{
  "id": "/afl-fantasy/",
  "name": "AFL",
  "short_name": "AFL",
  "description": "AFL fantasy football league management and analysis",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#002244",
  "background_color": "#002244",
  "icons": [
    {
      "src": "/assets/afl/favicons/favicon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/assets/afl/favicons/favicon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/assets/afl/favicons/icon-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Set Lineup",
      "short_name": "Lineup",
      "description": "Set this week's starting lineup",
      "url": "/lineup"
    },
    {
      "name": "Live Scores",
      "short_name": "Scores",
      "description": "Live scoring for this week's matchups",
      "url": "/live-scoring"
    },
    {
      "name": "My Roster",
      "short_name": "Roster",
      "description": "Your roster, contracts and cap",
      "url": "/rosters"
    },
    {
      "name": "Schefter Report",
      "short_name": "Schefter",
      "description": "The league's news feed",
      "url": "/schefter"
    }
  ],
  "share_target": {
    "action": "/schefter/tip",
    "method": "GET",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url"
    }
  }
}
