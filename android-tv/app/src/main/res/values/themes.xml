<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame so launch never flashes white on a TV. -->
    <style name="Theme.MflLive" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/board_ground</item>
        <item name="android:colorBackground">@color/board_ground</item>
    </style>

    <!-- The overlay tile: no screen of its own, so nothing flashes over the
         game when it starts the overlay and closes. -->
    <style name="Theme.MflLive.Overlay" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
</resources>
