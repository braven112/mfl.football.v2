# astro
.astro

# build output
/dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
.vercel

# VS Code personal settings
.vscode/extensions.json

# Salary history snapshots (large raw data files)
data/salary-history-archive/
data/*/salary-history/

# Contract declarations: local-dev-only filesystem fallback. Production reads
# from Upstash Redis. See src/utils/contract-storage.ts.
data/*/contract-declarations.json

# AFL keeper plans: local-dev-only filesystem fallback. Production reads
# from Upstash Redis. See src/utils/afl-keepers-storage.ts.
data/*/keeper-plans.json

# Salary history - only keep summary-week-*.json files
src/data/salary-history/**/raw-*.json
src/data/salary-history/**/summary-2*.json

# Self-hosted dark NFL + college logos, mirrored from ESPN during prebuild
# (scripts/fetch-nfl-dark-logos.mjs, scripts/fetch-college-dark-logos.mjs);
# the committed manifests in src/data/nfl-dark-logos-manifest.json and
# src/data/college-dark-logos-manifest.json track what a build actually has.
public/assets/nfl-logos/dark/
public/assets/college-logos/dark/

# Design files (PSDs/AI stored in Vercel Blob)
*.psd
*.ai

# Claude Code (personal/machine-specific)
.claude/settings.local.json
.claude/worktrees/
.claude/memory/
.env*.local

# One-shot Redis migration cursor checkpoint (scripts/migrate-redis.mjs)
.migrate-redis.state.json
.env*

# Ask Roger eval run output (pnpm eval:roger)
tests/eval/report-latest.json
# Cut Watch eval run output (pnpm eval:cutwatch)
tests/eval/cut-watch-report-latest.json
