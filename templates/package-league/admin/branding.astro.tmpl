---
/**
 * Team branding editor (__LEAGUE_SLUG__) — thin route: the gate and the config import
 * live here (a component cannot redirect; a static import specifier cannot be
 * a runtime variable). The editor is components/shared/branding/BrandingEditor.
 *
 * Commissioner of this league, or a platform admin (src/utils/league-admin.ts),
 * and only while the league has `features.brandingEditor` on.
 */
export const prerender = false;

import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import BrandingEditor from '../../../components/shared/branding/BrandingEditor.astro';
import { getAuthUser, isCommissionerOrAdmin } from '../../../utils/auth';
import { canAdministerLeague } from '../../../utils/league-admin';
import { loginUrlForRequest, forbiddenPathFor } from '../../../utils/login-redirect';
import { getLeagueBySlug } from '../../../config/leagues';
import config from '../../../../data/__LEAGUE_SLUG__/__LEAGUE_SLUG__.config.json';

const league = getLeagueBySlug('__LEAGUE_SLUG__')!;
const user = getAuthUser(Astro.request);
if (!user) return Astro.redirect(loginUrlForRequest(Astro, league));
if (!league.features.brandingEditor) return Astro.redirect('/__LEAGUE_SLUG__');
if (!canAdministerLeague(user, league)) {
  return Astro.rewrite(forbiddenPathFor(league, isCommissionerOrAdmin(user) ? 'league' : 'commissioner'));
}
---

<TheLeagueLayout title="Team Branding — Admin">
  <BrandingEditor leagueSlug="__LEAGUE_SLUG__" teams={config.teams} divisions={config.divisions} />
</TheLeagueLayout>
