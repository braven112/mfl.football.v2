---
/**
 * News Ops — /__LEAGUE_SLUG__/admin/news
 *
 * Thin wrapper: league-scoped admin gate + layout. The dashboard lives in
 * the shared components/schefter/AdminDashboard.astro; the stats API it
 * fronts is JWT-league-scoped the same way.
 */
export const prerender = false;

import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import AdminDashboard from '../../../components/schefter/AdminDashboard.astro';
import PersonaEditor from '../../../components/schefter/PersonaEditor.astro';
import { getAuthUser, isCommissionerOrAdmin } from '../../../utils/auth';
import { canAdministerLeague } from '../../../utils/league-admin';
import { loginUrlForRequest, forbiddenPathFor } from '../../../utils/login-redirect';
import { getLeagueBySlug } from '../../../config/leagues';

// League-scoped gate: commissioner/admin AND the session must belong to
// __LEAGUE_SHORT__ league — another league's commissioner session must not open its ops
// dashboard.
const user = getAuthUser(Astro.request);
const __LEAGUE_SLUG__ = getLeagueBySlug('__LEAGUE_SLUG__');
if (!user) return Astro.redirect(loginUrlForRequest(Astro, getLeagueBySlug('__LEAGUE_SLUG__')!));
if (!__LEAGUE_SLUG__) return Astro.redirect('/');
// A platform admin (src/utils/league-admin.ts) administers every league.
if (!canAdministerLeague(user, __LEAGUE_SLUG__)) {
  return Astro.rewrite(forbiddenPathFor(__LEAGUE_SLUG__, isCommissionerOrAdmin(user) ? 'league' : 'commissioner'));
}
---

<TheLeagueLayout title="News Ops — Admin">
  <AdminDashboard base="/__LEAGUE_SLUG__" navSlug="__LEAGUE_SLUG__">
    <PersonaEditor slot="settings" navSlug="__LEAGUE_SLUG__" />
  </AdminDashboard>
</TheLeagueLayout>
