---
/**
 * Transactions (__LEAGUE_SLUG__) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/transactions/TransactionsPage.
 *
 * The feed maps live HERE, shaped like a lazy glob: the KEYS answer "which
 * seasons exist" while only the season being viewed is actually read. They are
 * built over the league-data loader, never an `import.meta.glob`, which would
 * compile every season into the serverless function
 * (docs/claude/rules/storage-and-build.md § "League data lives in Blob").
 */
import TransactionsPage from '../../components/shared/transactions/TransactionsPage.astro';
import { getLeagueBySlug } from '../../config/leagues';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';
import type { LazyFeedGlob } from '../../utils/mfl-feed-glob';

export const prerender = false;

const league = getLeagueBySlug('__LEAGUE_SLUG__')!;
/** A lazy-glob-shaped map over the league-data loader. */
const lazy = (...patterns: string[]): LazyFeedGlob =>
  Object.fromEntries(
    patterns.flatMap((p) => listLeagueData(p)).map((p) => [p, () => loadLeagueData(p).then((d) => ({ default: d }))]),
  );

const transactionFeeds = lazy(`${league.dataPath}/mfl-feeds/*/transactions.json`);
const leagueFeeds = lazy(`${league.dataPath}/mfl-feeds/*/league.json`);
// Schefter's feed and its archive years, for the story on each move. Same
// lazy shape: only the files for the season being viewed are read.
const schefterPosts = lazy(`${league.dataPath}/schefter-feed.json`, `${league.dataPath}/schefter-archive/*.json`);
---

<TransactionsPage leagueSlug="__LEAGUE_SLUG__" transactionFeeds={transactionFeeds} leagueFeeds={leagueFeeds} schefterPosts={schefterPosts} />
