---
/**
 * Free agents (__LEAGUE_SLUG__) — thin route over the shared Free Agents page, the
 * same one the AFL renders (src/components/shared/free-agents/FreeAgentsPage.astro).
 * __LEAGUE_SHORT__ pools players by DIVISION, so the switcher is its nine divisions.
 * The snapshot import and globs live here: a static import specifier cannot
 * be a runtime variable.
 */
import FreeAgentsPage from '../../components/shared/free-agents/FreeAgentsPage.astro';
import freeAgentsData from '../../../data/__LEAGUE_SLUG__/derived/free-agents.json';

export const prerender = false;

const leagueModules = import.meta.glob(
  '../../../data/__LEAGUE_SLUG__/mfl-feeds/20{2[5-9],[3-9][0-9]}/league.json',
  { eager: true }
);
const calendarModules = import.meta.glob(
  '../../../data/__LEAGUE_SLUG__/mfl-feeds/20{2[5-9],[3-9][0-9]}/calendar.json',
  { eager: true }
);
---

<FreeAgentsPage
  leagueSlug="__LEAGUE_SLUG__"
  snapshot={freeAgentsData}
  leagueModules={leagueModules}
  calendarModules={calendarModules}
  title="Free Agents | __LEAGUE_SHORT__"
  poolNoun="Division"
/>
