---
/**
 * __LEAGUE_SHORT__ — full calendar. Thin route wrapper: the feed maps are built
 * here, through the league-data loader (storage-and-build.md § "League data
 * lives in Blob").
 */
import PackageCalendarPage from '../../components/shared/package-league/PackageCalendarPage.astro';
import { getLeagueBySlug } from '../../config/leagues';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';
import type { LazyFeedGlob } from '../../utils/mfl-feed-glob';

export const prerender = false;

const league = getLeagueBySlug('__LEAGUE_SLUG__')!;
/** A lazy-glob-shaped map over the league-data loader (never a glob: that compiles the data into the function). */
const lazy = (pattern: string): LazyFeedGlob =>
  Object.fromEntries(listLeagueData(pattern).map((p) => [p, () => loadLeagueData(p).then((d) => ({ default: d }))]));

const calendarFeeds = lazy(`${league.dataPath}/mfl-feeds/*/calendar.json`);
const playoffFeeds = lazy(`${league.dataPath}/mfl-feeds/*/playoff-brackets.json`);
---

<PackageCalendarPage leagueSlug="__LEAGUE_SLUG__" calendarFeeds={calendarFeeds} playoffFeeds={playoffFeeds} />
