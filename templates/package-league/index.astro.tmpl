---
/**
 * __LEAGUE_NAME__ — home. Thin route wrapper over the shared
 * package-league homepage. Globs live here: a static import specifier cannot
 * be a runtime variable, and cron-written feeds must never be static imports
 * (docs/claude/rules/storage-and-build.md). The Schefter feed is read live
 * from Redis (getSchefterFeedIfAny).
 */
import PackageLeagueHome from '../../components/shared/package-league/PackageLeagueHome.astro';
import config from '../../../data/__LEAGUE_SLUG__/__LEAGUE_SLUG__.config.json';
import { getLeagueBySlug } from '../../config/leagues';
import { getSchefterFeedIfAny } from '../../utils/schefter-league-data';

export const prerender = false;

const standingsFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/standings.json');
const transactionFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/transactions.json');
const leagueFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/league.json');
const scheduleFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/schedule.json');
const rosterFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/rosters.json');
// Absent until the sync account belongs to the league (the export is
// owner/commissioner-gated); the calendar falls back to derived dates.
const calendarFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/calendar.json');
const playoffFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/playoff-brackets.json');
// The Primetime front page's extra reads (registry `siteTheme`); unused by the Editorial homepage.
const historyFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/derived/league-history.json');
const ytdScoreFeeds = import.meta.glob('../../../data/__LEAGUE_SLUG__/mfl-feeds/*/playerScores-ytd.json');
const peckingOrderIssues = import.meta.glob<any>('../../../data/__LEAGUE_SLUG__/pecking-order/*.json', { eager: true, import: 'default' });

const posts = (await getSchefterFeedIfAny(getLeagueBySlug('__LEAGUE_SLUG__')!))?.posts ?? [];
---

<PackageLeagueHome
  leagueSlug="__LEAGUE_SLUG__"
  config={config}
  standingsFeeds={standingsFeeds}
  transactionFeeds={transactionFeeds}
  leagueFeeds={leagueFeeds}
  scheduleFeeds={scheduleFeeds}
  rosterFeeds={rosterFeeds}
  calendarFeeds={calendarFeeds}
  playoffFeeds={playoffFeeds}
  peckingOrderIssues={peckingOrderIssues}
  posts={posts}
  historyFeeds={historyFeeds}
  ytdScoreFeeds={ytdScoreFeeds}
/>
