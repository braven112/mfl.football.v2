---
/**
 * One news article (__LEAGUE_SLUG__) — thin route: finds the post (active feed, then
 * the per-year archives) and redirects to the news index when it is missing.
 * The body is the shared SchefterArticlePage. The lookup and redirect stay
 * here: `Astro.redirect()` only works from a page, and these globs are
 * static specifiers.
 */
import SchefterArticlePage from '../../../components/shared/SchefterArticlePage.astro';
import config from '../../../../data/__LEAGUE_SLUG__/__LEAGUE_SLUG__.config.json';
import type { SchefterPost } from '../../../types/schefter';
import type { GauntletDerived } from '../../../utils/schedule-strength';
import { getLeagueBySlug } from '../../../config/leagues';
import { getSchefterFeedIfAny } from '../../../utils/schefter-league-data';

export const prerender = false;

const gauntletFiles = import.meta.glob<GauntletDerived>('../../../../data/__LEAGUE_SLUG__/derived/schedule-strength-*.json', {
  import: 'default',
});
const archiveFiles = import.meta.glob<{ posts?: SchefterPost[] } | SchefterPost[]>(
  '../../../../data/__LEAGUE_SLUG__/schefter-archive/*.json',
  { import: 'default' },
);

// The live feed (Redis), then the archives. Null for a league with no feed yet.
const feedData = await getSchefterFeedIfAny(getLeagueBySlug('__LEAGUE_SLUG__')!);

const { id } = Astro.params;
const isArticle = (p: SchefterPost) => p.type === 'article' && p.id === id && !!p.content;
let post = (feedData?.posts ?? []).find(isArticle);
if (!post) {
  for (const key of Object.keys(archiveFiles).sort().reverse()) {
    const data = await archiveFiles[key]();
    const hit = ((Array.isArray(data) ? data : (data?.posts ?? [])) as SchefterPost[]).find(isArticle);
    if (hit) {
      post = hit;
      break;
    }
  }
}
if (!post) return Astro.redirect('/__LEAGUE_SLUG__/news');
---

<SchefterArticlePage leagueSlug="__LEAGUE_SLUG__" post={post} gauntletFiles={gauntletFiles} teams={config.teams} />
