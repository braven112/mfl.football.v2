---
/**
 * Trade Builder (__LEAGUE_SLUG__) — thin route wrapper over the SAME shared trade
 * builder the AFL renders (src/components/shared/trade-builder/). __LEAGUE_SHORT__
 * player pools are its nine divisions (`playerLimitUnit: DIVISION`), so trades
 * stay inside the viewer's division. It sits under /front-office/ because that
 * is the path the roster action sheet's Trade option opens; __LEAGUE_SHORT__ has no
 * Front Office hub, so the breadcrumbs skip it.
 */
import TradeBuilderPage from '../../../components/shared/trade-builder/TradeBuilderPage.astro';
import Breadcrumbs from '../../../components/shared/Breadcrumbs.astro';
import { getLeagueBySlug } from '../../../config/leagues';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { listLeagueData, loadLeagueData } from '../../../utils/league-data';
import { rosterYears } from '../../../utils/rosters/roster-page-feeds';
import config from '../../../../data/__LEAGUE_SLUG__/__LEAGUE_SLUG__.config.json';

export const prerender = false;

const league = getLeagueBySlug('__LEAGUE_SLUG__')!;
const r = (p: string) => resolveLeaguePath(p, Astro.locals.hideLeaguePrefix ?? false);

// League data is read through the loader, not globbed (storage-and-build.md
// § "League data lives in Blob"). The builder works on the newest season with
// a roster, so only that season's feeds are loaded, keyed by repo path — the
// shape `feedForYear` reads.
const feedDir = `${league.dataPath}/mfl-feeds`;
const loadFeeds = async (paths: string[]) =>
  Object.fromEntries(await Promise.all(paths.map(async (p) => [p, await loadLeagueData(p)] as const)));
const forYear = (file: string, year: number) =>
  listLeagueData(`${feedDir}/*/${file}`).filter((p) => Number(p.split('/').at(-2)) === year);
// players.json stayed current-era only while it was globbed; keep that window.
const CURRENT_ERA_FLOOR = 2025;

const rosters = await loadFeeds(listLeagueData(`${feedDir}/*/rosters.json`));
const fallbackYear = getLeagueYearForSlug(league.slug);
const year = rosterYears(rosters)[0] ?? fallbackYear;
const [players, adp, picks, tradeBait, tradeBaitByFranchise] = await Promise.all([
  loadFeeds(year >= CURRENT_ERA_FLOOR ? forYear('players.json', year) : []),
  loadFeeds(forYear('adp-redraft.json', year)),
  loadFeeds(forYear('futureDraftPicks.json', year)),
  loadFeeds(forYear('tradeBait.json', year)),
  loadFeeds(forYear('tradeBait-by-franchise.json', year)),
]);
const feeds = {
  rosters,
  players,
  // A redraft league values players on the REDRAFT board.
  adp,
  adpFile: 'adp-redraft.json',
  picks,
  tradeBait,
  tradeBaitByFranchise,
};

// "Payton Manning Division" → "Payton Manning": the short label for the locked
// rows and the "same-division trades only" line.
const poolShort = Object.fromEntries(config.divisions.map((d) => [d.id, d.name.replace(/\s+Division$/i, '')]));
---

<TradeBuilderPage
  leagueSlug={league.slug}
  leagueLabel={league.shortName ?? league.name}
  feeds={feeds}
  fallbackYear={fallbackYear}
  teams={config.teams}
  divisions={config.divisions}
  poolShort={poolShort}
  poolNoun="division"
>
  <Breadcrumbs
    slot="breadcrumbs"
    items={[{ label: 'Home', href: r(`/${league.slug}`) }, { label: 'Rosters', href: r(`/${league.slug}/rosters`) }, { label: 'Trade Builder' }]}
  />
</TradeBuilderPage>
