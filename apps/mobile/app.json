{
  "expo": {
    "name": "MFL Football",
    "slug": "mfl",
    "owner": "fantasysports.dev",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14161a",
    "android": {
      "package": "football.mfl.live.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161a"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "football.mfl.live"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "apiOrigin": "https://v2.mfl.football",
      "eas": {
        "projectId": "45e0bbdf-e3b3-408d-8e0b-ac9950292d58"
      }
    }
  }
}
