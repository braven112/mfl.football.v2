    {
      "name": "rosters-page",
      "rules": "docs/plans/rosters-page-split.md",
      "note": "Run `node scripts/roster-parity-check.mjs` before AND after editing — it is the only test of this 12k-line page's hydrated output.",
      "paths": [
        "src/pages/*/rosters.astro",
        "scripts/roster-parity-check.mjs"
      ],
      "tests": [
        "tests/page-fork-ratchet.test.ts",
        "tests/roster-utils-rows.test.ts"
      ]
    },
    {
      "name": "hero-composites",
      "rules": "docs/claude/insights/features/player-composites.md",
      "paths": [
        "src/utils/hero-*",
        "src/utils/afl-hero-*",
        "src/utils/offseason-hero-data.ts",
        "src/utils/league-event-hero-view.ts",
        "src/utils/playoff-hero-helpers.ts"
      ],
      "tests": [
        "tests/hero-casting.test.ts",
        "tests/afl-hero-casting.test.ts",
        "tests/hero-resolver.test.ts",
        "tests/offseason-hero-data.test.ts"
      ]
    },
    {
      "name": "throwback-week",
      "rules": "docs/claude/insights/features/throwback-week.md",
      "paths": [
        "src/data/*/throwback-*",
        "src/utils/throwback*",
        "src/utils/era-*",
