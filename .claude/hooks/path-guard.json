    {
      "name": "year-rollover",
      "paths": [
        "src/utils/league-year*",
        "src/utils/pecking-order-season-window.mjs"
      ],
      "note": "Two independent clocks (Feb 14 → getCurrentLeagueYear, Labor Day → getCurrentSeasonYear); the base year is ALWAYS calendarYear - 1. See CLAUDE.md \"Year rollover — two independent clocks\".",
      "tests": [
        "tests/league-year-rollover.test.ts",
        "tests/afl-league-year.test.ts",
        "tests/league-year-node-safe.test.ts",
        "tests/league-year-for-slug.test.ts"
      ]
