        "tests/team-color-backdrop-guard.test.ts",
        "tests/afl-brand-green-guard.test.ts",
        "tests/service-worker-cache.test.ts"
      ]
    },
    {
      "name": "storage-and-build",
      "rules": "docs/claude/rules/storage-and-build.md",
      "paths": [
        "scripts/lib/canonical-json.mjs",
        "scripts/fetch-mfl-feeds.mjs",
