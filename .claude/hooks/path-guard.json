        "tests/current-era-feed-globs.test.ts"
      ]
    },
    {
      "name": "league-urls-and-registry",
      "rules": "docs/claude/rules/league-urls.md",
      "paths": [
        "src/config/leagues*",
        "src/utils/link-punctuation.mjs",
        "src/utils/mfl-url.ts",
        "scripts/lib/groupme*",
        "src/utils/groupme*"
      ],
      "tests": [
        "tests/league-url-prefix.test.ts",
        "tests/url-shareability.test.ts",
        "tests/league-literal-guard.test.ts",
        "tests/rankings-scope.test.ts",
        "tests/league-year-for-slug.test.ts"
      ]
