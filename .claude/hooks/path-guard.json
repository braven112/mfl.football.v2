    {
      "name": "draft-pages",
      "rules": "docs/plans/draft-hub-and-results.md",
      "paths": [
        "src/pages/*/draft/**",
        "src/pages/best-ball-1/draft-*.astro",
        "src/utils/draft*",
        "src/utils/*mock-draft*",
        "src/pages/api/draft/**",
        "src/pages/api/draft-list.ts"
      ],
      "tests": [
        "tests/draft-status-units.test.ts",
        "tests/afl-draft-slot.test.ts",
