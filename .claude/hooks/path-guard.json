    {
      "name": "rankings",
      "paths": [
        "src/utils/rankings-*",
        "src/utils/custom-rankings*",
        "src/pages/api/ri.ts",
        "src/pages/api/cr.ts",
        "src/pages/*/cr.astro"
      ],
      "note": "Rankings are per-league; rankings-scope.ts owns every storage key. See CLAUDE.md \"Rankings are per-league\".",
      "tests": [
        "tests/rankings-scope.test.ts",
        "tests/rankings-lookup.test.ts",
        "tests/rankings-storage.test.ts",
        "tests/custom-rankings-seeding.test.ts"
      ]
    },
    {
      "name": "page-directory-and-whats-new",
      "paths": [
        "src/data/page-directory.json",
        "src/data/whats-new.json",
        "src/data/weekly-changelog-staging.json",
        "src/utils/whats-new*"
      ],
      "note": "See CLAUDE.md \"Page directory registry\" and \"What's New changelog\".",
      "tests": [
        "tests/page-directory-data.test.ts",
        "tests/whats-new-data.test.ts",
        "tests/whats-new-links.test.ts",
        "tests/whats-new-cross-league.test.ts"
      ]
    },
    {
      "name": "auth-and-url-safety",
      "paths": [
        "src/utils/auth.ts",
        "src/utils/rate-limit.ts",
        "src/utils/url-guard.ts",
        "src/middleware.ts"
      ],
      "note": "Session JWT only — never re-add unsigned identity sources. See CLAUDE.md \"Auth — session JWT only\".",
      "tests": [
        "tests/url-guard.test.ts",
        "tests/mfl-cookie-redirect-guard.test.ts"
      ]
    },
    {
      "name": "clientrouter-pages",
      "paths": [
        "src/pages/*/assets.astro",
        "src/pages/*/salary.astro",
        "src/pages/*/trade-builder.astro",
        "src/components/**/MatchupSelector*"
      ],
      "note": "These pages have each shipped a 'goes dead after in-site navigation' bug: init must re-run on astro:page-load, and module-level state must not capture the previous page's DOM.",
      "tests": [
        "tests/assets-page-clientrouter.test.ts",
        "tests/salary-page-clientrouter.test.ts",
        "tests/trade-builder-clientrouter.test.ts",
        "tests/matchup-selector-clientrouter.test.ts",
        "tests/clientrouter-init-ratchet.test.ts"
      ]
    },
    {
      "name": "page-forks",
      "paths": [
        "src/pages/theleague/*.astro",
        "src/pages/afl-fantasy/*.astro"
      ],
      "note": "A route under two league directories is a sibling: build a shared component, not a second page. See CLAUDE.md \"Second league's copy of a page\".",
      "tests": [
        "tests/page-fork-ratchet.test.ts",
        "tests/clientrouter-init-ratchet.test.ts"
      ]
    },
    {
      "name": "github-workflows",
      "paths": [
        ".github/workflows/*.yml"
      ],
      "note": "No new vars.* feature gates (comment out cron: to disable a job; gate with a const in the script); league ids/hosts come from the registry; a weekly job needs isSeasonWindowOpen, not \"the feeds have a completed week\". See CLAUDE.md \"Feature flags — code, not GitHub Actions variables\".",
      "tests": [
        "tests/workflow-feature-flag-guard.test.ts",
        "tests/league-literal-guard.test.ts"
      ]
    },
    {
      "name": "client-scripts",
      "paths": [
        "src/components/**/*.astro",
        "src/scripts/*"
      ],
      "note": "Bundled <script> blocks run ONCE per session under the ClientRouter: init on astro:page-load (never DOMContentLoaded), re-read elements inside init(), replace document/window listeners rather than stacking them. See docs/claude/insights/domains/frontend.md \"Astro and ClientRouter\".",
      "tests": [
        "tests/clientrouter-init-ratchet.test.ts"
      ]
    },
    {
      "name": "dev-tooling",
      "paths": [
        "scripts/ratchet.mjs",
        "scripts/lib/ratchet-measures.mjs",
        "scripts/lib/rebase-conflicts.mjs",
        "scripts/resolve-rebase-conflicts.mjs",
        "scripts/scaffold-*.mjs",
        "scripts/record-mfl-fixture.mjs",
        "scripts/sibling-drift.mjs",
        "scripts/guard-gap.mjs",
        "scripts/rollover-check.ts",
        "tests/helpers/scan-guard.ts",
        "tests/fixtures/*-baseline.json"
      ],
      "note": "These back the /ratchet, /rebase, /new-page, /new-cron, /guard-test and /rollover-check skills and the sibling-drift, guard-gap and fixture-recorder agents; their tests are the contract those skills rely on.",
      "tests": [
        "tests/page-fork-ratchet.test.ts",
        "tests/clientrouter-init-ratchet.test.ts",
        "tests/rebase-conflict-classifier.test.ts",
        "tests/scan-guard-helper.test.ts",
        "tests/mfl-fixture-canonicalize.test.ts",
        "tests/workflow-feature-flag-guard.test.ts",
        "tests/path-guard-map.test.ts"
      ]
    },
    {
      "name": "claude-config-and-docs",
      "paths": [
        "CLAUDE.md",
        "AGENTS.md",
        "GEMINI.md",
        "docs/claude/rules/*.md",
        "docs/claude/insights/domains/*.md",
        ".claude/**"
      ],
      "tests": [
        "tests/claude-md-references.test.ts",
        "tests/insights-curated-head.test.ts",
        "tests/path-guard-map.test.ts"
      ]
    }
