{
  "$comment": "Path → guard-tests → rules-doc map consumed by .claude/hooks/path-guard.mjs on every Write/Edit. Globs use Node's path.matchesGlob against repo-relative paths. Keep each domain's tests FAST (scan-style guards, pure-function suites) — they run on every edit that matches. tests/path-guard-map.test.ts validates this file: every glob must match a real file, every test and rules doc must exist, and every docs/claude/rules/*.md must be routed by at least one domain.",
  "domains": [
    {
      "name": "roger",
      "rules": "docs/claude/rules/roger.md",
      "paths": [
        "scripts/schefter-scan.mjs",
        "scripts/compute-league-events.mjs",
        "scripts/lib/roger-*",
        "scripts/roger-*",
        "src/data/theleague/league-year-config.ts",
        "src/data/theleague/nfl-draft-dates-fetched.json",
        "tests/roger-reminder-window.test.ts"
      ],
      "tests": [
        "tests/roger-reminder-window.test.ts",
        "tests/roger-afl-mapping.test.ts"
      ]
    },
    {
      "name": "schefter",
      "rules": "docs/claude/rules/schefter.md",
      "paths": [
        "scripts/schefter-*.mjs",
        "scripts/lib/schefter*",
        "src/utils/schefter*",
        "src/pages/api/schefter/**",
        "src/components/**/Schefter*"
      ],
      "tests": [
        "tests/schefter-franchise-name-redaction.test.ts",
        "tests/schefter-attack-detection-parity.test.ts",
        "tests/schefter-output-sanitizer.test.ts"
      ]
    },
    {
      "name": "standings-brackets-draft-order",
      "rules": "docs/claude/rules/standings-brackets-draft-order.md",
      "paths": [
        "src/utils/standings*",
        "src/utils/live-standings*",
        "src/utils/playoff*",
        "src/utils/*bracket*",
        "scripts/*bracket*",
        "scripts/*standings*"
      ],
      "tests": [
        "tests/standings-all-play.test.ts",
        "tests/afl-bracket-kind.test.ts",
        "tests/draft-order-phase.test.ts",
        "tests/playoff-round-data.test.ts"
      ]
    },
    {
      "name": "live-scoring",
      "rules": "docs/claude/rules/live-scoring.md",
      "paths": [
        "src/utils/live-*",
        "src/utils/espn*",
        "scripts/fetch-live-*",
        "scripts/fetch-espn*",
        "src/pages/*/live*"
      ],
      "tests": [
        "tests/live-scoring-host-resolution.test.ts",
        "tests/marquee-live-guard.test.ts",
        "tests/nfl-live-routes.test.ts"
      ]
    },
    {
      "name": "lineups",
      "rules": "docs/claude/rules/lineups.md",
      "paths": [
        "src/pages/*/lineup.astro",
        "src/utils/lineup*",
        "src/pages/api/lineup*",
        "src/pages/api/*/lineup*"
      ],
      "tests": [
        "tests/lineup-page-clientrouter.test.ts",
        "tests/lineup-sources.test.ts",
        "tests/lineup-route-merge.test.ts"
      ]
    },
    {
      "name": "franchise-history-owners",
      "rules": [
        "docs/claude/insights/features/franchise-history.md",
        "docs/plans/owners-feature.md"
      ],
      "paths": [
        "scripts/compute-franchise-history.mjs",
        "scripts/compute-owner-tenures.mjs",
        "src/utils/owner*",
        "src/utils/franchise-eras.ts",
        "src/pages/*/owners/**",
        "src/pages/*/franchises/**"
      ],
      "tests": [
        "tests/owner-tenures-data.test.ts",
        "tests/owner-boundary-parity.test.ts",
        "tests/owner-history-boundaries.test.ts"
      ]
    },
    {
      "name": "theming-and-assets",
      "rules": "docs/claude/rules/theming-and-assets.md",
      "paths": [
        "src/styles/**",
        "src/utils/theme*",
        "src/utils/team-color*",
        "src/utils/team-icon*",
