---
/**
 * Story-only gallery for the component kit (src/styles/badge.css,
 * src/styles/card.css, src/styles/modal.css — docs/plans/component-kit.md).
 *
 * Renders the REAL classes — nothing here restyles a kit component, so what
 * the canvas shows is what every page ships. The kit stylesheets reach the
 * canvas through .storybook/preview.ts (Trap 2 in docs/claude/rules/storybook.md).
 *
 * Keep every inline element on one source line with its neighbours (Trap 4:
 * Storybook does not load astro.config's compressHTML).
 */

export interface Props {
  /** Which part of the kit to show. */
  part?: 'badge' | 'card' | 'modal' | 'tabs' | 'table' | 'pill';
}

const { part = 'badge' } = Astro.props;

const TONES = [
  { cls: '', name: 'Default', use: 'No ground: inherits the text colour around it.' },
  { cls: 'ui-badge--neutral', name: 'Neutral', use: 'A quiet fact: Bye, IR, Rookie.' },
  { cls: 'ui-badge--success', name: 'Success', use: 'Done and good: Paid, Clinched, Kept.' },
  { cls: 'ui-badge--warning', name: 'Warning', use: 'Needs attention: Questionable, Due soon.' },
  { cls: 'ui-badge--error', name: 'Error', use: 'Wrong or gone: Out, Eliminated, Overdue.' },
  { cls: 'ui-badge--info', name: 'Info', use: 'Themed per league: New, Live.' },
  { cls: 'ui-badge--accent', name: 'Accent', use: "The league's own colour, carrying the theme's ink." },
];
---

{part === 'badge' ? (
  <section class="kitg">
    <header>
      <h2 class="kitg__title">Badge</h2>
      <p class="kitg__lede">One small-label shape for every status, seed and tag. Source: <code>src/styles/badge.css</code>. A control the viewer taps (a filter or sort chip) is not a badge.</p>
    </header>

    <div class="kitg__grid" role="table" aria-label="Badge tones">
      <div class="kitg__row kitg__row--head" role="row">
        <span role="columnheader">Tone</span>
        <span role="columnheader">Default</span>
        <span role="columnheader">Caps</span>
        <span role="columnheader">In a sentence</span>
      </div>
      {TONES.map((t) => (
        <div class="kitg__row" role="row">
          <span class="kitg__name" role="cell"><strong>{t.name}</strong><code>{`class="ui-badge${t.cls ? ' ' + t.cls : ''}"`}</code><small>{t.use}</small></span>
          <span role="cell"><span class:list={['ui-badge', t.cls]}>Clinched</span></span>
          <span role="cell"><span class:list={['ui-badge', 'ui-badge--caps', t.cls]}>Clinched</span></span>
          <span role="cell" class="kitg__prose">Pacific Pigskins <span class:list={['ui-badge', 'ui-badge--inline', t.cls]}>x</span> clinched a bye.</span>
        </div>
      ))}
    </div>

    <h3 class="kitg__sub">A page's own badge: keep only what differs</h3>
    <p class="kitg__row-demo"><span class="ui-badge ui-badge--caps kitg__seed">Seed 3</span></p>
    <pre class="kitg__code"><code>{`<span class="ui-badge ui-badge--caps seed-badge">Seed 3</span>

.seed-badge {
  /* Kit: ui-badge ui-badge--caps supplies the shared badge shape; what follows is this badge's own look. */
  --ui-badge-bg: var(--league-accent);
  --ui-badge-ink: var(--on-league-accent);
  padding: 0.2rem 0.55rem;
}`}</code></pre>
  </section>
) : part === 'card' ? (
  <section class="kitg">
    <header>
      <h2 class="kitg__title">Card</h2>
      <p class="kitg__lede">One card surface: ground, outline, corner and lift. Source: <code>src/styles/card.css</code>. Editorial outlines a card; Primetime drops the outline and lifts it with a shadow. Layout inside the card is the card's own.</p>
    </header>
    <div class="kitg__cards">
      <article class="ui-card kitg__card">
        <p class="kitg__card-eyebrow">Week 8</p>
        <p class="kitg__card-title">Pacific Pigskins 124.6 – 98.2 Smokane FC</p>
        <p class="kitg__card-body">The kit card, unmodified. Switch the toolbar's site style to see Primetime's lift.</p>
      </article>
      <article class="ui-card kitg__card kitg__card--muted">
        <p class="kitg__card-eyebrow">A page's own ground</p>
        <p class="kitg__card-title">Muted tile</p>
        <p class="kitg__card-body">Same surface, its own background set on its own class.</p>
      </article>
    </div>
  </section>
) : part === 'tabs' ? (
  <section class="kitg">
    <header>
      <h2 class="kitg__title">Tabs</h2>
      <p class="kitg__lede">One underline tab bar. Source: <code>src/styles/tabs.css</code>. <code>ui-tabs</code> on the bar, <code>ui-tab</code> on each tab; the selected tab is the one with <code>aria-selected="true"</code>, <code>aria-current="page"</code> or <code>ui-tab--active</code>. Padding, gap and scrolling are the bar's own.</p>
    </header>
    <div class="ui-tabs kitg__tabs" role="tablist" aria-label="Player sheet">
      <button type="button" class="ui-tab kitg__tab" role="tab" aria-selected="true">Overview</button>
      <button type="button" class="ui-tab kitg__tab" role="tab" aria-selected="false">Contract</button>
      <button type="button" class="ui-tab kitg__tab" role="tab" aria-selected="false">Game log</button>
      <button type="button" class="ui-tab kitg__tab" role="tab" aria-selected="false">News</button>
    </div>
  </section>
) : part === 'pill' ? (
  <section class="kitg">
    <header>
      <h2 class="kitg__title">Pill</h2>
      <p class="kitg__lede">Filters or sorts one view: the same UI below, different content. A switch to an unrelated view is a tab. Source: <code>src/styles/pill.css</code>. <code>ui-pills</code> on the row (one swiping line on a phone), <code>ui-pill</code> on each pill; the selected one carries <code>aria-pressed="true"</code>, <code>aria-selected="true"</code>, <code>aria-current="page"</code> or <code>ui-pill--active</code> and is tinted with <code>--ui-pill-tone</code>.</p>
    </header>
    <div class="ui-pills" role="group" aria-label="Filter the feed">
      <button type="button" class="ui-pill" aria-pressed="true">All</button>
      <button type="button" class="ui-pill" aria-pressed="false">Trades</button>
      <button type="button" class="ui-pill" aria-pressed="false">Waivers</button>
      <button type="button" class="ui-pill" aria-pressed="false">Injuries</button>
      <button type="button" class="ui-pill" aria-pressed="false">Rumors</button>
    </div>
  </section>
) : part === 'table' ? (
  <section class="kitg">
    <header>
      <h2 class="kitg__title">Table</h2>
      <p class="kitg__lede">One data-table header row and tabular numerals. Source: <code>src/styles/table.css</code>. <code>ui-table</code> on the <code>&lt;table&gt;</code>. Cell padding, widths, zebra rows and a sticky header's ground are the table's own; heat maps and week grids are forks.</p>
    </header>
    <table class="ui-table kitg__table">
      <thead><tr><th>Team</th><th>W-L</th><th>PF</th><th>PA</th></tr></thead>
      <tbody>
        <tr><td>Pacific Pigskins</td><td>6-2</td><td>1,021.4</td><td>902.8</td></tr>
        <tr><td>Smokane FC</td><td>5-3</td><td>987.0</td><td>951.6</td></tr>
        <tr><td>Da Dangsters</td><td>2-6</td><td>842.2</td><td>1,004.9</td></tr>
      </tbody>
    </table>
  </section>
) : (
  <section class="kitg">
    <header>
      <h2 class="kitg__title">Modal</h2>
      <p class="kitg__lede">One dialog surface: ground, ink, corner, lift and the frosted scrim behind it. Source: <code>src/styles/modal.css</code>. <code>ui-modal</code> goes on the panel (or the <code>&lt;dialog&gt;</code>, whose backdrop is the scrim); <code>ui-scrim</code> on a hand-built overlay. Width, padding, the phone sheet and the animation are the dialog's own.</p>
    </header>
    <div class="kitg__stages">
      <div class="kitg__stage">
        <div class="kitg__behind"><p>Pacific Pigskins</p><p>Smokane FC</p><p>Da Dangsters</p></div>
        <div class="ui-scrim kitg__scrim"></div>
        <div class="ui-modal kitg__panel">
          <p class="kitg__card-title">Confirm your MFL login</p>
          <p class="kitg__card-body">A centered dialog: the kit panel, unmodified.</p>
        </div>
      </div>
      <div class="kitg__stage kitg__stage--sheet">
        <div class="kitg__behind"><p>Pacific Pigskins</p><p>Smokane FC</p><p>Da Dangsters</p></div>
        <div class="ui-scrim kitg__scrim"></div>
        <div class="ui-modal kitg__panel kitg__panel--sheet">
          <p class="kitg__card-title">Cap by year</p>
          <p class="kitg__card-body">A phone bottom sheet squares its own lower corners.</p>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .kitg {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    max-width: 60rem;
    color: var(--page-text);
  }
  .kitg__title {
    margin: 0;
  }
  .kitg__tabs {
    gap: 0.25rem;
  }
  .kitg__tab {
    padding: 0.6rem 0.75rem;
  }
  .kitg__table {
    width: 100%;
    max-width: 32rem;
    border-collapse: collapse;
  }
  .kitg__table th,
  .kitg__table td {
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .kitg__table td {
    border-bottom: 1px solid var(--content-border);
  }
  .kitg__lede {
    margin: 0.25rem 0 0;
    color: var(--content-text-muted);
  }
  .kitg__grid {
    display: grid;
    border: 1px solid var(--content-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--card-bg);
  }
  .kitg__row {
    display: grid;
    grid-template-columns: minmax(14rem, 2fr) repeat(3, minmax(8rem, 1fr));
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--content-border);
  }
  .kitg__row--head {
    border-top: 0;
    padding-block: 0.6rem;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted);
    background: var(--content-bg-muted);
  }
  .kitg__name {
    display: grid;
    gap: 0.2rem;
  }
  .kitg__name code,
  .kitg__name small {
    font-size: var(--font-size-xs);
  }
  .kitg__name small {
    color: var(--content-text-muted);
  }
  .kitg__prose {
    font-size: var(--font-size-sm);
  }
  .kitg__sub {
    margin: 0.5rem 0 0;
    font-size: var(--font-size-base);
  }
  .kitg__row-demo {
    margin: 0;
  }
  .kitg__seed {
    --ui-badge-bg: var(--league-accent);
    --ui-badge-ink: var(--on-league-accent);
    padding: 0.2rem 0.55rem;
  }
  .kitg__code {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--content-bg-muted);
    font-size: var(--font-size-xs);
    overflow-x: auto;
  }
  .kitg__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .kitg__card {
    padding: 1rem 1.25rem;
  }
  .kitg__card--muted {
    background: var(--content-bg-muted);
  }
  .kitg__card-eyebrow {
    margin: 0;
    font-size: var(--font-size-2xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted);
  }
  .kitg__card-title {
    margin: 0.25rem 0;
    font-weight: var(--font-weight-bold);
  }
  .kitg__card-body {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--content-text-muted);
  }

  .kitg__stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .kitg__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 16rem;
    padding: 1rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--page-bg);
  }
  .kitg__stage--sheet {
    align-items: flex-end;
    padding: 0;
  }
  .kitg__behind {
    position: absolute;
    inset: 0;
    padding: 1rem;
    font-weight: var(--font-weight-bold);
  }
  .kitg__scrim {
    position: absolute;
    inset: 0;
  }
  .kitg__panel {
    position: relative;
    width: 100%;
    max-width: 18rem;
    padding: 1.25rem;
  }
  .kitg__panel--sheet {
    max-width: none;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  @media (max-width: 760px) {
    .kitg__row {
      grid-template-columns: 1fr 1fr;
    }
    .kitg__row--head {
      display: none;
    }
    .kitg__name {
      grid-column: 1 / -1;
    }
  }
</style>
