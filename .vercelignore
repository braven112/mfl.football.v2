# Vercel Ignore File
# Prevents large data files from being bundled into serverless functions

# Large salary history snapshots (raw timestamped files)
src/data/salary-history/**/raw-*.json
data/*/salary-history/

# Design files (PSDs, large images)
design/

# Test files
tests/
*.test.ts
*.spec.ts

# Development artifacts
tmp/
*.log

# NOT .git/: vercel-ignore-build.mjs reads the commit range with git to skip
# builds whose data is already live, and Vercel applies this file BEFORE the
# ignore command runs. Excluding .git made every such check fail open and build.
# (.git is never traced into the function, so it costs no function size.)

# Editor configs
.vscode/
.idea/

# Local env files (should already be ignored)
.env.local
.env.*.local

# The MFL Live mobile app builds on Expo EAS, never on Vercel
apps/mobile/
