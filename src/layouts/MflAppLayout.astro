---
/**
 * MflAppLayout — the shell for MFL Live, the league-neutral app on the shared
 * host (mfl.football / staging.mfl.football).
 *
 * Deliberately NOT TheLeagueLayout and NOT SplashLayout:
 *
 *  - TheLeagueLayout wears one league's identity — its crest, its nav, its
 *    footer, its PWA manifest. This surface spans every league the signed-in
 *    MFL account is in and must claim none of them.
 *  - SplashLayout is chrome-free and sets no `data-league`, so it renders
 *    TheLeague's default blue tokens. This app has a palette of its own.
 *
 * See docs/plans/mfl-live-app.md.
 *
 * ── WHY data-league="mfl" ON A HOST THAT BELONGS TO NO LEAGUE ─────────────
 * The token system keys every palette off this attribute, and this app needs
 * a palette (the `mfl-live` theme, src/themes/mfl-live.json, mapped to `mfl`
 * by THEMED_SURFACES in scripts/generate-league-themes.mjs). The
 * value is a THEME KEY, not a league: "mfl" is not in the registry, has no
 * MFL id, and must never appear in HOST_TO_SLUG — which is exactly why it is
 * written as a literal here rather than derived from a league lookup. There
 * is no league to look up.
 *
 * ── THE BAR HOLDS TWO THINGS ─────────────────────────────────────────────
 * Brand, and a hamburger. Every destination — the board, settings, the league
 * sites — plus the theme control and sign in/out live in `MflAppMenu`. The bar
 * used to carry all of them inline and drop the league links entirely below
 * 640px, which meant the phone this app is FOR was the device that lost
 * navigation. One menu at every width; adding a destination no longer competes
 * for bar space.
 *
 * ── THE MANIFEST IS GATED ─────────────────────────────────────────────────
 * TheLeagueLayout already refuses to serve a league's manifest on a foreign
 * host, because a manifest's scope claims the origin it is served from. The
 * mirror of that rule applies here: MFL Live's manifest belongs on the shared
 * host and nowhere else. `/live` only routes there today (a league apex
 * rewrites it under the league prefix and 404s), but the gate is what keeps
 * that true if `/live/` is ever added to SKIP_REWRITE_PREFIXES.
 *
 * ── ITS SCOPE IS THE WHOLE HOST, DELIBERATELY (Sep 2026) ─────────────────
 * `scope` was `/live` so an installed app could not swallow the other leagues
 * served here by path prefix. It is now `/`, and `start_url` is `/` — the
 * splash — because the ask was for v2.mfl.football ITSELF to be the installed
 * app, not one board inside it. Two things make that safe rather than the bug
 * the old scope prevented:
 *
 *  - `/theleague/*` and `/afl-fantasy/*` are NOT served on the shared host
 *    (they 404 there; see the comment in src/pages/index.astro), so there is
 *    no league page for the app to swallow. `/best-ball-1/*` IS served here
 *    and IS now in scope — accepted, since bb1 has no apex of its own and the
 *    shared host is the only front door it has ever had.
 *  - `id` stays `/live`. An app id is an identity key, resolved against the
 *    origin and NOT required to sit inside `scope`, so keeping it is what
 *    lets an already-installed MFL Live UPDATE in place to the wider scope
 *    instead of appearing as a second, competing app.
 *
 * The consequence for this layout: the manifest is no longer linked only from
 * here. SplashLayout links it too, behind the same `isSharedAppHost` gate, so
 * the app is installable from the host's front door. Both gates are pinned by
 * tests/push-notification-icons.test.ts.
 */
import { Font } from 'astro:assets';
import SpeedInsights from '@vercel/speed-insights/astro';
import { mflLoginUrl } from '../utils/mfl-login-redirect';
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../components/shared/ThemeScript.astro';
import MflAppMenu from '../components/shared/mfl-live/MflAppMenu.astro';
import NflLogoDarkStyles from '../components/shared/NflLogoDarkStyles.astro';
import TeamIconDarkStyles from '../components/shared/TeamIconDarkStyles.astro';
import { getThemePreference } from '../utils/theme-preference';
import { getMflLiveUser } from '../utils/auth';
import { canViewSiteInsights } from '../utils/site-insights';
import { canViewProductPages } from '../utils/product-pages-access';
import { getLeagueById, isSharedAppHost, leagueUrl } from '../config/leagues';
import { getLeagueYearForMflId } from '../utils/league-year';
// Global utility classes (.visually-hidden, …) — a frontmatter import so the
// CSS ships unscoped; an @import inside the <style> block would get scoped.
import '../styles/utilities.css';
// Global polish layer + shared empty/error states. Imported here, NOT via
// @import in the <style> block below: Astro scopes @imported rules to this
// layout's own markup, so they would never reach a page's content.
import '../styles/polish.css';
import '../styles/states.css';
// The one CTA pattern (.cta / .cta-link). Also a frontmatter import: its
// state rules must out-rank this layout's global a:hover, which a scoped copy
// could not reach. docs/claude/rules/theming-and-assets.md § "CTAs".
import '../styles/cta.css';
import '../styles/badge.css';
import '../styles/card.css';
import '../styles/modal.css';
import '../styles/tabs.css';
import '../styles/table.css';
// Seasonal looks (Halloween): the headline face and the hidden theme control,
// keyed on <html data-season> like everything seasonal.
import '../styles/seasonal-themes.css';
import { mflLiveSeason } from '../utils/mfl-live-season';

export interface Props {
	title: string;
	/** Meta description. Optional — the board itself is behind auth. */
	description?: string;
}

const { title, description } = Astro.props as Props;

// 'auto' renders no class — the pre-paint ThemeScript resolves it against
// prefers-color-scheme before first paint.
const themePref = getThemePreference(Astro.cookies);

// A seasonal theme (Halloween) is worn by the WHOLE app while its window is
// open, whatever leagues the viewer plays in (SURFACE_SEASONAL_THEMES). The
// palette keys on data-season here exactly as on a league page; franchise
// marks swap only for leagues that wear the season themselves. Its lock
// outranks the viewer's light/dark choice. ?testDate= / ?seasonPreview=
// preview it, as on the league sites.
const season = mflLiveSeason(Astro.url, Astro.locals.seasonPreview);
const modeLock = season?.lock ?? undefined;

// See the manifest note above.
const onSharedHost = isSharedAppHost(Astro.url.hostname);

const authUser = getMflLiveUser(Astro.request);

// The menu's "League sites" section names ONLY the signed-in owner's own
// league (owner's call, Oct 2026, as MFL Live opened to Archie's members): a
// list of every league this project runs showed each league's owners the
// others' sites. Signed out, there is no league to name and the section is
// gone. The session names one league, so an owner in two sees the one they
// signed in under; the board itself still reads every league they are in.
//
// Where the link goes: a league with its own front door here gets its site,
// absolute via leagueUrl (docs/claude/rules/league-urls.md). A league NOT
// advertised on the shared host (Archie's) gets its MyFantasyLeague home page
// instead — the site its owners already use — until the owner decides to
// point them at its pages here. A best-ball session is never an MFL Live
// session (getMflLiveUser), so no draft-only league can reach this list.
const sessionLeague = authUser ? getLeagueById(authUser.leagueId) : null;
const leagueLinks: { name: string; href: string }[] = sessionLeague
	? [
			{
				name: sessionLeague.name,
				href:
					sessionLeague.advertiseOnSharedHost === false
						? `https://${sessionLeague.mflHost}/${getLeagueYearForMflId(sessionLeague.id)}/home/${sessionLeague.id}`
						: leagueUrl(sessionLeague, '/'),
			},
		]
	: [];
import { spriteUrlFor } from '../utils/sprite-url';
/** The league's icon set, for client scripts and React islands (src/utils/sprite-url-client.ts). */
const pageSpriteUrl = spriteUrlFor(Astro.url);
---

<!DOCTYPE html>
<html lang="en" data-sprite-url={pageSpriteUrl} data-league="mfl" data-season={season?.id} data-theme-lock={modeLock} class:list={[{ dark: modeLock ? modeLock === 'dark' : themePref === 'dark' }]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<ThemeScript />
		{/* The `-v2` in every icon filename is a cache-bust, not a variant. A
		    browser keeps a favicon or touch icon for hours (and a CDN for a
		    year) keyed on its URL, so redrawing an icon in place left everyone
		    on the old placeholder. Give a redrawn icon a new filename. */}
		<link rel="icon" type="image/svg+xml" href="/assets/mfl-live/icon-v2.svg" />
		<link rel="apple-touch-icon" href="/assets/mfl-live/apple-touch-icon-v2.png" />
		{onSharedHost && (
			<link rel="manifest" href="/assets/mfl-live/site.webmanifest" crossorigin="use-credentials" />
		)}
		<meta name="theme-color" content="#14161a" data-theme-color-light="#14161a" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="MFL Live" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<Font cssVariable="--font-vend-sans" />
		{/* Both dark-mark swaps, because this board draws BOTH kinds of crest.
		    NflLogoDarkStyles covers rung 2 of the identity ladder (a franchise
		    named after an NFL club) by swapping in the mirrored 500-dark cut and
		    ringing the black-bodied marks; TeamIconDarkStyles covers rung 1 (a
		    league we run) by swapping in each franchise's own `iconDark` and
		    white-stroking the illegible ones. Both key on the image `src`, so
		    they reach React islands too. Inherited rather than reimplemented —
		    which is the argument for this board having a real dark theme instead
		    of a permanently black ground. */}
		<NflLogoDarkStyles />
		<TeamIconDarkStyles />
		<ClientRouter />
		<title>{title}</title>
	</head>
	<body>
		<a class="mfl-skip" href="#mfl-main">Skip to content</a>

		<header class="mfl-bar">
			<a class="mfl-bar__brand" href="/live" aria-label="MFL Live — home">
				{/* The MFL.football mark (public/assets/logos/mfl-football-mark.svg),
				    inlined so the bars take the bar's fixed ink and the football the
				    accent. viewBox is cropped to the glyph's own bounds. */}
				<svg class="mfl-bar__mark" viewBox="8 11 48 44" aria-hidden="true" focusable="false">
					<g fill="currentColor">
						<rect x="9" y="12" width="12" height="42" rx="6" />
						<rect x="26" y="30" width="12" height="24" rx="6" />
						<rect x="43" y="12" width="12" height="42" rx="6" />
					</g>
					<g
						fill="var(--league-accent)"
						stroke="var(--league-accent)"
						transform="translate(32 20) rotate(-15)"
					>
						<path d="M-6.5 0Q0-5.4 6.5 0Q0 5.4-6.5 0Z" stroke-width="4.5" stroke-linejoin="round" />
					</g>
				</svg>
				<span class="mfl-bar__live">Live</span>
			</a>

			<div class="mfl-bar__end">
				<MflAppMenu
					leagueLinks={leagueLinks}
					ownerName={authUser?.name ?? null}
					signedIn={Boolean(authUser)}
					signInHref={mflLoginUrl(Astro.url.pathname + Astro.url.search)}
					currentPath={Astro.url.pathname}
					showAnalytics={canViewSiteInsights(authUser)}
					showProducts={canViewProductPages(authUser)}
				/>
			</div>
		</header>

		{/* Sign-out is a POST, so it cannot be a link. Same shape as
		    NavFooter's: fetch + reload, bound on astro:page-load rather than
		    DOMContentLoaded (ClientRouter fires no DOMContentLoaded on a soft
		    navigation, so a once-only binding leaves the button dead after the
		    first in-app nav), with a dataset guard so repeated page-loads do
		    not stack listeners on a button that survived the swap. */}
		<script is:inline>
			(function () {
				function initSignOut() {
					var button = document.querySelector('[data-mfl-signout]');
					if (!button) return;
					if (button.dataset.signoutBound === '1') return;
					button.dataset.signoutBound = '1';

					button.addEventListener('click', async function () {
						button.disabled = true;
						try {
							await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include' });
						} catch (e) {
							// Clearing the cookie is the server's job. A failed call means
							// we are still signed in, and reloading shows that honestly.
						}
						window.location.reload();
					});
				}
				document.addEventListener('astro:page-load', initSignOut);
			})();
		</script>

		{/* Install prompt capture — the same block TheLeagueLayout carries, and
		    for the same reason: Chrome fires `beforeinstallprompt` ONCE, before
		    any component script runs, so the layout stashes it on `window` for
		    the board's InstallAppPrompt banner to read. The `window` flag keeps
		    the ClientRouter from stacking a listener per navigation. It only
		    ever fires where the manifest is linked (the shared host). */}
		<script is:inline>
			(function () {
				if (window.__mflInstallPromptBound) return;
				window.__mflInstallPromptBound = true;
				window.addEventListener('beforeinstallprompt', function (e) {
					e.preventDefault();
					window.__mflInstallPrompt = e;
					window.dispatchEvent(new Event('mfl:installpromptready'));
				});
				window.addEventListener('appinstalled', function () {
					window.__mflInstallPrompt = null;
					window.dispatchEvent(new Event('mfl:installpromptready'));
				});
			})();
		</script>

		{/* Visit beacon — the same one the league sites send; feeds /live/analytics. */}
		<script src="../scripts/visit-beacon.ts"></script>

		<main id="mfl-main" class="mfl-main">
			<slot />
		</main>
		{/* Body, never <head>: it renders a custom element, which ends <head> early and
		    pushes every stylesheet into <body> (unstyled flash). tests/head-custom-element-guard.test.ts */}
		<SpeedInsights />
	</body>
</html>

<style>
	@import '../styles/tokens.css';
	/* Dark-mode token overrides (scoped under html.dark) — must come after tokens.css */
	@import '../styles/tokens-dark.css';
	/* Per-league theme palettes (generated from src/themes/*.json) */
	@import '../styles/league-themes.generated.css';
	/* Site style tokens — Editorial / Primetime (generated from src/styles/site-styles/*.json) */
	@import '../styles/site-styles.generated.css';

	:global(html) {
		background: var(--page-bg);
		color-scheme: light dark;
	}

	:global(body) {
		margin: 0;
		min-height: 100dvh;
		background: var(--page-bg);
		color: var(--page-text);
		font-family: var(--font-vend-sans), system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 1rem;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	.mfl-skip {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		padding: 0.75rem 1rem;
		background: var(--content-bg);
		color: var(--page-text);
		border-radius: 0 0 0.5rem 0;
	}
	.mfl-skip:focus {
		left: 0;
	}

	/* ── The bar ──
	   Sticky because this is a board you scroll for an afternoon, and the way
	   back to the top of it should not be a scroll. `env(safe-area-inset-*)`
	   because it is installed to a home screen and runs under the notch. */
	.mfl-bar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem clamp(0.75rem, 3vw, 1.25rem);
		padding-top: calc(0.5rem + env(safe-area-inset-top, 0px));
		background: var(--breadcrumb-bar-bg);
		border-bottom: 2px solid var(--league-accent);
	}

	.mfl-bar__brand {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		text-decoration: none;
		/* The bar is the brand near-black in BOTH themes, so its ink is fixed
		   white rather than a theme token — a token here would go near-black
		   on near-black in light mode. */
		color: #ffffff;
	}

	.mfl-bar__mark {
		height: 1.3rem;
		width: auto;
		display: block;
		align-self: center;
	}

	.mfl-bar__live {
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--league-accent);
	}

	/* Everything that is not the brand now lives behind the hamburger, so the
	   bar has exactly two things in it at every width. See MflAppMenu. */
	.mfl-bar__end {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-inline-start: auto;
	}

	.mfl-main {
		padding: clamp(1rem, 4vw, 2rem) clamp(0.75rem, 3vw, 1.25rem);
		padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
	}
</style>
