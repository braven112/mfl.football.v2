---
/**
 * MFL Football — the free team logo maker, at mfl.football/team-logo. Public
 * and indexable, for any fantasy football team on any site, signed in or not.
 *
 * The builder itself is `TeamLogoBuilder` (also inside /video's Make my logo
 * dialog, and the same choices as the app's Create team logo screen): the
 * owner picks a style, two or three team colors and the kind of art, and
 * copies a prompt into ChatGPT or Gemini. We make no images (decided with
 * Brandon 2026-10-27). Every word of the prompt comes from
 * `src/utils/team-logo-prompt.ts`, which the client script imports, so the
 * site and the app's `/api/mfl-live/logo-prompt` write the same text.
 *
 * Under it, `LogoTracer` turns the finished PNG into an SVG, free for
 * everyone (2026-11-09; it launched as Pro). The examples are real runs of
 * the tool (`src/data/logo-maker-examples.ts`); "Use this prompt" fills the
 * builder from one. This is the ONE public logo maker page (Brandon,
 * 2026-11-09): the search copy, FAQ and structured data that were drafted for
 * a separate /fantasy-football-logo-maker landing page live here instead.
 *
 * Importing your own MFL teams is the paid upgrade (2026-10-29); it is not on
 * sale yet, so its button is the "I'm interested" door. The owner's teams
 * pre-fill the name when signed in; nothing else needs the session.
 */
import MflAppLayout from '../layouts/MflAppLayout.astro';
import { getMflLiveUser } from '../utils/auth';
import { listOwnerLeagues } from '../utils/live/owner-league';
import TeamLogoBuilder from '../components/shared/mfl-live/TeamLogoBuilder.astro';
import LogoTracer from '../components/shared/live/LogoTracer.astro';
import ProductInterest from '../components/shared/ProductInterest.astro';
import { FORMER_BRAND, type Faq } from '../data/mfl-services';
import { LOGO_MAKER_EXAMPLES } from '../data/logo-maker-examples';
import { LOGO_STYLES } from '../utils/team-logo-prompt';
import { breadcrumbJsonLd, faqJsonLd, jsonLdScript, organizationJsonLd } from '../utils/structured-data';
import '../styles/mfl-live.css';

export const prerender = false;

const PATH = '/team-logo';
const user = getMflLiveUser(Astro.request);
const owned = user ? await listOwnerLeagues(user).catch(() => null) : null;
const teams = owned?.ok ? owned.leagues.map((l) => ({ name: l.franchiseName, league: l.leagueName })) : [];
const styleLabel = (id: string) => LOGO_STYLES.find((s) => s.id === id)?.label ?? id;

const faqs: Faq[] = [
	{ q: 'Is the fantasy football logo maker free?', a: `Yes. It is free, needs no account, and works for any fantasy football team on any site. It is made by MFL Football, formerly ${FORMER_BRAND}.` },
	{ q: 'How do I make a fantasy football logo with AI?', a: 'Type your team name and a mascot idea, pick a style and two or three team colors, then copy the prompt. Paste it into ChatGPT or Gemini, ask for a few tries, and keep the one that still reads when it is tiny.' },
	{ q: 'What makes a fantasy football logo look professional?', a: 'A mascot you can picture. Your team name can be a joke or a pun, but give the logo a real animal or object to draw, like a rhino or a viking helmet. A pun is hard to draw; a rhino is not. Then keep it to a few team colors plus white and black.' },
	{ q: 'Can my logo have letters on it?', a: 'Skip the team name: words can’t be read once a logo is shrunk to a team icon. One stylized letter, like an M, or two letters joined into one symbol, like an interlocking NY, works well, because it reads as a shape.' },
	{ q: 'Why does the tool write a prompt instead of making the picture?', a: 'You already have a better image maker than we could run: ChatGPT and Gemini are free to try. The prompt carries the rules a good team logo needs, so whichever one you use gets them right.' },
	{ q: 'What size should a fantasy football logo be?', a: 'A square logo at 1024 × 1024 pixels on a transparent background covers every fantasy site. Banners are 1900 × 316. The prompt asks for these sizes, and for a design that still reads when shrunk to 40 pixels.' },
	{ q: 'Why would I want my logo as an SVG?', a: 'A PNG is a grid of dots that gets blurry when you make it bigger. An SVG is drawn from shapes, so it stays sharp at any size: print shops want one for shirts and jerseys, engravers and sticker makers cut from one, and it blows up to banner size with clean edges. The tracer on this page turns your finished PNG into an SVG, free.' },
	{ q: 'Can I use an NFL team’s logo for my fantasy team?', a: 'No. NFL, college and pro logos are trademarks. Every prompt asks for an original design, so ask for new art inspired by your team instead.' },
	{ q: 'How do I put the logo on my MyFantasyLeague team?', a: 'On MFL, open your franchise settings and paste the image address into the Icon (square) or Logo (banner) field. MFL links to an image hosted on the web, so upload the file somewhere public first.' },
];

const jsonLd = [
	organizationJsonLd(),
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'Free Fantasy Football Logo Maker',
		url: `https://mfl.football${PATH}`,
		applicationCategory: 'DesignApplication',
		operatingSystem: 'Any',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		description: 'Free AI prompt builder for fantasy football team logos: pick a style and team colors, paste the prompt into ChatGPT or Gemini, then turn the finished PNG into an SVG.',
		publisher: { '@id': 'https://mfl.football/#organization' },
	},
	faqJsonLd(faqs),
	breadcrumbJsonLd([
		{ name: 'MFL Football', path: '/' },
		{ name: 'Team logo maker', path: PATH },
	]),
];
---

<MflAppLayout
	title="Free Fantasy Football Logo Maker — MFL Football"
	description="Make a fantasy football team logo free: pick a style and team colors, paste the prompt into ChatGPT or Gemini, then turn it into an SVG. No account needed."
	ogImage="/assets/logo-maker/examples.png"
>
	{jsonLd.map((block) => <script is:inline type="application/ld+json" set:html={jsonLdScript(block)} />)}
	<section class="mls tlogo-page">
		<a class="mls__back" href="/live">&larr; Live</a>
		<h1 class="mls__title">Create a team logo</h1>
		<p class="mls__lede">
			Pick a look and we&rsquo;ll write the prompt. Paste it into ChatGPT or Gemini to make the picture, then
			turn it into an SVG right here. Free, no account, any league.
		</p>
		<TeamLogoBuilder teams={teams} />
		<LogoTracer />

		{LOGO_MAKER_EXAMPLES.length > 0 && (
		<section class="lm-block" aria-labelledby="lm-examples">
			<h2 id="lm-examples">Made with this tool</h2>
			<p>Real logos from these prompts. Tap &ldquo;Use this prompt&rdquo; to start from the same choices.</p>
			<ul class="lm-examples" role="list">
				{LOGO_MAKER_EXAMPLES.map((ex) => (
					<li class="lm-example">
						<div class="lm-example__art">
							<img src={ex.image} alt={ex.alt} width="512" height="512" loading="lazy" decoding="async" />
						</div>
						<h3 class="lm-example__name">{ex.teamName}</h3>
						<p class="lm-example__style">{styleLabel(ex.style)}</p>
						<button
							type="button"
							class="cta cta--ghost lm-example__use"
							data-logo-use={JSON.stringify({ teamName: ex.teamName, idea: ex.idea, style: ex.style, colors: ex.colors, kind: ex.kind })}
						>Use this prompt</button>
					</li>
				))}
			</ul>
		</section>
		)}

		<section class="lm-block" aria-labelledby="lm-how">
			<h2 id="lm-how">How it works</h2>
			<ol class="lm-steps">
				<li><strong>Name it.</strong> Your team name and a mascot, like &ldquo;a charging boar with a football.&rdquo; A silly team name is fine, but give it a mascot you can picture, like an animal or an object: that is what makes a clean, professional logo.</li>
				<li><strong>Pick a look.</strong> A crest, mascot, monogram, retro patch or round badge, in two or three team colors. The tool tells you when two colors are too close to tell apart on a small logo.</li>
				<li><strong>Paste the prompt.</strong> ChatGPT or Gemini makes the picture. The prompt asks for a transparent background, the right size, and an original design with no team name on it: words can&rsquo;t be read once a logo is small. One stylized letter, like an M, or two letters joined into one symbol is fine.</li>
				<li><strong>Make it an SVG.</strong> Upload the finished PNG above and download a vector version that stays sharp at any size, for shirts, banners and stickers. Free, no account needed.</li>
			</ol>
		</section>

		<section class="lm-block" aria-labelledby="lm-pro">
			<h2 id="lm-pro">Play on MyFantasyLeague?</h2>
			<p>
				Soon: bring in every team you own on MFL and get a logo prompt for each one in a single tap, with your
				team names and colors already filled in.
			</p>
			<button type="button" class="cta cta--primary" data-interest="owner-suite" data-interest-name="Logo prompts for every MFL team you own">I&rsquo;m interested</button>
		</section>

		<section class="lm-block" aria-labelledby="lm-faq">
			<h2 id="lm-faq">Questions</h2>
			<dl class="lm-faq">
				{faqs.map((f) => (
					<div>
						<dt>{f.q}</dt>
						<dd>{f.a}</dd>
					</div>
				))}
			</dl>
		</section>
	</section>
	<ProductInterest />
</MflAppLayout>

<style>
	.lm-block {
		padding-top: 2.5rem;
		line-height: 1.55;
	}
	.lm-block h2 {
		margin: 0 0 0.75rem;
		font-size: var(--font-size-xl);
		line-height: 1.1;
	}
	.lm-block p {
		margin: 0 0 0.75rem;
	}
	.lm-examples {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.lm-example {
		display: grid;
		justify-items: center;
		gap: 0.35rem;
		padding: 1rem 0.75rem;
		border: 1px solid var(--color-border-subtle);
		border-radius: 14px;
		text-align: center;
	}
	/* One light ground in both themes: the logos are drawn for transparency
	   with dark outlines, which vanish on a dark card. */
	.lm-example__art {
		width: 100%;
		display: grid;
		place-items: center;
		padding: 0.5rem;
		border-radius: 10px;
		background: #f4f1ea;
	}
	.lm-example__art img {
		display: block;
		width: 100%;
		max-width: 16rem;
		height: auto;
	}
	.lm-example__name {
		margin: 0.25rem 0 0;
		font-size: var(--font-size-base);
		line-height: 1.2;
	}
	.lm-example__style {
		margin: 0;
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
	}
	.lm-example__use {
		margin-top: 0.4rem;
	}
	.lm-steps {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding-left: 1.25rem;
	}
	.lm-faq {
		display: grid;
		gap: 1rem;
		margin: 0;
	}
	.lm-faq dt {
		font-weight: 700;
	}
	.lm-faq dd {
		margin: 0.35rem 0 0;
		color: var(--color-text-secondary);
	}
	/* Phones: one example a row, never a sideways scroll. */
	@media (max-width: 760px) {
		.lm-examples {
			grid-template-columns: minmax(0, 1fr);
		}
		.lm-example__use {
			width: 100%;
		}
	}
</style>
