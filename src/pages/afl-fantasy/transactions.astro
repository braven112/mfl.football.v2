---
/**
 * Transactions (afl-fantasy) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/transactions/TransactionsPage.
 *
 * The feed MAPS are built HERE, so the shared component never names a
 * league's data path. Each is lazy, in the shape of a lazy `import.meta.glob`:
 * its KEYS answer "which seasons exist", while only the season being viewed is
 * actually read — through the league-data loader (src/utils/league-data.ts),
 * so no season is bundled into the server function.
 */
import TransactionsPage from '../../components/shared/transactions/TransactionsPage.astro';
import { getLeagueBySlug } from '../../config/leagues';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';
import type { LazyFeedGlob } from '../../utils/mfl-feed-glob';

export const prerender = false;

const league = getLeagueBySlug('afl-fantasy')!;
const lazyFeeds = (paths: string[]): LazyFeedGlob =>
  Object.fromEntries(paths.map((p) => [p, () => loadLeagueData(p)]));

const transactionFeeds = lazyFeeds(listLeagueData(`${league.dataPath}/mfl-feeds/*/transactions.json`));
const leagueFeeds = lazyFeeds(listLeagueData(`${league.dataPath}/mfl-feeds/*/league.json`));
// Schefter's feed and its archive years, for the story on each move. Same
// lazy shape: only the files for the season being viewed are read.
const schefterPosts = lazyFeeds([
  ...listLeagueData(`${league.dataPath}/schefter-feed.json`),
  ...listLeagueData(`${league.dataPath}/schefter-archive/*.json`),
]);
---

<TransactionsPage leagueSlug="afl-fantasy" transactionFeeds={transactionFeeds} leagueFeeds={leagueFeeds} schefterPosts={schefterPosts} />
