---
/**
 * Record Book (AFL) — thin route wrapper.
 *
 * Shared implementation: components/shared/league-history/RecordBookPage.
 * The dataset is imported HERE because a static import specifier can't be a
 * runtime variable, and the gate lives here because `Astro.redirect()` only
 * redirects from a page. Open to every visitor since 2026-10-25
 * (utils/league-history/access.ts).
 */
import RecordBookPage from '../../../components/shared/league-history/RecordBookPage.astro';
import { getAuthUser } from '../../../utils/auth';
import { mflLoginUrl } from '../../../utils/mfl-login-redirect';
import { canViewLeagueHistory } from '../../../utils/league-history/access';
import { getLeagueBySlug } from '../../../config/leagues';
import { loadLeagueData } from '../../../utils/league-data';

// Derived history files, read through the league-data loader
// (src/utils/league-data.ts) instead of being bundled into the function.
const AFL_DERIVED = `${getLeagueBySlug('afl-fantasy')!.dataPath}/derived`;
const [historyData, keeperHistory, pickTrades] = await Promise.all([
  loadLeagueData<any>(`${AFL_DERIVED}/league-history.json`),
  loadLeagueData<any>(`${AFL_DERIVED}/keeper-history.json`),
  loadLeagueData<any>(`${AFL_DERIVED}/pick-trades.json`),
]);

export const prerender = false;

const authUser = getAuthUser(Astro.request);
if (!canViewLeagueHistory(authUser)) {
  if (!authUser) return Astro.redirect(mflLoginUrl(Astro.url.pathname));
  return Astro.rewrite('/_not-found');
}
---

<RecordBookPage leagueSlug="afl-fantasy" data={historyData} keepers={keeperHistory} picks={pickTrades} />
