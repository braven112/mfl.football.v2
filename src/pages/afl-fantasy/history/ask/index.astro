---
/**
 * Ask the History (AFL) — thin route wrapper for the ask screen.
 *
 * Shared implementation: components/shared/league-history/HistoryAskPage.
 * The dataset is imported HERE because a static import specifier can't be a
 * runtime variable. Reading is open like every history page; asking is gated
 * inside (canAskLeagueHistory).
 */
import HistoryAskPage from '../../../../components/shared/league-history/HistoryAskPage.astro';
import { getLeagueBySlug } from '../../../../config/leagues';
import { loadLeagueData } from '../../../../utils/league-data';

// Derived history files, read through the league-data loader
// (src/utils/league-data.ts) instead of being bundled into the function.
const AFL_DERIVED = `${getLeagueBySlug('afl-fantasy')!.dataPath}/derived`;
const [historyData] = await Promise.all([
  loadLeagueData<any>(`${AFL_DERIVED}/league-history.json`),
]);

export const prerender = false;
---

<HistoryAskPage leagueSlug="afl-fantasy" data={historyData} />
