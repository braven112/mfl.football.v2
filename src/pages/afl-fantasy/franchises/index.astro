---
/**
 * AFL franchises index — route over the shared franchises index
 * (src/components/shared/franchises/FranchisesIndexPage.astro), which package
 * leagues render too. What stays here is the AFL's own: its career stats
 * source (awards-history era records, src/utils/afl-career-stats.ts), its
 * two-conference grouping and title-first sort, and its title badges
 * (AflFranchiseCardBadges).
 */
import FranchisesIndexPage, { type FranchiseCardRow } from '../../../components/shared/franchises/FranchisesIndexPage.astro';
import AflFranchiseCardBadges from '../../../components/afl-fantasy/AflFranchiseCardBadges.astro';
import aflConfig from '../../../../data/afl-fantasy/afl.config.json';
import { getFranchiseTitleProgress, type TitleTypeProgress } from '../../../utils/afl-awards';
import { getAflCareerStats, type AflCareerStats } from '../../../utils/afl-career-stats';
import { getConferenceName, type ConferenceId } from '../../../utils/afl-conference';
import { buildHistoricalIdentities } from '../../../utils/franchise-eras';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import ownerTenures from '../../../../data/afl-fantasy/derived/owner-tenures.json';
import { ownerSlugForIdentity } from '../../../utils/owner-links';

const { byFranchise, yearsCovered } = getAflCareerStats();
const firstYear = yearsCovered[0];
const lastYear = yearsCovered[yearsCovered.length - 1];

type AflTeamConfig = (typeof aflConfig.teams)[number];

interface CardRow {
  team: AflTeamConfig;
  stats: AflCareerStats | null;
  /** Title types this franchise has won, prestige order. */
  titles: TitleTypeProgress[];
  aflTitles: number;
}
const rows: CardRow[] = (aflConfig.teams ?? []).map((team) => {
  const progress = getFranchiseTitleProgress(team.franchiseId);
  return {
    team,
    stats: byFranchise.get(team.franchiseId) ?? null,
    titles: progress.types.filter((t) => t.won),
    aflTitles: progress.types.find((t) => t.key === 'afl')?.years.length ?? 0,
  };
});

// TheLeague's sort — championships desc, then career wins desc — applied
// within each conference section.
const byTitlesThenWins = (a: CardRow, b: CardRow) =>
  b.aflTitles - a.aflTitles || (b.stats?.wins ?? 0) - (a.stats?.wins ?? 0);

const conferences = (['00', '01'] as ConferenceId[]).map((id) => ({
  id,
  name: getConferenceName(id),
  rows: rows.filter((r) => r.team.conference === id).sort(byTitlesThenWins),
}));

function recordString(s: AflCareerStats | null): string {
  if (!s) return '0-0';
  return s.ties > 0 ? `${s.wins}-${s.losses}-${s.ties}` : `${s.wins}-${s.losses}`;
}

function winPct(s: AflCareerStats | null): string {
  const total = s ? s.wins + s.losses + s.ties : 0;
  if (!s || !total) return '.000';
  const pct = (s.wins + s.ties * 0.5) / total;
  return pct.toFixed(3).replace(/^0/, '');
}

const pointsApproximate = rows.some((r) => r.stats?.pointsApproximate);
const pointsMissingYears = [
  ...new Set(rows.flatMap((r) => r.stats?.pointsMissingYears ?? [])),
].sort((a, b) => a - b);

// Every distinct historical identity across all franchises, newest-first —
// grouped by ownerEra when set, otherwise by normalized name, skipping
// groups whose dominant name matches the current franchise (see
// buildHistoricalIdentities). AFL detail pages render a slot's complete
// name history — the current owner's lineage AND previous owners — so every
// identity has a real landing spot at #name-history.
const historicalIdentities = buildHistoricalIdentities(aflConfig.teams as any[]);

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;

// Every entry in this strip belongs to SOMEBODY, and until the owners feature
// existed there was nowhere to send them: the blanket `#name-history` link
// dropped all 95 onto the same section of whichever franchise slot happens to
// hold that name today, which for a prior owner's identity is a different
// team's page. The owner page is where those seasons actually live. The
// `#name-history` link stays as the fallback — it is at least the right slot.
const identityHref = (h: (typeof historicalIdentities)[number]): string => {
  const ownerSlug = ownerSlugForIdentity(ownerTenures.identityIndex, h.name, h.yearStart);
  const path = ownerSlug
    ? `/afl-fantasy/owners/${ownerSlug}`
    : `/afl-fantasy/franchises/${h.franchiseId}#name-history`;
  return resolveLeaguePath(path, hideLeaguePrefix);
};

const toCard = (r: CardRow): FranchiseCardRow => ({
  team: r.team,
  record: recordString(r.stats),
  pct: winPct(r.stats),
  seasons: r.stats?.seasons ?? 0,
  points: r.stats?.pointsFor ?? 0,
  subtitle: `${r.team.division} Division · ${r.team.tier}`,
  titles: r.titles,
});

const notes = [
  ...(pointsApproximate ? ["Some seasons' points are approximated from per-game averages."] : []),
  ...(pointsMissingYears.length > 0
    ? [
        `MFL has no points data for ${pointsMissingYears.join(', ')}; those seasons count toward records but not points totals.`,
      ]
    : []),
];
---

<FranchisesIndexPage
  leagueSlug="afl-fantasy"
  title="Franchises | AFL"
  heading="AFL Franchises"
  breadcrumbs={[{ label: 'AFL Fantasy', href: '/afl-fantasy' }, { label: 'Franchises' }]}
  lede={`Career records, championships, and title honors for all ${rows.length} franchises — ${conferences[0].rows.length} in the American League, ${conferences[1].rows.length} in the National League — across ${firstYear}–${lastYear}. Click a card for the full franchise page.`}
  notes={notes}
  groups={conferences.map((c) => ({ name: c.name, rows: c.rows.map(toCard) }))}
  CardBadges={AflFranchiseCardBadges}
  historicalIdentities={historicalIdentities}
  identityHref={identityHref}
/>
