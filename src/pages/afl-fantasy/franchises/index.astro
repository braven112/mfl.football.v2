---
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../../components/theleague/Breadcrumbs.astro';
import aflConfig from '../../../../data/afl-fantasy/afl.config.json';
import {
  getFranchiseTitleProgress,
  type TitleTypeKey,
  type TitleTypeProgress,
} from '../../../utils/afl-awards';
import { getAflCareerStats, type AflCareerStats } from '../../../utils/afl-career-stats';
import { getConferenceName, type ConferenceId } from '../../../utils/afl-conference';
import { buildHistoricalIdentities } from '../../../utils/franchise-eras';
import { stripBadgeYear, namespaceBadgeIds } from '../../../utils/afl-badge';
import { PREMIER_LEAGUE, D_LEAGUE, getTierLogo, getTierLogoDark } from '../../../utils/afl-tier-logo';
import ThemeImage from '../../../components/ThemeImage.astro';

const { byFranchise, yearsCovered } = getAflCareerStats();
const firstYear = yearsCovered[0];
const lastYear = yearsCovered[yearsCovered.length - 1];

type AflTeamConfig = (typeof aflConfig.teams)[number];

// Badge art loaded raw (same pattern as the franchise detail page) so the
// year stamp can be stripped for this "timeless" aggregate-count context —
// the card shows a lifetime total, not a single win, so no year applies.
const badgeSvgRaw = import.meta.glob<string>(
  '../../../../public/assets/afl/awards/*.svg',
  { query: '?raw', import: 'default', eager: true }
);
const BADGE_SVG: Record<string, string> = {};
for (const [p, raw] of Object.entries(badgeSvgRaw)) {
  BADGE_SVG[p.split('/').pop() as string] = raw;
}
// Strip once per FILE up front (there are only ~13), not once per card — the
// same badge file (e.g. afl-championship.svg) renders once per franchise
// that's won it, and stripBadgeYear's output only depends on the filename.
const STRIPPED_BADGE_SVG: Record<string, string> = {};
for (const [filename, raw] of Object.entries(BADGE_SVG)) {
  STRIPPED_BADGE_SVG[filename] = stripBadgeYear(raw);
}
// uid is franchiseId + title-type key — unique per card (each type renders at
// most once per franchise) — so every inlined badge's internal ids (clip
// paths, gradients) stay collision-free across the whole grid. See
// namespaceBadgeIds' doc comment for why this matters even though today's
// art makes the collision visually harmless.
function timelessBadge(filename: string, uid: string): string {
  return namespaceBadgeIds(STRIPPED_BADGE_SVG[filename] ?? '', uid);
}

// Division names map to the same award slugs the franchise detail page uses
// for its own locked-placeholder slot (DIVISION_SLUG_BY_NAME in [id].astro).
// Hard-mapped by name rather than keyed off team.conference because the AFL's
// current 4-division layout strictly partitions divisions by conference
// (North/South are always American League, East/West always National) — see
// the divisions listed for `conferences` in afl.config.json. This is also why
// only 4 of the 6 division award slugs are covered: al-central and nl-pacific
// are retired (pre-2013) divisions no current team plays in — see the
// division-structure gotcha in afl-awards.ts and the 2026-06-27 entry in
// docs/claude/insights/features/afl-trophy-wall.md — so badgeFilenameFor()
// correctly returns null for them rather than needing a slot that can't occur.
const DIVISION_SLUG: Record<string, string> = {
  North: 'al-north',
  South: 'al-south',
  East: 'nl-east',
  West: 'nl-west',
};

// Which badge art represents a title TYPE for a given team. Conference and
// division each collapse several award slugs (any conference / any division
// counts toward the type) — the card shows the team's OWN current conference
// / division art, matching how the detail page picks a single locked slot.
// Premier/D-League intentionally return null: their championship banners are
// visually near-identical to the AFL championship banner (same medallion
// layout), so those two render the tier LOGO instead (see the template).
function badgeFilenameFor(key: TitleTypeKey, team: AflTeamConfig): string | null {
  switch (key) {
    case 'afl':
      return 'afl-championship.svg';
    case 'nit':
      return 'nit.svg';
    case 'conference':
      return team.conference === '00' ? 'al-champion.svg' : 'nl-champion.svg';
    case 'division': {
      const slug = DIVISION_SLUG[team.division as string];
      return slug ? `${slug}.svg` : null;
    }
    default:
      return null;
  }
}

interface CardRow {
  team: AflTeamConfig;
  stats: AflCareerStats | null;
  /** Title types this franchise has won, prestige order. */
  titles: TitleTypeProgress[];
  aflTitles: number;
}

const rows: CardRow[] = (aflConfig.teams ?? []).map((team) => {
  const progress = getFranchiseTitleProgress(team.franchiseId);
  return {
    team,
    stats: byFranchise.get(team.franchiseId) ?? null,
    titles: progress.types.filter((t) => t.won),
    aflTitles: progress.types.find((t) => t.key === 'afl')?.years.length ?? 0,
  };
});

// TheLeague's sort — championships desc, then career wins desc — applied
// within each conference section.
const byTitlesThenWins = (a: CardRow, b: CardRow) =>
  b.aflTitles - a.aflTitles || (b.stats?.wins ?? 0) - (a.stats?.wins ?? 0);

const conferences = (['00', '01'] as ConferenceId[]).map((id) => ({
  id,
  name: getConferenceName(id),
  rows: rows.filter((r) => r.team.conference === id).sort(byTitlesThenWins),
}));

function recordString(s: AflCareerStats | null): string {
  if (!s) return '0-0';
  return s.ties > 0 ? `${s.wins}-${s.losses}-${s.ties}` : `${s.wins}-${s.losses}`;
}

function winPct(s: AflCareerStats | null): string {
  const total = s ? s.wins + s.losses + s.ties : 0;
  if (!s || !total) return '.000';
  const pct = (s.wins + s.ties * 0.5) / total;
  return pct.toFixed(3).replace(/^0/, '');
}

const TITLE_TOOLTIP: Record<TitleTypeKey, string> = {
  afl: 'AFL Champion',
  premier: 'Premier League titles',
  conference: 'Conference titles',
  division: 'Division titles',
  dleague: 'D-League titles',
  nit: 'NIT titles',
};

const titleYears = (t: TitleTypeProgress): string =>
  t.years.slice().sort((a, b) => a - b).join(', ');

const pointsApproximate = rows.some((r) => r.stats?.pointsApproximate);
const pointsMissingYears = [
  ...new Set(rows.flatMap((r) => r.stats?.pointsMissingYears ?? [])),
].sort((a, b) => a - b);

// Every distinct historical identity across all franchises, newest-first —
// grouped by ownerEra when set, otherwise by normalized name, skipping
// groups whose dominant name matches the current franchise (see
// buildHistoricalIdentities). AFL detail pages render a slot's complete
// name history — the current owner's lineage AND previous owners — so every
// identity has a real landing spot at #name-history.
const historicalIdentities = buildHistoricalIdentities(aflConfig.teams as any[]);
---

<TheLeagueLayout title="Franchises | AFL">
  <div class="franchises-page">
    <header>
      <Breadcrumbs items={[
        { label: 'AFL Fantasy', href: '/afl-fantasy' },
        { label: 'Franchises' },
      ]} />
      <h1>AFL Franchises</h1>
      <p class="lede">
        Career records, championships, and title honors for all
        {rows.length} franchises — {conferences[0].rows.length} in the
        American League, {conferences[1].rows.length} in the National
        League — across {firstYear}–{lastYear}. Click a card for the full
        franchise page.
      </p>
      {pointsApproximate && (
        <p class="points-note">Some seasons' points are approximated from per-game averages.</p>
      )}
      {pointsMissingYears.length > 0 && (
        <p class="points-note">
          MFL has no points data for {pointsMissingYears.join(', ')}; those
          seasons count toward records but not points totals.
        </p>
      )}
    </header>

    {conferences.map((conf) => (
      <section class="conference-section">
        <h2 class="conference-title">
          {conf.name}
          <span class="conference-count">{conf.rows.length} teams</span>
        </h2>
        <div class="franchise-grid">
          {conf.rows.map(({ team, stats, titles }) => (
            <a
              class="franchise-card"
              href={`/afl-fantasy/franchises/${team.franchiseId}`}
              style={team.colorPrimary ? `--accent: ${team.colorPrimary};` : ''}
            >
              <div class="card-body">
                <div class="lockup">
                  <img
                    class="lockup-icon"
                    src={team.icon}
                    alt=""
                    loading="lazy"
                    width="64"
                    height="64"
                  />
                  <div class="lockup-text">
                    <h3 class="name">{team.nameMedium || team.name}</h3>
                    <p class="division">{team.division} Division · {team.tier}</p>
                  </div>
                </div>
                <dl class="stats">
                  <div>
                    <dt>All-Time</dt>
                    <dd>{recordString(stats)} <span class="dim">({winPct(stats)})</span></dd>
                  </div>
                  <div>
                    <dt>Seasons</dt>
                    <dd>{stats?.seasons ?? 0}</dd>
                  </div>
                  <div>
                    <dt>Points</dt>
                    <dd>{Math.round(stats?.pointsFor ?? 0).toLocaleString()}</dd>
                  </div>
                </dl>
                <ul class="badges" aria-label="Titles">
                  {titles.map((t) => (
                    <li
                      class="badge"
                      title={`${TITLE_TOOLTIP[t.key]}: ${titleYears(t)}`}
                    >
                      <span class="icon" aria-hidden="true">
                        {t.key === 'premier' || t.key === 'dleague' ? (
                          <ThemeImage
                            src={getTierLogo(t.key === 'premier' ? PREMIER_LEAGUE : D_LEAGUE)}
                            darkSrc={getTierLogoDark(t.key === 'premier' ? PREMIER_LEAGUE : D_LEAGUE)}
                            alt=""
                            class="badge-tier-logo"
                          />
                        ) : (
                          <span
                            class="badge-svg"
                            set:html={timelessBadge(badgeFilenameFor(t.key, team) ?? '', `${team.franchiseId}-${t.key}`)}
                          />
                        )}
                      </span>
                      <span>{t.years.length}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    {historicalIdentities.length > 0 && (
      <section class="historical-identities">
        <h2>Former Identities</h2>
        <p class="historical-identities__sub">
          Every name these clubs have played under — punitive last-place
          rebrands included. Each links to the franchise's name history.
        </p>
        <ul class="identity-list">
          {historicalIdentities.map((h) => (
            <li>
              <a href={`/afl-fantasy/franchises/${h.franchiseId}#name-history`}>
                {h.icon && <img class="identity-icon" src={h.icon} alt="" loading="lazy" width="32" height="32" />}
                <strong>{h.name}</strong>
                <span class="identity-years">{h.yearStart === h.yearEnd ? h.yearStart : `${h.yearStart}–${h.yearEnd}`}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</TheLeagueLayout>

<style>
  .franchises-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl, 32px) var(--spacing-md, 16px) var(--spacing-2xl, 48px);
  }

  header {
    margin-bottom: var(--spacing-xl, 32px);
  }

  h1 {
    margin: 0.25rem 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--page-text, #1a1a1a);
  }

  .lede {
    margin: 0;
    color: var(--content-text-muted, #6b7280);
    max-width: 60ch;
  }

  .points-note {
    margin: var(--spacing-sm, 8px) 0 0;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
  }

  .conference-section {
    margin-bottom: var(--spacing-2xl, 48px);
  }

  .conference-title {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-lg, 24px);
    display: flex;
    align-items: center;
    gap: var(--spacing-md, 16px);
    padding-bottom: var(--spacing-sm, 8px);
    border-bottom: 2px solid var(--content-border, #e5e7eb);
    color: var(--league-accent, #c41e3a);
  }

  .conference-count {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--content-text-muted, #6b7280);
  }

  .franchise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-md, 16px);
  }

  .franchise-card {
    --accent: var(--league-accent, #c41e3a);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .card-body {
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e5e7eb);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  :global(html.dark) .card-body {
    box-shadow: 0 0 0 1px var(--content-border, #555);
  }

  .franchise-card:hover .card-body {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    border-color: var(--accent);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lockup-icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .lockup-text {
    min-width: 0;
  }

  .name {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.2;
    color: var(--page-text, #1a1a1a);
  }

  .division {
    margin: 0.125rem 0 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted, #6b7280);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stats dt {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted, #6b7280);
    font-weight: 600;
  }

  .stats dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--page-text, inherit);
  }

  .dim {
    color: var(--content-text-muted, #6b7280);
    font-weight: 400;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-top: auto;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.125rem 0.5rem 0.125rem 0.1875rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--content-bg-muted, #f5f5f5);
    color: var(--content-text-muted, #555);
  }

  /* The brand badge art (or tier logo) carries its own color now, so the
     chip itself stays a neutral ring rather than a per-type pastel — a
     colored pill behind full-color art fights the art instead of framing
     it. Ring, not fill, keeps chips legible against html.dark's page bg. */
  :global(html.dark) .badge {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .badge .icon {
    display: flex;
    align-items: center;
    line-height: 0;
  }

  /* Award badge art (afl-championship / conference / division / nit) —
     inlined raw SVG with its year stamp stripped (timeless aggregate count). */
  .badge .icon :global(svg) {
    display: block;
    height: 22px;
    width: auto;
  }

  /* Premier League / D-League tier logo — an <img> via ThemeImage, not
     inline SVG, so it's sized directly rather than through the svg rule
     above. Their championship banners look like the AFL medallion, so the
     tier mark stands in for those two badge types instead. */
  :global(.badge-tier-logo) {
    height: 20px;
    width: auto;
    object-fit: contain;
  }

  .historical-identities {
    margin-top: var(--spacing-2xl, 48px);
    padding-top: var(--spacing-lg, 24px);
    border-top: 1px solid var(--content-border, #e5e7eb);
  }

  .historical-identities h2 {
    margin: 0 0 0.25rem;
    /* AFL editorial section title — 0.9rem (UFC Sans Condensed compensation) */
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-left: 0.625rem;
    border-left: 2px solid var(--league-accent, #c41e3a);
    color: var(--page-text, #111827);
  }

  .historical-identities__sub {
    margin: var(--spacing-sm, 8px) 0 var(--spacing-md, 16px);
    padding-left: 0.625rem;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
    max-width: 60ch;
  }

  .identity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }

  .identity-list a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e5e7eb);
    text-decoration: none;
    color: var(--page-text, #111827);
    font-size: 0.875rem;
  }

  .identity-list a:hover {
    border-color: var(--league-accent, #c41e3a);
  }

  .identity-list a strong {
    flex: 1;
    min-width: 0;
    /* break-word (not anywhere) — anywhere collapses the flex item to
       min-content and splits AFL's long names mid-word */
    overflow-wrap: break-word;
  }

  .identity-list .identity-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--content-bg, #fff);
  }

  .identity-years {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
    font-variant-numeric: tabular-nums;
  }
</style>
