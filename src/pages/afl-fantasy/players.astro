---
/**
 * Free Agents (AFL) — thin route wrapper around the AFL-family players page
 * (components/afl-family/PlayersPage), shared with the custom-site demo's
 * keeper slot. The data imports stay HERE: a glob or import specifier cannot
 * be a runtime variable, and importing every league's snapshot in the shared
 * component would ship them all on every render.
 *
 * SSR, not prerendered — see the component's notes (apex rewrites need an
 * SSR route; the derived snapshot keeps the function small).
 */
import PlayersPage from '../../components/afl-family/PlayersPage.astro';
import freeAgentsData from '../../../data/afl-fantasy/derived/free-agents.json';
import { getLeagueBySlug } from '../../config/leagues';

// league.json is ~12 KB, so an era-filtered glob costs nothing (the megafile
// guard in tests/current-era-feed-globs.test.ts is about players.json).
const leagueFeedModules = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/league.json', {
  eager: true,
});
const calendarModules = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/calendar.json', {
  eager: true,
});
---

<PlayersPage
  league={getLeagueBySlug('afl-fantasy')!}
  freeAgentsData={freeAgentsData}
  leagueFeedModules={leagueFeedModules}
  calendarModules={calendarModules}
  logoSrc="/assets/logos/afl-logo.svg"
/>
