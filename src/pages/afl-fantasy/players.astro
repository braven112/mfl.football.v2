---
/**
 * AFL Free Agents Page — player research tool focused on available players.
 *
 * A leaner sibling of TheLeague's /theleague/players. AFL has no salary cap,
 * contracts, auction, or surplus value (see leagues-data.mjs → afl-fantasy
 * features: contracts:false, salaryCap:false), so this page deliberately drops
 * every cap/contract/salary/auction/surplus/DEF-spotlight column that page
 * carries and shows only browse-relevant columns: identity, age, experience,
 * draft, physicals, dynasty ADP, last-season points, and projected points.
 *
 * Data is loaded at build time from the AFL MFL feed JSON (data/afl-fantasy),
 * with roster-membership flags re-derived per request from the live MFL
 * rosters API (see the live overlay note below) so adds/drops show up within
 * about a minute instead of waiting for the next deploy.
 *
 * AFL is a duplicate-player conference league (registry duplicatePlayers:
 * true): the same NFL player can be rostered once per conference, so
 * availability is per-conference. The page renders ONE conference at a time
 * — a hard boundary, because an AL owner can't add an NL-available player —
 * defaulting to the signed-in owner's conference (AL otherwise), with a
 * hero switcher to view the other conference. Within the active view,
 * "rostered" means rostered in THAT conference; rows revealed by "Include
 * rostered" carry an "FA in <other>" tag when the other conference can
 * still add them.
 */
import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import CollegeLogoDarkStyles from '../../components/CollegeLogoDarkStyles.astro';
import PlayerDetailsModal from '../../components/theleague/PlayerDetailsModal.astro';
import { resolveLeaguePath } from '../../utils/nav-utils';
import { getLeagueBySlug } from '../../config/leagues';
import { NFL_LOGO_ONERROR, NFL_LOGO_ONLOAD, COLLEGE_LOGO_ONERROR, COLLEGE_LOGO_ONLOAD, positionOrder } from '../../constants/roster-constants';
import { getPlayerAvatarBackground, getPlayerAvatarBorder, getPlayerAvatarRing, getPlayerAvatarRingDark, getPlayerAvatarStyleMaps } from '../../utils/nfl-team-colors';
import '../../styles/player-cell.css';
import '../../styles/ranking-columns.css';
// Build-time-derived free-agent snapshot. All the heavy multi-year feed reads +
// row assembly live in scripts/compute-afl-free-agents.mjs (wired into prebuild);
// this page imports only the finished ~400KB result. See the SSR note below.
import freeAgentsData from '../../../data/afl-fantasy/derived/free-agents.json';
import { fetchLiveAflRosters, applyLiveRosters, conferenceScopedView, resolveConferenceSelection, type FaSnapshot } from '../../utils/afl-free-agents-live';
import { getAuthUser } from '../../utils/auth';
// AFL uses team defenses (no IDP), so a DEF free agent has no headshot of its
// own. Mirror TheLeague's hero treatment: surface a rotating pool of the team's
// marquee defenders (ESPN headshots) over the logo watermark. The data is keyed
// by NFL team code, so the shared theleague-sourced file works directly here.
import { DEF_SPOTLIGHT_PLAYERS, getDefSpotlightPlayer } from '../../data/theleague/def-spotlight-players';
import MyRankEditor from '../../components/shared/rankings/MyRankEditor.astro';

// SSR (server-rendered) — NOT prerendered. Two constraints pull in opposite
// directions and the derived-snapshot import above is how we satisfy both:
//
//  1. Apex routing needs SSR. The middleware (src/middleware.ts) rewrites
//     www.afl-fantasy.com/players → /afl-fantasy/players via context.rewrite(),
//     which only resolves to routes registered in the SSR function. A
//     `prerender = true` target is a static CDN file with no SSR route, so the
//     rewrite 404s and falls back to the default (TheLeague) 404 page — that was
//     the original apex bug.
//  2. The serverless function is near Vercel's 250MB limit. If this SSR page
//     eager-globbed every year of AFL feeds (~50MB of players/weekly-results),
//     it would bundle all of it into the shared _render function and tip it over
//     (see docs/claude/insights/domains/deployment.md).
//
// Resolution: the multi-year read happens at BUILD TIME in
// scripts/compute-afl-free-agents.mjs (node fs reads are not traced into the
// function), which emits data/afl-fantasy/derived/free-agents.json. This page
// imports only that small snapshot, so it renders on-demand (routing works) while
// contributing ~0.4MB, not ~15MB, to the function. Refreshes every deploy.

// League registry entry — single lookup serves the MFL photo host and the
// league id; never hardcode either (CLAUDE.md league-constants rule).
const aflLeague = getLeagueBySlug('afl-fantasy')!;
const mflHost = aflLeague.mflHost;

// ── Derived free-agent snapshot ──
// Year resolution, per-year feed parsing, row assembly, the default sort, and the
// position counts all used to run right here off eager import.meta.glob() over 24
// years of AFL feeds. That work now happens at build time in
// scripts/compute-afl-free-agents.mjs; this page consumes only the finished
// result, keeping the SSR bundle small (see the SSR note above).
//
// ── Live roster overlay ──
// The snapshot's roster-membership flags freeze at deploy time, so a player
// dropped on MFL after the last deploy kept showing as rostered (Kyle Pitts,
// Aug 2026). Since this page is SSR anyway, re-derive rostered/confs per
// request from the live MFL rosters export (60s in-memory cache; falls back
// to the baked flags when MFL is unreachable) — moves surface within about a
// minute. Only membership is live; the player pool itself still refreshes at
// deploy time.
const snapshot = freeAgentsData as unknown as FaSnapshot;
const liveView = applyLiveRosters(snapshot, await fetchLiveAflRosters(snapshot.generatedForYear, snapshot));
const players = liveView.players;
const nflTeamsList = freeAgentsData.nflTeamsList as string[];
const hasProjected = freeAgentsData.hasProjected;
const hasLastYrPts = freeAgentsData.hasLastYrPts;
const hasAdp = freeAgentsData.hasAdp;
const defaultSort = freeAgentsData.defaultSort;
const defaultDir = freeAgentsData.defaultDir;

// Duplicate-player conference metadata. Null when the league has a single
// shared pool (no switcher, league-wide availability).
const conferenceMeta = snapshot.conferences;

// ── Conference boundary ──
// One conference at a time: ?conf=<id|abbrev> wins (shareable links), else
// the signed-in owner's conference (session JWT → franchise → conference),
// else the first conference (AL). The hero switcher flips the view
// client-side and mirrors the choice back into ?conf=.
//
// NB: this makes the SSR HTML session-personalized — never add shared-cache
// headers (s-maxage/CDN caching) to this page or one user's default
// conference gets served to everyone.
const authUser = getAuthUser(Astro.request);
const { activeConfId } = resolveConferenceSelection(
  conferenceMeta,
  authUser,
  aflLeague.id,
  Astro.url.searchParams.get('conf'),
);

// Counts + hero spotlight scoped to the active conference (league-wide when
// there's no conference structure). Rookies are included by default (AFL
// rookies are addable free agents, and owners research them + their ADP
// here), matching the client script's default filter state so the numbers
// don't pop on hydration.
const scoped = conferenceScopedView(liveView, activeConfId, { includeRookies: true });
const faCounts = scoped.faCounts;
const freeAgentsCount = scoped.freeAgentsCount;
const topFa = scoped.topFa;
const topFaIsDef = topFa?.position === 'DEF';
// For a team defense, spotlight the team's marquee defender (if mapped) so the
// hero shows a face over the logo watermark instead of a bare crest.
const topFaDefStar = topFaIsDef ? getDefSpotlightPlayer(topFa?.team) : null;
const topFaLogo = topFa && topFa.team && topFa.team.indexOf('FA') !== 0
  ? `/assets/nfl-logos/${topFa.team}.svg`
  : '/assets/nfl-logos/NFL.svg';
// The hero headshot shows ESPN images only. When there's no ESPN image
// (offensive player with no espnId, or an unmapped DEF) we hide the foreground
// headshot rather than falling back to an MFL photo. Falls back to the logo
// (already loaded as the watermark) rather than '' so we never emit <img src="">.
const topFaHasHeadshot = topFa
  ? (topFaIsDef ? !!topFaDefStar?.espnId : !!topFa.espnId)
  : false;
const topFaHead = topFa
  ? (topFaIsDef
      ? (topFaDefStar
          ? `https://a.espncdn.com/i/headshots/nfl/players/full/${topFaDefStar.espnId}.png`
          : topFaLogo)
      : (topFa.espnId
          ? `https://a.espncdn.com/i/headshots/nfl/players/full/${topFa.espnId}.png`
          : topFaLogo))
  : topFaLogo;
// Initial (pre-hydration) error handler for the eager hero headshot: the image
// starts fetching before client JS attaches its handler, so mirror the client's
// hero-only fallback here — try the ESPN college headshot, then hide — so an ESPN
// 404 never flashes a broken image in the first viewport. Only emitted when we're
// showing an ESPN headshot (topFaHasHeadshot). espnId is a numeric MFL/ESPN id.
const topFaHeadEspnIdRaw = topFaHasHeadshot ? (topFaIsDef ? topFaDefStar?.espnId : topFa?.espnId) : null;
const topFaHeadEspnId = topFaHeadEspnIdRaw && /^\d+$/.test(String(topFaHeadEspnIdRaw)) ? String(topFaHeadEspnIdRaw) : null;
const topFaHeadOnerror = topFaHeadEspnId
  ? `this.onerror=function(){this.onerror=null;this.style.visibility='hidden'};this.src='https://a.espncdn.com/i/headshots/college-football/players/full/${topFaHeadEspnId}.png'`
  : undefined;

const playerDataJson = JSON.stringify(players);
const defSpotlightJson = JSON.stringify(DEF_SPOTLIGHT_PLAYERS);
const conferenceMetaJson = JSON.stringify(conferenceMeta ?? null);
const activeConfIdJson = JSON.stringify(activeConfId);

// NFL-team avatar backdrops (same pattern as players.astro / projected-free-
// agents): precomputed maps (ESPN codes + MFL aliases) so the client-side
// row builder just does a lookup. FA/unknown falls back to league-neutral.
const { bg: nflAvatarBg, border: nflAvatarBorder, ring: nflAvatarRing, ringDark: nflAvatarRingDark } = getPlayerAvatarStyleMaps();
const nflAvatarBgFallback = getPlayerAvatarBackground('FA');
const nflAvatarBorderFallback = getPlayerAvatarBorder('FA');
const nflAvatarRingFallback = getPlayerAvatarRing('FA');
const nflAvatarRingDarkFallback = getPlayerAvatarRingDark('FA');
const nflAvatarBgJson = JSON.stringify(nflAvatarBg);
const nflAvatarBorderJson = JSON.stringify(nflAvatarBorder);
const nflAvatarRingJson = JSON.stringify(nflAvatarRing);
const nflAvatarRingDarkJson = JSON.stringify(nflAvatarRingDark);

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(path, hideLeaguePrefix);
// Client payload for src/scripts/players/afl-players.ts.
// One JSON blob handed over by a one-line bridge below, instead of 21
// separate `define:vars` consts — that form forces the whole ~900-line
// script to be a classic (un-importable, un-typed) block.
// RAW values, never the pre-stringified `*Json` ones — nesting an
// already-stringified blob inside this second JSON.stringify escapes every
// quote twice and inflates the emitted HTML for nothing. See the same note on
// TheLeague's page.
const playersConfigJson = JSON.stringify({
  playerData: players,
  hasProjected,
  hasLastYrPts,
  hasAdp,
  defaultSort,
  defaultDir,
  mflHost,
  defSpotlight: DEF_SPOTLIGHT_PLAYERS,
  conferenceMeta: conferenceMeta ?? null,
  activeConfId,
  nflAvatarBg,
  nflAvatarBorder,
  nflAvatarBgFallback,
  nflAvatarBorderFallback,
  nflAvatarRing,
  nflAvatarRingFallback,
  nflAvatarRingDark,
  nflAvatarRingDarkFallback,
  logoOnerror: NFL_LOGO_ONERROR,
  collegeLogoOnerror: COLLEGE_LOGO_ONERROR,
  collegeLogoOnload: COLLEGE_LOGO_ONLOAD,
});

---

<TheLeagueLayout title="Free Agents | AFL">
  <CollegeLogoDarkStyles />
  <div class="players-page">
    <!-- Hero -->
    <div class="players-hero">
      <div class="hero-spotlight" id="hero-spotlight" aria-hidden="true" data-def={topFaIsDef ? 'true' : 'false'} data-def-player={topFaIsDef && topFaDefStar ? 'true' : 'false'}>
        <img id="hero-spotlight-logo" class="hero-spotlight__logo" src={topFaLogo} alt="" loading="eager" decoding="async" onerror={NFL_LOGO_ONERROR} onload={NFL_LOGO_ONLOAD} />
        <img id="hero-spotlight-head" class="hero-spotlight__head" src={topFaHead} alt="" loading="eager" decoding="async" style={topFaHasHeadshot ? undefined : 'visibility:hidden'} onerror={topFaHeadOnerror} />
      </div>
      <!-- Rendered even with no initial topFa (just hidden): updateSpotlight()
           looks these elements up once, so a caption that isn't in the SSR
           HTML could never appear after a conference switch reveals a top
           free agent. -->
      <div class="hero-spotlight-caption" id="hero-spotlight-caption" aria-live="polite" style={topFa ? undefined : 'display:none'}>
        <span class="hero-spotlight__label" id="hero-spotlight-label">Top Free Agent</span>
        <span class="hero-spotlight__name" id="hero-spotlight-name">{topFa ? (topFaDefStar ? topFaDefStar.name : topFa.name) : ''}</span>
        <span class="hero-spotlight__meta" id="hero-spotlight-meta">
          {topFa ? `${topFa.position === 'PK' ? 'K' : topFa.position}${topFa.team && topFa.team.indexOf('FA') !== 0 ? ` · ${topFa.team}` : ''}${topFa.projected != null ? ` · ${topFa.projected.toFixed(1)} pts` : ''}` : ''}
        </span>
      </div>
      <div class="hero-top">
        <div class="hero-title-group">
          <h1 class="hero-title">Free Agents</h1>
          <span class="hero-count"><span id="hero-count-num">{freeAgentsCount}</span> available players</span>
        </div>
        <a href={r('/afl-fantasy/rosters')} class="hero-cross-link">
          View rosters
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Conference boundary: one conference at a time. Duplicate-player
           league — an AL owner can't add an NL-available player, so the
           views never mix. Defaults to the signed-in owner's conference. -->
      {conferenceMeta && activeConfId && (
        <div class="conf-switcher" id="conf-switcher" role="group" aria-label="Conference">
          {conferenceMeta.ids.map((id) => (
            <button
              type="button"
              class={`conf-switch-btn${id === activeConfId ? ' active' : ''}`}
              data-conf={id}
              aria-pressed={id === activeConfId ? 'true' : 'false'}
            >
              {conferenceMeta.names[id]?.name || id}
            </button>
          ))}
        </div>
      )}

      <!-- Search -->
      <div class="hero-search">
        <svg class="hero-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          id="player-search"
          class="hero-search__input"
          placeholder="Search by player name or NFL team..."
          autocomplete="off"
        />
      </div>

      <!-- Position pills -->
      <nav class="hero-positions" id="category-tabs">
        <button class="pos-pill active" data-pos="ALL">
          All
          <span class="pos-pill__count" id="count-ALL">{faCounts.ALL || 0}</span>
        </button>
        {positionOrder.map(pos => (
          <button class="pos-pill" data-pos={pos}>
            {pos === 'PK' ? 'K' : pos}
            <span class="pos-pill__count" id={`count-${pos}`}>{faCounts[pos] || 0}</span>
          </button>
        ))}
      </nav>
    </div>

    <!-- Toolbar -->
    <div class="players-toolbar">
      <div class="toolbar-left">
        <h2 class="players-section-title">Available Players</h2>
        <span class="showing-count" aria-live="polite">
          <strong id="showing-count">50</strong> of <strong id="total-players">0</strong>
        </span>
      </div>
      <div class="toolbar-right">
        <div class="col-group-toggles" id="col-group-toggles" role="group" aria-label="Show columns" style="display: none;">
          <span class="col-group-toggles__label">View:</span>
          <button class="col-group-btn active" data-group="stats" type="button" aria-pressed="true">Stats</button>
          <button class="col-group-btn" data-group="rankings" id="col-group-btn-rankings" type="button" aria-pressed="false">Rankings</button>
        </div>
        <MyRankEditor league="afl" />
        <button class="filter-toggle-btn" id="filter-toggle-btn" type="button" aria-expanded="false" aria-controls="filters-panel">
          <svg class="filter-toggle-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="11" y1="18" x2="13" y2="18" />
          </svg>
          Filters
          <span class="filter-badge" id="filter-badge" style="display: none;">0</span>
        </button>
      </div>
    </div>

    <!-- Filters panel -->
    <div class="filters-panel" id="filters-panel" inert>
      <div class="filters-panel__clip">
        <div class="filters-panel__inner">
          <h3 class="filters-panel-title">Filters</h3>
          <div class="filters-grid">
            <div class="filter-group">
              <label class="filter-label" for="filter-team">NFL Team</label>
              <select id="filter-team" class="filter-select">
                <option value="">All Teams</option>
                {nflTeamsList.map(team => (
                  <option value={team}>{team}</option>
                ))}
              </select>
            </div>

            <div class="filter-group filter-group--age">
              <label class="filter-label">Age Range</label>
              <div class="filter-range">
                <input type="number" id="filter-age-min" class="filter-input-num" placeholder="Min" min="18" max="50" />
                <span class="filter-range__sep">&ndash;</span>
                <input type="number" id="filter-age-max" class="filter-input-num" placeholder="Max" min="18" max="50" />
              </div>
            </div>

            <div class="filter-group filter-group--ht">
              <label class="filter-label">Height (in)</label>
              <div class="filter-range">
                <input type="number" id="filter-ht-min" class="filter-input-num" placeholder="Min" min="60" max="84" />
                <span class="filter-range__sep">&ndash;</span>
                <input type="number" id="filter-ht-max" class="filter-input-num" placeholder="Max" min="60" max="84" />
              </div>
            </div>

            <div class="filter-group filter-group--wt">
              <label class="filter-label">Weight (lbs)</label>
              <div class="filter-range">
                <input type="number" id="filter-wt-min" class="filter-input-num" placeholder="Min" min="150" max="400" />
                <span class="filter-range__sep">&ndash;</span>
                <input type="number" id="filter-wt-max" class="filter-input-num" placeholder="Max" min="150" max="400" />
              </div>
            </div>

            <div class="filter-group">
              <label class="filter-label" for="filter-exp">Experience</label>
              <select id="filter-exp" class="filter-select">
                <option value="">All</option>
                <option value="rookie">Rookie</option>
                <option value="1-2">1–2 years</option>
                <option value="3-5">3–5 years</option>
                <option value="6-10">6–10 years</option>
                <option value="10+">10+ years</option>
              </select>
            </div>

            <div class="filter-group">
              <label class="filter-label" for="filter-draft">Draft Round</label>
              <select id="filter-draft" class="filter-select">
                <option value="">All</option>
                <option value="1">Round 1</option>
                <option value="2">Round 2</option>
                <option value="3">Round 3</option>
                <option value="4+">Round 4+</option>
                <option value="udfa">Undrafted</option>
              </select>
            </div>
          </div>

          <div class="filters-row-bottom">
            <!-- autocomplete="off": Firefox restores checkbox state across
                 reloads, which would desync the restored DOM from the script's
                 re-initialized defaults (rookies shown, badge at 0). -->
            <label class="filter-checkbox">
              <input type="checkbox" id="show-rostered" autocomplete="off" />
              <span>Include rostered</span>
            </label>
            <label class="filter-checkbox">
              <input type="checkbox" id="show-rookies" autocomplete="off" checked />
              <span>Include rookies</span>
            </label>
            <label class="filter-checkbox">
              <input type="checkbox" id="rookies-only" autocomplete="off" />
              <span>Rookies only</span>
            </label>
            <button class="filter-clear-btn" id="filter-clear-btn" type="button">Clear Filters</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
      <table class="players-table" id="players-table">
        <thead>
          <tr>
            <th class="sortable col-rank" data-sort="rank"><div class="th-content">#</div></th>
            <th class="sortable col-player" data-sort="name"><div class="th-content">Player</div></th>
            <th class="sortable col-age" data-sort="age"><div class="th-content">Age</div></th>
            <th class="sortable col-sm" data-sort="exp"><div class="th-content">Exp</div></th>
            <th class="sortable col-sm" data-sort="draftRd"><div class="th-content">Draft</div></th>
            <th class="sortable col-text col-group--stats col-college" data-sort="college" title="College" aria-label="College"><div class="th-content">C</div></th>
            <th class="sortable col-sm" data-sort="height"><div class="th-content">Ht</div></th>
            <th class="sortable col-sm" data-sort="weight"><div class="th-content">Wt</div></th>
            {hasAdp && (
              <th class="sortable col-num col-group--stats" data-sort="adpDyn"><div class="th-content">ADP</div></th>
            )}
            {hasLastYrPts && (
              <th class="sortable col-num col-group--stats" data-sort="lastYrPts"><div class="th-content">Last Yr</div></th>
            )}
            {hasProjected && (
              <th class="sortable col-num col-projected col-group--stats" data-sort="projected"><div class="th-content">Proj</div></th>
            )}
          </tr>
        </thead>
        <tbody id="player-table-body"></tbody>
      </table>
    </div>

    <!-- Show more -->
    <div class="show-more-wrapper" id="show-more-wrapper">
      <button class="show-more-btn" id="show-more-btn">
        Load More Players
        <svg class="show-more-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>
    </div>

    <!-- No data -->
    <div class="no-data" id="no-data" style="display: none;">
      <p>No player data available yet.</p>
    </div>
  </div>
  <PlayerDetailsModal hideContract={true} />
</TheLeagueLayout>

<script is:inline define:vars={{ playersConfigJson }}>
  window.__AFL_PLAYERS__ = JSON.parse(playersConfigJson);
</script>
<script>
  // The free-agent table. A bundled module (typed, import-capable) reading
  // the payload above — it used to be ~900 lines of classic `define:vars`
  // script, which is why it has to talk to the rankings module over
  // CustomEvents instead of importing it.
  import '../../scripts/players/afl-players';
</script>

<!-- Rankings integration: injects the owner's ranking columns into the table -->
<script>
  import { initRankingTable } from '../../utils/rankings-table';

  initRankingTable({
    tableSelector: '.players-table',
    anchorSelector: '[data-sort="weight"]',
  });
</script>

<!-- Player modal trigger (delegated, survives re-renders) -->
<script>
  import { initPlayerModalTrigger } from '../../utils/player-modal-trigger';
  function initModalTrigger() {
    const tbody = document.getElementById('player-table-body');
    if (tbody && !tbody.dataset.modalInit) {
      tbody.dataset.modalInit = 'true';
      initPlayerModalTrigger(tbody);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModalTrigger);
  } else {
    initModalTrigger();
  }
  document.addEventListener('astro:page-load', initModalTrigger);
</script>

<style>
  /* =============================================
     AFL FREE AGENTS PAGE
     Lean sibling of /theleague/players — shared visual system,
     no cap / contract / auction / value columns.
     ============================================= */

  .players-page {
    max-width: 100%;
    padding-bottom: 3rem;
  }

  /* Remove gap between nav header and hero */
  :global(.container-header) {
    margin-bottom: 0 !important;
    padding-bottom: 0.5rem !important;
  }

  /* ── Hero ── */
  .players-hero {
    background: var(--color-gray-50, #f9fafb);
    color: var(--color-gray-900, #111827);
    padding: 1.75rem 1.5rem 1.5rem;
    border-radius: var(--radius-lg, 1rem);
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--content-border, #e2e8f0);
  }

  /* Hero spotlight (broadcast diagonal cut: top-FA headshot + team logo) */
  .hero-spotlight {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    pointer-events: none;
    clip-path: polygon(20% 0, 110% 0, 90% 100%, 0% 100%);
    background:
      radial-gradient(120% 120% at 80% 20%, rgba(196, 30, 58, 0.12) 0%, transparent 60%),
      #eef1f6;
  }
  :global(html.dark) .hero-spotlight {
    background:
      radial-gradient(120% 120% at 80% 20%, rgba(196, 30, 58, 0.5) 0%, transparent 60%),
      #111827;
  }
  .hero-spotlight::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 100%;
    z-index: 3;
    background: linear-gradient(to bottom, var(--league-accent, #c41e3a) 0%, rgba(196, 30, 58, 0.6) 100%);
    clip-path: polygon(20% 0, 22.5% 0, 2.5% 100%, 0% 100%);
    pointer-events: none;
  }
  .hero-spotlight::after {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 100%;
    z-index: 3;
    background: linear-gradient(to bottom, rgba(196, 30, 58, 0.6) 0%, var(--league-accent, #c41e3a) 100%);
    clip-path: polygon(110% 0, 107.5% 0, 87.5% 100%, 90% 100%);
    pointer-events: none;
  }
  .hero-spotlight__logo {
    position: absolute;
    top: 50%;
    left: 58%;
    transform: translate(-50%, -50%);
    width: 78%;
    height: auto;
    max-height: 150%;
    object-fit: contain;
    opacity: 0.16;
    filter: grayscale(0.1);
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .hero-spotlight__head {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 60% 100%;
    padding: 0.5rem 0 0;
    filter: brightness(1.02) contrast(1.05) saturate(1.1) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.35));
    z-index: 2;
    opacity: 0;
    animation: spotlightIn 0.45s ease forwards;
  }
  /* Team defense has no headshot — make the crest the hero */
  .hero-spotlight[data-def='true'] .hero-spotlight__head {
    display: none;
  }
  .hero-spotlight[data-def='true'] .hero-spotlight__logo {
    opacity: 0.92;
    filter: none;
    width: 62%;
    left: 60%;
  }
  /* DEF with a mapped marquee defender: bring the headshot back as the foreground
     hero (styled like a normal contained/bottom-anchored player photo) and drop
     the team logo back to its faint background watermark. */
  .hero-spotlight[data-def='true'][data-def-player='true'] .hero-spotlight__head {
    display: block;
  }
  .hero-spotlight[data-def='true'][data-def-player='true'] .hero-spotlight__logo {
    opacity: 0.16;
    filter: grayscale(0.1);
    width: 78%;
    left: 58%;
  }
  @keyframes spotlightIn {
    from { opacity: 0; transform: scale(1.04); }
    to   { opacity: 1; transform: scale(1); }
  }

  .hero-spotlight-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.05rem;
    max-width: 60%;
    text-align: right;
    pointer-events: none;
    padding: 0.35rem 0.6rem 0.4rem;
    border-radius: var(--radius-md, 0.5rem);
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
  }
  :global(html.dark) .hero-spotlight-caption {
    padding: 0.4rem 0.65rem 0.45rem 1.75rem;
    border-radius: 0;
    background: radial-gradient(130% 150% at 100% 100%, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.3) 48%, transparent 78%);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.6);
  }
  .hero-spotlight__label {
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #6b7280;
  }
  :global(html.dark) .hero-spotlight__label { color: rgba(255, 255, 255, 0.75); }
  .hero-spotlight__name {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.15;
    color: #111827;
    letter-spacing: -0.01em;
  }
  :global(html.dark) .hero-spotlight__name { color: #fff; }
  .hero-spotlight__meta {
    font-size: 0.6875rem;
    font-weight: 500;
    color: #4b5563;
    font-variant-numeric: tabular-nums;
  }
  :global(html.dark) .hero-spotlight__meta { color: rgba(255, 255, 255, 0.85); }

  .hero-top {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-cross-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: var(--league-accent, #c41e3a);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full, 999px);
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    transition: gap 0.15s ease, filter 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }
  .hero-cross-link:hover {
    gap: 0.5rem;
    filter: brightness(0.92);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .hero-title-group {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-left: 0.625rem;
    border-left: 2px solid var(--league-accent, #c41e3a);
  }
  .hero-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--color-gray-900, #111827);
    line-height: 1.2;
  }
  .hero-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray-400, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Conference switcher ── */
  .conf-switcher {
    position: relative;
    z-index: 5;
    display: inline-flex;
    gap: 0;
    margin-bottom: 1rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-md, 0.5rem);
    background: color-mix(in srgb, var(--content-bg, #fff) 70%, transparent);
    overflow: hidden;
  }
  .conf-switch-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border: none;
    background: transparent;
    color: var(--color-gray-600, #4b5563);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .conf-switch-btn + .conf-switch-btn {
    border-left: 1px solid var(--content-border, #d1d5db);
  }
  .conf-switch-btn:hover {
    color: var(--league-accent, #c41e3a);
    background: color-mix(in srgb, var(--league-accent, #c41e3a) 6%, transparent);
  }
  .conf-switch-btn.active {
    background: var(--league-accent, #c41e3a);
    color: #fff;
    cursor: default;
  }
  /* ── Hero search ── */
  .hero-search {
    position: relative;
    z-index: 2;
    margin-bottom: 1.25rem;
    max-width: 520px;
  }
  .hero-search__icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: var(--color-gray-400, #9ca3af);
    pointer-events: none;
    transition: color 0.15s;
  }
  .hero-search__input {
    width: 100%;
    padding: 0.7rem 0.875rem 0.7rem 2.5rem;
    border: 1px solid var(--input-border, #e2e8f0);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--input-bg, #fff);
    color: var(--input-text, #111827);
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .hero-search__input::placeholder { color: var(--input-placeholder, #9ca3af); }
  .hero-search__input:focus {
    outline: none;
    border-color: var(--league-accent, #c41e3a);
    box-shadow: 0 0 0 2px rgba(196, 30, 58, 0.12);
  }
  .hero-search:has(.hero-search__input:focus) .hero-search__icon {
    color: var(--league-accent, #c41e3a);
  }

  /* ── Position pills ── */
  .hero-positions {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
  .pos-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--content-border, #d1d5db) 70%, transparent);
    border-radius: var(--radius-md, 0.5rem);
    background: color-mix(in srgb, var(--content-bg, #fff) 55%, transparent);
    -webkit-backdrop-filter: blur(8px) saturate(1.4);
    backdrop-filter: blur(8px) saturate(1.4);
    color: var(--color-gray-600, #4b5563);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .pos-pill:hover {
    border-color: var(--league-accent, #c41e3a);
    color: var(--league-accent, #c41e3a);
    background: color-mix(in srgb, var(--content-bg, #fff) 72%, transparent);
  }
  .pos-pill.active {
    background: var(--league-accent, #c41e3a);
    border-color: var(--league-accent, #c41e3a);
    color: white;
  }
  .pos-pill__count {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.05rem 0.35rem;
    border-radius: 10px;
    background: var(--color-gray-100, #f3f4f6);
    min-width: 1.25rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .pos-pill.active .pos-pill__count { background: rgba(255, 255, 255, 0.25); }

  /* ── Toolbar ── */
  .players-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-gray-100, #f3f4f6);
    flex-wrap: wrap;
  }
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex: 1;
    min-width: 0;
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .players-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-900, #111827);
    padding-left: 0.625rem;
    border-left: 2px solid var(--league-accent, #c41e3a);
    margin: 0;
    line-height: 1.2;
    white-space: nowrap;
  }
  .showing-count {
    font-size: 0.75rem;
    color: var(--color-gray-400, #9ca3af);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .showing-count strong {
    color: var(--color-gray-700, #374151);
    font-weight: 600;
  }

  /* ── Column view toggles (Stats / Rankings) ── */
  .col-group-toggles {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .col-group-toggles__label {
    font-size: 0.8125rem;
    color: var(--content-text-muted, #64748b);
    margin-right: 0.1rem;
  }
  .col-group-btn {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-full, 999px);
    background: var(--content-bg, #fff);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-gray-600, #4b5563);
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1.4;
  }
  .col-group-btn:hover {
    border-color: var(--league-accent, #c41e3a);
    color: var(--league-accent, #c41e3a);
  }
  .col-group-btn.active {
    background: var(--league-accent, #c41e3a);
    border-color: var(--league-accent, #c41e3a);
    color: #fff;
  }

  /* ── Filter toggle ── */
  .filter-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--content-bg, #fff);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-600, #4b5563);
    cursor: pointer;
    transition: all 0.15s;
    position: relative;
  }
  .filter-toggle-btn__icon { width: 15px; height: 15px; }
  .filter-toggle-btn:hover,
  .filter-toggle-btn.active,
  .filter-toggle-btn.has-filters {
    border-color: var(--league-accent, #c41e3a);
    color: var(--league-accent, #c41e3a);
  }
  .filter-toggle-btn.active,
  .filter-toggle-btn.has-filters {
    background: color-mix(in srgb, var(--league-accent, #c41e3a) 10%, var(--content-bg, white));
  }
  .filter-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--league-accent, #c41e3a);
    color: white;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
  }

  /* ── Filters panel ──
     Collapses via a 0fr → 1fr grid row rather than a fixed max-height: the
     panel is ~600px tall once .filters-grid drops to one column on phones,
     and any hardcoded cap clips it. The fr track always resolves to the
     panel's real height, so it can never cut off. */
  .filters-panel {
    display: grid;
    grid-template-rows: 0fr;
    /* visibility (delayed to the end of the collapse) takes the clipped
       controls out of the tab order everywhere; the panel's `inert` does the
       same but is a no-op on iOS Safari below 15.4. */
    visibility: hidden;
    transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s 0.3s;
  }
  .filters-panel.open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition-delay: 0s;
  }
  /* Clip lives on a bare wrapper, not the card: the card's own padding and
     border would floor the 0fr track and leave a sliver when collapsed. */
  .filters-panel__clip {
    min-height: 0;
    overflow: hidden;
  }
  .filters-panel__inner {
    background: var(--content-bg, #fff);
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: var(--radius-md, 0.5rem);
    padding: 1rem 1.25rem 1rem;
    margin-bottom: 0.75rem;
    box-shadow: var(--shadow-sm);
  }
  .filters-panel-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-900, #111827);
    padding-left: 0.625rem;
    border-left: 2px solid var(--league-accent, #c41e3a);
    margin: 0 0 0.875rem;
    line-height: 1.2;
  }
  .filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 0.875rem;
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gray-400, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .filter-select {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--input-border, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    font-size: 0.8125rem;
    color: var(--input-text, #374151);
    background: var(--input-bg, #fff);
  }
  .filter-select:focus,
  .filter-input-num:focus {
    outline: none;
    border-color: var(--league-accent, #c41e3a);
    box-shadow: 0 0 0 2px rgba(196, 30, 58, 0.12);
  }
  .filter-range {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .filter-range__sep {
    color: var(--color-gray-400, #9ca3af);
    font-size: 0.875rem;
  }
  .filter-input-num {
    width: 70px;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--input-border, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    font-size: 0.8125rem;
    color: var(--input-text, #374151);
    text-align: center;
    background: var(--input-bg, #fff);
  }
  .filters-row-bottom {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-gray-100, #f3f4f6);
  }
  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-gray-600, #4b5563);
    cursor: pointer;
    user-select: none;
  }
  .filter-checkbox input { accent-color: var(--league-accent, #c41e3a); }
  .filter-clear-btn {
    margin-left: auto;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    background: var(--content-bg, #fff);
    color: var(--color-gray-500, #6b7280);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-clear-btn:hover {
    border-color: var(--color-gray-400, #9ca3af);
    color: var(--color-gray-700, #374151);
    background: var(--color-gray-50, #f9fafb);
  }

  /* ── Show more ── */
  .show-more-wrapper {
    display: flex;
    justify-content: center;
    padding: 1.25rem 0 0;
  }
  .show-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 2rem;
    border: 1px solid var(--content-border, #dee2e6);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--content-bg, #fff);
    color: var(--league-accent, #c41e3a);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .show-more-btn__icon { width: 16px; height: 16px; }
  .show-more-btn:hover {
    border-color: var(--league-accent, #c41e3a);
    background: var(--league-accent, #c41e3a);
    color: white;
    box-shadow: var(--shadow-md);
  }

  /* ── Table ── */
  .table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-md, 0.5rem);
    background: var(--content-bg, #fff);
    box-shadow: var(--shadow-sm);
    margin-top: 0.5rem;
  }
  :global(html.dark) .table-wrapper {
    box-shadow: 0 0 0 1px var(--content-border, #555555), var(--shadow-lg);
  }
  .players-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .players-table thead {
    background: var(--color-gray-50, #f9fafb);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--content-border, #e2e8f0);
  }
  .players-table thead tr {
    border-left: 3px solid var(--color-gray-100, #f3f4f6);
  }
  .players-table th {
    padding: 0.5rem 0.375rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-400, #9ca3af);
  }
  .players-table th:first-child { padding-left: 0.75rem; }
  .players-table th:last-child { padding-right: 0.75rem; }
  .players-table th.sortable {
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .players-table th.sortable:hover {
    background: var(--color-gray-100, #f3f4f6);
    color: var(--color-gray-600, #4b5563);
  }
  .players-table th.sorted {
    background: rgba(196, 30, 58, 0.06);
    color: var(--league-accent, #c41e3a);
  }
  .th-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }
  .sort-arrow {
    font-size: 0.55rem;
    opacity: 0.8;
  }

  /* Columns */
  .col-rank { width: min-content; text-align: center; }
  .col-player { min-width: 200px; }
  .col-player .th-content { justify-content: flex-start; }
  .col-age { width: 42px; text-align: center; }
  .col-sm { width: 48px; text-align: center; }
  .col-num { width: 72px; text-align: right; }
  .col-num .th-content { justify-content: flex-end; }
  .col-text { text-align: left; }

  /* ── Cells ── */
