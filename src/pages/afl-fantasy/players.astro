---
/**
 * AFL Free Agents — thin route over the shared page every duplicate-player
 * league renders (src/components/shared/free-agents/FreeAgentsPage.astro).
 *
 * What stays here, and why: the snapshot read and the feed globs, so the
 * shared page never names a league's data path; and the conference crests,
 * which only the AFL has.
 *
 * SSR, not prerendered: apex routing (www.afl-fantasy.com/players) rewrites
 * only to routes registered in the SSR function. The snapshot is the ~0.4 MB
 * output of scripts/compute-free-agents.mjs, not 24 years of feeds, and is
 * read through the league-data loader (src/utils/league-data.ts) rather than
 * bundled into the function.
 */
import FreeAgentsPage, { type PoolLogo } from '../../components/shared/free-agents/FreeAgentsPage.astro';
import { isValidConferenceId, getConferenceLogo, getConferenceLogoDark } from '../../utils/afl-conference';
import { getLeagueBySlug } from '../../config/leagues';
import { loadLeagueData } from '../../utils/league-data';

const AFL_DERIVED = `${getLeagueBySlug('afl-fantasy')!.dataPath}/derived`;
const [freeAgentsData] = await Promise.all([
  loadLeagueData<any>(`${AFL_DERIVED}/free-agents.json`),
]);

// league.json and calendar.json are ~12 KB each, so era-filtered eager globs
// cost nothing (tests/current-era-feed-globs.test.ts is about players.json).
const leagueModules = import.meta.glob(
  '../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/league.json',
  { eager: true }
);
const calendarModules = import.meta.glob(
  '../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/calendar.json',
  { eager: true }
);

// The crests exist only for the two real conference ids, so a feed that grew
// a third still falls back to its name rather than requesting a 404 image.
const poolLogos: Record<string, PoolLogo> = {};
for (const id of freeAgentsData.conferences?.ids ?? []) {
  if (isValidConferenceId(id)) poolLogos[id] = { src: getConferenceLogo(id), darkSrc: getConferenceLogoDark(id) };
}
---

<FreeAgentsPage
  leagueSlug="afl-fantasy"
  snapshot={freeAgentsData}
  leagueModules={leagueModules}
  calendarModules={calendarModules}
  title="Free Agents | AFL"
  poolLogos={poolLogos}
  signInLogo={{ src: '/assets/logos/afl-logo.svg', alt: 'AFL logo' }}
/>
