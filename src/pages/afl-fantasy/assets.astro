---
/**
 * The old Asset Library URL, now a redirect to the Brand Book.
 *
 * `/assets` was the team-branding destination for years, so it is linked from
 * the footer, from owners' bookmarks and from three years of GroupMe messages.
 * The page it pointed at has been replaced by the Brand Book (its successor,
 * `/brand/files`, was folded into the Brand Book too, Oct 2026), and a dead
 * bookmark is a worse answer than a redirect.
 *
 * 301: the Asset Library is retired for good (owner's call, Oct 2026), and a
 * permanent redirect is the right answer for a page we are done with. Keep
 * 302 for redirects that may yet change.
 *
 * The redirect lives in the PAGE because it has to — `Astro.redirect()`
 * returned from a component's frontmatter only stops that component rendering
 * and still answers 200 with a blank body.
 */
import { resolveLeaguePath } from '../../utils/nav-utils';

export const prerender = false;

return Astro.redirect(
  resolveLeaguePath('/afl-fantasy/brand', Astro.locals.hideLeaguePrefix ?? false),
  301
);
---
