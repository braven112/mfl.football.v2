---
/**
 * The Board (AFL) — thin route wrapper.
 *
 * Shared implementation lives in
 * components/shared/suggestions/SuggestionBoxPage. See TheLeague's wrapper for
 * why the auth read and the config import live in the route.
 *
 * This board's ideas live in their own Redis bucket (`sb:afl:*`, resolved by
 * src/utils/suggestions-scope.ts from the SESSION's league) — never TheLeague's.
 */
import SuggestionBoxPage from '../../components/shared/suggestions/SuggestionBoxPage.astro';
import { getAuthUser, isCommissionerOrAdmin } from '../../utils/auth';
import { LEAGUES } from '../../config/leagues';
import config from '../../../data/afl-fantasy/afl.config.json';

export const prerender = false;

const authUser = getAuthUser(Astro.request);
const isThisLeague = authUser?.leagueId === LEAGUES['afl-fantasy'].id;
const isAdmin = authUser && isThisLeague ? isCommissionerOrAdmin(authUser) : false;
const teamIcons = config.teams.map((t: { franchiseId: string; icon: string }) => ({
  franchiseId: t.franchiseId,
  icon: t.icon,
}));
---

<SuggestionBoxPage
  leagueSlug="afl-fantasy"
  isAuthenticated={!!authUser && isThisLeague}
  isAdmin={isAdmin}
  userFranchiseId={(isThisLeague && authUser?.franchiseId) || ''}
  teamIcons={teamIcons}
/>
