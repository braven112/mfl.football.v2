---
/**
 * AFL rivalry page — thin route wrapper around the shared League History
 * rivalry page (components/shared/league-history/HistoryRivalryPage), which
 * replaced the AFL's own page (Brandon, 2026-10-25: upgrade in place). Its
 * trades and the head-to-head coverage note come in through the default slot.
 * The dataset imports and the redirects stay here: a static import specifier
 * can't be a runtime variable, and `Astro.redirect()` only redirects from a
 * page.
 */
import HistoryRivalryPage from '../../../components/shared/league-history/HistoryRivalryPage.astro';
import RivalryTrades from '../../../components/shared/rivalries/RivalryTrades.astro';
import historyData from '../../../../data/afl-fantasy/derived/league-history.json';
import franchiseHistory from '../../../../data/afl-fantasy/derived/franchise-history.json';
import aflConfig from '../../../../data/afl-fantasy/afl.config.json';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { describeCoverageGap } from '../../../utils/rivalries';
import { rivalryPairRoute } from '../../../utils/league-history/rivalry-route';

export const prerender = false;

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const route = rivalryPairRoute(historyData, franchiseHistory, Astro.params.pair);
if (route.redirect) {
  const path = route.redirect === 'index' ? '/afl-fantasy/rivalries' : `/afl-fantasy/rivalries/${route.redirect}${Astro.url.search}`;
  return Astro.redirect(resolveLeaguePath(path, hideLeaguePrefix), route.redirect === 'index' ? 302 : 301);
}
const { a, b, playoffRounds } = route;
const ownerOnly = Astro.url.searchParams.get('view') !== 'all';
// Seasons whose head-to-head the archives only partly cover: a meeting these
// two had then is missing from the page's log.
const coverageNote = describeCoverageGap(((franchiseHistory as any).h2hCoverage ?? []) as any[]);
---

<HistoryRivalryPage leagueSlug="afl-fantasy" data={historyData} a={a} b={b} playoffRounds={playoffRounds}>
  <RivalryTrades history={franchiseHistory} teams={aflConfig.teams as any[]} a={a} b={b} ownerOnly={ownerOnly} />
  {coverageNote && (
    <p class="rv-coverage">{coverageNote} Any meeting these two had then is missing above.</p>
  )}
</HistoryRivalryPage>

<style>
  .rv-coverage {
    margin: 1rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
  }
</style>
