---
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import aflConfig from '../../../../data/afl-fantasy/afl.config.json';
import franchiseHistory from '../../../../data/afl-fantasy/derived/franchise-history.json';
import { formatTradeAsset } from '../../../utils/franchise-trade-asset';
import {
  currentOwnerMeetings,
  tallyMeetings,
  parseRivalryPair,
  canonicalRivalryPair,
  formatRivalryRecord,
  describeCoverageGap,
  type Matchup,
} from '../../../utils/rivalries';

export const prerender = false;

const { pair } = Astro.params;

// Canonical URL puts the smaller franchise id first, so a pairing has exactly
// one address no matter which side linked to it. A reversed slug redirects
// rather than rendering a duplicate page.
const parsed = parseRivalryPair(pair ?? '');
if (!parsed) {
  return Astro.redirect('/afl-fantasy/rivalries');
}
const [smaller, bigger] = [parsed[0], parsed[1]].sort();
if (`${smaller}-vs-${bigger}` !== pair) {
  return Astro.redirect(`/afl-fantasy/rivalries/${smaller}-vs-${bigger}`, 301);
}

const frA: any = (franchiseHistory.franchises as any)?.[smaller] ?? null;
const frB: any = (franchiseHistory.franchises as any)?.[bigger] ?? null;
if (!frA || !frB) {
  return Astro.redirect('/afl-fantasy/rivalries');
}

const teamLookup: Record<string, any> = Object.fromEntries(
  (aflConfig.teams as any[]).map((t) => [t.franchiseId, t])
);

// Every meeting under the current owners, oldest first. frA (the smaller id)
// is the reference perspective; frB's stored copy mirrors it, so reading one
// side is enough and avoids double-counting.
type Meeting = {
  year: number;
  week: number;
  scoreA: number;
  scoreB: number;
  isPlayoff: boolean;
  playoffRound: string | null;
  margin: number;
};

const meetings: Meeting[] = currentOwnerMeetings(frA.matchupHistory, bigger)
  .map((m: Matchup) => ({
    year: m.year,
    week: m.week,
    scoreA: m.score,
    scoreB: m.opponentScore,
    isPlayoff: Boolean(m.isPlayoff),
    playoffRound: m.playoffRound ?? null,
    margin: Math.abs(m.score - m.opponentScore),
  }))
  .sort((x, y) => x.year - y.year || x.week - y.week);

const { wins: aWins, losses: bWins, ties } = tallyMeetings(
  currentOwnerMeetings(frA.matchupHistory, bigger)
);
const totalGames = meetings.length;
const leader = aWins > bWins ? frA : aWins < bWins ? frB : null;

const playoffMeetings = meetings.filter((m) => m.isPlayoff);
const biggestBlowout = meetings.length
  ? meetings.reduce((acc, m) => (m.margin > acc.margin ? m : acc))
  : null;
const closestGame = meetings.length
  ? meetings.reduce((acc, m) => (m.margin < acc.margin ? m : acc))
  : null;
const highestCombined = meetings.length
  ? meetings.reduce((acc, m) => (m.scoreA + m.scoreB > acc.scoreA + acc.scoreB ? m : acc))
  : null;
const mostRecent = meetings.length ? meetings[meetings.length - 1] : null;

// Longest run of consecutive wins by either side, walked chronologically.
function longestStreaks(games: Meeting[]) {
  let aMax = 0;
  let bMax = 0;
  let curSide: 'A' | 'B' | 'tie' | null = null;
  let curLen = 0;
  for (const g of games) {
    const side: 'A' | 'B' | 'tie' =
      g.scoreA > g.scoreB ? 'A' : g.scoreA < g.scoreB ? 'B' : 'tie';
    if (side === curSide) curLen++;
    else {
      curSide = side;
      curLen = 1;
    }
    if (side === 'A') aMax = Math.max(aMax, curLen);
    if (side === 'B') bMax = Math.max(bMax, curLen);
  }
  return { aMax, bMax, currentSide: curSide, currentLen: curLen };
}
const streaks = longestStreaks(meetings);

// Trades between the two. frA's ledger already records both sides of each
// deal, so filtering it by partner is the whole set.
type Trade = {
  year: number;
  timestamp: number;
  partnerId: string;
  gaveUp: string[];
  received: string[];
  comments: string;
};
const tradesBetween: Trade[] = (((frA.trades ?? []) as Trade[]) || [])
  .filter((t) => t.partnerId === bigger)
  .sort((x, y) => y.timestamp - x.timestamp);

const playerNames = ((franchiseHistory as any).playerNames ?? {}) as Record<
  string,
  { name: string; position?: string; team?: string }
>;
const franchiseShortName = (fid: string): string => {
  const t = teamLookup[fid];
  return t?.nameShort ?? t?.nameMedium ?? t?.name ?? fid;
};
const formatAsset = (code: string) => formatTradeAsset(code, playerNames, franchiseShortName);
const tradeDateLabel = (t: Trade): string =>
  t.timestamp
    ? new Date(t.timestamp * 1000).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      })
    : String(t.year);

// Seasons whose head-to-head the archives only partly cover. Shown as a
// footnote because this page's meeting log is exactly what goes missing.
const coverage: Array<any> = ((franchiseHistory as any).h2hCoverage ?? []) as any[];
const coverageNote = describeCoverageGap(coverage);

const nameA = frA.currentNameMedium || frA.currentName;
const nameB = frB.currentNameMedium || frB.currentName;
const shortA = frA.currentNameShort || nameA;
const shortB = frB.currentNameShort || nameB;
---

<TheLeagueLayout title={`${nameA} vs ${nameB} | AFL Rivalry`}>
  <article class="rivalry-detail">
    <a class="rivalry-back" href="/afl-fantasy/rivalries">← All rivalries</a>

    <header class="rivalry-hero">
      <a class="rivalry-side" href={`/afl-fantasy/franchises/${frA.franchiseId}`}>
        {frA.currentIcon ? <img src={frA.currentIcon} alt="" class="rivalry-side__icon" /> : null}
        <span class="rivalry-side__name">{nameA}</span>
      </a>

      <div class="rivalry-versus">
        {totalGames > 0 ? (
          <>
            <strong class="rivalry-record">{formatRivalryRecord(aWins, bWins, ties)}</strong>
            <span class="rivalry-versus__label">all-time</span>
            {leader ? (
              <p class="rivalry-leader">
                {leader === frA ? shortA : shortB} leads {Math.max(aWins, bWins)}–{Math.min(aWins, bWins)}
                {ties > 0 ? `–${ties}` : ''}
              </p>
            ) : (
              <p class="rivalry-leader">Dead even</p>
            )}
            {playoffMeetings.length > 0 && (
              <p class="rivalry-playoffs">
                🔥 {playoffMeetings.length} playoff meeting{playoffMeetings.length === 1 ? '' : 's'}
              </p>
            )}
          </>
        ) : (
          <span class="rivalry-versus__label">No meetings on record</span>
        )}
      </div>

      <a class="rivalry-side" href={`/afl-fantasy/franchises/${frB.franchiseId}`}>
        {frB.currentIcon ? <img src={frB.currentIcon} alt="" class="rivalry-side__icon" /> : null}
        <span class="rivalry-side__name">{nameB}</span>
      </a>
    </header>

    {totalGames === 0 ? (
      <p class="rivalry-empty">
        These two have no recorded head-to-head meetings under their current owners.
      </p>
    ) : (
      <>
        <section class="rivalry-section">
          <h2>Series Highlights</h2>
          <div class="rivalry-grid">
            {closestGame && (
              <div class="rivalry-stat">
                <div class="rivalry-stat__label">Closest game</div>
                <div class="rivalry-stat__value">{closestGame.margin.toFixed(2)}</div>
                <div class="rivalry-stat__ctx">
                  {closestGame.scoreA.toFixed(1)}–{closestGame.scoreB.toFixed(1)} · Week{' '}
                  {closestGame.week}, {closestGame.year}
                </div>
              </div>
            )}
            {biggestBlowout && (
              <div class="rivalry-stat">
                <div class="rivalry-stat__label">Biggest blowout</div>
                <div class="rivalry-stat__value">{biggestBlowout.margin.toFixed(2)}</div>
                <div class="rivalry-stat__ctx">
                  {biggestBlowout.scoreA.toFixed(1)}–{biggestBlowout.scoreB.toFixed(1)} · Week{' '}
                  {biggestBlowout.week}, {biggestBlowout.year}
                </div>
              </div>
            )}
            {highestCombined && (
              <div class="rivalry-stat">
                <div class="rivalry-stat__label">Highest combined</div>
                <div class="rivalry-stat__value">
                  {(highestCombined.scoreA + highestCombined.scoreB).toFixed(2)}
                </div>
                <div class="rivalry-stat__ctx">
                  {highestCombined.scoreA.toFixed(1)}–{highestCombined.scoreB.toFixed(1)} · Week{' '}
                  {highestCombined.week}, {highestCombined.year}
                </div>
              </div>
            )}
            <div class="rivalry-stat">
              <div class="rivalry-stat__label">Longest streak</div>
              <div class="rivalry-stat__value">{Math.max(streaks.aMax, streaks.bMax)}</div>
              <div class="rivalry-stat__ctx">
                by {streaks.aMax >= streaks.bMax ? shortA : shortB}
                {streaks.currentSide && streaks.currentSide !== 'tie' && streaks.currentLen > 1 ? (
                  <>
                    <br />current: {streaks.currentSide === 'A' ? shortA : shortB} won last{' '}
                    {streaks.currentLen}
                  </>
                ) : null}
              </div>
            </div>
            {mostRecent && (
              <div class="rivalry-stat">
                <div class="rivalry-stat__label">Most recent</div>
                <div class="rivalry-stat__value">
                  {mostRecent.scoreA.toFixed(1)}–{mostRecent.scoreB.toFixed(1)}
                </div>
                <div class="rivalry-stat__ctx">Week {mostRecent.week}, {mostRecent.year}</div>
              </div>
            )}
          </div>
        </section>

        <section class="rivalry-section">
          <h2>Every Meeting ({totalGames})</h2>
          <div class="rivalry-table-wrap">
            <table class="rivalry-table">
              <thead>
                <tr>
                  <th scope="col">Season</th>
                  <th scope="col">Wk</th>
                  <th scope="col">{shortA}</th>
                  <th scope="col">{shortB}</th>
                  <th scope="col">Winner</th>
                  <th scope="col">Round</th>
                </tr>
              </thead>
              <tbody>
                {meetings.slice().reverse().map((m) => {
                  const aWon = m.scoreA > m.scoreB;
                  const tie = m.scoreA === m.scoreB;
                  return (
                    <tr class:list={[m.isPlayoff && 'is-playoff']}>
                      <td>{m.year}</td>
                      <td>{m.week}</td>
                      <td class:list={[!tie && aWon && 'is-winner']}>{m.scoreA.toFixed(2)}</td>
                      <td class:list={[!tie && !aWon && 'is-winner']}>{m.scoreB.toFixed(2)}</td>
                      <td>{tie ? 'Tie' : aWon ? shortA : shortB}</td>
                      <td>{m.isPlayoff ? m.playoffRound ?? 'Playoffs' : '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {coverageNote && (
            <p class="rivalry-caveat">{coverageNote} Meetings from those weeks
              are missing from this log.</p>
          )}
        </section>

        {tradesBetween.length > 0 && (
          <section class="rivalry-section">
            <h2>Trades Between ({tradesBetween.length})</h2>
            <ul class="rivalry-trades">
              {tradesBetween.map((t) => (
                <li class="rivalry-trade">
                  <div class="rivalry-trade__date">{tradeDateLabel(t)}</div>
                  <div class="rivalry-trade__sides">
                    <div>
                      <span class="rivalry-trade__label">{shortA} sent</span>
                      <ul>
                        {t.gaveUp.length
                          ? t.gaveUp.map((c) => <li>{formatAsset(c)}</li>)
                          : <li class="dim">—</li>}
                      </ul>
                    </div>
                    <div>
                      <span class="rivalry-trade__label">{shortB} sent</span>
                      <ul>
                        {t.received.length
                          ? t.received.map((c) => <li>{formatAsset(c)}</li>)
                          : <li class="dim">—</li>}
                      </ul>
                    </div>
                  </div>
                  {t.comments ? <p class="rivalry-trade__comment">{t.comments}</p> : null}
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )}
  </article>
</TheLeagueLayout>

<style>
  .rivalry-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--spacing-md, 16px);
  }

  .rivalry-back {
    display: inline-block;
    margin-bottom: var(--spacing-md, 16px);
    font-size: 0.85rem;
    color: var(--content-text-muted);
    text-decoration: none;
  }

  .rivalry-back:hover {
    color: var(--league-accent);
  }

  .rivalry-hero {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-md, 16px);
    padding: var(--spacing-lg, 24px) var(--spacing-md, 16px);
    background: var(--card-bg);
    border: 1px solid var(--content-border);
    border-radius: 14px;
    margin-bottom: var(--spacing-lg, 24px);
  }

  .rivalry-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--page-text);
    text-align: center;
  }

  .rivalry-side:hover .rivalry-side__name {
    color: var(--league-accent);
  }

  .rivalry-side__icon {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .rivalry-side__name {
    font-weight: 700;
    font-size: 1rem;
  }

  .rivalry-versus {
    text-align: center;
    min-width: 130px;
  }

  .rivalry-record {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--page-text);
    line-height: 1;
  }

  .rivalry-versus__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--content-text-muted);
  }

  .rivalry-leader,
  .rivalry-playoffs {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: var(--content-text-muted);
  }

  .rivalry-empty {
    color: var(--content-text-muted);
    text-align: center;
    padding: var(--spacing-lg, 24px);
  }

  .rivalry-section {
    margin-bottom: var(--spacing-xl, 32px);
  }

  .rivalry-section h2 {
    font-size: 1.15rem;
    margin-bottom: var(--spacing-md, 16px);
  }

  .rivalry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--spacing-sm, 8px);
  }

  .rivalry-stat {
    background: var(--card-bg);
    border: 1px solid var(--content-border);
    border-radius: 10px;
    padding: 0.85rem;
  }

  .rivalry-stat__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--content-text-muted);
  }

  .rivalry-stat__value {
    font-size: 1.4rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--page-text);
    margin: 0.15rem 0 0.3rem;
  }

  .rivalry-stat__ctx {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--content-text-muted);
  }

  /* Wide tables scroll inside their own container rather than the page. */
  .rivalry-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--content-border);
    border-radius: 10px;
    background: var(--card-bg);
  }

  .rivalry-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .rivalry-table th,
  .rivalry-table td {
    padding: 0.5rem 0.7rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--content-border);
  }

  .rivalry-table th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--content-text-muted);
    background: var(--content-bg-muted);
  }

  .rivalry-table td {
    color: var(--page-text);
    font-variant-numeric: tabular-nums;
  }

  .rivalry-table tbody tr:last-child td {
    border-bottom: none;
  }

  .rivalry-table .is-winner {
    font-weight: 700;
  }

  .rivalry-table .is-playoff td {
    background: var(--content-bg-muted);
  }

  .rivalry-caveat {
    margin: var(--spacing-sm, 8px) 0 0;
    font-size: 0.78rem;
    color: var(--content-text-muted);
    max-width: 70ch;
  }

  .rivalry-trades {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rivalry-trade {
    background: var(--card-bg);
    border: 1px solid var(--content-border);
    border-radius: 10px;
    padding: 0.75rem 0.85rem;
  }

  .rivalry-trade__date {
    font-size: 0.78rem;
    color: var(--content-text-muted);
    margin-bottom: 0.4rem;
  }

  .rivalry-trade__sides {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.5rem;
  }

  .rivalry-trade__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--content-text-muted);
  }

  .rivalry-trade__sides ul {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--page-text);
  }

  .rivalry-trade__sides .dim {
    color: var(--content-text-muted);
  }

  .rivalry-trade__comment {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--content-text-muted);
    border-left: 2px solid var(--content-border);
    padding-left: 0.6rem;
  }

  @media (max-width: 640px) {
    .rivalry-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .rivalry-side__icon {
      width: 48px;
      height: 48px;
    }
  }
</style>
