---
/**
 * AFL rivalries index — thin route wrapper around the shared League History
 * rivalries page (components/shared/league-history/HistoryRivalriesPage),
 * which replaced the AFL's own matrix (2026-10-26). What stays here is the
 * AFL's own: the grid split by conference (today's alignment, from the league
 * config) and the head-to-head coverage note. The data imports stay here
 * because a static import specifier can't be a runtime variable.
 */
import HistoryRivalriesPage from '../../../components/shared/league-history/HistoryRivalriesPage.astro';
import historyData from '../../../../data/afl-fantasy/derived/league-history.json';
import franchiseHistory from '../../../../data/afl-fantasy/derived/franchise-history.json';
import aflConfig from '../../../../data/afl-fantasy/afl.config.json';
import { describeCoverageGap } from '../../../utils/rivalries';

export const prerender = false;

// One grid per conference: a 24-column grid is punishing on a phone.
const teams = aflConfig.teams as Array<{ franchiseId: string; conference?: string }>;
const gridGroups = ((aflConfig.conferences ?? []) as Array<{ code: string; name: string }>).map((c) => ({
  name: c.name,
  franchiseIds: teams.filter((t) => t.conference === c.code).map((t) => t.franchiseId),
}));
// Seasons whose head-to-head the archives only partly cover.
const coverageNote = describeCoverageGap(((franchiseHistory as any).h2hCoverage ?? []) as any[]);
---

<HistoryRivalriesPage leagueSlug="afl-fantasy" data={historyData} gridGroups={gridGroups}>
  {coverageNote && <p class="rx-coverage">{coverageNote} Any meeting from those seasons is missing from these records.</p>}
</HistoryRivalriesPage>

<style>
  .rx-coverage {
    margin: 1.25rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
  }
</style>
