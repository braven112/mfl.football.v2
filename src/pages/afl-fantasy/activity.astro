---
export const prerender = false;

import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import OwnerActivityReport from '../../components/theleague/OwnerActivityReport.astro';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import { chooseTeamName } from '../../utils/team-names';
import {
	getAllActivity,
	getDailyPageViews,
	getGlobalPagePopularity,
	getAllOwnerPagePopularity,
	buildOwnerActivityRow,
	sortByLastSeen,
	type OwnerActivityRow,
} from '../../utils/owner-activity';
import { lastMflMoveByFranchise, type MflMove } from '../../utils/mfl-activity';
import { getLeagueContext, getLeagueBaseUrl } from '../../utils/league-context';

// League resolved from URL via the registry — never hardcode the id/slug.
const league = getLeagueContext(Astro.url);
const baseUrl = getLeagueBaseUrl(league);
const leagueId = league.leagueId;

const franchiseIds = aflConfig.teams.map((t: any) => t.franchiseId);

// AFL franchises carry no `color` field, so the shared theleague color map
// doesn't cover them. Assign a deterministic, visually-distinct chart color by
// franchise index so each line on the page-views chart is legible.
const CHART_PALETTE = [
	'#cc2936', '#1f77b4', '#2ca02c', '#ff7f0e', '#9467bd', '#8c564b',
	'#e377c2', '#17becf', '#bcbd22', '#d62728', '#0d6efd', '#198754',
	'#fd7e14', '#6f42c1', '#20c997', '#dc3545', '#0dcaf0', '#6610f2',
	'#d63384', '#ffc107', '#495057', '#0a8754', '#b5179e', '#3a0ca3',
];
function aflChartColor(franchiseId: string, index: number): string {
	const n = parseInt(franchiseId, 10);
	const i = Number.isFinite(n) ? (n - 1) : index;
	return CHART_PALETTE[((i % CHART_PALETTE.length) + CHART_PALETTE.length) % CHART_PALETTE.length];
}

let activityMap: Record<string, number> = {};
let pageViewData: { dates: string[]; data: Record<string, Record<string, number>> } = { dates: [], data: {} };
let globalPages: { page: string; count: number }[] = [];
let ownerPages: Record<string, { page: string; count: number }[]> = {};

// Mock data for local development — ?mock=true enables it
const useMock = Astro.url.searchParams.has('mock');

if (useMock) {
	// Seeded random for deterministic output
	const seed = (s: number) => () => { s = (s * 16807 + 0) % 2147483647; return (s - 1) / 2147483646; };

	// Generate a spread of activity profiles across all AFL franchises so the
	// mock view exercises active / idle / dormant / never-seen states.
	const activityProfiles: Record<string, { baseViews: number; lastSeenHoursAgo: number }> = {};
	franchiseIds.forEach((fid, idx) => {
		const rng = seed(parseInt(fid, 10) * 2917 + 13);
		const roll = rng();
		if (idx % 11 === 0) {
			activityProfiles[fid] = { baseViews: 0, lastSeenHoursAgo: -1 }; // never seen
		} else if (roll < 0.2) {
			activityProfiles[fid] = { baseViews: 2, lastSeenHoursAgo: 168 + Math.round(rng() * 200) }; // dormant
		} else if (roll < 0.5) {
			activityProfiles[fid] = { baseViews: 5, lastSeenHoursAgo: 36 + Math.round(rng() * 60) }; // idle
		} else {
			activityProfiles[fid] = { baseViews: 8 + Math.round(rng() * 10), lastSeenHoursAgo: Math.round(rng() * 12) }; // active
		}
	});

	// Last seen timestamps
	for (const [fid, profile] of Object.entries(activityProfiles)) {
		if (profile.lastSeenHoursAgo >= 0) {
			activityMap[fid] = Date.now() - profile.lastSeenHoursAgo * 3600_000;
		}
	}

	// Daily page views for 30 days
	const dates: string[] = [];
	for (let i = 29; i >= 0; i--) {
		const d = new Date(); d.setDate(d.getDate() - i);
		dates.push(d.toISOString().slice(0, 10));
	}
	const pvData: Record<string, Record<string, number>> = {};
	for (const date of dates) {
		pvData[date] = {};
		for (const [fid, profile] of Object.entries(activityProfiles)) {
			if (profile.baseViews === 0) continue;
			const rng = seed(parseInt(fid, 10) * 1000 + parseInt(date.replace(/-/g, ''), 10));
			const dayOfWeek = new Date(date).getDay();
			const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
			const recencyBoost = 1 + (dates.indexOf(date) / dates.length) * 0.5;
			const weekendBoost = isWeekend ? 1.4 : 1;
			const views = Math.max(0, Math.round(profile.baseViews * recencyBoost * weekendBoost * (0.3 + rng() * 1.4)));
			if (views > 0) pvData[date][fid] = views;
		}
	}
	pageViewData = { dates, data: pvData };

	// Global page popularity
	const pageWeights = [
		{ page: '/rosters', weight: 280 },
		{ page: '/standings', weight: 190 },
		{ page: '/players', weight: 150 },
		{ page: '/lineup', weight: 132 },
		{ page: '/keepers', weight: 110 },
		{ page: '/league-summary', weight: 84 },
		{ page: '/playoffs', weight: 61 },
		{ page: '/calendar', weight: 43 },
		{ page: '/whats-new', weight: 27 },
		{ page: '/activity', weight: 22 },
		{ page: '/rules', weight: 14 },
	];
	globalPages = pageWeights.map(({ page, weight }) => ({ page, count: weight }));

	// Per-owner page popularity
	ownerPages = {};
	for (const fid of franchiseIds) {
		const profile = activityProfiles[fid];
		if (!profile || profile.baseViews === 0) { ownerPages[fid] = []; continue; }
		const rng = seed(parseInt(fid, 10) * 7919);
		ownerPages[fid] = pageWeights
			.slice(0, 5 + Math.floor(rng() * 5))
			.map(({ page, weight }) => ({
				page,
				count: Math.max(1, Math.round(weight * (profile.baseViews / 10) * (0.5 + rng()))),
			}))
			.sort((a, b) => b.count - a.count);
	}
} else {
	try {
		[activityMap, pageViewData, globalPages, ownerPages] = await Promise.all([
			getAllActivity(leagueId),
			getDailyPageViews(leagueId, 30),
			getGlobalPagePopularity(leagueId),
			getAllOwnerPagePopularity(leagueId, franchiseIds),
		]);
	} catch { /* Redis unavailable */ }
}

// ── MFL move recency ──
// Read ONLY to back the Last Seen column. This page is site analytics; the
// league's transaction log is the Schefter feed's job, not a leaderboard here.
// This is the FALLBACK MFL signal: MFL's own `lastVisit` (loaded below) is a
// real login timestamp and strictly better, but it exists only for leagues we
// are commissioner of and only once the sync workflow has run.
let mflMoveMap: Record<string, MflMove> = {};

// import.meta.glob must be at the top level (Vite requirement)
const txFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/transactions.json', { eager: true });

if (useMock) {
	const MOCK_MOVE_TYPES = ['TRADE', 'FREE_AGENT', 'WAIVER', 'IR'];
	for (const fid of franchiseIds) {
		const n = parseInt(fid, 10);
		// Busier owners moved more recently; franchises with no moves are left
		// out so the "no moves" branch of the blend is exercised too.
		const moves = (n % 4) + (n % 6) + (n % 5);
		if (moves > 0) {
			mflMoveMap[fid] = {
				at: Date.now() - Math.max(0.25, 30 / (moves + 1)) * 86_400_000,
				type: MOCK_MOVE_TYPES[n % MOCK_MOVE_TYPES.length],
			};
		}
	}
} else {
	// AFL spans many historical seasons. Walk years newest-first and use the
	// most recent feed that actually has transactions — early in a new league
	// year the freshest dir (e.g. 2026) can exist but be near-empty, which would
	// leave every Last Seen row without its MFL fallback; fall back to the last
	// season with real moves.
	const yearKeys = Object.keys(txFeeds)
		.map(p => { const m = p.match(/\/(\d{4})\/transactions\.json$/); return m ? { year: parseInt(m[1], 10), key: p } : null; })
		.filter((e): e is { year: number; key: string } => e !== null)
		.sort((a, b) => b.year - a.year);

	const parseTx = (key: string): any[] => {
		const txMod: any = txFeeds[key];
		const txData = txMod && typeof txMod === 'object' && 'default' in txMod ? txMod.default : txMod;
		return txData?.transactions?.transaction
			? (Array.isArray(txData.transactions.transaction) ? txData.transactions.transaction : [txData.transactions.transaction])
			: [];
	};

	let rawTx: any[] = [];
	for (const { key } of yearKeys) {
		const parsed = parseTx(key);
		if (parsed.length > 0) { rawTx = parsed; break; }
	}

	mflMoveMap = lastMflMoveByFranchise(rawTx);
}

// MFL's own `lastVisit` — the real last-login timestamp per franchise, synced
// by .github/workflows/sync-owner-last-visit.yml. A glob rather than a static
// import so a league without the file yet builds fine instead of failing on a
// missing module. Empty map = fall back to transaction recency.
const lastVisitFiles = import.meta.glob('../../../data/afl-fantasy/owner-last-visit.json', { eager: true });
const mflVisitMap: Record<string, number> = useMock
	? // Mock MFL logins, so ?mock stays self-contained. Reading the real file here
	  // would mix live owner login times into a fixture page and make the mock's
	  // own move fixtures unreachable. Every third franchise is left out so the
	  // transaction fallback is exercised too.
	  Object.fromEntries(
			franchiseIds
				.filter((_fid: string, i: number) => i % 3 !== 0)
				.map((fid: string, i: number) => [fid, Date.now() - ((i * 7) % 60) * 3_600_000]),
		)
	: (() => {
	const mod: any = Object.values(lastVisitFiles)[0];
	const data = mod && typeof mod === 'object' && 'default' in mod ? mod.default : mod;
	const raw = data?.lastVisit;
	if (!raw || typeof raw !== 'object') return {};
	// Stored as epoch SECONDS (MFL's unit); everything downstream is ms.
	const out: Record<string, number> = {};
	for (const [franchiseId, seconds] of Object.entries(raw)) {
		const n = Number(seconds);
		if (Number.isFinite(n) && n > 0) out[franchiseId] = n * 1000;
	}
	return out;
})();

const teams: OwnerActivityRow[] = sortByLastSeen(
	aflConfig.teams.map((team: any) =>
		buildOwnerActivityRow({
			franchiseId: team.franchiseId,
			name: chooseTeamName({
				fullName: team.name,
				nameMedium: team.nameMedium,
				nameShort: team.nameShort,
				abbrev: team.abbrev,
			}),
			icon: team.icon,
			siteVisit: activityMap[team.franchiseId] ?? null,
			mflVisit: mflVisitMap[team.franchiseId] ?? null,
			move: mflMoveMap[team.franchiseId] ?? null,
		}),
	),
);

// Build chart series data: one series per team with daily page view counts
const chartTeams = aflConfig.teams.map((team: any, idx: number) => ({
	id: team.franchiseId,
	name: chooseTeamName({
		fullName: team.name,
		nameMedium: team.nameMedium,
		nameShort: team.nameShort,
		abbrev: team.abbrev,
	}, 'short'),
	color: aflChartColor(team.franchiseId, idx),
	icon: team.icon,
	values: pageViewData.dates.map((d) => pageViewData.data[d]?.[team.franchiseId] ?? 0),
}));
const chartDates = pageViewData.dates;
---

<TheLeagueLayout title="Owner Activity">
	<OwnerActivityReport
		leagueName={league.name}
		leagueHref={baseUrl}
		teams={teams}
		globalPages={globalPages}
		ownerPages={ownerPages}
		chartTeams={chartTeams}
		chartDates={chartDates}
	/>
</TheLeagueLayout>
