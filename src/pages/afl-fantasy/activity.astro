---
/**
 * Owner Activity (AFL) — thin route wrapper.
 *
 * The page is components/shared/OwnerActivityPage; the gate and the feed maps
 * stay here (Astro.rewrite only works from a page, and the shared page never
 * names a league's data path). The maps are lazy and read through the
 * league-data loader (src/utils/league-data.ts). Private by default:
 * src/utils/owner-activity-access.ts.
 */
import OwnerActivityPage from '../../components/shared/OwnerActivityPage.astro';
import { getAuthUser } from '../../utils/auth';
import { resolveOwnerActivityAccess } from '../../utils/owner-activity-access';
import { loginUrlForRequest, forbiddenPathFor } from '../../utils/login-redirect';
import { getLeagueBySlug } from '../../config/leagues';
import { getLeagueContext } from '../../utils/league-context';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';
import type { LazyFeedGlob } from '../../utils/mfl-feed-glob';

export const prerender = false;

// League resolved from URL via the registry — never hardcode the id/slug.
const league = getLeagueBySlug(getLeagueContext(Astro.url).slug)!;
const access = await resolveOwnerActivityAccess(getAuthUser(Astro.request), league);
if (access.kind === 'login') return Astro.redirect(loginUrlForRequest(Astro, league));
if (access.kind === 'forbidden') return Astro.rewrite(forbiddenPathFor(league, 'admin'));

const lazyFeeds = (paths: string[]): LazyFeedGlob =>
  Object.fromEntries(paths.map((p) => [p, () => loadLeagueData(p)]));
// This route's own data, whatever host the request came in on.
const dataPath = getLeagueBySlug('afl-fantasy')!.dataPath;
const transactionFeeds = lazyFeeds(listLeagueData(`${dataPath}/mfl-feeds/*/transactions.json`));
const lastVisitFiles = lazyFeeds(listLeagueData(`${dataPath}/owner-last-visit.json`));
---

<OwnerActivityPage
	leagueSlug={league.slug}
	transactionFeeds={transactionFeeds}
	lastVisitFiles={lastVisitFiles}
	canManage={access.canManage}
/>
