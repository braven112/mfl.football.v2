---
/**
 * AFL Homepage — route over the shared league homepage
 * (src/components/shared/home/LeagueHomePage.astro), which package leagues
 * render too. What stays here is the AFL's own: its team preference
 * (`?myteam` cookie write — a page-only operation), its conference-scoped
 * hero and live scoring, and its cards (team snapshot with the spotlight
 * tile, What's Next, conference playoff preview, tiered standings), passed
 * into the page's slots.
 *
 * 2-column layout mirroring TheLeague's homepage:
 *   Left  — rotating hero (calendar-driven), team snapshot, conference-draft
 *           preview (in season), tiered standings preview, What's Next
 *           timeline, quick links.
 *   Right — Schefter Report news feed (sticky sidebar).
 *
 * The hero is the shared league hero (`resolveLeagueHomeHero`), whose AFL profile encodes AFL's
 * calendar cadence: long quiet offseason → keeper window in June/July →
 * conference draft weekend before Labor Day → regular season → playoffs →
 * championship. What's New entries tagged `leagues: ['afl']` (or untagged)
 * surface during quiet periods.
 */
export const prerender = false;

import LeagueHomePage from '../../components/shared/home/LeagueHomePage.astro';

import { getPersonaLabels } from '../../utils/persona-server';
// TEMPORARY (2026-08-20 → 08-23): for this preseason weekend the hero IS the
// live-scoring test drive — the shared page renders it INSTEAD of the hero,
// gated on the one showTestDriveHero() call below. Delete with
// src/utils/live-scoring-test-drive.ts.
import { showTestDriveHero } from '../../utils/live-scoring-test-drive';
import AflTeamSnapshot from '../../components/afl/hp-sections/AflTeamSnapshot.astro';
import AflStandingsCompact from '../../components/afl/hp-sections/AflStandingsCompact.astro';
import AflConferencePlayoffPreview from '../../components/afl/hp-sections/AflConferencePlayoffPreview.astro';
import AflWhatsNext from '../../components/afl/hp-sections/AflWhatsNext.astro';

import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import feedData from '../../../data/afl-fantasy/schefter-feed.json';
import { getWhatsNewEntriesForLeague } from '../../utils/whats-new-entries';

import type { SchefterFeed as FeedType } from '../../types/schefter';
import { parseTestDate } from '../../utils/hero-resolver';
import { resolveLeagueHomeHero } from '../../utils/league-hero/page';
import { getFranchiseConference } from '../../utils/afl-conference';
import {
  buildLiveScoringHeroProps,
  type BuiltLiveScoringProps,
} from '../../utils/live-scoring-hero-props';
import { getAflWhatsNextTimeline } from '../../utils/league-event-resolver';
import { getAflLeagueYear, getCurrentSeasonYear } from '../../utils/league-year';
import { isSeasonWindowOpen } from '../../utils/pecking-order-season-window.mjs';
import { ensureLeaguePrefix } from '../../config/leagues';
import { getCurrentNFLWeek } from '../../utils/current-week';
import { findNextGame, franchiseSchedule, parseWeeklySchedule } from '../../utils/schedule-data.mjs';
import { loadMyTeamWeek } from '../../utils/my-team-week';
import { chooseTeamName } from '../../utils/team-names';
import { loadAflDraftSlot } from '../../utils/afl-draft-slot';
import { resolveAflTeamSpotlight } from '../../utils/afl-team-spotlight';
import { resolveHeroFranchiseBackdrop } from '../../utils/hero-franchise-backdrop';
import {
  getAFLPreference,
  setAFLPreference,
  getAFLTeamData,
  resolveAFLTeamSelection,
} from '../../utils/team-preferences';
import { getAuthUser, franchiseIdForLeague } from '../../utils/auth';
import { spriteUrl } from '../../utils/sprite-url';
import { getLeagueBySlug } from '../../config/leagues';
import { readInstallState } from '../../utils/app-install-state';
import { resolveSchefterRail } from '../../utils/schefter-rail-view';
import aflTopPlayers from '../../../data/afl-fantasy/derived/top-players.json';
import type { TopPlayersFile } from '../../types/top-players';

// ── Team preference resolution ──────────────────────────────────────────────
const myTeamParam = Astro.url.searchParams.get('myteam');
const franchiseParam = Astro.url.searchParams.get('franchise');

if (myTeamParam) {
  const teamData = getAFLTeamData(myTeamParam);
  if (teamData) {
    setAFLPreference(Astro.cookies, myTeamParam, teamData.conference, teamData.tier);
  }
}

/** This league's registry entry — resolved once, not per use site. */
const AFL = getLeagueBySlug('afl-fantasy')!;

const cookiePref = getAFLPreference(Astro.cookies);
const authUser = getAuthUser(Astro.request);
const authAflFranchiseId = franchiseIdForLeague(authUser, AFL.id);
// The install banner is an interruption, so it never shows to an owner who
// already has the app — a fact only the ACCOUNT can hold. `display-mode:
// standalone` is false in the desktop browser of someone whose phone has had
// the app since August, and Chrome keeps offering the install there because on
// that device it genuinely is installable. See src/utils/app-install-state.ts.
//
// It takes an AFL SESSION, not merely a signed-in one. The banner exists to
// make notifications reachable, and those are franchise-scoped — a TheLeague
// owner browsing here cannot receive a single AFL alert (/notifications
// redirects them), so installing the AFL app buys them nothing. They are also
// the one viewer whose "I already have it" can never be recorded: the report
// carries this page's league and the server, correctly, refuses to file it
// against their own. Pitching an app to someone who can neither use it nor
// dismiss it for good is the "toggle that silently does nothing" again.
const showInstallBanner =
  !!authAflFranchiseId && !(await readInstallState(AFL.id, authAflFranchiseId));

// The session had been smuggled through `cookiePreference` — the one slot it
// must not use, since a param-less signed-in owner then looked like a cookie
// choice. It has its own slot, and with no `defaultTeam` the resolver answers
// undefined for a viewer who has named no team, so the `hasExplicitTeam`
// guard that used to undo its hardcoded '0001' is gone.
const userFranchiseId = resolveAFLTeamSelection({
  myTeamParam,
  franchiseParam,
  cookiePreference: cookiePref?.franchiseId,
  authUserFranchise: authAflFranchiseId,
});
const userTeam = userFranchiseId ? aflConfig.teams.find(t => t.franchiseId === userFranchiseId) : undefined;
const userConferenceId = (userTeam?.conference === '00' || userTeam?.conference === '01')
  ? (userTeam.conference as '00' | '01')
  : undefined;
const userConferenceName = userConferenceId
  ? aflConfig.conferences.find(c => c.code === userConferenceId)?.name
  : undefined;

// The owner's own colours + crest behind the promo hero.
//
// Deliberately the SESSION's franchise, not `userTeam` — so this reads
// `authAflFranchiseId` rather than the `?myteam=` / cookie preference that the
// My Team card, the standings highlight and the spotlight tile all follow.
// Those cards say "here is a team"; the hero, painted in someone's colours,
// says "this site is yours", and that claim should rest on having actually
// signed in rather than on a query param anyone can set. It also keeps the two
// leagues' homepages answering the question the same way — TheLeague has no
// team picker at all, so a preference-driven AFL hero would have been the one
// asymmetry between them. (Brandon's call, Sep 2026.)
//
// `authAflFranchiseId` already carries the league check, so a TheLeague session
// browsing here cannot be handed the AFL's franchise 0001.
//
// 'afl' and not AFL.slug: this is the crest manifest's league key, which is not
// the route directory ('afl-fantasy'). See `crestStrokeIndex`.
const heroBackdropTeam = authAflFranchiseId
  ? aflConfig.teams.find(t => t.franchiseId === authAflFranchiseId)
  : undefined;
const heroBackdrop = resolveHeroFranchiseBackdrop(heroBackdropTeam, 'afl');

// ── Date / hero state ───────────────────────────────────────────────────────
const testDateParam = Astro.url.searchParams.get('testDate');
const effectiveDate = parseTestDate(testDateParam) ?? new Date();
// One date instance for the gate AND the component it gates — see the same
// comment on TheLeague's homepage for the boundary race that splitting them
// creates. `effectiveDate` is always defined here, which is why this page was
// already correct; the shared const keeps it that way.
const testDriveHero = showTestDriveHero(AFL.slug, effectiveDate);

// ---------------------------------------------------------------------------
// The Owners' Poll card. Same shape as TheLeague's — one shared component, each
// route bringing its own league's data — because a static glob specifier
// cannot be a runtime variable. See that page for why this reads the committed
// archive rather than Redis.
const ownersPollIssues = import.meta.glob<any>(
  '../../../data/afl-fantasy/pecking-order/*.json',
  { eager: true, import: 'default' },
);

const ownersPollIssue = Object.entries(ownersPollIssues)
  .map(([file, data]) => {
    const m = file.match(/(\d{4})-(\d{1,2})\.json$/);
    return m ? { year: Number(m[1]), week: Number(m[2]), data } : null;
  })
  .filter((x): x is { year: number; week: number; data: any } => !!x)
  // THIS season only. Without it the newest archived result wins outright, so
  // between Labor Day and the season's first count the card publishes LAST
  // season's ranking — today that is the seeded synthetic example — under a
  // heading that reads as the current room's opinion.
  .filter((x) => x.year === getCurrentSeasonYear(effectiveDate))
  .filter((x) => (x.data?.ownersPoll?.ranked?.length ?? 0) > 0)
  .sort((a, b) => b.year - a.year || b.week - a.week)[0] ?? null;

const showOwnersPollCard =
  AFL.ownersPoll?.enabled &&
  isSeasonWindowOpen(getCurrentSeasonYear(effectiveDate), effectiveDate);
const testMode = !!testDateParam;

const timeline = getAflWhatsNextTimeline(effectiveDate);
const aflWhatsNew = getWhatsNewEntriesForLeague('afl');

// ── Standings + roster data ─────────────────────────────────────────────────
const standingsFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/standings.json', { eager: true });
const rosterFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/rosters.json', { eager: true });
const scheduleFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/schedule.json', { eager: true });

function getModule(mod: any) {
  return mod && typeof mod === 'object' && 'default' in mod ? mod.default : mod;
}

// The season this page DISPLAYS, which is not always the season being PLAYED.
// MFL creates the new year at kickoff and leaves it empty until games are
// played, so this walks back from getCurrentSeasonYear to the most recent year
// with populated standings rather than rendering an empty table.
//
// Deliberately NOT the year the recap hero asks about — see `liveSeasonYear`
// below, which is computed from the same clock but never walks back.
function resolveSeasonYearWithData(): number {
  const preferred = getCurrentSeasonYear(effectiveDate);
  for (let y = preferred; y >= preferred - 5; y--) {
    const feed = getModule(standingsFeeds[`../../../data/afl-fantasy/mfl-feeds/${y}/standings.json`]) as { leagueStandings?: { franchise: any[] } } | undefined;
    if (feed?.leagueStandings?.franchise?.length) return y;
  }
  return preferred;
}

const seasonYear = resolveSeasonYearWithData();

/**
 * Rosters run on the LEAGUE year, which is NOT the season year — the two clocks
 * are ~3 months apart for the AFL (June 1 rollover vs Labor Day). CLAUDE.md's
 * rule: anything roster-management-shaped uses the league year.
 *
 * Reading rosters off `seasonYear` showed the last COMPLETED season's roster
 * for the whole offseason — in August that is 20 players from a team that no
 * longer exists, while the actual roster is the 7 keepers the draft is about to
 * fill out. Walks back the same way `resolveSeasonYearWithData` does, because
 * MFL creates the new year's directory before it holds anything.
 */
function resolveRosterYearWithData(): number {
  const preferred = getAflLeagueYear(effectiveDate);
  for (let y = preferred; y >= preferred - 5; y--) {
    const feed = getModule(rosterFeeds[`../../../data/afl-fantasy/mfl-feeds/${y}/rosters.json`]) as { rosters?: { franchise?: any | any[] } } | undefined;
    const franchises = feed?.rosters?.franchise;
    if (Array.isArray(franchises) ? franchises.length : franchises) return y;
  }
  return preferred;
}

const aflLeagueYear = getAflLeagueYear(effectiveDate);
const rosterYear = resolveRosterYearWithData();

function pickFeed(feeds: Record<string, unknown>, suffix: string, year = seasonYear) {
  return getModule(feeds[`../../../data/afl-fantasy/mfl-feeds/${year}/${suffix}`]);
}

const standingsFeed = pickFeed(standingsFeeds, 'standings.json') as { leagueStandings?: { franchise: any[] } } | undefined;
const standingsFranchises: any[] = standingsFeed?.leagueStandings?.franchise ?? [];

// Roster count for the user's team, from the current league year.
const rostersFeed = pickFeed(rosterFeeds, 'rosters.json', rosterYear) as { rosters?: { franchise: any | any[] } } | undefined;
const rosterFranchises = rostersFeed?.rosters?.franchise
  ? Array.isArray(rostersFeed.rosters.franchise) ? rostersFeed.rosters.franchise : [rostersFeed.rosters.franchise]
  : [];
const userRosterEntry = rosterFranchises.find((r: any) => r.id === userFranchiseId);
const rosterCount = userRosterEntry?.player
  ? (Array.isArray(userRosterEntry.player) ? userRosterEntry.player.length : 1)
  : undefined;

// Next opponent for the snapshot's "Next Up" tile. The tile has always had
// the prop; nothing filled it, so it read "TBD" all season. `findNextGame`
// skips played weeks, so a doubleheader week resolves to the first game still
// to play rather than to the week's last one.
const scheduleWeeks = parseWeeklySchedule(pickFeed(scheduleFeeds, 'schedule.json'));
const nextGame = userFranchiseId
  ? findNextGame(franchiseSchedule(scheduleWeeks, userFranchiseId), getCurrentNFLWeek(effectiveDate, seasonYear) ?? 1)
  : null;
const nextOpponentTeam = nextGame
  ? aflConfig.teams.find((t: { franchiseId: string }) => t.franchiseId === nextGame.opponentId)
  : undefined;
const nextOpponent = nextOpponentTeam
  ? {
      name: chooseTeamName(
        {
          fullName: nextOpponentTeam.name,
          nameMedium: nextOpponentTeam.nameMedium,
          nameShort: nextOpponentTeam.nameShort,
          abbrev: nextOpponentTeam.abbrev,
        },
        'default',
      ),
      icon: nextOpponentTeam.icon,
      isHome: nextGame?.isHome,
    }
  : undefined;

// Record from standings feed
const userStandingsRow = standingsFranchises.find((f: any) => f.id === userFranchiseId);
const recordParts = (userStandingsRow?.h2hwlt ?? '').split('-').map((n: string) => parseInt(n, 10));
const record = recordParts.length === 3 && recordParts.every(Number.isFinite)
  ? { wins: recordParts[0], losses: recordParts[1], ties: recordParts[2] }
  : undefined;

// ── The hero ────────────────────────────────────────────────────────────────
// The shared league hero (src/utils/league-hero/): resolved, then cast, from
// this league's own feeds. The standings leader personalizes the Monday slot.
const standingsLeaderId = standingsFranchises.length
  ? [...standingsFranchises].sort((a: any, b: any) => {
      const pct = (f: any) => {
        const [w, l, t] = (f.h2hwlt ?? '').split('-').map((n: string) => parseInt(n, 10));
        const games = (w || 0) + (l || 0) + (t || 0);
        return games ? ((w || 0) + (t || 0) * 0.5) / games : 0;
      };
      return pct(b) - pct(a) || parseFloat(b.pf || '0') - parseFloat(a.pf || '0');
    })[0]?.id
  : undefined;

// The waiver deadline's DAY and HOUR come from MFL's own calendar, never from
// prose — the 2026 feed has the AFL processing Wednesday 8pm PT all season
// EXCEPT a Tuesday run on Dec 29. Keyed by the AFL's MFL LEAGUE year (June 1
// rollover), which is what `/players` reads the same feed with.
const aflCalendarModules = import.meta.glob(
  '../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/calendar.json',
  { eager: true }
);
const aflLeagueYearForHero = getAflLeagueYear(effectiveDate);
const aflWaiverCalendar =
  (Object.entries(aflCalendarModules).find(([path]) => path.includes(`/${aflLeagueYearForHero}/`))?.[1] as any)?.default ?? [];

const heroState = await resolveLeagueHomeHero({
  league: AFL,
  effectiveDate,
  testMode,
  cookies: Astro.cookies,
  authUser,
  authFranchiseId: authAflFranchiseId,
  // The browsed team casts (the My Team card follows it too); the SIGNED-IN
  // franchise alone decides whose colours the card wears.
  castFranchiseId: userFranchiseId,
  userPoolId: userConferenceId,
  userTier: userTeam?.tier,
  poolOf: getFranchiseConference,
  posts: (feedData as FeedType).posts,
  waiverCalendar: aflWaiverCalendar,
  leagueYear: aflLeagueYearForHero,
  timeline,
  whatsNewEntries: aflWhatsNew,
  standingsLeaderId,
});

const inSeasonVariant = heroState.kind === 'regular-season' || heroState.kind === 'playoffs' || heroState.kind === 'championship';

// In season the My Team card becomes "this week" (shared with TheLeague —
// src/utils/my-team-week.ts). It follows the BROWSED team like the rest of the
// card, but lineup status is the signed-in owner's alone.
const myTeamWeek = inSeasonVariant && userFranchiseId
  ? await loadMyTeamWeek({
      league: AFL,
      franchiseId: userFranchiseId,
      isOwner: !!authAflFranchiseId && authAflFranchiseId === userFranchiseId,
      leagueYear: aflLeagueYear,
      seasonYear: getCurrentSeasonYear(effectiveDate),
      currentNflWeek: getCurrentNFLWeek(effectiveDate, getCurrentSeasonYear(effectiveDate)),
      now: effectiveDate,
    })
  : null;

// ── Team snapshot spotlight (offseason fourth tile) ─────────────────────────
// Replaces the old "Keepers — X of 7 protected" tile, which could only ever
// render "—": AFL has no MFL keeper construct, so there was no count to pass.
// Resolved only for the offseason card that shows it, and only for a signed-in
// / team-selected viewer — the draft tier reads feeds off disk.
const spotlight = !inSeasonVariant && userFranchiseId
  ? await resolveAflTeamSpotlight({
      franchiseId: userFranchiseId,
      draftSlot: loadAflDraftSlot({
        franchiseId: userFranchiseId,
        conferenceId: userTeam?.conference,
        referenceDate: effectiveDate,
      }),
    })
  : null;

// ── Schefter feed ───────────────────────────────────────────────────────────
// The rail IS the owner's Watching feed. The WHOLE feed goes in: slicing to
// 30 first and filtering after leaves almost nothing, because the newest posts
// are overwhelmingly wire.
const feed = feedData as FeedType;
const rail = await resolveSchefterRail({ league: AFL, posts: feed.posts, authUser, now: effectiveDate });

// Hide the What's Next card that the hero already promotes — EXCEPT when the
// hero is a conference draft. In the keeper→draft window the hero counts down
// the viewer's own draft, and What's Next lists BOTH the AL and NL drafts, so
// we deliberately don't exclude the hero's draft there (it's one of the two).
const heroEventId = heroState.content.heroEventId;
const heroIsDraft = heroEventId === 'afl-al-draft' || heroEventId === 'afl-nl-draft';

// What's New row: skip whatever article the hero is already featuring, and read
// the last-visit cookie so "NEW" badges light up for unseen entries.
const heroWhatsNewId = heroState.content.heroEntryId;
const lastVisitDate = Astro.cookies.get('whats_new_last_visit')?.value ?? null;
// ── Live scoring hero ───────────────────────────────────────────────────────
// The same shared builder TheLeague's homepage uses. The AFL differs in one
// way: it narrows the SUPPORTING matchups to the viewer's own conference.
// Twenty-four teams across two conferences means "the three closest games in
// the league" is mostly games against people this owner will never play.
//
// Scoping needs a conference, and a conference needs a signed-in franchise —
// so `authAflFranchiseId`, deliberately not the `?myteam=` preference (a hero
// scoped to someone's colours should rest on having signed in, the same rule
// the franchise backdrop and the composite accent already follow). A viewer
// with no conference gets the league-wide cast rather than an arbitrary half.
let aflLiveScoring: BuiltLiveScoringProps | undefined;

if (heroState.kind === 'regular-season' && heroState.slot === 'live-scoring' && heroState.week) {
  const viewerConference = authAflFranchiseId ? getFranchiseConference(authAflFranchiseId) : null;
  aflLiveScoring = await buildLiveScoringHeroProps({
    league: AFL.slug,
    week: heroState.week,
    origin: Astro.url,
    teams: aflConfig.teams,
    userFranchiseId: authAflFranchiseId ?? undefined,
    ...(viewerConference
      ? {
          scopeFranchiseIds: aflConfig.teams
            .filter((t: { franchiseId: string }) => getFranchiseConference(t.franchiseId) === viewerConference)
            .map((t: { franchiseId: string }) => t.franchiseId),
        }
      : {}),
  });
}

// Owner-facing copy follows the league's persona (src/utils/persona.mjs).
const labels = await getPersonaLabels('afl-fantasy');
---

<LeagueHomePage
  leagueSlug={AFL.slug}
  topPlayers={aflTopPlayers as unknown as TopPlayersFile}
  title="AFL — American Football League"
  installBanner={showInstallBanner ? { leagueName: 'AFL Fantasy' } : null}
  effectiveDate={effectiveDate}
  testDriveHero={testDriveHero}
  hero={{
    state: heroState,
    liveScoring: aflLiveScoring,
    config: aflConfig,
    standings: standingsFranchises,
    userFranchiseId,
    backdrop: heroBackdrop,
  }}
  ownersPoll={showOwnersPollCard
    ? {
        issue: ownersPollIssue ? { year: ownersPollIssue.year, week: ownersPollIssue.week, ownersPoll: ownersPollIssue.data.ownersPoll } : null,
        ballotHref: ensureLeaguePrefix(AFL, '/owners-poll'),
      }
    : null}
  whatsNew={{
    entries: aflWhatsNew,
    basePath: '/afl-fantasy',
    allReleasesLink: '/afl-fantasy/whats-new',
    spriteUrl,
    lastVisitDate,
    urlHost: 'afl-fantasy.com',
    excludeId: heroWhatsNewId,
  }}
  testMode={testMode}
  rail={{
    label: `${labels.reportShort} feed`,
    posts: rail.posts,
    isAuthenticated: !!authUser,
    userFranchiseId: authAflFranchiseId ?? undefined,
    personalized: rail.personalized,
    forYouIds: rail.forYouIds,
    watching: rail.watchingByPost,
    emptyText: rail.emptyText,
  }}
>
  <AflTeamSnapshot
    slot="snapshot"
    userTeam={userTeam}
    userConferenceName={userConferenceName}
    record={record}
    nextOpponent={nextOpponent}
    rosterCount={rosterCount}
    rosterYear={rosterYear === aflLeagueYear ? undefined : rosterYear}
    rosterLimit={28}
    spotlight={spotlight}
    variant={inSeasonVariant ? 'in-season' : 'offseason'}
    thisWeek={myTeamWeek}
  />

  <AflWhatsNext
    slot="whats-next"
    demoDate={effectiveDate}
    maxCards={2}
    excludeEventId={heroIsDraft ? undefined : heroEventId}
  />

  {standingsFranchises.length > 0 && (
    <AflConferencePlayoffPreview
      slot="standings"
      teams={aflConfig.teams}
      standings={standingsFranchises}
      config={aflConfig}
      userFranchiseId={userFranchiseId}
      conferenceCode={userConferenceId ?? '00'}
    />
  )}

  {standingsFranchises.length > 0 && (
    <AflStandingsCompact
      slot="standings"
      teams={aflConfig.teams}
      standings={standingsFranchises}
      userFranchiseId={userFranchiseId}
      relegationCount={4}
    />
  )}
</LeagueHomePage>
