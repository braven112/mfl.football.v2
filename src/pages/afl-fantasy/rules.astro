---
import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import PayoutsTable from '../../components/shared/PayoutsTable.astro';
import { getLeagueBySlug } from '../../config/leagues';
import { formatPrizeAmount, getAwardPrize } from '../../utils/prize-display';
import { promises as fs } from 'node:fs';
import path from 'node:path';

const AFL_SLUG = getLeagueBySlug('afl-fantasy')!.slug;

export const prerender = false;

// Read the AFL constitution HTML at build time. The source of truth is
// docs/rules.html — when the AFL league office updates the constitution,
// drop a new version of that file in and the page picks it up.
const rulesPath = path.join(
  process.cwd(),
  'src',
  'pages',
  'afl-fantasy',
  'docs',
  'rules.html'
);

let rulesHtml: string;
try {
  rulesHtml = await fs.readFile(rulesPath, 'utf8');
} catch {
  rulesHtml = '<p>Rules document not available.</p>';
}

// The constitution's Prize Distribution list is the one part of this document
// we do NOT render as written: prize amounts have a single source of truth in
// the league registry (docs/claude/rules/accounting.md), and a hand-typed copy
// here is free to drift from the dollars the commissioner actually pays. Cut
// that list out and render <PayoutsTable> in the gap instead.
//
// This is a best-effort splice against a file the AFL league office replaces
// wholesale. If the markers are ever absent the split simply doesn't happen
// and the document renders exactly as delivered — a stale list is a smaller
// failure than a blank rules page.
const PRIZE_LIST_START = '<h3>Prize Distribution</h3>';
const PRIZE_LIST_END = '</ul>';
const prizeStart = rulesHtml.indexOf(PRIZE_LIST_START);
const prizeEnd =
  prizeStart === -1 ? -1 : rulesHtml.indexOf(PRIZE_LIST_END, prizeStart);

// The footnote after the list states a combined total ($450) that is itself
// two registry prizes added together, so it is derived rather than copied.
const leagueChampionship = getAwardPrize(AFL_SLUG, 'afl-championship');
const conferenceChampionship = getAwardPrize(AFL_SLUG, 'al-champion');
const doubleTitleFootnote =
  leagueChampionship && conferenceChampionship
    ? `The League Champion is also a Conference Champion, earning a total of ${formatPrizeAmount(
        leagueChampionship.amount + conferenceChampionship.amount
      )} for both titles.`
    : undefined;

// Everything after the list, minus the footnote the component now renders.
// Matched on its opening words rather than its full text: the footnote states
// a combined total, and pinning the old dollar figure here would stop matching
// the day that figure changes — leaving the stale footnote AND the derived one
// on the page together.
const FOOTNOTE_PATTERN = /<p><em>\*?The League Champion is also a Conference Champion[^<]*<\/em><\/p>/;
const canSplicePrizes = prizeStart !== -1 && prizeEnd !== -1;
const rulesHtmlBeforePrizes = canSplicePrizes ? rulesHtml.slice(0, prizeStart) : rulesHtml;
const rulesHtmlAfterPrizes = canSplicePrizes
  ? rulesHtml.slice(prizeEnd + PRIZE_LIST_END.length).replace(FOOTNOTE_PATTERN, '')
  : '';

// Section anchors lifted from the headings in docs/rules.html so the
// in-page jump nav stays in sync.
const sectionLinks = [
  { id: 'league-information', label: 'League Information' },
  { id: 'important-dates', label: 'Important Dates' },
  { id: 'division-setup', label: 'Division Setup' },
  { id: 'team-rosters', label: 'Team Rosters' },
  { id: 'injured-reserve', label: 'Injured Reserve' },
  { id: 'starting-rosters', label: 'Starting Rosters' },
  { id: 'trades', label: 'Trades' },
  { id: 'free-agents', label: 'Free Agents' },
  { id: 'keepers', label: 'Keepers' },
  { id: 'draft', label: 'Draft' },
  { id: 'schedule', label: 'Schedule' },
  { id: 'scoring', label: 'Scoring & Errors' },
  { id: 'game-tiebreakers', label: 'Game Tiebreakers' },
  { id: 'standings-tiebreakers', label: 'Standings Tiebreakers' },
  { id: 'playoff-structure', label: 'Playoff Structure' },
  { id: 'premier-dleague', label: 'Premier / D-League Competition' },
  { id: 'payouts', label: 'Payouts' },
  { id: 'replacement-owners', label: 'Replacement Owners' },
  { id: 'rule-changes', label: 'Rule Changes' },
];
---

<TheLeagueLayout title="AFL Constitution & Rules">
  <div class="afl-rules-page">
    <header class="afl-rules-page__hero">
      <h1>AFL Constitution</h1>
      <p>
        The full rule set for AFL. Use the table of contents to jump
        to a section. Edits to this document live at
        <code>src/pages/afl-fantasy/docs/rules.html</code>.
      </p>
      <a href="/afl-fantasy/rules-chat" class="afl-rules-chat-link">
        Got a question? Ask Roger
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </header>

    <nav class="afl-rules-page__toc" aria-label="Constitution sections">
      <h2 class="afl-rules-page__toc-title">Sections</h2>
      <ol class="afl-rules-page__toc-list">
        {sectionLinks.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="afl-rules-page__content">
      <Fragment set:html={rulesHtmlBeforePrizes} />
      {canSplicePrizes && (
        <>
          <h3>Prize Distribution</h3>
          <PayoutsTable leagueSlug={AFL_SLUG} footnote={doubleTitleFootnote} />
        </>
      )}
      <Fragment set:html={rulesHtmlAfterPrizes} />
    </article>
  </div>
</TheLeagueLayout>

<style>
  .afl-rules-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--spacing-xl, 32px) var(--spacing-md, 16px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-xl, 32px);
  }

  @media (min-width: 1024px) {
    .afl-rules-page {
      grid-template-columns: 240px minmax(0, 1fr);
      grid-template-areas:
        'hero hero'
        'toc content';
    }

    .afl-rules-page__hero {
      grid-area: hero;
    }

    .afl-rules-page__toc {
      grid-area: toc;
    }

    .afl-rules-page__content {
      grid-area: content;
    }
  }

  .afl-rules-page__hero {
    border-bottom: 2px solid var(--content-border, #e5e7eb);
    padding-bottom: var(--spacing-md, 16px);
    margin-bottom: var(--spacing-md, 16px);
  }

  .afl-rules-page__hero h1 {
    font-size: 2rem;
    margin-bottom: var(--spacing-sm, 8px);
    color: var(--page-text, #1a1a1a);
  }

  .afl-rules-page__hero p {
    color: var(--content-text-muted, #6b7280);
    line-height: 1.6;
  }

  .afl-rules-page__hero code {
    background: var(--content-bg-muted, #f3f4f6);
    color: var(--page-text, inherit);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.875em;
  }

  .afl-rules-page__toc {
    position: sticky;
    top: 80px;
    align-self: start;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e5e7eb);
    border-radius: 8px;
    padding: var(--spacing-md, 16px);
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  :global(html.dark) .afl-rules-page__toc {
    box-shadow: 0 0 0 1px var(--content-border, #555);
  }

  .afl-rules-page__toc-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--content-text-muted, #6b7280);
    margin: 0 0 var(--spacing-sm, 8px) 0;
  }

  .afl-rules-page__toc-list {
    list-style: decimal;
    padding-left: var(--spacing-md, 16px);
    margin: 0;
  }

  .afl-rules-page__toc-list li {
    padding: 2px 0;
  }

  .afl-rules-page__toc-list a {
    color: var(--page-text, #1a1a1a);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .afl-rules-page__toc-list a:hover {
    color: var(--league-accent, #c41e3a);
    text-decoration: underline;
  }

  .afl-rules-page__content {
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e5e7eb);
    border-radius: 8px;
    padding: var(--spacing-lg, 24px);
    line-height: 1.7;
    color: var(--page-text, #1a1a1a);
  }

  :global(html.dark) .afl-rules-page__content {
    box-shadow: 0 0 0 1px var(--content-border, #555);
  }

  .afl-rules-page__content :global(h2) {
    scroll-margin-top: 80px;
  }

  /* ── Ask Roger CTA ── */
  .afl-rules-chat-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.5rem 0.875rem;
    background: var(--league-accent, #c41e3a);
    color: #fff;
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .afl-rules-chat-link:hover {
    background: color-mix(in srgb, var(--color-primary, #c41e3a) 80%, black);
    text-decoration: none;
  }
</style>
