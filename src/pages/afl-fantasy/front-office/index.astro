---
/**
 * Front Office hub (AFL) — thin route wrapper.
 *
 * Same shell, same panel, same switcher as TheLeague's: the hub is one
 * component now (FrontOfficePanel), and what differs between the leagues is
 * decided by registry features, not by which file you are looking at.
 *
 * The AFL gained a team switcher here. Its analytics, draft assets and
 * stacks are public roster data, so any team is browsable read-only; its
 * KEEPER BOARD is not, and the panel explains that absence itself.
 *
 * The cookie WRITE stays in this route: `Astro.cookies.set()` from an
 * imported component runs after the headers are committed and throws.
 * Keep this file thin (tests/page-fork-ratchet.test.ts).
 */
import FrontOfficeHubPage from '../../../components/shared/front-office-hub/FrontOfficeHubPage.astro';
import FrontOfficeTeamSwitcher from '../../../components/shared/front-office-hub/FrontOfficeTeamSwitcher.astro';
import FrontOfficePanel from '../../../components/shared/front-office-hub/FrontOfficePanel.astro';
import { buildFrontOfficePanelData } from '../../../utils/front-office-panel-data';
import { getAuthUser, franchiseIdForLeague } from '../../../utils/auth';
import { getLeagueBySlug } from '../../../config/leagues';
import { getTeam } from '../../../utils/afl-conference';
import {
  getAFLPreference,
  rememberAflTeamChoice,
  resolveAFLTeamSelection,
} from '../../../utils/team-preferences';

export const prerender = false;

const league = getLeagueBySlug('afl-fantasy')!;
const user = getAuthUser(Astro.request);
const myFranchiseId = franchiseIdForLeague(user, league.id);

const myTeamParam = Astro.url.searchParams.get('myteam');
const franchiseParam =
  Astro.url.searchParams.get('franchise') ??
  Astro.url.searchParams.get('team') ??
  Astro.url.searchParams.get('franchiseId');

// Cookie WRITE — route frontmatter only (see this file's header).
rememberAflTeamChoice(Astro.cookies, myTeamParam);
const cookiePreference = getAFLPreference(Astro.cookies);

// Priority: param > cookie > the viewer's own team > first team. The owner's
// franchise goes in `authUserFranchise`, its own slot; this panel renders ONE
// team, so '0001' is a real fallback behind it.
// See docs/claude/rules/preferred-team.md.
const selectedTeamId = resolveAFLTeamSelection({
  myTeamParam,
  franchiseParam,
  cookiePreference: cookiePreference?.franchiseId,
  authUserFranchise: myFranchiseId,
  defaultTeam: '0001',
}) ?? '0001';

const data = await buildFrontOfficePanelData({
  leagueSlug: 'afl-fantasy',
  selectedTeamId,
  viewerFranchiseId: myFranchiseId,
  viewerMflCookie: user?.id,
});

const myTeamInfo = myFranchiseId ? getTeam(myFranchiseId) : undefined;
const myTeam = myTeamInfo ? { id: myTeamInfo.franchiseId, name: myTeamInfo.name, icon: myTeamInfo.icon } : null;
---

<FrontOfficeHubPage leagueSlug="afl-fantasy" myTeam={myTeam} leagueYear={data.leagueYear}>
  <FrontOfficeTeamSwitcher slot="switcher" teams={data.teamsList} selectedTeamId={selectedTeamId} />
  <FrontOfficePanel {...data} />
</FrontOfficeHubPage>
