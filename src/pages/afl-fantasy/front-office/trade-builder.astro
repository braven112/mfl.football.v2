---
/**
 * Trade Builder (AFL) — thin route wrapper around the AFL-family trade builder
 * (components/afl-family/TradeBuilderPage), shared with the custom-site demo's
 * keeper slot. The feed globs stay HERE: a specifier cannot be a runtime
 * variable.
 */
import TradeBuilderPage from '../../../components/afl-family/TradeBuilderPage.astro';
import { feedsByYear } from '../../../utils/afl-family-standings';
import { getLeagueBySlug } from '../../../config/leagues';

export const prerender = false;

const FALLBACK_YEAR = 2025;

const feeds = {
  rosters: feedsByYear(import.meta.glob('../../../../data/afl-fantasy/mfl-feeds/*/rosters.json', { eager: true })),
  // Year-filtered (2025+): the bare glob baked ~22 MB of historical
  // players.json into the server chunk. tests/current-era-feed-globs.test.ts
  // guards it.
  players: feedsByYear(
    import.meta.glob('../../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/players.json', { eager: true }),
  ),
  adp: feedsByYear(import.meta.glob('../../../../data/afl-fantasy/mfl-feeds/*/adp-dynasty.json', { eager: true })),
  picks: feedsByYear(import.meta.glob('../../../../data/afl-fantasy/mfl-feeds/*/futureDraftPicks.json', { eager: true })),
  tradeBait: feedsByYear(import.meta.glob('../../../../data/afl-fantasy/mfl-feeds/*/tradeBait.json', { eager: true })),
  tradeBaitByFranchise: feedsByYear(
    import.meta.glob('../../../../data/afl-fantasy/mfl-feeds/*/tradeBait-by-franchise.json', { eager: true }),
  ),
};
const moduleData = (mod: any) => (mod && typeof mod === 'object' && 'default' in mod ? mod.default : mod);
// The newest season with real rosters.
const selectedYear =
  [...feeds.rosters.entries()]
    .filter(([, mod]) => moduleData(mod)?.rosters?.franchise)
    .map(([year]) => year)
    .sort((a, b) => b - a)[0] ?? FALLBACK_YEAR;
---

<TradeBuilderPage league={getLeagueBySlug('afl-fantasy')!} selectedYear={selectedYear} feeds={feeds} />
