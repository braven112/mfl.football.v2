---
/**
 * Standings (AFL) — thin route wrapper around the AFL-family standings page
 * (components/afl-family/StandingsPage), shared with the custom-site demo's
 * keeper slot.
 *
 * Kept HERE: the feed globs (a glob specifier cannot be a runtime variable),
 * the season redirects (`Astro.redirect()` only redirects from a page), and
 * the team-preference cookie (a component cannot set one).
 */
import StandingsPage from '../../components/afl-family/StandingsPage.astro';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import { feedsByYear, resolveStandingsRoute } from '../../utils/afl-family-standings';
import { getAFLPreference, setAFLPreference, getAFLTeamData, resolveAFLTeamSelection } from '../../utils/team-preferences';
import { getLeagueBySlug } from '../../config/leagues';
import { getAuthUser, franchiseIdForLeague } from '../../utils/auth';

const league = getLeagueBySlug('afl-fantasy')!;
const feeds = {
  standings: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/standings.json', { eager: true })),
  fetchMeta: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/fetch.meta.json', { eager: true })),
  weeklyResults: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/weekly-results.json', { eager: true })),
  // Each season's division/conference structure (the 2003-2012 AFL ran six
  // divisions; see afl-structure.ts).
  league: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/league.json', { eager: true })),
};
const route = await resolveStandingsRoute(Astro.url, league, '/afl-fantasy', feeds);
if ('redirect' in route) return Astro.redirect(route.redirect);

// A ?myteam= link sets the owner's team preference.
const myTeamParam = Astro.url.searchParams.get('myteam');
const cookiePreference = getAFLPreference(Astro.cookies);
if (myTeamParam) {
  const teamData = getAFLTeamData(myTeamParam);
  if (teamData) setAFLPreference(Astro.cookies, myTeamParam, teamData.conference, teamData.tier);
}
// No `defaultTeam`: a visitor with no choice and no session highlights NOBODY
// (it used to pass '0001', which told every signed-out stranger Smokane FC was
// their team). The session is league-gated with `franchiseIdForLeague` — both
// leagues have a franchise 0001.
const preferredTeamId = resolveAFLTeamSelection({
  myTeamParam,
  franchiseParam: Astro.url.searchParams.get('franchise'),
  cookiePreference: cookiePreference?.franchiseId,
  authUserFranchise: franchiseIdForLeague(getAuthUser(Astro.request), league.id),
});
---

<StandingsPage
  league={league}
  config={aflConfig}
  selectedYear={route.selectedYear}
  availableYears={route.availableYears}
  selectedFeed={route.feed}
  lastFetched={route.lastFetched}
  seasonLeagueFeed={feeds.league.get(route.selectedYear)}
  weeklyResultsFeed={feeds.weeklyResults.get(route.selectedYear)}
  preferredTeamId={preferredTeamId}
  competitions={true}
/>
