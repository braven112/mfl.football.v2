---
/**
 * Rosters (AFL) — thin route wrapper around the AFL-family rosters page
 * (components/afl-family/RostersPage), shared with the custom-site demo's
 * keeper slot.
 *
 * Kept HERE: the feed globs (a specifier cannot be a runtime variable), the
 * season redirect (`Astro.redirect()` only redirects from a page) and the
 * team-preference cookie (a component cannot set one).
 */
import RostersPage from '../../components/afl-family/RostersPage.astro';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import { feedsByYear } from '../../utils/afl-family-standings';
import { resolveRostersRoute } from '../../utils/afl-family-rosters';
import { setAFLPreference, getAFLTeamData } from '../../utils/team-preferences';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;

// AFL 2026 league hasn't been created on MFL yet — fall back to 2025 until
// the new league exists and feeds populate.
const FALLBACK_YEAR = 2025;

const myTeamParam = Astro.url.searchParams.get('myteam');
if (myTeamParam) {
  const teamData = getAFLTeamData(myTeamParam);
  if (teamData) setAFLPreference(Astro.cookies, myTeamParam, teamData.conference, teamData.tier);
}

const feeds = {
  rosters: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/rosters.json', { eager: true })),
  players: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/players.json', { eager: true })),
  // Season-to-date points for the whole pool, the SAME source the Free Agents
  // column reads (src/utils/stats-season.mjs). Committed from 2025 on.
  ytdScores: feedsByYear(
    import.meta.glob('../../../data/afl-fantasy/mfl-feeds/20{2[5-9],[3-9][0-9]}/playerScores-ytd.json', { eager: true }),
  ),
  tradeBait: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/tradeBait.json', { eager: true })),
  tradeBaitByFranchise: feedsByYear(
    import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/tradeBait-by-franchise.json', { eager: true }),
  ),
  futurePicks: feedsByYear(import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/futureDraftPicks.json', { eager: true })),
  // The roster header's gameday bar, keyed by the LEAGUE year like every
  // other feed directory here.
  schedule: feedsByYear(
    import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/schedule.json', { eager: true, import: 'default' }),
  ),
  standings: feedsByYear(
    import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/standings.json', { eager: true, import: 'default' }),
  ),
};
const route = resolveRostersRoute(Astro.url, '/afl-fantasy', feeds.rosters, feeds.players, FALLBACK_YEAR);
if ('redirect' in route) return Astro.redirect(route.redirect);
---

<RostersPage
  league={getLeagueBySlug('afl-fantasy')!}
  config={aflConfig}
  selectedYear={route.selectedYear}
  availableYears={route.availableYears}
  feeds={feeds}
  throwbackScope="afl"
  logoSrc="/assets/logos/afl-logo.svg"
/>
