---
/**
 * Submit Lineup — /afl-fantasy/lineup
 *
 * Thin route wrapper. The page itself is
 * `src/components/shared/lineup/LineupPage.astro`, rendered for both leagues.
 * AFL starter rules are identical to TheLeague's (QB:1, RB/WR/TE 1-4 across
 * three FLEX, PK:1, DEF:1 — nine slots), which is why one component serves
 * both. See that file for what stays in a route and why.
 */
export const prerender = false;

import LineupPage from '../../components/shared/lineup/LineupPage.astro';
import type { LineupBrand } from '../../types/lineups';
import { getAuthUser } from '../../utils/auth';
import { getAflLeagueYear } from '../../utils/league-year';
import { getLeagueBySlug } from '../../config/leagues';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';

// Auth gate — require an AFL-scoped session, not just any logged-in owner.
// A TheLeague JWT also carries a franchiseId, and that id would otherwise be
// fired at AFL's league (wrong roster, and a franchise the user doesn't own).
// Send anyone who isn't AFL-authenticated to the AFL login, preserving the
// requested path + query (e.g. ?week=12) so they land back where they aimed.
const MFL_LEAGUE_ID = getLeagueBySlug('afl-fantasy')!.id;
const user = getAuthUser(Astro.request);
if (!user?.franchiseId || user.leagueId !== MFL_LEAGUE_ID) {
  const next = encodeURIComponent(Astro.url.pathname + Astro.url.search);
  return Astro.redirect(`/afl-fantasy/login?next=${next}`);
}

const aflTeamsById = new Map<string, any>(
  ((aflConfig as any).teams ?? []).map((t: any) => [t.franchiseId, t]),
);

// The AFL has no throwback identities, so there is nothing async to resolve —
// the crest and color come straight from the league config.
//
// `iconDark` FIRST, and not gated on the theme: the faceoff panel is a
// team-color gradient over near-black in BOTH themes, so the site-wide
// `html.dark` crest swap (TeamIconDarkStyles) never fires here — a dark-inked
// crest would sit invisible behind a 0.34-opacity watermark in light mode.
// Ten of the 24 AFL teams ship a hand-authored dark variant; the rest fall
// back to their light crest, which the chip already names either way.
async function resolveBrands(): Promise<(franchiseId: string) => LineupBrand> {
  return (franchiseId: string) => {
    const team = aflTeamsById.get(franchiseId);
    return {
      name: team?.nameShort || team?.name || '',
      color: team?.colorPrimary,
      watermark: team?.iconDark || team?.icon,
    };
  };
}
---

<LineupPage
  leagueSlug="afl-fantasy"
  leagueYear={getAflLeagueYear()}
  franchiseId={user.franchiseId}
  basePath="/afl-fantasy/lineup"
  submitEndpoint="/api/afl-fantasy/lineup"
  draftStorageKey="lineup-draft-afl"
  resolveBrands={resolveBrands}
/>
