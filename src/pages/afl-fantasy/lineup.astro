---
/**
 * Set Lineup (AFL) — thin route wrapper around the AFL-family lineup page
 * (components/afl-family/LineupPage), which the custom-site demo's keeper
 * slot shares.
 *
 * The auth gate stays HERE: `Astro.redirect()` only redirects from a page.
 * It requires an AFL-scoped session, not just any logged-in owner — a
 * TheLeague JWT also carries a franchiseId, which would otherwise be fired at
 * the AFL's league (wrong roster, and a franchise the user doesn't own). The
 * login keeps the requested path + query (e.g. ?week=12).
 */
import LineupPage from '../../components/afl-family/LineupPage.astro';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import { getAuthUser } from '../../utils/auth';
import { loginUrlForRequest } from '../../utils/login-redirect';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;

const league = getLeagueBySlug('afl-fantasy')!;
const user = getAuthUser(Astro.request);
if (!user?.franchiseId || user.leagueId !== league.id) {
  return Astro.redirect(loginUrlForRequest(Astro, league));
}
---

<LineupPage league={league} config={aflConfig} user={{ ...user, franchiseId: user.franchiseId }} throwbackScope="afl" />
