---
/**
 * The Pecking Order (AFL) — current week (latest published issue).
 *
 * Thin wrapper over the shared issue component: reads all AFL pecking-order
 * JSON issues via Vite glob and picks the highest (year, week). Permalink to a
 * specific issue lives at /afl-fantasy/pecking-order/[year]/[week].
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../../components/theleague/Breadcrumbs.astro';
import PeckingOrderIssue, { type PeckingOrderData } from '../../../components/shared/PeckingOrderIssue.astro';

const issueFiles = import.meta.glob<PeckingOrderData>(
  '../../../../data/afl-fantasy/pecking-order/*.json',
  { eager: true, import: 'default' }
);

const issues = Object.entries(issueFiles)
  .map(([file, data]) => {
    const m = file.match(/(\d{4})-(\d{1,2})\.json$/);
    if (!m) return null;
    return {
      year: parseInt(m[1], 10),
      week: parseInt(m[2], 10),
      data: data as PeckingOrderData,
    };
  })
  .filter((x): x is { year: number; week: number; data: PeckingOrderData } => x !== null)
  .sort((a, b) => b.year - a.year || b.week - a.week);

const latest = issues[0] ?? null;

const olderIssues = issues.slice(1);
---

<TheLeagueLayout title={latest ? `${latest.data.headline} · The Pecking Order · Week ${latest.week}` : 'The Pecking Order'}>
  <div class="pr-page">
    <Breadcrumbs items={[
      { label: 'AFL', href: '/afl-fantasy' },
      { label: 'The Pecking Order' },
    ]} />

    {latest ? (
      <>
        <PeckingOrderIssue issue={latest.data} league="afl" />
        {olderIssues.length > 0 && (
          <aside class="pr-archive">
            <h2 class="pr-archive__title">Past Issues</h2>
            <ul class="pr-archive__list">
              {olderIssues.map(i => (
                <li>
                  <a href={`/afl-fantasy/pecking-order/${i.year}/${i.week}`}>
                    Week {i.week} · {i.year} — {i.data.headline}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </>
    ) : (
      <section class="pr-empty">
        <h1>The Pecking Order — Coming Soon</h1>
        <p>
          The first weekly issue publishes Tuesday morning during the season.
          Run <code>pnpm generate:pecking-order --league afl-fantasy --year YYYY --week N</code> to seed an issue.
        </p>
      </section>
    )}
  </div>
</TheLeagueLayout>

<style>
.pr-page { min-height: 60vh; }
.pr-archive {
  margin: 0 0 3rem;
}
.pr-archive__title {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0 0 0.75rem;
}
.pr-archive__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.4rem;
}
.pr-archive__list a {
  color: var(--page-text, #111827);
  text-decoration: none;
}
.pr-archive__list a:hover { text-decoration: underline; }
.pr-empty {
  max-width: 720px;
  margin: 4rem auto;
  text-align: center;
  color: var(--content-text-muted, #6b7280);
}
.pr-empty code {
  background: var(--content-bg-muted, #f3f4f6);
  padding: 0.15rem 0.35rem;
  border-radius: 0.25rem;
  font-size: 0.9em;
}
</style>
