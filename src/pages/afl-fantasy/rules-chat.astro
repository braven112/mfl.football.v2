---
/**
 * Ask Roger — the AFL. Thin route over the shared page
 * (src/components/shared/rules-chat/RulesChatPage.astro).
 */
export const prerender = false;

import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import RulesChatPage from '../../components/shared/rules-chat/RulesChatPage.astro';
import { getAuthUser, isCommissionerOrAdmin } from '../../utils/auth';
import { LEAGUES } from '../../config/leagues-data.mjs';
import seedData from '../../data/afl-rules-qa-seeds.json';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import type { RulesQA } from '../../types/rules-qa';

const authUser = getAuthUser(Astro.request);
const teamIcons = aflConfig.teams.map((t: { franchiseId: string; icon: string }) => ({
  franchiseId: t.franchiseId,
  icon: t.icon,
}));
---

<TheLeagueLayout title="Ask Roger">
  <RulesChatPage
    league={LEAGUES['afl-fantasy']}
    seedData={seedData as RulesQA[]}
    isAuthenticated={!!authUser}
    isAdmin={authUser ? isCommissionerOrAdmin(authUser) : false}
    teamIcons={teamIcons}
    apiEndpoint="/api/afl-rules-qa"
    rulesHref="/afl-fantasy/rules"
    rulebookName="the AFL constitution"
    bio="He's read the AFL constitution cover to cover — every conference, every division, and the fine print about promotion and relegation that even the Commissioner forgot about."
  />
</TheLeagueLayout>
