---
/**
 * AFL Draft Broadcast — the big board for the room.
 *
 * A laptop plugged into a TV on draft night. Owners make their picks in MFL's
 * own live draft room; this page follows along, and the moment a selection
 * lands it throws the player on screen over his drafting franchise's colors.
 *
 * DELIBERATELY NOT a variant of /theleague/draft-room. That page is an
 * interactive tool — queue, chat, filters, submit-pick — built for one person
 * at a laptop. This is a zero-input display read from ten feet away. They share
 * the data layer (`buildDraftPlayers`, `pick-reveal.ts`, `/api/draft/status`)
 * and nothing else; making one page serve both would compromise both.
 *
 * The AFL drafts by CONFERENCE: two independent 108-pick boards
 * (CONFERENCE00 = American, franchises 0001–0012; CONFERENCE01 = National,
 * 0013–0024). `?conference=` picks which one is on the TV. In 2025 the two
 * drafted on different DAYS, so the page must never assume both are live.
 *
 * Query string, all optional:
 *   ?conference=00|01   which board is on the TV
 *   ?year=YYYY          season (defaults to the AFL league year — June 1 clock)
 *   ?rehearse=N         replay a finished season from pick N (no network)
 *   ?mflLeague=<id>     FOLLOW ANOTHER MFL LEAGUE'S LIVE DRAFT — the dry run
 *                       for draft night, since rehearsal never polls. Add
 *                       ?mflHost= for a specific www## host, ?unit= to name a
 *                       draft unit. Always flagged on screen.
 *   ?warm=N|all|off     how many players deep to pre-cache images for
 *   ?screensaver=N|off  seconds of idle board before it replays the draft to
 *                       itself (default 600 — see SCREENSAVER_IDLE_MS). The
 *                       short override is how you watch it work without
 *                       standing in front of a TV for ten minutes.
 */

import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import DraftBroadcastIsland from '../../../components/shared/draft-broadcast/DraftBroadcast';
import aflConfig from '../../../../data/afl-fantasy/afl.config.json';
import { getLeagueBySlug } from '../../../config/leagues';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { buildDraftPlayers } from '../../../utils/build-draft-players';
import {
  assignBoardRanks,
  buildConferenceBoard,
  buildDefenseFacesByTeam,
  enrichBroadcastPlayers,
  fetchRemoteDraftResults,
  findRehearsalYear,
  hasDraftSlots,
  loadConferenceKeepers,
  loadFranchiseHoldings,
  trimToDraftable,
} from '../../../utils/draft-broadcast-server';
import { resolveBroadcastSource } from '../../../utils/draft-broadcast-source';
import { broadcastStrokeIndex, resolveBroadcastCrest } from '../../../utils/broadcast-crest';
import { resolveWarmDepth } from '../../../utils/draft-broadcast-images';
import { resolveScreensaverIdleMs } from '../../../utils/draft-broadcast';
import type {
  BroadcastConference,
  BroadcastPlayer,
  DraftBroadcastPageData,
} from '../../../types/draft-broadcast';
import type { DraftRoomTeam } from '../../../types/draft-room';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../../../styles/draft-broadcast.css';

export const prerender = false;

// League constants come from the registry — never literals (see
// tests/league-literal-guard.test.ts).
const league = getLeagueBySlug('afl-fantasy')!;

// The AFL's league year rolls over June 1, NOT TheLeague's Feb 14. Using the
// wrong clock here shows last year's board for months.
const defaultYear = getLeagueYearForSlug(league.slug);
const yearParam = Astro.url.searchParams.get('year');
const parsedYear = yearParam ? parseInt(yearParam, 10) : NaN;
const leagueYear = Number.isFinite(parsedYear) ? parsedYear : defaultYear;

// ── Which conference is on the TV ──
const conferences: BroadcastConference[] = (aflConfig.conferences ?? []).map((c: any) => ({
  code: c.code,
  name: c.name,
  unit: `CONFERENCE${c.code}`,
}));
const requestedCode = (Astro.url.searchParams.get('conference') || '').trim();
const conference =
  conferences.find((c) => c.code === requestedCode) ?? conferences[0];

// ── Board skeleton (all 108 slots, filled or not) ──
// fs rather than import.meta.glob: globbing would compile every season of
// draftResults into the server bundle to serve one. Same call as
// afl-draft-slot.ts makes for the same reason.
let draftResultsRaw: any = null;
try {
  draftResultsRaw = JSON.parse(
    readFileSync(
      join(process.cwd(), `${league.dataPath}/mfl-feeds/${leagueYear}/draftResults.json`),
      'utf-8'
    )
  );
} catch {
  draftResultsRaw = null;
}

// ── Which draft this board is WATCHING ──
// Its own, unless `?mflLeague=` points it at another MFL league's live draft —
// the only way to exercise poll → diff → queue → reveal end to end before draft
// night, since `?rehearse=` never touches the network. See
// draft-broadcast-source.ts for why the host is allowlisted and why an override
// is always flagged on screen.
const source = resolveBroadcastSource(Astro.url.searchParams, {
  leagueId: league.id,
  mflHost: league.mflHost,
  unit: conference?.unit ?? '',
});

// An override takes its SKELETON from the same league it will poll: draft
// order, round count and who is on the clock before the first poll lands all
// come from the board, so reading the local feed here would show the room the
// real league's order over the copy's picks.
//
// Two ways that can come back with nothing, and the local skeleton is the
// fallback for BOTH — an override must degrade to a board that follows nothing,
// never to a blank TV. The second is the one that actually happens: a fresh
// copy league answers with its draft units already named and zero slots in
// them until someone sets the draft up (see hasDraftSlots). The poll takes over
// the moment real slots appear either way.
if (source.isOverride) {
  const remote = await fetchRemoteDraftResults({
    leagueId: source.leagueId,
    host: source.mflHost,
    year: leagueYear,
  });
  if (remote && hasDraftSlots(remote, source.unit ?? '')) draftResultsRaw = remote;
}

const board = buildConferenceBoard(draftResultsRaw, source.unit ?? '');

// ── Rehearsal ──
// The real board is empty until draft night, so this is the only way to drive
// the page end-to-end beforehand: point it at a COMPLETED season and let it
// replay. `rehearse=N` means "start with N picks already made, then roll
// forward one at a time" — the island does the rolling, through the SAME
// ingest path a live poll uses, so a dry run exercises the real pipeline
// rather than a mock of it. The FULL board ships either way; the island trims
// it to the starting state. Clamped so a typo can't produce a negative board.
const rehearseParam = Astro.url.searchParams.get('rehearse');
const rehearseUpTo = rehearseParam ? Math.max(0, parseInt(rehearseParam, 10) || 0) : undefined;
const picks = board.picks;

// ── Franchise brands ──
// Read straight off afl.config.json rather than through getFranchiseBrand(),
// which is hardcoded to theleague.config.json. Every AFL franchise already
// carries colorPrimary/colorSecondary/icon, so there's nothing to resolve.
// These colors ride SERIALIZED on DraftRoomTeam — importing a brand util into
// the island would ship the whole league config JSON to the client.
const conferenceTeams = (aflConfig.teams ?? []).filter(
  (t: any) => t.conference === conference?.code
);
// One index for the whole conference rather than one per team — see
// broadcastStrokeIndex.
const aflStrokeIndex = broadcastStrokeIndex('afl', aflConfig.teams ?? []);

const teams: DraftRoomTeam[] = conferenceTeams.map((t: any) => ({
  franchiseId: t.franchiseId,
  name: t.name,
  nameMedium: t.nameMedium || t.name,
  nameShort: t.nameShort || t.name,
  abbrev: t.abbrev || '',
  // Crest art, and the outline a light cut needs to survive a board that is
  // dark in BOTH themes — resolved server-side because none of the site's
  // `html.dark` crest machinery reaches this page. See resolveBroadcastCrest
  // for why the big and small surfaces can end up on different artwork.
  ...resolveBroadcastCrest(t, 'afl', aflStrokeIndex),
  colorPrimary: t.colorPrimary,
  colorSecondary: t.colorSecondary,
  // The franchise's hand-authored card background. Rides serialized like the
  // colors above, for the same reason: the island must not import the league
  // config to look one string up.
  broadcastGradient: t.broadcastGradient,
}));

// ── Player pool ──
// buildDraftPlayers reads theleague's players.json, which is correct here:
// MFL player ids are GLOBAL and both leagues carry the identical 2609-player
// universe. adpSource 'redraft' because the AFL re-drafts most of the roster
// every year — a dynasty ADP would call every veteran pick a reach.
// No viewerFranchiseId: RSP is licensed content and this screen is shown to a
// room full of people.
const allPlayers = buildDraftPlayers(leagueYear, {
  adpSource: 'redraft',
}) as BroadcastPlayer[];

const enriched = enrichBroadcastPlayers(allPlayers, {
  dataPath: league.dataPath,
  year: leagueYear,
});

const boardPlayerIds = new Set(picks.map((p) => p.playerId).filter(Boolean));

// ── Board rank ──
// The AFL is a KEEPER league: each franchise holds 7, so 84 of this
// conference's players are gone before 1.01 is called. Ranking against the
// full player universe is what made the whole first round read as a reach.
// Keepers are conference-scoped because `duplicatePlayers` lets the National
// League keep a man the American League can still draft.
const conferenceFranchiseIds = new Set(conferenceTeams.map((t: any) => t.franchiseId));
const keptIds = loadConferenceKeepers(
  league.dataPath,
  leagueYear,
  conferenceFranchiseIds,
  boardPlayerIds
);
const ranked = assignBoardRanks(enriched, keptIds);

const players = trimToDraftable(ranked, boardPlayerIds);

// What each franchise already HOLDS — its keepers, here — for the screensaver's
// roster panels. Resolved against the UNTRIMMED pool (`ranked`), because a
// keeper is by definition not on the board and most of them are trimmed out of
// the shipped pool by the line above. Thin records only; see RosterHolding.
const holdings = loadFranchiseHoldings(
  league.dataPath,
  leagueYear,
  conferenceFranchiseIds,
  boardPlayerIds,
  ranked
);

// A team defense has no headshot of its own, so the reveal card stands two of
// the unit's marquee defenders in for it. Built from the TRIMMED pool — one
// list per team rather than one per player — see buildDefenseFacesByTeam.
const defenseFaces = buildDefenseFacesByTeam(players);

// Which season each conference's "Rehearse" link points at. Resolved from the
// feeds (see findRehearsalYear) rather than assumed, so a rehearsal link is
// either correct or absent — never a board that renders empty.
//
// Computed for EVERY conference, including while already rehearsing, because
// the conference switcher stays live during a replay: sending the current
// replay's year to the other conference assumes the two finished the same
// seasons, which is exactly what duplicatePlayers does not guarantee.
// Anchored to defaultYear, NOT leagueYear: "most recent finished season" is a
// property of today, not of whatever season is currently on screen. Using
// leagueYear walks the candidates backwards on every hop — a 2025 replay would
// offer 2024 on the conference switcher, then 2023 from there.
const rehearsalYears: Record<string, number> = {};
for (const c of conferences) {
  const year = findRehearsalYear(league.dataPath, defaultYear, c.unit);
  if (year !== undefined) rehearsalYears[c.code] = year;
}

const pageData: DraftBroadcastPageData = {
  leagueYear,
  conference: conference ?? { code: '00', name: 'American League', unit: 'CONFERENCE00' },
  totalRounds: board.totalRounds,
  picksPerRound: board.picksPerRound,
  teams,
  picks,
  players,
  leagueId: source.leagueId,
  mflHost: source.mflHost,
  feedUnit: source.unit,
  sourceLabel: source.label,
  warmDepth: resolveWarmDepth(Astro.url.searchParams.get('warm')),
  screensaverIdleMs: resolveScreensaverIdleMs(Astro.url.searchParams.get('screensaver')),
  rehearseUpTo,
  rehearsalYears,
  defenseFaces,
  holdings,
};

const title = `${conference?.name ?? 'AFL'} Draft Board | AFL`;
---

<TheLeagueLayout title={title} hideMobileNavIcons>
  <DraftBroadcastIsland
    client:load
    pageData={JSON.stringify(pageData)}
    conferences={JSON.stringify(conferences)}
  />
</TheLeagueLayout>
