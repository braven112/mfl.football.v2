---
/**
 * Draft Room (AFL) — thin route wrapper.
 *
 * Shared render lives in components/shared/draft-room/DraftRoomPage; the
 * AFL-specific decisions live in utils/afl-draft-room, which documents WHY
 * the two conferences draft on different MFL pages and must never be crossed.
 *
 * Everything downstream is scoped to the chosen conference: the board, the
 * franchises, the deep link, the clock's units, and the client's poll URL —
 * see `pollUnit`, without which /api/draft/status hands the AL's picks to
 * everyone.
 */
import DraftRoomPage from '../../../components/shared/draft-room/DraftRoomPage.astro';
import aflConfigData from '../../../../data/afl-fantasy/afl.config.json';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { getAFLPreference, resolveAFLTeamSelection } from '../../../utils/team-preferences';
import { getAuthUser, franchiseIdForLeague } from '../../../utils/auth';
import { getLeagueBySlug } from '../../../config/leagues';
import { buildAflRoomPageData, resolveAflRoomFor } from '../../../utils/afl-draft-room';
import { loadLeagueData } from '../../../utils/league-data';

export const prerender = false;

const league = getLeagueBySlug('afl-fantasy')!;
const user = getAuthUser(Astro.request);
// The session was correctly league-gated here but smuggled through
// `cookiePreference`, so a signed-in owner with no cookie was indistinguishable
// from a cookie choice. It has its own slot now. No `defaultTeam`: this value
// is the chair the room treats as yours, and '0001' put a logged-out visitor in
// somebody's seat — see utils/afl-draft-room.ts, which routes AROUND that
// default rather than trusting it.
const myFranchiseId = resolveAFLTeamSelection({
  myTeamParam: Astro.url.searchParams.get('myteam'),
  franchiseParam: Astro.url.searchParams.get('franchise'),
  cookiePreference: getAFLPreference(Astro.cookies)?.franchiseId,
  authUserFranchise: franchiseIdForLeague(user, league.id),
});

const room = resolveAflRoomFor(
  aflConfigData.conferences ?? [],
  Astro.url.searchParams.get('conference'),
  myFranchiseId
);

const leagueYear = getLeagueYearForSlug('afl-fantasy');
const yearFeed = async (file: string) => {
  const path = `${league.dataPath}/mfl-feeds/${leagueYear}/${file}`;
  return { [path]: { default: await loadLeagueData(path) } };
};

const pageData = await buildAflRoomPageData({
  room,
  leagueYear,
  leagueId: league.id,
  mflHost: league.mflHost,
  myFranchiseId,
  draftResultsFeeds: await yearFeed('draftResults.json'),
  leagueFeeds: await yearFeed('league.json'),
  partyHost: import.meta.env.PUBLIC_PARTYKIT_HOST || '',
});
---

<DraftRoomPage
  leagueSlug="afl-fantasy"
  title={`${room.selected.short} Draft Room | AFL`}
  pageData={pageData}
  userTeamId={room.userTeamId}
  conferences={room.conferences}
  conference={room.conference}
  basePath="/afl-fantasy/draft/room"
  isViewersConference={room.isViewersConference}
  draftContext="general"
/>
