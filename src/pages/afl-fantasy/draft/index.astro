---
/**
 * Draft hub (AFL) — thin route wrapper.
 *
 * Shared render lives in components/shared/draft-hub/DraftHubPage; the
 * assembly lives in utils/draft-hub-data#buildDraftHubProps.
 *
 * The globs are HERE because a static import specifier can't be a runtime
 * variable. They are LAZY, and the calendar/futureDraftPicks feeds are globbed
 * rather than imported by year for the same reason — writing the year into the
 * specifier is a league constant that goes stale at the next rollover.
 */
import DraftHubPage from '../../../components/shared/draft-hub/DraftHubPage.astro';
import aflConfigData from '../../../../data/afl-fantasy/afl.config.json';
import { getAuthUser, isAuthorizedForLeague } from '../../../utils/auth';
import { getLeagueBySlug } from '../../../config/leagues';
import { resolveConfigForYear } from '../../../utils/team-names';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { buildDraftHubProps } from '../../../utils/draft-hub-data';
import { listLeagueData, loadLeagueData } from '../../../utils/league-data';
import type { LazyFeedGlob } from '../../../utils/mfl-feed-glob';

export const prerender = false;

// Draft capital is shown only to a signed-in owner OF THIS LEAGUE. Without the
// league check, a TheLeague owner browsing the AFL would be shown their own
// franchise id's AFL picks — both leagues have a franchise 0001.
const league = getLeagueBySlug('afl-fantasy')!;
const user = getAuthUser(Astro.request);
const myFranchiseId = user && isAuthorizedForLeague(user, league.id) ? user.franchiseId : null;

// Lazy, in the shape of a lazy `import.meta.glob`: the keys say which seasons
// exist, and only the seasons the page asks for are read, through the
// league-data loader (src/utils/league-data.ts) rather than the bundle.
const lazyFeeds = (paths: string[]): LazyFeedGlob =>
  Object.fromEntries(paths.map((p) => [p, () => loadLeagueData(p)]));
const feedsDir = `${league.dataPath}/mfl-feeds`;

const props = await buildDraftHubProps({
  draftFeeds: lazyFeeds(listLeagueData(`${feedsDir}/*/draftResults.json`)),
  calendarFeeds: lazyFeeds(listLeagueData(`${feedsDir}/*/calendar.json`)),
  futurePickFeeds: lazyFeeds(listLeagueData(`${feedsDir}/*/futureDraftPicks.json`)),
  // Per-league rollover, NOT TheLeague's clock: the AFL flips June 1 and
  // TheLeague Feb 14, so using the latter would put the AFL hub on the wrong
  // season's calendar, future picks and team config for ~3.5 months a year.
  // getLeagueYearForSlug falls back for a league that declares no rollover,
  // so TheLeague's behaviour is unchanged.
  leagueYear: getLeagueYearForSlug('afl-fantasy'),
  unionSlug: 'afl-fantasy',
  myFranchiseId,
  teamsForYear: (year) =>
    (resolveConfigForYear(aflConfigData as any, year).teams ?? []).map((t: any) => ({
      id: t.franchiseId,
      name: t.name,
      icon: t.icon,
      banner: t.banner,
    })),
});
---

<DraftHubPage leagueSlug="afl-fantasy" {...props} />
