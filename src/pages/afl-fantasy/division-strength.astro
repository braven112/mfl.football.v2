---
/**
 * Division Strength (AFL) — thin route wrapper.
 *
 * Shared implementation lives in
 * components/shared/division-strength/DivisionStrengthPage.
 *
 * The derived file is read HERE, through the league-data loader
 * (src/utils/league-data.ts), so the shared component never names a league's
 * data path and the 1.6 MB report is not bundled into the server function.
 *
 * The redirect also lives HERE, and must: `Astro.redirect()` only redirects
 * from a PAGE. Returned from a component's frontmatter it merely stops
 * rendering that component and the response is still a 200 with a blank body.
 */
import DivisionStrengthPage from '../../components/shared/division-strength/DivisionStrengthPage.astro';
import { getLeagueBySlug } from '../../config/leagues';
import { loadLeagueData } from '../../utils/league-data';
import { resolveDivisionStrengthView } from '../../utils/division-strength-view';
import { resolveLeaguePath } from '../../utils/nav-utils';
import type { DivisionStrengthFile } from '../../types/division-strength';

export const prerender = false;

const league = getLeagueBySlug('afl-fantasy')!;
const data = (await loadLeagueData(`${league.dataPath}/derived/division-strength.json`)) as unknown as DivisionStrengthFile;
const basePath = resolveLeaguePath(
  '/afl-fantasy/division-strength',
  Astro.locals.hideLeaguePrefix ?? false
);
const view = resolveDivisionStrengthView(Astro.url, data, basePath);
if (view.kind === 'redirect') return Astro.redirect(view.to, 302);
---

<DivisionStrengthPage leagueSlug="afl-fantasy" data={data} view={view} />
