---
/**
 * The Schefter Report — AFL Fantasy.
 *
 * Thin route wrapper over the shared page body
 * (src/components/shared/SchefterNewsPage.astro). Only the feed import lives
 * here, because the AFL's feed sits at the repo-root data/ rather than under
 * src/data/ and a static import specifier cannot be a runtime variable.
 *
 * The AFL has no group chat, so it gets no Group Chat tab and no live poller.
 */
export const prerender = false;

import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import SchefterNewsPage from '../../components/shared/SchefterNewsPage.astro';
import { getAuthUser } from '../../utils/auth';
import { getLeagueBySlug } from '../../config/leagues';
import { resolveSchefterNewsView } from '../../utils/schefter-news-view';
import type { SchefterFeed as FeedType } from '../../types/schefter';

// AFL feed data lives in data/ (not src/data/).
let feed: FeedType = { lastScanTimestamp: '', lastProcessedMflTimestamp: '0', posts: [] };
try {
  const raw = await import('../../../data/afl-fantasy/schefter-feed.json');
  feed = raw.default as FeedType;
} catch {
  // Feed not yet populated
}

const authUser = getAuthUser(Astro.request);
const league = getLeagueBySlug('afl-fantasy')!;

const view = await resolveSchefterNewsView({
  league,
  feed,
  authUser,
  url: Astro.url,
});
---

<TheLeagueLayout title="The Schefter Report" og={view.og}>
  <SchefterNewsPage
    view={view}
    isAuthenticated={!!authUser}
    userId={authUser?.id}
    schefterArticles={view.featuredArticles}
    articleBasePath="/afl-fantasy/news"
    tipHref="/afl-fantasy/schefter/tip"
  />
</TheLeagueLayout>
