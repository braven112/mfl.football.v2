---
/**
 * AFL Playoffs — route over the shared Playoffs page
 * (src/components/shared/playoffs/PlayoffsPage.astro), which package leagues
 * render too. What stays here is the AFL's own: its seeding (per conference,
 * plus the NIT for everyone else), which bracket each tab shows (by bracket
 * KIND, never id — src/utils/afl-bracket-kind.mjs), the reconstructed
 * pre-2024 brackets, and the Prizes tab (AflPlayoffPrizes). The globs, the
 * year redirects and the `?myteam` cookie write stay in the route for the
 * usual reasons (static import specifiers; `Astro.redirect()` and
 * `Astro.cookies.set()` only work from a page).
 */
import PlayoffsPage from '../../components/shared/playoffs/PlayoffsPage.astro';
import AflPlayoffPrizes from '../../components/afl-fantasy/AflPlayoffPrizes.astro';
import { getConferenceStandings } from '../../utils/standings';
import { formatRecord, type SeededTeam } from '../../utils/playoffs';
import {
  bracketFeedForYear,
  bracketWeeks,
  buildBracketViews,
  loadSeasonBrackets,
  weeklyScoresFor,
  type BracketMode,
  type TeamResolver,
} from '../../utils/playoff-bracket-views';
import { chooseTeamName, resolveConfigForYear, type TeamConfig } from '../../utils/team-names';
import { extractSeasonStructure, applySeasonStructure } from '../../utils/afl-structure';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import {
  getAFLPreference,
  setAFLPreference,
  getAFLTeamData,
  resolveAFLTeamSelection,
} from '../../utils/team-preferences';
import { getCurrentSeasonYear } from '../../utils/league-year';
import { getLeagueBySlug } from '../../config/leagues';
import { getAuthUser, franchiseIdForLeague } from '../../utils/auth';
import reconstructedBracketsFile from '../../../data/afl-fantasy/derived/reconstructed-playoff-brackets.json';
import { buildBracketKindResolver } from '../../utils/afl-bracket-kind.mjs';

export const prerender = false;

// Team Preference Cookie Integration
const myTeamParam = Astro.url.searchParams.get('myteam');
const franchiseParam = Astro.url.searchParams.get('franchise');

// If myteam parameter is provided, update the cookie preference
if (myTeamParam) {
  const teamData = getAFLTeamData(myTeamParam);
  if (teamData) {
    setAFLPreference(Astro.cookies, myTeamParam, teamData.conference, teamData.tier);
  }
}

// Get cookie preference
const cookiePreference = getAFLPreference(Astro.cookies);

// Resolve which team to use for auto-selecting bracket. No `defaultTeam` —
// with no choice and no session there is no team to auto-select one for. The
// `|| undefined` that used to sit here could never fire: the resolver's
// hardcoded '0001' fallback is truthy.
// The session goes in `authUserFranchise`, league-gated with
// `franchiseIdForLeague` — both leagues have a franchise 0001, so a bare
// `user.franchiseId` would show a TheLeague owner Smokane FC as "their" team.
const preferredTeamId = resolveAFLTeamSelection({
  myTeamParam,
  franchiseParam,
  cookiePreference: cookiePreference?.franchiseId,
  authUserFranchise: franchiseIdForLeague(
    getAuthUser(Astro.request),
    getLeagueBySlug('afl-fantasy')!.id
  ),
});

const AFL_LEAGUE = getLeagueBySlug('afl-fantasy')!;

const standingsFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/standings.json', {
  eager: true,
});
const bracketFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/playoff-brackets.json', {
  eager: true,
});
// Per-season division/conference structure — see applySeasonStructure below.
const leagueFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/league.json', {
  eager: true,
});
const weeklyResultsFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/weekly-results.json', {
  eager: true,
});

const availableYears = Object.keys(standingsFeeds)
  .map(path => {
    const match = path.match(/\/(\d{4})\/standings\.json$/);
    return match ? parseInt(match[1], 10) : null;
  })
  .filter((year): year is number => year !== null)
  .sort((a, b) => b - a);

const currentSeasonYear = getCurrentSeasonYear();
const defaultYear = availableYears.includes(currentSeasonYear)
  ? currentSeasonYear
  : availableYears[0] || currentSeasonYear;
const requestedYear = Astro.url.searchParams.get('year');
const selectedYear = requestedYear ? parseInt(requestedYear, 10) : defaultYear;
const requestedView = Astro.url.searchParams.get('view');
const requestedMode = Astro.url.searchParams.get('mode');

type TabView = 'winners' | 'toilet' | 'prizes';

if (!availableYears.includes(selectedYear)) {
  return Astro.redirect(`/afl-fantasy/playoffs?year=${defaultYear}`);
}

const selectedFeed = standingsFeeds[`../../../data/afl-fantasy/mfl-feeds/${selectedYear}/standings.json`] as
  | { version: string; leagueStandings?: { franchise: any[] }; error?: any }
  | undefined;

if (!selectedFeed || !selectedFeed.leagueStandings || selectedFeed.error) {
  return Astro.redirect(`/afl-fantasy/playoffs?year=${defaultYear}`);
}

const franchises = selectedFeed.leagueStandings.franchise;

// Resolve team identities for the selected year (era-correct names/icons for historical seasons)
// Type cast is needed because JSON imports don't preserve strict type info, but the runtime config always has teams[]
const yearResolvedConfig = resolveConfigForYear(
  aflConfig as unknown as typeof aflConfig & { teams: TeamConfig[] },
  selectedYear
);

if (!yearResolvedConfig?.teams || yearResolvedConfig.teams.length === 0) {
  return Astro.redirect(`/afl-fantasy/playoffs?year=${defaultYear}`);
}

// Overlay the SELECTED season's division/conference structure from its league
// feed, exactly as /afl-fantasy/standings does. resolveConfigForYear handles
// identity but NOT division membership, and the AFL re-parented its divisions:
// 2003-2012 ran SIX divisions, three per conference (North/Central/South in the
// American, East/West/Pacific in the National) against today's four. Without
// this, seeding an archived season groups it by today's map — 12 conference
// seasons between 2003 and 2016 seeded differently than the standings page for
// the same year, which is a self-contradiction, not just a cosmetic drift.
const seasonStructure = extractSeasonStructure(
  leagueFeeds[`../../../data/afl-fantasy/mfl-feeds/${selectedYear}/league.json`]
);
const seasonConfig = applySeasonStructure(yearResolvedConfig, seasonStructure);

// Get conference standings for both conferences. MFL's feed order is the
// AFL's official final order — preserve it instead of re-sorting locally.
const conferenceAStandings = getConferenceStandings(franchises, seasonConfig, '00', { preserveFeedOrder: true });
const conferenceBStandings = getConferenceStandings(franchises, seasonConfig, '01', { preserveFeedOrder: true });
const assetMap = new Map(
  (yearResolvedConfig?.teams ?? []).map(team => [
    team.franchiseId,
    {
      icon: team.icon,
      banner: team.banner,
      aliases: team.aliases || [],
      name: team.name,
    },
  ])
);

// Create conference-specific seed maps for AFL structure
// AL Conference (Bracket 2): Seeds 1-4 based on conferenceSeed
const alConferenceTeams = [...conferenceAStandings.divisionWinners, ...conferenceAStandings.wildCards];
const alSeeds = new Map(
  alConferenceTeams.map(team => [
    team.conferenceSeed,
    {
      ...team,
      seed: team.conferenceSeed,
      bracketSeed: team.conferenceSeed,
      originalSeed: team.conferenceSeed,
      record: formatRecord(team.h2hwlt),
      icon: assetMap.get(team.id)?.icon || '',
      banner: assetMap.get(team.id)?.banner || '',
      displayName: chooseTeamName([
        team.teamName,
        assetMap.get(team.id)?.name || '',
        ...(assetMap.get(team.id)?.aliases || []),
      ]),
    }
  ])
);

// NL Conference (Bracket 3): Seeds 1-4 based on conferenceSeed
const nlConferenceTeams = [...conferenceBStandings.divisionWinners, ...conferenceBStandings.wildCards];
const nlSeeds = new Map(
  nlConferenceTeams.map(team => [
    team.conferenceSeed,
    {
      ...team,
      seed: team.conferenceSeed,
      bracketSeed: team.conferenceSeed,
      originalSeed: team.conferenceSeed,
      record: formatRecord(team.h2hwlt),
      icon: assetMap.get(team.id)?.icon || '',
      banner: assetMap.get(team.id)?.banner || '',
      displayName: chooseTeamName([
        team.teamName,
        assetMap.get(team.id)?.name || '',
        ...(assetMap.get(team.id)?.aliases || []),
      ]),
    }
  ])
);

// NIT/Toilet Bowl (Brackets 6-9): Non-playoff teams
const allConferenceTeams = [
  ...conferenceAStandings.allTeams,
  ...conferenceBStandings.allTeams,
];
const playoffTeamIds = new Set([...alConferenceTeams.map(t => t.id), ...nlConferenceTeams.map(t => t.id)]);
const nitTeams = allConferenceTeams
  .filter(team => !playoffTeamIds.has(team.id))
  .sort((a, b) => {
    // Sort by Power Rank (highest to lowest for NIT seeding)
    const aPower = parseFloat(a.pwr);
    const bPower = parseFloat(b.pwr);
    return bPower - aPower; // Descending order (highest power rank = seed 1)
  });

const nitSeeds = new Map(
  nitTeams.map((team, idx) => [
    idx + 1,
    {
      ...team,
      seed: idx + 1,
      bracketSeed: idx + 1,
      originalSeed: idx + 1,
      record: formatRecord(team.h2hwlt),
      icon: assetMap.get(team.id)?.icon || '',
      banner: assetMap.get(team.id)?.banner || '',
      displayName: chooseTeamName([
        team.teamName,
        assetMap.get(team.id)?.name || '',
        ...(assetMap.get(team.id)?.aliases || []),
      ]),
    }
  ])
);

// For overall championship bracket (Bracket 1), use conference winners
const championshipSeeds = new Map([
  ...Array.from(alSeeds.entries()).filter(([seed]) => seed <= 2),
  ...Array.from(nlSeeds.entries()).filter(([seed]) => seed <= 2).map(([seed, team]) => [seed + 2, team] as [number, typeof team]),
]);

// Store all teams for auto-bracket selection
const playoffTeamsWithSeeds = [...alConferenceTeams, ...nlConferenceTeams];
const toiletBowlTeams = nitTeams;

// Determine which bracket contains the preferred team
let defaultView: TabView = 'winners'; // Default to championship bracket
if (preferredTeamId) {
  // Check if team is in championship/playoff brackets (seeds 1-8)
  const isInChampionship = playoffTeamsWithSeeds.some(team => team.id === preferredTeamId);

  // Check if team is in toilet bowl (seeds 10+)
  const isInToilet = toiletBowlTeams.some(team => team.id === preferredTeamId);

  if (isInToilet) {
    defaultView = 'toilet';
  } else if (isInChampionship) {
    defaultView = 'winners';
  }
}

const bracketFeed = bracketFeedForYear(bracketFeeds, selectedYear);
const bracketMetasFromFeed = bracketFeed?.playoffBrackets?.playoffBracket || [];
// Brackets rebuilt from schedule.json for seasons MFL only ever gave seeds for
// (2003-2023). Advisory, never a substitute for real MFL data — see
// scripts/reconstruct-afl-playoff-brackets.mjs.
const {
  bracketIds: bracketIdsToFetch,
  brackets: sortedBrackets,
  usedReconstructed: usedReconstructedBracket,
} = loadSeasonBrackets(bracketFeed, (reconstructedBracketsFile as any)?.seasons?.[String(selectedYear)] ?? {});

const availableViews: TabView[] = ['winners', 'toilet', 'prizes'];
const tabView: TabView = availableViews.includes(requestedView as TabView)
  ? (requestedView as TabView)
  : defaultView;

const availableModes: BracketMode[] = ['projected', 'clean'];
const bracketMode: BracketMode = availableModes.includes(requestedMode as BracketMode)
  ? (requestedMode as BracketMode)
  : 'projected';

// Bracket ids do not mean the same thing across eras — see afl-bracket-kind.mjs.
const bracketNameById = new Map<string, string>(
  (bracketMetasFromFeed as any[])
    .filter((b: any) => b?.id && b?.name)
    .map((b: any) => [String(b.id), String(b.name)])
);
const bracketKind = buildBracketKindResolver(bracketMetasFromFeed as any[], bracketMetasFromFeed as any[]);

const weeksNeeded = bracketWeeks(sortedBrackets);
const weeklyScores = weeklyScoresFor(
  weeklyResultsFeeds[`../../../data/afl-fantasy/mfl-feeds/${selectedYear}/weekly-results.json`],
  weeksNeeded
);

const getSeedMapForBracket = (bracketId: string) => {
  // Keyed off bracketKind rather than the id, because the id↔meaning mapping
  // changed twice (see the bracketKind comment). The AFL Championship and the
  // placement games share the championship seeds.
  const kind = bracketKind(bracketId);
  if (kind === 'al') return alSeeds;
  if (kind === 'nl') return nlSeeds;
  if (kind === 'nit') return nitSeeds;
  return championshipSeeds;
};

const resolveTeam: TeamResolver = (ref, bracketId, resolvedGames): SeededTeam | undefined => {
  // If franchise_id is present, MFL has resolved the team - use it directly
  if (ref?.franchise_id) {
    const franchiseId = String(ref.franchise_id);
    // Use the seed from the MFL bracket API if available
    let apiSeed = ref?.seed ? Number(ref.seed) : undefined;

    // If no seed but we have a reference to another bracket's game, look up the seed from there
    if (!apiSeed && (ref?.winner_of_game || ref?.loser_of_game) && ref?.bracket) {
      const sourceBracket = String(ref.bracket);
      const gameRef = ref.winner_of_game || ref.loser_of_game;
      const key = `${sourceBracket}-${gameRef}`;
      const result = resolvedGames.get(key);

      // Try to get from winner/loser first (for final games)
      let teamFromGame = ref.winner_of_game ? result?.winner : result?.loser;

      // If not found (game not final yet), check home/away teams
      if (!teamFromGame && result) {
        if (result.home?.id === franchiseId) {
          teamFromGame = result.home;
        } else if (result.away?.id === franchiseId) {
          teamFromGame = result.away;
        }
      }

      if (teamFromGame?.id === franchiseId) {
        apiSeed = teamFromGame.originalSeed;
      }
    }

    // Try to find in playoff teams first
    const playoffTeam = playoffTeamsWithSeeds.find(t => t.id === franchiseId);
    if (playoffTeam) {
      const seedToUse = apiSeed ?? playoffTeam.conferenceSeed;
      return {
        ...playoffTeam,
        seed: seedToUse,
        bracketSeed: seedToUse,
        originalSeed: seedToUse,
        record: formatRecord(playoffTeam.h2hwlt),
        icon: assetMap.get(franchiseId)?.icon || '',
        banner: assetMap.get(franchiseId)?.banner || '',
        displayName: chooseTeamName([
          playoffTeam.teamName,
          assetMap.get(franchiseId)?.name || '',
          ...(assetMap.get(franchiseId)?.aliases || []),
        ]),
      };
    }
    // Try NIT teams
    const nitTeam = toiletBowlTeams.find(t => t.id === franchiseId);
    if (nitTeam) {
      // For NIT brackets (6-9):
      // - Bracket 6: Use MFL API seed from bracket data
      // - Brackets 7-9: Use seed from resolvedGames lookup (from bracket 6)
      // - Fallback: Use nitSeeds from standings as backup
      let seedToUse = apiSeed;

      // Fall back to nitSeeds from standings if API/resolvedGames lookup failed
      if (!seedToUse) {
        for (const [seed, team] of nitSeeds.entries()) {
          if (team.id === franchiseId) {
            seedToUse = seed;
            break;
          }
        }
      }

      return {
        ...nitTeam,
        seed: seedToUse || 0,
        bracketSeed: seedToUse || 0,
        originalSeed: seedToUse || 0,
        record: formatRecord(nitTeam.h2hwlt),
        icon: assetMap.get(franchiseId)?.icon || '',
        banner: assetMap.get(franchiseId)?.banner || '',
        displayName: chooseTeamName([
          nitTeam.teamName,
          assetMap.get(franchiseId)?.name || '',
          ...(assetMap.get(franchiseId)?.aliases || []),
        ]),
      };
    }
  }

  const sourceBracket = ref?.bracket ? String(ref.bracket) : bracketId;
  const seedMap = getSeedMapForBracket(sourceBracket);

  // Try to resolve from the bracket-specific seed map
  if (ref?.seed && seedMap.has(ref.seed)) {
    return seedMap.get(ref.seed);
  }

  // Resolve winner/loser references from previous games
  if (ref?.winner_of_game || ref?.loser_of_game) {
    const key = `${sourceBracket}-${ref.winner_of_game || ref.loser_of_game}`;
    const result = resolvedGames.get(key);
    return ref.winner_of_game ? result?.winner : result?.loser;
  }

  return undefined;
};

const bracketViews = buildBracketViews({ brackets: sortedBrackets, mode: bracketMode, resolveTeam, weeklyScores });
const filteredBrackets = bracketViews.filter(bracket => {
  if (tabView === 'prizes') return false;
  const kind = bracketKind(bracket.id);
  if (kind === 'nit') return tabView === 'toilet';
  // The AFL Cup is an in-season competition, and MFL never exported its games.
  // Keep it off the postseason tabs unless a season actually has them.
  if (kind === 'cup') return tabView === 'winners' && bracket.rounds.length > 0;
  return tabView === 'winners';
});

const tabs = [
  { view: 'winners', title: 'Winners', icon: 'icon-trophy' },
  { view: 'toilet', title: 'Toilet Bowl', icon: 'icon-toilet' },
  { view: 'prizes', title: 'Prizes', icon: 'icon-money-bag' },
];
---

<PlayoffsPage
  leagueSlug={AFL_LEAGUE.slug}
  availableYears={availableYears}
  selectedYear={selectedYear}
  brackets={filteredBrackets}
  liveWeeks={weeksNeeded}
  tabs={tabs}
  tabView={tabView}
  customView={tabView === 'prizes'}
  usedReconstructedBracket={usedReconstructedBracket}
>
  {tabView === 'prizes' && (
    <AflPlayoffPrizes
      selectedYear={selectedYear}
      franchises={franchises}
      yearResolvedConfig={yearResolvedConfig}
      bracketViews={bracketViews}
      bracketIdsToFetch={bracketIdsToFetch}
      bracketKind={bracketKind}
      bracketNameById={bracketNameById}
      conferenceAStandings={conferenceAStandings}
      conferenceBStandings={conferenceBStandings}
    />
  )}
</PlayoffsPage>
