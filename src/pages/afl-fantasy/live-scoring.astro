---
/**
 * AFL Fantasy — Live Scoring (/afl/live-scoring)
 *
 * A thin wrapper over the shared `LiveBoardPage`. Two AFL facts shape what it
 * renders, and both are handled below this page rather than here:
 *
 *  - **24 franchises playing doubleheaders.** MFL returns 24 matchup elements
 *    for a week — distinct pairs, not duplicates, because every team plays
 *    twice. The board takes an arbitrary matchup count and leads with every
 *    one the viewer is in, which is what a doubleheader needs.
 *  - **`duplicatePlayers`.** The same NFL player is routinely started by two
 *    AFL franchises at once (85 of 131 starters in a real week), so anything
 *    mapping a player back to "his" franchise handles a LIST — see
 *    `buildLiveMoments`, whose owner map is keyed playerId → franchises.
 *
 * What stays here is what cannot move into a component: the feature gate's
 * `Astro.redirect()`, which from an imported component only stops rendering it
 * and ships a blank 200.
 */
import LiveBoardPage from '../../components/shared/live/LiveBoardPage.astro';
import { getLeagueContext } from '../../utils/league-context';
import { leagueHasFeature } from '../../config/leagues';

// Live-fetch on every request — scores must never be cached.
export const prerender = false;

const league = getLeagueContext(Astro.url);

if (!leagueHasFeature(league.slug, 'liveScoring')) {
  return Astro.redirect('/afl');
}
---

<LiveBoardPage title="Live Scoring | AFL Fantasy" />
