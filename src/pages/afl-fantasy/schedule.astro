---
/**
 * Schedule (AFL) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/schedule/SchedulePage.
 *
 * The feeds and the config are imported HERE because a static import specifier
 * can't be a runtime variable, and globbing both leagues' feeds inside the
 * shared component would ship the other league's season on every render of
 * either route.
 *
 * The viewer's franchise is resolved here too: `franchiseIdForLeague` is the
 * one answer to "is this visitor an owner HERE" — both leagues have a
 * franchise 0001, so a bare franchiseId would show an AFL owner the TheLeague
 * club with the same id. Null covers signed out, signed into the other league,
 * and no franchise, and the page falls back to the league grid for all three.
 */
import SchedulePage from '../../components/shared/schedule/SchedulePage.astro';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import { franchiseIdForLeague, getAuthUser } from '../../utils/auth';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;

const scheduleFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/schedule.json', {
  eager: true,
  import: 'default',
});
const standingsFeeds = import.meta.glob('../../../data/afl-fantasy/mfl-feeds/*/standings.json', {
  eager: true,
  import: 'default',
});

const league = getLeagueBySlug('afl-fantasy')!;
const viewerFranchiseId = franchiseIdForLeague(getAuthUser(Astro.request), league.id);
---

<SchedulePage
  leagueSlug="afl-fantasy"
  config={aflConfig}
  scheduleFeeds={scheduleFeeds}
  standingsFeeds={standingsFeeds}
  viewerFranchiseId={viewerFranchiseId}
/>
