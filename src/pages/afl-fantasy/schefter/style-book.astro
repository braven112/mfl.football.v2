---
/**
 * The Style Book — /afl-fantasy/schefter/style-book
 *
 * Thin wrapper over the shared components/schefter/StyleBookPage.astro.
 */
export const prerender = false;

import { getPersonaLabels } from '../../../utils/persona-server';
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import StyleBookPage from '../../../components/schefter/StyleBookPage.astro';
// Title follows the league's persona (src/utils/persona.mjs).
const labels = await getPersonaLabels('afl-fantasy');
---

<TheLeagueLayout title={`The Style Book — ${labels.reportShort}`}>
  <StyleBookPage navSlug="afl" base="/afl-fantasy" leagueName="AFL" />
</TheLeagueLayout>
