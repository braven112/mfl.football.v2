---
/**
 * Rumor Thread Permalink — /afl-fantasy/schefter/thread/[threadId]
 *
 * Thin wrapper over the shared components/schefter/RumorThread.astro.
 */
export const prerender = false;

import { getPersonaLabels } from '../../../../utils/persona-server';
import TheLeagueLayout from '../../../../layouts/TheLeagueLayout.astro';
import RumorThread from '../../../../components/schefter/RumorThread.astro';
import { getLeagueBySlug } from '../../../../config/leagues';
import { getSchefterFeed } from '../../../../utils/schefter-league-data';

const { id } = Astro.params;
if (!id) return Astro.redirect('/afl-fantasy/news');

const feed = getSchefterFeed(getLeagueBySlug('afl-fantasy')!);
// Title follows the league's persona (src/utils/persona.mjs).
const labels = await getPersonaLabels('afl-fantasy');
---

<TheLeagueLayout title={`Rumor thread — ${labels.report}`}>
  <RumorThread
    navSlug="afl"
    base="/afl-fantasy"
    leagueName="AFL"
    feed={feed}
    threadId={id}
  />
</TheLeagueLayout>
