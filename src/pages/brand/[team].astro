---
/**
 * One NFL club's brand page on the shared host — see ../brand.astro for why
 * this lives at the root rather than linking into a league's copy.
 *
 * The redirect lives HERE, and must: `Astro.redirect()` only redirects from a
 * PAGE. Returned from a component's frontmatter it merely stops rendering that
 * component and the response is still a 200 with a blank body.
 */
import ClubBrandPage from '../../components/shared/brand/ClubBrandPage.astro';
import { codeFromSlug } from '../../utils/nfl-marks';

// SSR, not prerender: every one of these reads `Astro.locals.hideLeaguePrefix`,
// which middleware derives from the HOSTNAME. The same compiled page answers
// both the league apex (prefix hidden) and the shared host (prefix kept) and
// must emit different hrefs for each, so a baked file would ship wrong-host
// links to whichever host it was not baked for. The mark data itself is static.
export const prerender = false;

const code = codeFromSlug(Astro.params.team ?? '');
if (!code) return Astro.redirect('/brand', 302);
---

<ClubBrandPage code={code} />
