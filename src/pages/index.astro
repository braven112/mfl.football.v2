---
import SplashLayout from '../layouts/SplashLayout.astro';
import { crossHostLeagueHref } from '../config/leagues';
import type { CanonicalLeagueSlug } from '../config/leagues';
import ProductInterest from '../components/shared/ProductInterest.astro';
import { LEAGUE_PACKAGE_PRICING, leaguePackageSeasonOffer } from '../data/products';
import { CUSTOM_FEATURES, CUSTOM_SITE_ROWS, SETUP_DISCOUNTS, dollars, perMonth } from '../data/pricing';
import { siteExampleLeagues } from '../data/league-showcase';
import { getTestDateFromSearchParams } from '../utils/league-year';
import { FORMER_BRAND, SITE_FOOTER_LINKS } from '../data/mfl-services';
import { organizationJsonLd, websiteJsonLd } from '../utils/structured-data';

// ── What this page is for ─────────────────────────────────────────────────
// MFL.football SELLS LEAGUE WEBSITES (Brandon, Nov 2026), and since
// 2026-11-14 this page sells only that: a hero, the three packages, one band
// pointing at /features, and a live example. Live scores and the free tools
// are footer links, not sections.

// The example section. Hand-picked through `siteExample` in league-showcase.ts
// (Brandon chooses which leagues a buyer is sent to: The League only, for
// now), and still under showcaseLeagues' rules, so a best-ball league or an
// unlisted package league can never be one.
const examples = siteExampleLeagues();

// The logo cuts each example panel draws. The panel follows the theme, so it
// wants both; a league with no entry falls back to its registry logo.
const EXAMPLE_LOGOS: Partial<Record<CanonicalLeagueSlug, { light: string; dark: string }>> = {
  theleague: { light: '/assets/logos/theleague-logo.svg', dark: '/assets/logos/theleague-logo-dark.svg' },
};

// This splash renders on every NON-league host: the shared app host, and also
// localhost and Vercel previews. On the shared host TheLeague is not served —
// `/theleague` 404s there — so an example panel must leave for the league's
// own domain rather than link to something this host refuses.
//
// `crossHostLeagueHref` decides that per host rather than unconditionally,
// which is the load-bearing part: absolute links everywhere would send a
// preview build's visitor to PRODUCTION theleague.us on the first click, so
// the branch under test becomes undrivable past its front page.
const hrefFromHere = (path: string) => crossHostLeagueHref(Astro.url.hostname, path);

// Nothing paid is on sale yet (`PRODUCT_PAGES_PUBLIC` is false and /products
// 404s for the public), so every "I'm interested" button is a coming-soon door
// (ProductInterest): it counts the click and offers to email the visitor at
// launch.
const packageOffer = leaguePackageSeasonOffer(getTestDateFromSearchParams(Astro.url.searchParams) ?? new Date());

// The homepage sells exactly THREE packages, one per league size (Brandon,
// 2026-11-14: "the homepage should only offer the 3 packages"). Every number
// comes from LEAGUE_PACKAGE_PRICING through src/data/pricing.ts, so this page,
// /pricing and the product page can never disagree. Everything else that used
// to live here (the daily homepage, the AI reporter, live scores, history) is
// shown on /features instead.
const PACKAGES = [
  {
    teams: CUSTOM_SITE_ROWS[0].teams,
    setup: CUSTOM_SITE_ROWS[0].setup,
    renewal: CUSTOM_SITE_ROWS[0].renewal,
    who: 'Most home leagues',
  },
  {
    teams: CUSTOM_SITE_ROWS[1].teams,
    setup: CUSTOM_SITE_ROWS[1].setup,
    renewal: CUSTOM_SITE_ROWS[1].renewal,
    who: 'Big leagues and conferences',
  },
  {
    teams: 'Over 32 teams',
    setup: null,
    renewal: null,
    who: 'Contests and leagues of leagues',
  },
];

const discountLine = SETUP_DISCOUNTS.map((d) => `${Math.round(d.off * 100)}% off setup signed ${d.months}`).join(', ');
---
<SplashLayout
  title="MFL.football: custom league websites for MyFantasyLeague"
  description={`MFL.football (formerly ${FORMER_BRAND}) builds and runs custom websites for MyFantasyLeague leagues. Three packages: ${PACKAGES.map((p) => `${p.setup ? dollars(p.setup) : 'a custom quote'} for ${p.teams.toLowerCase()}`).join(', ')}.`}
  canonicalPath="/"
  ogImage="/assets/home/league-site.webp"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  {/* Soft Premium (src/styles/soft-premium.css): the hero, card and dark band
      here are the same ones every service page wears. */}
  <div class="home sp">
  <header class="sp-top">
    <a class="sp-brand" href="/" aria-label="MFL.football home">
      <img class="sp-brand__light" src="/assets/logos/mfl-football-wordmark.svg" width="5404" height="680" alt="" />
      <img class="sp-brand__dark" src="/assets/logos/mfl-football-wordmark-dark.svg" width="5404" height="680" alt="" />
    </a>
    <nav class="sp-top__links" aria-label="Sections">
      <a href="#packages">Packages</a>
      <a href="/features">Features</a>
      <a class="sp-top__live" href="/live">Live scores</a>
    </nav>
    <div class="sp-top__end">
      <a class="cta cta--ghost" href="/login">Sign in</a>
    </div>
  </header>

  <section class="sp-hero">
    <div class="sp-hero__copy">
      <p class="sp-eyebrow">Formerly {FORMER_BRAND} · For MyFantasyLeague</p>
      <h1>Custom websites for your MFL league.</h1>
      <p class="sp-lede">
        We build your league a branded site on its own domain, then run it for you: its own AI beat reporter, your house rules
        automated, reminders, dues and league history, handled so the commissioner does not have to.
      </p>
      <div class="sp-ctas">
        <a class="cta cta--primary" href="#packages">See the packages</a>
        <a class="cta cta--ghost" href="/features">See the features</a>
      </div>
      <ul class="sp-hero__facts">
        <li>Your league stays on MFL</li>
        <li>Built for phones</li>
        <li>Light and dark</li>
      </ul>
    </div>
    <div class="sp-hero__visual">
      <figure class="shot">
        <img src="/assets/home/league-site.webp" width="1230" height="748" alt="TheLeague's league site, built on MFL.football, with its weekly recap hero in the winning team's colors" />
      </figure>
      {examples[0] && (
        <div class="sp-lcard hero-lcard" aria-hidden="true">
          <span class="sp-lcard__top">
            <span>
              <span class="sp-lcard__name">{examples[0].name}</span><br />
              <span class="sp-lcard__meta">{examples[0].showcase.teams} teams · since {examples[0].showcase.estYear}</span>
            </span>
            <svg class="sp-lcard__ball" viewBox="-10 -8 20 16"><path d="M-6.5 0Q0-5.4 6.5 0Q0 5.4-6.5 0Z" stroke-width="3" stroke-linejoin="round" transform="rotate(-15)" /></svg>
          </span>
          {examples[0].domains?.[0] && <span class="sp-lcard__host">{examples[0].domains[0]}</span>}
          <span class="sp-lcard__label">Run by MFL.football</span>
        </div>
      )}
    </div>
  </section>

  <section class="sp-section" id="packages" aria-labelledby="packages-h">
    <div class="sp-head">
      <div class="sp-head__title">
        <p class="sp-eyebrow">Packages</p>
        <h2 id="packages-h">One full site. Priced by league size.</h2>
      </div>
      <p class="sp-head__note">Every package is the whole platform, built and run for your league. Launching soon: tap “I’m interested” and we’ll email you when it opens.</p>
    </div>
    <ul class="pkgs">
      {PACKAGES.map((p, i) => (
        <li class={`ui-card sp-card pkg${i === 0 ? ' pkg--top' : ''}`}>
          <span class="sp-card__who">{p.who}</span>
          <h3 class="pkg__teams">{p.teams}</h3>
          {p.setup ? (
            <p class="pkg__price"><b>{dollars(p.setup)}</b><span>setup and your first year</span></p>
          ) : (
            <p class="pkg__price"><b>Custom quote</b><span>priced to your league</span></p>
          )}
          {p.renewal ? (
            <p class="pkg__renew">Then {dollars(perMonth(p.renewal))}/mo, billed annually ({dollars(p.renewal)}/year)</p>
          ) : (
            <p class="pkg__renew">Setup and renewal quoted to order, for a league or a contest of many leagues</p>
          )}
          <span class="sp-ctas pkg__acts">
            <button
              type="button"
              class={`cta ${i === 0 ? 'cta--primary' : 'cta--ghost'}`}
              data-interest="league-package"
              data-interest-name={`League Package, ${p.teams.toLowerCase()}`}
              data-interest-note={p.setup ? `${dollars(p.setup)} for setup and your first year, then ${dollars(p.renewal ?? 0)} a year.` : 'Over 32 teams, we quote it.'}
            >{p.setup ? 'I’m interested' : 'Get a quote'}</button>
          </span>
        </li>
      ))}
    </ul>
    <div class="ui-card sp-card incl">
      <h3>Every package includes</h3>
      <ul class="sp-list incl__list">
        {CUSTOM_FEATURES.map((f) => <li>{f.text}</li>)}
      </ul>
    </div>
    <p class="terms">
      Set up in the off-season and save: {discountLine}. Leagues of 16 or fewer that make their own logos save {LEAGUE_PACKAGE_PRICING.logoDiscount}.
      {packageOffer && <> {packageOffer}</>}
      {' '}<a class="cta-link" href="/pricing">Full pricing details</a>
    </p>
  </section>

  <section class="sp-band sp-band--cta feat" aria-labelledby="feat-h">
    <div class="sp-band__copy">
      <p class="sp-eyebrow">What you get</p>
      <h2 id="feat-h">Your league gets its own AI beat reporter.</h2>
      <p>It breaks every trade and signing, writes the weekly columns, and brings in Vegas Vic on the lines and Doc Rivers on injuries. See it, and the rest of the platform, on the features page.</p>
    </div>
    <a class="cta cta--primary" href="/features">See the features</a>
  </section>

  {examples.length > 0 && (
    <section class="sp-section" id="examples" aria-labelledby="examples-h">
      <div class="sp-head">
        <div class="sp-head__title">
          <p class="sp-eyebrow">See one running</p>
          <h2 id="examples-h">Every feature runs on {examples.length === 1 ? 'this league' : 'these leagues'} today.</h2>
        </div>
      </div>
      <div class="examples" style={`--panel-count: ${examples.length}`}>
        {examples.map((league) => {
          const logo = EXAMPLE_LOGOS[league.slug] ?? league.logo;
          const host = league.domains?.[0];
          return (
            <a class="ui-card sp-card panel" data-league={league.navSlug} href={hrefFromHere(`/${league.slug}`)}>
              <span class="panel__logo">
                <img class="panel__logo-img panel__logo-img--light" src={logo.light} alt="" />
                <img class="panel__logo-img panel__logo-img--dark" src={logo.dark} alt="" />
              </span>
              <span class="panel__text">
                <h3>{league.name}</h3>
                <span class="sp-muted panel__meta">{league.showcase.teams} teams · {league.showcase.format} · since {league.showcase.estYear}</span>
              </span>
              <span class="sp-card__more">{host ? `Visit ${host}` : 'Visit the site'}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="sp-section" id="free" aria-labelledby="free-h">
    <div class="sp-head">
      <div class="sp-head__title">
        <p class="sp-eyebrow">Free</p>
        <h2 id="free-h">Free for any team</h2>
      </div>
      <p class="sp-head__note">No account, no cost.</p>
    </div>
    <div class="free">
      <a class="ui-card sp-card" href="/team-logo">
        <h3>Team logo maker</h3>
        <p>Pick a style, a mascot and your colors, and get a prompt for ChatGPT or Gemini. A free tracer turns the result into an SVG.</p>
        <span class="sp-card__more">Make a logo</span>
      </a>
      <a class="ui-card sp-card" href="/video">
        <h3>Season video</h3>
        <p>Turn any team’s season into a vertical video for TikTok, Reels, Shorts and X.</p>
        <span class="sp-card__more">Make a video</span>
      </a>
    </div>
  </section>

  <footer class="sp-foot">
    <span>MFL.football · formerly {FORMER_BRAND}</span>
    <nav class="sp-foot__links" aria-label="Site">
      {SITE_FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </footer>

  <ProductInterest />
  </div>
</SplashLayout>
<style>
  /* Page layout only. Every surface, type style and color comes from
     src/styles/soft-premium.css, shared with the service pages. */

  /* Hero visual: TheLeague's real site in a soft frame, with the graphite
     league card overlapping its lower-left corner on wide screens. */
  .shot {
    margin: 0;
    overflow: hidden;
    border-radius: var(--sp-radius);
    background: var(--sp-surface);
    box-shadow: var(--sp-shadow);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-lcard {
    position: absolute;
    left: -2.5rem;
    bottom: -2.5rem;
    max-width: 17rem;
    padding: 1.1rem 1.2rem;
    aspect-ratio: 1.62;
  }

  .hero-lcard .sp-lcard__name {
    font-size: var(--sp-text-lg);
  }

  @media (max-width: 1100px) {
    .hero-lcard {
      left: 1rem;
      bottom: -2rem;
      max-width: 15rem;
    }
  }

  @media (max-width: 860px) {
    .sp-hero__visual {
      padding-bottom: 2.5rem;
    }

    .hero-lcard {
      left: 0.75rem;
      max-width: 12.5rem;
      padding: 0.85rem 1rem;
      gap: 0.5rem;
    }

    .hero-lcard .sp-lcard__name {
      font-size: var(--sp-text-md);
    }

    .hero-lcard .sp-lcard__host {
      font-size: var(--sp-text-xs);
    }
  }

  /* The three packages, side by side; stacked on phones. */
  .pkgs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .pkg {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* The featured size: a faint red tint ring, never a dark stripe. */
  .pkg--top {
    box-shadow: var(--sp-shadow), 0 0 0 2px var(--sp-red-soft);
  }

  .pkg__teams {
    font-size: var(--sp-text-xl);
  }

  .pkg__price {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }

  .pkg__price b {
    font-size: var(--sp-text-2xl);
    font-weight: 750;
    color: var(--sp-ink);
    line-height: 1.1;
  }

  .pkg__price span,
  .pkg .pkg__renew {
    font-size: var(--sp-text-sm);
    color: var(--sp-muted);
  }

  .pkg__acts {
    margin-top: auto;
    padding-top: 0.35rem;
  }

  .incl {
    margin-bottom: 1rem;
  }

  .incl__list {
    columns: 2;
    column-gap: 2rem;
  }

  .incl__list :global(li) {
    break-inside: avoid;
  }

  .terms {
    margin: 0;
    font-size: var(--sp-text-sm);
    color: var(--sp-muted);
  }

  @media (max-width: 860px) {
    .pkgs {
      grid-template-columns: minmax(0, 1fr);
    }

    .incl__list {
      columns: 1;
    }
  }

  /* The two free tools, side by side at every width (Brandon, 2026-11-14). */
  .free {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .free .sp-card__more {
    margin-top: auto;
  }

  @media (max-width: 420px) {
    .free {
      gap: 0.6rem;
    }

    .free .sp-card {
      padding: 1rem;
    }
  }

  .examples {
    display: grid;
    grid-template-columns: repeat(min(var(--panel-count, 1), 2), minmax(0, 1fr));
    gap: 1rem;
  }

  .panel {
    flex-direction: row;
    align-items: center;
    gap: 1.25rem;
  }

  .panel__logo {
    display: grid;
    place-items: center;
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background: var(--sp-surface-2);
  }

  .panel__logo-img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .panel__logo-img--dark,
  :global(html.dark) .panel__logo-img--light {
    display: none;
  }

  :global(html.dark) .panel__logo-img--dark {
    display: block;
  }

  .panel__text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .panel__meta {
    font-size: var(--sp-text-sm);
  }

  .panel .sp-card__more {
    margin: 0 0 0 auto;
    padding: 0;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .examples {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel {
      flex-wrap: wrap;
    }

    .panel .sp-card__more {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
