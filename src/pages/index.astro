---
import SplashLayout from '../layouts/SplashLayout.astro';
import { crossHostLeagueHref } from '../config/leagues';
import type { CanonicalLeagueSlug } from '../config/leagues';
import ProductInterest from '../components/shared/ProductInterest.astro';
import { MFL_LIVE_PRO_PRICE, type ProductSlug } from '../data/products';
import { mflLiveIncludedNames, siteExampleLeagues } from '../data/league-showcase';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../utils/league-year';
import { FORMER_BRAND, SERVICES } from '../data/mfl-services';
import { organizationJsonLd, websiteJsonLd } from '../utils/structured-data';

// ── What this page is for ─────────────────────────────────────────────────
// MFL.football SELLS LEAGUE WEBSITES first (Brandon, Nov 2026): the hero, the
// services and a live example come before anything free. The free tools are a
// short row near the bottom, and live scores has ONE band rather than a nav
// link, a free card, a band and a product card.

// The example section. Hand-picked through `siteExample` in league-showcase.ts
// (Brandon chooses which leagues a buyer is sent to: The League only, for
// now), and still under showcaseLeagues' rules, so a best-ball league or an
// unlisted package league can never be one.
const examples = siteExampleLeagues();

// The logo cuts each example panel draws. The panel follows the theme, so it
// wants both; a league with no entry falls back to its registry logo.
const EXAMPLE_LOGOS: Partial<Record<CanonicalLeagueSlug, { light: string; dark: string }>> = {
  theleague: { light: '/assets/logos/theleague-logo.svg', dark: '/assets/logos/theleague-logo-dark.svg' },
};

// This splash renders on every NON-league host: the shared app host, and also
// localhost and Vercel previews. On the shared host TheLeague is not served —
// `/theleague` 404s there — so an example panel must leave for the league's
// own domain rather than link to something this host refuses.
//
// `crossHostLeagueHref` decides that per host rather than unconditionally,
// which is the load-bearing part: absolute links everywhere would send a
// preview build's visitor to PRODUCTION theleague.us on the first click, so
// the branch under test becomes undrivable past its front page.
const hrefFromHere = (path: string) => crossHostLeagueHref(Astro.url.hostname, path);

// Nothing paid is on sale yet (`PRODUCT_PAGES_PUBLIC` is false and /products
// 404s for the public), so every "I'm interested" button is a coming-soon door
// (ProductInterest): it counts the click and offers to email the visitor at
// launch. Each service also links its public service page, which is real.
const seasonYear = getCurrentSeasonYear(getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined);
const proPrice = `$${MFL_LIVE_PRO_PRICE.season}`;
const includedNames = mflLiveIncludedNames();
const includedList =
  includedNames.length > 1
    ? `${includedNames.slice(0, -1).join(', ')} and ${includedNames[includedNames.length - 1]}`
    : (includedNames[0] ?? '');

// Only MFL Live Pro's price is public (Brandon, Oct 2026); every service here
// shows what it does, not what it costs.
interface ServiceCard {
  slug: ProductSlug;
  name: string;
  who: string;
  body: string;
  /** Its public service page (src/data/mfl-services.ts), when it has one. */
  learnMore?: string;
}

const servicePath = (slug: (typeof SERVICES)[number]['slug']) =>
  SERVICES.find((s) => s.slug === slug)?.path;

const MORE_SERVICES: ServiceCard[] = [
  {
    slug: 'league-hub',
    name: 'League Hub',
    who: 'For a commissioner who wants a real site',
    body: 'A branded site on your own domain with the draft hub, an AI league reporter, push alerts and more.',
    learnMore: servicePath('league-website'),
  },
  {
    slug: 'league-history',
    name: 'Full History',
    who: 'For any MFL, Sleeper or Yahoo league',
    body: 'Every season back to your first: standings, playoffs, owner pages, rivalries and records.',
    learnMore: servicePath('league-history'),
  },
  {
    slug: 'contest-package',
    name: 'Contest Package',
    who: 'For organizers running many leagues',
    body: 'One competition across dozens or hundreds of MFL leagues.',
  },
];

// The top package is sold on automation, not features: everything a
// commissioner does by hand, the system does. Each line is a feature the
// platform already runs for The League and the AFL (src/data/products.ts).
const AUTOMATED = [
  'Deadline and lineup reminders to every owner',
  'Draft order, the draft room and results',
  'Dues and prize payouts written into MFL’s books',
  'Contracts, the salary cap and extensions tracked',
  'Rules questions answered from your constitution',
  'League news, trades and recaps written for you',
  'Weekly power rankings',
  'News and reminders posted to your group chat',
];

const commissionerToolsPath = servicePath('commissioner-tools');
const skinsPath = servicePath('skins') ?? '/instructions#skin';
---
<SplashLayout
  title="MFL.football: custom league websites for MyFantasyLeague"
  description={`MFL.football (formerly ${FORMER_BRAND}) builds and runs custom websites for MyFantasyLeague leagues: commissioner automation, league history, live scores and free MFL skins.`}
  canonicalPath="/"
  ogImage="/assets/home/league-site.webp"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  <div class="home">
  <header class="top">
    <a class="brand" href="/" aria-label="MFL.football home">
      <img class="brand__mark brand__mark--light" src="/assets/logos/mfl-football-wordmark.svg" width="5404" height="680" alt="" />
      <img class="brand__mark brand__mark--dark" src="/assets/logos/mfl-football-wordmark-dark.svg" width="5404" height="680" alt="" />
    </a>
    <nav class="top__links" aria-label="Sections">
      <a href="#services">Services</a>
      <a href="#examples">Example</a>
      <a class="top__live" href="/live">Live scores</a>
      <a href="#free">Free tools</a>
    </nav>
    <a class="cta cta--ghost top__signin" href="/login">Sign in</a>
  </header>

  <section class="hero">
    <div>
      <p class="eyebrow">Formerly {FORMER_BRAND} · For MyFantasyLeague leagues</p>
      <h1>Custom websites for your MFL league.</h1>
      <p class="lede">
        We build your league a branded site on its own domain, then run it for you: reminders, the draft,
        dues, league history and news, handled so the commissioner does not have to.
      </p>
      <div class="hero__ctas">
        <a class="cta cta--primary" href="#services">See our services</a>
        {examples[0] && (
          <a class="cta cta--ghost" href={hrefFromHere(`/${examples[0].slug}`)}>See a live league site</a>
        )}
      </div>
    </div>
    <figure class="shot">
      <div class="shot__chrome" aria-hidden="true"><i></i><i></i><i></i><span>theleague.us</span></div>
      <img src="/assets/home/league-site.webp" width="1230" height="748" alt="TheLeague's league site, built on MFL.football, with its weekly recap hero in the winning team's colors" />
    </figure>
  </section>

  <section class="block" id="services" aria-labelledby="services-h">
    <div class="block__head">
      <div><h2 id="services-h">League websites</h2></div>
      <p>Launching soon. Tap “I'm interested” on any service and we'll email you when it opens.</p>
    </div>
    <div class="auto">
      <div class="auto__copy">
        <span class="plan__who">Our biggest package · for a league that wants it all handled</span>
        <h3>League Package</h3>
        <span class="auto__lede">Anything the commissioner does manually, our system handles.</span>
        <span class="auto__body">Your own site with every feature on the platform, custom features built for how your league plays, and priority support.</span>
        {/* The pricing SHAPE, without amounts (Brandon, Oct 2026). */}
        <span class="auto__fees">
          <span><b>Setup fee</b> We build your league's site and features once.</span>
          <span><b>Automation fee</b> We run your league from then on.</span>
        </span>
        <span class="acts">
          <button
            type="button"
            class="cta cta--primary"
            data-interest="league-package"
            data-interest-name="League Package"
            data-interest-note="Anything a commissioner does by hand, our system handles: a one-time setup fee, then an automation fee to run your league."
          >I'm interested</button>
          {commissionerToolsPath && <a class="cta-link" href={commissionerToolsPath}>What it automates</a>}
        </span>
      </div>
      <ul class="auto__list">
        {AUTOMATED.map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <div class="paid">
      {MORE_SERVICES.map((p) => (
        <div class="plan">
          <span class="plan__who">{p.who}</span>
          <h3>{p.name}</h3>
          <p>{p.body}</p>
          <span class="acts">
            <button type="button" class="cta cta--ghost" data-interest={p.slug} data-interest-name={p.name}>I'm interested</button>
            {p.learnMore && <a class="cta-link" href={p.learnMore}>Learn more</a>}
          </span>
        </div>
      ))}
    </div>
    <p class="addons">
      <b>Add-ons</b> for League Hub and League Package leagues: side games, custom standings, prizes, contracts and large-league support.
      <button type="button" class="cta-link" data-interest="add-ons" data-interest-name="Add-ons">I'm interested</button>
    </p>
  </section>

  {examples.length > 0 && (
    <section class="block" id="examples" aria-labelledby="examples-h">
      <div class="block__head">
        <div><h2 id="examples-h">See one running</h2></div>
        <p>Every feature above runs on {examples.length === 1 ? 'this league' : 'these leagues'} today.</p>
      </div>
      <div class="examples" style={`--panel-count: ${examples.length}`}>
        {examples.map((league) => {
          const logo = EXAMPLE_LOGOS[league.slug] ?? league.logo;
          const host = league.domains?.[0];
          return (
            <a class="panel" data-league={league.navSlug} href={hrefFromHere(`/${league.slug}`)}>
              <img class="panel__logo panel__logo--light" src={logo.light} alt="" />
              <img class="panel__logo panel__logo--dark" src={logo.dark} alt="" />
              <span>
                <span class="panel__name">{league.name}</span>
                <span class="panel__meta">{league.showcase.teams} teams · {league.showcase.format} · since {league.showcase.estYear}</span>
              </span>
              <span class="panel__go">{host ? `Visit ${host}` : 'Visit the site'} →</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="live" aria-labelledby="live-h">
    <div class="live__copy">
      <span class="live__kicker">For any MFL owner</span>
      <h2 id="live-h">Live scores</h2>
      <p>
        Every MFL league you own, scored live on one board, free. Pro adds the Broadcast for your TV,
        projected standings and game-day alerts for {proPrice} a season.
      </p>
      <p class="live__price">
        <s>{proPrice}</s><strong>Free</strong>
        <span>Pro for {includedList} owners through the {seasonYear} season</span>
      </p>
      <a class="cta cta--primary live__cta" href="/live">Open live scores →</a>
    </div>
    <img class="live__img" src="/assets/mfl-live/landing-takeover.webp" width="1440" height="810" loading="lazy" alt="A field goal takes over the TV on the live scores Broadcast" />
  </section>

  <section class="block" id="free" aria-labelledby="free-h">
    <div class="block__head">
      <div><span class="tag tag--free">Free</span><h2 id="free-h">Free tools</h2></div>
      <p>No account, no cost.</p>
    </div>
    <div class="free-grid">
      <a class="card" href={skinsPath}>
        <h3>MFL skin</h3>
        <p>Light and dark themes for your league's MyFantasyLeague pages.</p>
        <span class="card__more">Get the skin →</span>
      </a>
      <a class="card" href="/instructions#homepage">
        <h3>Template builder</h3>
        <p>A homepage, header and footer for MFL, with step-by-step install.</p>
        <span class="card__more">Build a template →</span>
      </a>
      <a class="card" href="/mfl-all-play-standings">
        <h3>All-play standings</h3>
        <p>Paste any MFL league ID: all-play standings and who the schedule helped or robbed.</p>
        <span class="card__more">Run the report →</span>
      </a>
    </div>
  </section>

  <footer class="foot">
    <span>MFL.football · formerly {FORMER_BRAND}</span>
    {SERVICES.map((s) => <a href={s.path}>{s.eyebrow}</a>)}
    <a href="/mfl-all-play-standings">Free all-play standings</a>
    <a href="/compare">Compare</a>
    <a href="/about">About</a>
    <a href="/live">Live scores</a>
    <a href="/instructions">Template instructions</a>
    <a href="/brand">Brand Book</a>
  </footer>

  <ProductInterest />
  </div>
</SplashLayout>
<style>
  /* MFL.football's brand is red and black, in BOTH themes. The splash layout's
     default theme would paint this page navy (CTAs, headings) in light and
     blue/green in dark, so the page sets its own values for the tokens it and
     the shared CTA (src/styles/cta.css) read. Dark keeps the brand: near-white
     ink on the dark ground, with a lighter red that holds contrast there. */
  .home {
    --brand-ink: #111111;
    --brand-red: #c8102e;
    --brand-red-hover: #a10d25;
    --primary-link-default-text-color: var(--brand-ink);
    --primary-link-hover-text-color: var(--brand-red);
    --secondary-color: var(--brand-red);
    --cta-fill: var(--brand-red);
    --cta-fill-hover: var(--brand-red-hover);
    --on-cta-fill: #ffffff;
    --btn-primary-border-hover: var(--brand-red);
  }

  :global(html.dark) .home {
    --brand-ink: #f2f3f5;
    --brand-red: #ff4d5e;
    --brand-red-hover: #ff7380;
    --on-cta-fill: #111111;
  }

  /* Quieter than MFL Live's landing: the page follows the theme, and the one
     loud surface is the MFL Live band, which is dark in BOTH themes (MFL
     Live's own ground, #14161a family) so its literals do not flip. */
  .top {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--primary-content-border-color);
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  /* The wordmark's letters are outlined paths (public/assets/logos/), so it
     needs no font. One cut per theme, like the league panels' logos. */
  .brand__mark {
    display: block;
    width: auto;
    height: 1.6rem;
  }

  .brand__mark--dark,
  :global(html.dark) .brand__mark--light {
    display: none;
  }

  :global(html.dark) .brand__mark--dark {
    display: block;
  }

  .top__links {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
    font-size: var(--font-size-sm);
  }

  .top__live {
    font-weight: 700;
  }

  .top__live::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #e0263c;
    vertical-align: 0.1em;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 4.5rem 0 3.5rem;
  }

  .eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  .hero h1 {
    margin: 0.75rem 0 1rem;
    font-size: var(--font-size-3xl);
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .lede {
    margin: 0 0 1.75rem;
    max-width: 30em;
    font-size: var(--font-size-base);
    color: var(--color-gray-600);
  }

  .hero__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--primary-content-border-color);
    border-radius: 16px;
    background: var(--primary-content-bg-color);
    box-shadow: var(--shadow-xl);
  }

  .shot__chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--primary-content-border-color);
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  .shot__chrome i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--primary-content-border-color);
  }

  .shot__chrome span {
    margin-left: 0.75rem;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .block {
    padding: 3.5rem 0 0;
  }

  .block__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .block__head h2 {
    margin: 0.5rem 0 0;
    font-size: var(--font-size-2xl);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .block__head p {
    margin: 0;
    max-width: 26em;
    color: var(--color-gray-600);
  }

  .tag {
    display: inline-block;
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: var(--font-size-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tag--free {
    background: color-mix(in srgb, var(--color-success) 14%, transparent);
    color: var(--color-success-dark);
  }

  .tag--soon,
  .tag--paid {
    border: 1px solid var(--primary-content-border-color);
    color: var(--color-gray-600);
  }

  /* Free-tool cards are links; service cards (.plan) are boxes holding two
     actions, so only .card gets the pointer and the lift. */
  .card,
  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border: var(--style-card-border, 1px solid var(--primary-content-border-color));
    box-shadow: var(--style-card-shadow, none);
    border-radius: 16px;
    background: var(--primary-content-bg-color);
    color: inherit;
    font: inherit;
    text-align: left;
  }

  .card {
    cursor: pointer;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--color-gray-500);
    text-decoration: none;
    color: inherit;
  }

  .card:focus-visible {
    outline: 2px solid var(--secondary-color);
    outline-offset: 3px;
  }

  .card h3,
  .plan h3 {
    margin: 0.2rem 0 0;
    font-size: var(--font-size-lg);
  }

  .card p,
  .plan p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
  }

  .card__up {
    padding-top: 0.6rem;
    border-top: 1px dashed var(--primary-content-border-color);
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  .card__up b {
    color: var(--primary-link-default-text-color);
  }

  .card__more {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--secondary-color);
  }

  .free-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  /* ---------- MFL Live band ---------- */

  .live {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    margin-top: 3.5rem;
    overflow: hidden;
    border: 1px solid #2a2f37;
    border-radius: 22px;
    background: radial-gradient(700px 300px at 0% 0%, #3a0a12, #14161a);
    color: #ffffff;
  }

  .live__copy {
    padding: 2.75rem;
  }

  .live__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff6b7c;
  }

  .live__kicker::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #e0263c;
  }

  .live h2 {
    margin: 0.75rem 0 0.9rem;
    font-size: var(--font-size-3xl);
    line-height: 0.95;
    text-transform: uppercase;
    color: #ffffff;
  }

  .live p {
    margin: 0 0 1.1rem;
    color: #b4bac6;
  }

  .live__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
  }

  .live__price s {
    font-family: var(--font-display);
    font-size: calc(var(--font-size-lg) * 1.3);
    color: #6b7385;
  }

  .live__price strong {
    font-family: var(--font-display);
    font-size: calc(var(--font-size-lg) * 1.7);
    color: #ffffff;
  }

  .live__price span {
    font-size: var(--font-size-sm);
  }

  .live__img {
    display: block;
    width: calc(100% - 1.5rem);
    height: auto;
    margin: 1.5rem 1.5rem 1.5rem 0;
    border-radius: 12px;
  }

  /* ---------- Products ---------- */

  .paid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  /* The automation band: the top package, wider and quieter-loud than a card.
     Same box as .plan (border, ground) so it reads as one of the products. */
  .auto {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2.5rem;
    margin-bottom: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--primary-link-default-text-color);
    border-radius: 16px;
    background: var(--primary-content-bg-color);
    color: inherit;
  }

  .auto__copy {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .auto h3 {
    margin: 0.2rem 0 0;
    font-size: var(--font-size-2xl);
    line-height: 1;
    text-transform: uppercase;
  }

  .auto__lede {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--primary-link-default-text-color);
  }

  .auto__body {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
  }

  .auto__fees {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    font-size: var(--font-size-xs);
    color: var(--color-gray-600);
  }

  .auto__fees > span {
    padding: 0.6rem 0.75rem;
    border: 1px dashed var(--primary-content-border-color);
    border-radius: 10px;
  }

  .auto__fees b {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--primary-link-default-text-color);
  }

  .auto__list {
    display: grid;
    gap: 0.55rem;
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }

  .auto__list li {
    display: flex;
    gap: 0.6rem;
    color: var(--color-gray-600);
  }

  .auto__list li::before {
    content: '✓';
    flex: none;
    font-weight: 700;
    color: var(--color-success-dark);
  }

  .plan__who {
