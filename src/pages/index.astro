---
import SplashLayout from '../layouts/SplashLayout.astro';
import { LEAGUES, crossHostLeagueHref } from '../config/leagues';
import type { CanonicalLeagueSlug } from '../config/leagues';
import ProductInterest from '../components/shared/ProductInterest.astro';
import { LEAGUE_PACKAGE_PRICING, MFL_LIVE_PRO_PRICE, SEASONAL_THEME_INCLUDES, SEASONAL_THEME_PRICE, type ProductSlug } from '../data/products';
import { mflLiveIncludedNames, siteExampleLeagues } from '../data/league-showcase';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../utils/league-year';
import { FORMER_BRAND, SERVICES } from '../data/mfl-services';
import { organizationJsonLd, websiteJsonLd } from '../utils/structured-data';

// ── What this page is for ─────────────────────────────────────────────────
// MFL.football SELLS LEAGUE WEBSITES first (Brandon, Nov 2026): the hero, the
// services and a live example come before anything free. The free tools are a
// short row near the bottom, and live scores has ONE band rather than a nav
// link, a free card, a band and a product card.

// The example section. Hand-picked through `siteExample` in league-showcase.ts
// (Brandon chooses which leagues a buyer is sent to: The League only, for
// now), and still under showcaseLeagues' rules, so a best-ball league or an
// unlisted package league can never be one.
const examples = siteExampleLeagues();

// The logo cuts each example panel draws. The panel follows the theme, so it
// wants both; a league with no entry falls back to its registry logo.
const EXAMPLE_LOGOS: Partial<Record<CanonicalLeagueSlug, { light: string; dark: string }>> = {
  theleague: { light: '/assets/logos/theleague-logo.svg', dark: '/assets/logos/theleague-logo-dark.svg' },
};

// This splash renders on every NON-league host: the shared app host, and also
// localhost and Vercel previews. On the shared host TheLeague is not served —
// `/theleague` 404s there — so an example panel must leave for the league's
// own domain rather than link to something this host refuses.
//
// `crossHostLeagueHref` decides that per host rather than unconditionally,
// which is the load-bearing part: absolute links everywhere would send a
// preview build's visitor to PRODUCTION theleague.us on the first click, so
// the branch under test becomes undrivable past its front page.
const hrefFromHere = (path: string) => crossHostLeagueHref(Astro.url.hostname, path);

// Nothing paid is on sale yet (`PRODUCT_PAGES_PUBLIC` is false and /products
// 404s for the public), so every "I'm interested" button is a coming-soon door
// (ProductInterest): it counts the click and offers to email the visitor at
// launch. Each service also links its public service page, which is real.
const seasonYear = getCurrentSeasonYear(getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined);
const proPrice = `$${MFL_LIVE_PRO_PRICE.season}`;
const includedNames = mflLiveIncludedNames();
const includedList =
  includedNames.length > 1
    ? `${includedNames.slice(0, -1).join(', ')} and ${includedNames[includedNames.length - 1]}`
    : (includedNames[0] ?? '');

// Public prices: MFL Live Pro (Oct 2026), League Package, the site's top price,
// and seasonal themes (Brandon, Nov 2026). Every other service here shows what
// it does, not what it costs.
interface ServiceCard {
  slug: ProductSlug;
  name: string;
  who: string;
  body: string;
  /** Its public service page (src/data/mfl-services.ts), when it has one. */
  learnMore?: string;
}

const servicePath = (slug: (typeof SERVICES)[number]['slug']) =>
  SERVICES.find((s) => s.slug === slug)?.path;

const MORE_SERVICES: ServiceCard[] = [
  {
    slug: 'league-hub',
    name: 'League Hub',
    who: 'For a commissioner who wants a real site',
    body: 'A branded site on your own domain with a daily homepage, an AI league reporter, push alerts and more.',
    learnMore: servicePath('league-website'),
  },
  {
    slug: 'league-history',
    name: 'Full History',
    who: 'For any MFL, Sleeper or Yahoo league',
    body: 'Every season back to your first: standings, playoffs, owner pages, rivalries and records.',
    learnMore: servicePath('league-history'),
  },
  {
    slug: 'contest-package',
    name: 'Contest Package',
    who: 'For organizers running many leagues',
    body: 'One competition across dozens or hundreds of MFL leagues.',
  },
];

// The top package is sold on automation, not features: everything a
// commissioner does by hand, the system does. Each line is a feature the
// platform already runs for The League and the AFL (src/data/products.ts).
const AUTOMATED = [
  'Your custom side game or league rule, run every week',
  'Deadline and lineup reminders to every owner',
  'Dues and prize payouts written into MFL’s books',
  'Contracts, the salary cap and extensions tracked',
  'Rules questions answered from your constitution',
  'League news, trades and recaps written for you',
  'Two weekly columns: Pecking Order power rankings and The Gauntlet schedule strength, named however your league likes',
  'Ask the History: any question about the league’s past',
  'MFL Football Pro for every owner, on phone and TV',
  'News and reminders posted to your group chat',
];

// The headline feature (Brandon, 2026-11-04): a league homepage whose hero
// changes with the calendar and leads with the one thing the league needs to
// do next. Each card is a real rung of the hero ladder (src/utils/league-hero/).
// No draft rung: draft features are worked out with each league, not sold.
const HERO_DAYS = [
  { when: 'Sunday morning', title: 'Your lineup has a hole', body: 'A starter is ruled out. You see it, and the fix, before kickoff.' },
  { when: 'Waiver night', title: 'Claims close tonight', body: 'The free agents worth a claim, with the time left to file one.' },
  { when: 'Monday', title: 'The week in one card', body: 'The week’s top performer, in the winning team’s colors.' },
  { when: 'Deadline week', title: 'Three days to make a deal', body: 'The trade deadline, counted down, with the teams still buying.' },
];

// Features that come with every custom league, shown beside the daily hero.
const SPOTLIGHT = [
  { title: 'Ask the History', body: 'Owners ask who won in 2014 or the all-time record between two teams, and get the answer from the league’s own records.' },
  { title: 'League news written for you', body: 'An AI reporter breaks every trade and signing and writes two weekly columns about your real teams: Pecking Order power rankings and The Gauntlet schedule strength. Rename them for your league.' },
  { title: 'Rules answers', body: 'Owners ask a rules question and get the answer from your constitution, on the site or in the group chat.' },
];

// Proof for the number-one sell, the league's own rules automated (Brandon,
// 2026-11-04): formats MFL cannot run, live on leagues we run. These are
// links to one page each, not homepage examples, so neither league needs
// siteExample (the AFL and Archie's are deliberately not showcased).
const CUSTOM_RULE_EXAMPLES = [
  {
    league: LEAGUES['afl-fantasy'],
    name: 'Premier League and D-League',
    body: 'Two tiers with promotion and relegation every season, in the AFL.',
  },
  {
    league: LEAGUES.archies,
    name: 'MAD Power 99',
    body: 'A 99-team playoff race on combined scores over weeks 15 to 17, in Archie’s League.',
  },
];

// The same TheLeague standings page in each look it wears (Brandon,
// 2026-11-04: show an example of everything we sell). Captured with
// ?testDate= inside each window of src/config/seasonal-themes.mjs.
const THEME_SHOTS = [
  { label: 'Regular season', src: '/assets/home/theme-regular.webp', alt: 'TheLeague standings in its everyday blue and green, with each team’s own logo' },
  { label: 'Halloween', src: '/assets/home/theme-halloween.webp', alt: 'The same standings in the Halloween theme: black and orange, a spooky headline face and every logo redrawn' },
  { label: 'Christmas Week', src: '/assets/home/theme-christmas.webp', alt: 'The same standings in the Christmas theme: red, string lights and every logo redrawn as a knitted sweater patch' },
];

const commissionerToolsPath = servicePath('commissioner-tools');
const skinsPath = servicePath('skins') ?? '/instructions#skin';
---
<SplashLayout
  title="MFL.football: custom league websites for MyFantasyLeague"
  description={`MFL.football (formerly ${FORMER_BRAND}) builds and runs custom websites for MyFantasyLeague leagues: commissioner automation, league history, live scores and free MFL skins.`}
  canonicalPath="/"
  ogImage="/assets/home/league-site.webp"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  {/* Soft Premium (src/styles/soft-premium.css): the hero, card, stat row and
      dark band here are the same ones every service page wears. */}
  <div class="home sp">
  <header class="sp-top">
    <a class="sp-brand" href="/" aria-label="MFL.football home">
      <img class="sp-brand__light" src="/assets/logos/mfl-football-wordmark.svg" width="5404" height="680" alt="" />
      <img class="sp-brand__dark" src="/assets/logos/mfl-football-wordmark-dark.svg" width="5404" height="680" alt="" />
    </a>
    <nav class="sp-top__links" aria-label="Sections">
      <a href="#services">Services</a>
      <a href="#examples">Example</a>
      <a class="sp-top__live" href="/live">Live scores</a>
      <a href="#free">Free tools</a>
    </nav>
    <div class="sp-top__end">
      <a class="cta cta--ghost" href="/login">Sign in</a>
    </div>
  </header>

  <section class="sp-hero">
    <div class="sp-hero__copy">
      <p class="sp-eyebrow">Formerly {FORMER_BRAND} · For MyFantasyLeague</p>
      <h1>Custom websites for your MFL league.</h1>
      <p class="sp-lede">
        We build your league a branded site on its own domain, then run it for you: your custom side games and house rules automated,
        a homepage built around today, reminders, dues, league history and news, handled so the commissioner does not have to.
      </p>
      <div class="sp-ctas">
        <a class="cta cta--primary" href="#services">See our services</a>
        {examples[0] && (
          <a class="cta cta--ghost" href={hrefFromHere(`/${examples[0].slug}`)}>See a live league site</a>
        )}
      </div>
      <ul class="sp-hero__facts">
        <li>Your league stays on MFL</li>
        <li>Built for phones</li>
        <li>Light and dark</li>
      </ul>
    </div>
    <div class="sp-hero__visual">
      <figure class="shot">
        <img src="/assets/home/league-site.webp" width="1230" height="748" alt="TheLeague's league site, built on MFL.football, with its weekly recap hero in the winning team's colors" />
      </figure>
      {examples[0] && (
        <div class="sp-lcard hero-lcard" aria-hidden="true">
          <span class="sp-lcard__top">
            <span>
              <span class="sp-lcard__name">{examples[0].name}</span><br />
              <span class="sp-lcard__meta">{examples[0].showcase.teams} teams · since {examples[0].showcase.estYear}</span>
            </span>
            <svg class="sp-lcard__ball" viewBox="-10 -8 20 16"><path d="M-6.5 0Q0-5.4 6.5 0Q0 5.4-6.5 0Z" stroke-width="3" stroke-linejoin="round" transform="rotate(-15)" /></svg>
          </span>
          {examples[0].domains?.[0] && <span class="sp-lcard__host">{examples[0].domains[0]}</span>}
          <span class="sp-lcard__label">Run by MFL.football</span>
        </div>
      )}
    </div>
  </section>

  <ul class="sp-stats" aria-label="At a glance">
    <li class="sp-stat"><b>{AUTOMATED.length}</b><span>Commissioner jobs our system does for you</span></li>
    <li class="sp-stat"><b>1</b><span>Site on your own domain, with your crest and colors</span></li>
    <li class="sp-stat"><b>2</b><span>Themes on every page, light and dark</span></li>
    <li class="sp-stat"><b>0</b><span>Moves away from MyFantasyLeague</span></li>
  </ul>

  <section class="sp-section" id="today" aria-labelledby="today-h">
    <div class="sp-head">
      <div class="sp-head__title">
        <p class="sp-eyebrow">Every day of the year</p>
        <h2 id="today-h">A homepage that knows what day it is</h2>
      </div>
      <p class="sp-head__note">Your league’s homepage leads with the most important thing your league needs to do today. Signed-in owners see it for their own team.</p>
    </div>
    <ol class="sp-grid sp-grid--4 days">
      {HERO_DAYS.map((d) => (
        <li class="ui-card sp-card">
          <span class="sp-card__who">{d.when}</span>
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </li>
      ))}
    </ol>
    <ul class="sp-grid spot">
      {SPOTLIGHT.map((f) => (
        <li class="ui-card sp-card">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="sp-section" id="services" aria-labelledby="services-h">
    <div class="sp-head">
      <div class="sp-head__title">
        <p class="sp-eyebrow">League websites</p>
        <h2 id="services-h">Everything the commissioner does by hand, handled.</h2>
      </div>
      <p class="sp-head__note">Launching soon. Tap “I'm interested” on any service and we'll email you when it opens.</p>
    </div>
    <div class="ui-card sp-card pkg">
      <div class="pkg__copy">
        <span class="sp-card__who">Our biggest package · for a league that wants it all handled</span>
        <h3 class="pkg__name">League Package</h3>
        <p class="pkg__lede">Your league’s custom side game or house rule, automated.</p>
        <p>The thing your commissioner has always tracked by hand, run by our system every week. Plus your own site with every feature on the platform, and priority support. Every owner also gets MFL Football Pro: the live scoring app on their phone and the live Broadcast on their TV.</p>
        <ul class="pkg__fees">
          {LEAGUE_PACKAGE_PRICING.tiers.map((t) => (
            <li><b>{t.setup}</b> <span>{t.setup === 'Custom quote' ? t.teams : `setup, ${t.teams.toLowerCase()}`}</span></li>
          ))}
        </ul>
        <p class="pkg__terms">
          Then a yearly renewal that runs your league's automation: {LEAGUE_PACKAGE_PRICING.renewals.map((r) => `${r.price} for ${r.teams} teams`).join(', ')}. Leagues of 16 or fewer that make their own logos save {LEAGUE_PACKAGE_PRICING.logoDiscount}.
        </p>
        <span class="sp-ctas">
          <button
            type="button"
            class="cta cta--primary"
            data-interest="league-package"
            data-interest-name="League Package"
            data-interest-note={`Setup from ${LEAGUE_PACKAGE_PRICING.tiers[0].setup}, then from ${LEAGUE_PACKAGE_PRICING.renewal} to run your league. Over 24 teams, we quote it.`}
          >I'm interested</button>
          {commissionerToolsPath && <a class="cta cta--ghost" href={commissionerToolsPath}>What it automates</a>}
        </span>
      </div>
      <ul class="sp-list pkg__list">
        {AUTOMATED.map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <div class="ui-card sp-card custom">
      <div class="custom__copy">
        <h3>The rules MFL can’t run, we run</h3>
        <p>Side games, tiers with relegation, playoff formats and league formats MyFantasyLeague doesn’t support, built for your league and scored automatically every week.</p>
      </div>
      <ul class="custom__list">
        {CUSTOM_RULE_EXAMPLES.map((ex) => (
          <li>
            <a class="cta-link" href={hrefFromHere(`/${ex.league.slug}/standings?view=league`)}>{ex.name}</a>
            <span class="sp-muted">{ex.body}</span>
          </li>
        ))}
      </ul>
    </div>
    <ul class="sp-grid services">
      {MORE_SERVICES.map((p) => (
        <li class="ui-card sp-card">
          <span class="sp-card__who">{p.who}</span>
          <h3>{p.name}</h3>
          <p>{p.body}</p>
          <span class="sp-ctas plan__acts">
            <button type="button" class="cta cta--ghost" data-interest={p.slug} data-interest-name={p.name}>I'm interested</button>
            {p.learnMore && <a class="cta-link" href={p.learnMore}>Learn more</a>}
          </span>
        </li>
      ))}
    </ul>
    <div class="ui-card sp-card themes">
      <div class="themes__copy">
        <span class="sp-card__who">Add-on</span>
        <h3>Seasonal themes</h3>
        <p>
          For a one-time {SEASONAL_THEME_PRICE} per theme, your site changes its look on its own through the year and changes back when the
          week is over. It includes remaking {SEASONAL_THEME_INCLUDES}.
        </p>
        <a class="sp-card__more" href="/mfl-league-themes">See every logo before and after</a>
      </div>
      <div class="themes__shots">
        {THEME_SHOTS.map((t) => (
          <figure>
            <img src={t.src} width="1200" height="560" loading="lazy" alt={t.alt} />
            <figcaption>{t.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    <p class="addons">
      <b>Add-ons</b> for League Hub and League Package leagues: side games, custom standings, prizes, contracts and large-league support.
      <button type="button" class="cta-link" data-interest="add-ons" data-interest-name="Add-ons">I'm interested</button>
    </p>
  </section>

  {examples.length > 0 && (
    <section class="sp-section" id="examples" aria-labelledby="examples-h">
      <div class="sp-head">
        <div class="sp-head__title">
          <p class="sp-eyebrow">See one running</p>
          <h2 id="examples-h">Every feature above runs on {examples.length === 1 ? 'this league' : 'these leagues'} today.</h2>
        </div>
      </div>
      <div class="examples" style={`--panel-count: ${examples.length}`}>
        {examples.map((league) => {
          const logo = EXAMPLE_LOGOS[league.slug] ?? league.logo;
          const host = league.domains?.[0];
          return (
            <a class="ui-card sp-card panel" data-league={league.navSlug} href={hrefFromHere(`/${league.slug}`)}>
              <span class="panel__logo">
                <img class="panel__logo-img panel__logo-img--light" src={logo.light} alt="" />
                <img class="panel__logo-img panel__logo-img--dark" src={logo.dark} alt="" />
              </span>
              <span class="panel__text">
                <h3>{league.name}</h3>
                <span class="sp-muted panel__meta">{league.showcase.teams} teams · {league.showcase.format} · since {league.showcase.estYear}</span>
              </span>
              <span class="sp-card__more">{host ? `Visit ${host}` : 'Visit the site'}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="sp-band live" aria-labelledby="live-h">
    <div class="sp-band__copy">
      <p class="sp-eyebrow">For any MFL owner</p>
      <h2 id="live-h">Live scores</h2>
      <p>
        Every MFL league you own, scored live on one board, free. Pro adds the Broadcast for your TV,
        projected standings and game-day alerts for {proPrice} a season.
      </p>
      <p class="live__price">
        <s>{proPrice}</s><strong>Free</strong>
        <span>Pro for {includedList} owners through the {seasonYear} season</span>
      </p>
      <a class="cta cta--primary" href="/live">Open live scores</a>
    </div>
    <img class="live__img" src="/assets/mfl-live/landing-takeover.webp" width="1440" height="810" loading="lazy" alt="A field goal takes over the TV on the live scores Broadcast" />
  </section>

  <section class="sp-section" id="free" aria-labelledby="free-h">
    <div class="sp-head">
      <div class="sp-head__title">
        <p class="sp-eyebrow">Free</p>
        <h2 id="free-h">Free tools</h2>
      </div>
      <p class="sp-head__note">No account, no cost.</p>
    </div>
    <div class="sp-grid">
      <a class="ui-card sp-card" href={skinsPath}>
        <h3>MFL skin</h3>
        <p>Light and dark themes for your league's MyFantasyLeague pages.</p>
        <span class="sp-card__more">Get the skin</span>
      </a>
      <a class="ui-card sp-card" href="/instructions#homepage">
        <h3>Template builder</h3>
        <p>A homepage, header and footer for MFL, with step-by-step install.</p>
        <span class="sp-card__more">Build a template</span>
      </a>
      <a class="ui-card sp-card" href="/mfl-all-play-standings">
        <h3>All-play standings</h3>
        <p>Paste any MFL league ID: all-play standings and who the schedule helped or robbed.</p>
        <span class="sp-card__more">Run the report</span>
      </a>
    </div>
  </section>

  <footer class="sp-foot">
    <span>MFL.football · formerly {FORMER_BRAND}</span>
    <nav class="sp-foot__links" aria-label="Site">
      {SERVICES.map((s) => <a href={s.path}>{s.eyebrow}</a>)}
      <a href="/mfl-all-play-standings">Free all-play standings</a>
      <a href="/compare">Compare</a>
      <a href="/about">About</a>
      <a href="/live">Live scores</a>
      <a href="/instructions">Template instructions</a>
      <a href="/brand">Brand Book</a>
    </nav>
  </footer>

  <ProductInterest />
  </div>
</SplashLayout>
<style>
  /* Page layout only. Every surface, type style and colour comes from
     src/styles/soft-premium.css, shared with the service pages. */

  /* Hero visual: TheLeague's real site in a soft frame, with the graphite
     league card overlapping its lower-left corner on wide screens. */
  .shot {
    margin: 0;
    overflow: hidden;
    border-radius: var(--sp-radius);
    background: var(--sp-surface);
    box-shadow: var(--sp-shadow);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-lcard {
    position: absolute;
    left: -2.5rem;
    bottom: -2.5rem;
    max-width: 17rem;
    padding: 1.1rem 1.2rem;
    aspect-ratio: 1.62;
  }

  .hero-lcard .sp-lcard__name {
    font-size: var(--sp-text-lg);
  }

  @media (max-width: 1100px) {
    .hero-lcard {
      left: 1rem;
      bottom: -2rem;
      max-width: 15rem;
    }
  }

  @media (max-width: 860px) {
    .sp-hero__visual {
      padding-bottom: 2.5rem;
    }

    .hero-lcard {
      left: 0.75rem;
      max-width: 12.5rem;
      padding: 0.85rem 1rem;
      gap: 0.5rem;
    }

    .hero-lcard .sp-lcard__name {
      font-size: var(--sp-text-md);
    }

    .hero-lcard .sp-lcard__host {
      font-size: var(--sp-text-xs);
    }
  }

  .sp-stats {
    margin-top: 1.5rem;
  }

  /* The package: copy on the card's white, the automated list on a gray
     inset, side by side; stacked on phones. */
  .pkg {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .pkg__copy {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .pkg__name {
    font-size: var(--sp-text-2xl);
  }

  .pkg .pkg__lede {
    color: var(--sp-ink);
    font-weight: 600;
  }

  .pkg__fees {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pkg__fees li {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    padding: 0.8rem 0.9rem;
    border-radius: var(--sp-radius-sm);
    background: var(--sp-surface-2);
    font-size: var(--sp-text-sm);
    color: var(--sp-muted);
  }

  .pkg__fees b {
    font-size: var(--sp-text-lg);
    color: var(--sp-ink);
  }

  .pkg .pkg__terms {
    font-size: var(--sp-text-sm);
  }

  /* The headline feature: four day cards, then the three spotlight cards. */
  .days {
    margin-bottom: 1rem;
  }

  .days .sp-card__who {
    color: var(--sp-red);
  }

  /* Custom rules: the copy beside its two live proof links. */
  .custom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 2rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .custom__list {
    display: grid;
    gap: 0.9rem;
    margin: 0;
