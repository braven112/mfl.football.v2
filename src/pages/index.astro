---
import SplashLayout from '../layouts/SplashLayout.astro';
import { ALL_LEAGUES, crossHostLeagueHref } from '../config/leagues';
import type { CanonicalLeagueSlug } from '../config/leagues';
import { getLatestWhatsNewAcrossLeagues } from '../utils/whats-new-cross-league';
import ProductInterest from '../components/shared/ProductInterest.astro';
import { MFL_LIVE_PRO_PRICE, type ProductSlug } from '../data/products';
import { mflLiveIncludedNames } from '../data/league-showcase';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../utils/league-year';

interface PanelMeta {
  logo: string;
  /** On-dark variant (white fills) — the panels are dark gradients in both themes */
  logoDark: string;
  estYear: number;
  stats: string;
}

// Presentational-only data; ids/slugs/names come from the league registry.
// A league with no entry here (any launched league, until it is advertised and
// given its own line) gets a panel built from its registry logo: see panelFor.
const PANEL_META: Partial<Record<CanonicalLeagueSlug, PanelMeta>> = {
  theleague: {
    logo: '/assets/logos/theleague-logo.svg',
    logoDark: '/assets/logos/theleague-logo-dark.svg',
    estYear: 2007,
    stats: '16 Teams · 1 Conference · 3 Draft Rounds',
  },
  'afl-fantasy': {
    logo: '/assets/logos/afl-logo.svg',
    logoDark: '/assets/logos/afl-logo-dark.svg',
    estYear: 2003,
    stats: '24 Teams · 2 Conferences · 9 Draft Rounds',
  },
  'best-ball-1': {
    logo: '/assets/logos/bestball-logo.svg',
    logoDark: '/assets/logos/bestball-logo-dark.svg',
    estYear: 2026,
    stats: '12 Teams · Best Ball · 25-Round Draft',
  },
  keeper: {
    logo: '/assets/logos/keeper-logo.svg',
    logoDark: '/assets/logos/keeper-logo-dark.svg',
    estYear: 2020,
    stats: '12 Teams · Keepers · No Salary Cap',
  },
  archies: {
    logo: '/assets/logos/archies-head.webp',
    logoDark: '/assets/logos/archies-head.webp',
    estYear: 2021,
    stats: '99 Teams · 9 Divisions · Redraft',
  },
};

function panelFor(league: (typeof ALL_LEAGUES)[number]): PanelMeta {
  return (
    PANEL_META[league.slug] ?? {
      logo: league.logo.light,
      logoDark: league.logo.dark,
      estYear: new Date().getFullYear(),
      stats: '',
    }
  );
}

const CHIP_LABELS: Record<string, string> = {
  theleague: 'The League',
  afl: 'AFL',
  bb1: 'Best Ball #1',
  archies: "Archie's",
};

/**
 * Which leagues the front door ADVERTISES.
 *
 * Derived from the registry's `bestBall` flag — the same derivation
 * `BOTH_LEAGUES` uses for the weekly changelog — and never a slug list, so a
 * best-ball sister league added later is dropped from here automatically, and
 * a fourth full-management league appears automatically.
 *
 * ── THIS IS A PRESENTATION RULE AND MUST NOT BECOME A ROUTING ONE ─────────
 * Best Ball #1 declares `domains: []`: the shared host's path prefix is the
 * ONLY address it has, so hiding it at the ROUTE level would remove it from
 * the internet rather than send it somewhere else — which is exactly what
 * `resolveSharedHostHiddenLeague` refuses to do, and what the 'never hides a
 * league that has nowhere else to be' guard exists to keep refusing.
 *
 * So this list governs the splash and nothing else. `/best-ball-1/*` is still
 * served here, and the league switcher in the nav on both league sites still
 * offers it (`buildSwitchUrl` sends it to SHARED_APP_ORIGIN, since it has no
 * apex to link to), which is what keeps it reachable now that the front door
 * no longer names it. Pinned in tests/shared-host-league-hiding.test.ts.
 *
 * PANEL_META, CHIP_LABELS and the `.chip--bb1` rule are all deliberately left
 * complete rather than pruned as dead: PANEL_META is keyed by every canonical
 * slug, and keeping the other two means re-advertising a league is this one
 * filter and nothing else. Pruning them would make it a multi-file change that
 * silently ships an unstyled chip.
 */
// A package league (archies) is listed only once its owner says so — a client
// league is not automatically an advertisement for the site. The registry's
// `advertiseOnSharedHost: false` keeps it off the splash; it is still served
// at its own path.
const splashLeagues = ALL_LEAGUES.filter(
  (league) => !league.bestBall && league.advertiseOnSharedHost !== false,
);
const advertisedNavSlugs = new Set(splashLeagues.map((league) => league.navSlug));

const leagueCount = splashLeagues.length;

// Same list, so the feed cannot advertise a league the panels above do not.
// Scoping the SLICES (rather than filtering afterwards) is what keeps a
// best-ball-only article out of the pool entirely instead of letting it
// occupy one of the six slots and then be dropped.
const entries = getLatestWhatsNewAcrossLeagues(
  6,
  splashLeagues.map((league) => league.navSlug),
);

// This splash renders on every NON-league host: the shared app host, and also
// localhost and Vercel previews. On the shared host TheLeague and the AFL are
// not served — `/theleague` 404s there — so their panels and the What's New
// cards (whose detailPath is itself a league path) must leave for the league's
// own domain rather than link to something this host refuses.
//
// `crossHostLeagueHref` decides that per host rather than unconditionally,
// which is the load-bearing part: absolute links everywhere would send a
// preview build's visitor to PRODUCTION theleague.us on the first click, so
// the branch under test becomes undrivable past its front page. It also leaves
// Best Ball #1 alone — that league has no apex, and a relative path is the
// honest link when you are already on the only host serving it.
const hrefFromHere = (path: string) => crossHostLeagueHref(Astro.url.hostname, path);

// ── The storefront ─────────────────────────────────────────────────────────
// MFL.football is the brand; this page says what is free, what MFL Live is,
// and what the paid products cost. Nothing paid is on sale yet
// (`PRODUCT_PAGES_PUBLIC` is false and /products 404s for the public), so
// every paid button — and the free League History page, which ships with
// Full History — is a "coming soon" door (ProductInterest): it counts the
// click and offers to email the visitor at launch. The one exception is MFL
// Live's own sign-in, which is real for the leagues that have Pro included.
const seasonYear = getCurrentSeasonYear(getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined);
const proPrice = `$${MFL_LIVE_PRO_PRICE.season}`;
const includedNames = mflLiveIncludedNames();
const includedList =
  includedNames.length > 1
    ? `${includedNames.slice(0, -1).join(', ')} and ${includedNames[includedNames.length - 1]}`
    : (includedNames[0] ?? '');

// Prices: only MFL Live Pro's is public (Brandon, Oct 2026). Every other
// product shows what it does, not what it costs, until its price is ready to
// announce — a card without `price` simply leaves the line out.
interface PaidCard {
  slug: ProductSlug;
  name: string;
  who: string;
  price?: string;
  per?: string;
  body: string;
  /** Shown in the dialog under "coming soon", when the door needs a word more. */
  note?: string;
}

const PAID: PaidCard[] = [
  {
    slug: 'owner-suite',
    name: 'MFL Live Pro',
    who: 'For any MFL owner',
    price: proPrice,
    per: `/ season · or $${MFL_LIVE_PRO_PRICE.month}/month`,
    body: 'The Broadcast for your TV, live and projected standings, full boards and game-day alerts.',
    note: `Owners in ${includedList} already have Pro this season: sign in at MFL Live.`,
  },
  {
    slug: 'league-history',
    name: 'Full History',
    who: 'For any MFL, Sleeper or Yahoo league',
    body: 'Every season back to your first: standings, playoffs, owner pages, rivalries and records.',
  },
  {
    slug: 'league-hub',
    name: 'League Hub',
    who: 'For a commissioner who wants a real site',
    body: 'A branded site on your own domain with the draft hub, an AI league reporter, push alerts and more.',
  },
  {
    slug: 'contest-package',
    name: 'Contest Package',
    who: 'For organizers running many leagues',
    body: 'One competition across dozens or hundreds of MFL leagues.',
  },
  {
    slug: 'add-ons',
    name: 'Add-ons',
    who: 'For League Hub and League Package leagues',
    body: 'Side games, custom standings, prizes, contracts and large-league support.',
  },
];

// The top package is sold on automation, not features: everything a
// commissioner does by hand, the system does. Each line is a feature the
// platform already runs for The League and the AFL (src/data/products.ts).
const AUTOMATED = [
  'Deadline and lineup reminders to every owner',
  'Draft order, the draft room and results',
  'Dues and prize payouts written into MFL’s books',
  'Contracts, the salary cap and extensions tracked',
  'Rules questions answered from your constitution',
  'League news, trades and recaps written for you',
  'Weekly power rankings and an owners’ poll',
  'News and reminders posted to your group chat',
];
---
<SplashLayout title="MFL.football — skins, live scoring and league sites for MyFantasyLeague">
  <div class="home">
  <header class="top">
    <a class="brand" href="/" aria-label="MFL.football home">
      <img class="brand__mark brand__mark--light" src="/assets/logos/mfl-football-wordmark.svg" width="5404" height="680" alt="" />
      <img class="brand__mark brand__mark--dark" src="/assets/logos/mfl-football-wordmark-dark.svg" width="5404" height="680" alt="" />
    </a>
    <nav class="top__links" aria-label="Sections">
      <a href="#free">Free tools</a>
      <a class="top__live" href="/live">MFL Live</a>
      <a href="#products">Products</a>
      <a href="#leagues">Leagues</a>
    </nav>
    <a class="cta cta--ghost top__signin" href="/login">Sign in</a>
  </header>

  <section class="hero">
    <div>
      <p class="eyebrow">For MyFantasyLeague leagues</p>
      <h1>Make your MFL league look like a pro league.</h1>
      <p class="lede">
        Free skins and templates for any MyFantasyLeague site, live scoring for every league you play in,
        and full league sites when you're ready for more.
      </p>
      <div class="hero__ctas">
        <a class="cta cta--primary" href="/instructions">Get the free skin</a>
        <a class="cta cta--ghost" href="#products">See all products</a>
      </div>
    </div>
    <figure class="shot">
      <div class="shot__chrome" aria-hidden="true"><i></i><i></i><i></i><span>theleague.us</span></div>
      <img src="/assets/home/league-site.webp" width="1230" height="748" alt="TheLeague's league site, built on MFL.football, with its weekly recap hero in the winning team's colors" />
    </figure>
  </section>

  <section class="block" id="free" aria-labelledby="free-h">
    <div class="block__head">
      <div><span class="tag tag--free">Free</span><h2 id="free-h">Start free</h2></div>
      <p>Everything here costs nothing. Use it as long as you like.</p>
    </div>
    <div class="free-grid">
      <a class="card" href="/instructions#skin">
        <span class="tag tag--free">Free</span>
        <h3>MFL skin</h3>
        <p>Light and dark themes for your league's MyFantasyLeague pages.</p>
        <span class="card__more">Get the skin →</span>
      </a>
      <a class="card" href="/instructions#homepage">
        <span class="tag tag--free">Free</span>
        <h3>Template builder</h3>
        <p>A homepage, header and footer for MFL, with step-by-step install.</p>
        <span class="card__more">Build a template →</span>
      </a>
      <a class="card" href="/live">
        <span class="tag tag--free">Free</span>
        <h3>MFL Live scores</h3>
        <p>Live scores for every MFL league you play in, on one screen.</p>
        <span class="card__up">Upgrade: <b>Pro {proPrice}/season</b></span>
        <span class="card__more">Open MFL Live →</span>
      </a>
      <button type="button" class="card" data-interest="league-history" data-interest-name="The League History page">
        <span class="tag tag--soon">Free · Coming soon</span>
        <h3>League History page</h3>
        <p>Your league's champions and a trophy case for every franchise.</p>
        <span class="card__up">Upgrade: <b>Full History</b></span>
        <span class="card__more">I'm interested →</span>
      </button>
    </div>
  </section>

  <section class="live" aria-labelledby="live-h">
    <div class="live__copy">
      <span class="live__kicker">New this season</span>
      <h2 id="live-h">MFL Live</h2>
      <p>
        Every MFL league you own, scored live on one board. Put it on the TV, watch the standings move,
        and get pinged when a game gets close.
      </p>
      <p class="live__price">
        <s>{proPrice}</s><strong>Free</strong>
        <span>for {includedList} owners through the {seasonYear} season</span>
      </p>
      <a class="cta cta--primary live__cta" href="/live">See MFL Live →</a>
    </div>
    <img class="live__img" src="/assets/mfl-live/landing-takeover.webp" width="1440" height="810" loading="lazy" alt="A field goal takes over the TV on the MFL Live Broadcast" />
  </section>

  <section class="block" id="products" aria-labelledby="products-h">
    <div class="block__head">
      <div><span class="tag tag--paid">When you want more</span><h2 id="products-h">Products</h2></div>
      <p>From one owner's game day to a fully custom league site. Coming soon: tap one to tell us you want it.</p>
    </div>
    <button
      type="button"
      class="auto"
      data-interest="league-package"
      data-interest-name="League Package"
      data-interest-note="Anything a commissioner does by hand, our system handles: a one-time setup fee, then an automation fee to run your league."
    >
      <span class="auto__copy">
        <span class="plan__who">Our biggest package · for a league that wants it all handled</span>
        <h3>League Package</h3>
        <span class="auto__lede">Anything the commissioner does manually, our system handles.</span>
        <span class="auto__body">Your own site with every feature on the platform, custom features built for how your league plays, and priority support.</span>
        {/* The pricing SHAPE, without amounts (Brandon, Oct 2026). */}
        <span class="auto__fees">
          <span><b>Setup fee</b> We build your league's site and features once.</span>
          <span><b>Automation fee</b> We run your league from then on.</span>
        </span>
        <span class="card__more">Coming soon · I'm interested →</span>
      </span>
      <ul class="auto__list">
        {AUTOMATED.map((line) => <li>{line}</li>)}
      </ul>
    </button>
    <div class="paid">
      {PAID.map((p) => (
        <button
          type="button"
          class="plan"
          data-interest={p.slug}
          data-interest-name={p.name}
          data-interest-note={p.note}
        >
          <span class="plan__who">{p.who}</span>
          <h3>{p.name}</h3>
          {p.price && <span class="plan__price">{p.price} <small>{p.per}</small></span>}
          <p>{p.body}</p>
          <span class="card__more">Coming soon · I'm interested →</span>
        </button>
      ))}
    </div>
  </section>

  {/* The panels: one per advertised league, through hrefFromHere (see above). */}
  <section class="block" id="leagues" aria-labelledby="leagues-h">
    <div class="block__head"><h2 id="leagues-h">Leagues on MFL.football</h2></div>
    <div class="hero-leagues" style={`--panel-count: ${leagueCount}`}>
      {splashLeagues.map((league) => {
        const meta = panelFor(league);
        return (
          <a class="panel" data-league={league.navSlug} href={hrefFromHere(`/${league.slug}`)}>
            <img class="panel__logo panel__logo--light" src={meta.logo} alt="" />
            <img class="panel__logo panel__logo--dark" src={meta.logoDark} alt="" />
            <span>
              <span class="panel__name">{league.name}</span>
              <span class="panel__meta">{meta.stats} · since {meta.estYear}</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="block whats-new" aria-labelledby="whats-new-heading">
    <h2 id="whats-new-heading" class="section-title">What's new on the league sites</h2>
    <ul class="wn-grid">
      {entries.map((entry) => (
        <li>
          <a class="wn-card" href={hrefFromHere(entry.detailPath)}>
            <span class="wn-meta">
              {entry.leagues.filter((slug) => advertisedNavSlugs.has(slug)).map((slug) => (
                <span class={`chip chip--${slug}`}>{CHIP_LABELS[slug] ?? slug}</span>
              ))}
              <time datetime={entry.date}>{entry.formattedDate}</time>
            </span>
            <h3>{entry.title}</h3>
            <p>{entry.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <footer class="foot">
    <span>MFL.football</span>
    <a href="/live">MFL Live</a>
    <a href="/instructions">Template instructions</a>
    <a href="/brand">Brand Book</a>
  </footer>

  <ProductInterest />
  </div>
</SplashLayout>

<style>
  /* MFL.football's brand is red and black, in BOTH themes. The splash layout's
     default theme would paint this page navy (CTAs, headings) in light and
     blue/green in dark, so the page sets its own values for the tokens it and
     the shared CTA (src/styles/cta.css) read. Dark keeps the brand: near-white
     ink on the dark ground, with a lighter red that holds contrast there. */
  .home {
    --brand-ink: #111111;
    --brand-red: #c8102e;
    --brand-red-hover: #a10d25;
    --primary-link-default-text-color: var(--brand-ink);
    --primary-link-hover-text-color: var(--brand-red);
    --secondary-color: var(--brand-red);
    --cta-fill: var(--brand-red);
    --cta-fill-hover: var(--brand-red-hover);
    --on-cta-fill: #ffffff;
    --btn-primary-border-hover: var(--brand-red);
  }

  :global(html.dark) .home {
    --brand-ink: #f2f3f5;
    --brand-red: #ff4d5e;
    --brand-red-hover: #ff7380;
    --on-cta-fill: #111111;
  }

  /* Quieter than MFL Live's landing: the page follows the theme, and the one
     loud surface is the MFL Live band, which is dark in BOTH themes (MFL
     Live's own ground, #14161a family) so its literals do not flip. */
  .top {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--primary-content-border-color);
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  /* The wordmark's letters are outlined paths (public/assets/logos/), so it
     needs no font. One cut per theme, like the league panels' logos. */
  .brand__mark {
    display: block;
    width: auto;
    height: 1.6rem;
  }

  .brand__mark--dark,
  :global(html.dark) .brand__mark--light {
    display: none;
  }

  :global(html.dark) .brand__mark--dark {
    display: block;
  }

  .top__links {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
    font-size: var(--font-size-sm);
  }

  .top__live {
    font-weight: 700;
  }

  .top__live::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #e0263c;
    vertical-align: 0.1em;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 4.5rem 0 3.5rem;
  }

  .eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  .hero h1 {
    margin: 0.75rem 0 1rem;
    font-size: var(--font-size-3xl);
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .lede {
    margin: 0 0 1.75rem;
    max-width: 30em;
    font-size: var(--font-size-base);
    color: var(--color-gray-600);
  }

  .hero__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--primary-content-border-color);
    border-radius: 16px;
    background: var(--primary-content-bg-color);
    box-shadow: var(--shadow-xl);
  }

  .shot__chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--primary-content-border-color);
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  .shot__chrome i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--primary-content-border-color);
  }

  .shot__chrome span {
    margin-left: 0.75rem;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .block {
    padding: 3.5rem 0 0;
  }

  .block__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .block__head h2 {
    margin: 0.5rem 0 0;
    font-size: var(--font-size-2xl);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .block__head p {
    margin: 0;
    max-width: 26em;
    color: var(--color-gray-600);
  }

  .tag {
    display: inline-block;
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: var(--font-size-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tag--free {
    background: color-mix(in srgb, var(--color-success) 14%, transparent);
    color: var(--color-success-dark);
  }

  .tag--soon,
  .tag--paid {
    border: 1px solid var(--primary-content-border-color);
    color: var(--color-gray-600);
  }

  /* Cards are links or fake-door buttons; both reset to the same box. */
  .card,
  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border: var(--style-card-border, 1px solid var(--primary-content-border-color));
    box-shadow: var(--style-card-shadow, none);
    border-radius: 16px;
    background: var(--primary-content-bg-color);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .card:hover,
  .plan:hover {
    transform: translateY(-2px);
    border-color: var(--color-gray-500);
    text-decoration: none;
    color: inherit;
  }

  .card:focus-visible,
  .plan:focus-visible {
    outline: 2px solid var(--secondary-color);
    outline-offset: 3px;
  }

  .card h3,
  .plan h3 {
    margin: 0.2rem 0 0;
    font-size: var(--font-size-lg);
  }

  .card p,
  .plan p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
  }

  .card__up {
    padding-top: 0.6rem;
    border-top: 1px dashed var(--primary-content-border-color);
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  .card__up b {
    color: var(--primary-link-default-text-color);
  }

  .card__more {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--secondary-color);
  }

  .free-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  /* ---------- MFL Live band ---------- */

  .live {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    margin-top: 3.5rem;
    overflow: hidden;
    border: 1px solid #2a2f37;
