---
import SplashLayout from '../layouts/SplashLayout.astro';
import { crossHostLeagueHref } from '../config/leagues';
import ProductInterest from '../components/shared/ProductInterest.astro';
import {
  BEAT_REPORTER_PRICE_YEAR,
  CUSTOM_FROM_SETUP,
  HISTORY_AND_REPORTER_PRICE_YEAR,
  HISTORY_PRICE_YEAR,
  dollars,
} from '../data/pricing';
import { siteExampleLeagues } from '../data/league-showcase';
import { FORMER_BRAND, SITE_FOOTER_LINKS, SITE_HEADER_LINKS, findService } from '../data/mfl-services';
import { organizationJsonLd, websiteJsonLd } from '../utils/structured-data';

// ── What this page is for ─────────────────────────────────────────────────
// Since 2026-11-16 the homepage shows only the products (Brandon: "super
// simple, shows the products"): Ask the History ($49), the AI Beat Reporter
// ($49, the house voice Max Insider), both together ($79), and custom sites
// from $3,000. Each product has its own page (src/data/mfl-services.ts), and
// every price here is read from src/data/pricing.ts, so the homepage, the
// product pages and /pricing can never disagree.

// The example league the custom-site card links to. Hand-picked through
// `siteExample` in league-showcase.ts (The League only, for now), and still
// under showcaseLeagues' rules, so a best-ball league or an unlisted package
// league can never be one.
const examples = siteExampleLeagues();

// This splash renders on every NON-league host: the shared app host, and also
// localhost and Vercel previews. On the shared host TheLeague is not served,
// so a league link must leave for the league's own domain, and
// `crossHostLeagueHref` decides that per host (an absolute link everywhere
// would send a preview build's visitor to production).
const hrefFromHere = (path: string) => crossHostLeagueHref(Astro.url.hostname, path);

const history = findService('ask-the-history');
const reporter = findService('beat-reporter');
const custom = findService('league-website');

const bundleSaves = HISTORY_PRICE_YEAR + BEAT_REPORTER_PRICE_YEAR - HISTORY_AND_REPORTER_PRICE_YEAR;

// Ask the History and the Beat Reporter are on sale by direct contact
// (Brandon, 2026-11-16): their buttons open ProductInterest's request form.
// The custom site is still a coming-soon door.
const PRODUCTS = [
  {
    key: 'history',
    href: history.path,
    kicker: 'League history',
    name: 'Ask the History',
    pitch: 'Every season of your league in one place, and an AI that answers anything about its past.',
    price: dollars(HISTORY_PRICE_YEAR),
    unit: 'a year',
    points: ['Ask any question in plain English', 'Champions, records and rivalries', 'Every franchise and owner'],
    interest: { product: 'league-history', name: `Ask the History, ${dollars(HISTORY_PRICE_YEAR)} a year` },
  },
  {
    key: 'reporter',
    href: reporter.path,
    kicker: 'AI beat reporter',
    name: 'Max Insider',
    pitch: 'Your league’s own insider. He breaks every trade and move and writes the weekly columns.',
    price: dollars(BEAT_REPORTER_PRICE_YEAR),
    unit: 'a year',
    points: ['Breaking news, minutes after a move', 'Weekly columns about your league', 'Right on your MFL home page'],
    interest: { product: 'beat-reporter', name: `the AI Beat Reporter, ${dollars(BEAT_REPORTER_PRICE_YEAR)} a year` },
  },
] as const;
---
<SplashLayout
  title="MFL.football: Ask the History, an AI beat reporter and custom MFL league sites"
  description={`MFL.football (formerly ${FORMER_BRAND}) for MyFantasyLeague leagues: Ask the History ${dollars(HISTORY_PRICE_YEAR)}/yr, the AI Beat Reporter ${dollars(BEAT_REPORTER_PRICE_YEAR)}/yr, both ${dollars(HISTORY_AND_REPORTER_PRICE_YEAR)}/yr, custom sites from ${dollars(CUSTOM_FROM_SETUP)}.`}
  canonicalPath="/"
  ogImage="/assets/home/league-site.webp"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  {/* Soft Premium (src/styles/soft-premium.css): the same header, card and
      footer every service page wears. */}
  <div class="home sp">
  <header class="sp-top">
    <a class="sp-brand" href="/" aria-label="MFL.football home">
      <img class="sp-brand__light" src="/assets/logos/mfl-football-wordmark.svg" width="5404" height="680" alt="" />
      <img class="sp-brand__dark" src="/assets/logos/mfl-football-wordmark-dark.svg" width="5404" height="680" alt="" />
    </a>
    <nav class="sp-top__links" aria-label="Main">
      {SITE_HEADER_LINKS.map((l) => <a href={l.href} aria-current={l.href === '/' ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="sp-top__end">
      <a class="cta cta--ghost" href="/login">Sign in</a>
    </div>
  </header>

  <section class="intro" aria-labelledby="intro-h">
    <p class="sp-eyebrow">For MyFantasyLeague · Formerly {FORMER_BRAND}</p>
    <h1 id="intro-h">Give your league<br class="intro__br" /> the full treatment.</h1>
    <p class="intro__lede">Three ways to make an MFL league feel big-time. Pick one, or take it all.</p>
  </section>

  <section class="lineup" aria-label="Products">
    {PRODUCTS.map((p) => (
      <article class={`prod prod--${p.key}`}>
        <div class="prod__head">
          <p class="prod__kicker">{p.kicker}</p>
          {p.key === 'reporter' && (
            <img class="prod__avatar" src="/assets/beat-reporter-avatar.webp" width="256" height="256" alt="Max Insider" />
          )}
        </div>
        <h2 class="prod__name">{p.name}</h2>
        <p class="prod__pitch">{p.pitch}</p>
        <p class="prod__price"><b>{p.price}</b><span>{p.unit}</span></p>
        <ul class="prod__points">
          {p.points.map((t) => <li>{t}</li>)}
        </ul>
        <div class="prod__acts">
          <a class="cta cta--primary" href={p.href}>See details</a>
          <button type="button" class="cta-link" data-interest={p.interest.product} data-interest-name={p.interest.name}>Get started</button>
        </div>
      </article>
    ))}

    <aside class="bundle" aria-labelledby="bundle-h">
      <div class="bundle__copy">
        <p class="prod__kicker">Better together</p>
        <h2 id="bundle-h" class="bundle__name">Ask the History + Max Insider</h2>
      </div>
      <p class="bundle__price"><b>{dollars(HISTORY_AND_REPORTER_PRICE_YEAR)}</b><span>a year for both · save {dollars(bundleSaves)}</span></p>
      <button
        type="button"
        class="cta cta--primary"
        data-interest="history-and-reporter"
        data-interest-name={`Ask the History + the AI Beat Reporter, ${dollars(HISTORY_AND_REPORTER_PRICE_YEAR)} a year`}
      >Get both</button>
    </aside>

    <article class="prod prod--custom">
      <div class="prod__head">
        <p class="prod__kicker">The flagship</p>
        <svg class="prod__ball" viewBox="-10 -8 20 16" aria-hidden="true"><path d="M-6.5 0Q0-5.4 6.5 0Q0 5.4-6.5 0Z" stroke-width="3" stroke-linejoin="round" transform="rotate(-15)" /></svg>
      </div>
      <h2 class="prod__name">Custom sites</h2>
      <p class="prod__pitch">Your league on its own domain, in its own colors, built and run for you. Everything above is included.</p>
      <p class="prod__price"><small>Starting at</small><b>{dollars(CUSTOM_FROM_SETUP)}</b><span>setup and your first year</span></p>
      <ul class="prod__points">
        <li>Your domain, crest and colors</li>
        <li>Lineups, trades and claims, synced to MFL</li>
        <li>Live scoring, Ask the History and Max Insider</li>
      </ul>
      <div class="prod__acts">
        <a class="cta cta--primary" href={custom.path}>See details</a>
        <button type="button" class="cta-link" data-interest="league-package" data-interest-name="A custom MFL league website">I’m interested</button>
      </div>
      {examples.length > 0 && (
        <p class="prod__live">
          See one running:{' '}
          {examples.map((league) => {
            return <a class="cta-link" data-league={league.navSlug} href={hrefFromHere(`/${league.slug}`)}>{league.name}</a>;
          })}
        </p>
      )}
    </article>
  </section>

  <footer class="sp-foot">
    <span>MFL.football · formerly {FORMER_BRAND}</span>
    <nav class="sp-foot__links" aria-label="Site">
      {/* Live scores left the header (Brandon, 2026-11-16) but the installed
          app opens on this page, so the board stays one tap away here. */}
      <a href="/live">Live scores</a>
      {SITE_FOOTER_LINKS.filter((l) => l.href !== '/live').map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </footer>

  <ProductInterest />
  </div>
</SplashLayout>
<style>
  /* Page layout only. Surfaces, type and color come from the Soft Premium
     tokens (src/styles/soft-premium.css), shared with the product pages. The
     custom-site card is dark in BOTH themes, so it reads the band tokens. */

  .intro {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  /* Centered, so the eyebrow drops its dot (it would orphan on a wrap). */
  .intro .sp-eyebrow::before {
    display: none;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--sp-ink);
  }

  .intro__lede {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--sp-muted);
  }

  /* Desktop: History | Reporter | Custom, with the bundle under the first two
     and the custom card standing the full height. Phones: one column, in
     that order with the bundle before the flagship. */
  .lineup {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'history reporter custom'
      'bundle bundle custom';
    gap: 1.1rem;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .prod--history { grid-area: history; }
  .prod--reporter { grid-area: reporter; }
  .prod--custom { grid-area: custom; }
  .bundle { grid-area: bundle; }

  .prod,
  .bundle {
    box-sizing: border-box;
    min-width: 0;
    border: 1px solid var(--sp-line);
    border-radius: var(--sp-radius);
    background: var(--sp-surface);
    box-shadow: var(--sp-shadow);
    color: var(--sp-ink);
  }

  .prod {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
  }

  .prod__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
  }

  .prod__kicker {
    margin: 0;
    font-size: var(--sp-text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sp-red);
  }

  .prod__avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: var(--sp-live-ring);
  }

  .prod__name {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .prod__pitch {
    margin: 0;
    font-size: var(--sp-text-md);
    line-height: 1.55;
    color: var(--sp-muted);
  }

  .prod__price,
  .bundle__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.5rem;
    margin: 0.4rem 0 0;
  }

  .prod__price b,
  .bundle__price b {
    font-size: clamp(2.6rem, 4.5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .prod__price small {
    flex-basis: 100%;
    font-size: var(--sp-text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .prod__price span,
  .bundle__price span {
    font-size: var(--sp-text-sm);
    color: var(--sp-muted);
  }

  .prod__points {
    display: grid;
    gap: 0.6rem;
    margin: 0.35rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--sp-line);
    list-style: none;
    font-size: var(--sp-text-md);
  }

  .prod__points li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
  }

  .prod__points li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sp-red);
    transform: translateY(-0.1rem);
  }

  .prod__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  /* The bundle: one quiet row, tinted, under the two $49 products. */
  .bundle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding: 1.4rem clamp(1.5rem, 3vw, 2.1rem);
    background: linear-gradient(120deg, var(--sp-surface), var(--sp-surface-2));
    border-color: var(--sp-red-soft);
  }

  .bundle__copy {
    display: grid;
    gap: 0.35rem;
    flex: 1 1 14rem;
  }

  .bundle__name {
    margin: 0;
    font-size: var(--sp-text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .bundle__price {
    margin: 0;
  }

  .bundle__price b {
    font-size: clamp(2.1rem, 3.5vw, 2.6rem);
  }

  /* The flagship: graphite in both themes, with a faint red glow. */
  .prod--custom {
    --primary-link-default-text-color: var(--sp-band-ink);
    position: relative;
    overflow: hidden;
    border-color: var(--sp-band-line);
    background:
      radial-gradient(90% 60% at 100% 0%, var(--sp-red-soft), transparent 70%),
      linear-gradient(160deg, var(--sp-lcard-1), var(--sp-band) 55%);
    box-shadow: var(--sp-lcard-shadow);
    color: var(--sp-band-ink);
  }

  .prod--custom .prod__name {
    color: var(--sp-band-ink);
  }

  .prod--custom .prod__kicker {
    color: var(--sp-band-muted);
  }

  .prod--custom .prod__pitch,
  .prod--custom .prod__price span,
  .prod--custom .prod__live {
    color: var(--sp-band-muted);
  }

  .prod--custom .prod__points {
    border-top-color: var(--sp-band-line);
  }

  .prod__ball {
    width: 2.1rem;
    height: 1.4rem;
    flex: none;
  }

  .prod__ball path {
    fill: var(--sp-red);
    stroke: var(--sp-red);
  }

  .prod__live {
    margin: 0;
    font-size: var(--sp-text-sm);
  }

  @media (max-width: 1000px) {
    .lineup {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'history reporter'
        'bundle bundle'
        'custom custom';
    }
  }

  @media (max-width: 700px) {
    .lineup {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'history'
        'reporter'
        'bundle'
        'custom';
    }

    .intro__br {
      display: none;
    }

    .bundle {
      flex-direction: column;
      align-items: flex-start;
    }

    .bundle__copy {
      flex: none;
    }
  }
</style>
