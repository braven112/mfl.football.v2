---
/**
 * NFL Brand Book — the shared host's copy, at the ROOT.
 *
 * `mfl.football` is deliberately not a second front door for a league that has
 * its own apex: `resolveSharedHostHiddenLeague` 404s /theleague/* and
 * /afl-fantasy/* there, because a league reachable at two addresses is two sets
 * of links and two places to stay signed in. So the shared host cannot link
 * into a league's brand page — it needs its own route, and a root path is the
 * honest one, since NFL club marks belong to no league.
 *
 * This route also answers on each league apex, where the middleware rewrites
 * /brand → /<slug>/brand before it can reach here — so a TheLeague owner still
 * gets the league copy (with its roster panel) at theleague.us/brand.
 */
import BrandPage from '../components/shared/brand/BrandPage.astro';

export const prerender = false;
---

<BrandPage />
