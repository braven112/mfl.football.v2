---
/**
 * Custom Rankings (The League) — thin route wrapper.
 * Shared implementation lives in components/shared/custom-rankings/CustomRankingsPage.
 *
 * The auth gate is HERE, not in the shared component: Astro.redirect() only
 * redirects from a page. See src/utils/custom-rankings-access.ts.
 */
import CustomRankingsPage from '../../components/shared/custom-rankings/CustomRankingsPage.astro';
import { resolveCustomRankingsAccess } from '../../utils/custom-rankings-access';

export const prerender = false;

const access = resolveCustomRankingsAccess(Astro.request, Astro.url);
if (!access) {
  return Astro.redirect('/theleague');
}
---

<CustomRankingsPage title="My Draft List | The League" user={access.user} />
