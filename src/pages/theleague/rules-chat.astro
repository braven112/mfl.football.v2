---
/**
 * Ask Roger — TheLeague. Thin route over the shared page
 * (src/components/shared/rules-chat/RulesChatPage.astro): the league's seed
 * cards, team icons and endpoint stay here because a static import can't be
 * a runtime variable.
 */
export const prerender = false;

import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import RulesChatPage from '../../components/shared/rules-chat/RulesChatPage.astro';
import { getAuthUser, isCommissionerOrAdmin } from '../../utils/auth';
import { LEAGUES } from '../../config/leagues-data.mjs';
import seedData from '../../data/rules-qa-seeds.json';
import config from '../../data/theleague.config.json';
import type { RulesQA } from '../../types/rules-qa';

const authUser = getAuthUser(Astro.request);
const teamIcons = config.teams.map((t: { franchiseId: string; icon: string }) => ({
  franchiseId: t.franchiseId,
  icon: t.icon,
}));
---

<TheLeagueLayout title="Ask Roger">
  <RulesChatPage
    league={LEAGUES.theleague}
    seedData={seedData as RulesQA[]}
    isAuthenticated={!!authUser}
    isAdmin={authUser ? isCommissionerOrAdmin(authUser) : false}
    teamIcons={teamIcons}
    apiEndpoint="/api/rules-qa"
    rulesHref="/theleague/rules"
    rulebookName="the constitution"
    bio="He's read the constitution cover to cover — all 27 sections, every footnote, and the fine print about compensatory picks that even the Commissioner forgot about."
    showSupport
  />
</TheLeagueLayout>
