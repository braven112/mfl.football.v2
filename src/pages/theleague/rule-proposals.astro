---
/**
 * Rule Proposals (theleague) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/rule-proposals/RuleProposalsPage.
 * The auth gate lives HERE, not in the component: 
 * Astro.redirect() only redirects from a PAGE. Per-league static data imports
 * also belong here — a static import specifier can't be a runtime variable.
 */
import RuleProposalsPage from '../../components/shared/rule-proposals/RuleProposalsPage.astro';
import type { RuleProposal } from '../../components/shared/rule-proposals/RuleProposalsPage.astro';
import { getAuthUser, isAuthorizedForLeague } from '../../utils/auth';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;
const LEAGUE = getLeagueBySlug('theleague')!;

const user = getAuthUser(Astro.request);
if (!user || !isAuthorizedForLeague(user, LEAGUE.id)) {
  return Astro.redirect('/theleague');
}

const proposals: RuleProposal[] = [
  {
    id: 'draft-pick-tiers',
    title: 'Draft Pick Tiers',
    season: '2027 season',
    status: 'Open for discussion',
    summary:
      'The top 7 still make the playoffs. The 9 teams that miss them split into three tiers and play for comp picks in Weeks 15 to 17, with the best pick going to the worst tier.',
    changes: [
      'Seeds 8-10, 11-13 and 14-16 each form a tier. Every team plays both tier-mates every week, so six games each.',
      'Bottom tier plays for 1.17, 2.19 and 3.18. Middle tier plays for 2.17 and 3.17. Top tier plays for 2.18.',
      'Tier ties go to total points, then to the worse regular-season seed.',
      'Comp picks go from 3 a year to 6.',
      'The 5th-place bracket becomes the three Week 15 playoff losers, with a Week 16 bye for the best seed.',
    ],
    replaces: 'the Play-in Game and the Toilet Bowl Challenge',
    href: 'https://claude.ai/artifact/X4q6gzN6TyGCtKPxP3HXTP',
    linkLabel: 'Read the full proposal',
  },
];
---

<RuleProposalsPage leagueSlug="theleague" proposals={proposals} />
