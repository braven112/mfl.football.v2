---
/**
 * Owner Activity (TheLeague) — thin route wrapper.
 *
 * The page is components/shared/OwnerActivityPage; the gate and the feed
 * listings stay here (Astro.rewrite only works from a page). The feeds are
 * read through the league-data loader, lazily — only the seasons the page
 * opens are fetched (src/utils/league-data.ts). Private by default:
 * src/utils/owner-activity-access.ts.
 */
import OwnerActivityPage from '../../components/shared/OwnerActivityPage.astro';
import { getAuthUser } from '../../utils/auth';
import { resolveOwnerActivityAccess } from '../../utils/owner-activity-access';
import { loginUrlForRequest, forbiddenPathFor } from '../../utils/login-redirect';
import { getLeagueBySlug } from '../../config/leagues';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';

export const prerender = false;

const league = getLeagueBySlug('theleague')!;
const access = await resolveOwnerActivityAccess(getAuthUser(Astro.request), league);
if (access.kind === 'login') return Astro.redirect(loginUrlForRequest(Astro, league));
if (access.kind === 'forbidden') return Astro.rewrite(forbiddenPathFor(league, 'admin'));

// Lazy `{ path: () => data }` maps, the shape the old lazy globs had.
const lazyFeeds = (pattern: string) =>
  Object.fromEntries(listLeagueData(pattern).map((path) => [path, () => loadLeagueData(path)]));
const transactionFeeds = lazyFeeds(`${league.dataPath}/mfl-feeds/*/transactions.json`);
const lastVisitFiles = lazyFeeds(`${league.dataPath}/owner-last-visit.json`);
---

<OwnerActivityPage
	leagueSlug={league.slug}
	transactionFeeds={transactionFeeds}
	lastVisitFiles={lastVisitFiles}
	canManage={access.canManage}
/>
