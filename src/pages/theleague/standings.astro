---
/**
 * Standings (TheLeague) — thin route over the shared standings page.
 *
 * Kept in the route: the globs (a static import specifier cannot be a runtime
 * variable), the bad-year redirect (a component cannot redirect) and the
 * preferred-team cookie write (a component cannot set a cookie).
 */
import StandingsPage from '../../components/shared/standings/StandingsPage.astro';
import { DIVISION_BADGES } from '../../components/theleague/standings/standings-table-config';
import leagueConfig from '../../data/theleague.config.json';
import { getAuthUser, franchiseIdForLeague } from '../../utils/auth';
import {
  getTheLeaguePreference,
  setTheLeaguePreference,
  resolveTeamSelection,
} from '../../utils/team-preferences';
import { resolveConfigForYear, resolvePreferredTeamIdForYear, type TeamConfig } from '../../utils/team-names';
import { applyHistoricalDivisions } from '../../utils/historical-divisions';
import { getLeagueBySlug } from '../../config/leagues';
import { loadSeasonFeed } from '../../utils/mfl-feed-glob';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../../utils/league-year';
import { resolveThrowbackRequestState } from '../../utils/throwback-request-state';
import { applyThrowbackToStandingsConfig } from '../../utils/throwback-standings';
import {
  chooseStandingsSeason,
  loadDefendingChampions,
  loadStandingsSeason,
  parseStandingsView,
  type StandingsConfig,
} from '../../utils/standings-page';

const league = getLeagueBySlug('theleague')!;
const standingsFeeds = import.meta.glob('../../../data/theleague/mfl-feeds/*/standings.json');
const fetchMetaFeeds = import.meta.glob('../../../data/theleague/mfl-feeds/*/fetch.meta.json');
// Per-season division alignment. The league realigned repeatedly (2007-2010 ran
// Pacific/Midwest/Central/Atlantic), so grouping an archived year by today's
// map put the wrong teams together — see utils/historical-divisions.ts.
const leagueFeeds = import.meta.glob('../../../data/theleague/mfl-feeds/*/league.json');

// The default year follows ?testDate= — the same clock the throwback gate below
// reads — so /rollover-check can drive this page by date alone.
const testDate = getTestDateFromSearchParams(Astro.url.searchParams);
const currentSeasonYear = getCurrentSeasonYear(testDate ?? undefined);
// A fallback redirect keeps the test clock, or the preview lands on the real year.
const testDateQuery = testDate
  ? `&testDate=${encodeURIComponent(Astro.url.searchParams.get('testDate')!)}`
  : '';

const season = chooseStandingsSeason(standingsFeeds, Astro.url.searchParams.get('year'), currentSeasonYear);
if (!season.valid) {
  return Astro.redirect(`/theleague/standings?year=${season.defaultYear}${testDateQuery}`);
}
const { selectedYear } = season;

const { franchises, lastFetched } = await loadStandingsSeason({
  league,
  year: selectedYear,
  standingsFeeds,
  fetchMetaFeeds,
});
if (!franchises) {
  return Astro.redirect(`/theleague/standings?year=${season.defaultYear}${testDateQuery}`);
}

// Identities for the season (resolveConfigForYear), then that season's own
// division alignment — resolveConfigForYear does NOT resolve division.
// The JSON's inferred team type is wider than either helper's, so it is
// declared once here as what it is: a standings config whose teams carry eras.
const baseConfig = leagueConfig as unknown as StandingsConfig & { teams: TeamConfig[] };
const configForYear = async (year: number): Promise<StandingsConfig> =>
  applyHistoricalDivisions(resolveConfigForYear(baseConfig, year), await loadSeasonFeed(leagueFeeds, year));

// Preferred team. No `defaultTeam`: a visitor with no choice and no session
// highlights NOBODY, and the resolver answers undefined for that.
const myTeamParam = Astro.url.searchParams.get('myteam');
if (myTeamParam) {
  setTheLeaguePreference(Astro.cookies, myTeamParam);
}
const preferredTeamId = resolveTeamSelection({
  myTeamParam,
  franchiseParam: Astro.url.searchParams.get('franchise'),
  cookiePreference: getTheLeaguePreference(Astro.cookies)?.franchiseId,
  authUserFranchise: franchiseIdForLeague(getAuthUser(Astro.request), league.id),
});

// DEFENDING champions — last season's division winners, keyed by the division
// they won under last season's own alignment, in the identity they wore then.
const defendingChampions = await loadDefendingChampions({
  standingsFeeds,
  previousYear: selectedYear - 1,
  previousConfig: await configForYear(selectedYear - 1),
  currentTeams: leagueConfig.teams,
});

// Throwback Week: the current season's rows wear each club's era art, with
// today's name printed underneath (see utils/throwback-standings.ts).
const { config: seasonConfig, todayNames: throwbackTodayNames } = applyThrowbackToStandingsConfig(
  'theleague',
  await configForYear(selectedYear),
  await resolveThrowbackRequestState('theleague', Astro.url),
  // Same clock the week gate uses, so a ?testDate= preview agrees with itself.
  { isCurrentSeason: selectedYear === currentSeasonYear },
);
---

<StandingsPage
  leagueSlug={league.slug}
  title="Standings"
  franchises={franchises}
  config={seasonConfig}
  selectedYear={selectedYear}
  availableYears={season.availableYears}
  view={parseStandingsView(Astro.url.searchParams.get('view'))}
  preferredTeamId={resolvePreferredTeamIdForYear(baseConfig, preferredTeamId, selectedYear)}
  lastFetched={lastFetched}
  defendingChampions={defendingChampions}
  divisionBadges={DIVISION_BADGES}
  throwbackTodayNames={throwbackTodayNames}
/>
