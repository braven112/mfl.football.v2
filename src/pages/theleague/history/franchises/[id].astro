---
/**
 * League History franchise page (The League) — thin route wrapper.
 *
 * Shared implementation: components/shared/league-history/HistoryFranchisePage.
 * The dataset is imported HERE because a static import specifier can't be a
 * runtime variable, and the gate and the unknown-franchise rewrite live here
 * because `Astro.redirect()` only redirects from a page. Admin-only until
 * League History launches (utils/league-history/access.ts).
 */
import HistoryFranchisePage from '../../../../components/shared/league-history/HistoryFranchisePage.astro';
import historyData from '../../../../../data/theleague/derived/league-history.json';
import { getAuthUser } from '../../../../utils/auth';
import { mflLoginUrl } from '../../../../utils/mfl-login-redirect';
import { canViewLeagueHistory } from '../../../../utils/league-history/access';
import { franchiseList } from '../../../../utils/league-history/franchise.mjs';

export const prerender = false;

const authUser = getAuthUser(Astro.request);
if (!canViewLeagueHistory(authUser)) {
  if (!authUser) return Astro.redirect(mflLoginUrl(Astro.url.pathname));
  return Astro.rewrite('/_not-found');
}
const id = Astro.params.id ?? '';
if (!(franchiseList(historyData) as Array<{ franchiseId: string }>).some((f) => f.franchiseId === id)) {
  return Astro.rewrite('/_not-found');
}
---

<HistoryFranchisePage leagueSlug="theleague" data={historyData} franchiseId={id} rivalriesPage franchisePage />
