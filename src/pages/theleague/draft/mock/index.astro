---
/**
 * Mock Draft lobby (The League) — thin route wrapper.
 *
 * Shared render lives in components/shared/draft-mock/DraftMockLobby. See the
 * AFL twin for the whole difference: it drafts by conference, from the pool
 * its keepers left behind, and only inside a window.
 */
import DraftMockLobby from '../../../../components/shared/draft-mock/DraftMockLobby.astro';
import leagueConfigData from '../../../../data/theleague.config.json';
import { getAuthUser, isAuthorizedForLeague, isCommissionerOrAdmin } from '../../../../utils/auth';
import { getCurrentLeagueYear } from '../../../../utils/league-year';
import { DEFAULT_LEAGUE_ID, getLeagueBySlug } from '../../../../config/leagues';

export const prerender = false;

const user = getAuthUser(Astro.request);
const leagueYear = getCurrentLeagueYear();
const leagueId = user?.leagueId || DEFAULT_LEAGUE_ID;

// The AFL half of this got the same treatment: a signed-in owner of the OTHER
// league must not be offered a create form that can only fail, nor a session
// list scoped to their own league rendered under this one's chrome. The create
// endpoint keys off the SESSION's league, not the page's.
const ownsHere = !!user && isAuthorizedForLeague(user, getLeagueBySlug('theleague')!.id);
const gate = user && !ownsHere
  ? {
      heading: 'You don\u2019t have a team in The League',
      body: 'A mock puts you in a chair, so it needs a franchise to put you in. The rest of the draft section is open to you \u2014 the board, the order, and every draft the league has held.',
    }
  : null;

// Source catalog — keep in sync with MockRankingSource in src/types/draft-room.ts
const rankingSources = [
  { value: 'mfl-rookie', label: 'MFL Rookie ADP' },
  { value: 'mfl-dynasty', label: 'MFL Dynasty ADP' },
  { value: 'sleeper', label: 'Sleeper' },
  { value: 'ktc', label: 'KeepTradeCut' },
  { value: 'my-rank', label: 'My Rank' },
  { value: 'random', label: 'Chaos (random)' },
];
---

<DraftMockLobby
  leagueSlug="theleague"
  title="Mock Draft | The League"
  heading="Mock Draft"
  subtitle={`Practice your ${leagueYear} rookie draft strategy before the real thing.`}
  basePath="/theleague/draft/mock"
  loginPath="/theleague/login"
  signedIn={!!user}
  userFranchiseId={user?.franchiseId}
  isAdmin={user ? isCommissionerOrAdmin(user) : false}
  leagueId={leagueId}
  leagueYear={leagueYear}
  franchises={(leagueConfigData.teams ?? []).map((t: any) => ({
    franchiseId: t.franchiseId,
    name: t.nameMedium || t.name,
    icon: t.icon || '',
  }))}
  rankingSources={rankingSources}
  defaultRankingSource="mfl-rookie"
  roundOptions={[1, 2, 3]}
  rounds={3}
  queueScope={leagueId}
  gate={gate}
  showSessions={ownsHere}
/>
