---
/**
 * Mock Draft results (The League) — thin route wrapper.
 */
import DraftMockResultsPage from '../../../../../components/shared/draft-mock/DraftMockResultsPage.astro';
import leagueConfigData from '../../../../../data/theleague.config.json';
import { getAuthUser } from '../../../../../utils/auth';
import { fetchMockSession } from '../../../../../utils/mock-draft-session';

export const prerender = false;

const { sessionId } = Astro.params;
if (!sessionId) return Astro.redirect('/theleague/draft/mock');
if (!getAuthUser(Astro.request)) return Astro.redirect('/theleague/login');

// Fetched HERE, not in the shared component: a missing session has to bounce,
// and Astro.redirect() from a component only blanks the body. See CLAUDE.md.
const session = await fetchMockSession(import.meta.env.PUBLIC_PARTYKIT_HOST, sessionId);
if (!session) return Astro.redirect('/theleague/draft/mock');
---

<DraftMockResultsPage
  leagueSlug="theleague"
  session={session}
  title="Mock Draft Results | The League"
  basePath="/theleague/draft/mock"
  teams={(leagueConfigData.teams ?? []).map((t: any) => ({
    franchiseId: t.franchiseId,
    name: t.name,
    nameMedium: t.nameMedium || t.name,
    nameShort: t.nameShort || t.name,
    icon: t.icon || '',
  }))}
/>
