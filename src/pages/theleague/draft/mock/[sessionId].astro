---
/**
 * Mock Draft room (The League) — thin route wrapper.
 *
 * Rookies only, which is what `rookieOnly` buys: the payload drops from the
 * full ~229 KB pool to ~15 KB. RSP scouting is licensed content, enriched only
 * for the viewer who holds the licence.
 */
import DraftMockSessionPage from '../../../../components/shared/draft-mock/DraftMockSessionPage.astro';
import leagueConfigData from '../../../../data/theleague.config.json';
import { getCurrentLeagueYear } from '../../../../utils/league-year';
import { getTheLeaguePreference, resolveTeamSelection } from '../../../../utils/team-preferences';
import { getAuthUser } from '../../../../utils/auth';
import { buildDraftPlayers } from '../../../../utils/build-draft-players';
import { getFranchiseBrand } from '../../../../utils/franchise-brand';
import type { DraftRoomPageData, DraftRoomTeam } from '../../../../types/draft-room';
import { DEFAULT_LEAGUE_ID } from '../../../../config/leagues';

export const prerender = false;

const { sessionId } = Astro.params;
if (!sessionId) return Astro.redirect('/theleague/draft/mock');

const user = getAuthUser(Astro.request);
if (!user) return Astro.redirect('/theleague/login');

const leagueYear = getCurrentLeagueYear();

// Brand colors drive the pick-reveal splash — rookies rarely have an NFL team
// at draft time, so the drafting franchise tints the moment.
const teams: DraftRoomTeam[] = (leagueConfigData.teams ?? []).map((team: any) => {
  const brand = getFranchiseBrand(team.franchiseId);
  return {
    franchiseId: team.franchiseId,
    name: team.name,
    nameMedium: team.nameMedium || team.name,
    nameShort: team.nameShort || team.name,
    abbrev: team.abbrev || '',
    icon: team.icon || '',
    colorPrimary: brand.colorPrimary,
    colorSecondary: brand.colorSecondary,
  };
});

// Picks start empty — PartyKit session sync populates them.
const pageData: DraftRoomPageData = {
  leagueYear,
  draftKind: 'live',
  draftLimitHours: '',
  draftTimerSusp: '',
  totalRounds: 3,
  picksPerRound: teams.length,
  teams,
  picks: [],
  players: buildDraftPlayers(leagueYear, { rookieOnly: true, viewerFranchiseId: user.franchiseId }),
  partyHost: import.meta.env.PUBLIC_PARTYKIT_HOST || '',
  leagueId: user.leagueId || DEFAULT_LEAGUE_ID,
};
---

<DraftMockSessionPage
  leagueSlug="theleague"
  title="Mock Draft Room | The League"
  sessionId={sessionId}
  pageData={pageData}
  userTeamId={resolveTeamSelection({
    myTeamParam: Astro.url.searchParams.get('myteam'),
    authUserFranchise: user?.franchiseId,
    cookiePreference: getTheLeaguePreference(Astro.cookies, 'myteam'),
  })}
  basePath="/theleague/draft/mock"
  draftContext="rookie"
/>
