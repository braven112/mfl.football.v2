---
/**
 * Draft Room (The League) — thin route wrapper.
 *
 * Shared render lives in components/shared/draft-room/DraftRoomPage; the
 * assembly lives in utils/draft-room-data#buildDraftRoomData. The globs are
 * HERE because a static import specifier can't be a runtime variable.
 *
 * TheLeague drafts as ONE unit, so no `unit` is passed and no conference
 * switcher renders — see the AFL twin, where that is the whole difference.
 */
import DraftRoomPage from '../../../components/shared/draft-room/DraftRoomPage.astro';
import leagueConfigData from '../../../data/theleague.config.json';
import { getCurrentLeagueYear } from '../../../utils/league-year';
import { getTheLeaguePreference, resolveTeamSelection } from '../../../utils/team-preferences';
import { getAuthUser } from '../../../utils/auth';
import { buildDraftPlayers } from '../../../utils/build-draft-players';
import { getFranchiseBrand } from '../../../utils/franchise-brand';
import { getLeagueBySlug } from '../../../config/leagues';
import { buildDraftRoomData, mflBaseUrlFor } from '../../../utils/draft-room-data';
import type { DraftRoomTeam } from '../../../types/draft-room';

export const prerender = false;

const league = getLeagueBySlug('theleague')!;
const leagueYear = getCurrentLeagueYear();
const user = getAuthUser(Astro.request);

const draftResultsFeeds = import.meta.glob('../../../../data/theleague/mfl-feeds/*/draftResults.json', { eager: true });
const leagueFeeds = import.meta.glob('../../../../data/theleague/mfl-feeds/*/league.json', { eager: true });

// Brand colors drive the pick-reveal splash — rookies rarely have an NFL team
// at draft time, so the drafting franchise tints the moment.
const teams: DraftRoomTeam[] = (leagueConfigData.teams ?? []).map((team: any) => {
  const brand = getFranchiseBrand(team.franchiseId);
  return {
    franchiseId: team.franchiseId,
    name: team.name,
    nameMedium: team.nameMedium || team.name,
    nameShort: team.nameShort || team.name,
    abbrev: team.abbrev || '',
    icon: team.icon || '',
    colorPrimary: brand.colorPrimary,
    colorSecondary: brand.colorSecondary,
  };
});

const pageData = buildDraftRoomData({
  leagueYear,
  draftResultsFeeds,
  leagueFeeds,
  teams,
  // The full draftable pool, not just rookies: late-round veterans added via
  // waiver are draftable. RSP scouting is licensed, so it is only enriched
  // for a viewer who owns it.
  players: buildDraftPlayers(leagueYear, { viewerFranchiseId: user?.franchiseId }),
  leagueId: league.id,
  partyHost: import.meta.env.PUBLIC_PARTYKIT_HOST || '',
  mflPickUrl: `${mflBaseUrlFor(leagueFeeds, leagueYear, league.mflHost)}/${leagueYear}/options?L=${league.id}&O=17`,
});
---

<DraftRoomPage
  leagueSlug="theleague"
  title="Draft Room | The League"
  pageData={pageData}
  userTeamId={resolveTeamSelection({
    myTeamParam: Astro.url.searchParams.get('myteam'),
    authUserFranchise: user?.franchiseId,
    cookiePreference: getTheLeaguePreference(Astro.cookies, 'myteam'),
  })}
  basePath="/theleague/draft/room"
/>
