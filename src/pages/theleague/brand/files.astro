---
/**
 * The retired Brand Files library (theleague). Everything it listed now lives
 * on a Brand Book page (owner's call, Oct 2026) — club files on the club's
 * page, league, conference and division art on their own pages, retired clubs
 * on the archive — so the old address forwards to the Brand Book index, whose
 * search finds any file by name. Asset URLs themselves never moved.
 *
 * 302, not 301: a permanent redirect is cached indefinitely and cannot be
 * taken back without minting a new URL (same rule as /assets).
 */
import { resolveLeaguePath } from '../../../utils/nav-utils';

export const prerender = false;

return Astro.redirect(resolveLeaguePath('/theleague/brand', Astro.locals.hideLeaguePrefix ?? false), 302);
---
