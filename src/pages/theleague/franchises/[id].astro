---
/**
 * TheLeague franchise page — thin route wrapper.
 *
 * The page is the shared League History franchise page
 * (components/shared/league-history/HistoryFranchisePage), which replaced
 * TheLeague's own page (Brandon, 2026-10-25). TheLeague's sections — award
 * chips, the roster and Brand Book links, the awards honor roll, trade ledger,
 * draft and auction history, badges, eras and previous owners — come in
 * through its slots from theleague/franchises/TheLeagueFranchiseExtras, and
 * the owner map's hometown card (shared/owner-map/FranchiseHometown) into
 * `after-stats`.
 * The dataset import and the unknown-franchise redirect stay here: a static
 * import specifier can't be a runtime variable, and `Astro.redirect()` only
 * redirects from a page.
 */
import HistoryFranchisePage from '../../../components/shared/league-history/HistoryFranchisePage.astro';
import TheLeagueFranchiseExtras from '../../../components/theleague/franchises/TheLeagueFranchiseExtras.astro';
import FranchiseHometown from '../../../components/shared/owner-map/FranchiseHometown.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { franchiseList } from '../../../utils/league-history/franchise.mjs';
import { loadLeagueData } from '../../../utils/league-data';
import { getLeagueBySlug } from '../../../config/leagues';

// Read through the league-data loader, never bundled into the function
// (src/utils/league-data.ts).
const THELEAGUE_DATA = getLeagueBySlug('theleague')!.dataPath;
const [historyData, franchiseHistory] = (await Promise.all([
  loadLeagueData(`${THELEAGUE_DATA}/derived/league-history.json`),
  loadLeagueData(`${THELEAGUE_DATA}/derived/franchise-history.json`),
])) as [any, any];

export const prerender = false;

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const id = Astro.params.id ?? '';
if (!(franchiseList(historyData) as Array<{ franchiseId: string }>).some((f) => f.franchiseId === id)) {
  return Astro.redirect(resolveLeaguePath('/theleague/franchises', hideLeaguePrefix));
}
// The hometown card names the team as TheLeague's own record does.
const fr: any = (franchiseHistory.franchises as any)[id] ?? null;
---

<HistoryFranchisePage leagueSlug="theleague" data={historyData} franchiseId={id} rivalriesPage>
  <TheLeagueFranchiseExtras slot="hero-extra" part="hero" franchiseId={id} />
  {fr && (
    <FranchiseHometown
      slot="after-stats"
      leagueSlug="theleague"
      franchiseId={id}
      teamName={fr.currentNameMedium || fr.currentName}
      icon={fr.currentIcon}
      division={fr.currentDivision ?? null}
    />
  )}
  <TheLeagueFranchiseExtras part="sections" franchiseId={id} />
</HistoryFranchisePage>
