---
/**
 * Free Agents Page - Player research tool focused on available players
 *
 * Displays free agents (and optionally rostered players) with sorting by:
 * - Projected Points, Age, Name
 *
 * Data is loaded at build time from MFL feed JSON files.
 */
import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import CollegeLogoDarkStyles from '../../components/CollegeLogoDarkStyles.astro';
import PlayerDetailsModal from '../../components/theleague/PlayerDetailsModal.astro';
import { resolveLeaguePath } from '../../utils/nav-utils';
import { NFL_LOGO_ONERROR, NFL_LOGO_ONLOAD, COLLEGE_LOGO_ONERROR, COLLEGE_LOGO_ONLOAD, positionOrder } from '../../constants/roster-constants';
import { getCurrentLeagueYear, getCurrentSeasonYear, getTestDateFromSearchParams } from '../../utils/league-year';
import { getPlayerMap } from '../../utils/player-map';
import { getNthDayOfMonth } from '../../utils/league-event-resolver';
import { buildWeeklyPlayerResults } from '../../utils/weekly-player-results';
import { getFrozenSalaryAveragesYear } from '../../utils/salary-calculations';
import { calculateAllSurplusValues } from '../../utils/surplus-value';
import { getAuthUser, isCommissionerOrAdmin } from '../../utils/auth';
import '../../styles/player-cell.css';
import '../../styles/ranking-columns.css';
import collegeLogos from '../../data/college-logos.json';
import espnCollegeIds from '../../../data/theleague/espn-college-ids.json';
import leagueConfig from '../../data/theleague.config.json';
import { getLeagueBySlug } from '../../config/leagues';
import { getPlayerAvatarBackground, getPlayerAvatarBorder, getPlayerAvatarRing, getPlayerAvatarRingDark, getPlayerAvatarStyleMaps } from '../../utils/nfl-team-colors';
import { isDraftComplete } from '../../utils/draft-utils';
import { DEF_SPOTLIGHT_PLAYERS, getDefSpotlightPlayer } from '../../data/theleague/def-spotlight-players';
import MyRankEditor from '../../components/shared/rankings/MyRankEditor.astro';

// Build franchise ID → short name map for auction high-bidder display
const franchiseNameEntries: [string, string][] = ((leagueConfig as any).teams ?? []).map((t: any) => [
  t.franchiseId,
  t.nameShort || t.nameMedium || t.name || t.franchiseId,
]);
const franchiseNamesJson = JSON.stringify(franchiseNameEntries);

// Build franchise ID → banner URL map for auction bidder column
const franchiseBannerEntries: [string, string][] = ((leagueConfig as any).teams ?? [])
  .filter((t: any) => t.banner)
  .map((t: any) => [t.franchiseId, t.banner]);
const franchiseBannersJson = JSON.stringify(franchiseBannerEntries);

// College logo lookup (case-insensitive)
const collegeLogosNormalized = Object.fromEntries(
  Object.entries(collegeLogos ?? {}).map(([name, data]) => [name.toLowerCase(), data])
);
function getCollegeLogo(collegeName: string | null): string | null {
  if (!collegeName) return null;
  const entry = collegeLogosNormalized[collegeName.toLowerCase()];
  return (entry as any)?.logo ?? null;
}

// MFL team code → local SVG filename normalization
const MFL_TEAM_CODE_MAP: Record<string, string> = {
  GBP: 'GB', KCC: 'KC', NEP: 'NE', NOS: 'NO',
  SFO: 'SF', TBB: 'TB', LVR: 'LV', HST: 'HOU',
  BLT: 'BAL', CLV: 'CLE', ARZ: 'ARI', JAC: 'JAX',
};
function normalizeMflTeam(code: string): string {
  if (!code) return 'FA';
  return MFL_TEAM_CODE_MAP[code] || code;
}

// Load player data
const currentYear = getCurrentLeagueYear();

// MFL host/id from the league registry — never hardcode these (CLAUDE.md).
// Used to build the per-player "Bid" and generic "Add" deep-links on each row.
// 'theleague' is a static registry entry, so a miss is a programming error —
// fail fast rather than silently falling back to a hardcoded league.
const theLeagueDef = getLeagueBySlug('theleague');
if (!theLeagueDef) throw new Error('League registry is missing the "theleague" entry');
const mflHost = theLeagueDef.mflHost;
const mflLeagueId = theLeagueDef.id;
// Year-filtered (2025+): this page reads only currentLeagueYear +
// currentSeasonYear; the bare glob baked ~22 MB of historical players.json
// into the server chunk. tests/current-era-feed-globs.test.ts guards it.
const playerModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/20{2[5-9],[3-9][0-9]}/players.json',
  { eager: true }
);
const projectedScoresModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/projectedScores.json',
  { eager: true }
);
const rostersModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/rosters.json',
  { eager: true }
);

const adpDynastyModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/adp-dynasty.json',
  { eager: true }
);
const adpRedraftModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/adp-redraft.json',
  { eager: true }
);
const lastYearWeeklyModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/20{2[5-9],[3-9][0-9]}/weekly-results-raw.json',
  { eager: true }
);
const snapCountModules = import.meta.glob(
  '../../../data/theleague/nfl-cache/snap-counts-*.json',
  { eager: true }
);
const nflScheduleModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/nflSchedule.json',
  { eager: true }
);
const fpaModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/fantasyPointsAllowed.json',
  { eager: true }
);
const leagueModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/league.json',
  { eager: true }
);
const auctionResultsModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/auctionResults.json',
  { eager: true }
);
const draftResultsModules = import.meta.glob(
  '../../../data/theleague/mfl-feeds/*/draftResults.json',
  { eager: true }
);
const salaryAvgModules = import.meta.glob(
  '../../data/mfl-salary-averages-*.json',
  { eager: true }
);
const playerSalaryHistoryModules = import.meta.glob(
  '../../data/mfl-player-salaries-*.json',
  { eager: true }
);

const getModuleData = (mod: any) =>
  mod && typeof mod === 'object' && 'default' in mod ? mod.default : mod;

const findForYear = (modules: Record<string, any>, yr: number) => {
  const key = Object.keys(modules).find(k => k.includes(`/${yr}/`));
  return key ? getModuleData(modules[key]) : null;
};

const playersData = findForYear(playerModules, currentYear);
const projectedScoresData = findForYear(projectedScoresModules, currentYear);
const rostersData = findForYear(rostersModules, currentYear);

// Rookies enter TheLeague only through the rookie draft, so before it wraps
// the class is noise on a free-agent page and the "Include rookies" filter
// defaults off. Once this league year's draft is COMPLETE (every pick slot
// carries a real selection — not merely started, it's a multi-day slow
// draft), the undrafted leftovers are genuinely available players and the
// filter flips to default-on. findForYear matches the exact league year only:
// post-Feb-14, before the new year's feed exists, this falls back to false
// (hidden) rather than reading last year's completed draft.
const draftResultsData = findForYear(draftResultsModules, currentYear);
const rookieDraftComplete = isDraftComplete(draftResultsData);

// ADP data — current year only (blank until MFL has data)
function buildAdpMap(modules: Record<string, any>): Map<string, number> {
  const data = findForYear(modules, currentYear);
  const map = new Map<string, number>();
  if (data?.adp?.player) {
    const players = Array.isArray(data.adp.player) ? data.adp.player : [data.adp.player];
    for (const p of players) {
      if (p?.id && p?.averagePick) {
        const pick = parseFloat(p.averagePick);
        if (pick > 0) map.set(p.id, pick);
      }
    }
  }
  return map;
}
const adpDynMap = buildAdpMap(adpDynastyModules);
const adpRdfMap = buildAdpMap(adpRedraftModules);

// Last year total points + games played (from weekly results)
const lastSeasonYear = getCurrentSeasonYear();
const lastYearData = findForYear(lastYearWeeklyModules, lastSeasonYear);
const lastYrPtsMap = new Map<string, number>();
const lastYrGamesMap = new Map<string, number>();
if (Array.isArray(lastYearData)) {
  for (const weekPayload of lastYearData) {
    const matchups = weekPayload?.weeklyResults?.matchup;
    if (!matchups) continue;
    const matchupArr = Array.isArray(matchups) ? matchups : [matchups];
    for (const m of matchupArr) {
      const franchises = m?.franchise ? (Array.isArray(m.franchise) ? m.franchise : [m.franchise]) : [];
      for (const f of franchises) {
        const players = f?.player ? (Array.isArray(f.player) ? f.player : [f.player]) : [];
        for (const p of players) {
          if (!p?.id || !p?.score) continue;
          const score = parseFloat(p.score);
          if (!isNaN(score) && score > 0) {
            lastYrPtsMap.set(p.id, (lastYrPtsMap.get(p.id) || 0) + score);
            lastYrGamesMap.set(p.id, (lastYrGamesMap.get(p.id) || 0) + 1);
          }
        }
      }
    }
  }
}

// Build weekly player results for the modal's Season Results table
const nflScheduleData = findForYear(nflScheduleModules, lastSeasonYear);
const fpaData = findForYear(fpaModules, lastSeasonYear);
const leagueData = findForYear(leagueModules, lastSeasonYear);
const playersDataForSeason = findForYear(playerModules, lastSeasonYear) || playersData;
const weeklyPlayerResults = (nflScheduleData && Array.isArray(lastYearData))
  ? buildWeeklyPlayerResults(lastYearData, nflScheduleData, fpaData, playersDataForSeason, leagueData)
  : {};

// Build snap count lookup (keyed by MFL player ID)
const snapCountMap = new Map<string, { snaps: number, pct: number, games: number }>();
{
  // Find the most recent snap count file
  const snapKeys = Object.keys(snapCountModules).sort().reverse();
  for (const key of snapKeys) {
    const data = getModuleData(snapCountModules[key]);
    if (data?.players) {
      for (const [mflId, stats] of Object.entries(data.players) as [string, any][]) {
        snapCountMap.set(mflId, {
          snaps: stats.offenseSnaps ?? 0,
          pct: stats.offensePct ?? 0,
          games: stats.gamesPlayed ?? 0,
        });
      }
      break; // Use only the most recent file
    }
  }
}
const hasSnapCounts = snapCountMap.size > 0;

// Build projected scores lookup
const projectedMap = new Map<string, number>();
if (projectedScoresData?.projectedScores?.playerScore) {
  const scores = Array.isArray(projectedScoresData.projectedScores.playerScore)
    ? projectedScoresData.projectedScores.playerScore
    : [projectedScoresData.projectedScores.playerScore];
  for (const s of scores) {
    if (s?.id && s?.score) {
      const score = parseFloat(s.score);
      if (score > 0) projectedMap.set(s.id, score);
    }
  }
}

// Build rostered player map with contract info + the OWNING franchise, which
// is what lets a rostered player's modal wear the fantasy team (band colors,
// crest, "Rostered by" line) instead of the free-agent fallback.
const rosteredPlayers = new Map<string, { salary: number | null; contractYrs: number | null; franchiseId: string }>();
if (rostersData?.rosters?.franchise) {
  const franchises = Array.isArray(rostersData.rosters.franchise)
    ? rostersData.rosters.franchise
    : [rostersData.rosters.franchise];
  for (const franchise of franchises) {
    const rosterPlayers = franchise?.player
      ? (Array.isArray(franchise.player) ? franchise.player : [franchise.player])
      : [];
    for (const p of rosterPlayers) {
      if (!p?.id) continue;
      const salary = p.salary ? parseFloat(p.salary) : null;
      const contractYrs = p.contractYear ? parseInt(p.contractYear, 10) : null;
      rosteredPlayers.set(p.id, {
        salary: salary && salary > 0 ? salary : null,
        contractYrs: contractYrs && contractYrs > 0 ? contractYrs : null,
        franchiseId: franchise.id,
      });
    }
  }
}

// Build surplus value lookup (same pattern as trade-builder.astro)
const surplusMap = new Map<string, { dollarValue: number; estimatedCost: number; surplusValue: number }>();
{
  // Resolve frozen salary averages year
  const salaryAvgYear = String(getFrozenSalaryAveragesYear(salaryAvgModules, getModuleData));
  let salaryAvgData: any = null;
  for (const [path, mod] of Object.entries(salaryAvgModules)) {
    if (path.includes(salaryAvgYear)) {
      salaryAvgData = getModuleData(mod);
      break;
    }
  }
  if (!salaryAvgData) {
    const keys = Object.keys(salaryAvgModules).sort().reverse();
    if (keys.length > 0) salaryAvgData = getModuleData(salaryAvgModules[keys[0]]);
  }

  // Build input arrays for the surplus calculator
  const projScoresArray: Array<{ id: string; score: string }> = [];
  if (projectedScoresData?.projectedScores?.playerScore) {
    const scores = Array.isArray(projectedScoresData.projectedScores.playerScore)
      ? projectedScoresData.projectedScores.playerScore
      : [projectedScoresData.projectedScores.playerScore];
    for (const s of scores) {
      if (s?.id && s?.score) projScoresArray.push({ id: s.id, score: s.score });
    }
  }

  const rawPlayersList = playersData?.players?.player;
  const playersArray: Array<{ id: string; name: string; position: string; team: string; birthdate?: string; draftYear?: number }> = [];
  if (Array.isArray(rawPlayersList)) {
    for (const p of rawPlayersList) {
      if (!p?.id || !p?.name || !p?.position) continue;
      const draftYear = p.draft_year ? parseInt(p.draft_year, 10) : undefined;
      playersArray.push({
        id: p.id,
        name: p.name,
        position: p.position === 'Def' ? 'DEF' : p.position,
        team: p.team || '',
        birthdate: p.birthdate,
        draftYear: Number.isFinite(draftYear) ? draftYear : undefined,
      });
    }
  }

  const rostersArray: Array<{ id: string; player: Array<{ id: string; salary: string; contractYear: string; status: string }> }> = [];
  if (rostersData?.rosters?.franchise) {
    const franchises = Array.isArray(rostersData.rosters.franchise)
      ? rostersData.rosters.franchise
      : [rostersData.rosters.franchise];
    for (const f of franchises) {
      const fPlayers = f?.player ? (Array.isArray(f.player) ? f.player : [f.player]) : [];
      rostersArray.push({
        id: f.id,
        player: fPlayers.map((rp: any) => ({
          id: rp.id,
          salary: rp.salary ?? '0',
          contractYear: rp.contractYear ?? '0',
          status: rp.status ?? 'ROSTER',
        })),
      });
    }
  }

  if (projScoresArray.length > 0 && salaryAvgData) {
    const surplusResults = calculateAllSurplusValues({
      leagueYear: currentYear,
      projectedScores: projScoresArray,
      players: playersArray,
      rosters: rostersArray,
      salaryAverages: salaryAvgData,
      adpDynasty: adpDynMap,
    });
    for (const r of surplusResults) {
      surplusMap.set(r.playerId, {
        dollarValue: r.dollarValue,
        estimatedCost: r.estimatedCost,
        surplusValue: r.surplusValue,
      });
    }
  }
}
const hasSurplusData = surplusMap.size > 0;

// Build auction results lookup (seed from build-time data, updated by polling)
const auctionMap = new Map<string, { bid: number; franchise: string; status: string }>();
{
  const auctionData = findForYear(auctionResultsModules, currentYear);
  const auctionUnit = auctionData?.auctionResults?.auctionUnit;
  if (auctionUnit?.auction) {
    const auctionList = Array.isArray(auctionUnit.auction)
      ? auctionUnit.auction
      : [auctionUnit.auction];
    for (const a of auctionList) {
      if (a?.player && a?.winningBid) {
        auctionMap.set(a.player, {
          bid: parseInt(a.winningBid, 10),
          franchise: a.franchise || '',
          status: 'won',
        });
      }
    }
  }
}
const hasAuctionData = auctionMap.size > 0;

// Auction season: 3rd Thursday of March through 3rd Sunday of August.
// `?testDate=YYYY-MM-DD` overrides "now" so the phase-aware row action (Bid vs
// Add) can be previewed in the browser. It only shifts the auction-window
// comparison — data loading stays keyed to the real currentYear so a test date
// can't request a year we have no feed data for. The auction window itself is
// computed from the test date's league year so cross-year dates resolve correctly.
const nowRef = getTestDateFromSearchParams(Astro.url.searchParams) ?? new Date();
const auctionWindowYear = getCurrentLeagueYear(nowRef);
const auctionStart = getNthDayOfMonth(auctionWindowYear, 2, 4, 3); // 3rd Thursday of March (month 2 = March)
const auctionEnd = getNthDayOfMonth(auctionWindowYear, 7, 0, 3);   // 3rd Sunday of August (month 7 = August)
auctionEnd.setHours(20, 45, 0, 0); // 8:45 PM PT close
const isAuctionSeason = nowRef.getTime() >= auctionStart.getTime() && nowRef.getTime() < auctionEnd.getTime();
// MFL deep-links use the same league year that drives the Bid/Add state, so a
// cross-year ?testDate can't show one year's auction while linking another.
// For real requests (no testDate) this equals currentYear.
const mflActionYear = auctionWindowYear;

// Player salary by each of the last 3 completed league years.
const salaryYear1 = currentYear - 1;
const salaryYear2 = currentYear - 2;
const salaryYear3 = currentYear - 3;
const recentSalaryYears = [salaryYear1, salaryYear2, salaryYear3].filter((y) => y > 0);
const recentSalaryYearSet = new Set(recentSalaryYears);
const historicalSalaryByYearMap = new Map<string, Record<number, number>>();
{
  for (const [path, mod] of Object.entries(playerSalaryHistoryModules)) {
    const yearMatch = path.match(/mfl-player-salaries-(\d{4})\.json$/);
    const fileYear = yearMatch ? parseInt(yearMatch[1], 10) : NaN;
    if (!Number.isFinite(fileYear) || !recentSalaryYearSet.has(fileYear)) continue;

    const data = getModuleData(mod);
    const players = Array.isArray(data?.players) ? data.players : [];
    for (const p of players) {
      if (!p?.id) continue;
      const salary = parseFloat(String(p.salary ?? 0));
      if (!Number.isFinite(salary) || salary <= 0) continue;
      const entry = historicalSalaryByYearMap.get(p.id) ?? {};
      entry[fileYear] = salary;
      historicalSalaryByYearMap.set(p.id, entry);
    }
  }
}

// Relevant positions for fantasy
const fantasyPositions = new Set(['QB', 'RB', 'WR', 'TE', 'PK', 'Def', 'DEF']);

// Build combined player list
interface PlayerRow {
  id: string;
  name: string;
  position: string;
  team: string;
  age: number | null;
  espnId: string | null;
  projected: number | null;
  rostered: boolean;
  exp: number | null;
  draftRd: number | null;
  college: string | null;
  collegeLogo: string | null;
  htWt: string | null;
  height: number | null;
  weight: number | null;
  adpDyn: number | null;
  adpRdf: number | null;
  lastYrPts: number | null;
  snaps: number | null;
  snapPct: number | null;
  rookie: boolean;
  birthdate: number | null;
  jersey: string | null;
  draftYear: number | null;
  draftTeam: string | null;
  draftPick: number | null;
  salary: number | null;
  contractYrs: number | null;
  /** Fantasy franchise that rosters him, or null for a true free agent. */
  franchiseId: string | null;
  games: number | null;
  ppg: number | null;
  salaryYear1: number | null;
  salaryYear2: number | null;
  salaryYear3: number | null;
  dollarValue: number | null;
  estimatedCost: number | null;
  surplusValue: number | null;
  auctionBid: number | null;
  auctionStatus: string | null;
  auctionBidTime: number | null;
  auctionFranchise: string | null;
  auctionInitTime: number | null;
}

const allPlayers = playersData?.players?.player;
const playerList: PlayerRow[] = [];
const playerIdentityMap = getPlayerMap(currentYear);

if (Array.isArray(allPlayers)) {
  const now = Date.now() / 1000;
  for (const p of allPlayers) {
    if (!p?.id || !p?.name || !p?.position) continue;
    if (!fantasyPositions.has(p.position)) continue;

    const projected = projectedMap.get(p.id) ?? null;
    const isRostered = rosteredPlayers.has(p.id);
    const rosterInfo = rosteredPlayers.get(p.id);

    // Skip only players with zero data relevance (no projections, not rostered, no NFL team)
    // This filters out practice squad/obscure players while keeping real NFL free agents

    let age: number | null = null;
    if (p.birthdate) {
      const birthTimestamp = parseInt(p.birthdate, 10);
      if (birthTimestamp > 0) {
        age = Math.floor((now - birthTimestamp) / (365.25 * 24 * 60 * 60));
      }
    }

    const identity = playerIdentityMap.get(p.id);
    const pos = identity?.position ?? (p.position === 'Def' ? 'DEF' : p.position);
    const displayName = identity?.name ?? (() => {
      const nameParts = p.name.split(', ');
      return nameParts.length === 2 ? `${nameParts[1]} ${nameParts[0]}` : p.name;
    })();

    // Experience (years in NFL)
    const draftYr = p.draft_year ? parseInt(p.draft_year, 10) : null;
    const exp = draftYr && draftYr > 0 ? currentYear - draftYr : null;

    // Draft round
    const draftRd = p.draft_round ? parseInt(p.draft_round, 10) : null;

    // Height/Weight formatting
    let htWt: string | null = null;
    let heightInches: number | null = null;
    let weightLbs: number | null = null;
    if (p.height) {
      const inches = parseInt(p.height, 10);
      if (inches > 0) {
        heightInches = inches;
        const ft = Math.floor(inches / 12);
        const rem = inches % 12;
        htWt = `${ft}'${rem}"`;
        if (p.weight) {
          weightLbs = parseInt(p.weight, 10) || null;
          htWt += ` ${p.weight}`;
        }
      }
    }

    playerList.push({
      id: p.id,
      name: displayName,
      position: pos,
      team: identity?.nflTeam ?? normalizeMflTeam(p.team || ''),
      age: pos === 'DEF' ? 25 : age,
      espnId: identity?.espnId ?? (p.espn_id || (espnCollegeIds as any).players?.[p.id]?.espnCollegeId || null),
      projected,
      rostered: isRostered,
      exp: pos === 'DEF' ? 5 : exp,
      draftRd: (draftRd && draftRd > 0) ? draftRd : null,
      college: p.college || null,
      collegeLogo: getCollegeLogo(p.college),
      htWt,
      height: heightInches,
      weight: weightLbs,
      adpDyn: adpDynMap.get(p.id) ?? null,
      adpRdf: adpRdfMap.get(p.id) ?? null,
      lastYrPts: lastYrPtsMap.has(p.id) ? Math.round((lastYrPtsMap.get(p.id)!) * 10) / 10 : null,
      snaps: snapCountMap.has(p.id) ? snapCountMap.get(p.id)!.snaps : null,
      snapPct: snapCountMap.has(p.id) ? snapCountMap.get(p.id)!.pct : null,
      games: lastYrGamesMap.get(p.id) ?? null,
      rookie: p.status === 'R',
      birthdate: p.birthdate ? parseInt(p.birthdate, 10) : null,
      jersey: p.jersey || null,
      draftYear: draftYr,
      draftTeam: p.draft_team || null,
      draftPick: p.draft_pick ? parseInt(p.draft_pick, 10) : null,
      salary: rosterInfo?.salary ?? null,
      contractYrs: rosterInfo?.contractYrs ?? null,
      franchiseId: rosterInfo?.franchiseId ?? null,
      ppg: (() => {
        const pts = lastYrPtsMap.get(p.id);
        const gp = lastYrGamesMap.get(p.id);
        return (pts && gp && gp > 0) ? Math.round((pts / gp) * 10) / 10 : null;
      })(),
      salaryYear1: historicalSalaryByYearMap.get(p.id)?.[salaryYear1] ?? null,
      salaryYear2: historicalSalaryByYearMap.get(p.id)?.[salaryYear2] ?? null,
      salaryYear3: historicalSalaryByYearMap.get(p.id)?.[salaryYear3] ?? null,
      dollarValue: surplusMap.get(p.id)?.dollarValue ?? null,
      estimatedCost: surplusMap.get(p.id)?.estimatedCost ?? null,
      surplusValue: surplusMap.get(p.id)?.surplusValue ?? null,
      auctionBid: auctionMap.get(p.id)?.bid ?? null,
      auctionStatus: auctionMap.get(p.id)?.status ?? null,
      auctionBidTime: null,
      auctionFranchise: auctionMap.get(p.id)?.franchise ?? null,
      auctionInitTime: null,
    });
  }
}

// Default sort by projected points (highest first)
playerList.sort((a, b) => {
  const aVal = a.projected ?? -1;
  const bVal = b.projected ?? -1;
  return bVal - aVal;
});

const hasProjected = projectedMap.size > 0;
const hasLastYrPts = lastYrPtsMap.size > 0;

// Count free agents by position for category tabs. Mirrors the client's
// initial filter state: rookies only count once the draft is complete, so
// the server-rendered pill counts (and hero spotlight) match the table.
const freeAgents = playerList.filter(p => !p.rostered && (rookieDraftComplete || !p.rookie));
const faCounts: Record<string, number> = { ALL: freeAgents.length };
for (const p of freeAgents) {
  faCounts[p.position] = (faCounts[p.position] || 0) + 1;
}

// Initial hero spotlight: the top free agent by the default sort (highest projected).
// The client rehydrates this on every filter/sort change via updateSpotlight().
const topFa = freeAgents[0] ?? null;
const topFaIsDef = topFa?.position === 'DEF';
// For a team defense, spotlight the team's marquee defender (if mapped) so the
// hero shows a face over the logo watermark instead of a bare crest.
const topFaDefStar = topFaIsDef ? getDefSpotlightPlayer(topFa?.team) : null;
const topFaLogo = topFa && topFa.team && topFa.team.indexOf('FA') !== 0
  ? `/assets/nfl-logos/${topFa.team}.svg`
  : '/assets/nfl-logos/NFL.svg';
// The hero headshot shows ESPN images only. When there's no ESPN image
// (offensive player with no espnId, or an unmapped DEF) we hide the foreground
// headshot rather than falling back to an MFL photo, so the spotlight never
// shows a low-res/placeholder face. See topFaHasHeadshot below.
// Falls back to the (NFL) logo rather than an empty string so we never emit
// <img src=""> (which re-requests the document) when there are no free agents
// or when the headshot is hidden.
const topFaHasHeadshot = topFa
  ? (topFaIsDef ? !!topFaDefStar?.espnId : !!topFa.espnId)
  : false;
const topFaHead = topFa
  ? (topFaIsDef
      ? (topFaDefStar
          ? `https://a.espncdn.com/i/headshots/nfl/players/full/${topFaDefStar.espnId}.png`
          : topFaLogo)
      : (topFa.espnId
          ? `https://a.espncdn.com/i/headshots/nfl/players/full/${topFa.espnId}.png`
          : topFaLogo))
  : topFaLogo;
// Initial (pre-hydration) error handler for the eager hero headshot: the image
// starts fetching before client JS attaches its handler, so mirror the client's
// hero-only fallback here — try the ESPN college headshot, then hide — so an ESPN
// 404 never flashes a broken image in the first viewport. Only emitted when we're
// showing an ESPN headshot (topFaHasHeadshot). espnId is a numeric MFL/ESPN id.
const topFaHeadEspnIdRaw = topFaHasHeadshot ? (topFaIsDef ? topFaDefStar?.espnId : topFa?.espnId) : null;
const topFaHeadEspnId = topFaHeadEspnIdRaw && /^\d+$/.test(String(topFaHeadEspnIdRaw)) ? String(topFaHeadEspnIdRaw) : null;
const topFaHeadOnerror = topFaHeadEspnId
  ? `this.onerror=function(){this.onerror=null;this.style.visibility='hidden'};this.src='https://a.espncdn.com/i/headshots/college-football/players/full/${topFaHeadEspnId}.png'`
  : undefined;

// Build unique NFL teams list for team filter dropdown
const nflTeamsSet = new Set<string>();
for (const p of playerList) {
  if (p.team && p.team.indexOf('FA') !== 0) nflTeamsSet.add(p.team);
}
const nflTeamsList = [...nflTeamsSet].sort();

const playerDataJson = JSON.stringify(playerList);
const nflTeamsJson = JSON.stringify(nflTeamsList);
const defSpotlightJson = JSON.stringify(DEF_SPOTLIGHT_PLAYERS);

// NFL-team gradient backdrops for player avatars (same treatment as the modal
// band). Precomputed via the shared style maps (ESPN codes + MFL aliases) so
// the client-side list renderer just does a lookup — no color math duplicated
// in the browser. FA/unknown falls back to the league-neutral blue.
const { bg: nflAvatarBg, border: nflAvatarBorder, ring: nflAvatarRing, ringDark: nflAvatarRingDark } = getPlayerAvatarStyleMaps();
const nflAvatarBgFallback = getPlayerAvatarBackground('FA');
const nflAvatarBorderFallback = getPlayerAvatarBorder('FA');
const nflAvatarRingFallback = getPlayerAvatarRing('FA');
const nflAvatarRingDarkFallback = getPlayerAvatarRingDark('FA');
const nflAvatarBgJson = JSON.stringify(nflAvatarBg);
const nflAvatarBorderJson = JSON.stringify(nflAvatarBorder);
const nflAvatarRingJson = JSON.stringify(nflAvatarRing);
const nflAvatarRingDarkJson = JSON.stringify(nflAvatarRingDark);

// Admin gate: Value view is only visible to admin franchises (same auth as nav sidebar)
const authUser = getAuthUser(Astro.request);
const isAdmin = !!authUser && isCommissionerOrAdmin(authUser);

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(path, hideLeaguePrefix);
// Client payload for src/scripts/players/theleague-players.ts.
// One JSON blob handed over by a one-line bridge below, instead of 28
// separate `define:vars` consts — that form forces the whole ~1,750-line
// script to be a classic (un-importable, un-typed) block.
const playersConfigJson = JSON.stringify({
  playerDataJson,
  hasProjected,
  hasLastYrPts,
  hasSnapCounts,
  nflTeamsJson,
  hasSurplusData,
  hasAuctionData,
  isAuctionSeason,
  isAdmin,
  currentYear,
  mflHost,
  mflLeagueId,
  mflActionYear,
  franchiseNamesJson,
  franchiseBannersJson,
  defSpotlightJson,
  nflAvatarBgJson,
  nflAvatarBgFallback,
  nflAvatarBorderJson,
  nflAvatarBorderFallback,
  nflAvatarRingJson,
  nflAvatarRingFallback,
  nflAvatarRingDarkJson,
  nflAvatarRingDarkFallback,
  logoOnerror: NFL_LOGO_ONERROR,
  collegeLogoOnerror: COLLEGE_LOGO_ONERROR,
  collegeLogoOnload: COLLEGE_LOGO_ONLOAD,
  rookieDraftComplete,
});

---

<TheLeagueLayout title="Free Agents | TheLeague">
  <CollegeLogoDarkStyles />
  <div class="players-page">
    <!-- Dark Gradient Hero -->
    <div class="players-hero">
      <!-- Dynamic spotlight: the #1 player in the current filter/sort.
           ESPN headshot in front, NFL team logo watermark behind. Rehydrated
           client-side by updateSpotlight() whenever the list re-renders. -->
      <div class="hero-spotlight" id="hero-spotlight" aria-hidden="true" data-def={topFaIsDef ? 'true' : 'false'} data-def-player={topFaIsDef && topFaDefStar ? 'true' : 'false'}>
        <img id="hero-spotlight-logo" class="hero-spotlight__logo" src={topFaLogo} alt="" loading="eager" decoding="async" onerror={NFL_LOGO_ONERROR} onload={NFL_LOGO_ONLOAD} />
        <img id="hero-spotlight-head" class="hero-spotlight__head" src={topFaHead} alt="" loading="eager" decoding="async" style={topFaHasHeadshot ? undefined : 'visibility:hidden'} onerror={topFaHeadOnerror} />
      </div>
      {topFa && (
        <div class="hero-spotlight-caption" id="hero-spotlight-caption" aria-live="polite">
          <span class="hero-spotlight__label" id="hero-spotlight-label">Top Free Agent</span>
          <span class="hero-spotlight__name" id="hero-spotlight-name">{topFaDefStar ? topFaDefStar.name : topFa.name}</span>
          <span class="hero-spotlight__meta" id="hero-spotlight-meta">
            {(topFa.position === 'PK' ? 'K' : topFa.position)}{topFa.team && topFa.team.indexOf('FA') !== 0 ? ` · ${topFa.team}` : ''}{topFa.projected != null ? ` · ${topFa.projected.toFixed(1)} pts` : ''}
          </span>
        </div>
      )}
      <div class="hero-top">
        <div class="hero-title-group">
          <h1 class="hero-title">Free Agents</h1>
          <span class="hero-count">{freeAgents.length} available players</span>
        </div>
        <a href={r('/theleague/projected-free-agents')} class="hero-cross-link">
          See projected FAs
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Search -->
      <div class="hero-search">
        <svg class="hero-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          id="player-search"
          class="hero-search__input"
          placeholder="Search by player name or NFL team..."
          autocomplete="off"
        />
      </div>

      <!-- Position Pills -->
      <nav class="hero-positions" id="category-tabs">
        <button class="pos-pill active" data-pos="ALL">
          All
          <span class="pos-pill__count" id="count-ALL">{faCounts.ALL || 0}</span>
        </button>
        {positionOrder.map(pos => (
          <button
            class="pos-pill"
            data-pos={pos}
          >
            {pos === 'PK' ? 'K' : pos}
            <span class="pos-pill__count" id={`count-${pos}`}>{faCounts[pos] || 0}</span>
          </button>
        ))}
      </nav>
    </div>

    <!-- Toolbar: section title + counts + view toggles + filter button -->
    <div class="players-toolbar">
      <div class="toolbar-left">
        <h2 class="players-section-title">Available Players</h2>
        <span class="showing-count" aria-live="polite">
          <strong id="showing-count">50</strong> of <strong id="total-players">0</strong>
        </span>
        <div class="col-group-toggles" id="col-group-toggles" role="group" aria-label="Show columns" style="display: none;">
          <span class="col-group-toggles__label">View:</span>
          <button class="col-group-btn active" data-group="stats" type="button" aria-pressed="true">Stats</button>
          <button class="col-group-btn" data-group="rankings" id="col-group-btn-rankings" type="button" aria-pressed="false">Rankings</button>
          <button class="col-group-btn" data-group="auction" id="col-group-btn-auction" type="button" aria-pressed="false">Auction</button>
          {isAdmin && (hasSurplusData || hasAuctionData) && <button class="col-group-btn" data-group="value" id="col-group-btn-value" type="button" aria-pressed="false">Value</button>}
        </div>
        <button class="auction-freshness" id="auction-freshness" type="button" aria-label="Refresh auction data" title="Click to refresh auction data" style="display: none;">
          <span class="freshness__dot" aria-hidden="true"></span>
          Updated <span id="auction-freshness-time">&mdash;</span>
        </button>
        <span class="auction-countdown" id="auction-countdown" role="timer" aria-live="off" aria-label="Auction ends in" style="display: none;">
          <span class="countdown__label">Ends in</span>
          <span class="countdown__value" id="countdown-value">&mdash;</span>
        </span>
      </div>
      <div class="toolbar-center"></div>
      <div class="toolbar-right">
        <MyRankEditor league="theleague" />
        <button class="filter-toggle-btn" id="filter-toggle-btn" type="button" aria-expanded="false" aria-controls="filters-panel">
          <svg class="filter-toggle-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="11" y1="18" x2="13" y2="18" />
          </svg>
          Filters
          <span class="filter-badge" id="filter-badge" style="display: none;">0</span>
        </button>
      </div>
    </div>

    <!-- Collapsible Filters Panel -->
    <div class="filters-panel" id="filters-panel" inert>
      <div class="filters-panel__clip">
        <div class="filters-panel__inner">
          <h3 class="filters-panel-title">Filters</h3>
          <div class="filters-grid">
            <div class="filter-group">
              <label class="filter-label" for="filter-team">NFL Team</label>
              <select id="filter-team" class="filter-select">
                <option value="">All Teams</option>
                {nflTeamsList.map(team => (
                  <option value={team}>{team}</option>
                ))}
              </select>
            </div>

            <div class="filter-group filter-group--age">
              <label class="filter-label">Age Range</label>
              <div class="filter-range">
                <input type="number" id="filter-age-min" class="filter-input-num" placeholder="Min" min="18" max="50" />
                <span class="filter-range__sep">&ndash;</span>
                <input type="number" id="filter-age-max" class="filter-input-num" placeholder="Max" min="18" max="50" />
              </div>
            </div>

            <div class="filter-group filter-group--ht">
              <label class="filter-label">Height (in)</label>
              <div class="filter-range">
                <input type="number" id="filter-ht-min" class="filter-input-num" placeholder="Min" min="60" max="84" />
                <span class="filter-range__sep">&ndash;</span>
                <input type="number" id="filter-ht-max" class="filter-input-num" placeholder="Max" min="60" max="84" />
              </div>
            </div>

            <div class="filter-group filter-group--wt">
              <label class="filter-label">Weight (lbs)</label>
              <div class="filter-range">
                <input type="number" id="filter-wt-min" class="filter-input-num" placeholder="Min" min="150" max="400" />
                <span class="filter-range__sep">&ndash;</span>
                <input type="number" id="filter-wt-max" class="filter-input-num" placeholder="Max" min="150" max="400" />
              </div>
            </div>

            <div class="filter-group">
              <label class="filter-label" for="filter-exp">Experience</label>
              <select id="filter-exp" class="filter-select">
                <option value="">All</option>
                <option value="rookie">Rookie</option>
                <option value="1-2">1–2 years</option>
                <option value="3-5">3–5 years</option>
                <option value="6-10">6–10 years</option>
                <option value="10+">10+ years</option>
              </select>
            </div>

            <div class="filter-group">
              <label class="filter-label" for="filter-draft">Draft Round</label>
              <select id="filter-draft" class="filter-select">
                <option value="">All</option>
                <option value="1">Round 1</option>
                <option value="2">Round 2</option>
                <option value="3">Round 3</option>
                <option value="4+">Round 4+</option>
                <option value="udfa">Undrafted</option>
              </select>
            </div>
          </div>

          <div class="filters-row-bottom">
            <!-- autocomplete="off": Firefox restores checkbox state across
                 reloads, desyncing the restored DOM from the script's
                 re-initialized defaults (same hardening as the AFL page). -->
            <label class="filter-checkbox">
              <input type="checkbox" id="show-rostered" autocomplete="off" />
              <span>Include rostered</span>
            </label>
            <label class="filter-checkbox">
              <input type="checkbox" id="show-rookies" autocomplete="off" checked={rookieDraftComplete} />
              <span>Include rookies</span>
            </label>
            <button class="filter-clear-btn" id="filter-clear-btn" type="button">Clear Filters</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Screen reader announcer for bid changes -->
    <div class="sr-only" aria-live="polite" aria-atomic="true" id="auction-announcer"></div>

    <!-- Table -->
    <div class="table-wrapper">
      <!-- Bid Status Legend (inside table-wrapper so it's visually attached) -->
      <div class="bid-legend" id="bid-legend" style="display: none;">
        <span class="bid-legend__title">Bid Status:</span>
        <span class="bid-legend__item bid-legend__item--hot">
          <span class="bid-legend__dot bid-legend__dot--hot" aria-hidden="true"></span>
          Hot (&lt;15m)
        </span>
        <span class="bid-legend__item bid-legend__item--warm">
          <span class="bid-legend__dot bid-legend__dot--warm" aria-hidden="true"></span>
          Warm (15-60m)
        </span>
        <span class="bid-legend__item bid-legend__item--cool">
          <span class="bid-legend__dot bid-legend__dot--cool" aria-hidden="true"></span>
          Active (&gt;1h)
        </span>
        <span class="bid-legend__item bid-legend__item--won">
          Won
        </span>
        <span class="bid-legend__item bid-legend__item--none">
          No bid
        </span>
      </div>
      <table class="players-table" id="players-table">
        <thead>
          <tr>
            <th class="sortable col-rank" data-sort="rank">
              <div class="th-content">#</div>
            </th>
            <th class="sortable col-player" data-sort="name">
              <div class="th-content">Player</div>
            </th>
            <th class="sortable col-age" data-sort="age">
              <div class="th-content">Age</div>
            </th>
            <th class="sortable col-sm col-always-profile" data-sort="exp">
              <div class="th-content">Exp</div>
            </th>
            <th class="sortable col-sm col-always-profile" data-sort="draftRd">
              <div class="th-content">Draft</div>
            </th>
            <th class="sortable col-text col-group--stats col-college" data-sort="college" title="College" aria-label="College">
              <div class="th-content">C</div>
            </th>
            <th class="sortable col-sm col-always-profile" data-sort="height">
              <div class="th-content">Ht</div>
            </th>
            <th class="sortable col-sm col-always-profile" data-sort="weight">
              <div class="th-content">Wt</div>
            </th>
            {hasSnapCounts && (
              <th class="sortable col-sm col-group--stats" data-sort="games">
                <div class="th-content">GP</div>
              </th>
            )}
            {hasSnapCounts && (
              <th class="sortable col-sm col-group--stats" data-sort="snaps">
                <div class="th-content">Snaps</div>
              </th>
            )}
            {hasSnapCounts && (
              <th class="sortable col-num col-group--stats" data-sort="snapPct">
                <div class="th-content">Snap%</div>
              </th>
            )}
            {hasLastYrPts && (
              <th class="sortable col-num col-group--stats" data-sort="lastYrPts">
                <div class="th-content">Last Yr</div>
              </th>
            )}
            {hasLastYrPts && hasSnapCounts && (
              <th class="sortable col-num col-group--stats col-value-ppg" data-sort="ppg">
                <div class="th-content">PPG</div>
              </th>
            )}
            {hasProjected && (
              <th class="sortable col-num col-group--stats col-projected" data-sort="projected" style="display: none;">
                <div class="th-content">Proj</div>
              </th>
            )}
            {isAdmin && (
              <th class="sortable col-num col-group--value col-value-money col-value-bid" data-sort="auctionBid" aria-label="Auction bid price">
                <div class="th-content">Bid</div>
              </th>
            )}
            {isAdmin && hasSurplusData && (
              <th class="sortable col-num col-group--value col-value-money" data-sort="estimatedCost">
                <div class="th-content">Est. Cost</div>
              </th>
            )}
            {isAdmin && hasSurplusData && (
              <th class="sortable col-num col-group--value col-value-money" data-sort="dollarValue">
                <div class="th-content">$ Value</div>
              </th>
            )}
            <th class="sortable col-num col-group--value col-value-money col-steal" data-sort="stealValue" aria-label="Dollar value minus current bid — higher means bigger steal">
              <div class="th-content">Steal</div>
            </th>
            <th class="col-group--value col-value-money col-place-bid" aria-label="Place a bid on this player">
              <div class="th-content"></div>
            </th>
            <!-- Auction view columns -->
            <th class="sortable col-num col-group--auction col-auction-rank" data-sort="auctionRank" style="display: none;">
              <div class="th-content">Rank</div>
            </th>
            <th class="sortable col-num col-group--auction col-auction-bid" data-sort="auctionBid" style="display: none;">
              <div class="th-content">Bid</div>
            </th>
            <th class="sortable col-text col-group--auction col-auction-bidder" data-sort="auctionFranchise" style="display: none;">
              <div class="th-content">Bidder</div>
            </th>
            <th class="sortable col-text col-group--auction col-auction-started" data-sort="auctionInitTime" style="display: none;">
              <div class="th-content">Started</div>
            </th>
            <th class="sortable col-text col-group--auction col-auction-lastbid" data-sort="auctionBidTime" style="display: none;">
              <div class="th-content">Last Bid</div>
            </th>
            <th class="sortable col-num col-group--auction col-auction-timeleft" data-sort="auctionTimeLeft" style="display: none;">
              <div class="th-content">Time Left</div>
            </th>
            <th class="col-group--auction col-auction-placebid" style="display: none;" aria-label="Place a bid on this player">
              <div class="th-content"></div>
            </th>
            <th class="sortable col-sm col-contract col-contract-yrs" data-sort="contractYrs" style="display: none;">
              <div class="th-content">Yrs</div>
            </th>
            <th class="sortable col-num col-contract" data-sort="salary" style="display: none;">
              <div class="th-content">Sal/Bid</div>
            </th>
            <!-- Acquisition action (default/rankings views): Add during in-season/FCFS, Bid during auction -->
            <th class="col-fa-action" aria-label="Add or bid on this player">
              <div class="th-content"></div>
            </th>
          </tr>
        </thead>
        <tbody id="player-table-body"></tbody>
      </table>
    </div>

    <!-- Show More -->
    <div class="show-more-wrapper" id="show-more-wrapper">
      <button class="show-more-btn" id="show-more-btn">
        Load More Players
        <svg class="show-more-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>
    </div>

    <!-- No data -->
    <div class="no-data" id="no-data" style="display: none;">
      <p>No player data available yet.</p>
      <p>Run <code>node scripts/fetch-mfl-feeds.mjs</code> to fetch data.</p>
    </div>
  </div>
  <PlayerDetailsModal />

  <script
    type="application/json"
    id="weekly-player-results"
    set:html={JSON.stringify(weeklyPlayerResults)}
  ></script>
</TheLeagueLayout>

<script is:inline define:vars={{ playersConfigJson }}>
  window.__TL_PLAYERS__ = JSON.parse(playersConfigJson);
</script>
<script>
  // The free-agent table: filters, sorting, the auction board and the
  // contract/value views. A bundled module (typed, import-capable) reading
  // the payload above — it used to be ~1,750 lines of classic `define:vars`
  // script, which is why it has to talk to the rankings module over
  // CustomEvents instead of importing it.
  import '../../scripts/players/theleague-players';
</script>

<!-- Rankings integration: dynamically injects ranking columns from localStorage imports -->
<script>
  import { initRankingTable } from '../../utils/rankings-table';

  initRankingTable({
    tableSelector: '.players-table',
    anchorSelector: '[data-sort="weight"]',
    // My Rank doubles as the Value view's ranking column.
    compositeThClasses: ['col-my-rank', 'col-group--value'],
  });
</script>

<!-- Player modal trigger (delegated, works across re-renders) -->
<script>
  import { initPlayerModalTrigger } from '../../utils/player-modal-trigger';

  function initModalTrigger() {
    const tbody = document.getElementById('player-table-body');
    if (tbody) initPlayerModalTrigger(tbody);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModalTrigger);
  } else {
    initModalTrigger();
  }
</script>

<style>
  /* =============================================
     FREE AGENTS PAGE — SPORTS WEBSITE REDESIGN
     ============================================= */

  .players-page {
    max-width: 100%;
    padding-bottom: 3rem;
  }

  /* ── Remove gap between nav header and hero ── */
  :global(.container-header) {
    margin-bottom: 0 !important;
    padding-bottom: 0.5rem !important;
  }

  /* ── Dark Gradient Hero ── */
  .players-hero {
    background: var(--color-gray-50, #f9fafb);
    color: var(--color-gray-900, #111827);
    padding: 1.75rem 1.5rem 1.5rem;
    border-radius: var(--radius-lg, 1rem);
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--content-border, #e2e8f0);
  }
  .players-hero::before {
    display: none;
  }

  /* ── Hero Spotlight (broadcast diagonal cut: top-FA headshot + team logo) ── */
  .hero-spotlight {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    pointer-events: none;
    clip-path: polygon(20% 0, 110% 0, 90% 100%, 0% 100%);
    /* Light mode: light panel. Literal colors on purpose — the --color-gray-*
       scale INVERTS under html.dark, so a gray token here would flip the panel
       to the wrong tone in the other theme. Each theme is set explicitly. */
    background:
      radial-gradient(120% 120% at 80% 20%, rgba(28, 73, 124, 0.12) 0%, transparent 60%),
      #eef1f6;
  }
  /* Dark mode: dark broadcast panel */
  :global(html.dark) .hero-spotlight {
    background:
      radial-gradient(120% 120% at 80% 20%, rgba(28, 73, 124, 0.55) 0%, transparent 60%),
      #111827;
  }
  /* Diagonal accent stripe — left edge */
  .hero-spotlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    z-index: 3;
    background: linear-gradient(
      to bottom,
      var(--color-primary, #1c497c) 0%,
      rgba(28, 73, 124, 0.6) 100%
    );
    clip-path: polygon(20% 0, 22.5% 0, 2.5% 100%, 0% 100%);
    pointer-events: none;
  }
  /* Diagonal accent stripe — right edge */
  .hero-spotlight::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    z-index: 3;
    background: linear-gradient(
      to bottom,
      rgba(28, 73, 124, 0.6) 0%,
      var(--color-primary, #1c497c) 100%
    );
    clip-path: polygon(110% 0, 107.5% 0, 87.5% 100%, 90% 100%);
    pointer-events: none;
  }
  /* NFL team logo watermark behind the headshot */
  .hero-spotlight__logo {
    position: absolute;
    top: 50%;
    left: 58%;
    transform: translate(-50%, -50%);
    width: 78%;
    height: auto;
    max-height: 150%;
    object-fit: contain;
    opacity: 0.16;
    filter: grayscale(0.1);
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  /* Foreground headshot of the current #1 player — contained + bottom-anchored
     so the whole player (head through shoulders/torso) shows, not just a face crop */
  .hero-spotlight__head {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 60% 100%;
    padding: 0.5rem 0 0;
    filter: brightness(1.02) contrast(1.05) saturate(1.1) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.35));
    z-index: 2;
    opacity: 0;
    animation: spotlightIn 0.45s ease forwards;
  }
  /* DEF: there's no headshot for a team defense — drop the redundant foreground
     crest and let the single team logo (the watermark) be the hero. */
  .hero-spotlight[data-def='true'] .hero-spotlight__head {
    display: none;
  }
  .hero-spotlight[data-def='true'] .hero-spotlight__logo {
    opacity: 0.92;
    filter: none;
    width: 62%;
    left: 60%;
  }
  /* DEF with a mapped marquee defender: bring the headshot back as the foreground
     hero (styled like a normal contained/bottom-anchored player photo) and drop
     the team logo back to its faint background watermark. */
  .hero-spotlight[data-def='true'][data-def-player='true'] .hero-spotlight__head {
    display: block;
  }
  .hero-spotlight[data-def='true'][data-def-player='true'] .hero-spotlight__logo {
    opacity: 0.16;
    filter: grayscale(0.1);
    width: 78%;
    left: 58%;
  }

  @keyframes spotlightIn {
    from { opacity: 0; transform: scale(1.04); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Caption — light mode: dark text on a light frosted pill;
     dark mode (override below): light text on a soft scrim. */
  .hero-spotlight-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.05rem;
    max-width: 60%;
    text-align: right;
    pointer-events: none;
    padding: 0.35rem 0.6rem 0.4rem;
    border-radius: var(--radius-md, 0.5rem);
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
  }
  /* Dark mode: white text on the dark panel, soft feathered scrim (no pill). */
  :global(html.dark) .hero-spotlight-caption {
    padding: 0.4rem 0.65rem 0.45rem 1.75rem;
    border-radius: 0;
    background: radial-gradient(130% 150% at 100% 100%, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.3) 48%, transparent 78%);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.6);
  }
  .hero-spotlight__label {
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #6b7280;
  }
  :global(html.dark) .hero-spotlight__label {
    color: rgba(255, 255, 255, 0.75);
  }
  .hero-spotlight__name {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.15;
    color: #111827;
    letter-spacing: -0.01em;
  }
  :global(html.dark) .hero-spotlight__name {
    color: #fff;
  }
  .hero-spotlight__meta {
    font-size: 0.6875rem;
    font-weight: 500;
    color: #4b5563;
    font-variant-numeric: tabular-nums;
  }
  :global(html.dark) .hero-spotlight__meta {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-top {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  /* Filled pill so the link stays legible over the dark spotlight panel it sits on */
  .hero-cross-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: var(--color-primary, #1c497c);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full, 999px);
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    transition: gap 0.15s ease, background 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }
  .hero-cross-link:hover {
    gap: 0.5rem;
    background: var(--color-primary-dark, #163a63);
    transform: translateY(-1px);
    text-decoration: none;
  }
  :global(html.dark) .hero-cross-link {
    background: var(--color-primary, #1c497c);
    color: #fff;
  }
  .hero-title-group {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-left: 0.625rem;
    border-left: 2px solid var(--color-primary, #1c497c);
  }
  .hero-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--color-gray-900, #111827);
    line-height: 1.2;
  }
  .hero-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray-400, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Hero Search ── */
  .hero-search {
    position: relative;
    z-index: 2;
    margin-bottom: 1.25rem;
    max-width: 520px;
  }
  .hero-search__icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: var(--color-gray-400, #9ca3af);
    pointer-events: none;
    transition: color 0.15s;
  }
  .hero-search__input {
    width: 100%;
    padding: 0.7rem 0.875rem 0.7rem 2.5rem;
    border: 1px solid var(--input-border, #e2e8f0);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--input-bg, #fff);
    color: var(--input-text, #111827);
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .hero-search__input::placeholder {
    color: var(--input-placeholder, #9ca3af);
  }
  .hero-search__input:focus {
    outline: none;
    border-color: var(--input-border-focus, #1c497c);
    box-shadow: 0 0 0 2px rgba(28, 73, 124, 0.12);
    background: var(--input-bg, #fff);
    color: var(--input-text, #111827);
  }
  .hero-search__input:focus::placeholder {
    color: var(--input-placeholder, #9ca3af);
  }
  .hero-search__input:focus + .hero-search__icon,
  .hero-search:has(.hero-search__input:focus) .hero-search__icon {
    color: var(--color-primary, #1c497c);
  }

  /* ── Position Pills (in hero) ── */
  .hero-positions {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
  .pos-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--content-border, #d1d5db) 70%, transparent);
    border-radius: var(--radius-md, 0.5rem);
    /* Frosted glass — translucent surface lets the hero background show through */
    background: color-mix(in srgb, var(--content-bg, #fff) 55%, transparent);
    -webkit-backdrop-filter: blur(8px) saturate(1.4);
    backdrop-filter: blur(8px) saturate(1.4);
    color: var(--color-gray-600, #4b5563);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .pos-pill:hover {
    border-color: var(--color-primary, #1c497c);
    color: var(--color-primary, #1c497c);
    background: color-mix(in srgb, var(--content-bg, #fff) 72%, transparent);
  }
  .pos-pill.active {
    background: var(--color-primary, #1c497c);
    border-color: var(--color-primary, #1c497c);
    color: white;
  }
  .pos-pill__count {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.05rem 0.35rem;
    border-radius: 10px;
    background: var(--color-gray-100, #f3f4f6);
    min-width: 1.25rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .pos-pill.active .pos-pill__count {
    background: rgba(255, 255, 255, 0.25);
  }

  /* ── Toolbar (below hero) ── */
  .players-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-gray-100, #f3f4f6);
    flex-wrap: wrap;
  }
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex: 1;
    min-width: 0;
  }
  .toolbar-center {
    display: none; /* toggles moved to toolbar-left */
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* ── Section Title (editorial signature) ── */
  .players-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-900, #111827);
    padding-left: 0.625rem;
    border-left: 2px solid var(--color-primary, #1c497c);
    margin: 0;
    line-height: 1.2;
    white-space: nowrap;
  }

  .showing-count {
    font-size: 0.75rem;
    color: var(--color-gray-400, #9ca3af);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .showing-count strong {
    color: var(--color-gray-700, #374151);
    font-weight: 600;
  }

  /* Column group toggles */
  .col-group-toggles {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .col-group-toggles__label {
    font-size: 0.8125rem;
    color: var(--content-text-muted, #64748b);
    margin-right: 0.1rem;
  }
  .col-group-btn {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-full, 999px);
    background: var(--content-bg, #fff);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-gray-600, #4b5563);
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1.4;
  }
  .col-group-btn:hover {
    border-color: var(--color-primary, #1c497c);
    color: var(--color-primary, #1c497c);
  }
  .col-group-btn.active {
    background: var(--color-primary, #1c497c);
    border-color: var(--color-primary, #1c497c);
    color: white;
  }

  /* ── Filter Toggle Button ── */
  .filter-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--content-bg, #fff);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-600, #4b5563);
    cursor: pointer;
    transition: all 0.15s;
    position: relative;
  }
  .filter-toggle-btn__icon {
    width: 15px;
    height: 15px;
  }
  .filter-toggle-btn:hover {
    border-color: var(--color-primary, #1c497c);
    color: var(--color-primary, #1c497c);
  }
  .filter-toggle-btn.active,
  .filter-toggle-btn.has-filters {
    border-color: var(--color-primary, #1c497c);
    color: var(--color-primary, #1c497c);
    background: color-mix(in srgb, var(--color-primary, #1c497c) 10%, var(--content-bg, white));
  }
  .filter-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--color-primary, #1c497c);
    color: white;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
  }

  /* ── Collapsible Filters Panel ──
     Collapses via a 0fr → 1fr grid row rather than a fixed max-height: the
     panel is ~600px tall once .filters-grid drops to one column on phones,
     and any hardcoded cap clips it. The fr track always resolves to the
     panel's real height, so it can never cut off. */
  .filters-panel {
    display: grid;
    grid-template-rows: 0fr;
    /* visibility (delayed to the end of the collapse) takes the clipped
       controls out of the tab order everywhere; the panel's `inert` does the
       same but is a no-op on iOS Safari below 15.4. */
    visibility: hidden;
    transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s 0.3s;
  }
  .filters-panel.open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition-delay: 0s;
  }
  /* Clip lives on a bare wrapper, not the card: the card's own padding and
     border would floor the 0fr track and leave a sliver when collapsed. */
  .filters-panel__clip {
    min-height: 0;
    overflow: hidden;
  }
  .filters-panel__inner {
    background: var(--content-bg, #fff);
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: var(--radius-md, 0.5rem);
    padding: 1rem 1.25rem 1rem;
    margin-bottom: 0.75rem;
    box-shadow: var(--shadow-sm);
  }

  /* Filter panel section title */
  .filters-panel-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-900, #111827);
    padding-left: 0.625rem;
    border-left: 2px solid var(--color-primary, #1c497c);
    margin: 0 0 0.875rem;
    line-height: 1.2;
  }
  .filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 0.875rem;
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gray-400, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .filter-select {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--input-border, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    font-size: 0.8125rem;
    color: var(--input-text, #374151);
    background: var(--input-bg, #fff);
  }
  .filter-select:focus {
    outline: none;
    border-color: var(--color-primary, #1c497c);
    box-shadow: 0 0 0 2px rgba(28,73,124,0.12);
  }
  .filter-range {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .filter-range__sep {
    color: var(--color-gray-400, #9ca3af);
    font-size: 0.875rem;
  }
  .filter-input-num {
    width: 70px;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--input-border, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    font-size: 0.8125rem;
    color: var(--input-text, #374151);
    text-align: center;
    background: var(--input-bg, #fff);
  }
  .filter-input-num:focus {
    outline: none;
    border-color: var(--color-primary, #1c497c);
    box-shadow: 0 0 0 2px rgba(28,73,124,0.12);
  }
  .filters-row-bottom {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-gray-100, #f3f4f6);
  }
  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-gray-600, #4b5563);
    cursor: pointer;
    user-select: none;
  }
  .filter-checkbox input {
    accent-color: var(--color-primary, #1c497c);
  }
  .filter-clear-btn {
    margin-left: auto;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--content-border, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    background: var(--content-bg, #fff);
    color: var(--color-gray-500, #6b7280);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-clear-btn:hover {
    border-color: var(--color-gray-400, #9ca3af);
    color: var(--color-gray-700, #374151);
    background: var(--color-gray-50, #f9fafb);
  }

  /* ── Show More ── */
  .show-more-wrapper {
    display: flex;
    justify-content: center;
    padding: 1.25rem 0 0;
  }
  .show-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 2rem;
    border: 1px solid var(--content-border, #dee2e6);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--content-bg, #fff);
    color: var(--color-primary, #1c497c);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .show-more-btn__icon {
    width: 16px;
    height: 16px;
  }
  .show-more-btn:hover {
    border-color: var(--color-primary, #1c497c);
    background: var(--color-primary, #1c497c);
    color: white;
    box-shadow: var(--shadow-md);
  }

  /* ── Table ── */
  .table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-md, 0.5rem);
    background: var(--content-bg, #fff);
    box-shadow: var(--shadow-sm);
    margin-top: 0.5rem;
  }

  /* Dark mode: raised-card ring (light stays borderless) */
  :global(html.dark) .table-wrapper {
    box-shadow:
      0 0 0 1px var(--content-border, #555555),
      var(--shadow-lg);
  }
  .players-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .players-table thead {
    background: var(--color-gray-50, #f9fafb);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--content-border, #e2e8f0);
  }
  .players-table thead tr {
    border-left: 3px solid var(--color-gray-100, #f3f4f6);
  }
  .players-table th {
    padding: 0.5rem 0.375rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-400, #9ca3af);
  }
  .players-table th:first-child {
    padding-left: 0.75rem;
  }
  .players-table th.last-visible-col {
    padding-right: 0.75rem;
  }
  .players-table th.sortable {
    cursor: pointer !important;
    user-select: none;
    -webkit-user-select: none;
  }
  :global(.players-table th.sortable *) {
    cursor: pointer !important;
  }
  .players-table th.sortable:hover {
