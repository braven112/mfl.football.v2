---
/**
 * Transactions (theleague) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/transactions/TransactionsPage.
 *
 * The feed listings live HERE, not in the shared component: reading both
 * leagues there would put the other league's seasons on every render.
 *
 * LAZY, which is the whole point: the keys answer "which seasons exist" for
 * free, while only the season being viewed is actually read — through the
 * league-data loader (src/utils/league-data.ts), so none of it is bundled
 * into the function. TheLeague's transactions archive is ~3 MB. A missing
 * feed is simply absent from the listing, so a league whose feed a workflow
 * has not written yet still builds and renders.
 */
import TransactionsPage from '../../components/shared/transactions/TransactionsPage.astro';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;

const league = getLeagueBySlug('theleague')!;
// Lazy `{ path: () => data }` maps, the shape the old lazy globs had.
const lazyFeeds = (...patterns: string[]) =>
  Object.fromEntries(
    patterns.flatMap((pattern) => listLeagueData(pattern)).map((path) => [path, () => loadLeagueData(path)]),
  );
const transactionFeeds = lazyFeeds(`${league.dataPath}/mfl-feeds/*/transactions.json`);
const leagueFeeds = lazyFeeds(`${league.dataPath}/mfl-feeds/*/league.json`);
// Schefter's feed and its archive years, for the story on each move. Same
// lazy shape: only the files for the season being viewed are read. (The
// active feed's entry is answered live from Redis inside the page.)
const schefterFeedPath =
  (league as { schefterFeedPath?: string }).schefterFeedPath ?? `${league.dataPath}/schefter-feed.json`;
const schefterPosts = lazyFeeds(
  schefterFeedPath,
  `${schefterFeedPath.replace(/[^/]+$/, '')}schefter-archive/*.json`,
);
---

<TransactionsPage leagueSlug="theleague" transactionFeeds={transactionFeeds} leagueFeeds={leagueFeeds} schefterPosts={schefterPosts} />
