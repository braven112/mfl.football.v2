---
/**
 * Top Players (The League) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/top-players/TopPlayersPage.
 *
 * The derived file is read HERE, through the league-data loader (never
 * bundled), so the shared component stays league-neutral and one league's
 * route never reads the other league's leaderboard.
 */
import TopPlayersPage from '../../components/shared/top-players/TopPlayersPage.astro';
import { loadLeagueData } from '../../utils/league-data';
import { getLeagueBySlug } from '../../config/leagues';
import { resolveTopPlayersView } from '../../utils/top-players-view';
import { resolveLeaguePath } from '../../utils/nav-utils';
import type { TopPlayersFile } from '../../types/top-players';

export const prerender = false;

const data = (await loadLeagueData(
  `${getLeagueBySlug('theleague')!.dataPath}/derived/top-players.json`,
)) as unknown as TopPlayersFile;
const basePath = resolveLeaguePath(
  '/theleague/top-players',
  Astro.locals.hideLeaguePrefix ?? false
);
const view = resolveTopPlayersView(Astro.url, data);
---

<TopPlayersPage leagueSlug="theleague" data={data} view={view} basePath={basePath} />
