---
/**
 * The Gauntlet — TheLeague schedule-strength dashboard.
 * Data: data/theleague/derived/schedule-strength-<year>-w<NN>.json, written
 * weekly by scripts/compute-schedule-strength.mjs (Wednesday cron + prebuild).
 */
import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import GauntletDashboard from '../../components/shared/schedule-strength/GauntletDashboard.astro';
import { resolveGauntletViewLazy, resolveGauntletViewerTeam, type GauntletDerived } from '../../utils/schedule-strength';
import { getCurrentSeasonYear } from '../../utils/league-year';
import { getLeaguePersona } from '../../utils/persona-server';
import { personaLabels } from '../../utils/persona.mjs';
import leagueConfig from '../../data/theleague.config.json';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';
import { getLeagueBySlug } from '../../config/leagues';

// Lazy: weekly issues are retained forever (published articles point at
// them), so only the selected year's latest file is read per request —
// through the league-data loader, never bundled into the function.
const files: Record<string, () => Promise<GauntletDerived>> = Object.fromEntries(
  listLeagueData(`${getLeagueBySlug('theleague')!.dataPath}/derived/schedule-strength-*.json`).map((path) => [
    path,
    () => loadLeagueData<GauntletDerived>(path) as Promise<GauntletDerived>,
  ]),
);

const view = await resolveGauntletViewLazy({
  files,
  teams: leagueConfig.teams,
  baseUrl: '/theleague',
  pagePath: '/theleague/schedule-strength',
  requestedYear: Astro.url.searchParams.get('year'),
});

const myTeamId = resolveGauntletViewerTeam('theleague', Astro.cookies, Astro.request);

const byline = personaLabels(await getLeaguePersona('theleague')).column;

const title = view.data
  ? `The Gauntlet · ${view.seasonComplete ? `${view.year} Final` : `Week ${view.data.week}`} Schedule Strength`
  : 'The Gauntlet · Schedule Strength';
---

<TheLeagueLayout title={title}>
  <div class="gauntlet-page">
    <Breadcrumbs items={[
      { label: 'The League', href: '/theleague' },
      { label: 'Schedule Strength' },
    ]} />
    <GauntletDashboard
      columnName={view.data?.columnName ?? 'The Gauntlet'}
      byline={byline}
      week={view.data?.week ?? 0}
      year={view.year ?? getCurrentSeasonYear()}
      runIn={view.runIn}
      played={view.played}
      scheduleLuck={view.scheduleLuck}
      heatMapFranchises={view.heatMapFranchises}
      heatMapWeeks={view.heatMapWeeks}
      trapWeeks={view.trapWeeks}
      yearOptions={view.yearOptions}
      seasonComplete={view.seasonComplete}
      scheduleSwap={view.scheduleSwap}
      scheduleSwapThroughWeek={view.scheduleSwapThroughWeek}
      myTeamId={myTeamId}
    />
  </div>
</TheLeagueLayout>

<style>
  .gauntlet-page { min-height: 60vh; }
</style>
