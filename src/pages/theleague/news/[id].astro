---
/**
 * Schefter Article Detail Page
 *
 * Renders full-length articles from the Schefter feed.
 * Follows the What's New editorial pattern with author card and metadata.
 * Server-rendered so the theleague.us middleware rewrite works correctly
 * (prerendered static files bypass middleware on Vercel).
 */

import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../../components/shared/Breadcrumbs.astro';
import SchefterReactionBar from '../../../components/shared/SchefterReactionBar.tsx';
import { formatRelativeTime } from '../../../utils/schefter-feed';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getAuthor, getAuthorAvatar } from '../../../types/schefter';
import { getLeaguePersona, postByline } from '../../../utils/persona-server';
import { personaLabels } from '../../../utils/persona.mjs';
import { getSchefterFeedBySlug } from '../../../utils/schefter-league-data';
import type { SchefterFeed, SchefterPost, AuctionGrade } from '../../../types/schefter';
import '../../../styles/schefter-feed.css';
import '../../../styles/schefter-article.css';
import GauntletArticleSection from '../../../components/shared/schedule-strength/GauntletArticleSection.astro';
import MatchupPreviewSection from '../../../components/shared/matchup-preview/MatchupPreviewSection.astro';
import type { GauntletDerived } from '../../../utils/schedule-strength';
import leagueConfig from '../../../data/theleague.config.json';

// The Gauntlet articles render their rankings from the same derived JSON the
// dashboard uses (single source of truth — article and page cannot disagree).
// Lazy glob: GauntletArticleSection imports only the matching issue, and only
// for posts that carry a scheduleStrength pointer.
const gauntletFiles = import.meta.glob<GauntletDerived>(
  '../../../../data/theleague/derived/schedule-strength-*.json',
  { import: 'default' }
);

// Posts older than the active window live in per-year archive files (see
// scripts/lib/schefter-archive.mjs). Lazy glob: an archive year is only
// loaded when the active feed misses, so permalinks to archived articles
// keep resolving without the archive riding in this page's chunk.
const archiveFiles = import.meta.glob<{ posts?: SchefterPost[] } | SchefterPost[]>(
  '../../../data/theleague/schefter-archive/*.json',
  { import: 'default' }
);

const { id } = Astro.params;
const feed = await getSchefterFeedBySlug('theleague');
const isArticle = (p: SchefterPost) => p.type === 'article' && p.id === id && (p.content || p.grades);
let post = feed.posts.find(isArticle);

if (!post) {
  // Newest archive year first — recent rollouts are the likeliest hits.
  const years = Object.keys(archiveFiles).sort().reverse();
  for (const key of years) {
    const data = await archiveFiles[key]();
    const posts = Array.isArray(data) ? data : (data?.posts ?? []);
    const hit = (posts as SchefterPost[]).find(isArticle);
    if (hit) {
      post = hit;
      break;
    }
  }
}

if (!post) {
  return Astro.redirect('/theleague/news');
}
// Masthead and byline follow the league's persona (src/utils/persona.mjs).
const labels = personaLabels(await getLeaguePersona('theleague'));
const byAuthor = getAuthor(post.authorId);
const byline = await postByline({ league: 'theleague' }, byAuthor, getAuthorAvatar(byAuthor));
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(path, hideLeaguePrefix);
const imagePath = post.image ? `/assets/schefter/${post.image}` : null;
const formattedDate = new Date(post.timestamp).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const isGradeArticle = !!(post.grades && post.grades.length > 0);


function gradeColor(grade: string): string {
  const letter = grade.charAt(0);
  if (letter === 'A') return '#16a34a'; // green
  if (letter === 'B') return '#2563eb'; // blue
  if (letter === 'C') return '#d97706'; // amber
  if (letter === 'D') return '#ea580c'; // orange
  return '#dc2626'; // red for F
}
---

<TheLeagueLayout title={`${post.headline} — ${labels.report}`}>
  <div class="sf-article">

    <Breadcrumbs items={[
      { label: 'The League', href: '/theleague' },
      { label: labels.report, href: '/theleague/news' },
      { label: post.headline },
    ]} />

    <div class="ui-card sf-article__card">
      <!-- Hero image -->
      {imagePath && (
        <div class="sf-article__hero-wrap">
          <img
            src={imagePath}
            alt={post.imageAlt ?? post.headline}
            class="sf-article__hero-img"
            loading="eager"
          />
        </div>
      )}

      <!-- Header -->
      <div class="sf-article__header">
        <div class="sf-article__meta">
          <span class="ui-badge ui-badge--caps sf-article__badge">Article</span>
          <span class="sf-article__meta-dot" aria-hidden="true"></span>
          <time class="sf-article__date" datetime={post.timestamp}>{formattedDate}</time>
        </div>

        <h1 class="sf-article__title">{post.headline}</h1>

        <!-- Author row -->
        <div class="sf-article__author">
          <img class="sf-article__author-avatar" src={byline.avatar} alt="" aria-hidden="true" width="32" height="32" />
          <div>
            <span class="sf-article__author-name">{byline.name}</span>
            <span class="sf-article__author-handle">{byline.handle}</span>
          </div>
        </div>
      </div>

      <!-- The Gauntlet: the Run-In chart leads; the column reads under it -->
      <GauntletArticleSection
        gauntletRef={post.scheduleStrength}
        files={gauntletFiles}
        teams={leagueConfig.teams}
        baseUrl="/theleague"
        dashboardHref={r('/theleague/schedule-strength')}
        part="chart"
      />

      <!-- Matchup Preview: the Game of the Week rivalry panel leads the copy -->
      <MatchupPreviewSection
        visuals={post.matchupVisuals}
        teams={leagueConfig.teams}
        rivalriesBase={r('/theleague/rivalries')}
        part="top"
      />

      <!-- Article body -->
      {isGradeArticle ? (
        <Fragment>
        <div class="sf-article__body">
          {/* Intro paragraphs */}
          {post.intro?.map(paragraph => (
            <p set:html={paragraph} />
          ))}
        </div>

        <div class="sf-grades">
          {post.grades!.map((g: AuctionGrade) => (
            <div class="ui-card sf-grade-card" style={`--grade-accent: ${g.color || '#666'};`}>
              <div class="sf-grade-card__header">
                <img class="sf-grade-card__icon" src={`/assets/theleague/icons/${g.franchiseId}.png`} alt="" width="36" height="36" />
                <div class="sf-grade-card__team">
                  <span class="sf-grade-card__team-name">{g.teamName}</span>
                  <span class="sf-grade-card__headline">{g.headline}</span>
                </div>
                <div class="ui-badge sf-grade-card__badge" style={`--grade-color: ${gradeColor(g.grade)};`}>
                  {g.grade}
                </div>
              </div>

              <div class="sf-grade-card__body" set:html={g.body} />

              <div class="sf-grade-card__stats">
                <div class="sf-grade-card__stat">
                  <span class="sf-grade-card__stat-value">{g.playerCount}</span>
                  <span class="sf-grade-card__stat-label">Players</span>
                </div>
                <div class="sf-grade-card__stat">
                  <span class="sf-grade-card__stat-value">{g.auctionSpendDisplay}</span>
                  <span class="sf-grade-card__stat-label">Spent</span>
                </div>
                <div class="sf-grade-card__stat">
                  <span class="sf-grade-card__stat-value">{g.postCapSpaceDisplay}</span>
                  <span class="sf-grade-card__stat-label">Cap Left</span>
                </div>
              </div>

              {/* Acquisitions list */}
              {g.pickups && g.pickups.length > 0 && (
                <div class="sf-grade-card__pickups">
                  <span class="sf-grade-card__pickups-title">Acquisitions</span>
                  <div class="sf-grade-card__pickups-list">
                    {g.pickups.map(p => (
                      <div class="sf-grade-card__pickup">
                        <span class="sf-grade-card__pickup-pos">{p.position}</span>
                        <span class="sf-grade-card__pickup-name">{p.name}</span>
                        <span class="sf-grade-card__pickup-salary">{p.salary}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Holes remaining warning */}
              {g.holesRemaining && g.holesRemaining.length > 0 && (
                <div class="sf-grade-card__holes">
                  Still need: {g.holesRemaining.join(', ')}
                </div>
              )}
            </div>
          ))}
        </div>
        </Fragment>
      ) : (
        <div class="sf-article__body">
          {post.content?.map(paragraph => (
            <p set:html={paragraph} />
          ))}
        </div>
      )}

      <!-- Matchup Preview: a tale-of-the-tape card for every matchup, under the copy -->
      <MatchupPreviewSection
        visuals={post.matchupVisuals}
        teams={leagueConfig.teams}
        rivalriesBase={r('/theleague/rivalries')}
        part="cards"
      />

      <!-- The Gauntlet: luck, trap weeks + dashboard CTA (the chart sits above the copy) -->
      <GauntletArticleSection
        gauntletRef={post.scheduleStrength}
        files={gauntletFiles}
        teams={leagueConfig.teams}
        baseUrl="/theleague"
        dashboardHref={r('/theleague/schedule-strength')}
        part="details"
      />

      <!-- Reactions -->
      <div class="sf-article__reactions">
        <SchefterReactionBar
          client:visible
          postId={post.id}
          isAuthenticated={false}
        />
      </div>

      <!-- Back to feed -->
      <div class="sf-article__footer">
        <a href={r('/theleague/news')} class="sf-article__footer-link">
          ← More from {labels.report}
        </a>
      </div>
    </div>
  </div>
</TheLeagueLayout>
