---
/**
 * The Pecking Order (TheLeague) — landing page.
 *
 * Thin wrapper over the shared landing component: reads this league's issue
 * JSON and hands it over. Which
 * state the page renders — live issue vs. preseason preview — is decided in
 * PeckingOrderLanding, so both leagues stay in step.
 * Permalink to a specific issue lives at /theleague/pecking-order/[year]/[week].
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../../components/shared/Breadcrumbs.astro';
import PeckingOrderLanding from '../../../components/shared/PeckingOrderLanding.astro';
import { type PeckingOrderData } from '../../../components/shared/PeckingOrderIssue.astro';
import { resolvePeckingOrderLanding } from '../../../utils/pecking-order-landing';
import { getTestDateFromSearchParams } from '../../../utils/league-year';
import { listLeagueData, loadLeagueData } from '../../../utils/league-data';
import { getLeagueBySlug } from '../../../config/leagues';

// Every issue is listed by the landing, so all are read — through the
// league-data loader, never bundled into the function.
const issueFiles: Record<string, PeckingOrderData | null> = Object.fromEntries(
  await Promise.all(
    listLeagueData(`${getLeagueBySlug('theleague')!.dataPath}/pecking-order/*.json`).map(
      async (path) => [path, await loadLeagueData<PeckingOrderData>(path)] as const,
    ),
  ),
);

const issues = Object.entries(issueFiles)
  .map(([file, data]) => {
    const m = file.match(/(\d{4})-(\d{1,2})\.json$/);
    if (!m) return null;
    return {
      year: parseInt(m[1], 10),
      week: parseInt(m[2], 10),
      data: data as PeckingOrderData,
    };
  })
  .filter((x): x is { year: number; week: number; data: PeckingOrderData } => x !== null);

// `?testDate=YYYY-MM-DD` shifts the reference date server-side so the preview
// and live states can both be checked out of season.
const now = getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined;

// Resolved twice (here and in the component) rather than threaded through as a
// prop: the title needs the state before the body renders, and the resolver is
// pure sorting + a date compare.
const { mode, latest } = resolvePeckingOrderLanding(issues, now);

const title = mode === 'live' && latest
  ? `${latest.data.headline} · The Pecking Order · Week ${latest.week}`
  : 'The Pecking Order — Weekly Power Rankings';
---

<TheLeagueLayout title={title}>
  <div class="pr-page">
    <Breadcrumbs items={[
      { label: 'The League', href: '/theleague' },
      { label: 'The Pecking Order' },
    ]} />

    <PeckingOrderLanding
      issues={issues}
      league="theleague"
      basePath="/theleague/pecking-order"
      now={now}
    />
  </div>
</TheLeagueLayout>

<style>
.pr-page { min-height: 60vh; }
</style>
