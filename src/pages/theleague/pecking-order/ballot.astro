---
/**
 * The Owners' Poll ballot (TheLeague) — thin route wrapper.
 *
 * Shared implementation lives in
 * components/shared/owners-poll/OwnersPollBallotPage.
 *
 * Two things live HERE and must:
 *  - the auth gate, because `Astro.redirect()` only redirects from a page
 *    (returned from a component it just stops rendering and serves a blank
 *    200);
 *  - the issue glob, because Vite requires a literal glob pattern — the league
 *    can't be interpolated, and globbing both leagues here would ship the
 *    other league's issues on every render.
 *
 * One segment, so it cannot collide with the sibling [year]/[week] permalink,
 * which needs two.
 */
import OwnersPollBallotPage, {
  type BallotStandingsRow,
} from '../../../components/shared/owners-poll/OwnersPollBallotPage.astro';
import { resolveOwnersPollAccess } from '../../../utils/owners-poll-access';

export const prerender = false;

const access = resolveOwnersPollAccess(Astro.request, Astro.url);
if (!access) {
  return Astro.redirect('/theleague');
}

const issueFiles = import.meta.glob<{ standings?: { divisions?: Array<{ teams?: BallotStandingsRow[] }> } }>(
  '../../../../data/theleague/pecking-order/*.json',
  { eager: true, import: 'default' },
);

// Newest issue by <year>-<week>, for the record/PPG shown on each card. Purely
// cosmetic context: an empty list just drops the record line, it never blocks
// the ballot.
const latest = Object.entries(issueFiles)
  .map(([file, data]) => {
    const m = file.match(/(\d{4})-(\d{1,2})\.json$/);
    return m ? { year: Number(m[1]), week: Number(m[2]), data } : null;
  })
  .filter((x): x is { year: number; week: number; data: (typeof issueFiles)[string] } => x !== null)
  .sort((a, b) => b.year - a.year || b.week - a.week)[0];

const standings: BallotStandingsRow[] = (latest?.data?.standings?.divisions ?? []).flatMap(
  (division) => division.teams ?? [],
);
---

<OwnersPollBallotPage league={access.league} user={access.user} standings={standings} />
