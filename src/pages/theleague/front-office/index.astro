---
/**
 * Front Office hub (TheLeague) — thin route wrapper.
 *
 * Everything below the shell is `FrontOfficePanel`, shared with the AFL.
 * Three things stay HERE, in the route, and each for its own reason:
 *
 * - The auth read, because `isAuthorizedForLeague` decides whose franchise
 *   this is (both leagues have a franchise 0001).
 * - The cookie WRITE. `Astro.cookies.set()` from an imported component runs
 *   after the response headers are committed and throws, blanking the page.
 *   Reading a cookie is fine anywhere.
 * - Nothing else. Keep this file under 80 lines or it joins the fork
 *   ratchet (tests/page-fork-ratchet.test.ts).
 */
import FrontOfficeHubPage from '../../../components/shared/front-office-hub/FrontOfficeHubPage.astro';
import FrontOfficeTeamSwitcher from '../../../components/shared/front-office-hub/FrontOfficeTeamSwitcher.astro';
import FrontOfficePanel from '../../../components/shared/front-office-hub/FrontOfficePanel.astro';
import { buildFrontOfficePanelData } from '../../../utils/front-office-panel-data';
import { getAuthUser, isAuthorizedForLeague } from '../../../utils/auth';
import { getLeagueBySlug } from '../../../config/leagues';
import {
  getTheLeaguePreference,
  setTheLeaguePreference,
  resolveTeamSelection,
} from '../../../utils/team-preferences';

export const prerender = false;

const league = getLeagueBySlug('theleague')!;
const user = getAuthUser(Astro.request);
const myFranchiseId = user && isAuthorizedForLeague(user, league.id) ? user.franchiseId : null;

// Team selection: query param > cookie > signed-in owner > first team.
// Mirrors rosters.astro's own resolution exactly (same priority order, same
// param names) so a bookmarked `?myteam=`/`?franchise=` link behaves
// identically on both pages.
const myTeamParam = Astro.url.searchParams.get('myteam');
const franchiseParam =
  Astro.url.searchParams.get('franchise') ??
  Astro.url.searchParams.get('team') ??
  Astro.url.searchParams.get('franchiseId');

// Cookie WRITE — route frontmatter only, before anything touches the response.
if (myTeamParam) {
  setTheLeaguePreference(Astro.cookies, myTeamParam);
}
const cookiePreference = getTheLeaguePreference(Astro.cookies);

const selectedTeamId = resolveTeamSelection({
  myTeamParam,
  franchiseParam,
  cookiePreference: cookiePreference?.franchiseId,
  authUserFranchise: myFranchiseId,
});

const data = await buildFrontOfficePanelData({
  leagueSlug: 'theleague',
  selectedTeamId,
  viewerFranchiseId: myFranchiseId,
});

const myTeamRow = myFranchiseId ? data.teamsList.find((t) => t.id === myFranchiseId) : null;
const myTeam = myTeamRow ? { id: myTeamRow.id, name: myTeamRow.name, icon: myTeamRow.icon } : null;
---

<FrontOfficeHubPage leagueSlug="theleague" myTeam={myTeam} leagueYear={data.leagueYear}>
  <FrontOfficeTeamSwitcher slot="switcher" teams={data.teamsList} selectedTeamId={selectedTeamId} />
  <FrontOfficePanel {...data} />
</FrontOfficeHubPage>
