---
/**
 * Front Office hub (TheLeague) — thin route wrapper.
 *
 * Shared render lives in components/shared/front-office-hub/FrontOfficeHubPage.
 * No data assembly beyond resolving the signed-in owner's team, so nothing is
 * extracted to a utils/front-office-hub-data.ts the way the Draft Hub needed —
 * see that component's header comment for why a live-state band was rejected.
 */
import FrontOfficeHubPage from '../../../components/shared/front-office-hub/FrontOfficeHubPage.astro';
import leagueConfigData from '../../../data/theleague.config.json';
import { getAuthUser, isAuthorizedForLeague } from '../../../utils/auth';
import { getLeagueBySlug } from '../../../config/leagues';
import { resolveConfigForYear } from '../../../utils/team-names';
import { getLeagueYearForSlug } from '../../../utils/league-year';

export const prerender = false;

// Both leagues have a franchise 0001 — without this check a TheLeague owner
// browsing the AFL would be shown their own franchise id's AFL team.
const league = getLeagueBySlug('theleague')!;
const user = getAuthUser(Astro.request);
const myFranchiseId = user && isAuthorizedForLeague(user, league.id) ? user.franchiseId : null;
// Roster-management clock (Feb 14), not the season clock — every page this
// hub links to is contracts/cap/trades/roster-shaped.
const leagueYear = getLeagueYearForSlug('theleague');
const teams = resolveConfigForYear(leagueConfigData as any, leagueYear).teams ?? [];
const myTeam = myFranchiseId
  ? (() => {
      const t = teams.find((t: any) => t.franchiseId === myFranchiseId);
      return t ? { id: t.franchiseId, name: t.name, icon: t.icon } : null;
    })()
  : null;
---

<FrontOfficeHubPage leagueSlug="theleague" myTeam={myTeam} leagueYear={leagueYear} />
