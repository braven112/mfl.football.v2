---
/**
 * Submit Lineup — /theleague/lineup
 *
 * Thin route wrapper. The page itself is
 * `src/components/shared/lineup/LineupPage.astro`, rendered for both leagues.
 *
 * Three things stay HERE rather than moving into the shared component:
 *
 *  - **The auth gate.** `Astro.redirect()` only redirects from a PAGE.
 *    Returning it from a component's frontmatter just stops rendering that
 *    component — the response is still a 200, now with a blank body. That
 *    exact mistake shipped when /cr's gate moved into a shared component.
 *  - **The league year.** TheLeague's rolls at Feb 14; the AFL's at June 1.
 *  - **`resolveBrands`.** TheLeague's faceoff panels resolve Throwback Week
 *    identities from an async store; the AFL reads afl.config.json. Called
 *    once with every franchise on the strip, so a double-header week doesn't
 *    re-read the store per card.
 */
export const prerender = false;

import LineupPage from '../../components/shared/lineup/LineupPage.astro';
import type { LineupBrand } from '../../types/lineups';
import { getAuthUser } from '../../utils/auth';
import { getCurrentLeagueYear } from '../../utils/league-year';
import { getThrowbackFranchiseBrand } from '../../utils/franchise-brand';
import { isThrowbackWeek } from '../../data/theleague/throwback-config';
import { getAllThrowbackPreferences } from '../../utils/throwback-store';

const user = getAuthUser(Astro.request);
if (!user?.franchiseId) {
  return Astro.redirect('/theleague/login?redirect=/theleague/lineup');
}

// During a Throwback Week the chip name swaps to the franchise's resolved
// legacy identity; colors and watermark are unaffected.
async function resolveBrands(
  franchiseIds: string[],
  week: number,
): Promise<(franchiseId: string) => LineupBrand> {
  const throwbackActive = isThrowbackWeek(week);
  const overrides = throwbackActive ? await getAllThrowbackPreferences(franchiseIds) : {};
  return (franchiseId: string) => {
    const brand = getThrowbackFranchiseBrand(
      franchiseId,
      throwbackActive,
      overrides[franchiseId],
    );
    return { name: brand.name, color: brand.color, watermark: brand.groupMe };
  };
}
---

<LineupPage
  leagueSlug="theleague"
  leagueYear={getCurrentLeagueYear()}
  franchiseId={user.franchiseId}
  basePath="/theleague/lineup"
  submitEndpoint="/api/lineup"
  draftStorageKey="lineup-draft"
  resolveBrands={resolveBrands}
/>
