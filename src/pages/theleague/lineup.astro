---
/**
 * Set Lineup (TheLeague) — thin route wrapper around the shared lineup page
 * (components/shared/lineup/LineupPage), which the AFL and the custom-site
 * demo's keeper slot render too.
 *
 * The auth gate stays HERE: `Astro.redirect()` only redirects from a page.
 * It deliberately asks only for a franchise, not a TheLeague-scoped session:
 * that is how this page has always gated, and tests/lineup-route-merge.test.ts
 * pins the API side of it — /api/lineup always targets TheLeague whatever
 * league the session names, so the write cannot land in the wrong league.
 * The login keeps the requested path + query (e.g. ?week=12).
 */
import LineupPage from '../../components/shared/lineup/LineupPage.astro';
import leagueConfig from '../../data/theleague.config.json';
import { getAuthUser } from '../../utils/auth';
import { loginUrlForRequest } from '../../utils/login-redirect';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;

const league = getLeagueBySlug('theleague')!;
const user = getAuthUser(Astro.request);
if (!user?.franchiseId) return Astro.redirect(loginUrlForRequest(Astro, league));
---

<LineupPage league={league} config={leagueConfig} user={{ ...user, franchiseId: user.franchiseId }} throwbackScope="theleague" />
