---
/**
 * Schedule (The League) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/schedule/SchedulePage.
 *
 * The feeds and the config are read HERE so the shared component stays
 * league-neutral and never reads the other league's seasons.
 *
 * The viewer's franchise is resolved here too: `franchiseIdForLeague` is the
 * one answer to "is this visitor an owner HERE" — both leagues have a
 * franchise 0001, so a bare franchiseId would show a TheLeague owner the AFL
 * club with the same id. Null covers signed out, signed into the other league,
 * and no franchise, and the page falls back to the league grid for all three.
 */
import SchedulePage from '../../components/shared/schedule/SchedulePage.astro';
import leagueConfig from '../../data/theleague.config.json';
import { franchiseIdForLeague, getAuthUser } from '../../utils/auth';
import { getLeagueBySlug } from '../../config/leagues';
import { listLeagueData, loadLeagueData } from '../../utils/league-data';

export const prerender = false;

const league = getLeagueBySlug('theleague')!;

// SchedulePage picks the season from every year's schedule (the newest one
// with games), so every season is read — through the league-data loader,
// never bundled into the function — and handed over in the `{ path: data }`
// shape the old eager globs had.
const loadAll = async (pattern: string): Promise<Record<string, unknown>> =>
  Object.fromEntries(
    await Promise.all(listLeagueData(pattern).map(async (path) => [path, await loadLeagueData(path)] as const)),
  );
const [scheduleFeeds, standingsFeeds] = await Promise.all([
  loadAll(`${league.dataPath}/mfl-feeds/*/schedule.json`),
  loadAll(`${league.dataPath}/mfl-feeds/*/standings.json`),
]);
const viewerFranchiseId = franchiseIdForLeague(getAuthUser(Astro.request), league.id);
---

<SchedulePage
  leagueSlug="theleague"
  config={leagueConfig}
  scheduleFeeds={scheduleFeeds}
  standingsFeeds={standingsFeeds}
  viewerFranchiseId={viewerFranchiseId}
/>
