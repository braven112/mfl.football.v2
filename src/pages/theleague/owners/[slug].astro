---
/**
 * Owner detail (The League) — thin route wrapper.
 *
 * The redirect lives HERE, not in the shared component: Astro only honours
 * `Astro.redirect()` from a page, and returning it from a component renders a
 * blank 200 instead of bouncing.
 */
import OwnerDetailPage from '../../../components/shared/owners/OwnerDetailPage.astro';
import { resolveOwnerDetail } from '../../../utils/owner-detail';
import type { OwnerTenuresFile } from '../../../types/owner-tenures';
import { loadLeagueData } from '../../../utils/league-data';
import { getLeagueBySlug } from '../../../config/leagues';

// Read through the league-data loader, never bundled into the function
// (src/utils/league-data.ts).
const THELEAGUE_DATA = getLeagueBySlug('theleague')!.dataPath;
const [ownerData, historyData] = (await Promise.all([
  loadLeagueData(`${THELEAGUE_DATA}/derived/owner-tenures.json`),
  loadLeagueData(`${THELEAGUE_DATA}/derived/league-history.json`),
])) as [any, any];

export const prerender = false;

const result = resolveOwnerDetail(Astro, 'theleague', ownerData as unknown as OwnerTenuresFile);
if (result.redirectTo !== undefined) return Astro.redirect(result.redirectTo);
---

<OwnerDetailPage leagueSlug="theleague" owner={result.owner} related={result.related} historyData={historyData} />
