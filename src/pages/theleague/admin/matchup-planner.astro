---
/**
 * Matchup Planner — /theleague/admin/matchup-planner. Brandon's alone.
 *
 * Thin wrapper: the gate + layout. The gate is the site owner's own
 * franchise session in this league (isSiteOwnerIn), the same gate as My
 * Rankings: this is one person's planning tool, not a commissioner page.
 * View: components/shared/MatchupPlannerPage.astro.
 */
export const prerender = false;

import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import MatchupPlannerPage from '../../../components/shared/MatchupPlannerPage.astro';
import { getAuthUser } from '../../../utils/auth';
import { loginUrlForRequest, forbiddenPathFor } from '../../../utils/login-redirect';
import { getLeagueBySlug } from '../../../config/leagues';
import { isSiteOwnerIn } from '../../../utils/site-owner';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const league = getLeagueBySlug('theleague');
const user = getAuthUser(Astro.request);
if (!league) return Astro.redirect('/');
if (!user) return Astro.redirect(loginUrlForRequest(Astro, league));
// Every other session, commissioners included, gets the standard refusal.
if (!isSiteOwnerIn(user, league.slug)) return Astro.rewrite(forbiddenPathFor(league, 'commissioner'));
---

<TheLeagueLayout title="Matchup Planner">
  <MatchupPlannerPage routeSlug={league.slug} />
</TheLeagueLayout>
