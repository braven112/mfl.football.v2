---
/**
 * ESPN History pilot — /theleague/admin/espn-history
 *
 * League admin gate (same as every /admin page). Create an import for an ESPN
 * league id to mint its secret upload link, which the ESPN commissioner opens
 * on the MFL app host. Data lives in Redis, never in this public repo
 * (src/utils/espn-history.ts).
 */
export const prerender = false;

import TheLeagueLayout from '../../../../layouts/TheLeagueLayout.astro';
import { getAuthUser, isCommissionerOrAdmin, isAuthorizedForLeague } from '../../../../utils/auth';
import { loginUrlForRequest, forbiddenPathFor } from '../../../../utils/login-redirect';
import { getLeagueBySlug, SHARED_APP_ORIGIN } from '../../../../config/leagues';
import { getRedis } from '../../../../utils/redis-client';
import {
  ESPN_LEAGUE_ID,
  createEspnImport,
  listEspnImports,
  listSnapshots,
} from '../../../../utils/espn-history';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const user = getAuthUser(Astro.request);
const theLeague = getLeagueBySlug('theleague');
if (!user) return Astro.redirect(loginUrlForRequest(Astro, getLeagueBySlug('theleague')!));
if (!theLeague) return Astro.redirect('/theleague');
if (!isCommissionerOrAdmin(user) || !isAuthorizedForLeague(user, theLeague.id)) {
  return Astro.rewrite(forbiddenPathFor(theLeague, isCommissionerOrAdmin(user) ? 'league' : 'commissioner'));
}

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const origin = Astro.request.headers.get('origin');
  if (origin && origin !== Astro.url.origin) return new Response('Cross-origin request refused.', { status: 403 });
  const form = await Astro.request.formData();
  const leagueId = String(form.get('leagueId') ?? '').trim();
  const label = String(form.get('label') ?? '');
  if (!ESPN_LEAGUE_ID.test(leagueId)) {
    error = 'An ESPN league id is the number after leagueId= in the league page address.';
  } else {
    const created = await createEspnImport(leagueId, label);
    if (created) return Astro.redirect(Astro.url.pathname, 303);
    error = 'Storage is not configured, so the import could not be created.';
  }
}

const redisAvailable = Boolean(await getRedis());
const imports = await listEspnImports();
const rows = await Promise.all(
  imports.map(async (imp) => {
    const snaps = await listSnapshots(imp.leagueId);
    return {
      ...imp,
      link: new URL(`/history/import/${imp.token}`, SHARED_APP_ORIGIN).href,
      snapshots: snaps.length,
      seasons: [...new Set(snaps.map((s) => s.seasonId))].sort((a, b) => b - a),
    };
  }),
);
---

<TheLeagueLayout title="ESPN History — Admin">
  <div class="espn-admin">
    <h1>ESPN History (pilot)</h1>
    <p class="espn-admin__muted">
      Create an import for an ESPN league, then send its secret link to that league's commissioner. Anyone with the link can
      upload to that league, so send it privately.
    </p>

    {!redisAvailable && <p class="espn-admin__warn" role="alert">Storage is not configured in this environment.</p>}
    {error && <p class="espn-admin__warn" role="alert">{error}</p>}

    <form method="post" class="espn-admin__form">
      <label>ESPN league id <input name="leagueId" inputmode="numeric" pattern="\d{1,12}" required /></label>
      <label>Name (optional) <input name="label" maxlength="80" placeholder="Family league" /></label>
      <button type="submit" disabled={!redisAvailable}>Create import</button>
    </form>

    {rows.length === 0 ? (
      <p class="espn-admin__muted">No imports yet.</p>
    ) : (
      <div class="espn-admin__scroll">
        <table>
          <thead>
            <tr><th>League</th><th>Seasons received</th><th>Uploads</th><th>Commissioner's link</th><th></th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td><strong>{r.label}</strong><br /><span class="espn-admin__muted">ESPN {r.leagueId}</span></td>
                <td>{r.seasons.length ? r.seasons.join(', ') : '—'}</td>
                <td>{r.snapshots}</td>
                <td><input class="espn-admin__link" readonly value={r.link} aria-label={`Upload link for ${r.label}`} /></td>
                <td><a href={`/theleague/admin/espn-history/${r.leagueId}`}>Preview</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</TheLeagueLayout>

<style>
  .espn-admin { max-width: 960px; margin: 0 auto; padding: 16px 16px 64px; color: var(--page-text); }
  .espn-admin h1 { font-size: 1.5rem; margin: 0 0 8px; }
  .espn-admin__muted { color: var(--content-text-muted); }
  .espn-admin__warn { padding: 8px 12px; border-left: 4px solid var(--league-accent); background: var(--color-surface-3); border-radius: 6px; }
  .espn-admin__form { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; margin: 16px 0 24px; }
  .espn-admin__form label { display: grid; gap: 4px; font-size: 0.875rem; font-weight: 600; }
  .espn-admin__form input { padding: 8px; border: 1px solid var(--color-border-subtle); border-radius: 6px; background: var(--page-bg); color: var(--page-text); }
  .espn-admin__form button { padding: 9px 18px; font-weight: 600; color: var(--page-bg); background: var(--page-text); border: 0; border-radius: 6px; cursor: pointer; }
  .espn-admin__form button:disabled { opacity: 0.5; cursor: not-allowed; }
  .espn-admin__scroll { overflow-x: auto; }
  .espn-admin table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .espn-admin th, .espn-admin td { padding: 8px 10px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-border-subtle); }
  .espn-admin th { background: var(--color-surface-3); }
  .espn-admin a { color: var(--color-primary); font-weight: 600; }
  .espn-admin__link { width: 100%; min-width: 220px; font: 0.75rem ui-monospace, monospace; padding: 6px; border: 1px solid var(--color-border-subtle); border-radius: 4px; background: var(--page-bg); color: var(--page-text); }
</style>
