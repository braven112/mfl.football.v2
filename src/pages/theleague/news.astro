---
/**
 * The Schefter Report — TheLeague.
 *
 * Thin route wrapper; the page body is shared with the AFL
 * (components/shared/SchefterNewsPage.astro + utils/schefter-news-view.ts).
 * Only what cannot move stays here: the feed import (a static specifier cannot
 * be a runtime variable) and the decorations that are TheLeague's alone.
 */
export const prerender = false;

import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../components/theleague/Breadcrumbs.astro';
import SchefterNewsPage from '../../components/shared/SchefterNewsPage.astro';
import HottestDesksWidget from '../../components/theleague/HottestDesksWidget.astro';
import { getAuthUser } from '../../utils/auth';
import { getLeagueBySlug } from '../../config/leagues';
import { getFranchiseBrand } from '../../utils/franchise-brand';
import { resolveSchefterNewsView } from '../../utils/schefter-news-view';
import { loadHottestDesks, loadGroupMePosts } from '../../utils/schefter-news-loaders';
import { enrichPostsWithOgPreviews } from '../../utils/groupme-storage';
import type { SchefterFeed as FeedType } from '../../types/schefter';
import feedData from '../../data/theleague/schefter-feed.json';

const authUser = getAuthUser(Astro.request);
const [groupMePosts, hottestDesks] = await Promise.all([
  loadGroupMePosts(!!authUser),
  loadHottestDesks(),
]);

const view = await resolveSchefterNewsView({
  league: getLeagueBySlug('theleague')!,
  feed: feedData as FeedType,
  authUser,
  url: Astro.url,
  groupMePosts,
  hasGroupChat: true,
  // Open Graph previews for GroupMe links, server-side and Redis-cached.
  // Silent on failure — posts without previews fall back to link cards.
  enrichPosts: async (posts) => {
    try {
      await enrichPostsWithOgPreviews(posts);
    } catch (err) {
      console.warn('[news] OG enrichment failed:', err);
    }
  },
});

// Reply-composer avatar. The fallback brand carries empty strings, so an
// unknown franchise still lands on SchefterNewsPage's own defaults.
const brand = view.userFranchiseId ? getFranchiseBrand(view.userFranchiseId) : null;
---

<TheLeagueLayout title="League News" og={view.og}>
  <SchefterNewsPage
    view={view}
    isAuthenticated={!!authUser}
    userId={authUser?.id}
    userTeamName={brand?.name || undefined}
    userTeamIcon={brand?.icon || undefined}
    groupMePosts={groupMePosts}
    schefterArticles={view.featuredArticles}
    articleBasePath="/theleague/news"
    tipHref="/theleague/schefter/tip"
  >
    <Breadcrumbs slot="breadcrumbs" items={[
      { label: 'The League', href: '/theleague' },
      { label: 'The Schefter Report' },
    ]} />
    <HottestDesksWidget slot="rail" desks={hottestDesks} windowLabel="this week" />
  </SchefterNewsPage>
</TheLeagueLayout>
