---
/**
 * Owner Map (theleague) — thin route wrapper.
 *
 * Shared implementation lives in components/shared/owner-map/OwnerMapPage.
 * The auth gate lives HERE, not in the component:
 * Astro.redirect() only redirects from a PAGE. Per-league static data imports
 * also belong here — a static import specifier can't be a runtime variable.
 */
import OwnerMapPage from '../../components/shared/owner-map/OwnerMapPage.astro';
import { franchiseIdForLeague, getAuthUser, isAuthorizedForLeague, isCommissionerOrAdminForLeague } from '../../utils/auth';
import { readHometowns } from '../../utils/owner-hometowns';
import { getLeagueBySlug } from '../../config/leagues';
import ownerData from '../../../data/theleague/derived/owner-tenures.json';
import history from '../../../data/theleague/derived/franchise-history.json';
import type { OwnerTenuresFile } from '../../types/owner-tenures';
import type { OwnerMapHistory } from '../../utils/owner-map';

export const prerender = false;
const LEAGUE = getLeagueBySlug('theleague')!;

const user = getAuthUser(Astro.request);
if (!user || !isAuthorizedForLeague(user, LEAGUE.id)) {
  return Astro.redirect('/theleague');
}
const hometowns = await readHometowns(LEAGUE.slug);
---

<OwnerMapPage
  leagueSlug="theleague"
  data={ownerData as unknown as OwnerTenuresFile}
  history={history as unknown as OwnerMapHistory}
  myFranchiseId={franchiseIdForLeague(user, LEAGUE.id)}
  hometowns={hometowns}
  canEditAll={isCommissionerOrAdminForLeague(user, LEAGUE.id)}
/>
