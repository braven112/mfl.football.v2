---
/**
 * The League rivalries index — thin route wrapper around the shared League
 * History rivalries page (components/shared/league-history/HistoryRivalriesPage),
 * which replaced this league's own matrix (2026-10-26). The dataset import
 * stays here because a static import specifier can't be a runtime variable.
 * Public, like the rivalry pages it opens.
 */
import HistoryRivalriesPage from '../../../components/shared/league-history/HistoryRivalriesPage.astro';
import { loadLeagueData } from '../../../utils/league-data';
import { getLeagueBySlug } from '../../../config/leagues';

// Read through the league-data loader, never bundled into the function
// (src/utils/league-data.ts).
const THELEAGUE_DATA = getLeagueBySlug('theleague')!.dataPath;
const historyData: any = await loadLeagueData(`${THELEAGUE_DATA}/derived/league-history.json`);

export const prerender = false;
---

<HistoryRivalriesPage leagueSlug="theleague" data={historyData} />
