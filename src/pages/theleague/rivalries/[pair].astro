---
/**
 * TheLeague rivalry page — thin route wrapper around the shared League History
 * rivalry page (components/shared/league-history/HistoryRivalryPage), which
 * replaced TheLeague's own page (Brandon, 2026-10-25: upgrade in place). Its
 * trades and trophy case come in through the default slot.
 * The dataset imports and the redirects stay here: a static import specifier
 * can't be a runtime variable, and `Astro.redirect()` only redirects from a
 * page.
 */
import HistoryRivalryPage from '../../../components/shared/league-history/HistoryRivalryPage.astro';
import RivalryTrades from '../../../components/shared/rivalries/RivalryTrades.astro';
import TheLeagueRivalryTrophies from '../../../components/theleague/rivalries/TheLeagueRivalryTrophies.astro';
import leagueConfig from '../../../data/theleague.config.json';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { rivalryPairRoute } from '../../../utils/league-history/rivalry-route';
import { loadLeagueData } from '../../../utils/league-data';
import { getLeagueBySlug } from '../../../config/leagues';

// Read through the league-data loader, never bundled into the function
// (src/utils/league-data.ts).
const THELEAGUE_DATA = getLeagueBySlug('theleague')!.dataPath;
const [historyData, franchiseHistory] = (await Promise.all([
  loadLeagueData(`${THELEAGUE_DATA}/derived/league-history.json`),
  loadLeagueData(`${THELEAGUE_DATA}/derived/franchise-history.json`),
])) as [any, any];

export const prerender = false;

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const route = rivalryPairRoute(historyData, franchiseHistory, Astro.params.pair);
if (route.redirect !== null) {
  const path = route.redirect === 'index' ? '/theleague/rivalries' : `/theleague/rivalries/${route.redirect}${Astro.url.search}`;
  return Astro.redirect(resolveLeaguePath(path, hideLeaguePrefix), route.redirect === 'index' ? 302 : 301);
}
const { a, b, playoffRounds } = route;
const ownerOnly = Astro.url.searchParams.get('view') !== 'all';
---

<HistoryRivalryPage leagueSlug="theleague" data={historyData} a={a} b={b} playoffRounds={playoffRounds}>
  <RivalryTrades history={franchiseHistory} teams={leagueConfig.teams as any[]} a={a} b={b} ownerOnly={ownerOnly} />
  <TheLeagueRivalryTrophies history={franchiseHistory} a={a} b={b} />
</HistoryRivalryPage>
