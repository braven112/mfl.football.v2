---
/**
 * Get started — the onboarding steps for a new custom-site league, in one
 * place (Brandon, 2026-11-08: the story form belongs "in the same section as
 * creating logos and team colors. all of these are onboarding activities").
 *
 * Wears the MFL.football marketing chrome (MarketingShell, Soft Premium)
 * since 2026-11-14, so it reads as part of the same site as the homepage.
 *
 * Shared host only, like /brand/specs and /team-logo: a league reaches it
 * before it has a site of its own. Each step is its own page; this one only
 * orders them.
 */
import MarketingShell from '../components/shared/marketing/MarketingShell.astro';

export const prerender = false;

const STEPS = [
  {
    href: '/league-story',
    title: 'Tell us your league’s story',
    body: 'How it began, the people, the rivalries and traditions, and the name and personality of your league’s own beat reporter. We send your commissioner a private link; answer there, or let your own AI fill it in. About 30 minutes.',
    cta: 'How it works',
  },
  {
    href: '/team-logo',
    title: 'Pick team colors and make a logo',
    body: 'Choose a style and your team colors, and we write a prompt to paste into ChatGPT, Gemini or Claude.',
    cta: 'Make a logo',
  },
  {
    href: '/brand/specs',
    title: 'Send your logos and reporter picture',
    body: 'The team, league, conference and division logo sizes to send, with templates, plus a 500 × 500 picture of your beat reporter.',
    cta: 'See the logo specs',
  },
];
---

<MarketingShell title="Get started | MFL.football" description="The onboarding steps for a new custom league site: your league's story, team colors and logos." canonicalPath="/get-started">
  <section class="gstart">
    <header class="gstart__head">
      <p class="sp-eyebrow"><span>Onboarding</span></p>
      <h1>Get started</h1>
      <p class="sp-lede">Three steps to set up your league&rsquo;s site. Do them in any order, and send what you have.</p>
    </header>
    <ol class="gstart__steps">
      {
        STEPS.map((s) => (
          <li class="ui-card sp-card gstart__step">
            <h2 class="gstart__h">{s.title}</h2>
            <p class="gstart__body">{s.body}</p>
            <a class="cta cta--primary" href={s.href}>
              {s.cta}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</MarketingShell>

<style>
  .gstart {
    max-width: 46rem;
    margin: clamp(2rem, 6vw, 4rem) auto 3rem;
  }
  .gstart__head {
    margin-bottom: 2rem;
  }
  .gstart__head h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
  }
  .gstart__head .sp-lede {
    margin-top: 0.75rem;
  }
  .gstart__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    counter-reset: step;
  }
  .gstart__step {
    counter-increment: step;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .gstart__h {
    margin: 0;
    font-size: var(--sp-text-lg);
    color: var(--sp-ink);
  }
  .gstart__h::before {
    content: counter(step) '. ';
    color: var(--sp-red);
  }
  .gstart__body {
    margin: 0;
    color: var(--sp-muted);
  }
</style>
