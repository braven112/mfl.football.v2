---
/**
 * Trade Builder (the custom-site demo's keeper league) — thin route wrapper
 * over the shared trade builder every league renders
 * (src/components/shared/trade-builder/TradeBuilderPage.astro). Off the demo
 * this slot does not exist (middleware 404).
 */
import TradeBuilderPage from '../../../components/shared/trade-builder/TradeBuilderPage.astro';
import FrontOfficeNav from '../../../components/shared/front-office-nav/FrontOfficeNav.astro';
import { keeperConfig, keeperLeague } from '../../../utils/keeper-slot';
import { getLeagueYearForSlug } from '../../../utils/league-year';

export const prerender = false;

const league = keeperLeague();
if (!league) return Astro.rewrite('/_not-found');
const config = keeperConfig();

const feeds = {
  rosters: import.meta.glob('../../../../data/keeper/mfl-feeds/*/rosters.json', { eager: true }),
  // Current era only: the builder shows the newest season, and a bare year glob
  // bakes every season's players.json into the server chunk.
  players: import.meta.glob('../../../../data/keeper/mfl-feeds/20{2[5-9],[3-9][0-9]}/players.json', { eager: true }),
  // A keeper league values players on the DYNASTY board.
  adp: import.meta.glob('../../../../data/keeper/mfl-feeds/*/adp-dynasty.json', { eager: true }),
  adpFile: 'adp-dynasty.json',
  picks: import.meta.glob('../../../../data/keeper/mfl-feeds/*/futureDraftPicks.json', { eager: true }),
  tradeBait: import.meta.glob('../../../../data/keeper/mfl-feeds/*/tradeBait.json', { eager: true }),
  tradeBaitByFranchise: import.meta.glob('../../../../data/keeper/mfl-feeds/*/tradeBait-by-franchise.json', { eager: true }),
};
---

<TradeBuilderPage
  leagueSlug="keeper"
  leagueLabel={league.shortName ?? league.name}
  feeds={feeds}
  fallbackYear={getLeagueYearForSlug(league.slug)}
  teams={config.teams}
  conferences={config.conferences ?? []}
  poolShort={{}}
  poolNoun="league"
>
  <FrontOfficeNav slot="breadcrumbs" leagueSlug="keeper" current="trade-builder" crumb="Trade Builder" />
</TradeBuilderPage>
