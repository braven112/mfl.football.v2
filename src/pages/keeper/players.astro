---
/**
 * Free Agents (the custom-site demo's keeper league) — thin route wrapper over
 * the shared Free Agents page every league renders
 * (src/components/shared/free-agents/FreeAgentsPage.astro). One shared pool:
 * the keeper league has no duplicate-player conferences, so its snapshot
 * carries none and the page shows no switcher. Off the demo this slot does not
 * exist (middleware 404). Its data exists only in a demo build's checkout, so
 * the snapshot is read through a glob, never a static import.
 */
import FreeAgentsPage from '../../components/shared/free-agents/FreeAgentsPage.astro';
import { keeperLeague } from '../../utils/keeper-slot';

export const prerender = false;

const league = keeperLeague();
if (!league) return Astro.rewrite('/_not-found');
const snapshot = Object.values(
  import.meta.glob('../../../data/keeper/derived/free-agents.json', { eager: true, import: 'default' }),
)[0];
if (!snapshot) return Astro.rewrite('/_not-found');
const leagueModules = import.meta.glob('../../../data/keeper/mfl-feeds/20{2[5-9],[3-9][0-9]}/league.json', { eager: true });
const calendarModules = import.meta.glob('../../../data/keeper/mfl-feeds/20{2[5-9],[3-9][0-9]}/calendar.json', { eager: true });
---

<FreeAgentsPage
  leagueSlug="keeper"
  snapshot={snapshot}
  leagueModules={leagueModules}
  calendarModules={calendarModules}
  title={`Free Agents | ${league.name}`}
  signInLogo={{ src: '/assets/logos/keeper-logo.svg', alt: `${league.name} logo` }}
/>
