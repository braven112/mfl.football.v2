---
/**
 * /history — the free League History setup page, on the shared host.
 *
 * Paste an MFL league id and its champions page builds in about a minute
 * (HistoryBuilder). Lists the leagues built so far.
 *
 * Gated by `canViewLeagueHistory` (one seat until launch;
 * src/utils/league-history/access.ts). Not in the page directory until then,
 * the same reasoning as /live/analytics. On a league's own domain /history
 * rewrites under the league prefix and 404s, which is intended: this page
 * belongs to the shared host only.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import HistoryBuilder from '../../components/shared/league-history/HistoryBuilder.astro';
import { getAuthUser } from '../../utils/auth';
import { mflLoginUrl } from '../../utils/mfl-login-redirect';
import { canViewLeagueHistory } from '../../utils/league-history/access';
import { listMflHistories } from '../../utils/league-history/store';
import '../../styles/league-history.css';

export const prerender = false;

const authUser = getAuthUser(Astro.request);
if (!canViewLeagueHistory(authUser)) {
	if (!authUser) return Astro.redirect(mflLoginUrl('/history'));
	return Astro.rewrite('/_not-found');
}

const leagues = await listMflHistories();
---

<MflAppLayout title="League History" description="Every champion your league has crowned, on one page.">
	<div class="lh">
		<header>
			<p class="lh__eyebrow">League History</p>
			<h1 class="lh__title">Every champion your league has crowned</h1>
			<p class="lh__lede">
				Paste your MyFantasyLeague league id, or your league's MFL address, and we build a page
				with every season's champion and each team's trophy case. Free.
			</p>
		</header>

		<section class="lh__section" aria-label="Build a league's page">
			<HistoryBuilder />
			<p class="lh__muted">
				Your league id is the number at the end of your MFL league's address, for example
				…/home/<strong>54321</strong>.
			</p>
		</section>

		{leagues.length > 0 && (
			<section class="lh__section" aria-labelledby="lh-built">
				<h2 class="lh__h2" id="lh-built">Leagues on League History</h2>
				<ul class="lh__list">
					{leagues.map((l) => (
						<li><a class="cta-link" href={`/history/mfl/${l.leagueId}`}>{l.name}</a></li>
					))}
				</ul>
			</section>
		)}
	</div>
</MflAppLayout>
