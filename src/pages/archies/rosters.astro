---
/**
 * Rosters (archies) — thin route wrapper over the shared package-league page.
 * The glob lives here: a static import specifier cannot be a runtime variable.
 */
import PackageRostersPage from '../../components/shared/package-league/PackageRostersPage.astro';
import config from '../../../data/archies/archies.config.json';

export const prerender = false;

const rosterFeeds = import.meta.glob('../../../data/archies/mfl-feeds/*/rosters.json');
---

<PackageRostersPage leagueSlug="archies" rosterFeeds={rosterFeeds} config={config} />
