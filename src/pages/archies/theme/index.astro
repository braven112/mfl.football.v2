---
/**
 * /archies/theme → the light page. The redirect lives in a PAGE because
 * Astro.redirect() only redirects from one.
 */
import { themePath } from '../../../components/shared/theme/theme-mode';

export const prerender = false;

return Astro.redirect(themePath('archies', 'light', Astro.url, Astro.locals.hideLeaguePrefix ?? false), 302);
---
