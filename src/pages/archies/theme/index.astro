---
/**
 * /archies/theme → the light page. The redirect lives in a PAGE because
 * Astro.redirect() only redirects from one.
 */
import { resolveLeaguePath } from '../../../utils/nav-utils';

export const prerender = false;

return Astro.redirect(resolveLeaguePath('/archies/theme/light', Astro.locals.hideLeaguePrefix ?? false), 302);
---
