---
/**
 * Set Lineup (archies) — thin route wrapper around the shared lineup
 * page (components/shared/lineup/LineupPage) that the AFL renders.
 *
 * The auth gate stays HERE: `Astro.redirect()` only redirects from a page. It
 * requires a session for THIS league — every league has a franchise 0001, so
 * another league's session would point this page at someone else's team.
 *
 * The starting slots come from the league's own MFL starter rules
 * (utils/lineup-slots.ts): Archie's may not start a kicker, or may let
 * a FLEX take a second QB, and the page must offer exactly what MFL accepts.
 */
import LineupPage from '../../components/shared/lineup/LineupPage.astro';
import { getAuthUser } from '../../utils/auth';
import { loginUrlForRequest } from '../../utils/login-redirect';
import { getLeagueBySlug } from '../../config/leagues';
import { getLeagueYearForSlug } from '../../utils/league-year';
import { feedForYear } from '../../utils/rosters/roster-page-feeds';
import { lineupSlotsFor } from '../../utils/lineup-slots';
import config from '../../../data/archies/archies.config.json';

export const prerender = false;

const league = getLeagueBySlug('archies')!;
const user = getAuthUser(Astro.request);
if (!user?.franchiseId || user.leagueId !== league.id) {
  return Astro.redirect(loginUrlForRequest(Astro, league));
}

const leagueFeeds = import.meta.glob('../../../data/archies/mfl-feeds/*/league.json', { eager: true });
// Just after the league-year rollover the new year's league.json may not be
// synced yet, so fall back to last year's rules rather than to another
// league's layout. Rules the page cannot offer (not nine starters) are a 404.
const leagueYear = getLeagueYearForSlug(league.slug);
const slotLayout = [leagueYear, leagueYear - 1]
  .map((year) => lineupSlotsFor(feedForYear(leagueFeeds, year, 'league.json')?.league?.starters))
  .find(Boolean);
if (!slotLayout) return Astro.rewrite('/_not-found');
---

<LineupPage league={league} config={config} user={{ ...user, franchiseId: user.franchiseId }} throwbackScope={null} slotLayout={slotLayout} />
