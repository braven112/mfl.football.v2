---
/**
 * The Pecking Order (Archie's) — historical permalink:
 * /archies/pecking-order/[year]/[week].
 *
 * Server-rendered, NOT prerendered: on a league's apex host the canonical path
 * is the bare `/pecking-order/<year>/<week>`, which only `src/middleware.ts`
 * maps onto this route — and a prerendered page is a static file the
 * middleware never sees, so every apex permalink answered 500 (Sep–Oct 2026).
 * Same reason `news/[id].astro` is server-rendered.
 *
 * An issue that is not on disk answers a real 404. That is load-bearing: the
 * Tuesday announcement waits for THIS url to answer 200 before it posts
 * (`issuePermalink` in scripts/generate-pecking-order.mjs), so a week that has
 * not deployed yet must not look live.
 */
export const prerender = false;

import TheLeagueLayout from '../../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../../../components/shared/Breadcrumbs.astro';
import PeckingOrderPermalink from '../../../../components/shared/PeckingOrderPermalink.astro';
import { type PeckingOrderData } from '../../../../components/shared/PeckingOrderIssue.astro';
import NotFound from '../../../404.astro';
import { getLeagueBySlug } from '../../../../config/leagues';
import { listLeagueData, loadLeagueData } from '../../../../utils/league-data';

interface Entry { year: number; week: number; data: PeckingOrderData }

const parseIssues = (files: Record<string, PeckingOrderData>): Entry[] =>
  Object.entries(files)
    .map(([file, data]) => {
      const m = file.match(/(\d{4})-(\d{1,2})\.json$/);
      if (!m) return null;
      return { year: parseInt(m[1], 10), week: parseInt(m[2], 10), data: data as PeckingOrderData };
    })
    .filter((x): x is Entry => x !== null);

// Through the league-data loader: a glob would compile every issue into the function.
const issuePaths = listLeagueData(`${getLeagueBySlug('archies')!.dataPath}/pecking-order/*.json`);
const issueData = await Promise.all(issuePaths.map((p) => loadLeagueData<PeckingOrderData>(p)));
const allIssues: Entry[] = parseIssues(Object.fromEntries(issuePaths.map((p, i) => [p, issueData[i]!])));

const year = Number(Astro.params.year);
const week = Number(Astro.params.week);
const issue = allIssues.find((i) => i.year === year && i.week === week)?.data ?? null;
if (!issue) Astro.response.status = 404;
---

{issue ? (
<TheLeagueLayout title={`${issue.headline} · The Pecking Order · Week ${issue.week}`}>
  <div class="pr-page">
    <Breadcrumbs items={[
      { label: "Archie's", href: '/archies' },
      { label: 'The Pecking Order', href: '/archies/pecking-order' },
      { label: `Week ${issue.week} · ${issue.year}` },
    ]} />

    <PeckingOrderPermalink
      issue={issue}
      issues={allIssues}
      league="archies"
      basePath="/archies/pecking-order"
    />
  </div>
</TheLeagueLayout>
) : (
<NotFound />
)}

<style>
.pr-page { min-height: 60vh; }
</style>
