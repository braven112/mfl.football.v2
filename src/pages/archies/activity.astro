---
/**
 * Owner Activity (archies) — thin route wrapper.
 *
 * The page is components/shared/OwnerActivityPage; the gate and the globs stay
 * here (Astro.rewrite only works from a page, and a static import specifier
 * can't be a runtime variable). Private by default:
 * src/utils/owner-activity-access.ts.
 */
import OwnerActivityPage from '../../components/shared/OwnerActivityPage.astro';
import { getAuthUser } from '../../utils/auth';
import { resolveOwnerActivityAccess } from '../../utils/owner-activity-access';
import { loginUrlForRequest, forbiddenPathFor } from '../../utils/login-redirect';
import { getLeagueBySlug } from '../../config/leagues';

export const prerender = false;

const league = getLeagueBySlug('archies')!;
const access = await resolveOwnerActivityAccess(getAuthUser(Astro.request), league);
if (access.kind === 'login') return Astro.redirect(loginUrlForRequest(Astro, league));
if (access.kind === 'forbidden') return Astro.rewrite(forbiddenPathFor(league, 'admin'));

const transactionFeeds = import.meta.glob('../../../data/archies/mfl-feeds/*/transactions.json');
const lastVisitFiles = import.meta.glob('../../../data/archies/owner-last-visit.json');
---

<OwnerActivityPage
	leagueSlug={league.slug}
	transactionFeeds={transactionFeeds}
	lastVisitFiles={lastVisitFiles}
	canManage={access.canManage}
/>
