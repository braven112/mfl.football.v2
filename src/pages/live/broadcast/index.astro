---
/**
 * MFL Live — the Broadcast. `/live/broadcast`.
 *
 * The board's home in MFL Live, where it is sold: a landing that reads like a
 * product (the live board playing inside a TV frame, one big "Go full screen",
 * the leagues it watches, and pairing a television by QR code), which hands
 * off to the same fullscreen board the league routes have always shown.
 *
 * Three kinds of visitor, and the route decides which before anything renders:
 *
 *  - an owner signed in to MFL Live (`getMflLiveUser`);
 *  - a TELEVISION holding a watch-only pass from `/tv`. It has no session; its
 *    pass resolves to the owner who paired it, through `getBroadcastViewer`,
 *    which is read here and by the board's poll and nowhere else;
 *  - anyone else, who gets the pitch and the two ways in.
 *
 * The route owns every cookie write (`rememberBroadcastChoices`, clearing a
 * dead TV pass): `Astro.cookies.set()` from an imported component runs after
 * the headers are committed and blanks the page.
 *
 * `?view=board` is the board alone, in the page. It exists for the browsers
 * with no Fullscreen API — an iPhone above all — where "Go full screen" has
 * nothing to call and becomes a link here instead.
 *
 * A paired TV skips the landing (owner's call, Oct 2026): it opens straight
 * onto the board, edge to edge with no app bar, because a TV is there to show
 * the scores and the landing's pitch is for the person deciding to pair one.
 * Fullscreen cannot be requested without a click, so the bare page IS the
 * full screen. `?view=landing` still reaches the landing, where a TV changes
 * its leagues or unpairs itself; the board's hidden back link goes there.
 */
import MflAppLayout from '../../../layouts/MflAppLayout.astro';
import BroadcastLanding from '../../../components/shared/live-broadcast/BroadcastLanding.astro';
import LiveBroadcast from '../../../components/shared/live-broadcast/LiveBroadcast';
import HandheldPrepaint from '../../../components/shared/live-broadcast/HandheldPrepaint.astro';
import { getBroadcastViewer } from '../../../utils/broadcast-viewer';
import { rememberBroadcastChoices } from '../../../utils/broadcast-cookies';
import { assembleBroadcastBoard, toPageData, type AssembledBoard } from '../../../utils/broadcast-board';
import {
  BROADCAST_LEAGUE_COOKIE,
  BROADCAST_SOUND_COOKIE,
  resolveBroadcastSound,
} from '../../../utils/broadcast-selection';
import { listPasses, ownerKeyFor, TV_PASS_COOKIE, type PassSummary } from '../../../utils/broadcast-tv-pairing';
import { getPairingStore } from '../../../utils/broadcast-tv-store';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../../../utils/league-year';
import { getCurrentNFLWeek } from '../../../utils/current-week';
import '../../../styles/live-broadcast.css';
import '../../../styles/utilities.css';

export const prerender = false;

rememberBroadcastChoices(Astro.url, Astro.cookies);

const viewer = await getBroadcastViewer(Astro.request);
const pairedTv = viewer?.via === 'tv';
const viewParam = Astro.url.searchParams.get('view');

if (pairedTv && viewParam === null) {
  const boardUrl = new URL(Astro.url);
  boardUrl.searchParams.set('view', 'board');
  return Astro.redirect(`${boardUrl.pathname}${boardUrl.search}`, 302);
}

// A pass that no longer resolves — revoked, or past its thirty days — is
// cleared here, so `/tv` (which sends any pass-holder straight to this page)
// makes a fresh code instead of bouncing between the two.
if (!viewer && Astro.cookies.has(TV_PASS_COOKIE)) {
  Astro.cookies.delete(TV_PASS_COOKIE, { path: '/' });
}

// Same clocks and clamps as the league routes' board (LiveBroadcastPage).
const testDate = getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined;
const year = getCurrentSeasonYear(testDate);
const weekParam = Astro.url.searchParams.get('week');
const parsedWeek = weekParam ? parseInt(weekParam, 10) : NaN;
const explicitWeek = Number.isFinite(parsedWeek) && parsedWeek >= 1 && parsedWeek <= 25;
const week = explicitWeek ? parsedWeek : (getCurrentNFLWeek(testDate ?? new Date()) ?? 1);

const sound = resolveBroadcastSound(
  Astro.url.searchParams.get('sound'),
  Astro.cookies.get(BROADCAST_SOUND_COOKIE)?.value ?? null,
);
// Never remembered — see LiveBroadcastPage.
const demo = Astro.url.searchParams.get('demo') === '1';
const boardOnly = viewParam === 'board';

let board: AssembledBoard | null = null;
let failed = false;
let tvs: PassSummary[] = [];

if (viewer) {
  try {
    board = await assembleBroadcastBoard({
      user: viewer.user,
      leaguesParam: Astro.url.searchParams.get('leagues'),
      // A TV's own choice first, then the set the phone that paired it watched.
      leaguesCookie: Astro.cookies.get(BROADCAST_LEAGUE_COOKIE)?.value ?? viewer.pass?.leagues ?? null,
      week,
      year,
    });
  } catch {
    failed = true;
  }

  // Only an owner sees the list of TVs; a TV sees only itself.
  if (viewer.via === 'session') {
    try {
      const store = await getPairingStore();
      if (store) tvs = await listPasses(store, ownerKeyFor(viewer.user));
    } catch {
      tvs = [];
    }
  }
}

const pageData = board
  ? toPageData(board, { week, year, sound, pathname: Astro.url.pathname, demo })
  : null;

const title = boardOnly ? `Broadcast — Week ${week} — MFL Live` : 'Broadcast — MFL Live';
---

<MflAppLayout
  title={title}
  description="Every score from every league you play in, built for the TV across the room."
  pairedTvOwner={pairedTv ? (viewer?.user.name ?? null) : null}
  bare={pairedTv && boardOnly && Boolean(pageData)}
>
  {boardOnly && pageData ? (
    <div class:list={['bcl-board-only', { 'bcl-board-only--tv': pairedTv }]}>
      <a class="bcl-board-only__back" href={pairedTv ? '/live/broadcast?view=landing' : '/live/broadcast'}>&larr; Broadcast</a>
      <HandheldPrepaint />
      <LiveBroadcast client:load pageData={JSON.stringify(pageData)} />
    </div>
  ) : (
    <BroadcastLanding
      viewer={viewer ? { via: viewer.via, name: viewer.user.name, device: viewer.pass?.device ?? null } : null}
      board={board}
      pageData={pageData}
      failed={failed}
      week={week}
      explicitWeek={explicitWeek}
      sound={sound}
      tvs={tvs}
      host={Astro.url.host.replace(/^www\./, '')}
    >
      {pageData && <LiveBroadcast slot="board" client:load pageData={JSON.stringify({ ...pageData, modeHint: 'tv' })} />}
    </BroadcastLanding>
  )}
</MflAppLayout>

<style>
  .bcl-board-only__back {
    display: inline-block;
    margin: 0 0 0.75rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  /* A paired TV: the board fills the screen. The back link stays in the focus
     order (it is how the TV reaches its leagues and "Unpair") but shows only
     once the remote's focus lands on it. */
  .bcl-board-only--tv :global(.lbc) {
    height: 100vh;
    border-radius: 0;
  }
  .bcl-board-only--tv .bcl-board-only__back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border-radius: 0.5rem;
    background: var(--content-bg);
    color: var(--page-text);
    opacity: 0;
  }
  .bcl-board-only--tv .bcl-board-only__back:focus-visible {
    opacity: 1;
  }
</style>
