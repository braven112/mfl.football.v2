---
/**
 * MFL Live — the score overlay. `/live/broadcast/overlay`.
 *
 * Not a page anyone browses to: the Google TV app loads it into a see-through
 * window drawn over another app (YouTube TV), so the owner can watch the game
 * and their matchups at once. `?mode=panel|bar|expanded`, `?edge=top|bottom`,
 * `?side=left|right`, `?size=small|quarter` and `?layout=corner` are the
 * app's hints for the first paint; after that the app switches views through the page's
 * `window.__mflOverlay` handle (BroadcastOverlay.tsx).
 *
 * Its own document, no app layout: the page must be transparent edge to edge,
 * and a layout paints a ground, a bar and a menu the video would show through.
 *
 * Who may watch is decided exactly as the board decides it — a signed-in
 * owner, or a TV holding the watch-only pass from `/tv` — and it only reads.
 */
import BroadcastOverlay from '../../../components/shared/live-broadcast/BroadcastOverlay';
import { getBroadcastViewer } from '../../../utils/broadcast-viewer';
import { assembleBroadcastBoard, toPageData } from '../../../utils/broadcast-board';
import { BROADCAST_LEAGUE_COOKIE } from '../../../utils/broadcast-selection';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../../../utils/league-year';
import { getCurrentNFLWeek } from '../../../utils/current-week';
import { getTvSettings } from '../../../utils/mfl-live-tv-settings';
import { getLeagueBySlug } from '../../../config/leagues';
import '../../../styles/broadcast-overlay.css';

export const prerender = false;

const viewer = await getBroadcastViewer(Astro.request);

const testDate = getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined;
const year = getCurrentSeasonYear(testDate);
const weekParam = parseInt(Astro.url.searchParams.get('week') ?? '', 10);
const week =
  Number.isFinite(weekParam) && weekParam >= 1 && weekParam <= 25
    ? weekParam
    : (getCurrentNFLWeek(testDate ?? new Date()) ?? 1);

let pageData: string | null = null;
// Each registry league's on-dark logo, by MFL id: the overlay only ever darkens
// the picture behind it, and its ink is white.
const leagueLogos: Record<string, string> = {};
// The owner's own answer from /live/settings; a paired TV's pass is that owner.
const tvSettings = await getTvSettings(viewer?.user);
if (viewer) {
  try {
    const board = await assembleBroadcastBoard({
      user: viewer.user,
      leaguesParam: Astro.url.searchParams.get('leagues'),
      leaguesCookie: Astro.cookies.get(BROADCAST_LEAGUE_COOKIE)?.value ?? viewer.pass?.leagues ?? null,
      week,
      year,
    });
    const page = toPageData(board, { week, year, sound: false, pathname: Astro.url.pathname });
    for (const panel of page.panels) {
      const logo = panel.slug ? getLeagueBySlug(panel.slug)?.logo.dark : undefined;
      if (logo) leagueLogos[panel.leagueId] = logo;
    }
    pageData = JSON.stringify(page);
  } catch {
    pageData = null;
  }
}

Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="en" class="bov-doc">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Score overlay — MFL Football</title>
  </head>
  <body class="bov-doc">
    <BroadcastOverlay
      client:load
      pageData={pageData}
      signedIn={Boolean(viewer)}
      mode={Astro.url.searchParams.get('mode')}
      edge={Astro.url.searchParams.get('edge')}
      side={Astro.url.searchParams.get('side')}
      size={Astro.url.searchParams.get('size')}
      layout={Astro.url.searchParams.get('layout')}
      leagueLogos={leagueLogos}
      sundayTicket={tvSettings.sundayTicket}
    />
  </body>
</html>
