---
/**
 * MFL Live — every one of your MyFantasyLeague teams, scoring at once.
 *
 * Lives at mfl.football/live. See docs/plans/mfl-live-app.md.
 *
 * Each panel's league name links to `/live/league/<mflLeagueId>` — that
 * league's FULL board, every matchup in it rather than just this owner's,
 * plus standings and the week's top scorers. The href is passed in rather than
 * built inside the shared kit, because the league boards render the same
 * component and a link there would point at the page you are already on. It is
 * a BASE PATH rather than a callback because island props cross the
 * server/client boundary as JSON, where a function does not survive.
 * See docs/plans/mfl-live-league-boards.md.
 *
 * ── THE BOARD IS ASSEMBLED IN PROCESS ─────────────────────────────────────
 * `assembleMflLiveBoard` is called here directly and NEVER through
 * `/api/live-board`. A page that fetches its own API to render itself puts our
 * own edge in the path of its first paint, and this repo has already shipped
 * the outage that causes: on 2026-09-09 the live-scoring page printed "Scores
 * will appear here when games begin" over a live slate, invisible in the logs,
 * because a request blocked at the edge never reaches the route.
 * `docs/claude/rules/live-scoring.md`.
 *
 * ── WHY THIS DOES NOT REDIRECT WHEN SIGNED OUT ────────────────────────────
 * A signed-out visitor gets the shell and a sign-in call to action, not a
 * bounce. The board's empty state is designed to render with no data at all,
 * so there is a real page to show, and a board you can look at before signing
 * in explains itself better than a login form does.
 *
 * A league's own link, `/live?from=<slug>`, shows that league's branded
 * sign-in in place of the sales page (`src/utils/mfl-live-entry.ts`).
 *
 * Sign-in goes to the app's OWN `/login`, which defaults back here. It used to
 * point at `/theleague/login`, whose `?redirect=` is validated against
 * `startsWith('/theleague')` — so the trip back to this page was silently
 * dropped and owners landed on TheLeague's homepage instead.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import MflLiveLanding from '../../components/shared/mfl-live/MflLiveLanding.astro';
import MflLiveLeagueSignIn from '../../components/shared/mfl-live/MflLiveLeagueSignIn.astro';
import { getCurrentSeasonYear, getLeagueYearForMflId, getTestDateFromSearchParams } from '../../utils/league-year';
import { MFL_LIVE_ENTRY_PARAM, resolveMflLiveEntryLeague } from '../../utils/mfl-live-entry';
import LiveBoard from '../../components/shared/live/LiveBoard';
import InstallAppPrompt from '../../components/shared/pwa/InstallAppPrompt.astro';
import { getLeagueById } from '../../config/leagues';
import { mflLiveSeason } from '../../utils/mfl-live-season';
import { fromMflLiveBoard } from '../../utils/live/from-mfl-live';
import { getMflLiveUser } from '../../utils/auth';
import { hasMflLivePro } from '../../utils/mfl-live-pro';
import { getCurrentNFLWeek } from '../../utils/current-week';
import { getDailySlot } from '../../utils/hero-resolver';
import { assembleMflLiveBoard } from '../../utils/mfl-live-board';
import { MFL_LIVE_LEAGUE_COOKIE, rememberMflLiveChoice } from '../../utils/mfl-live-selection';
import type { MflLiveBoard as Board } from '../../types/mfl-live';
import '../../styles/live.css';

/**
 * This board renders through the SHARED kit (`components/shared/live`).
 *
 * `fromMflLiveBoard` converts the assembler's viewer-relative shape into the
 * canonical model. Lossless in this direction: every matchup here has a viewer
 * by construction, so `viewerSide` is always 0. `viewerFirst` is set because
 * this is a board OF your own teams — a league board keeps MFL's pairing order
 * instead, since most of its cards are nobody's.
 *
 * The poll stays on `/api/live-board`, which still answers the old shape, so
 * the island converts on arrival too (`pollShape`). That prop disappears when
 * the assembler emits the canonical model directly.
 */

// Scores must never be cached, and even the shell reads the session.
export const prerender = false;

const authUser = getMflLiveUser(Astro.request);

// Route-only write, before anything reads the cookie back — so a link that
// carries a league set sticks for next time. `Astro.cookies.set()` from an
// imported component throws after the headers are committed and blanks the
// page, which is why this lives here rather than inside the board.
if (authUser) rememberMflLiveChoice(Astro.url, Astro.cookies);

const now = new Date();

// The layout's own resolution, so the board header's Halloween cards appear
// exactly when the haunted scene behind them does (seasonal-themes.css).
const season = mflLiveSeason(Astro.url, Astro.locals.seasonPreview)?.id;
// The RAW resolver result, never clamped up to 1. MFL serves no live scoring
// before the Week 1 Thursday, and clamping is what hides that gap — a week-1
// request in the September pre-kickoff window fails against a perfectly
// healthy league.
const currentWeek = getCurrentNFLWeek(now);
const weekParam = Number.parseInt(Astro.url.searchParams.get('week') ?? '', 10);
const week = Number.isFinite(weekParam) && weekParam > 0 ? weekParam : currentWeek;

// A game-day hint, and nothing more. It may RAISE the island's poll cadence
// and may never decide whether it polls: the 2026 opener was a Wednesday
// night game, and a board gated on a Thu/Sun/Mon schedule never asked MFL for
// a score all game.
const isLive = getDailySlot(now).slot === 'live-scoring';

// The season Pro is included for on the signed-out landing: results-shaped,
// so the season-year clock.
const seasonYear = getCurrentSeasonYear(getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined);

// A league's own link (`/live?from=archies`) swaps the signed-out sales page
// for its branded sign-in. Signed in, it is ignored: one board for everyone.
const entryLeague = authUser
  ? null
  : resolveMflLiveEntryLeague(Astro.url.searchParams.get(MFL_LIVE_ENTRY_PARAM));

// The year the branded form signs in against is the ENTRY league's own: Archie's
// and the AFL roll on June 1, so between Feb 14 and June 1 TheLeague's clock
// names a year their MFL league does not exist in yet, and `myleagues` for it
// finds nothing.
const entryLeagueYear = entryLeague
  ? getLeagueYearForMflId(
      entryLeague.id,
      getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined,
    )
  : null;

let board: Board | null = null;
let assemblyFailed = false;

if (authUser && week) {
  try {
    const assembled = await assembleMflLiveBoard({
      user: authUser,
      week,
      // A CHECK against what the session may see, never an input.
      leaguesParam: Astro.url.searchParams.get('leagues'),
      leaguesCookie: Astro.cookies.get(MFL_LIVE_LEAGUE_COOKIE)?.value ?? null,
    });
    board = assembled.board;
  } catch {
    // Say so, rather than rendering an empty board that reads as "no games".
    assemblyFailed = true;
  }
}
---

<MflAppLayout
	title="MFL Live — all your fantasy teams, one board"
	description="Live scoring for every one of your MyFantasyLeague teams, in one place."
>
	{!authUser && entryLeague ? (
		<MflLiveLeagueSignIn league={entryLeague} seasonYear={entryLeagueYear!} />
	) : !authUser ? (
		<MflLiveLanding seasonYear={seasonYear} hostname={Astro.url.hostname} />
	) : !week ? (
		<section class="mfl-live-intro">
			<h1 class="mfl-live-intro__title">The season hasn&rsquo;t kicked off</h1>
			<p class="mfl-live-intro__sub">
				MFL doesn&rsquo;t score a week until it starts. This board will fill itself in
				the moment Week 1 does.
			</p>
		</section>
	) : assemblyFailed || !board ? (
		<section class="mfl-live-intro">
			<h1 class="mfl-live-intro__title">Couldn&rsquo;t load your leagues</h1>
			<p class="mfl-live-intro__sub">
				Something went wrong reading MyFantasyLeague. Refreshing usually sorts it; if
				it doesn&rsquo;t, your MFL sign-in may have expired.
			</p>
			<a class="cta cta--primary mfl-live-intro__cta" href="/login">Sign in again</a>
		</section>
	) : (
		<div class="mfl-live-board">
			{/* The install pitch, for signed-in owners only: a dismissible banner
			    that retires itself once the app is installed. Never reported to
			    `/api/app-install` — that record is the LEAGUE site's app, and
			    MFL Live is a different one. */}
			<InstallAppPrompt
				variant="banner"
				leagueName="MFL Live"
				leagueSlug={getLeagueById(authUser.leagueId)?.slug ?? 'mfl-live'}
				report={false}
				bannerCopy={{
					title: 'Put MFL Live on your Home Screen',
					prompt: 'Install the app and your live scores are one tap away all game day, full screen, no browser tab.',
					ios: 'On iPhone, tap Share, then Add to Home Screen, and live scoring opens like an app. Takes about five seconds.',
					lastStep: 'Open MFL Live from your Home Screen.',
				}}
			/>
			<LiveBoard
				client:load
				board={fromMflLiveBoard(board)}
				pollUrl="/api/live-board"
				pollShape="mfl-live"
				isLive={isLive}
				viewerFirst
				panelHrefBase="/live/league/"
				standingsProLocked={!hasMflLivePro(authUser)}
				season={season}
			/>
		</div>
	)}
</MflAppLayout>

<style>
	.mfl-live-intro {
		max-width: 46rem;
		margin: 0 auto;
	}

	.mfl-live-intro__title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.5rem, 5vw, 2.25rem);
		line-height: 1.15;
		color: var(--page-text);
	}

	.mfl-live-intro__sub {
		margin: 0 0 1.5rem;
		color: var(--color-text-secondary);
	}

	/* The fill is the mfl-live theme's --cta-fill (src/themes/mfl-live.json). */
	.mfl-live-intro__cta {
		padding: 0.7rem 1.15rem;
	}
</style>
