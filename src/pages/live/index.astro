---
/**
 * MFL Live — every one of your MyFantasyLeague teams, scoring at once.
 *
 * Lives at mfl.football/live. See docs/plans/mfl-live-app.md.
 *
 * ── PHASE 1: THE SHELL ────────────────────────────────────────────────────
 * This is the branding and layout pass. The board below is a PLACEHOLDER —
 * the cross-league data layer lands in Phase 2, when `loadCrossLeagueSnapshot`
 * is extracted out of `broadcast-board.ts` and this page calls it IN PROCESS.
 * It will never fetch its own API to render itself; that hop is what printed
 * "Scores will appear here when games begin" over a live slate on 2026-09-09
 * (docs/claude/rules/live-scoring.md).
 *
 * ── WHY THIS DOES NOT REDIRECT WHEN SIGNED OUT ────────────────────────────
 * A signed-out visitor gets the shell and a sign-in call to action, not a
 * bounce. Two reasons, one temporary and one not:
 *
 *  - Temporary: `/theleague/login` validates its `?redirect=` against
 *    `startsWith('/theleague')`, so a bounce from here cannot come back here.
 *    An owner would sign in and land on TheLeague's homepage. Widening that
 *    allowlist belongs in the login rework, not in a page that can simply
 *    render.
 *  - Not temporary: the board's empty state is designed to render with no
 *    data at all (decision 8 — the honest empty state), so there is a real
 *    page to show here. A redirect would waste it.
 *
 * The signed-in branch reveals nothing sensitive on its own; every league read
 * is gated on the session's MFL cookie server-side in Phase 2.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import { getAuthUser } from '../../utils/auth';

// Scores must never be cached, and even the shell reads the session.
export const prerender = false;

const authUser = getAuthUser(Astro.request);
---

<MflAppLayout
	title="MFL Live — all your fantasy teams, one board"
	description="Live scoring for every one of your MyFantasyLeague teams, in one place."
>
	{authUser ? (
		<section class="mfl-live" aria-labelledby="mfl-live-heading">
			<h1 id="mfl-live-heading" class="mfl-live__title">Your leagues</h1>
			<p class="mfl-live__sub">Signed in as {authUser.name}.</p>

			<div class="mfl-live__placeholder" role="status">
				<p class="mfl-live__placeholder-lede">The board lands next.</p>
				<p class="mfl-live__placeholder-body">
					This is the shell — theme, nav and install icon. Phase 2 fills it with
					every matchup from every league your MyFantasyLeague account is in.
				</p>
			</div>
		</section>
	) : (
		<section class="mfl-live" aria-labelledby="mfl-live-heading">
			<h1 id="mfl-live-heading" class="mfl-live__title">All your fantasy teams, one board</h1>
			<p class="mfl-live__sub">
				Every matchup from every league your MyFantasyLeague account is in, scoring
				live on one screen.
			</p>
			<a class="mfl-live__cta" href="/theleague/login">Sign in with MyFantasyLeague</a>
		</section>
	)}
</MflAppLayout>

<style>
	.mfl-live {
		max-width: 46rem;
		margin: 0 auto;
	}

	.mfl-live__title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.5rem, 5vw, 2.25rem);
		line-height: 1.15;
		color: var(--page-text);
	}

	.mfl-live__sub {
		margin: 0 0 1.5rem;
		color: var(--color-text-secondary);
	}

	.mfl-live__cta {
		display: inline-block;
		padding: 0.7rem 1.15rem;
		border-radius: 0.5rem;
		background: var(--league-accent);
		color: #ffffff;
		font-weight: 600;
		text-decoration: none;
	}
	.mfl-live__cta:hover,
	.mfl-live__cta:focus-visible {
		filter: brightness(1.08);
	}

	.mfl-live__placeholder {
		padding: clamp(1.25rem, 5vw, 2rem);
		border: 1px dashed var(--card-border);
		border-radius: 0.75rem;
		background: var(--card-bg);
	}

	.mfl-live__placeholder-lede {
		margin: 0 0 0.4rem;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.mfl-live__placeholder-body {
		margin: 0;
		color: var(--color-text-secondary);
	}
</style>
