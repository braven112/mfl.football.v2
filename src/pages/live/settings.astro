---
/**
 * MFL Live — which leagues the board watches.
 *
 * SSR shell around ONE hydrated island, and the island is load-bearing.
 *
 * The first cut was link-only: each toggle an `<a>` carrying the resulting
 * `?leagues=` for this route to write. Correct, needed no JavaScript, and it
 * felt like a page refresh on every tap because that is exactly what it was.
 * `LeagueToggles` replaced it with optimistic state and a background POST to
 * `/api/live-leagues`. THERE IS NO LINK FALLBACK LEFT — the switches are the
 * only way to change the selection, which is why they hydrate on load rather
 * than idle.
 *
 * THE COOKIE IS STILL WRITTEN HERE, IN THE ROUTE, for the `?leagues=` a link
 * elsewhere may still carry. `Astro.cookies.set()` from an imported component
 * runs after the response headers are committed, throws `ResponseSentError`
 * and blanks the page — the Sunday Ticket board shipped exactly that on its
 * first click. Reads are fine anywhere; only the write is route-only.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import { mflLoginUrl } from '../../utils/mfl-login-redirect';
import LeagueToggles from '../../components/shared/mfl-live/LeagueToggles';
import { getMflLiveUser } from '../../utils/auth';
import { discoverBoardLeagues, readViewerFranchiseNames } from '../../utils/cross-league-live';
import {
  MFL_LIVE_LEAGUE_COOKIE,
  rememberMflLiveChoice,
  resolveMflLiveLeagues,
} from '../../utils/mfl-live-selection';
import { resolveFranchiseIdentity } from '../../utils/mfl-live-identity';
import { getCurrentSeasonYear } from '../../utils/league-year';
import { getSleeperLink, type SleeperLink } from '../../utils/sleeper/link';
import { discoverSleeperBoardLeagues, readSleeperViewerMarks } from '../../utils/sleeper/live';
import { sleeperAvatarUrl } from '../../utils/sleeper/client';
import '../../styles/mfl-live.css';

export const prerender = false;

const authUser = getMflLiveUser(Astro.request);

// Route-only, and BEFORE anything reads the cookie back, so a click's own
// choice is what this render reflects.
if (authUser) rememberMflLiveChoice(Astro.url, Astro.cookies);

let leagues: Awaited<ReturnType<typeof discoverBoardLeagues>> = [];
let enabled: string[] = [];
/** League id -> the viewer's own franchise name and mark, for leagues myleagues left blank. */
let viewerNames: Awaited<ReturnType<typeof readViewerFranchiseNames>> = {};
let loadFailed = false;
let sleeperLink: SleeperLink | null = null;

if (authUser) {
  try {
    // Sleeper is optional and never fatal: a failed Sleeper read leaves the
    // MFL leagues to toggle and the link form to retry.
    sleeperLink = await getSleeperLink(authUser).catch(() => null);
    const [mflLeagues, sleeperLeagues] = await Promise.all([
      discoverBoardLeagues(authUser),
      discoverSleeperBoardLeagues(sleeperLink, getCurrentSeasonYear()).catch(() => []),
    ]);
    leagues = [...mflLeagues, ...sleeperLeagues];
    ({ enabled } = resolveMflLiveLeagues(
      Astro.url.searchParams.get('leagues'),
      Astro.cookies.get(MFL_LIVE_LEAGUE_COOKIE)?.value ?? null,
      leagues,
    ));
    // Never fatal: a missing name costs a sub-line, and this page's job is
    // the toggles.
    viewerNames = await readViewerFranchiseNames(
      authUser,
      leagues.filter((l) => l.provider !== 'sleeper'),
    ).catch(() => ({}));
    const sleeperMarks = await readSleeperViewerMarks(leagues);
    for (const [id, mark] of Object.entries(sleeperMarks)) {
      viewerNames[id] = { ...mark, leagueHasMarks: !!mark.icon };
    }
  } catch {
    loadFailed = true;
  }
}

/**
 * The rows, as plain data for the island.
 *
 * The identity ladder runs SERVER-side so the marks and names are in the first
 * paint rather than appearing after hydration — and so the client never needs
 * the league configs the ladder reads.
 */
/** The link form's one-word outcome, from `/api/live-sleeper`'s redirect. */
const SLEEPER_NOTICE: Record<string, string> = {
  linked: 'Sleeper account linked. Its leagues are on the board.',
  unlinked: 'Sleeper account unlinked.',
  'not-found': 'Sleeper has no account with that username.',
  invalid: 'That is not a Sleeper username.',
  unavailable: 'Couldn\u2019t reach Sleeper just now. Try again in a minute.',
  error: 'Couldn\u2019t save that just now. Try again in a minute.',
};
const sleeperNotice = SLEEPER_NOTICE[Astro.url.searchParams.get('sleeper') ?? ''] ?? '';
const sleeperAvatar = sleeperAvatarUrl(sleeperLink?.avatar);

const rows = leagues.map((league) => {
  // The ladder's name, not `league.franchiseName`. `myleagues` fills that for
  // a real MFL cookie, but the session FALLBACK — the path that puts the
  // owner's own league on the board when myleagues omitted it — leaves it
  // blank, and an empty sub-line reads as broken.
  const identity = resolveFranchiseIdentity({
    franchiseId: league.franchiseId,
    // The league's OWN export first: `myleagues` leaves `franchise_name`
    // blank for most leagues this site does not host, which is what made
    // every one of them read "Franchise 0015" here — and, on the board, what
    // stopped their NFL crests resolving at all.
    franchiseName: viewerNames[league.id]?.name || league.franchiseName,
    leagueSlug: league.registered?.slug ?? null,
    // From the same read as the name. A franchise's own uploaded art, so this
    // list shows what the board shows.
    mflIcon: viewerNames[league.id]?.icon,
    leagueHasMarks: viewerNames[league.id]?.leagueHasMarks,
  });
  return {
    id: league.id,
    name: league.name,
    franchiseName: identity.name,
    registered: !!league.registered,
    ...(league.provider ? { provider: league.provider } : {}),
    icon: identity.icon,
    initials: identity.initials,
    // The renderer crops only the uploaded-mark rung square — see
    // `mfl-live-identity.ts`. A crest or club mark is drawn to fit its box.
    cropMark: identity.rung === 'mfl',
  };
});

---

<MflAppLayout title="Leagues — MFL Live" description="Choose which leagues the board watches.">
	{!authUser ? (
		<section class="mls">
			<h1 class="mls__title">Leagues</h1>
			<p class="mls__lede">Sign in to choose which leagues the board watches.</p>
			<a class="cta cta--primary mls__cta" href={mflLoginUrl('/live/settings')}>Sign in with MyFantasyLeague</a>
		</section>
	) : loadFailed ? (
		<section class="mls">
			<h1 class="mls__title">Leagues</h1>
			<p class="mls__lede">
				Couldn&rsquo;t read your leagues from MyFantasyLeague just now. Your choices are
				safe — nothing was changed.
			</p>
			<a class="mls__back" href="/live">Back to the board</a>
		</section>
	) : (
		<section class="mls">
			<a class="mls__back" href="/live">&larr; Board</a>
			<h1 class="mls__title">Leagues</h1>
			<p class="mls__lede">
				Every league your MyFantasyLeague account is in is on by default. Switch one
				off and the board stops reading it.
			</p>

			{rows.length === 0 ? (
				<p class="mls__lede">
					MFL didn&rsquo;t list any leagues for this account. If you have just joined one,
					it can take a few minutes to appear.
				</p>
			) : (
				<LeagueToggles client:load leagues={rows} initialEnabled={enabled} />
			)}

			{/* Sleeper. A username and nothing else: Sleeper's API is public and
			    read-only, so there is no password to ask for. A plain form, so it
			    works before (and without) hydration. */}
			<section class="mls-sleeper" aria-labelledby="mls-sleeper-title">
				<h2 class="mls-sleeper__title" id="mls-sleeper-title">Sleeper</h2>
				{sleeperNotice && <p class="mls-sleeper__notice" role="status">{sleeperNotice}</p>}
				{sleeperLink ? (
					<div class="mls-sleeper__linked">
						<span class="mls__mark mls__mark--crop">
							{sleeperAvatar ? (
								<img src={sleeperAvatar} alt="" loading="lazy" />
							) : null}
						</span>
						<span class="mls__id">
							<span class="mls__name">{sleeperLink.displayName}</span>
							<span class="mls__sub">@{sleeperLink.username}</span>
						</span>
						<form method="post" action="/api/live-sleeper">
							<input type="hidden" name="action" value="unlink" />
							<button type="submit" class="cta cta--ghost">Unlink</button>
						</form>
					</div>
				) : (
					<form class="mls-sleeper__form" method="post" action="/api/live-sleeper">
						<p class="mls__lede">
							Play on Sleeper too? Add your Sleeper username and those leagues
							show up on the board with live scores.
						</p>
						<input type="hidden" name="action" value="link" />
						<label class="mls-sleeper__label" for="mls-sleeper-username">Sleeper username</label>
						<div class="mls-sleeper__row">
							<input
								class="mls-sleeper__input"
								id="mls-sleeper-username"
								name="username"
								type="text"
								inputmode="text"
								autocomplete="username"
								autocapitalize="none"
								spellcheck="false"
								maxlength="40"
								pattern="@?[A-Za-z0-9_]{1,40}"
								required
							/>
							<button type="submit" class="cta cta--primary">Add</button>
						</div>
					</form>
				)}
			</section>
		</section>
	)}
</MflAppLayout>

