													<span class="visually-hidden">{n(v)}</span>
												</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{!report.focused && (
					<div class="ins__split">
						<section class="ins__card" aria-labelledby="ins-devices">
							<h2 class="ins__h2" id="ins-devices">Devices</h2>
							{report.devices.length === 0 ? <p class="ins__muted">Nothing yet.</p> : (
								<ul class="ins__list">
									{report.devices.map((r) => (
										<li>
											<span>{r.label}</span>
											<span class="ins__meter" aria-hidden="true"><span style={`width:${pct(r.count, deviceTotal)}%`}></span></span>
											<span class="num">{pct(r.count, deviceTotal)}%</span>
										</li>
									))}
								</ul>
							)}
						</section>
						<section class="ins__card" aria-labelledby="ins-sources">
							<h2 class="ins__h2" id="ins-sources">How people arrive</h2>
							{report.sources.length === 0 ? <p class="ins__muted">Nothing yet.</p> : (
								<ul class="ins__list">
									{report.sources.map((r) => (
										<li>
											<span>{r.label}</span>
											<span class="ins__meter" aria-hidden="true"><span style={`width:${pct(r.count, sourceTotal)}%`}></span></span>
											<span class="num">{pct(r.count, sourceTotal)}%</span>
										</li>
									))}
								</ul>
							)}
							<p class="ins__note">
								Counted once per visit, at the first page. Links opened from the GroupMe app send no
								referrer, so they show as Direct.
							</p>
						</section>
					</div>
				)}

				{section === null && !report.focused && report.sections.length > 1 && (
					<section class="ins__card" aria-labelledby="ins-sections">
						<h2 class="ins__h2" id="ins-sections">By section</h2>
						<ul class="ins__list">
							{report.sections.map((r) => (
								<li>
									<a href={href({ section: r.key })}>{r.label}</a>
									<span class="ins__meter" aria-hidden="true"><span style={`width:${pct(r.count, report.totals.views)}%`}></span></span>
									<span class="num">{n(r.count)}</span>
								</li>
							))}
						</ul>
					</section>
				)}

				{!report.focused && (
					<section class="ins__card" aria-labelledby="ins-links">
						<h2 class="ins__h2" id="ins-links">How people get around</h2>
						<p class="ins__note">
							Pages reached by clicking a link in each part of the site, counted when the page loads.
							Owners counts distinct signed-in owners. Started Oct 2026; links typed or bookmarked are not counted.
						</p>
						<div class="ins__scroll">
							<table class="ui-table ins__table ins__table--stack" data-sortable="links">
								<thead>
									<tr>
										<th data-sort="text"><button type="button" class="ins__sort">Clicked from</button></th>
										<th class="num" data-sort="num" aria-sort="descending"><button type="button" class="ins__sort">Clicks</button></th>
										<th class="num" data-sort="num"><button type="button" class="ins__sort">Owners</button></th>
										<th>Top destinations</th>
									</tr>
								</thead>
								<tbody>
									{report.links.map((l) => (
										<tr>
											<td>{l.label}</td>
											<td class="num" data-label="Clicks">{n(l.clicks)}</td>
											<td class="num" data-label="Owners">{l.owners}</td>
											<td class="ins__muted ins__wide" data-label="Top destinations">
												{l.destinations.length === 0
													? '—'
													: l.destinations.slice(0, 4).map((d) => `${pageLabel(d.section, d.page)} (${n(d.clicks)})`).join(' · ')}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{!pageRef && (
					<section class="ins__card" aria-labelledby="ins-actions">
						<h2 class="ins__h2" id="ins-actions">Actions</h2>
						<p class="ins__note">Counted only when the action succeeded. Schefter tips are anonymous, so no owner count.</p>
						<div class="ins__scroll">
							<table class="ui-table ins__table" data-sortable="actions">
								<thead>
									<tr>
										<th data-sort="text"><button type="button" class="ins__sort">Action</button></th>
										<th class="num" data-sort="num" aria-sort="descending"><button type="button" class="ins__sort">Times</button></th>
										{!owner && <th class="num" data-sort="num"><button type="button" class="ins__sort">Owners</button></th>}
									</tr>
								</thead>
								<tbody>
									{report.actions.map((a) => (
										<tr>
											<td>{a.label}</td>
											<td class="num">{n(a.count)}</td>
											{!owner && <td class="num" data-v={a.owners ?? -1}>{a.owners === null ? '—' : a.owners}</td>}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{!report.focused && (
					<section class="ins__card" aria-labelledby="ins-interest">
						<h2 class="ins__h2" id="ins-interest">Product interest</h2>
						<p class="ins__note">
							Clicks on the "coming soon" product buttons, all time. People counts each browser once per product.
						</p>
						{interest === null ? (
							<p class="ins__note">Not available right now.</p>
						) : (
							<div class="ins__scroll">
								<table class="ui-table ins__table ins__table--stack" data-sortable="interest">
									<thead>
										<tr>
											<th data-sort="text"><button type="button" class="ins__sort">Product</button></th>
											<th class="num" data-sort="num" aria-sort="descending"><button type="button" class="ins__sort">People</button></th>
											<th class="num" data-sort="num"><button type="button" class="ins__sort">Clicks</button></th>
											<th class="num" data-sort="num"><button type="button" class="ins__sort">Emails</button></th>
											<th>Emails left</th>
										</tr>
									</thead>
									<tbody>
										{interest.map((r) => (
											<tr>
												<td>{r.name}</td>
												<td class="num" data-label="People">{n(r.people)}</td>
												<td class="num" data-label="Clicks">{n(r.clicks)}</td>
												<td class="num" data-label="Emails">{n(r.emails.length)}</td>
												<td class="ins__muted ins__wide" data-label="Emails left">{r.emails.length === 0 ? '—' : r.emails.map((e) => e.email).join(', ')}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						)}
					</section>
				)}
			</Fragment>
		)}
	</section>
</MflAppLayout>

<script>
	import { initSortableTables, onSortableHeaderClick } from '../../utils/sortable-table';

	// Registered once per module: `document` survives every ClientRouter swap,
	// and the handler acts only on the table that was clicked.
	document.addEventListener('click', onSortableHeaderClick);
	document.addEventListener('astro:page-load', () => {
		const root = document.querySelector<HTMLElement>('[data-ins-root]');
		if (root) initSortableTables(root);
	});
</script>

