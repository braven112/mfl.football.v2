---
/**
 * MFL Live — site analytics. ONE viewer: TheLeague's franchise 0001 with the
 * commissioner/admin role (`canViewSiteInsights`). Everyone else, signed in or
 * not, is sent to the board — the page does not admit to existing.
 *
 * Site-wide on purpose: TheLeague, the AFL, Best Ball, Archie's, MFL Live and
 * the shared host's own pages in one report, filterable by section. The
 * per-league, owner-visible `/activity` page is separate and unchanged.
 *
 * Filters compose and live in the URL, so any view can be bookmarked:
 * `days`, `section`, `owner` (a visitor key — the report becomes that owner's
 * profile), `page` (`<section>|<path>` — the report becomes "who opened this
 * page"), and `admins=show` (admins are left out by default; the commissioner
 * seat was about half of TheLeague's signed-in views). `stage` and `persona`
 * narrow the owners table to one lifecycle stage or usage style. Every table
 * sorts by any column, and each sort is kept in the URL too
 * (`s.<table>=<col>-<dir>`).
 *
 * Trends (lifecycle, depth curve, cohorts, personas, paths, month by month,
 * and the change from the previous window) come from
 * `site-insights-trends.ts`, under the same filters.
 *
 * Every number is derived by `buildInsightsReport` (pure, tested); this page
 * only reads and renders. Not in the page directory: search would show it to
 * other admins, and it is useless to them.
 *
 * `?mock` renders deterministic sample data (still gated), for design work
 * before the counters have filled.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import { getAuthUser } from '../../utils/auth';
import { mflLoginUrl } from '../../utils/mfl-login-redirect';
import {
	canViewSiteInsights,
	readInsightDays,
	readInsightMonths,
	readInsightPeople,
	seedInsightFirstSeen,
	seedInsightMonths,
} from '../../utils/site-insights';
import {
	LIFECYCLE_STAGES,
	PERSONAS,
	TREND_WEEKS,
	buildDepthAndCohorts,
	buildMonthRows,
	buildPaths,
	daysToRead,
	insightMonths,
	lifecycleStage,
	mockInsightMonths,
	parseLifecycleStage,
	parsePersona,
	percentChange,
	personaOf,
	splitWindows,
	type InsightMonthRaw,
	type LifecycleStage,
	type Persona,
} from '../../utils/site-insights-trends';
import {
	INSIGHTS_RANGES,
	INSIGHTS_TTL_DAYS,
	buildInsightsReport,
	insightClock,
	insightDates,
	insightSections,
	mockInsights,
	parseInsightsRange,
	parseOwnerRef,
	parsePageRef,
	sectionLabel,
	sectionOfVisitor,
	visitorKey,
	type InsightPageRef,
} from '../../utils/site-insights-model';
import { canonicalPath, directoryTitle } from '../../utils/site-analytics';
import { readProductInterest } from '../../utils/product-interest';
import { recordedPageTitle } from '../../utils/recorded-page-title';
import { formatLastSeen } from '../../utils/owner-activity';
import { getLeagueTeamConfig, getLeagueTeamConfigs } from '../../utils/league-team-brands';
import {
	ALL_LEAGUES,
	crossHostLeagueHref,
	ensureLeaguePrefix,
	getLeagueById,
	getLeagueBySlug,
	leagueClock,
	DEFAULT_LEAGUE_SLUG,
	type CanonicalLeagueSlug,
} from '../../config/leagues';
import '../../styles/mfl-live.css';

export const prerender = false;

const authUser = getAuthUser(Astro.request);
if (!authUser) return Astro.redirect(mflLoginUrl('/live/analytics'));
if (!canViewSiteInsights(authUser)) return Astro.redirect('/live');

const params = Astro.url.searchParams;
const range = parseInsightsRange(params.get('days'));
const sectionParam = params.get('section');
const sections = insightSections();
const section = sectionParam && sections.includes(sectionParam) ? sectionParam : null;
const owner = parseOwnerRef(params.get('owner'));
const pageRef = parsePageRef(params.get('page'), sections);
const showAdmins = params.get('admins') === 'show';
const stageParam = parseLifecycleStage(params.get('stage'));
const personaParam = parsePersona(params.get('persona'));
const useMock = params.has('mock');
const MONTHS_SHOWN = 12;
const zone = leagueClock(DEFAULT_LEAGUE_SLUG).zone;

// Every registry league's admin seats. Their own visits are most of a small
// league's traffic, so the report leaves them out unless asked.
const adminKeys = new Set(
	ALL_LEAGUES.flatMap((l) => (l.adminFranchiseIds ?? []).map((fid) => visitorKey(l.id, fid))),
);

let unavailable = false;
let raw: Awaited<ReturnType<typeof readInsightDays>> = [];
let people: Awaited<ReturnType<typeof readInsightPeople>> = [];
let months: InsightMonthRaw[] = [];

// Twice the window when the daily hashes still hold it, so every headline
// number can say how it moved since the window before.
const readDays = daysToRead(range, INSIGHTS_TTL_DAYS);

if (useMock) {
	const today = insightClock(new Date(), zone).date;
	const dates = insightDates(today, readDays);
	const owners = ALL_LEAGUES.flatMap((l) =>
		getLeagueTeamConfigs(l.slug).map((t: any) => ({ key: visitorKey(l.id, t.franchiseId), section: l.slug })),
	);
	({ days: raw, people } = mockInsights(dates, owners));
	months = mockInsightMonths(insightMonths(today, MONTHS_SHOWN), owners);
} else {
	try {
		await Promise.all([seedInsightFirstSeen(), seedInsightMonths()]);
		let monthRaw: InsightMonthRaw[] | null;
		[raw, people, monthRaw] = await Promise.all([
			readInsightDays(readDays),
			readInsightPeople(),
			readInsightMonths(MONTHS_SHOWN),
		]);
		months = monthRaw ?? [];
		if (raw === null) unavailable = true;
	} catch (err) {
		console.warn('[live/analytics] read failed:', err);
		unavailable = true;
	}
}

const windows = splitWindows(raw ?? [], range);
const filters = {
	section,
	owner,
	page: pageRef,
	excludeOwners: showAdmins ? new Set<string>() : adminKeys,
};
const report = buildInsightsReport({ days: windows.current, people, ...filters });
const previous = windows.previous ? buildInsightsReport({ days: windows.previous, people, ...filters }) : null;

const nowMs = Date.now();
const { depth, cohorts } = buildDepthAndCohorts({ days: windows.current, people, ...filters, zone });
const paths = buildPaths({ days: windows.current, ...filters });
const monthRows = buildMonthRows({ months, people, ...filters, zone })
	.filter((m) => m.views > 0 || m.owners > 0)
	.reverse();

// Lifecycle and persona per owner. Lifecycle counts every owner the section
// covers (by their league), not just this window's visitors — the lapsed and
// the never-seen are the point of it.
const recentByKey = new Map(report.people.map((p) => [p.key, p.recentDays]));
const stageOf = (p: { key: string; lastSeen: number | null; firstSeen?: number | null }): LifecycleStage =>
	lifecycleStage({ ...p, recentDays: recentByKey.get(p.key) ?? 0 }, nowMs);
const lifecyclePool = people.filter(
	(p) =>
		(showAdmins || !adminKeys.has(p.key)) &&
		(section === null || sectionOfVisitor(p.key) === section || recentByKey.has(p.key)),
);
const lifecycleCounts = new Map<LifecycleStage, number>();
for (const p of lifecyclePool) {
	const stage = stageOf(p);
	lifecycleCounts.set(stage, (lifecycleCounts.get(stage) ?? 0) + 1);
}
const lifecycleRows = (Object.keys(LIFECYCLE_STAGES) as LifecycleStage[]).map((stage) => ({
	stage,
	...LIFECYCLE_STAGES[stage],
	count: lifecycleCounts.get(stage) ?? 0,
}));
const lifecycleTotal = lifecyclePool.length;

const personaByKey = new Map(report.people.map((p) => [p.key, personaOf(p.pages)]));
const personaCounts = new Map<Persona, number>();
for (const persona of personaByKey.values()) if (persona) personaCounts.set(persona, (personaCounts.get(persona) ?? 0) + 1);
const personaRows = (Object.keys(PERSONAS) as Persona[])
	.map((persona) => ({ persona, ...PERSONAS[persona], count: personaCounts.get(persona) ?? 0 }))
	.filter((r) => r.count > 0)
	.sort((a, b) => b.count - a.count);
const personaTotal = personaRows.reduce((s, r) => s + r.count, 0);

const tablePeople = report.people.filter(
	(p) => (!stageParam || stageOf(p) === stageParam) && (!personaParam || personaByKey.get(p.key) === personaParam),
);

const prevPageViews = new Map((previous?.pages ?? []).map((p) => [`${p.section}|${p.page}`, p.views]));

// The homepage's "coming soon" product buttons. All-time, whatever the range.
let interest: Awaited<ReturnType<typeof readProductInterest>> = null;
if (!useMock && !report.focused) {
	try {
		interest = await readProductInterest();
	} catch (err) {
		console.warn('[live/analytics] product interest read failed:', err);
	}
}

// ── Display helpers ─────────────────────────────────────────────────────────

const fmt = new Intl.NumberFormat('en-US');
const n = (v: number) => fmt.format(v);

function ownerLabel(key: string): { team: string; league: string } {
	const i = key.indexOf(':');
	const leagueId = key.slice(0, i);
	const franchiseId = key.slice(i + 1);
	const league = getLeagueById(leagueId);
	const config = league ? getLeagueTeamConfig(league.slug, franchiseId) : undefined;
	return {
		team: (config?.name as string) || `Franchise ${franchiseId}`,
		league: league?.name ?? `League ${leagueId}`,
	};
}

function pageLabel(s: string, page: string): string {
	const league = getLeagueBySlug(s);
	if (league) {
		const slug = league.slug as CanonicalLeagueSlug;
		return directoryTitle(page, slug) ?? recordedPageTitle(canonicalPath(page, slug), slug) ?? page;
	}
	if (page === '/live') return 'Live board';
	if (page === '/live/league/:id') return 'Live — one league';
	if (page === '/live/settings') return 'Leagues & settings';
	if (page === '/live/analytics') return 'Site analytics';
	if (page === '/live/standings') return 'Live standings';
	if (page === '/login') return 'Sign in';
	if (page === '/') return 'Splash';
	return page;
}

/**
 * The real page behind a row, as an href that works from this host — the
 * league's own domain where the shared host no longer serves it. Null for a
 * path whose id segments were folded (`/players/:id`): there is no one page
 * to open.
 */
function realPageHref(s: string, page: string): string | null {
	if (page.includes(':id')) return null;
	const league = getLeagueBySlug(s);
	const path = league ? ensureLeaguePrefix(league, page) : page;
	return crossHostLeagueHref(Astro.url.hostname, path);
}

function dateLabel(date: string): string {
	const [y, m, d] = date.split('-').map(Number);
	return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		weekday: 'short',
		timeZone: 'UTC',
	});
}

function shortDate(ms: number | null | undefined): string {
	if (!ms) return '—';
	return new Date(ms).toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: new Date(ms).getFullYear() === new Date().getFullYear() ? undefined : 'numeric',
		timeZone: leagueClock(DEFAULT_LEAGUE_SLUG).zone,
	});
}

/** A per-row trend: one bar per day, scaled to that owner's own busiest day. */
function sparkBars(values: number[]): { x: number; h: number }[] {
	const max = Math.max(1, ...values);
	return values.map((v, i) => ({ x: i, h: v ? Math.max(2, Math.round((v / max) * 16)) : 0 }));
}

const clockLabel = leagueClock(DEFAULT_LEAGUE_SLUG).label;
const maxDayViews = Math.max(1, ...report.days.map((d) => d.views));
const maxDayOwners = Math.max(1, ...report.days.map((d) => d.activeOwners));
const maxHeat = Math.max(1, ...report.heatmap.flat());
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const hourLabel = (h: number) => (h === 0 ? '12a' : h < 12 ? `${h}a` : h === 12 ? '12p' : `${h - 12}p`);

const maxPage = Math.max(1, ...report.pages.map((p) => p.views));
const deviceTotal = report.devices.reduce((s, r) => s + r.count, 0);
const sourceTotal = report.sources.reduce((s, r) => s + r.count, 0);
const pct = (v: number, total: number) => (total ? Math.round((v / total) * 100) : 0);
const stickyTotal = report.stickiness.reduce((s, v) => s + v, 0);

const STALE_MS = 7 * 86_400_000;
const activeCount = report.people.filter((p) => p.lastSeen && nowMs - p.lastSeen < STALE_MS).length;

/** "▲ 12%" against the previous window, or null when there is none to compare. */
function delta(current: number, prev: number | undefined): { text: string; dir: 'up' | 'down' | 'flat' } | null {
	if (!previous || prev === undefined) return null;
	const change = percentChange(current, prev);
	if (change === null) return current > 0 ? { text: 'new', dir: 'up' } : null;
	if (change === 0) return { text: 'no change', dir: 'flat' };
	return { text: `${change > 0 ? '▲' : '▼'} ${Math.abs(change)}%`, dir: change > 0 ? 'up' : 'down' };
}
const comparedTo = `vs the ${range} days before`;

function monthLabel(month: string): string {
	const [y, m] = month.split('-').map(Number);
	return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
const maxMonthViews = Math.max(1, ...monthRows.map((m) => m.views));
const maxDepthPages = Math.max(1, ...depth.map((w) => w.avgPages));
const cohortWeeks = Math.min(
	TREND_WEEKS,
	Math.max(0, ...cohorts.map((c) => c.retention.reduce<number>((last, v, i) => (v === null ? last : i + 1), 0))),
);
const pageFrom = pageRef
	? paths.filter((p) => p.to === pageRef.page && p.from !== pageRef.page).slice(0, 8)
	: [];
const pageNext = pageRef
	? paths.filter((p) => p.from === pageRef.page && p.to !== pageRef.page).slice(0, 8)
	: [];

interface FilterState {
	days?: number;
	section?: string | null;
	owner?: string | null;
	page?: InsightPageRef | null;
	admins?: boolean;
	stage?: LifecycleStage | null;
	persona?: Persona | null;
	hash?: string;
}
const href = (next: FilterState) => {
	const q = new URLSearchParams();
	const days = next.days ?? range;
	const sec = next.section === undefined ? section : next.section;
	const own = next.owner === undefined ? owner : next.owner;
	const pg = next.page === undefined ? pageRef : next.page;
	const admins = next.admins ?? showAdmins;
	const stage = next.stage === undefined ? stageParam : next.stage;
	const persona = next.persona === undefined ? personaParam : next.persona;
	if (days !== 30) q.set('days', String(days));
	if (sec) q.set('section', sec);
	if (own) q.set('owner', own);
	if (pg) q.set('page', `${pg.section}|${pg.page}`);
	if (admins) q.set('admins', 'show');
	if (stage) q.set('stage', stage);
	if (persona) q.set('persona', persona);
	if (useMock) q.set('mock', '');
	const s = q.toString();
	return `/live/analytics${s ? `?${s}` : ''}${next.hash ? `#${next.hash}` : ''}`;
};

const sectionChips = [
	{ key: null as string | null, label: 'Whole site' },
	...sections.map((s) => ({ key: s as string | null, label: sectionLabel(s) })),
];

const ownerPerson = owner ? report.people.find((p) => p.key === owner) ?? null : null;
const ownerWho = owner ? ownerLabel(owner) : null;
const pageTitle = pageRef ? pageLabel(pageRef.section, pageRef.page) : null;
const pageRealHref = pageRef ? realPageHref(pageRef.section, pageRef.page) : null;
const viewsLabel = pageRef ? 'Views of this page' : 'Page views';
---

<MflAppLayout title="Site analytics — MFL Live" description="Admin-only site analytics">
	<section class="ins" data-ins-root>
		<a class="ins__back" href="/live">&larr; Board</a>
		<header class="ins__head">
			<h1 class="ins__title">Site analytics</h1>
			<p class="ins__lede">
				Who's using the site, and what they open. Visible only to you. Tap a page or an owner to
				focus the whole report on it; tap any column heading to sort.
				{useMock && <strong> Showing sample data.</strong>}
			</p>
		</header>

		<nav class="ins__filters" aria-label="Filters">
			<div class="ui-pills ins__chips" role="group" aria-label="Date range">
				{INSIGHTS_RANGES.map((d) => (
					<a class="ui-pill ins__chip" href={href({ days: d })} aria-current={d === range ? 'true' : undefined}>
						{d} days
					</a>
				))}
				<a
					class:list={['ui-pill', 'ins__chip', { 'ui-pill--active': !showAdmins }]}
					href={href({ admins: !showAdmins })}
					title="Tap to switch: admin seats' own visits"
				>
					{showAdmins ? 'Admins included' : 'Admins hidden'}
				</a>
			</div>
			<div class="ui-pills ins__chips" role="group" aria-label="Section">
				{sectionChips.map((c) => (
					<a
						class="ui-pill ins__chip"
						href={href({ section: c.key })}
						aria-current={c.key === section ? 'true' : undefined}
					>
						{c.label}
					</a>
				))}
			</div>
			{(owner || pageRef || stageParam || personaParam) && (
				<div class="ui-pills ins__chips" role="group" aria-label="Focus">
					{owner && ownerWho && (
						<a class="ui-pill ui-pill--active ins__chip" href={href({ owner: null })} aria-label={`Clear owner ${ownerWho.team}`}>
							Owner: {ownerWho.team} <span aria-hidden="true">✕</span>
						</a>
					)}
					{pageRef && (
						<a class="ui-pill ui-pill--active ins__chip" href={href({ page: null })} aria-label={`Clear page ${pageTitle}`}>
							Page: {pageTitle} <span aria-hidden="true">✕</span>
						</a>
					)}
					{stageParam && (
						<a class="ui-pill ui-pill--active ins__chip" href={href({ stage: null })} aria-label={`Clear stage ${LIFECYCLE_STAGES[stageParam].label}`}>
							Stage: {LIFECYCLE_STAGES[stageParam].label} <span aria-hidden="true">✕</span>
						</a>
					)}
					{personaParam && (
						<a class="ui-pill ui-pill--active ins__chip" href={href({ persona: null })} aria-label={`Clear style ${PERSONAS[personaParam].label}`}>
							Style: {PERSONAS[personaParam].label} <span aria-hidden="true">✕</span>
						</a>
					)}
				</div>
			)}
		</nav>

		{unavailable ? (
			<p class="ins__empty">Analytics storage is unavailable right now, so there's nothing to show. Try again shortly.</p>
		) : (
			<Fragment>
				{owner && ownerWho && (
					<section class="ins__card ins__profile" aria-labelledby="ins-profile">
						<h2 class="ins__h2 ins__profile-name" id="ins-profile">{ownerWho.team}</h2>
						<p class="ins__muted">
							{ownerWho.league}{ownerPerson?.username && ` · ${ownerPerson.username}`}
							{adminKeys.has(owner) && ' · admin'}
						</p>
						<dl class="ins__facts">
							<div><dt>First seen</dt><dd>{shortDate(ownerPerson?.firstSeen)}</dd></div>
							<div><dt>Last seen</dt><dd>{formatLastSeen(ownerPerson?.lastSeen ?? null)}</dd></div>
							<div><dt>Last sign-in</dt><dd>{ownerPerson?.lastLogin ? formatLastSeen(ownerPerson.lastLogin) : '—'}</dd></div>
							<div><dt>Active days</dt><dd>{ownerPerson?.activeDays ?? 0} of {range}</dd></div>
							<div><dt>Last 7 days</dt><dd>{ownerPerson?.recentDays ?? 0} of 7</dd></div>
							<div><dt>Pages opened</dt><dd>{report.pages.length}</dd></div>
							<div><dt>Stage</dt><dd>{LIFECYCLE_STAGES[stageOf({ key: owner, lastSeen: ownerPerson?.lastSeen ?? null, firstSeen: ownerPerson?.firstSeen ?? null })].label}</dd></div>
							<div><dt>Style</dt><dd>{(() => { const pz = personaOf(ownerPerson?.pages ?? []); return pz ? PERSONAS[pz].label : '—'; })()}</dd></div>
						</dl>
					</section>
				)}

				{pageRef && (
					<section class="ins__card ins__profile" aria-labelledby="ins-page-focus">
						<h2 class="ins__h2 ins__profile-name" id="ins-page-focus">{pageTitle}</h2>
						<p class="ins__muted">
							{sectionLabel(pageRef.section)} · <code>{pageRef.page}</code>
						</p>
						{pageRealHref ? (
							<a class="cta cta--ghost ins__open" href={pageRealHref} target="_blank" rel="noopener">
								Open this page <span aria-hidden="true">↗</span>
							</a>
						) : (
							<p class="ins__note">One row for every item of this kind (ids folded), so there is no single page to open.</p>
						)}
					</section>
				)}

				<div class="ins__tiles">
					{[
						{ show: true, value: n(report.totals.views), label: viewsLabel, d: delta(report.totals.views, previous?.totals.views) },
						{ show: !owner, value: n(report.totals.owners), label: 'Owners who visited', d: delta(report.totals.owners, previous?.totals.owners) },
						{ show: !owner, value: n(report.totals.weeklyOwners), label: 'Active in last 7 days', d: delta(report.totals.weeklyOwners, previous?.totals.weeklyOwners) },
						{ show: !owner, value: String(report.totals.avgDailyOwners), label: 'Avg owners / day', d: delta(report.totals.avgDailyOwners, previous?.totals.avgDailyOwners) },
						{ show: section === null && !pageRef, value: n(report.totals.logins), label: 'Sign-ins', d: delta(report.totals.logins, previous?.totals.logins) },
						{ show: !pageRef, value: n(report.totals.actions), label: 'Actions taken', d: delta(report.totals.actions, previous?.totals.actions) },
						{ show: !owner, value: `${pct(report.totals.anonymousViews, report.totals.views)}%`, label: 'Views while signed out', d: null },
					]
						.filter((t) => t.show)
						.map((t) => (
							<div class="ins__tile">
								<span class="ins__tile-value">{t.value}</span>
								<span class="ins__tile-label">{t.label}</span>
								{t.d && (
									<span class:list={['ins__delta', `is-${t.d.dir}`]} title={comparedTo}>
										{t.d.text}<span class="visually-hidden"> {comparedTo}</span>
									</span>
								)}
							</div>
						))}
				</div>

				{previous && <p class="ins__note ins__tiles-note">Arrows compare with the {range} days before.</p>}

				{!report.focused && lifecycleTotal > 0 && (
					<section class="ins__card" aria-labelledby="ins-life">
						<h2 class="ins__h2" id="ins-life">Where owners are</h2>
						<p class="ins__note">
							Every owner{section ? ` in ${sectionLabel(section)}` : ''}, by where they are in their life on the site. Tap a stage to list those owners.
						</p>
						<div class="ins__stack-bar" role="img" aria-label={lifecycleRows.filter((r) => r.count).map((r) => `${r.label} ${r.count}`).join(', ')}>
							{lifecycleRows.filter((r) => r.count > 0).map((r) => (
								<span class={`ins__seg ins__seg--${r.stage}`} style={`flex-grow:${r.count}`} title={`${r.label}: ${r.count}`}></span>
							))}
						</div>
						<ul class="ins__list ins__legend ins__legend--pct">
							{lifecycleRows.map((r) => (
								<li>
									<a href={href({ stage: r.stage, owner: null, page: null, hash: 'ins-people' })} class:list={{ 'is-current': r.stage === stageParam }}>
										<span class={`ins__swatch ins__seg--${r.stage}`} aria-hidden="true"></span>
										<span>
											<span class="ins__legend-label">{r.label}</span>
											<span class="ins__legend-note">{r.note}</span>
										</span>
									</a>
									<span class="num">{pct(r.count, lifecycleTotal)}%</span>
									<span class="num">{r.count}</span>
