---
/**
 * MFL Football — create a team logo, on the website.
 *
 * The same builder as the app's Create team logo screen: the owner picks a
 * style, one or two team colors (from the grid or any hex; white and black come
 * with every prompt) and the kind of art,
 * and copies a prompt into ChatGPT, Gemini or Claude. We make no images
 * (decided with Brandon 2026-10-27). Every word of the prompt comes from
 * `src/utils/team-logo-prompt.ts`, which the client script imports, so the
 * site and the app's `/api/mfl-live/logo-prompt` write the same text.
 *
 * The owner's teams pre-fill the name. Signed out, the page still works with
 * a typed name; nothing here needs the session except that list.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import { getMflLiveUser } from '../../utils/auth';
import { listOwnerLeagues } from '../../utils/live/owner-league';
import {
	DEFAULT_LOGO_CHOICE,
	LOGO_COLOR_SUGGESTIONS,
	LOGO_COLORS,
	LOGO_KINDS,
	LOGO_MAX_COLORS,
	LOGO_STYLES,
} from '../../utils/team-logo-prompt';
import '../../styles/mfl-live.css';

export const prerender = false;

const user = getMflLiveUser(Astro.request);
const owned = user ? await listOwnerLeagues(user).catch(() => null) : null;
const teams = owned?.ok ? owned.leagues.map((l) => ({ name: l.franchiseName, league: l.leagueName })) : [];
const firstName = teams[0]?.name ?? '';
---

<MflAppLayout title="Create a team logo — MFL Football" description="Write an AI prompt for your fantasy team's logo">
	<section class="mls tlogo" data-team-logo>
		<a class="mls__back" href="/live">&larr; Live</a>
		<h1 class="mls__title">Create a team logo</h1>
		<p class="mls__lede">
			Pick a look and we&rsquo;ll write the prompt. Paste it into ChatGPT or Gemini to make the picture, or
			into Claude for a vector logo.
		</p>

		<div class="tlogo__field">
			<label class="tlogo__label" for="tlogo-name">Team name</label>
			<input id="tlogo-name" class="tlogo__input" type="text" maxlength="60" value={firstName} list="tlogo-teams" placeholder="Your team name" />
			{teams.length > 1 && (
				<datalist id="tlogo-teams">
					{teams.map((t) => <option value={t.name}>{t.league}</option>)}
				</datalist>
			)}
		</div>

		<div class="tlogo__field">
			<label class="tlogo__label" for="tlogo-idea">Mascot or idea</label>
			<input id="tlogo-idea" class="tlogo__input" type="text" maxlength="120" placeholder="a charging boar with a football" />
		</div>

		<div class="tlogo__field">
			<span class="tlogo__label" id="tlogo-style-label">Style</span>
			<div class="ui-pills" role="group" aria-labelledby="tlogo-style-label" data-group="style">
				{LOGO_STYLES.map((s) => (
					<button type="button" class="ui-pill" data-value={s.id} aria-pressed={(s.id === DEFAULT_LOGO_CHOICE.style) ? 'true' : 'false'}>{s.label}</button>
				))}
			</div>
		</div>

		<div class="tlogo__field">
			<span class="tlogo__label" id="tlogo-suggest-label">Team colors that work well together</span>
			<div class="tlogo__chips" role="group" aria-labelledby="tlogo-suggest-label" data-suggestions>
				{LOGO_COLOR_SUGGESTIONS.map((sg) => (
					<button type="button" class="tlogo__suggest" data-suggest={sg.hexes.join(',')}>
						<span class="tlogo__dots" aria-hidden="true">
							{sg.hexes.map((hex) => <span class="tlogo__dot" style={`--swatch:${hex}`}></span>)}
						</span>
						{sg.label}
					</button>
				))}
			</div>
		</div>

		<div class="tlogo__field">
			<span class="tlogo__label" id="tlogo-color-label">Or pick your own · up to {LOGO_MAX_COLORS}</span>
			<div class="tlogo__chips" role="group" aria-labelledby="tlogo-color-label" data-colors>
				{LOGO_COLORS.map((c) => (
					<button
						type="button"
						class="tlogo__swatch"
						style={`--swatch:${c.hex}`}
						data-hex={c.hex}
						aria-label={c.name}
						title={c.name}
						aria-pressed={((DEFAULT_LOGO_CHOICE.colors as readonly string[]).includes(c.hex)) ? 'true' : 'false'}
					></button>
				))}
				<label class="tlogo__swatch tlogo__swatch--own" title="Pick your own color">
					<input type="color" id="tlogo-own" value="#7A1F2B" aria-label="Pick your own color" />
				</label>
			</div>
			<p class="tlogo__picked" data-picked aria-live="polite"></p>
			<p class="tlogo__note" data-color-note aria-live="polite"></p>
		</div>

		<div class="tlogo__field">
			<span class="tlogo__label" id="tlogo-kind-label">Make</span>
			<div class="ui-pills" role="group" aria-labelledby="tlogo-kind-label" data-group="kind">
				{LOGO_KINDS.map((k) => (
					<button type="button" class="ui-pill" data-value={k.id} aria-pressed={(k.id === DEFAULT_LOGO_CHOICE.kind) ? 'true' : 'false'}>{k.label}</button>
				))}
			</div>
		</div>

		<p class="tlogo__warning" data-warning hidden></p>
		<pre class="tlogo__prompt" data-prompt></pre>
		<div class="tlogo__actions">
			<button type="button" class="cta cta--primary" data-copy>Copy prompt</button>
			<a class="cta cta--ghost" href="https://chatgpt.com/" target="_blank" rel="noopener">Open ChatGPT</a>
			<a class="cta cta--ghost" href="https://gemini.google.com/app" target="_blank" rel="noopener">Open Gemini</a>
			<a class="cta cta--ghost" href="https://claude.ai/new" target="_blank" rel="noopener">Open Claude</a>
			<span class="tlogo__copied" data-copied aria-live="polite"></span>
		</div>
	</section>
</MflAppLayout>

<script>
	import { buildTeamLogoPrompt, LOGO_COLORS, LOGO_MAX_COLORS, normalizeHex, pickLogoColors } from '../../utils/team-logo-prompt';
	import type { MflLiveAppLogoKind } from '../../../packages/shared-types/src/mfl-live-app-logo';

	function init() {
		const found = document.querySelector<HTMLElement>('[data-team-logo]');
		if (!found || found.dataset.ready) return;
		const root: HTMLElement = found;
		root.dataset.ready = '1';

		const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const name = $<HTMLInputElement>('#tlogo-name');
		const idea = $<HTMLInputElement>('#tlogo-idea');
		const own = $<HTMLInputElement>('#tlogo-own');
		let colors: string[] = Array.from(root.querySelectorAll<HTMLElement>('[data-hex][aria-pressed="true"]')).map((b) => b.dataset.hex!);

		const picked = (group: string) =>
			root.querySelector<HTMLElement>(`[data-group="${group}"] [aria-pressed="true"]`)?.dataset.value ?? '';
		const colorName = (hex: string) => LOGO_COLORS.find((c) => c.hex === hex)?.name ?? hex;

		function render() {
			root.querySelectorAll<HTMLElement>('[data-hex]').forEach((b) => b.setAttribute('aria-pressed', String(colors.includes(b.dataset.hex!))));
			$('[data-picked]').textContent = colors.length
				? `Picked: ${colors.map(colorName).join(', ')}. Tap a color again to remove it.`
				: 'No colors picked, so the prompt uses red.';
			$('[data-picked]').textContent += " White and black are always included, so you don't need to pick them.";
			const built = buildTeamLogoPrompt(
				{ teamName: name.value, idea: idea.value, style: picked('style'), colors, kind: picked('kind') as MflLiveAppLogoKind },
				'',
			);
			$('[data-prompt]').textContent = built.prompt;
			const note = $<HTMLElement>('[data-color-note]');
			note.dataset.tone = built.colorNote.tone;
			note.textContent = built.colorNote.text;
			root.querySelectorAll<HTMLElement>('[data-suggest]').forEach((b) =>
				b.setAttribute('aria-pressed', String(b.dataset.suggest === colors.join(','))),
			);
			const warning = $<HTMLElement>('[data-warning]');
			warning.hidden = !built.warning;
			warning.textContent = built.warning ?? '';
		}

		function toggle(hex: string) {
			// White and black come with every prompt, so they never take a slot.
			if (pickLogoColors([hex])[0] !== hex) return;
			if (colors.includes(hex)) colors = colors.filter((h) => h !== hex);
			else if (colors.length < LOGO_MAX_COLORS) colors = [...colors, hex];
			render();
		}

		root.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
			group.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-value]');
				if (!btn) return;
				group.querySelectorAll('[data-value]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				render();
			});
		});
		$('[data-suggestions]').addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-suggest]');
			if (!btn) return;
			colors = btn.dataset.suggest!.split(',');
			render();
		});
		$('[data-colors]').addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-hex]');
			if (btn) toggle(btn.dataset.hex!);
		});
		own.addEventListener('change', () => {
			const hex = normalizeHex(own.value);
			if (hex) toggle(hex);
		});
		name.addEventListener('input', render);
		idea.addEventListener('input', render);

		$('[data-copy]').addEventListener('click', () => {
			const text = $('[data-prompt]').textContent ?? '';
			const done = (msg: string) => ($('[data-copied]').textContent = msg);
			navigator.clipboard?.writeText(text).then(
				() => done('Copied'),
				() => done('Select the prompt and copy it'),
			) ?? done('Select the prompt and copy it');
		});

		render();
	}

	document.addEventListener('astro:page-load', init);
	init();
</script>

<style>
	.tlogo__field {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}
	.tlogo__label {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--content-text-muted);
	}
	.tlogo__input {
		font: inherit;
		padding: 0.6rem 0.75rem;
		border-radius: 10px;
		border: 1px solid var(--color-border-subtle);
		background: var(--color-surface-3);
		color: var(--page-text);
	}
	.tlogo__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tlogo__swatch {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 10px;
		border: 1px solid var(--color-border-subtle);
		background: var(--swatch);
		cursor: pointer;
		padding: 0;
		position: relative;
	}
	.tlogo__swatch[aria-pressed='true'] {
		outline: 3px solid var(--league-accent);
		outline-offset: 2px;
	}
	.tlogo__swatch--own {
		background: conic-gradient(#c8102e, #ffd100, #00843d, #1d4ed8, #4c1d95, #c8102e);
		overflow: hidden;
	}
	.tlogo__swatch--own input {
		position: absolute;
		inset: 0;
		opacity: 0;
		width: 100%;
		height: 100%;
		cursor: pointer;
	}
	.tlogo__picked,
	.tlogo__warning,
	.tlogo__copied {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
	.tlogo__suggest {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font: inherit;
		font-size: var(--font-size-sm);
		padding: 0.45rem 0.75rem;
		border-radius: 10px;
		border: 1px solid var(--color-border-subtle);
		background: transparent;
		color: var(--page-text);
		cursor: pointer;
	}
	.tlogo__suggest[aria-pressed='true'] {
		border-color: var(--league-accent);
		outline: 1px solid var(--league-accent);
		outline-offset: -2px;
	}
	.tlogo__dots {
		display: inline-flex;
		gap: 3px;
	}
	.tlogo__dot {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 50%;
		background: var(--swatch);
		border: 1px solid var(--color-border-subtle);
	}
	.tlogo__note {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
	.tlogo__note[data-tone='good'] {
		color: var(--color-success);
	}
	.tlogo__note[data-tone='weak'] {
		color: var(--color-warning);
	}
	.tlogo__warning {
		color: var(--color-warning);
		margin-bottom: 0.75rem;
	}
	.tlogo__prompt {
		white-space: pre-wrap;
		word-break: break-word;
		font-size: var(--font-size-sm);
		line-height: 1.5;
		padding: 0.9rem;
		border-radius: 12px;
		border: 1px solid var(--color-border-subtle);
		background: var(--color-surface-3);
		color: var(--page-text);
		margin: 0 0 1rem;
	}
	.tlogo__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
	}
</style>
