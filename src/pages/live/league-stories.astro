---
/**
 * League stories — what new leagues sent from /league-story, newest first,
 * each laid out under the questionnaire's own headings
 * (src/data/league-story-questions.ts) so it reads like the doc it replaces.
 * These are the raw material for a league's lore in data/schefter/<league>/.
 *
 * Gated exactly like `/live/video-ideas` (`canViewSiteInsights`): one viewer.
 * Not in the page directory, for the same reason: search would show it to
 * people it refuses. Storage: src/utils/league-story/submissions.ts.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import { getAuthUser } from '../../utils/auth';
import { mflLoginUrl } from '../../utils/mfl-login-redirect';
import { canViewSiteInsights } from '../../utils/site-insights';
import { listSubmissions } from '../../utils/league-story/submissions';
import { STORY_SECTIONS } from '../../data/league-story-questions';
import '../../styles/mfl-live.css';

export const prerender = false;

const authUser = getAuthUser(Astro.request);
if (!authUser) return Astro.redirect(mflLoginUrl('/live/league-stories'));
if (!canViewSiteInsights(authUser)) return Astro.redirect('/live');

const stories = await listSubmissions().catch(() => null);

const when = (iso: string) =>
  new Date(iso).toLocaleString('en-US', { timeZone: 'America/Los_Angeles', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) + ' PT';
---

<MflAppLayout title="League stories — MFL Football" description="Onboarding story questionnaires sent by new leagues">
  <section class="mls">
    <a class="mls__back" href="/live">&larr; Live board</a>
    <h1 class="mls__title">League stories</h1>
    <p class="mls__lede">What new leagues sent from <a href="/league-story">Tell us your league&rsquo;s story</a>, newest first.</p>

    {
      stories === null ? (
        <p class="mls__lede">Couldn&rsquo;t read the stories just now.</p>
      ) : stories.length === 0 ? (
        <p class="mls__lede">No stories yet.</p>
      ) : (
        <ul class="mls-fix__list">
          {stories.map((s) => (
            <li class="mls-fix__item">
              <details class="lst">
                <summary>
                  <span class="mls__name">{s.league}</span>
                  <span class="mls__sub">
                    {[when(s.at), s.name, s.platform].filter(Boolean).join(' · ')} · <a href={`mailto:${s.email}`}>{s.email}</a>
                  </span>
                </summary>
                {s.pasted && (
                  <>
                    <h2 class="lst__h">Pasted from their AI</h2>
                    <p class="lst__a">{s.pasted}</p>
                  </>
                )}
                {STORY_SECTIONS.filter((sec) => sec.questions.some((q) => s.answers[q.id])).map((sec) => (
                  <>
                    <h2 class="lst__h">{sec.title}</h2>
                    {sec.questions
                      .filter((q) => s.answers[q.id])
                      .map((q) => (
                        <>
                          <p class="lst__q">{q.label}</p>
                          <p class="lst__a">{s.answers[q.id]}</p>
                        </>
                      ))}
                  </>
                ))}
              </details>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</MflAppLayout>

<style>
  .lst summary {
    cursor: pointer;
    display: grid;
    gap: 0.2rem;
  }
  .lst__h {
    margin: 1rem 0 0.25rem;
    font-size: var(--font-size-base);
  }
  .lst__q {
    margin: 0.5rem 0 0.1rem;
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
  }
  .lst__a {
    margin: 0;
    white-space: pre-wrap;
  }
</style>
