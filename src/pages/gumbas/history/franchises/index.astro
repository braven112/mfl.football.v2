---
/**
 * History franchises tab (Gumbas) — thin route over the SAME shared League History page
 * TheLeague and the AFL render (components/shared/league-history/HistoryFranchisesPage).
 *
 * The dataset is read HERE through the league-data loader (missing → null
 * until the first sync builds it): a static import specifier can't be a
 * runtime variable, and `Astro.redirect()` only redirects from a page.
 */
import HistoryFranchisesPage from '../../../../components/shared/league-history/HistoryFranchisesPage.astro';
import { getAuthUser } from '../../../../utils/auth';
import { mflLoginUrl } from '../../../../utils/mfl-login-redirect';
import { canViewLeagueHistory } from '../../../../utils/league-history/access';
import { loadLeagueData } from '../../../../utils/league-data';
import { getLeagueBySlug } from '../../../../config/leagues';

export const prerender = false;

const league = getLeagueBySlug('gumbas')!;
const historyData: any = await loadLeagueData(`${league.dataPath}/derived/league-history.json`);
if (!historyData) return Astro.rewrite('/_not-found');

const authUser = getAuthUser(Astro.request);
if (!canViewLeagueHistory(authUser)) {
  if (!authUser) return Astro.redirect(mflLoginUrl(Astro.url.pathname));
  return Astro.rewrite('/_not-found');
}
---

<HistoryFranchisesPage leagueSlug="gumbas" data={historyData} />
