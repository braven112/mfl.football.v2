---
/**
 * A shared Ask the History answer (Gumbas) — thin route over
 * components/shared/league-history/HistoryAnswerPage. Open to anyone with the
 * link; an unknown or expired id is a 404.
 */
import HistoryAnswerPage from '../../../../components/shared/league-history/HistoryAnswerPage.astro';
import { readAnswer } from '../../../../utils/league-history/ask-store';

export const prerender = false;

const saved = await readAnswer('gumbas', Astro.params.id ?? '').catch(() => null);
if (!saved) return Astro.rewrite('/_not-found');
if (saved.guest) Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<HistoryAnswerPage leagueSlug="gumbas" saved={saved} />
