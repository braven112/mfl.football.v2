---
/**
 * /products/features — the feature catalog every product page links into, so
 * a shared feature is described once. Admin-only until launch; see
 * `src/utils/product-pages-access.ts`.
 */
import MflAppLayout from '../../layouts/MflAppLayout.astro';
import { getAuthUser } from '../../utils/auth';
import { mflLoginUrl } from '../../utils/mfl-login-redirect';
import { canViewProductPages } from '../../utils/product-pages-access';
import { FEATURES, productsIncluding, productHref } from '../../data/products';
import ProductShot from '../../components/shared/products/ProductShot.astro';
import '../../styles/products.css';

export const prerender = false;

const authUser = getAuthUser(Astro.request);
if (!canViewProductPages(authUser)) {
	if (!authUser) return Astro.redirect(mflLoginUrl('/products/features'));
	return Astro.rewrite('/_not-found');
}
---

<MflAppLayout title="Feature catalog" description="Every platform feature, and which products include it.">
	<div class="prd">
		<a class="prd__back" href="/products">&larr; All products</a>
		<header class="prd__head">
			<p class="prd__eyebrow">Feature catalog</p>
			<h1 class="prd__title">What the platform does</h1>
			<p class="prd__lede">
				Each feature is described once here. Product pages link to it, and every feature lists
				the products that include it.
			</p>
		</header>

		<div class="prd__catalog">
			{FEATURES.map((feature) => {
				const includedIn = productsIncluding(feature.id);
				return (
					<section class="prd__catalog-item" id={feature.id} aria-labelledby={`f-${feature.id}`}>
						<h2 id={`f-${feature.id}`}>{feature.name}</h2>
						{feature.screenshot && <ProductShot shot={feature.screenshot} variant="catalog" />}
						<p>{feature.summary}</p>
						<ul>
							{feature.details.map((detail) => <li>{detail}</li>)}
						</ul>
						{includedIn.length > 0 && (
							<p class="prd__in">
								Included in{' '}
								{includedIn.map((p, i) => (
									<Fragment>
										{i > 0 && ', '}
										<a href={productHref(p.slug)}>{p.name}</a>
									</Fragment>
								))}
							</p>
						)}
					</section>
				);
			})}
		</div>
	</div>
</MflAppLayout>
