---
/**
 * Best Ball #1 — Live Scoring (/best-ball-1/live-scoring)
 *
 * A thin wrapper over the shared `LiveBoardPage`. This page matters MORE here
 * than in the other leagues: with no lineups to set, scoreboard watching is
 * the entire in-season experience.
 *
 * Two things it does NOT get, both decided in the registry rather than here:
 * Throwback Week (no `history[]`, so `strictThrowbackScopeForLeagueSlug`
 * returns null) and the offseason replay (`liveScoringSample: false` — the
 * bundled sample is another league's teams, and the board's own empty state is
 * the honest answer out of season).
 *
 * What stays here is what cannot move into a component: the feature gate's
 * `Astro.redirect()`, which from an imported component only stops rendering it
 * and ships a blank 200.
 */
import LiveBoardPage from '../../components/shared/live/LiveBoardPage.astro';
import { getLeagueContext } from '../../utils/league-context';
import { leagueHasFeature } from '../../config/leagues';

// Live-fetch on every request — scores must never be cached.
export const prerender = false;

const league = getLeagueContext(Astro.url);

if (!leagueHasFeature(league.slug, 'liveScoring')) {
  return Astro.redirect('/best-ball-1');
}
---

<LiveBoardPage title="Live Scoring | Best Ball #1" />
