---
/**
 * The AFL's trophies on the shared franchise page
 * (src/components/shared/franchises/FranchisePage.astro renders them into its
 * slots): the tier pill beside the name, the trophy summary in the lockup and
 * the trophy wall. One component for all three so their scoped styles stay
 * together; `part` picks which. AFL awards, tiers and badge art are the AFL's
 * own competition — the shared page never learns them.
 */
import {
  getFranchiseTrophyCase,
  getFranchiseTrophyRoom,
  getFranchiseTitleProgress,
  getFranchiseTrophyRank,
  getFranchiseTierRank,
  type AwardSlug,
  type AwardTier,
  type TrophyCaseItem,
} from '../../utils/afl-awards';
import { stampBadgeYear } from '../../utils/afl-badge';

interface Props {
  part: 'pill' | 'summary' | 'wall';
  team: any;
}
const { part, team } = Astro.props;
const id: string = team.franchiseId;

// Badge art loaded raw so the editable year can be stamped per win (an <img>
// can't be edited per instance). These are build-time repo assets only — safe
// to inject via set:html. Keyed by filename.
const badgeSvgRaw = import.meta.glob('../../../public/assets/afl/awards/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const BADGE_SVG: Record<string, string> = {};
for (const [p, raw] of Object.entries(badgeSvgRaw)) {
  BADGE_SVG[p.split('/').pop() as string] = raw;
}
// Stamp the win year (or blank it with '' for a locked placeholder) and make
// the #yearArc id unique per instance. Pure transform lives in afl-badge.ts.
function renderBadge(badge: string, year?: number | string, uid = ''): string {
  return stampBadgeYear(BADGE_SVG[badge] ?? '', year, uid);
}

// Trophy case — only awards this franchise actually won. Dated majors (AFL
// Championship, AFL Cup, NIT, Premier League, D-League) expand to one
// year-stamped badge per win; undated awards (divisions, conference) show once
// with a win count. Sourced from data/afl-fantasy/awards-history.json (2016+).
const trophyCase: TrophyCaseItem[] = getFranchiseTrophyCase(id);
const totalBadges = trophyCase.reduce(
  (sum, t) => sum + (t.dated ? 1 : t.years.length),
  0
);

// The team's own division + conference titles also show as locked placeholders
// when unwon. Map the current config assignment to award slugs.
const DIVISION_SLUG_BY_NAME: Record<string, AwardSlug> = {
  North: 'al-north',
  South: 'al-south',
  East: 'nl-east',
  West: 'nl-west',
};
const divisionSlug = DIVISION_SLUG_BY_NAME[team.division as string];
const conferenceSlug: AwardSlug = team.conference === '00' ? 'al-champion' : 'nl-champion';
const trophyTiers = getFranchiseTrophyRoom(id, { divisionSlug, conferenceSlug });

// Title-type progress — how many of the six title TYPES (AFL, Premier,
// Conference, Division, D-League, NIT) this franchise has won at least one of.
// Rendered as a segmented progress bar under the Trophy wall headline.
const titleProgress = getFranchiseTitleProgress(id);
// Full accessible summary so the per-type detail isn't mouse-only (the visual
// pips carry it via `title`): which types are won (+ count) and which aren't.
const wonTypeSummary = titleProgress.types
  .filter((t) => t.won)
  .map((t) => `${t.label} (won ${t.years.length})`)
  .join(', ');
const unwonTypeSummary = titleProgress.types
  .filter((t) => !t.won)
  .map((t) => t.label)
  .join(', ');
const titlePipsLabel =
  `Title types won: ${titleProgress.wonCount} of ${titleProgress.total}.` +
  (wonTypeSummary ? ` Won: ${wonTypeSummary}.` : '') +
  (unwonTypeSummary ? ` Not yet won: ${unwonTypeSummary}.` : '');

// Trophy-count rank across all AFL franchises (descending total trophies,
// standard competition ranking for ties). A zero-trophy case is left
// "unranked" — we hide the chip rather than show a meaningless "T-22nd".
const trophyRank = getFranchiseTrophyRank(id);
function ordinal(n: number): string {
  const mod100 = n % 100;
  if (mod100 >= 11 && mod100 <= 13) return `${n}th`;
  switch (n % 10) {
    case 1: return `${n}st`;
    case 2: return `${n}nd`;
    case 3: return `${n}rd`;
    default: return `${n}th`;
  }
}
const rankLabel =
  trophyRank.count > 0
    ? `${trophyRank.tied ? 'T-' : ''}${ordinal(trophyRank.rank)} of ${trophyRank.totalFranchises}`
    : null;

// Per-tier rank for each trophy-room section header ("Division Titles ·
// 1st of 24"). Same hide-when-empty rule as the overall rank — a tier the
// franchise has nothing in carries no chip.
function tierRankLabel(tier: AwardTier): string | null {
  const r = getFranchiseTierRank(id, tier);
  if (r.count === 0) return null;
  return `${r.tied ? 'T-' : ''}${ordinal(r.rank)} of ${r.totalFranchises}`;
}

// "No X" overlay text for an unwon (locked) badge.
function lockedLabel(t: TrophyCaseItem): string {
  switch (t.slug) {
    case 'afl-championship':
      return 'No AFL Championships';
    case 'premier-league':
      return 'No Premier League Championships';
    case 'dleague-champion':
      return 'No D-League Championships';
    case 'nit':
      return 'No NIT Championships';
  }
  if (t.category === 'conference') return 'No conference titles';
  if (t.category === 'division') return 'No division titles';
  return 'Not yet won';
}
---

{part === 'pill' && (
<span
  class:list={[
    'franchise-hero__tier-pill',
    team.tier === 'Premier League'
      ? 'franchise-hero__tier-pill--premier'
      : 'franchise-hero__tier-pill--dleague',
  ]}
>
  {team.tier}
</span>
)}
{/* Compact trophy summary: label + count + on-brand title-type pips,
     on one line directly under the identity row. */}
{part === 'summary' && (
<div class="lockup-trophies">
  <a class="lockup-trophies__label" href="#trophy-wall">Trophy wall</a>
  <span class="lockup-trophies__count">
    {totalBadges} {totalBadges === 1 ? 'trophy' : 'trophies'}
  </span>
  {rankLabel && (
    <span
      class="lockup-trophies__rank"
      title={`Ranked ${rankLabel} among all AFL franchises by total trophies won`}
    >
      {rankLabel}
    </span>
  )}
  <span class="lockup-trophies__pip-group">
    <span class="lockup-trophies__pips-caption" aria-hidden="true">Complete trophy set</span>
    <span class="title-pips" role="img" aria-label={titlePipsLabel}>
      {titleProgress.types.map((t) => (
        <span
          class="title-pips__pip"
          data-won={t.won ? 'true' : 'false'}
          title={t.won
            ? `${t.label} — won ${t.years.length} (${t.years.join(', ')})`
            : `${t.label} — not yet won`}
        />
      ))}
      <span class="title-pips__ratio">
        {titleProgress.wonCount}<span class="title-pips__total">/{titleProgress.total}</span>
      </span>
    </span>
  </span>
</div>
)}
{part === 'wall' && (
<section class="franchise-section trophy-room" id="trophy-wall">
  <h2 class="sr-only">Trophy wall</h2>
  {trophyTiers.length === 0 ? (
    <p class="badge-wall__empty">
      No hardware yet — this case is waiting for its first trophy.
    </p>
  ) : (
    <div class="trophy-tiers">
      {trophyTiers.map((tier) => (
        <section class="trophy-tier" data-tier={tier.key}>
          <h3 class="trophy-tier__title">
            {team.icon ? (
              <img class="trophy-tier__icon" src={team.icon} alt="" loading="lazy" />
            ) : null}
            <span>{tier.label}</span>
            {tierRankLabel(tier.key) && (
              <span
                class="trophy-tier__rank"
                title={`Ranked ${tierRankLabel(tier.key)} among all AFL franchises in ${tier.label.toLowerCase()}`}
              >
                {tierRankLabel(tier.key)}
              </span>
            )}
          </h3>
          <div class="badge-wall">
            {tier.items.map((t) => (
              <div
                class="badge-card"
                data-category={t.category}
                data-locked={t.locked ? 'true' : 'false'}
                role="img"
                aria-label={t.locked
                  ? lockedLabel(t)
                  : t.dated ? `${t.label} ${t.year}` : `${t.label} ${t.years.join(', ')}`}
              >
                <div
                  class="badge-card__art"
                  set:html={renderBadge(
                    t.badge,
                    t.locked ? '' : t.year,
                    t.locked ? `lock-${t.slug}` : t.dated ? `${t.slug}-${t.year}` : t.slug
                  )}
                />
                {t.locked ? <span class="badge-card__locked">{lockedLabel(t)}</span> : null}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  )}
</section>
)}

<style>
  .franchise-section {
    margin-bottom: var(--spacing-xl, 32px);
  }



  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .franchise-hero__tier-row {
    display: flex;
    gap: var(--spacing-sm, 8px);
    margin-bottom: var(--spacing-sm, 8px);
  }

  .franchise-hero__tier-pill {
    padding: 2px 10px;
    border-radius: 9999px;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .franchise-hero__tier-pill--premier {
    background: var(--league-accent, #c41e3a);
    color: var(--on-league-accent, white);
  }

  .franchise-hero__tier-pill--dleague {
    background: var(--content-bg-muted, #e5e7eb);
    color: var(--page-text, #1a1a1a);
  }


  /* Compact trophy summary strip: full-width row at the bottom of the lockup,
     directly under the identity row. Label · count · title-type pips, one line. */
  .lockup-trophies {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: var(--spacing-sm, 8px);
    padding-top: var(--spacing-sm, 8px);
    border-top: 1px solid var(--content-border, #e5e7eb);
  }

  /* Middot before the count (label · count). The pip group is separated by gap
     alone, so it never orphans a stray dot when it wraps on narrow screens. */
  .lockup-trophies__count::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--color-gray-400, #9ca3af);
  }

  .lockup-trophies__label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    /* Was hardcoded to --afl-navy (#0f1e2e) — correct against a light card,
       but --afl-navy IS the page background in dark mode, so navy-on-navy
       text would vanish. Use page-text so it inverts with the theme. */
    color: var(--page-text, #0f1e2e);
    text-decoration: none;
  }

  .lockup-trophies__label:hover {
    text-decoration: underline;
  }

  .lockup-trophies__count {
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
    font-variant-numeric: tabular-nums;
  }

  /* League-wide trophy-count rank, e.g. "· 3rd of 24" (T- prefix when tied).
     Same middot + muted treatment as the count so they read as one cluster. */
  .lockup-trophies__rank {
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
    font-variant-numeric: tabular-nums;
  }

  .lockup-trophies__rank::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--color-gray-400, #9ca3af);
  }

  /* Caption + pips travel together so they wrap as one unit on narrow screens.
     Pushed to the far right of the line so the complete trophy set + progress
     bar align right, opposite the label/count/rank cluster. */
  .lockup-trophies__pip-group {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* Micro-label naming what the pips measure: breadth across title types,
     not raw trophy volume. Editorial table-header treatment. */
  .lockup-trophies__pips-caption {
    font-size: var(--font-size-3xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-400, #9ca3af);
  }

  /* On-brand title-type progress: six slim pips, gold when won, + ratio. */
  .title-pips {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .title-pips__pip {
    width: 16px;
    height: 5px;
    border-radius: 3px;
    background: var(--content-border, #e5e7eb);
  }

  /* Brand trophy gold — matches the award-badge art, not the orange --afl-gold. */
  .title-pips__pip[data-won='true'] {
    background: var(--afl-trophy-gold, #c9a44c);
    background: linear-gradient(
      180deg,
      var(--afl-trophy-gold-light, #e6c976),
      var(--afl-trophy-gold, #c9a44c)
    );
  }

  .title-pips__ratio {
    margin-left: 0.375rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    /* Was hardcoded to --afl-navy — that's the page background in dark
       mode, so navy-on-navy text would vanish. Use page-text instead. */
    color: var(--page-text, #0f1e2e);
  }

  .title-pips__total {
    color: var(--color-gray-400, #9ca3af);
  }

  /* Trophy case — one badge per win; dated majors are year-stamped. */
  .trophy-tiers {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl, 32px);
  }

  .trophy-tier__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-left: 0.625rem;
    border-left: 2px solid var(--afl-trophy-gold, #c9a44c);
    margin: 0 0 var(--spacing-md, 16px) 0;
    color: var(--page-text, #1a1a1a);
  }

  /* League-wide rank for this tier, e.g. "· 1st of 24". Muted, mixed-case, and
     non-bold so it reads as context beside the uppercase section label. */
  .trophy-tier__rank {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--content-text-muted, #6b7280);
    font-variant-numeric: tabular-nums;
  }

  .trophy-tier__rank::before {
    content: '·';
    margin-right: 0.375rem;
    color: var(--color-gray-400, #9ca3af);
  }

  /* Small team icon anchoring each tier headline: img | headline. */
  .trophy-tier__icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 6px;
  }

  .badge-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--spacing-sm, 8px);
    justify-items: center;
  }

  /* Mobile (≤640px): the 200px auto-fill track only fits one badge below
     ~400px, leaving title badges stacked one-per-row. Pin to exactly two
     columns so a pair sits side by side all the way down to 320px — the
     fixed-200px cards shrink via their max-width:100% to fill each track. */
  @media (max-width: 640px) {
    .badge-wall {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Bare badges — no card chrome or labels; the medallion carries its own
     title and year. 200px columns fit four across on desktop. */
  .badge-card {
    position: relative;
    width: 200px;
    max-width: 100%;
  }

  .badge-card__art {
    display: block;
  }

  .badge-card__art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Unwon active award — faint greyed-out placeholder with an overlay label. */
  .badge-card[data-locked='true'] .badge-card__art {
    opacity: 0.12;
    filter: grayscale(1);
  }

  .badge-card__locked {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray-400, #9ca3af);
    pointer-events: none;
  }

  /* Mobile (≤640px): the 200px auto-fill track only fits one badge below
     ~400px, leaving title badges stacked one-per-row. Pin to exactly two
     columns so a pair sits side by side all the way down to 320px. Use
     minmax(0, 1fr) — not the default 1fr (minmax(auto, …)) — so the tracks
     can shrink below the cards' intrinsic 200px width, and drop the fixed
     width so each badge fills its half instead of overflowing the row.
     Placed after the base .badge-card rule so the width override wins in
     source order (media queries don't add specificity). */
  @media (max-width: 640px) {
    .badge-wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .badge-card {
      width: 100%;
    }
  }

  .badge-wall__empty {
    color: var(--content-text-muted, #6b7280);
    font-size: 0.9375rem;
  }
</style>
