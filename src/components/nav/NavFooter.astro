---
/**
 * NavFooter Component
 *
 * Fixed footer for the navigation drawer showing either:
 * 1. Authenticated state: Team logo, name, and owner info
 * 2. Unauthenticated state: "Verify Your Team" prompt with link to MFL
 *
 * Commissioners see a toggle button (up/down chevron) to switch between
 * owner mode and commissioner mode. Commissioner mode shows a circular
 * Goodell avatar and "Commissioner / League Office" labels.
 *
 * @see NavFooterProps in src/types/nav.ts
 * @see Design tokens in src/assets/css/src/_nav-tokens.scss
 */

import type { NavFooterProps, NavFooterLink, LeagueSlug } from '../../types/nav';
import { spriteUrl } from '../../utils/sprite-url';
import leagueConfigData from '../../data/theleague.config.json';
import ThemeToggle from '../ThemeToggle.astro';
import { getLeaguePrefix, resolveLeaguePath } from '../../utils/nav-utils';
import { getLeagueByNavSlug } from '../../config/leagues';
import { isSpotlightActive, spotlightNow } from '../../utils/feature-spotlight';
import '../../styles/feature-spotlight.css';
import { countryOptions } from '../../utils/broadcast-channels';
import {
  COUNTRY_COOKIE,
  ZONE_COOKIE,
  DEFAULT_VIEWER_PREFERENCES,
  LEAGUE_CLOCK,
  parseViewerPreferences,
  zoneShortName,
  zoneSummary,
} from '../../utils/viewer-preferences';

interface Props extends NavFooterProps {
  /** Current league for constructing roster link */
  league?: LeagueSlug;
}

// Build minimal team lookup map for client-side auth:login handling
const teamMap: Record<string, { name: string; icon: string | null }> = {};
for (const t of leagueConfigData.teams) {
  teamMap[t.franchiseId] = { name: t.name, icon: t.icon || null };
}

const {
  team,
  footerLinks = [],
  host,
  year,
  leagueId,
  verifyTeamUrl,
  league = 'theleague',
  isCommissioner = false,
  isCommishMode = false,
  hideLeaguePrefix = false,
} = Astro.props;

// Every internal link here goes through `resolveLeaguePath`, which drops the
// league prefix on an apex host — exactly as NavLinks resolves its own. It is
// not cosmetic: vercel.json 301s `/theleague/:path*` to `/:path*` on
// theleague.us, so a prefixed href costs every apex visitor a redirect hop.
const leagueBase = getLeaguePrefix(league);
const rosterUrl = resolveLeaguePath(`${leagueBase}/rosters`, hideLeaguePrefix);
const loginUrl = resolveLeaguePath(`${leagueBase}/login`, hideLeaguePrefix);

// Account-menu destinations.
// Both rows are registry-gated: best-ball publishes neither page, and a menu
// row that 404s is worse than no row.
const leagueFeatures = getLeagueByNavSlug(league).features;
const showPreferencesRow = leagueFeatures.viewerPreferences;
const showNotificationsRow = leagueFeatures.pushNotifications;
const preferencesUrl = resolveLeaguePath(`${leagueBase}/preferences`, hideLeaguePrefix);
const notificationsUrl = resolveLeaguePath(`${leagueBase}/notifications`, hideLeaguePrefix);

/**
 * The viewer's clock, READ FROM THE COOKIE ONLY.
 *
 * The nav renders on every page, so it must not do what `/preferences` does:
 * `resolveViewerPreferences` writes cookies (illegal from a component — the
 * headers are already committed) and reads Redis when the device has no cookie,
 * which here would be a Redis round-trip per page view. The cookies are written
 * only by an explicit choice, so their PRESENCE is the same `explicit` signal
 * `readViewerClock` returns — and their absence is the honest "you're on the
 * league's clock, same as before preferences existed".
 */
const rawCountry = Astro.cookies.get(COUNTRY_COOKIE)?.value ?? null;
const rawZone = Astro.cookies.get(ZONE_COOKIE)?.value ?? null;
const hasChosenClock = !!(rawCountry || rawZone);
const viewerPrefs = hasChosenClock ? parseViewerPreferences(rawCountry, rawZone) : null;
/**
 * The flag names the COUNTRY whose channels this viewer sees, and that has a
 * real default: `DEFAULT_VIEWER_PREFERENCES` is US, and Sunday Ticket, the
 * network badges and the game-day heroes have always resolved on it for a
 * viewer who never opened the picker. So the row shows that flag rather than
 * nothing — it reports what the site is already doing for them, which is the
 * pre-preference floor, not a guess.
 *
 * The CLOCK beside it is the opposite case and must NOT follow: there is no
 * default clock to report, because every league surface prints PT alone until
 * the viewer names one. Hence "League time (PT)" here, and no default zone
 * anywhere near it. Two floors, one row — see
 * docs/claude/rules/viewer-preferences.md.
 */
const flagCountry = viewerPrefs?.country ?? DEFAULT_VIEWER_PREFERENCES.country;
const viewerCountry = countryOptions().find((c) => c.code === flagCountry) ?? null;
const clockValue = viewerPrefs ? zoneSummary(viewerPrefs) : `League time (${zoneShortName(LEAGUE_CLOCK)})`;

/**
 * Build the MFL verify team URL
 * Points to the custom MFL page with embedded script that detects franchise ID
 */
const defaultVerifyUrl = `https://${host}/${year}/home/${leagueId}?MODULE=MESSAGE20`;
const verifyUrl = verifyTeamUrl || defaultVerifyUrl;

/**
 * Resolve URL templates with runtime values
 */
function resolveUrlTemplate(template: string): string {
  return template
    .replace('{host}', host)
    .replace('{year}', String(year))
    .replace('{leagueId}', leagueId);
}

/**
 * Get the resolved URL for a footer link
 */
function getFooterLinkUrl(link: NavFooterLink): string {
  if (link.urlTemplate) {
    return resolveUrlTemplate(link.urlTemplate);
  }
  return link.url || '#';
}

const isAuthenticated = !!team;

// Determine initial display state for commissioner toggle
const showCommish = isCommissioner && isCommishMode;

// The account menu hangs off the team row, so it needs a team to hang off —
// and being signed in is the ONLY condition. Gating it on the two link rows
// would leave a best-ball owner (both flags off, not a commissioner) with no
// way to sign out, which is the one row every signed-in owner always has.
// A signed-out visitor sees the verify prompt instead, with a standalone
// Preferences row below it (that page has no auth gate).
const showAccountMenu = isAuthenticated;

// The account menu is new, and a chevron nobody has a reason to press is a
// feature nobody finds. It pulses for its first week (server-side expiry, so
// it cleans itself up) and stops the moment this owner opens it (client-side,
// below) — whichever comes first.
const SPOTLIGHT_ID = 'nav-account-menu';
const spotlightAccountMenu = showAccountMenu && isSpotlightActive(SPOTLIGHT_ID, spotlightNow(Astro.url));
---

<footer
  class="nav-footer"
  role="contentinfo"
  data-nav-footer
  data-team-map={JSON.stringify(teamMap)}
  data-roster-url={rosterUrl}
  data-sprite-url={spriteUrl}
>
  {/* Authenticated State: Team Info Row with optional commissioner toggle */}
  {isAuthenticated && (
    <div class="nav-footer__team-row">
      <a
        href={rosterUrl}
        class="nav-footer__team"
        aria-label={showCommish ? 'Commissioner dashboard' : `View ${team.teamName} roster`}
        data-commish-link
        data-owner-label={`View ${team.teamName} roster`}
      >
        <div
          class:list={['nav-footer__team-logo', { 'nav-footer__team-logo--commish': showCommish }]}
          data-commish-swap="logo"
        >
          {showCommish && (
            <img
              src="/assets/commissioner-avatar.webp?v=5"
              alt="Commissioner"
              class="nav-footer__team-img"
              width="40"
              height="40"
              loading="lazy"
            />
          )}
          {!showCommish && team.iconUrl && (
            <img
              src={team.iconUrl}
              alt={`${team.teamName} logo`}
              class="nav-footer__team-img"
              width="40"
              height="40"
              loading="lazy"
            />
          )}
          {!showCommish && !team.iconUrl && (
            <div class="nav-footer__team-placeholder">
              <svg class="nav-footer__icon" aria-hidden="true">
                <use href={`${spriteUrl}#icon-shield-2`}></use>
              </svg>
            </div>
          )}
        </div>
        <div class="nav-footer__team-info" data-commish-swap="info">
          <span class="nav-footer__team-name">{showCommish ? 'Commissioner' : team.teamName}</span>
          {showCommish && (
            <span class="nav-footer__owner-name">League Office</span>
          )}
          {!showCommish && team.ownerName && (
            <span class="nav-footer__owner-name">{team.ownerName}</span>
          )}
        </div>
      </a>
      {showAccountMenu && (
        <button
          type="button"
          class:list={['nav-footer__account-toggle', { 'spotlight-pulse': spotlightAccountMenu }]}
          aria-label={spotlightAccountMenu ? 'Account and settings — new' : 'Account and settings'}
          aria-expanded="false"
          aria-controls="nav-account-panel"
          data-account-toggle
          data-spotlight={spotlightAccountMenu ? SPOTLIGHT_ID : undefined}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 15l5 5 5-5" />
            <path d="M7 9l5-5 5 5" />
          </svg>
        </button>
      )}
    </div>
  )}

  {/* Account & settings panel — the one place a viewer's own settings live:
      their clock, their alerts, commissioner mode, and the way out. */}
  {showAccountMenu && (
    <div class="nav-footer__account" id="nav-account-panel" data-account-panel hidden>
      {showPreferencesRow && (
        <a class="nav-footer__account-row" href={preferencesUrl}>
          <svg class="nav-footer__account-icon" aria-hidden="true">
            <use href={`${spriteUrl}#icon-wrench`}></use>
          </svg>
          <span class="nav-footer__account-label">
            Preferences
            <span class="nav-footer__account-value">
              {viewerCountry && <span class="nav-footer__account-flag" aria-hidden="true">{viewerCountry.flag}</span>}
              {clockValue}
            </span>
          </span>
          <svg class="nav-footer__account-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </a>
      )}

      {showNotificationsRow && (
        <a class="nav-footer__account-row" href={notificationsUrl}>
          <svg class="nav-footer__account-icon" aria-hidden="true">
            <use href={`${spriteUrl}#icon-bell`}></use>
          </svg>
          <span class="nav-footer__account-label">
            Notifications
            <span class="nav-footer__account-value">Which alerts reach your phone</span>
          </span>
          <svg class="nav-footer__account-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </a>
      )}

      {isCommissioner && (
        <button
          type="button"
          class="nav-footer__account-row nav-footer__account-row--button"
          aria-pressed={showCommish ? 'true' : 'false'}
          data-commish-toggle
          data-commish-team-name={team.teamName}
          data-commish-team-icon={team.iconUrl || ''}
          data-commish-team-owner={team.ownerName || ''}
          data-sprite-url={spriteUrl}
        >
          <svg class="nav-footer__account-icon" aria-hidden="true">
            <use href={`${spriteUrl}#icon-shield-2`}></use>
          </svg>
          <span class="nav-footer__account-label">
            Commissioner mode
            <span class="nav-footer__account-value">
              {showCommish ? 'On — league office tools unlocked' : 'Off — browsing as your team'}
            </span>
          </span>
          <span class="nav-footer__account-state" aria-hidden="true">{showCommish ? 'On' : 'Off'}</span>
        </button>
      )}

      <button
        type="button"
        class="nav-footer__account-row nav-footer__account-row--button nav-footer__account-row--signout"
        data-signout
      >
        <svg class="nav-footer__account-icon" aria-hidden="true">
          <use href={`${spriteUrl}#icon-user`}></use>
        </svg>
        <span class="nav-footer__account-label">
          Sign out
          <span class="nav-footer__account-value">{team.ownerName || team.teamName}</span>
        </span>
      </button>
    </div>
  )}

  {/* Screen reader announcement region for commissioner toggle */}
  {isAuthenticated && isCommissioner && (
    <div class="visually-hidden" aria-live="polite" role="status" aria-atomic="true" data-commish-announce></div>
  )}

  {/* Unauthenticated State: Verify Prompt */}
  {!isAuthenticated && (
    <a
      href={loginUrl}
      class="nav-footer__verify"
      aria-label="Log in to verify your team"
    >
      <div class="nav-footer__verify-icon">
        <svg class="nav-footer__icon" aria-hidden="true">
          <use href={`${spriteUrl}#icon-user`}></use>
        </svg>
      </div>
      <div class="nav-footer__verify-info">
        <span class="nav-footer__verify-label">Verify Your Team</span>
        <span class="nav-footer__verify-hint">Link your MFL account</span>
      </div>
      <svg class="nav-footer__verify-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </a>
  )}

  {/* Signed out, there is no team row to hang the account menu off — but
      /preferences has no auth gate and is the one setting that works without
      an account, so it keeps a home here now that it is no longer pinned at
      the top of the drawer. Notifications is deliberately absent: that page
      bounces a signed-out visitor to the login screen. */}
  {!isAuthenticated && showPreferencesRow && (
    <div class="nav-footer__account nav-footer__account--signed-out">
      <a class="nav-footer__account-row" href={preferencesUrl}>
        <svg class="nav-footer__account-icon" aria-hidden="true">
          <use href={`${spriteUrl}#icon-wrench`}></use>
        </svg>
        <span class="nav-footer__account-label">
          Preferences
          <span class="nav-footer__account-value">
            {viewerCountry && <span class="nav-footer__account-flag" aria-hidden="true">{viewerCountry.flag}</span>}
            {clockValue}
          </span>
        </span>
        <svg class="nav-footer__account-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </a>
    </div>
  )}

  {/* Theme preference — compact row, own top border so it doesn't crowd team identity */}
  <div class="nav-footer__theme-row">
    <span class="nav-footer__theme-label">Theme</span>
    <ThemeToggle size="compact" />
  </div>

  {/* Footer Links (e.g., "Back to MFL") */}
  {footerLinks.length > 0 && (
    <div class="nav-footer__links">
      {footerLinks.map((link) => (
        <a
          href={getFooterLinkUrl(link)}
          class="nav-footer__link"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          <svg class="nav-footer__link-icon" aria-hidden="true">
            <use href={`${spriteUrl}#icon-${link.icon}`}></use>
          </svg>
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  )}
</footer>

{/* Account panel disclosure + sign out. Re-queried on every astro:page-load
    because the ClientRouter swaps this element; the dataset flag is what stops
    a second listener stacking on the same node. */}
<script>
  /**
   * The chevron's spotlight pulse is NOT handled here. `NavDrawer.astro` owns
   * one delegated dismissal for every pulsing control in the drawer — this
   * toggle and any nav link inside its `newSince` week — so a click here is
   * already covered by that handler, and the class comes off without this
   * component knowing anything about localStorage.
   */
  function initAccountPanel() {
    const toggle = document.querySelector('[data-account-toggle]') as HTMLButtonElement | null;
    const panel = document.querySelector('[data-account-panel]') as HTMLElement | null;
    if (!toggle || !panel) return;
    if (toggle.dataset.accountToggleBound === '1') return;
    toggle.dataset.accountToggleBound = '1';

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      panel.hidden = open;
    });
  }

  function initSignOut() {
    const button = document.querySelector('[data-signout]') as HTMLButtonElement | null;
    if (!button) return;
    if (button.dataset.signoutBound === '1') return;
    button.dataset.signoutBound = '1';

    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      } catch {
        // The cookie clear is the server's job; a failed call means we are
        // still signed in, and reloading shows that honestly.
      }
      window.location.reload();
    });
  }

  document.addEventListener('astro:page-load', initAccountPanel);
  document.addEventListener('astro:page-load', initSignOut);
</script>

{/* Commissioner toggle client-side behavior — unconditional script, guarded by element check */}
<script>
  function initCommishToggle() {
    const COOKIE_NAME = 'commish-mode';
    const toggle = document.querySelector('[data-commish-toggle]') as HTMLButtonElement | null;
    if (!toggle) return;
    if (toggle.dataset.commishToggleBound === '1') return;
    toggle.dataset.commishToggleBound = '1';

    function isCommishMode(): boolean {
      return document.cookie.split('; ').some(c => c === `${COOKIE_NAME}=true`);
    }

    toggle.addEventListener('click', () => {
      const entering = !isCommishMode();
      // Set or clear the cookie, then reload so the server renders the correct state
      if (entering) {
        document.cookie = `${COOKIE_NAME}=true; path=/; max-age=31536000; SameSite=Lax`;
      } else {
        document.cookie = `${COOKIE_NAME}=; path=/; max-age=0`;
      }
      window.location.reload();
    });
  }

  // Initialize on page load and after View Transitions
  document.addEventListener('astro:page-load', initCommishToggle);
</script>

{/* Client-side auth:login handler — swaps "Verify Your Team" → team info when login happens without page reload */}
<script>
  let navFooterAuthLoginBound = false;

  function initAuthLoginListener() {
    if (navFooterAuthLoginBound) return;
    navFooterAuthLoginBound = true;

    window.addEventListener('auth:login', ((e: CustomEvent<{ franchiseId: string }>) => {
      const footer = document.querySelector('[data-nav-footer]') as HTMLElement | null;
      if (!footer) return;

      const teamMapRaw = footer.dataset.teamMap;
      const rosterUrl = footer.dataset.rosterUrl || '/theleague/rosters';
      const spUrl = footer.dataset.spriteUrl || '/assets/icons/sprite.svg';
      if (!teamMapRaw) return;

      let teamMap: Record<string, { name: string; icon: string | null }>;
      try { teamMap = JSON.parse(teamMapRaw); } catch { return; }

      const franchiseId = e.detail?.franchiseId;
      if (!franchiseId) return;

      const team = teamMap[franchiseId];
      if (!team) return;

      // Find and remove the verify prompt
      const verifyEl = footer.querySelector('.nav-footer__verify');
      if (!verifyEl) return; // Already authenticated — nothing to swap

      // Copy Astro's scoping attribute from an existing element so scoped CSS applies
      // to dynamically created elements. Astro adds data-astro-cid-xxxxx to all elements.
      const scopeAttr = Array.from(footer.attributes).find(a => a.name.startsWith('data-astro-cid-'));
      function applyScope(el: Element): void {
        if (scopeAttr) el.setAttribute(scopeAttr.name, scopeAttr.value);
      }

      // Build the authenticated team row
      const teamRow = document.createElement('div');
      teamRow.className = 'nav-footer__team-row';
      applyScope(teamRow);

      const link = document.createElement('a');
      link.href = rosterUrl;
      link.className = 'nav-footer__team';
      link.setAttribute('aria-label', `View ${team.name} roster`);
      applyScope(link);

      const logoDiv = document.createElement('div');
      logoDiv.className = 'nav-footer__team-logo';
      applyScope(logoDiv);
      if (team.icon) {
        const img = document.createElement('img');
        img.src = team.icon;
        img.alt = `${team.name} logo`;
        img.className = 'nav-footer__team-img';
        img.width = 40;
        img.height = 40;
        img.loading = 'lazy';
        applyScope(img);
        logoDiv.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'nav-footer__team-placeholder';
        applyScope(placeholder);
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('class', 'nav-footer__icon');
        svg.setAttribute('aria-hidden', 'true');
        applyScope(svg);
        const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
        use.setAttribute('href', `${spUrl}#icon-shield-2`);
        svg.appendChild(use);
        placeholder.appendChild(svg);
        logoDiv.appendChild(placeholder);
      }

      const infoDiv = document.createElement('div');
      infoDiv.className = 'nav-footer__team-info';
      applyScope(infoDiv);
      const nameSpan = document.createElement('span');
      nameSpan.className = 'nav-footer__team-name';
      nameSpan.textContent = team.name;
      applyScope(nameSpan);
      infoDiv.appendChild(nameSpan);

      link.appendChild(logoDiv);
      link.appendChild(infoDiv);
      teamRow.appendChild(link);

      // Swap: remove verify, insert team row before footer links
      verifyEl.replaceWith(teamRow);
    }) as EventListener);
  }

  document.addEventListener('astro:page-load', initAuthLoginListener);
</script>

<style>
  /* ==============================================
   * NAV FOOTER - Base Styles
   * ============================================== */
  .nav-footer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--nav-spacing-md, 12px);
    padding: var(--nav-spacing-lg, 16px);
    background: var(--nav-footer-bg, #f9fafb);
    border-top: 1px solid var(--nav-footer-border, #e5e7eb);
    min-height: var(--nav-footer-height, 80px);
    box-sizing: border-box;
    box-shadow: 0 -1px 1px hsl(220deg 3% 15% / 0.08),
                0 -2px 2px hsl(220deg 3% 15% / 0.06),
                0 -3px 4px hsl(220deg 3% 15% / 0.04);
  }

  /* ==============================================
   * TEAM ROW - Wrapper for team info + toggle
   * ============================================== */
  .nav-footer__team-row {
    display: flex;
    align-items: center;
    gap: var(--nav-spacing-xs, 4px);
  }

  .nav-footer__team-row .nav-footer__team {
    flex: 1;
    min-width: 0;
  }

  /* ==============================================
   * AUTHENTICATED STATE - Team Info (clickable link)
   * ============================================== */
  .nav-footer__team {
    display: flex;
    align-items: center;
    gap: var(--nav-spacing-md, 12px);
    position: relative;
    text-decoration: none;
    color: inherit;
    padding: var(--nav-spacing-sm, 8px);
    margin: calc(-1 * var(--nav-spacing-sm, 8px));
    border-radius: var(--nav-border-radius-md, 8px);
    transition: var(--nav-hover-transition, background-color 0.15s ease);
  }

  .nav-footer__team:hover {
    background: var(--nav-hover-bg, #f3f4f6);
  }

  .nav-footer__team:focus-visible {
    outline: none;
    box-shadow: var(--nav-focus-ring, 0 0 0 2px #1c497c);
  }

  .nav-footer__team-logo {
    flex-shrink: 0;
    width: var(--nav-team-logo-size, 40px);
    height: var(--nav-team-logo-size, 40px);
    border-radius: var(--nav-border-radius-md, 8px);
    overflow: hidden;
    background: var(--nav-bg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Circular avatar for commissioner mode */
  .nav-footer__team-logo--commish {
    border-radius: 50%;
  }

  .nav-footer__team-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-footer__team-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--nav-bg-subtle, #f9fafb);
  }

  .nav-footer__team-placeholder .nav-footer__icon {
    width: 24px;
    height: 24px;
    fill: var(--nav-text-muted, #6b7280);
  }

  .nav-footer__team-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0; /* Allow text truncation */
  }

  .nav-footer__team-name {
    font-size: var(--nav-team-name-size, 0.9375rem);
    font-weight: 600;
    color: var(--nav-footer-text, #333333);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
