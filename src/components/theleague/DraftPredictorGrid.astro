---
/**
 * DraftPredictorGrid - Grid display of all draft picks organized by round
 * Shows picks grouped by round with Compensatory picks marked as TBD
 * Configurable for different league formats (theLeague vs AFL Fantasy)
 */

import type { DraftPrediction } from '../../types/standings';
import type { LeagueSlug } from '../../types/nav';
import { resolveTeamBandForBodyText, teamBandStyle, bandCrestSrc, BAND_INK_LIGHT } from '../../utils/team-band';

export interface Props {
  predictions: DraftPrediction[];
  totalRounds?: number; // Default 3 for theLeague, 9 for AFL Fantasy
  teamsPerConference?: number; // Default 16 for theLeague, 12 for AFL Fantasy
  hasCompensatoryPicks?: boolean; // Default true for theLeague, false for AFL Fantasy
  championshipDetermined?: boolean; // Whether overall championship has been decided
  championLabel?: string; // Label for the reserved last pick: 'League Champion' (theLeague) or 'Conference Champion' (AFL)
  userTeamId?: string; // User's preferred team for highlighting their picks
  /**
   * Which league's franchise colours the pick plates read. REQUIRED, and not
   * decoration: this one component renders both leagues' order pages, and both
   * leagues have a franchise `0001`, so an unscoped lookup paints an AFL pick
   * in TheLeague Pigskins' red.
   */
  league: LeagueSlug;
}

const {
  predictions,
  totalRounds = 3,
  teamsPerConference = 16,
  hasCompensatoryPicks = true,
  championshipDetermined = false,
  championLabel = 'League Champion',
  userTeamId = '',
  league
} = Astro.props;

/**
 * The whole card in the club's colour — crest, name, pick number and all.
 *
 * Resolved through `resolveTeamBandForBodyText`, NOT `resolveTeamBand`, and
 * that is the load-bearing line here. The standard band measures its ink at
 * WCAG's 3:1 large-text floor, which is only earned while the text on the fill
 * is >=18.66px bold. This tile's type is 14.2px (`__name`), 16.5px
 * (`__number`) and 11.8px (`__label`) at this site's 18.9px root, in a 101px
 * card that cannot carry "Midwestside Connection" at 19px. Painting the card
 * at the large-text floor would have voided the measurement rather than passed
 * it, so the ink is measured at the 4.5:1 body floor instead.
 *
 * Measured over all 52 franchises: every one clears 4.5:1, and only three
 * fills move from what the standings band returns — the Ninjas, Smokane and
 * Best Ball's Franchise 01, all mid-greens, by ΔE 2.3-2.6. That is far below
 * the ~25 at which two colours read as different colours, so a club's draft
 * card and its standings row are the same colour to the eye; 22 of the 104
 * franchise/theme pairs simply take the other ink.
 *
 * The four status marks keep working because they were never only backgrounds:
 * `--user-team`, `--champion-tbd`, `--toilet-bowl` and `--league-winner` each
 * carry a border, and the CSS below leaves every border alone and overrides
 * only the fills and text colours.
 *
 * Returns null for a pick with no franchise — the TBD compensatory tiles, which
 * have no crest and no club — so those keep the card surface and dashed edge.
 */
function bandFor(pick: DraftPrediction) {
  if (!pick.franchiseId) return null;
  const band = resolveTeamBandForBodyText(pick.franchiseId, league);
  return {
    band,
    // The crest sits on the FILL, which is the club's colour in both themes, so
    // the cut is chosen by that fill and never by the reader's theme.
    crest: bandCrestSrc(pick.teamIcon, league, band.ink === BAND_INK_LIGHT),
  };
}

// Sort predictions by overall pick number
const sortedPredictions = [...predictions].sort(
  (a, b) => a.overallPickNumber - b.overallPickNumber
);

const formatTeamName = (name: string) => {
  const normalized = (name || '').trim();
  const key = normalized.toLowerCase();
  const replacements: Record<string, string> = {
    'the mariachi ninjas': 'Mariachi Ninjas',
    'running down the dream': 'The Dream',
    'dark magicians of chaos': 'Dark Magicians',
  };
  if (replacements[key]) return replacements[key];
  return normalized;
};

// Check if this conference has the champion
const hasChampion = sortedPredictions.some((p) => p.isLeagueWinner);

// Show "Reserved for Champ" only if championship hasn't been determined yet
// If championship is determined but this conference doesn't have the champion, show normal styling
const showChampionReserved = !championshipDetermined;

const isChampionPick = (pick: DraftPrediction) => pick.pickInRound === teamsPerConference;

// Group picks by round dynamically
const picksByRound: Record<number, DraftPrediction[]> = {};
for (let round = 1; round <= totalRounds; round++) {
  picksByRound[round] = sortedPredictions.filter((p) => p.round === round);
}

// Check which Compensatory picks have assignments (only for theLeague)
const specialPicksAssigned = hasCompensatoryPicks ? {
  '1.17': sortedPredictions.some((p) => p.round === 1 && p.pickInRound === 17),
  '2.17': sortedPredictions.some((p) => p.round === 2 && p.pickInRound === 17),
  '2.18': sortedPredictions.some((p) => p.round === 2 && p.pickInRound === 18),
} : {};

/**
 * The Legend's compensatory entries, resolved ONCE each.
 *
 * These are not swatches. When a compensatory pick has been assigned the
 * Legend renders the real franchise that owns it — the same pick the round
 * above already shows — so it has to be banded too, or one pick appears in two
 * different colours on one page.
 *
 * Resolved here rather than inline because the markup below was calling
 * `sortedPredictions.find(...)` six to eight times per entry, once for each
 * field, and a band would have added two more.
 */
const compPick = (round: number, pickInRound: number) =>
  hasCompensatoryPicks
    ? sortedPredictions.find((p) => p.round === round && p.pickInRound === pickInRound)
    : undefined;

const legendComp = [
  { key: '1.17', label: 'Toilet Bowl', pick: compPick(1, 17) },
  { key: '2.17', label: 'Consolation', pick: compPick(2, 17) },
  { key: '2.18', label: 'Consolation', pick: compPick(2, 18) },
].map((entry) => ({ ...entry, band: entry.pick ? bandFor(entry.pick) : null }));
---

<div class="draft-rounds-container">
  {Object.entries(picksByRound).map(([roundNum, roundPicks]) => {
    const round = parseInt(roundNum);
    const startPick = (round - 1) * teamsPerConference + 1;
    const endPick = round * teamsPerConference;
    const roundTitle = hasCompensatoryPicks && round === 1
      ? `Round ${round} (Picks ${startPick}-${endPick} + Compensatory ${round}.17)`
      : hasCompensatoryPicks && round === 2
      ? `Round ${round} (Picks ${startPick}-${endPick} + Compensatory ${round}.17, ${round}.18)`
      : `Round ${round} (Picks ${startPick}-${endPick})`;

    return (
      <div class="draft-round">
        <h3 class="draft-round__title">{roundTitle}</h3>
        <div class="draft-round__picks">
          {roundPicks.map((pick) => {
            const plate = bandFor(pick);
            return (
            <div
              class:list={[
                'draft-pick',
                {
                  'draft-pick--band': !!plate,
                  'draft-pick--league-winner': pick.isLeagueWinner,
                  'draft-pick--toilet-bowl': pick.isToiletBowlPick,
                  'draft-pick--champion': isChampionPick(pick) && hasChampion,
                  'draft-pick--champion-tbd': isChampionPick(pick) && showChampionReserved,
                  'draft-pick--user-team': userTeamId && pick.franchiseId === userTeamId,
                },
              ]}
              style={plate ? teamBandStyle(plate.band) : undefined}
              title={`${pick.teamName} - Pick ${pick.round}.${pick.pickInRound}`}
            >
              <div class="draft-pick__content">
                <div class="draft-pick__icon-container">
                  {pick.teamIcon && (
                    <img
                      src={plate ? plate.crest : pick.teamIcon}
                      alt={pick.teamName}
                      class="draft-pick__icon"
                    />
                  )}
                  {pick.isTraded && pick.originalTeamIcon && (
                    <img
                      src={pick.originalTeamIcon}
                      alt={pick.originalTeamName}
                      class="draft-pick__icon draft-pick__icon--original"
                      title={`Originally owned by ${pick.originalTeamName}`}
                    />
                  )}
                </div>
                <div class="draft-pick__name">{formatTeamName(pick.teamName)}</div>
                <div class="draft-pick__number">
                  {pick.round}.{String(pick.pickInRound).padStart(2, '0')}
                </div>
                {isChampionPick(pick) && (showChampionReserved || hasChampion) && (
                  <div class="draft-pick__label">{showChampionReserved ? 'Reserved for Champ' : championLabel}</div>
                )}
              </div>
            </div>
            );
          })}

          {/* Compensatory picks for theLeague only */}
          {hasCompensatoryPicks && round === 1 && !specialPicksAssigned['1.17'] && (
            <div class="draft-pick draft-pick--tbd draft-pick--special">
              <div class="draft-pick__content">
                <div class="draft-pick__name">TBD</div>
                <div class="draft-pick__number">1.17</div>
                <div class="draft-pick__label">Toilet Bowl</div>
              </div>
            </div>
          )}
          {hasCompensatoryPicks && round === 2 && !specialPicksAssigned['2.17'] && (
            <div class="draft-pick draft-pick--tbd draft-pick--special">
              <div class="draft-pick__content">
                <div class="draft-pick__name">TBD</div>
                <div class="draft-pick__number">2.17</div>
                <div class="draft-pick__label">Consolation</div>
              </div>
            </div>
          )}
          {hasCompensatoryPicks && round === 2 && !specialPicksAssigned['2.18'] && (
            <div class="draft-pick draft-pick--tbd draft-pick--special">
              <div class="draft-pick__content">
                <div class="draft-pick__name">TBD</div>
                <div class="draft-pick__number">2.18</div>
                <div class="draft-pick__label">Consolation</div>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  })}

  <!-- Legend -->
  <div class="draft-round">
    <h3 class="draft-round__title">Legend</h3>
    <div class="draft-round__picks">
      {/* User's team picks (if user has a preferred team) */}
      {userTeamId && (
        <div class="draft-pick draft-pick--legend draft-pick--user-team">
          <div class="draft-pick__content">
            <div class="draft-pick__icon-container">
              <svg viewBox="0 0 64 64" class="draft-pick__icon" style="color: #2e743d;" aria-hidden="true">
                <circle cx="32" cy="32" r="24" fill="currentColor" opacity="0.2"/>
                <path d="M32 16l4 12h12l-10 8 4 12-10-8-10 8 4-12-10-8h12z" fill="currentColor"/>
              </svg>
            </div>
            <div class="draft-pick__name">Your Picks</div>
            <div class="draft-pick__number">X.XX</div>
            <div class="draft-pick__label">Green border</div>
          </div>
        </div>
      )}

      {/* Champion placeholders - one for each round */}
      {Array.from({ length: totalRounds }, (_, i) => i + 1).map((round) => (
        <div class="draft-pick draft-pick--legend draft-pick--champion draft-pick--champion-tbd">
          <div class="draft-pick__content">
            <div class="draft-pick__icon-container">
              <svg viewBox="0 0 64 64" class="draft-pick__icon draft-pick__icon--crown" aria-hidden="true">
                <path d="M8 22l10 8 8-14 8 14 10-8 4 20H4l4-20z" fill="currentColor"/>
                <rect x="4" y="42" width="56" height="8" rx="2" fill="currentColor" opacity="0.15"/>
              </svg>
            </div>
            <div class="draft-pick__name">{championLabel}</div>
            <div class="draft-pick__number">{round}.{String(teamsPerConference).padStart(2, '0')}</div>
            <div class="draft-pick__label">Reserved</div>
          </div>
        </div>
      ))}

      {/* Compensatory picks for theLeague only. An ASSIGNED one shows the real
          franchise that owns it — the same pick the round above renders — so it
          carries the same band. An unassigned one is a TBD placeholder and gets
          no colour, exactly as in the rounds. */}
      {hasCompensatoryPicks && legendComp.map((entry) => (
        entry.pick && entry.band ? (
          <div
            class:list={['draft-pick', 'draft-pick--band', 'draft-pick--toilet-bowl']}
            style={teamBandStyle(entry.band.band)}
            title={`${entry.pick.teamName} - Pick ${entry.key}`}
          >
            <div class="draft-pick__content">
              <div class="draft-pick__icon-container">
                {entry.pick.teamIcon && (
                  <img src={entry.band.crest} alt={entry.pick.teamName} class="draft-pick__icon" />
                )}
                {entry.pick.isTraded && entry.pick.originalTeamIcon && (
                  <img
                    src={entry.pick.originalTeamIcon}
                    alt={entry.pick.originalTeamName}
                    class="draft-pick__icon draft-pick__icon--original"
                    title={`Originally owned by ${entry.pick.originalTeamName}`}
                  />
                )}
              </div>
              <div class="draft-pick__name">{formatTeamName(entry.pick.teamName)}</div>
              <div class="draft-pick__number">{entry.key}</div>
              <div class="draft-pick__label">{entry.label}</div>
            </div>
          </div>
        ) : (
          <div class="draft-pick draft-pick--tbd draft-pick--special">
            <div class="draft-pick__content">
              <div class="draft-pick__name">TBD</div>
              <div class="draft-pick__number">{entry.key}</div>
              <div class="draft-pick__label">{entry.label}</div>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</div>

<style>
  .draft-rounds-container {
    display: grid;
    gap: 2rem;
  }

  .draft-round {
    display: grid;
    gap: 1rem;
    background: var(--card-bg-color, #fff);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1));
  }

  .draft-round__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-gray-900, #111827);
  }

  .draft-round__picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.75rem;
  }

  .draft-pick {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80px;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 2px solid var(--draft-pick-border, transparent);
    background: var(--draft-pick-bg, var(--content-bg-muted, #f3f4f6));
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
  }

  .draft-pick:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.15);
  }

  .draft-pick--league-winner {
    background: #fffbeb;
    border-color: #fbbf24;
  }

  .draft-pick--champion {
    background: #fff7ed;
    border-color: #fb923c;
    color: #c2410c;
  }

  .draft-pick--champion-tbd {
    border-style: dashed;
  }

  .draft-pick--league-winner:hover {
    background: #fef3c7;
    border-color: #f59e0b;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #f59e0b, 0 4px 12px rgb(0 0 0 / 0.15);
  }

  .draft-pick--toilet-bowl {
    background: #fef2f2;
    border-color: #ff6b6b;
    border-style: dashed;
  }

  .draft-pick--toilet-bowl:hover {
    background: #fee2e2;
    border-color: #ff5252;
    box-shadow: 0 0 0 1px #ff6b6b, 0 4px 12px rgb(0 0 0 / 0.15);
  }

  .draft-pick--tbd {
    background: #f5f3ff;
    border-color: #c4b5fd;
    border-style: dashed;
  }

  .draft-pick--tbd:hover {
    background: #ede9fe;
    border-color: #a78bfa;
  }

  .draft-pick--user-team {
    background: #2e743d12;
    border-color: #2e743d;
    border-width: 3px;
    box-shadow: 0 0 0 1px rgba(46, 116, 61, 0.1), 0 4px 12px rgba(46, 116, 61, 0.15);
  }

  .draft-pick--user-team:hover {
    background: #2e743d36;
    border-color: #2e743d;
    box-shadow: 0 0 0 3px rgba(46, 116, 61, 0.2), 0 6px 16px rgba(46, 116, 61, 0.25);
    transform: translateY(-3px);
  }

  .draft-pick--special {
    box-shadow: 0 0 0 1px rgba(167, 139, 250, 0.2);
  }

  /* --- The whole card in the club's colour ------------------------------ */
  /* Scoped to `--band` so it reaches real pick cards only: the TBD
     compensatory tiles have no franchise, and the Legend's tiles are swatches
     rather than clubs. Neither should be painted.

     These rules come AFTER every status modifier on purpose. All of them are
     single-class selectors, so source order decides, and the club's colour is
     meant to win the FILL. What the modifiers keep is their BORDER — which is
     how each of them was already readable — so `--user-team`'s 3px green,
     `--champion-tbd`'s dash and `--toilet-bowl`'s dashed red all survive on
     top of the colour. Nothing below touches a border.

     Ink comes from the band, which for this surface was measured at the 4.5:1
     BODY floor (`resolveTeamBandForBodyText`) precisely because this card's
     type is 14.2px/16.5px/11.8px and cannot claim the large-text floor. */
  .draft-pick--band {
    background-color: var(--band-fill);
    border-color: color-mix(in srgb, var(--band-ink) 30%, transparent);
  }
  .draft-pick--band .draft-pick__name,
  .draft-pick--band .draft-pick__number {
    color: var(--band-ink);
  }
  /* The label is the quietest line on the card and stays quiet, but it is
     tinted from the ink rather than the old fixed slate — a fixed grey is
     unreadable on half these fills. */
  .draft-pick--band .draft-pick__label {
    color: color-mix(in srgb, var(--band-ink) 76%, transparent);
  }
  /* Hover tints toward the row's OWN ink, so it lightens a navy card and
     darkens a gold one with one rule — and it has to be declared here, or the
     status modifiers' own `:hover` backgrounds paint over the club colour. */
  .draft-pick--band:hover,
  .draft-pick--band.draft-pick--league-winner:hover,
  .draft-pick--band.draft-pick--toilet-bowl:hover,
  .draft-pick--band.draft-pick--user-team:hover {
    background-color: color-mix(in srgb, var(--band-ink) 12%, var(--band-fill));
  }

  :global(html.dark) .draft-pick--band {
    background-color: var(--band-fill-dark);
    border-color: color-mix(in srgb, var(--band-ink-dark) 30%, transparent);
  }
  :global(html.dark) .draft-pick--band .draft-pick__name,
  :global(html.dark) .draft-pick--band .draft-pick__number {
    color: var(--band-ink-dark);
  }
  :global(html.dark) .draft-pick--band .draft-pick__label {
    color: color-mix(in srgb, var(--band-ink-dark) 76%, transparent);
  }
  :global(html.dark) .draft-pick--band:hover,
  :global(html.dark) .draft-pick--band.draft-pick--league-winner:hover,
  :global(html.dark) .draft-pick--band.draft-pick--toilet-bowl:hover,
  :global(html.dark) .draft-pick--band.draft-pick--user-team:hover {
    background-color: color-mix(in srgb, var(--band-ink-dark) 12%, var(--band-fill-dark));
  }

  /* The status marks re-assert their own border over the band's tinted one.
     Declared after the band so the border colour they rely on is not lost. */
  .draft-pick--band.draft-pick--user-team {
    border-color: #2e743d;
  }
  .draft-pick--band.draft-pick--toilet-bowl {
    border-color: #ff6b6b;
  }
  .draft-pick--band.draft-pick--league-winner {
    border-color: #fbbf24;
  }
  .draft-pick--band.draft-pick--champion {
    border-color: #fb923c;
  }

  /* `bandCrestSrc` already chose the cut from the FILL, which is the club's
     colour in both themes. TeamIconDarkStyles is a global
     `html.dark img[src="<light>"]` rule, so without this it would override that
     choice after sunset and put a dark-card crest on a light fill. */
  :global(html.dark) .draft-pick--band .draft-pick__icon {
    content: normal;
  }

  /* --- Legend swatches ---------------------------------------------------
     The two swatches that stand for a MARK rather than a club — "Your Team's
     Picks" and the reserved champion pick — keep the plain card surface and
     drop the status TINT, so what the reader sees is the border.

     That is now the whole of the mark. A real pick wears its club's colour, so
     `--user-team`'s green tint and `--champion`'s orange one are painted over
     by the band and never appear in the grid; a legend still showing them
     taught a highlight the page does not use. The border does survive the
     band, so it is what the swatch demonstrates — and the labels say so.

     Declared after the status modifiers, like the band rules above, because
     these are all single-class selectors and source order is what decides. */
  .draft-pick--legend,
  .draft-pick--legend:hover {
    background: var(--draft-pick-bg, var(--content-bg-muted, #f3f4f6));
  }

  /* Dark mode: section-level round containers (and the reused Legend block)
     are flat --card-bg-color surfaces with only a shadow — they wash into the
     page background. Add the canonical hairline ring so each round/legend
     panel reads as a raised card, matching rosters.astro's .roster-table-card. */
  :global(html.dark) .draft-round {
    box-shadow:
      0 0 0 1px var(--content-border, #555555),
      var(--shadow-lg, var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1)));
  }

  /* Dark mode: the status-tinted pick cards were hardcoded light pastels
     (cream/pink/violet) — re-tint as whisper color-mixes against the card
     surface, borders stay their bright hues, champion text brightens. */
  :global(html.dark) .draft-pick--league-winner {
    background: color-mix(in srgb, #fbbf24 12%, var(--card-surface, #1e1e1e));
  }

  :global(html.dark) .draft-pick--league-winner:hover {
    background: color-mix(in srgb, #fbbf24 18%, var(--card-surface, #1e1e1e));
    box-shadow: 0 0 0 2px var(--card-bg, #1e1e1e), 0 0 0 4px #f59e0b, 0 4px 12px rgb(0 0 0 / 0.4);
  }

  :global(html.dark) .draft-pick--champion {
    background: color-mix(in srgb, #fb923c 12%, var(--card-surface, #1e1e1e));
    color: #fdba74;
  }

  :global(html.dark) .draft-pick--toilet-bowl {
    background: color-mix(in srgb, #ff6b6b 10%, var(--card-surface, #1e1e1e));
  }

  :global(html.dark) .draft-pick--toilet-bowl:hover {
    background: color-mix(in srgb, #ff6b6b 16%, var(--card-surface, #1e1e1e));
  }

  :global(html.dark) .draft-pick--tbd {
    background: color-mix(in srgb, #a78bfa 10%, var(--card-surface, #1e1e1e));
  }

  :global(html.dark) .draft-pick--tbd:hover {
    background: color-mix(in srgb, #a78bfa 16%, var(--card-surface, #1e1e1e));
  }

  .draft-pick__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    text-align: center;
  }

  .draft-pick__icon-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .draft-pick__icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
    color: #fb923c;
  }

  .draft-pick__icon--original {
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    border: 1px solid #fff;
    border-radius: 50%;
    object-fit: contain;
    background: var(--card-bg-color, #fff);
  }

  .draft-pick__name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gray-900, #111827);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
