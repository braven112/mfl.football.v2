---
/**
 * UdfaCompositeHero — the UDFA window hero: the best rookies still on the
 * board, four team-gradient panels side by side.
 *
 * Configuration of the shared CompositePanelBoard. The board watermarks the
 * NFL TEAM LOGO here because this hero is about NFL rookies (the tag showcase
 * watermarks the franchise crest instead — a tag is a fantasy-team story).
 *
 * `fill="pad"` because the board IS the board: a short board would misstate
 * how many rookies are actually available, so photoless panels backfill and
 * the team-logo watermark carries them. Ranks renumber after the swap.
 *
 * The router falls back to the legacy UDFAHero when fewer than two rookies
 * resolve.
 */
import type { HeroModel } from '../../utils/hero-casting';
import CompositePanelBoard from '../shared/CompositePanelBoard.astro';

interface Props {
  /** Best rookies on the board in rank order — pass up to 8: four show, the
      rest are spares that swap in when a headshot 404s. */
  models: HeroModel[];
  resolveLeaguePath: (path: string) => string;
}

const { models, resolveLeaguePath: r } = Astro.props;

const panels = models.map((model, index) => ({ model, badge: `No. ${index + 1}` }));
---

<CompositePanelBoard
  ariaLabel="Undrafted free agents — best rookies on the board"
  panels={panels}
  fill="pad"
  renumberBadges
  eyebrow="UDFA window · Best on the board"
  title="The draft is over. The bargains aren't."
  ctaLabel="Browse free agents"
  ctaHref={r('/theleague/players')}
/>
