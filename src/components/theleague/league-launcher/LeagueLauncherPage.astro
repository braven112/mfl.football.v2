---
/**
 * League Launcher — paste an MFL league id, review the pre-ticked feature
 * checkboxes (MFL settings → Claude's review → the league-type preset), change
 * anything, then Launch: the site dispatches a workflow that generates the
 * league on a `launch/<slug>` branch, and this page links the PR to staging.
 *
 * Catalog and presets are handed to the script as data, so re-picking the
 * league type re-presets the boxes in the browser exactly as the server would.
 * The route owns the gate (a component cannot redirect — CLAUDE.md).
 */
import { FEATURE_CATALOG, FEATURE_GROUPS } from '../../../config/league-feature-catalog.mjs';
import { ARCHETYPES, ARCHETYPE_KEYS } from '../../../config/league-archetypes.mjs';
import { ALL_LEAGUES } from '../../../config/leagues-data.mjs';
import { PACKAGE_ROUTES, isPackageLeague } from '../../../config/package-league-routes.mjs';

const catalog = FEATURE_CATALOG.map(({ key, label, description, group, requires }) => ({ key, label, description, group, requires }));
const archetypes = ARCHETYPE_KEYS.map((k) => ({ key: k, label: ARCHETYPES[k].label, features: ARCHETYPES[k].features }));
const groups = Object.entries(FEATURE_GROUPS).map(([id, label]) => ({
  id,
  label,
  features: catalog.filter((f) => f.group === id),
}));
/** Leagues whose pages follow their features — the only ones "Change features" can edit. */
const packageLeagues = ALL_LEAGUES.filter(isPackageLeague).map((l) => ({
  slug: l.slug,
  name: l.name,
  features: Object.fromEntries(catalog.map((f) => [f.key, Boolean((l.features as Record<string, boolean>)[f.key])])),
}));
/** Route → the feature that entitles it, so the page can say which pages a change adds or removes. */
const routes = PACKAGE_ROUTES;
---

<section class="launcher" data-league-launcher data-league="theleague">
  <script type="application/json" data-launcher-data set:html={JSON.stringify({ catalog, archetypes, packageLeagues, routes }).replace(/</g, '\\u003c')} />

  <header class="launcher__head">
    <h1>League Launcher</h1>
    <p>
      Enter an MFL league id. The boxes are pre-ticked from the league's MFL settings, then reviewed by Claude; change
      anything before you launch. Launching builds the league on its own branch, so nothing goes live until you merge
      the PR.
    </p>
  </header>

  <form class="launcher__find" data-launcher-find>
    <label>
      <span>MFL league id</span>
      <input name="mflId" inputmode="numeric" pattern="[0-9]{3,6}" required placeholder="12345" autocomplete="off" />
    </label>
    <button type="submit" class="cta cta--primary">Analyze</button>
  </form>
  <p class="launcher__status" data-launcher-status role="status" aria-live="polite"></p>

  <form class="launcher__review" data-launcher-review hidden>
    <fieldset class="launcher__card">
      <legend>League</legend>
      <label><span>Name</span><input name="name" required maxlength="80" /></label>
      <label><span>Short name <em>(optional)</em></span><input name="shortName" maxlength="80" /></label>
      <label>
        <span>Slug <em>(its path: mfl.football/&lt;slug&gt;)</em></span>
        <input name="slug" required pattern="[a-z][a-z0-9]{1,23}" maxlength="24" />
      </label>
      <p class="launcher__facts" data-launcher-facts></p>
    </fieldset>

    <fieldset class="launcher__card">
      <legend>League type</legend>
      <select name="archetype" data-launcher-archetype>
        {archetypes.map((a) => <option value={a.key}>{a.label}</option>)}
      </select>
      <p class="launcher__reason" data-launcher-archetype-reason></p>
      <p class="launcher__notes" data-launcher-notes hidden></p>
    </fieldset>

    {
      groups.map((g) => (
        <fieldset class="launcher__card">
          <legend>{g.label}</legend>
          {g.features.map((f) => (
            <label class="launcher__feature">
              <input type="checkbox" name={`f:${f.key}`} data-feature={f.key} />
              <span class="launcher__feature-text">
                <strong>{f.label}</strong>
                <span class="launcher__desc">{f.description}</span>
                <span class="launcher__why" data-why={f.key}></span>
              </span>
            </label>
          ))}
        </fieldset>
      ))
    }

    <div class="launcher__actions">
      <button type="submit" class="cta cta--primary" data-launcher-go>Launch</button>
      <p class="launcher__result" data-launcher-result role="status" aria-live="polite"></p>
    </div>
  </form>

  <section class="launcher__edit" aria-labelledby="launcher-edit-title">
    <h2 id="launcher-edit-title">Change a league's features</h2>
    <p>
      For Archie's and every league the Launcher built. Ticking or unticking a box adds or removes its pages,
      site-search entries and nav links, and its scheduled jobs follow. It opens a PR, so nothing changes until you
      merge it.
    </p>
    <form data-launcher-edit>
      <label>
        <span>League</span>
        <select name="league" data-edit-league>
          <option value="">Choose a league…</option>
          {packageLeagues.map((l) => <option value={l.slug}>{l.name}</option>)}
        </select>
      </label>
      <div data-edit-boxes hidden>
        {
          groups.map((g) => (
            <fieldset class="launcher__card">
              <legend>{g.label}</legend>
              {g.features.map((f) => (
                <label class="launcher__feature">
                  <input type="checkbox" data-edit-feature={f.key} />
                  <span class="launcher__feature-text">
                    <strong>{f.label}</strong>
                    <span class="launcher__desc">{f.description}</span>
                    <span class="launcher__why" data-edit-why={f.key}></span>
                  </span>
                </label>
              ))}
            </fieldset>
          ))
        }
        <p class="launcher__summary" data-edit-summary role="status" aria-live="polite"></p>
        <div class="launcher__actions">
          <button type="submit" class="cta cta--primary" data-edit-go disabled>Open PR with these features</button>
          <p class="launcher__result" data-edit-result role="status" aria-live="polite"></p>
        </div>
      </div>
    </form>
  </section>
</section>

<script>
  type Choice = { on: boolean; reason: string; source: string };
  type Draft = {
    mflId: string; name: string; shortName?: string; slug: string; mflHost: string | null;
    teamCount: number; divisionCount: number; duplicatePlayers: boolean;
    archetype: string; archetypeReason: string; features: Record<string, Choice>;
    notes?: string; reviewSkipped?: string;
  };
  type Data = {
    catalog: Array<{ key: string; label: string; requires: string[] }>;
    archetypes: Array<{ key: string; label: string; features: Record<string, boolean> }>;
    packageLeagues: Array<{ slug: string; name: string; features: Record<string, boolean> }>;
    routes: Record<string, string | null>;
  };

  /** Off-and-disabled for every box whose prerequisite is off; returns the keys it switched off. */
  function settleBoxes(data: Data, box: (key: string) => HTMLInputElement): string[] {
    const switched: string[] = [];
    for (const f of data.catalog) {
      const missing = f.requires.find((r) => !box(r).checked);
      const input = box(f.key);
      input.disabled = Boolean(missing);
      if (missing && input.checked) {
        input.checked = false;
        switched.push(f.key);
      }
    }
    return switched;
  }

  /** `pecking-order/[year]/[week].astro` → `/pecking-order/[year]/[week]` for display. */
  const routePath = (route: string) => `/${route.replace(/\.astro$/, '').replace(/\/?index$/, '')}`;

  /** Posts a spec, then shows the message and the PR link — or the errors. */
  async function submitSpec(url: string, spec: unknown, go: HTMLButtonElement, out: HTMLElement) {
    go.disabled = true;
    out.dataset.kind = 'muted';
    out.textContent = 'Starting…';
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ spec }),
      });
      const body = await res.json();
      if (!res.ok || !body.ok) {
        go.disabled = false;
        out.dataset.kind = 'bad';
        out.textContent = (body.errors ?? [`Failed (HTTP ${res.status}).`]).join(' ');
        return;
      }
      out.dataset.kind = 'ok';
      out.textContent = `${body.message} `;
      const a = document.createElement('a');
      a.href = body.prUrl;
      a.textContent = 'Open PR to staging';
      a.className = 'cta-link';
      a.target = '_blank';
      a.rel = 'noopener';
      out.append(a);
    } catch {
      go.disabled = false;
      out.dataset.kind = 'bad';
      out.textContent = 'Could not reach the server.';
    }
  }

  const SOURCE_LABEL: Record<string, string> = {
    'mfl-setting': 'MFL setting',
    ai: 'Claude',
    preset: 'League type',
    dependency: 'Needs another box',
    you: 'You',
  };

  function initLeagueLauncher() {
    // Gate on a node the router swaps, naming its league (CLAUDE.md).
    const root = document.querySelector<HTMLElement>('[data-league-launcher][data-league="theleague"]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const data = JSON.parse(root.querySelector('[data-launcher-data]')?.textContent || '{}') as Data;
    const find = root.querySelector<HTMLFormElement>('[data-launcher-find]')!;
    const review = root.querySelector<HTMLFormElement>('[data-launcher-review]')!;
    const status = root.querySelector<HTMLElement>('[data-launcher-status]')!;
    const result = root.querySelector<HTMLElement>('[data-launcher-result]')!;
    const archetypeSel = root.querySelector<HTMLSelectElement>('[data-launcher-archetype]')!;
    const box = (key: string) => review.querySelector<HTMLInputElement>(`[data-feature="${key}"]`)!;
    const why = (key: string) => review.querySelector<HTMLElement>(`[data-why="${key}"]`)!;
    let draft: Draft | null = null;
    const choices: Record<string, Choice> = {};

    const say = (el: HTMLElement, msg: string, kind = 'muted') => {
      el.textContent = msg;
      el.dataset.kind = kind;
    };

    /** Prerequisites gate their dependents: a box whose prerequisite is off is off and disabled. */
    function settle() {
      for (const key of settleBoxes(data, box)) {
        const missing = data.catalog.find((c) => c.key === key)!.requires.find((r) => !box(r).checked)!;
        const label = data.catalog.find((c) => c.key === missing)?.label ?? missing;
        choices[key] = { on: false, reason: `Needs ${label}, which is off.`, source: 'dependency' };
      }
      for (const f of data.catalog) {
        const c = choices[f.key];
        why(f.key).textContent = c ? `${SOURCE_LABEL[c.source] ?? c.source}: ${c.reason}` : '';
        why(f.key).dataset.source = c?.source ?? '';
      }
    }

    function paint(d: Draft) {
      (review.elements.namedItem('name') as HTMLInputElement).value = d.name;
      (review.elements.namedItem('shortName') as HTMLInputElement).value = d.shortName ?? '';
      (review.elements.namedItem('slug') as HTMLInputElement).value = d.slug;
      root!.querySelector('[data-launcher-facts]')!.textContent =
        `MFL ${d.mflId} · ${d.teamCount} teams · ${d.divisionCount} divisions · ${d.mflHost ?? 'MFL server unknown'}` +
        (d.duplicatePlayers ? ' · players owned once per division/conference' : '');
      archetypeSel.value = d.archetype;
      root!.querySelector('[data-launcher-archetype-reason]')!.textContent = d.archetypeReason;
      const notes = root!.querySelector<HTMLElement>('[data-launcher-notes]')!;
      notes.textContent = d.notes || d.reviewSkipped || '';
      notes.hidden = !notes.textContent;
      for (const f of data.catalog) {
        const c = d.features[f.key];
        choices[f.key] = c;
        box(f.key).checked = Boolean(c?.on);
      }
      settle();
      review.hidden = false;
    }

    find.addEventListener('submit', async (e) => {
      e.preventDefault();
      const mflId = (find.elements.namedItem('mflId') as HTMLInputElement).value.trim();
      say(status, 'Reading MFL settings and asking Claude to review… (up to a minute)');
      review.hidden = true;
      result.textContent = '';
      try {
        const res = await fetch('/api/admin/league-launcher/analyze', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mflId }),
        });
        const body = await res.json();
        if (!res.ok || !body.ok) return say(status, body.error ?? `Analyze failed (HTTP ${res.status}).`, 'bad');
        draft = body.draft as Draft;
        say(status, draft.reviewSkipped ? draft.reviewSkipped : 'Reviewed. Change anything, then launch.', draft.reviewSkipped ? 'warn' : 'ok');
        paint(draft);
      } catch {
        say(status, 'Could not reach the server.', 'bad');
      }
    });

    review.addEventListener('change', (e) => {
      const t = e.target as HTMLElement;
      if (t instanceof HTMLInputElement && t.dataset.feature) {
        choices[t.dataset.feature] = { on: t.checked, reason: t.checked ? 'Ticked by you.' : 'Unticked by you.', source: 'you' };
        settle();
      }
    });

    // Re-picking the league type re-presets every box MFL did not decide.
    archetypeSel.addEventListener('change', () => {
      const preset = data.archetypes.find((a) => a.key === archetypeSel.value);
      if (!preset) return;
      for (const f of data.catalog) {
        if (choices[f.key]?.source === 'mfl-setting') continue;
        box(f.key).checked = preset.features[f.key];
        choices[f.key] = { on: preset.features[f.key], reason: `${preset.label} default.`, source: 'preset' };
      }
      root!.querySelector('[data-launcher-archetype-reason]')!.textContent = 'Picked by you.';
      settle();
    });

    review.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!draft) return;
      const field = (n: string) => (review.elements.namedItem(n) as HTMLInputElement).value.trim();
      const features = Object.fromEntries(data.catalog.map((f) => [f.key, box(f.key).checked]));
      const spec = {
        mflId: draft.mflId,
        slug: field('slug'),
        name: field('name'),
        shortName: field('shortName') || undefined,
        mflHost: draft.mflHost,
        archetype: archetypeSel.value,
        duplicatePlayers: draft.duplicatePlayers,
        features,
      };
      await submitSpec('/api/admin/league-launcher/launch', spec, review.querySelector<HTMLButtonElement>('[data-launcher-go]')!, result);
    });

    // ── Change an existing league's features ─────────────────────────────
    const edit = root.querySelector<HTMLFormElement>('[data-launcher-edit]')!;
    const editLeague = edit.querySelector<HTMLSelectElement>('[data-edit-league]')!;
    const editBoxes = edit.querySelector<HTMLElement>('[data-edit-boxes]')!;
    const editGo = edit.querySelector<HTMLButtonElement>('[data-edit-go]')!;
    const editSummary = edit.querySelector<HTMLElement>('[data-edit-summary]')!;
    const editResult = edit.querySelector<HTMLElement>('[data-edit-result]')!;
    const editBox = (key: string) => edit.querySelector<HTMLInputElement>(`[data-edit-feature="${key}"]`)!;
    const current = () => data.packageLeagues.find((l) => l.slug === editLeague.value);

    /** Mark each changed box, list the pages that come and go, and enable the button only for a real change. */
    function paintEdit() {
      const league = current();
      if (!league) return;
      settleBoxes(data, editBox);
      const now = Object.fromEntries(data.catalog.map((f) => [f.key, editBox(f.key).checked]));
      for (const f of data.catalog) {
        const was = league.features[f.key];
        const why = edit.querySelector<HTMLElement>(`[data-edit-why="${f.key}"]`)!;
        why.textContent = now[f.key] === was ? '' : now[f.key] ? 'Turns on with this PR.' : 'Turns off with this PR.';
        why.dataset.source = now[f.key] === was ? '' : 'ai';
      }
      const pages = (features: Record<string, boolean>) =>
        new Set(Object.entries(data.routes).filter(([, f]) => f === null || features[f]).map(([r]) => routePath(r)));
      const before = pages(league.features);
      const after = pages(now);
      const added = [...after].filter((p) => !before.has(p));
      const removed = [...before].filter((p) => !after.has(p));
      const changed = data.catalog.some((f) => now[f.key] !== league.features[f.key]);
      editSummary.textContent = !changed
        ? 'No changes yet.'
        : [
            added.length ? `Adds ${added.join(', ')}.` : '',
            removed.length ? `Removes ${removed.join(', ')}.` : '',
            !added.length && !removed.length ? 'No pages change; its scheduled jobs follow the new boxes.' : '',
          ].filter(Boolean).join(' ');
      editGo.disabled = !changed;
    }

    editLeague.addEventListener('change', () => {
      const league = current();
      editBoxes.hidden = !league;
      editResult.textContent = '';
      if (!league) return;
      for (const f of data.catalog) editBox(f.key).checked = league.features[f.key];
      paintEdit();
    });
    edit.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).dataset.editFeature !== undefined) paintEdit();
    });
    edit.addEventListener('submit', async (e) => {
      e.preventDefault();
      const league = current();
      if (!league) return;
      const features = Object.fromEntries(data.catalog.map((f) => [f.key, editBox(f.key).checked]));
      await submitSpec('/api/admin/league-launcher/update', { slug: league.slug, features }, editGo, editResult);
    });
  }

  document.addEventListener('astro:page-load', initLeagueLauncher);
</script>

<style>
  .launcher {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    color: var(--page-text);
  }
  .launcher__head p,
  .launcher__desc,
  .launcher__reason,
  .launcher__facts {
    color: var(--content-text-muted);
  }
  .launcher__find {
    display: flex;
    gap: 0.75rem;
    align-items: end;
    flex-wrap: wrap;
    margin: 1rem 0 0.5rem;
  }
  .launcher label > span:not(.launcher__feature-text) {
    display: block;
    font-size: var(--font-size-sm);
    margin-bottom: 0.25rem;
  }
  .launcher input:not([type='checkbox']),
  .launcher select {
    width: 100%;
    max-width: 24rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--content-border);
    border-radius: 6px;
    background: var(--content-bg);
    color: var(--page-text);
  }
  .launcher__card {
    border: 1px solid var(--content-border);
    border-radius: 10px;
    background: var(--card-bg);
    padding: 0.75rem 1rem 1rem;
    margin: 1rem 0;
    display: grid;
    gap: 0.6rem;
  }
  .launcher__card legend {
    font-weight: 700;
    padding: 0 0.25rem;
  }
  .launcher__feature {
    display: flex;
    gap: 0.6rem;
    align-items: start;
  }
  .launcher__feature input {
    margin-top: 0.25rem;
    accent-color: var(--color-primary-fill, var(--color-primary));
  }
  .launcher__feature-text {
    display: grid;
    gap: 0.15rem;
  }
  .launcher__why:empty {
    display: none;
  }
  .launcher__desc,
  .launcher__why {
    font-size: var(--font-size-sm);
  }
  .launcher__why {
    color: var(--content-text-muted);
  }
  .launcher__why[data-source='ai'] {
    color: var(--color-primary);
  }
  .launcher__why[data-source='dependency'] {
    color: var(--color-error-dark);
  }
  .launcher__notes {
    background: var(--content-bg-muted);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: var(--font-size-sm);
  }
  .launcher__status[data-kind='bad'],
  .launcher__result[data-kind='bad'] {
    color: var(--color-error-dark);
  }
  .launcher__status[data-kind='ok'],
  .launcher__result[data-kind='ok'] {
    color: var(--color-success-dark);
  }
  .launcher__edit {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--content-border);
  }
  .launcher__edit > p,
  .launcher__summary {
    color: var(--content-text-muted);
  }
  .launcher__actions {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
</style>
