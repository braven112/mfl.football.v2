---
/**
 * AuctionCompositeHero — the free-agent auction hero, composite edition.
 *
 * The highest-ranked available free agent (dynasty ADP, top-5 daily rotation —
 * see hero-casting) models the auction window, with the amber money accent on
 * the countdown and the command-center essentials as a compact chip row.
 *
 * Configuration of the shared CompositeHero shell. Once bidding is LIVE the
 * ghost wordmark drops away — the word "AUCTION" stops being news the moment
 * the auction is the page — and the cast player's NFL crest carries the
 * watermark alone. That crest replaced the league-logo backdrop this state used
 * to show: both are centred marks, and his club says more about the player on
 * screen than our own logo does.
 *
 * The router falls back to the legacy AuctionHero when no model resolves.
 */
import type { HeroModel } from '../../utils/hero-casting';
import { getNflTeamColors } from '../../utils/nfl-team-colors';
import { normalizeTeamCode } from '../../utils/nfl-logo';
import { getNthDayOfMonth } from '../../utils/league-event-resolver';
import { formatCompactNumber } from '../../utils/formatters';
import { DEFAULT_LEAGUE } from '../../config/leagues';
import { resolveHeroCrest } from '../../utils/hero-crest';
import CompositeHero from '../shared/CompositeHero.astro';

interface Props {
  leagueYear: number;
  live: boolean;
  model: HeroModel;
  /** Live only: the soonest-closing auction the model represents */
  closingBid?: { bid: number; franchiseName: string; endsAtMs: number } | null;
  resolveLeaguePath: (path: string) => string;
  referenceDate?: Date;
  mflHost?: string;
  leagueId?: string;
}

const {
  leagueYear,
  live,
  model,
  closingBid = null,
  resolveLeaguePath: r,
  referenceDate,
  mflHost = DEFAULT_LEAGUE.mflHost,
  leagueId = DEFAULT_LEAGUE.id,
} = Astro.props;

const now = referenceDate ?? new Date();
const mflBase = `https://${mflHost}/${leagueYear}/options?L=${leagueId}`;

const auctionStartDate = getNthDayOfMonth(leagueYear, 2, 4, 3); // 3rd Thursday of March
const startOfDay = (d: Date) => { const o = new Date(d); o.setHours(0, 0, 0, 0); return o; };
const daysUntil = Math.max(0, Math.ceil((startOfDay(auctionStartDate).getTime() - startOfDay(now).getTime()) / 86_400_000));

const summary = live
  ? closingBid
    ? `The auction is under way — and the clock is running out on the next winner. ${closingBid.franchiseName} lead the bidding.`
    : 'The auction is under way — place bids, track results, and build your roster.'
  : 'Auction season is almost here — $425K minimum bid, $25K increments, 36 hours without a new bid wins.';

// Hours left on the featured bid's 36h clock (only when it's still running).
const bidHoursLeft = closingBid
  ? Math.max(0, Math.floor((closingBid.endsAtMs - now.getTime()) / 3_600_000))
  : null;

const teamCode = normalizeTeamCode(model.nflTeam);

// An auction player is by definition unrostered, so no franchise owns this
// story and the mark is his NFL team's. It replaces the league-logo backdrop
// the live state used to carry: both are centred watermarks, and his club says
// more about the player on screen than our own logo does.
const crest = resolveHeroCrest({ league: 'theleague', nflTeam: model.nflTeam });

const chips = [
  { label: 'Auction summary', href: `${mflBase}&O=44`, external: true },
  { label: 'Completed auctions', href: `${mflBase}&O=43`, external: true },
  { label: 'Free agents', href: r('/theleague/players'), external: false },
  { label: 'Auction rules', href: r('/theleague/rules#free-agent-bidding'), external: false },
];
---

<CompositeHero
  ariaLabel="Free agent auction command center"
  accent="auction"
  wordmark={live ? undefined : 'AUCTION'}
  crest={crest}
  model={model}
  captionMeta={`${model.descriptor} ${model.position} · ${teamCode}`}
  glowColor={getNflTeamColors(teamCode).primary}
  logoArt={live ? undefined : '/assets/logos/theleague-logo-dark.svg'}
  pill={live ? 'Auction live' : 'Auction opens soon'}
  title="Free agent"
  titleAccent="auction."
  summary={summary}
  styleVars="--cmh-min-h: clamp(250px, 25vw, 300px); --cmh-min-h-mobile: 270px; --cmh-ghost-size: clamp(4rem, 9vw, 7rem); --cmh-ghost-style: italic; --cmh-model-w: clamp(230px, 30vw, 350px); --cmh-logo-w: clamp(170px, 22vw, 250px); --cmh-logo-opacity: 0.2; --cmh-logo-w-mobile: clamp(170px, 22vw, 250px); --cmh-logo-right-mobile: clamp(1rem, 4vw, 3rem); --cmh-eyebrow-mb: 0.625rem; --cmh-content-max: min(32rem, 62%); --cmh-title-mb: 0.45rem; --cmh-summary-max: 46ch; --cmh-model-w-mobile: 175px; --cmh-footer-mb: 0.875rem; --cmh-divider: var(--cmh-chip-border);"
>
  {closingBid && (
    <span slot="caption" class="ach__caption-bid">
      ${formatCompactNumber(closingBid.bid)} high bid{bidHoursLeft !== null && bidHoursLeft > 0 ? ` · ~${bidHoursLeft}h left` : ''}
    </span>
  )}

  <div class="cmh__footer">
    <div class="cmh__count" role="group" aria-label={live ? 'Bidding now' : `${daysUntil} days to auction, 7AM Pacific`}>
      <span class="cmh__count-num" aria-hidden="true">{live ? 'LIVE' : daysUntil}</span>
      <span class="cmh__count-label" aria-hidden="true">{live ? 'Bidding now' : 'Days to auction · 7AM PT'}</span>
    </div>
    <span class="cmh__divider" aria-hidden="true"></span>
    <a class="cmh__cta" href={`${mflBase}&O=43`} target="_blank" rel="noopener noreferrer">
      Place auction bid
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <nav class="cmh__chips cmh__chips--block" aria-label="Auction quick links">
    {chips.map((chip) => (
      <a
        href={chip.href}
        class="cmh__chip"
        target={chip.external ? '_blank' : undefined}
        rel={chip.external ? 'noopener noreferrer' : undefined}
        aria-label={chip.external ? `${chip.label} (opens in new tab)` : undefined}
      >
        {chip.label}{chip.external && <span aria-hidden="true"> ↗</span>}
      </a>
    ))}
  </nav>
</CompositeHero>

<style>
  /* Auction-only extras: the high-bid line inside the frosted caption, and the
     quick-link row's spacing under the footer. Everything else is the shell. */
  .ach__caption-bid {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #fcd34d;
    font-variant-numeric: tabular-nums;
  }
</style>
