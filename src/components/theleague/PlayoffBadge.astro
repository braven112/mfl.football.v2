---
export interface Props {
  status: 'division_winner' | 'wild_card' | null;
  seed?: number;
}

const { status, seed } = Astro.props;

/**
 * The seed carries the badge; the word is the fallback, not the default.
 *
 * `DIV #1` said the same thing twice — gold vs silver already separates the two
 * ladders — and the pair cost ~45px inside a fixed 100px column on EVERY row,
 * badge or not. In the banded division table that is paid for out of the team
 * name, because the band made every numeric column shrink-to-fit and left
 * `.col-team` as the only `width: auto` column left to squeeze.
 *
 * Colour alone would be an accessibility failure, so the word moves to the
 * accessible name rather than vanishing: a `title` for a pointer and a
 * visually-hidden span for a screen reader (an `aria-label` on a plain `div`
 * has no role to attach to and is not reliably announced).
 *
 * Where MFL gives no seed there is nothing to print, so the word comes back as
 * the visible text — an unlabelled coloured square says nothing at all.
 */
const LABELS = {
  division_winner: { short: 'DIV', full: 'Division winner', className: 'badge-division-winner' },
  wild_card: { short: 'WC', full: 'Wild card', className: 'badge-wild-card' },
} as const;

const meta = status ? LABELS[status] : null;
---

{meta && (
  <div class:list={['badge', meta.className]} title={meta.full}>
    <span class="badge-seed" aria-hidden="true">{seed ? `#${seed}` : meta.short}</span>
    <span class="badge-sr">{seed ? `${meta.full}, seed ${seed}` : meta.full}</span>
  </div>
)}

<style>
  .badge {
    position: relative; /* the absolutely-positioned .badge-sr anchors here */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  .badge-division-winner {
    background-color: #ffd700;
    color: #1a1a1a;
    box-shadow: 0 2px 4px rgba(255, 215, 0, 0.3);
  }

  .badge-wild-card {
    background-color: #c0c0c0;
    color: #1a1a1a;
    box-shadow: 0 2px 4px rgba(192, 192, 192, 0.3);
  }

  /* Local rather than the global `.visually-hidden`, so the badge carries its
   * own accessible name into any page regardless of which stylesheets that
   * page happens to load. */
  .badge-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
