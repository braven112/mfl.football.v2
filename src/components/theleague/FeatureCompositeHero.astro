---
/**
 * FeatureCompositeHero — the fresh What's New hero, composite edition.
 *
 * The art IS the feature: the entry's screenshot in a browser frame over the
 * league-blue gradient with the ghost WHAT'S NEW wordmark. A player models the
 * announcement ONLY when the entry names one (`heroPlayerId` → cast via
 * castFeaturedModel) — players show up when they're being talked about, never
 * as stand-ins (see docs/claude/insights/features/player-composites.md).
 *
 * Art precedence: heroArt (entry-supplied artwork, e.g. a recovered vintage
 * logo) → cast model → screenshot (light/dark pair, swapped by html.dark;
 * hidden on mobile where the frame would be an unreadable thumbnail — the
 * logo silhouette stands in) → league logo silhouette.
 *
 * Configuration of the shared CompositeHero shell. The two art treatments the
 * shell does NOT own — entry artwork and the browser frame — ride its `art`
 * slot and keep their CSS local under the `fch__` prefix, because the frame
 * (chrome bar, theme-paired captures, the eager-promotion script) is this
 * hero's alone. Everything else is the shell.
 */
import type { HeroContent } from '../../types/whats-new';
import type { HeroModel } from '../../utils/hero-casting';
import { getNflTeamColors } from '../../utils/nfl-team-colors';
import { normalizeTeamCode } from '../../utils/nfl-logo';
import { LEAGUES } from '../../config/leagues';
import { resolveHeroCrest } from '../../utils/hero-crest';
import CompositeHero from '../shared/CompositeHero.astro';
import '../../styles/whats-new-hero-shot.css';

interface Props {
  content: HeroContent;
  /** Cast player, or null for player-less entries (bug-fix rollups) — the
      league logo silhouette stands in where the player would be. */
  model?: HeroModel | null;
  resolveLeaguePath: (path: string) => string;
}

const { content, model = null, resolveLeaguePath } = Astro.props;

const teamCode = model ? normalizeTeamCode(model.nflTeam) : '';
const ctaHref = content.link ? resolveLeaguePath(content.link) : resolveLeaguePath('/theleague/whats-new');

// The hero follows the site theme, but an entry can force the dark treatment
// in light mode when the dark card IS the story (e.g. the dark mode launch).
const forceDark = content.heroTheme === 'dark';

// Feature screenshot (browser-framed). The dark capture lives next to the
// light one under the `-dark` suffix convention (capture-whats-new-
// screenshots.mjs writes both); when the dark file 404s the frame falls
// back to the light capture via the img onerror hook.
const screenshot = content.image ? `/assets/whats-new/${content.image}` : null;
const screenshotDark = screenshot ? screenshot.replace(/\.(\w+)$/, '-dark.$1') : null;
// Frame chrome URL text from the league registry — never hardcode domains.
const league = LEAGUES.theleague;
const frameUrl = content.link
  ? `${league.domains[0]}${content.link.replace(`/${league.slug}`, '')}`
  : league.domains[0];

const LOGO = '/assets/logos/theleague-logo-dark.svg';
// Only a model-backed entry gets a crest. A screenshot entry's art IS the
// browser frame, and a bug-fix rollup has no subject at all — a watermark
// behind either would be decoration, which is the one thing the casting rule
// forbids. No franchise: a feature announcement is nobody's team story.
const crest = model ? resolveHeroCrest({ league: 'theleague', nflTeam: model.nflTeam }) : null;
// Art precedence, decided once: the shell renders the model layer itself, and
// takes the `art` slot for the two treatments it does not own.
const artMode = content.heroArt ? 'entry' : model ? 'model' : screenshot ? 'shot' : 'logo';
const GEOMETRY =
  '--cmh-min-h: clamp(230px, 23vw, 280px); --cmh-min-h-mobile: 250px; --cmh-ghost-left: 40%; ' +
  '--cmh-model-w: clamp(250px, 33vw, 390px); --cmh-logo-w: clamp(180px, 24vw, 280px); ' +
  '--cmh-logo-opacity: 0.18; --cmh-title-max: 22ch;';
---

<CompositeHero
  tag="article"
  class="fch"
  ariaLabel={`What's new: ${content.title}`}
  accent="feature"
  forceDark={forceDark}
  crop
  clampSummary
  titleTag="h3"
  wordmark={"WHAT'S NEW"}
  artSlot={artMode === 'entry' || artMode === 'shot'}
  crest={artMode === 'model' ? crest : null}
  model={artMode === 'model' ? model : null}
  glowColor={getNflTeamColors(teamCode).primary}
  logoArt={artMode === 'logo' ? LOGO : undefined}
  pill={content.kicker ?? 'New this week'}
  pillDate={content.kickerDate}
  title={content.title}
  summary={content.summary}
  ctaLabel={content.linkLabel ?? 'Check it out'}
  ctaHref={ctaHref}
  styleVars={GEOMETRY}
>
  {artMode === 'entry' && content.heroArt && (
    <Fragment slot="art">
      <img
        class="cmh__art"
        src={content.heroArt.src}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        onerror="this.style.display='none'; var s=this.nextElementSibling; if (s) { if (s.classList.contains('cmh__caption')) s.style.display='none'; }"
      />
      {content.heroArt.caption && (
        <span class="cmh__caption">
          <strong>{content.heroArt.caption}</strong>
          {content.heroArt.captionMeta && <span class="cmh__caption-meta">{content.heroArt.captionMeta}</span>}
        </span>
      )}
    </Fragment>
  )}

  {artMode === 'shot' && (
    <Fragment slot="art">
      <div class="fch__shot" aria-hidden="true">
        <div class="fch__shot-bar">
          <span class="fch__shot-dot fch__shot-dot--red"></span>
          <span class="fch__shot-dot fch__shot-dot--yellow"></span>
          <span class="fch__shot-dot fch__shot-dot--green"></span>
          <span class="fch__shot-url">{frameUrl}</span>
        </div>
        {/* Both halves ship lazy; the inline script below promotes ONLY the
            active theme's variant to eager (SSR can never know the resolved
            theme — the pre-paint html.dark class can). Net: one download,
            no lazy-load delay on the hero, and mobile (frame display:none)
            fetches neither. The hidden half never fires onerror, which is
            fine — its fallback class only matters once it's the shown one,
            and a theme flip makes it visible → lazy fetch → onerror then. */}
        <img
          class="fch__shot-img fch__shot-img--light"
          src={screenshot}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.closest('.fch').classList.add('fch--no-shot')"
        />
        <img
          class="fch__shot-img fch__shot-img--dark"
          src={screenshotDark}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.closest('.fch__shot').classList.add('fch__shot--no-dark')"
        />
        <script is:inline>
          (function () {
            var s = document.currentScript;
            // Mobile hides the whole frame — leave both halves lazy so
            // neither downloads (eager fetches even inside display:none).
            if (getComputedStyle(s.parentElement).display === 'none') return;
            // Forced-dark heroes show the dark capture even in light site
            // theme — promote the variant the CSS actually displays, not
            // just the html.dark one.
            var fch = s.closest('.fch');
            var dark =
              document.documentElement.classList.contains('dark') ||
              (fch && fch.classList.contains('cmh--force-dark'));
            var img = s.parentElement.querySelector(
              dark ? '.fch__shot-img--dark' : '.fch__shot-img--light',
            );
            if (img) img.loading = 'eager';
          })();
        </script>
      </div>
      {/* Mobile (and light-capture 404) stand-in — the frame is hidden there */}
      <img class="fch__shot-logo" src={LOGO} alt="" aria-hidden="true" loading="lazy" />
    </Fragment>
  )}
</CompositeHero>
