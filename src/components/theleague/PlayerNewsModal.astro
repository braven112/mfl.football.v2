---
/**
 * PlayerNewsModal — a news-only player modal.
 *
 * Header is a composite mini hero (player-modal-band): team-color gradient +
 * ghost wordmark + ESPN cutout when one exists (gradient-only for DEF /
 * MFL-JPG-only players).
 *
 * This is a THIN SHELL over the shared news layer — the list markup, styles and
 * fetching all live in player-news.css / player-news-client.ts, shared with
 * PlayerDetailsModal so the two surfaces cannot drift. Before that refactor this
 * component had no importer, fetched nothing (the caller had to pass an array of
 * TEAM headlines), faked a 400ms spinner over local data, and painted a
 * hardcoded light palette that rendered white-on-white in dark mode.
 */
import '../../styles/player-modal-band.css';
import '../../styles/player-news.css';

export interface Props {
  /** Additional CSS classes */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['player-news-modal', className]}>
  <div class="player-news-modal__overlay"></div>
  <div class="player-news-modal__content" role="dialog" aria-modal="true" aria-labelledby="player-news-title">
    <div class="player-news-modal__header pmb" id="pnm-band">
      <span class="pmb__ghost" aria-hidden="true"></span>
      <div class="pmb__glow" aria-hidden="true"></div>
      <img class="pmb__crest" alt="" aria-hidden="true" loading="lazy" decoding="async" style="display:none" />
      <img class="pmb__cutout" alt="" aria-hidden="true" loading="eager" decoding="async" />
      <div class="header-info">
        <h3 id="player-news-title">Latest News</h3>
        <p class="player-news-subtitle" id="news-player-info">—</p>
      </div>
      <button class="player-news-modal__close" type="button" aria-label="Close" title="Close (ESC)">
        ×
      </button>
    </div>

    <div class="player-news-modal__body">
      <p class="pn-subtitle" id="pnm-news-subtitle" style="display: none;"></p>
      <div class="pn-status" id="pnm-news-status"></div>
      <div class="pn-list" id="pnm-news-list" style="display: none;"></div>
      <p class="visually-hidden" role="status" aria-live="polite" id="pnm-news-live"></p>
    </div>

    <div class="player-news-modal__footer">
      <p class="news-source">Source: ESPN</p>
    </div>
  </div>
</div>

<style>
  .player-news-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1100;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .player-news-modal.active {
    display: flex;
  }

  /* Frosted-glass scrim is mandated for every modal backdrop on this site —
     a plain dark overlay without blur is off-standard. */
  .player-news-modal__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  :global(html.dark) .player-news-modal__overlay {
    background: rgba(0, 0, 0, 0.6);
  }

  .player-news-modal__content {
    position: relative;
    /* --card-bg resolves to white in light and to the dark card gradient in
       dark. Shorthand only — it is a gradient, never a color. */
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    width: 100%;
    max-width: 550px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: modal-appear 0.3s ease-out;
  }

  :global(html.dark) .player-news-modal__content {
    box-shadow:
      var(--shadow-xl),
      0 0 0 1px var(--content-border);
  }

  @keyframes modal-appear {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .player-news-modal__content { animation: none; }
  }

  /* Composite band header — .pmb paints gradient/ghost/glow/cutout
     (src/styles/player-modal-band.css); this block only lays out the text */
  .player-news-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    min-height: 92px;
    padding: 1.25rem 1.25rem 1.1rem 1.5rem;
    flex-shrink: 0;
  }

  .header-info {
    position: relative;
    z-index: 2;
    min-width: 0;
    /* Keep text clear of the cutout on the right */
    padding-right: clamp(64px, 24%, 110px);
  }

  .player-news-modal__header.pmb--no-cutout .header-info {
    padding-right: 2.25rem;
  }

  .header-info h3 {
    /* Explicit white — sits on the team-color gradient, not on the card */
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .player-news-subtitle {
    margin: 0.25rem 0 0 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 500;
  }

  .player-news-modal__close {
    position: relative;
    z-index: 3;
    background: rgba(6, 9, 13, 0.4);
    backdrop-filter: blur(2px);
    border: none;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .player-news-modal__close:hover {
    background: rgba(6, 9, 13, 0.65);
    color: #fff;
    transform: rotate(90deg);
  }

  .player-news-modal__body {
    overflow-y: auto;
    flex: 1;
    padding: 1rem 1.25rem;
  }

  .player-news-modal__footer {
    padding: 1rem 1.5rem;
    background: var(--content-bg-muted);
    border-top: 1px solid var(--content-border);
    flex-shrink: 0;
  }

  .news-source {
    margin: 0;
    font-size: 0.75rem;
    color: var(--content-text-muted);
    text-align: right;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .player-news-modal__content {
      max-height: 90vh;
    }
  }
</style>

<script>
  import { applyPlayerModalBand } from '../../utils/player-modal-band';
  import {
    loadPlayerNews,
    cancelPlayerNews,
    renderPlayerNewsList,
    renderPlayerNewsSkeleton,
    resolveNewsSubject,
    playerNewsEmptyMessage,
    type PlayerNewsState,
  } from '../../utils/player-news-client';

  /** Document-level listeners bind once — init re-runs on every page swap. */
  let documentListenersBound = false;

  /**
   * Where focus was before the dialog opened. `aria-modal="true"` tells AT to
   * expose only the dialog subtree, so leaving focus on the trigger behind the
   * scrim would strand the user in content the AT has been told to hide.
   */
  let lastFocused: HTMLElement | null = null;

  function initPlayerNewsModal() {
    const modal = document.querySelector('.player-news-modal');

    // Guard the DOUBLE INIT, not the individual bindings.
    //
    // This script registers init at module eval AND on astro:page-load, and
    // ClientRouter fires that on the first load too — so on initial load init
    // runs twice against the SAME DOM and every element listener is bound
    // twice. After a navigation the node is swapped, so the flag is absent on
    // the fresh node and re-wiring happens normally.
    //
    // Deliberately NOT the dataset-guarded bind-once pattern: init creates
    // per-run closure state, and freezing listeners on run 1 while the rebuilt
    // content reads run 2 is the documented stale-closure state split
    // (insights/domains/frontend.md, 2026-07-21). Returning early means the
    // second run never creates a divergent copy at all.
    if (modal instanceof HTMLElement) {
      if (modal.dataset.pnmWired === '1') return;
      modal.dataset.pnmWired = '1';
    }
    const overlay = document.querySelector('.player-news-modal__overlay');
    const closeBtn = document.querySelector('.player-news-modal__close');
    const subtitleEl = document.getElementById('pnm-news-subtitle');
    const statusEl = document.getElementById('pnm-news-status');
    const listEl = document.getElementById('pnm-news-list');
    const liveEl = document.getElementById('pnm-news-live');
    const playerInfo = document.getElementById('news-player-info');

    // Re-queries rather than using the `modal` captured at init: the
    // document-level Escape listener is bound ONCE while this init re-runs on
    // every astro:page-load, so a captured node goes stale after a View
    // Transition swap and Escape would silently close nothing.
    const closeModal = () => {
      document.querySelector('.player-news-modal')?.classList.remove('active');
      cancelPlayerNews();
      lastFocused?.focus();
      lastFocused = null;
    };

    closeBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', closeModal);

    if (!documentListenersBound) {
      documentListenersBound = true;
      document.addEventListener('keydown', (e) => {
        const active = document.querySelector('.player-news-modal');
        if (e.key === 'Escape' && active?.classList.contains('active')) {
          // Route through the same close path as the button and the overlay.
          // Removing `.active` directly skipped the focus restore, so Escape
          // dropped focus to <body> behind the scrim — and left `lastFocused`
          // stale, which then misdirected the NEXT close.
          closeModal();
        }
      });
    }

    const announce = (message: string) => {
      if (!liveEl) return;
      requestAnimationFrame(() => { liveEl.textContent = message; });
    };

    let subjectName = '';
    let lastSubject: { mflId?: string | null; espnId?: string | null } | null = null;

    const render = (state: PlayerNewsState) => {
      if (!statusEl || !listEl) return;
      const hadFocus = statusEl.contains(document.activeElement);

      if (state.kind === 'loading') {
        statusEl.className = 'pn-status';
        statusEl.style.display = '';
        listEl.style.display = 'none';
        renderPlayerNewsSkeleton(statusEl);
        announce('Loading news\u2026');
        if (hadFocus) { statusEl.tabIndex = -1; statusEl.focus(); }
        return;
      }

      if (state.kind === 'ok') {
        statusEl.style.display = 'none';
        listEl.style.display = '';
        renderPlayerNewsList(listEl, state.items);
        const noun = state.items.length === 1 ? 'story' : 'stories';
        announce(`${state.items.length} recent ${noun} loaded${subjectName ? ` for ${subjectName}` : ''}.`);
        if (hadFocus) { listEl.tabIndex = -1; listEl.focus(); }
        return;
      }

      listEl.style.display = 'none';
      statusEl.style.display = '';
      statusEl.className = 'pn-status pn-status--message';

      if (state.kind === 'empty') {
        // Collapsed: `--empty` drops the skeleton's height reservation so the
        // section shrinks to the one-line note instead of leaving a tall blank
        // box under a heading that has nothing to show.
        statusEl.className = 'pn-status pn-status--message pn-status--empty';
        const message = playerNewsEmptyMessage(state.windowDays, subjectName);
        statusEl.textContent = message;
        announce(message);
        if (hadFocus) { statusEl.tabIndex = -1; statusEl.focus(); }
        return;
      }

      // error — kept distinct from empty, and retryable.
      statusEl.textContent = "Couldn't reach ESPN. ";
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'pn-retry';
      retry.textContent = 'Retry';
      retry.addEventListener('click', () => {
        if (lastSubject) loadPlayerNews(lastSubject, render);
      });
      statusEl.appendChild(retry);
      announce('Could not load news.');
      if (hadFocus) retry.focus();
    };

    window.openPlayerNewsModal = function(playerData) {
      if (!modal) return;

      if (playerInfo) {
        playerInfo.textContent = [playerData?.name, playerData?.position, playerData?.nflTeam]
          .filter(Boolean)
          .join(' • ');
      }

      // Composite band: team gradient + ghost wordmark + ESPN cutout
      applyPlayerModalBand(document.getElementById('pnm-band'), playerData);

      lastFocused = document.activeElement as HTMLElement | null;
      modal.classList.add('active');

      // Move focus INTO the dialog — required by aria-modal, which is on the
      // content element.
      const content = modal.querySelector('.player-news-modal__content') as HTMLElement | null;
      if (content) {
        content.tabIndex = -1;
        content.focus();
      }

      // Shared with PlayerDetailsModal so the two cannot drift: handles the
      // team-DEF stand-in, and returns null when there is nothing to ask about
      // — which must NOT be reported as "no recent stories", because we never
      // asked.
      const resolved = resolveNewsSubject(playerData || {});
      subjectName = resolved?.subjectName ?? '';

      if (subtitleEl) {
        subtitleEl.textContent = resolved?.label ?? '';
        subtitleEl.style.display = resolved?.label ? '' : 'none';
      }

      if (liveEl) liveEl.textContent = '';

      if (!resolved) {
        if (statusEl) {
          statusEl.className = 'pn-status pn-status--message';
          statusEl.style.display = '';
          statusEl.textContent = 'No ESPN news feed for this player.';
        }
        if (listEl) listEl.style.display = 'none';
        cancelPlayerNews();
        return;
      }

      lastSubject = resolved.subject;
      loadPlayerNews(resolved.subject, render);
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPlayerNewsModal);
  } else {
    initPlayerNewsModal();
  }

  document.addEventListener('astro:page-load', initPlayerNewsModal);
</script>
