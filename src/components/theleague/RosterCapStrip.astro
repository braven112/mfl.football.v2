---
/**
 * The Rosters cap card — TheLeague, phone only (docs/plans/rosters-mobile-layout.md § 6).
 *
 * Sits under the roster header: this year's cap space, a cap bar split by
 * what the cap is spent on, and four chips (Sims · Trade · Dead $ · Tags).
 * The bar and the Sims chip open the Cap by year sheet (`RosterSimTray`).
 *
 * Its own component rather than a slot in the shared `RosterHeader`, which the
 * AFL renders too and which has no cap. Every number here is painted by
 * `renderSimSurfaces` (src/utils/rosters/sim-summary.ts) from `updateView`'s
 * own pass; the server renders the frame and the season's cap space so the
 * card is not blank before hydration.
 *
 * Hidden at 768px and up by `src/styles/rosters-mobile.css`; the desktop page
 * already shows every one of these numbers.
 */
interface Props {
  /** The first salary year, e.g. "2026". */
  year: string | number;
  /** Server-rendered cap space for the default team (replaced after hydration). */
  capSpace: string;
  /** Trade Builder, league-resolved by the route. `?b=<team>` is added client-side. */
  tradeHref: string;
  /** League Planner (the franchise-tag options), league-resolved by the route. */
  plannerHref: string;
}

const { year, capSpace, tradeHref, plannerHref } = Astro.props;
---

<section class="rcap" data-rcap aria-labelledby="rcapTitle">
  <div class="rcap__head">
    <h2 class="rcap__title" id="rcapTitle"><span data-rcap-year>{year}</span> cap space</h2>
    <strong class="rcap__space" data-rcap-space>{capSpace}</strong>
  </div>
  <button type="button" class="rcap__bar" data-rcap-bar data-rsim-open aria-label={`${year} cap. Open cap by year`}>
    <span class="rcap__seg rcap__seg--active" data-rcap-seg="active"></span>
    <span class="rcap__seg rcap__seg--practice" data-rcap-seg="practice"></span>
    <span class="rcap__seg rcap__seg--injured" data-rcap-seg="injured"></span>
    <span class="rcap__seg rcap__seg--dead" data-rcap-seg="dead"></span>
    <span class="rcap__seg rcap__seg--sim" data-rcap-seg="sim"></span>
    <span class="rcap__seg rcap__seg--space" data-rcap-seg="space"></span>
  </button>
  <ul class="rcap__key" aria-hidden="true">
    <li><span class="rcap__dot rcap__dot--active"></span>Active</li>
    <li><span class="rcap__dot rcap__dot--practice"></span>Practice</li>
    <li><span class="rcap__dot rcap__dot--injured"></span>IR</li>
    <li><span class="rcap__dot rcap__dot--dead"></span>Dead</li>
    <li><span class="rcap__dot rcap__dot--sim"></span>Sims</li>
  </ul>
  <div class="rcap__chips">
    <button type="button" class="rcap__chip" data-rsim-open>
      Sims <span class="rcap__count" data-rcap-sims>0</span>
    </button>
    <a class="rcap__chip" data-rcap-trade href={tradeHref}>Trade</a>
    <a class="rcap__chip" href="#rosterDeadMoney">Dead $</a>
    <a class="rcap__chip" data-rcap-tags-link href={plannerHref}>Tags</a>
    <button type="button" class="rcap__chip rcap__chip--accent" data-rcap-tags-review data-rsim-open hidden>
      Tags · Submit
    </button>
  </div>
</section>
