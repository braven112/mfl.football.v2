---
/**
 * ArticleHero — the homepage card that promotes TheLeague's latest Schefter
 * article (waiver report Wed→Thu, weekend preview Fri, generic otherwise).
 *
 * It renders the SAME component as every other composite on both homepages —
 * `LeagueCompositeHero` — from the SAME builder the AFL's news card uses
 * (`articleHeroView`). Before this it had two bespoke layouts of its own: a
 * composite for posts naming a `heroPlayerId`, and a plain bordered card for
 * everything else. Most Schefter articles name nobody, so the fallback WAS the
 * hero in practice, and the waiver report shipped to the homepage as an
 * unstyled white box beside seven branded cards.
 *
 * Two things follow from routing through the shared card:
 *
 *  - **A post with no cast player is no longer a different design.** The league
 *    mark takes the flank (`CompositeHero`'s logo layer), exactly as it does
 *    for a waiver card with no castable free agent.
 *  - **The CTA is the ARTICLE's link.** It always was here; it is stated
 *    because the AFL's copy of this card pointed at the news listing instead,
 *    and the shared builder is now the one place that decides.
 *
 * Still falls back to ArticleHeroStub when the feed carries no article at all —
 * a card with no story is not a story.
 */
import type { HeroState } from '../../../types/hero-state';
import type { SchefterFeed } from '../../../types/schefter';
import { getAuthor, getAuthorAvatar } from '../../../types/schefter';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { getPlayerMap } from '../../../utils/player-map';
import { castArticleModel } from '../../../utils/hero-casting';
import { articleDateLabel, articleHeroView, pickLatestArticle } from '../../../utils/article-hero-view';
import type { EventHeroView } from '../../../utils/afl-hero-resolver';
import LeagueCompositeHero from '../../shared/LeagueCompositeHero.astro';
import ArticleHeroStub from '../hero-stubs/ArticleHeroStub.astro';
import feedData from '../../../data/theleague/schefter-feed.json';

export interface Props {
  state: HeroState;
  articleType?: 'waiver-pickup' | 'weekend-preview' | 'generic';
}

const { state, articleType = 'generic' } = Astro.props;

const feed = feedData as SchefterFeed;

/**
 * Which article this slot would rather have. A miss falls through to the
 * newest — the slot is already on the page, and last week's story beats an
 * empty card.
 */
const PREFERRED: Record<string, RegExp | undefined> = {
  'waiver-pickup': /waiver|pickup|claim/i,
  'weekend-preview': /preview|weekend|storyline|watch/i,
  generic: undefined,
};

const KICKERS: Record<string, string> = {
  'waiver-pickup': 'Waiver Report',
  'weekend-preview': 'Weekend Preview',
  generic: 'Schefter Report',
};

/** Caption qualifier explaining why this player fronts the story. */
const DESCRIPTORS: Record<string, string> = {
  'waiver-pickup': 'Top Pickup',
  'weekend-preview': 'One to Watch',
  generic: 'In the Spotlight',
};

const referenceDate = state.metadata.referenceDate;
const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;

const article = pickLatestArticle(feed.posts, {
  prefer: PREFERRED[articleType],
  now: referenceDate,
  within: SEVEN_DAYS,
});

const author = article ? getAuthor(article.authorId) : null;

// Cast the player the article features. Deterministic — the post already named
// its hero. No id, or an unknown one, leaves the flank to the league mark.
const seasonYear = getCurrentSeasonYear(referenceDate);
// Only load the player map when there's an id to resolve — old posts without
// a heroPlayerId shouldn't pay the players.json parse on cold starts.
const model = article?.heroPlayerId
  ? castArticleModel(article.heroPlayerId, getPlayerMap(seasonYear), DESCRIPTORS[articleType] ?? 'In the Spotlight')
  : null;

const view: EventHeroView | null =
  article && author
    ? {
        ...articleHeroView(article, {
          pill: KICKERS[articleType] ?? 'Schefter Report',
          // TheLeague's blue, the news wordmark. A story about the league is a
          // league event — the card never wears one club's colours, even when
          // the cast player is rostered.
          composite: { wordmark: 'NEWS', accent: 'kickoff', tone: null, scope: 'league' },
          byline: { name: author.name, avatar: getAuthorAvatar(author) },
          fallbackLink: '/theleague/news',
          dateLabel: articleDateLabel(article.timestamp),
        }),
        model,
      }
    : null;
---

{view ? (
  <LeagueCompositeHero
    view={view}
    regionLabel={KICKERS[articleType] ?? 'Schefter Report'}
    league="theleague"
    clampSummary
  />
) : (
  <ArticleHeroStub />
)}
