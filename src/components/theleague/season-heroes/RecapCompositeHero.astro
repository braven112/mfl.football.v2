---
/**
 * RecapCompositeHero — the Tuesday-AM recap slot, composite edition. The
 * player who put up the most actual fantasy points in the just-completed week
 * models the hero: transparent ESPN cutout on the ROSTERING FRANCHISE's color
 * and crest, his point total as the stat, and the owner named in the summary
 * ("Pacific Pigskins rostered the week's highest score").
 *
 * This is the precedent for tinting a composite by a FANTASY team rather than
 * an NFL one: the hero is about someone's week, so the glow and the watermark
 * come from that franchise. See hero-franchise-accent.ts, which generalizes it.
 *
 * Self-loads from the season's playerScores feed and casts internally (mirrors
 * the other season heroes). The DATA year is the no-arg getCurrentSeasonYear()
 * — env-pinned to the last completed season, so a past-date recap view reads
 * real prior-season scores. The router falls back to the article-driven
 * RecapHero when no scorer resolves to a usable cutout.
 */
import type { HeroState } from '../../../types/hero-state';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { getPlayerMap } from '../../../utils/player-map';
import { getWeeklyTopScorerCandidates, getLatestScoredWeek } from '../../../utils/offseason-hero-data';
import { castBestScoredModel } from '../../../utils/hero-casting';
import { normalizeTeamCode } from '../../../utils/nfl-logo';
import { getFranchiseBrand } from '../../../utils/franchise-brand';
import { resolveDarkSurfaceCrest } from '../../../utils/dark-surface-crest';
import CompositeHero from '../../shared/CompositeHero.astro';
import RecapHero from './RecapHero.astro';

export interface Props {
  state: HeroState;
  resolveLeaguePath: (path: string) => string;
}

const { state, resolveLeaguePath: r } = Astro.props;

// No-arg season year: env-pinned to the last COMPLETED season, so the data is
// real regardless of the testDate driving the slot (the phase machine keys off
// the date; this hero just reads the box score).
const year = getCurrentSeasonYear();
const players = getPlayerMap(year);
const candidates = getWeeklyTopScorerCandidates(year);
const week = getLatestScoredWeek(year);
const model = candidates.length > 0 ? castBestScoredModel(candidates, players, undefined, 'Top Scorer') : null;

// The winning candidate carries the score + rostering franchise.
const winner = model ? candidates.find((c) => c.playerId === model.mflId) ?? null : null;

const brand = winner ? getFranchiseBrand(winner.franchiseId) : null;
const franchiseName = brand?.name ?? '';
const franchiseColor = brand?.color ?? '#1c497c';
// The crest is picked SERVER-SIDE, and it is the dark artwork whenever the
// franchise has any. This hero is a deep-ink composite in BOTH themes, so
// `TeamIconDarkStyles`' swap and white stroke, which fire only under
// `html.dark`, do nothing for a light-theme reader here. Taking `brand.groupMe`
// shipped every franchise's LIGHT mark onto ink in both themes, and the
// near-black crests dissolved into it at 0.12 opacity. See dark-surface-crest.ts.
const crestArt = brand ? resolveDarkSurfaceCrest(brand, 'theleague') : null;
// Inline, so it also beats the global `html.dark` stroke rule keyed on this
// same src — a light crest can never end up wearing two rings.
const crest = crestArt?.src ? { src: crestArt.src, filter: crestArt.filter } : null;

const teamCode = model ? normalizeTeamCode(model.nflTeam) : '';
const points = winner ? winner.score.toFixed(1) : '';
const summary = franchiseName
  ? `${franchiseName} rostered the week's highest score. See how the rest of the league stacked up.`
  : "The week's highest fantasy score. See how the rest of the league stacked up.";
---

{model ? (
  <CompositeHero
    ariaLabel={`Week ${week} recap — top scorer`}
    accent="recap"
    wordmark={crest ? undefined : `WEEK ${week}`}
    crest={crest}
    model={model}
    captionMeta={`${model.position} · ${teamCode}`}
    glowColor={franchiseColor}
    glowAlphaDark={0.42}
    glowAlphaLight={0.24}
    pill={`Weekly Recap · Week ${week}`}
    title={model.name}
    titleAccent="led the week."
    summary={summary}
    styleVars="--cmh-min-h: clamp(240px, 24vw, 290px); --cmh-min-h-mobile: 260px; --cmh-model-w: clamp(275px, 35vw, 412px); --cmh-eyebrow-mb: 0.625rem; --cmh-content-max: min(32rem, 62%); --cmh-title-mb: 0.45rem; --cmh-count-size: 1.5rem; --cmh-model-w-mobile: 170px; --cmh-divider: var(--cmh-pill-border);"
  >
    <div class="cmh__footer">
      <div class="cmh__stat" role="group" aria-label={`${points} points`}>
        <span class="cmh__stat-num" aria-hidden="true">{points}</span>
        <span class="cmh__stat-label" aria-hidden="true">Points · Week {week}</span>
      </div>
      <span class="cmh__divider" aria-hidden="true"></span>
      <a class="cmh__cta" href={r('/theleague/standings')}>
        See the full week
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </CompositeHero>
) : (
  <RecapHero state={state} />
)}
