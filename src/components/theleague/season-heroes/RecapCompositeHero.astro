---
/**
 * RecapCompositeHero — the Tuesday-AM recap slot, composite edition. The
 * player who put up the most actual fantasy points in the just-completed week
 * models the hero: transparent ESPN cutout on the ROSTERING FRANCHISE's color
 * and crest, his point total as the stat, and the owner named in the summary
 * ("Pacific Pigskins rostered the week's highest score").
 *
 * This is the precedent for tinting a composite by a FANTASY team rather than
 * an NFL one: the hero is about someone's week, so the glow and the watermark
 * come from that franchise. See hero-franchise-accent.ts, which generalizes it.
 *
 * Self-loads from the season's playerScores feed and casts internally (mirrors
 * the other season heroes). The DATA year is the no-arg getCurrentSeasonYear()
 * — env-pinned to the last completed season, so a past-date recap view reads
 * real prior-season scores. The router falls back to the article-driven
 * RecapHero when no scorer resolves to a usable cutout.
 */
import type { HeroState } from '../../../types/hero-state';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { getPlayerMap } from '../../../utils/player-map';
import { getWeeklyTopScorerCandidates, getWeekInTheBooks } from '../../../utils/offseason-hero-data';
import { castBestScoredModel } from '../../../utils/hero-casting';
import { normalizeTeamCode } from '../../../utils/nfl-logo';
import { getFranchiseBrand } from '../../../utils/franchise-brand';
import { resolveHeroCrest, resolveHeroFranchiseSkin } from '../../../utils/hero-crest';
import CompositeHero from '../../shared/CompositeHero.astro';
import RecapHero from './RecapHero.astro';
import { resolveRecapDestination } from '../../../utils/hero-recap-destination';
import feedData from '../../../data/theleague/schefter-feed.json';
import type { SchefterFeed } from '../../../types/schefter';

export interface Props {
  state: HeroState;
  resolveLeaguePath: (path: string) => string;
}

const { state, resolveLeaguePath: r } = Astro.props;

// No-arg season year: env-pinned to the last COMPLETED season, so the data is
// real regardless of the testDate driving the slot (the phase machine keys off
// the date; this hero just reads the box score).
const year = getCurrentSeasonYear();
const players = getPlayerMap(year);
// One week drives BOTH the label and the numbers under it. The week is capped
// at the calendar (getWeekInTheBooks) while the feed holds whatever week MFL
// considers live, so reading the scores unfiltered could caption week N's top
// scorer as week N-1's. Scoping the read to the same week means a disagreement
// yields no candidates — and the stub — rather than a confidently wrong card.
// `referenceDate` is the clock the slot itself was resolved on, so ?testDate
// moves the cap with it.
// `week` is 0 when nothing is in the books yet, or when the cap and the feed
// disagree. Passing `undefined` there would DISABLE the filter and caption an
// unfiltered top scorer as "Week 0" — the confidently-wrong card this scoping
// exists to prevent — so a weekless read yields no candidates instead.
const week = getWeekInTheBooks(year, 'theleague', state.metadata.referenceDate);
const candidates = week > 0 ? getWeeklyTopScorerCandidates(year, 'theleague', week) : [];
const model = candidates.length > 0 ? castBestScoredModel(candidates, players, undefined, 'Top Scorer') : null;

// The winning candidate carries the score + rostering franchise.
const winner = model ? candidates.find((c) => c.playerId === model.mflId) ?? null : null;

const brand = winner ? getFranchiseBrand(winner.franchiseId) : null;
const franchiseName = brand?.name ?? '';
const franchiseColor = brand?.color ?? '#1c497c';
// This hero IS a fantasy team's week, so the franchise that rostered the top
// scorer owns the story and its crest is the watermark. `resolveHeroCrest`
// picks the dark-surface artwork server-side and falls back to the player's NFL
// mark if that club ships none — see hero-crest.ts.
const crest = resolveHeroCrest({ franchiseId: winner?.franchiseId, league: 'theleague', nflTeam: model?.nflTeam });
// A TEAM event — it is this franchise's week — so the card wears their colours.
const franchise = resolveHeroFranchiseSkin(winner?.franchiseId, 'theleague');

// Where "see the full week" goes. It used to be /theleague/standings — the
// race, not the week — so a card built entirely out of the completed week's box
// score handed the reader a table that says nothing about it. Schefter's recap
// column when he wrote one, else that week's own scoreboard.
const recap = resolveRecapDestination({
  league: 'theleague',
  seasonYear: year,
  completedWeek: week,
  posts: (feedData as SchefterFeed).posts,
});

const teamCode = model ? normalizeTeamCode(model.nflTeam) : '';
const points = winner ? winner.score.toFixed(1) : '';
const summary = franchiseName
  ? `${franchiseName} rostered the week's highest score. See how the rest of the league stacked up.`
  : "The week's highest fantasy score. See how the rest of the league stacked up.";
---

{model ? (
  <CompositeHero
    ariaLabel={`Week ${week} recap — top scorer`}
    accent="recap"
    wordmark={`WEEK ${week}`}
    crest={crest}
    franchise={franchise}
    model={model}
    captionMeta={`${model.position} · ${teamCode}`}
    glowColor={franchiseColor}
    glowAlphaDark={0.42}
    glowAlphaLight={0.24}
    pill={`Weekly Recap · Week ${week}`}
    title={model.name}
    titleAccent="led the week."
    summary={summary}
    styleVars="--cmh-min-h: clamp(240px, 24vw, 290px); --cmh-min-h-mobile: 260px; --cmh-model-w: clamp(275px, 35vw, 412px); --cmh-model-right: calc(clamp(0.25rem, 2vw, 1.75rem) - 50px); --cmh-eyebrow-mb: 0.625rem; --cmh-content-max: min(32rem, 62%); --cmh-title-mb: 0.45rem; --cmh-count-size: 1.5rem; --cmh-model-w-mobile: 170px; --cmh-divider: var(--cmh-pill-border);"
  >
    <div class="cmh__footer">
      <div class="cmh__stat" role="group" aria-label={`${points} points`}>
        <span class="cmh__stat-num" aria-hidden="true">{points}</span>
        <span class="cmh__stat-label" aria-hidden="true">Points · Week {week}</span>
      </div>
      <span class="cmh__divider" aria-hidden="true"></span>
      <a class="cmh__cta" href={r(recap.href)}>
        {recap.isArticle ? 'Read the recap' : recap.week ? 'See the full week' : 'Read the latest'}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </CompositeHero>
) : (
  <RecapHero state={state} />
)}
