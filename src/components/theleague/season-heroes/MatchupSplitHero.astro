---
/**
 * MatchupSplitHero — the Saturday/Sunday game-day-preview slot, composite
 * edition. The marquee game of the week (its earliest kickoff — the same
 * opener the kickoff hero features) rendered as a split matchup card: each
 * team's top-scored fantasy star on his own team-color gradient, cutouts
 * mirrored toward the center VS. A band underneath names the game and points
 * at the full preview.
 *
 * Self-loads from the season's schedule + score feeds and casts each side
 * internally; the split panel itself is the shared FaceoffComposite. The DATA
 * year is the no-arg getCurrentSeasonYear() — env-pinned to the last completed
 * season, so a past-date preview reads real prior-season data (a completed
 * season falls back from projections to the actual box score). The router
 * falls back to the personalized MatchupPreviewHero grid when the marquee
 * game or its stars don't resolve.
 */
import type { HeroState } from '../../../types/hero-state';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { getPlayerMap } from '../../../utils/player-map';
import { getMarqueeGameStars } from '../../../utils/offseason-hero-data';
import { castBestScoredModel } from '../../../utils/hero-casting';
import { getNFLTeamLogo } from '../../../utils/nfl-logo';
import FaceoffComposite from '../FaceoffComposite.astro';
import MatchupPreviewHero from './MatchupPreviewHero.astro';
import { SUNDAY_TICKET_LOGO } from '../../../utils/broadcast-channels';
import { crestStrokeFilter } from '../../../utils/crest-dark-stroke-css';
import { isSaturdayEveningPT, showSundayTicketHero } from '../../../utils/sunday-ticket-window';
import { hasSubmittedLineup } from '../../../utils/lineup-submitted';
import { DEFAULT_LEAGUE } from '../../../config/leagues';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { getCurrentNFLWeek } from '../../../utils/current-week';

export interface Props {
  state: HeroState;
  resolveLeaguePath: (path: string) => string;
  userFranchiseId?: string;
}

const { state, resolveLeaguePath: r, userFranchiseId } = Astro.props;

// No-arg season year (env-pinned to the last completed season); referenceDate
// only steers which game of the current-week slate is "upcoming" in the live
// feed path.
const year = getCurrentSeasonYear();
const players = getPlayerMap(year);
const stars = getMarqueeGameStars(year, 'theleague', state.metadata.referenceDate);

const awayStar = stars ? castBestScoredModel(stars.awayCandidates, players, undefined, 'Team Star') : null;
const homeStar = stars ? castBestScoredModel(stars.homeCandidates, players, undefined, 'Team Star') : null;
const resolved = stars && awayStar && homeStar ? { stars, awayStar, homeStar } : null;

// Saturday the band bills the game of the week; Sunday morning (or Saturday
// evening once the lineup is in) it is the Sunday Ticket hero — same art, the official mark on the eyebrow, and the
// CTA that was always pointing at the board. The band is near-black in BOTH
// themes, so the dark-ink mark wears the crest ring here unconditionally
// rather than through the html.dark manifest rule.
// Saturday from 5pm the same hero shows for an owner whose lineup is already
// in (one cached live read, only in that window for a signed-in owner).
const ref = state.metadata.referenceDate;
const lineupSubmitted =
  userFranchiseId && isSaturdayEveningPT(ref)
    ? await hasSubmittedLineup({
        league: DEFAULT_LEAGUE,
        franchiseId: userFranchiseId,
        week: getCurrentNFLWeek(ref) ?? 1,
        leagueYear: getLeagueYearForSlug(DEFAULT_LEAGUE.slug),
      })
    : null;
const isSunday = showSundayTicketHero(ref, lineupSubmitted);
const markFilter = crestStrokeFilter();
---

{resolved ? (
  <section class="msh" aria-label={`Game of the week — ${resolved.stars.awayName} at ${resolved.stars.homeName}`}>
    <FaceoffComposite
      away={{ model: resolved.awayStar, chip: resolved.stars.awayCode, watermark: getNFLTeamLogo(resolved.stars.awayCode) }}
      home={{ model: resolved.homeStar, chip: resolved.stars.homeCode, watermark: getNFLTeamLogo(resolved.stars.homeCode) }}
    />

    <div class="msh__band">
      <div class="msh__band-left">
        {isSunday ? (
          <p class="msh__eyebrow msh__eyebrow--st">
            <img class="msh__mark" src={SUNDAY_TICKET_LOGO} alt="NFL Sunday Ticket" width="336" height="263" style={`filter: ${markFilter}`} />
            Your Sunday Ticket
          </p>
        ) : (
          <p class="msh__eyebrow">Game of the week</p>
        )}
        <h2 class="msh__title">{resolved.stars.awayName} at {resolved.stars.homeName}</h2>
      </div>
      <a class="msh__cta" href={r('/theleague/sunday-ticket')}>
        Build your multiview
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
) : (
  <MatchupPreviewHero state={state} resolveLeaguePath={r} userFranchiseId={userFranchiseId} />
)}

<style>
  .msh {
    --msh-border: rgba(28, 73, 124, 0.35);
    --msh-band-bg: #0b0e12;
    --msh-band-ink: #ffffff;
    --msh-accent: #7cb2ff;

    overflow: hidden;
    border-radius: var(--radius-lg, 0.75rem);
    border: 1px solid var(--msh-border);
    display: flex;
    flex-direction: column;
  }

  /* The panels + band are inherently dark (team-color gradients over near-black)
     in both themes on purpose — only the outer border re-tokenizes for dark. */
  :global(html.dark) .msh {
    --msh-border: rgba(255, 255, 255, 0.12);
  }

  .msh__band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    background: var(--msh-band-bg);
    color: var(--msh-band-ink);
  }

  .msh__eyebrow {
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--msh-accent);
    margin: 0 0 0.2rem;
  }

  .msh__title {
    color: var(--msh-band-ink);
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0;
  }

  .msh__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    color: #0b0e12;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.6rem 1.05rem;
    border-radius: var(--radius-md, 0.5rem);
    text-decoration: none;
    transition: transform 120ms ease;
  }

  .msh__eyebrow--st { display: inline-flex; align-items: center; gap: 0.5rem; }
  .msh__mark { height: 1.9rem; width: auto; object-fit: contain; }
  .msh__cta:hover {
    transform: translateY(-1px);
  }

  .msh__cta:focus-visible {
    outline: 2px solid var(--msh-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .msh__cta {
      transition: none;
    }

    .msh__cta:hover {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .msh__band {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.625rem;
    }
  }
</style>
