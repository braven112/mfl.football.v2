---
/**
 * PreseasonCompositeHero — the countdown-to-kickoff hero, composite edition.
 *
 * The model is a franchise headliner (hero casting rules): the signed-in
 * owner's own top-projected player — the guy they're locking in for Week 1 —
 * or a league-wide headliner for guests, rotating daily.
 *
 * Configuration of the shared CompositeHero shell; the geometry below is the
 * shipped `.psh` treatment expressed as the shell's custom properties.
 *
 * The router falls back to the legacy hero when no model resolves.
 */
import type { HeroState } from '../../types/hero-state';
import type { HeroModel } from '../../utils/hero-casting';
import { getNflTeamColors } from '../../utils/nfl-team-colors';
import { normalizeTeamCode } from '../../utils/nfl-logo';
import CompositeHero from '../shared/CompositeHero.astro';

interface Props {
  preseasonProps: NonNullable<HeroState['preseasonProps']>;
  model: HeroModel;
  resolveLeaguePath: (path: string) => string;
  /** Whether the model is the signed-in owner's own player in the opener */
  isOwnHeadliner?: boolean;
  /** The earliest game of the week — names the opener in the summary */
  kickoffGame?: { awayName: string; homeName: string } | null;
}

const { preseasonProps, model, resolveLeaguePath: r, isOwnHeadliner = false, kickoffGame = null } = Astro.props;

const days = preseasonProps.daysUntilKickoff;
const kickoffDate = preseasonProps.kickoffDate;
const isKickoffDay = days === 0;

const openerLine = kickoffGame ? ` — ${kickoffGame.awayName} at ${kickoffGame.homeName} under the lights` : '';
const summary = isKickoffDay
  ? `Week 1 is here${openerLine}. Lock your lineup — the season starts today.`
  : isOwnHeadliner
    ? `Week 1 kicks off ${kickoffDate}${openerLine}, and your guy is in the opener. Is the rest of your lineup ready?`
    : `Rosters are set and Week 1 kicks off ${kickoffDate}${openerLine}. Lock your lineup and get ready.`;

const teamCode = normalizeTeamCode(model.nflTeam);
const captionMeta = `${isOwnHeadliner ? 'Your Kickoff Starter' : model.descriptor} ${model.position} · ${teamCode}`;
---

<CompositeHero
  ariaLabel="Preseason countdown to kickoff"
  accent="kickoff"
  wordmark="KICKOFF"
  model={model}
  captionMeta={captionMeta}
  glowColor={getNflTeamColors(teamCode).primary}
  logoArt="/assets/logos/theleague-logo-dark.svg"
  pill="Preseason"
  title="Kickoff is"
  titleAccent={isKickoffDay ? 'here.' : 'coming.'}
  summary={summary}
  styleVars="--cmh-min-h: clamp(240px, 24vw, 290px); --cmh-min-h-mobile: 260px; --cmh-ghost-left: 38%; --cmh-ghost-size: clamp(4rem, 9vw, 7rem); --cmh-ghost-style: italic; --cmh-model-w: clamp(230px, 30vw, 350px); --cmh-logo-w: clamp(170px, 22vw, 250px); --cmh-logo-opacity: 0.2; --cmh-eyebrow-mb: 0.625rem; --cmh-content-max: min(32rem, 62%); --cmh-title-mb: 0.45rem; --cmh-summary-max: 46ch; --cmh-model-w-mobile: 175px;"
>
  <div class="cmh__footer">
    <div class="cmh__count" role="group" aria-label={isKickoffDay ? 'Kicks off today' : `${days} days to kickoff`}>
      <span class="cmh__count-num" aria-hidden="true">{days}</span>
      <span class="cmh__count-label" aria-hidden="true">{isKickoffDay ? 'Kicks off today' : 'Days to kickoff'}</span>
    </div>
    <span class="cmh__divider" aria-hidden="true"></span>
    <a class="cmh__cta" href={r('/theleague/standings')}>
      View standings
      <span aria-hidden="true">→</span>
    </a>
  </div>
</CompositeHero>
