---
/**
 * Site footer — champions band over a directory deck.
 *
 * Serves every league despite living under theleague/ (kept here so the
 * import in TheLeagueLayout doesn't churn).
 *
 * Layout: a full-width champions band on top, then the five-column link deck,
 * then a rule-driven Deep Cuts line, then the utility bar.
 *
 * The band is a grid of champion cards plus a trailing Trophy Case panel. The
 * panel is not decoration — it guarantees the band always has a final cell, so
 * the grid can never half-empty the way the old `300px 1fr` layout did on AFL
 * and Best Ball (the champion block only rendered for TheLeague, so grid
 * auto-placement dropped the nav into the fixed 300px track and left the 1fr
 * column empty).
 *
 * Card anatomy: the banner artwork already contains the team name, so the name
 * is only rendered as text when there is no banner.
 */
import { getLeagueContext } from '../../utils/league-context';
import { resolveLeaguePath, resolveDirectoryHref } from '../../utils/nav-utils';
import { getFooterColumns, getDeepCuts, pathBelongsToLeague } from '../../config/footer-config';
import {
  getFooterChampions,
  getFooterDraftStatus,
  leagueHasChampionBand,
} from '../../utils/footer-champions';
import { getLeagueBySlug, type CanonicalLeagueSlug } from '../../config/leagues';

interface Props {
  hideLeaguePrefix?: boolean;
  /**
   * The SIGNED-IN franchise, used only to name the AFL all-play link after the
   * tier that owner plays in. Strictly the JWT session — the layout resolves
   * it and passes it down, so the footer itself does no auth (it renders on
   * prerendered pages, where there is no request to read). Never the
   * preference cookie or ?myteam=: those are browse-as, not identity, and a
   * tier label should follow who you ARE, not whose team you're viewing.
   */
  franchiseId?: string | null;
}

const hideLeaguePrefix = Astro.props.hideLeaguePrefix ?? false;
const franchiseId = Astro.props.franchiseId ?? null;

const league = getLeagueContext(Astro.url);
const slug = league.slug as CanonicalLeagueSlug;
// getLeagueContext returns only { name, slug }; navSlug comes from the registry.
const navSlug = getLeagueBySlug(slug)?.navSlug ?? 'theleague';

const href = (path: string) =>
  resolveLeaguePath(resolveDirectoryHref(path, navSlug), hideLeaguePrefix);

const columns = getFooterColumns(slug, franchiseId);
const deepCuts = getDeepCuts(slug, columns);

const showBand = leagueHasChampionBand(slug);
const champions = showBand ? getFooterChampions(slug) : [];
const draftStatus = showBand ? null : getFooterDraftStatus(slug);

/**
 * Sweep names scale off the title count rather than being hardcoded to two.
 *
 * The Treble is the modern ceiling: the two gold awards that can coexist are
 * the Championship and the Premier League (the AFL Cup was retired and
 * REPLACED by the Premier League — Cup 2015-17, Premier League 2018 on, never
 * the same season), and the conference title is dropped whenever the
 * Championship is present. Two gold plus a division is therefore the most a
 * card can show. 2025's Ninjas are exactly that.
 *
 * Quadruple is kept only as a safety net: if a fourth counting award is ever
 * added, it renders a name instead of falling through to "4 Titles".
 */
const SWEEP_NAMES: Record<number, string> = {
  2: 'The Double',
  3: 'The Treble',
  4: 'The Quadruple',
};
const sweepName = (n: number) => SWEEP_NAMES[n] ?? `${n} Titles`;

const bandYear = champions[0]?.year ?? draftStatus?.year ?? null;
const trophyHref = href('/franchises');

/**
 * Search exists only for TheLeague (src/pages/theleague/search.astro hardcodes
 * its own base path). Prefixing the bare /search for another league produced a
 * 404 in the utility bar — on EVERY page of AFL and Best Ball. QuickLinks
 * already routes AFL's "all pages" CTA to the league home for the same reason.
 */
const showSearch = pathBelongsToLeague('/search', slug);
const searchHref = href('/search');

/**
 * The Trophy Case is only for leagues that HAVE a trophy history. Best-ball is
 * draft-only: it has no champions and no /franchises page, so rendering the
 * panel there would ship a guaranteed 404.
 */
const showTrophyCase = showBand;

// Cards plus the optional trophy panel. Three or more cells puts the panel on
// a narrower track so the champion cards stay the dominant pair; a lone card
// is capped rather than stretched across the full 1200px.
const bandCells =
  champions.length + (draftStatus ? 1 : 0) + (showTrophyCase ? 1 : 0);
const bandStyle =
  bandCells > 2
    ? `grid-template-columns:repeat(${bandCells - 1},1fr) minmax(240px,.7fr)`
    : bandCells === 1
      ? 'grid-template-columns:minmax(0,560px)'
      : '';
---

<footer class="site-footer">
  <div class="footer-container">
    {(champions.length > 0 || draftStatus) && (
      <>
        <div class="band-head">
          <span class="eyebrow">
            {champions.length > 1
              ? 'Defending Champions'
              : draftStatus
                ? 'Draft Status'
                : 'Defending Champion'}
          </span>
          {bandYear && <span class="eyebrow">{bandYear} Season</span>}
        </div>

        <div class="champ-band" style={bandStyle}>
          {champions.map((champ) => (
            <a class="champ-card" href={resolveLeaguePath(champ.href, hideLeaguePrefix)}>
              {champ.banner && (
                <img
                  class="champ-banner"
                  src={champ.banner}
                  alt={`${champ.team} — ${champ.year} ${champ.titles[0].label}`}
                  width="950"
                  height="158"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              )}
              <span class="champ-body">
                <span class="badge-stack">
                  {champ.titles.map((title) =>
                    title.badge ? (
                      <span class="badge"><img src={title.badge} alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
                    ) : (
                      <span class="badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M8 21h8M12 17v4M6 4h12v5a6 6 0 0 1-12 0V4Z" />
                          <path d="M6 6H4a2 2 0 0 0 0 4h2M18 6h2a2 2 0 0 1 0 4h-2" />
                        </svg>
                      </span>
                    )
                  )}
                </span>
                <span class="champ-text">
                  {champ.titles.length > 1 && (
                    <span class="sweep-ribbon">{sweepName(champ.titles.length)}</span>
                  )}
                  <span class="champ-meta">
                    {champ.titles.map((t) => t.label).join(' + ')} · {champ.year}
                  </span>
                  {!champ.banner && <span class="champ-team">{champ.teamDisplay}</span>}
                </span>
                <span class="champ-cta" aria-hidden="true">→</span>
              </span>
            </a>
          ))}

          {draftStatus && (
            <a class="champ-card" href={resolveLeaguePath(draftStatus.href, hideLeaguePrefix)}>
              <span class="champ-body">
                <span class="badge-stack">
                  <span class="badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M8 21h8M12 17v4M6 4h12v5a6 6 0 0 1-12 0V4Z" />
                      <path d="M6 6H4a2 2 0 0 0 0 4h2M18 6h2a2 2 0 0 1 0 4h-2" />
                    </svg>
                  </span>
                </span>
                <span class="champ-text">
                  <span class="champ-meta">{draftStatus.label} · {draftStatus.year}</span>
                  <span class="champ-team">{draftStatus.detail}</span>
                </span>
                <span class="champ-cta" aria-hidden="true">→</span>
              </span>
            </a>
          )}

          {showTrophyCase && (
          <a class="trophy-panel" href={trophyHref}>
            <span class="champ-body">
              <span class="badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M8 21h8M12 17v4M6 4h12v5a6 6 0 0 1-12 0V4Z" />
                  <path d="M6 6H4a2 2 0 0 0 0 4h2M18 6h2a2 2 0 0 1 0 4h-2" />
                </svg>
              </span>
              <span class="champ-text">
                <span class="champ-meta">The Trophy Case</span>
                <span class="trophy-title">Every champion, every season</span>
                {bandCells <= 2 && (
                  <span class="trophy-sub">Records and title counts by franchise.</span>
                )}
              </span>
              <span class="champ-cta" aria-hidden="true">→</span>
            </span>
          </a>
          )}
        </div>

        <div class="footer-rule"></div>
      </>
    )}

    <nav class="footer-deck" aria-label="Site directory" style={`grid-template-columns:repeat(${columns.length},1fr)`}>
      {columns.map((col) => (
        <div class="deck-col">
          <h2 class="deck-title">{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                {l.path ? (
                  <a href={href(l.path)}>{l.label}</a>
                ) : (
                  <span class="link-soon">{l.label}<span class="soon-tag">soon</span></span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    {deepCuts.length > 0 && (
      <div class="deep-cuts">
        <span class="eyebrow">Deep Cuts</span>
        {deepCuts.map((l) => <a href={href(l.path!)}>{l.label}</a>)}
      </div>
    )}

    <div class="footer-util">
      <span>© {new Date().getFullYear()} {league.name}</span>
      {showSearch && (
        <>
          <span class="util-sep" aria-hidden="true">·</span>
          <a href={searchHref}>Search</a>
        </>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--inverse-content-bg);
    color: var(--footer-link);
    margin-top: auto;
    width: 100%;
    /* Same accent edge as the breadcrumb bar: league-primary in dark
       (blue TheLeague / red AFL / emerald bb1 via --breadcrumb-bar-border),
       invisible in light where the token is unset. */
    border-top: 0.1rem solid var(--breadcrumb-bar-border, transparent);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Dark: footer mirrors the breadcrumb strip — TheLeague gets the rising
     deep-blue glow (gradient token), AFL its navy, bb1 its green. background
     is SHORTHAND because the token can be a gradient. */
  :global(html.dark) .site-footer {
    background: var(--breadcrumb-bar-bg, var(--inverse-content-bg));
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 0;
    box-sizing: border-box;
  }

  /* The global focus ring is --color-primary, which IS TheLeague's light
     footer background — 1.00:1, completely invisible. Every focusable thing
     in here re-points it to the white footer ring token. */
  .site-footer :where(a, button, [tabindex]):focus-visible {
    outline: 2px solid var(--footer-focus-ring);
    outline-offset: 2px;
    border-radius: 3px;
  }

  .eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.656rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--footer-text-muted);
  }

  .footer-rule {
    height: 1px;
    background: var(--footer-divider);
    margin: 1.75rem 0;
  }

  /* ---------- champions band ---------- */
  .band-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }

  .champ-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }
  .champ-band > * { min-width: 0; }

  .champ-card,
  .trophy-panel {
    background: var(--footer-surface-raised);
    border: 1px solid var(--footer-surface-border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .champ-card:hover,
  .trophy-panel:hover { border-color: var(--trophy-gold-edge); }

  .trophy-panel {
    border-style: dashed;
    display: flex;
    align-items: center;
  }
  .trophy-panel:hover { border-style: solid; }

  /* Every league banner in this repo is 950x158, so the card bleeds the full
     strip at its native ratio — no crop, no lost team name. */
  .champ-banner {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 950 / 158;
  }

  .champ-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    width: 100%;
  }

  .badge-stack { display: flex; flex: none; }
  .badge-stack .badge + .badge { margin-left: -14px; }
  /* A third or fourth trophy would push the stack wide enough to crowd the
     text, so extra badges tighten the overlap instead of widening the card. */
  .badge-stack .badge:nth-child(n + 3) { margin-left: -18px; }

  .badge {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--trophy-gold-edge);
    background: var(--inverse-content-bg);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--trophy-gold);
  }
  .badge img { width: 100%; height: 100%; display: block; }
  .badge svg { width: 24px; height: 24px; }

  .champ-text { min-width: 0; }

  .sweep-ribbon {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.594rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--trophy-gold-ink);
    background: var(--trophy-gold);
    border-radius: 2px;
    padding: 3px 7px;
    margin-bottom: 0.375rem;
  }

  .champ-meta {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.656rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--trophy-gold);
    font-variant-numeric: tabular-nums;
  }

  .champ-team,
  .trophy-title {
    display: block;
    font-weight: 800;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--footer-heading);
  }
  .champ-team { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .trophy-sub { display: block; font-size: 0.8125rem; color: var(--footer-link); margin-top: 2px; }

  .champ-cta {
    margin-left: auto;
    color: var(--footer-text-muted);
    font-size: 1rem;
    flex: none;
  }

  /* ---------- link deck ---------- */
  .footer-deck { display: grid; gap: 1.625rem; }
  .deck-title {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--footer-heading);
    margin: 0 0 0.75rem;
  }
  .deck-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
  }
  .deck-col li { margin: 0; }
  .deck-col a,
  .link-soon {
    color: var(--footer-link);
    text-decoration: none;
    font-size: 0.84375rem;
    display: block;
  }
  /* Hover was --secondary-color green: 2.03:1 on TheLeague blue, HARDER to
     read than the resting state. White + underline instead. */
  .deck-col a:hover,
  .deck-col a:focus-visible {
    color: var(--footer-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .link-soon { color: var(--footer-text-muted); cursor: default; }
  .soon-tag {
    font-family: var(--font-family-mono);
    font-size: 0.531rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    vertical-align: 2px;
    margin-left: 0.4375rem;
    border: 1px dashed var(--footer-surface-border);
    border-radius: 2px;
    padding: 1px 4px;
  }

  /* ---------- deep cuts ---------- */
  /* Gap-separated rather than ::before middots — a leading separator strands
     itself at the start of the wrapped line. */
  .deep-cuts {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4375rem 1.125rem;
    margin-top: 1.75rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--footer-divider);
  }
  .deep-cuts a { font-size: 0.78125rem; color: var(--footer-text-muted); text-decoration: none; }
  .deep-cuts a:hover {
    color: var(--footer-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- utility bar ---------- */
  .footer-util {
    border-top: 1px solid var(--footer-divider);
    margin-top: 1.75rem;
    padding: 0.9375rem 0 1.625rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.125rem;
    font-size: 0.78125rem;
    color: var(--footer-text-muted);
  }
  .footer-util a { color: var(--footer-text-muted); text-decoration: none; }
  .footer-util a:hover {
    color: var(--footer-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .util-sep { opacity: 0.4; }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .footer-deck { grid-template-columns: repeat(3, 1fr) !important; row-gap: 2rem; }
  }

  @media (max-width: 860px) {
    .champ-band,
    .champ-band[style] { grid-template-columns: 1fr !important; }
    .footer-deck { grid-template-columns: repeat(2, 1fr) !important; }
  }

  @media (max-width: 560px) {
    .footer-deck { grid-template-columns: 1fr !important; }
    .footer-container { padding-inline: 1.25rem; }
  }
</style>
