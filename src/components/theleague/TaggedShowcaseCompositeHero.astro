---
/**
 * TaggedShowcaseCompositeHero — the franchise-tag showcase (Feb 15 → auction
 * start): every tagged player on a team-gradient panel, chipped with the
 * tagging franchise + position and badged "Tagged".
 *
 * Configuration of the shared CompositePanelBoard. Where UDFA watermarks the
 * NFL team logo (it is about NFL rookies), this board watermarks the FRANCHISE
 * crest — a franchise tag is a fantasy-team story, so the tagging team's mark
 * belongs behind the player.
 *
 * `fill="drop"` because a photoless panel next to real faces looks broken, and
 * a thin tag year is honest; only when NOTHING loads does the board render
 * anyway, carried by the crest watermark, so the hero is never barren.
 *
 * The router falls back to the branded TaggedPlayerShowcaseHero when fewer
 * than two tagged players resolve to a composite (or none are tagged yet).
 */
import type { HeroModel } from '../../utils/hero-casting';
import CompositePanelBoard from '../shared/CompositePanelBoard.astro';

interface Props {
  /** Composite panels in filed order — pass up to 8: four show, the rest are
      spares that swap in when a headshot 404s. Each carries the tagging
      franchise's short name (for the chip) and crest src (for the watermark). */
  panels: Array<{ model: HeroModel; franchiseName: string; franchiseCrest: string }>;
  /** Total tagged players this year (may exceed the compositable panel count). */
  taggedCount: number;
  leagueYear: number;
  resolveLeaguePath: (path: string) => string;
}

const { panels: rawPanels, taggedCount, leagueYear, resolveLeaguePath: r } = Astro.props;

const panels = rawPanels.map(({ model, franchiseName, franchiseCrest }) => ({
  model,
  badge: [franchiseName, model.position].filter(Boolean).join(' · '),
  flag: 'Tagged',
  watermark: franchiseCrest || null,
  watermarkSquare: true,
}));

// Band copy scales with the number of tags — the composite face count can be
// smaller than taggedCount (some tagged players have no usable ESPN cutout).
const title =
  taggedCount === 1
    ? 'One player just got the franchise tag'
    : `${taggedCount} players just got the franchise tag`;
---

<CompositePanelBoard
  ariaLabel="Franchise-tagged players open for offers"
  panels={panels}
  fill="drop"
  greenFrame
  eyebrow={`Franchise tags · ${leagueYear}`}
  title={title}
  ctaLabel="See every tag"
  ctaHref={r('/theleague/rosters')}
/>
