---
/**
 * A fixed bar naming the environment, shown on the staging sites and on every
 * preview deployment.
 *
 * Owners end up on these hosts — that is the point of standing them up — and
 * the site is otherwise pixel-identical to production while reading
 * production's real data. Somebody looking at real rosters on
 * staging.theleague.us has no way to tell where they are, and the consequences
 * of guessing wrong run both directions: a bug reported against a week-old
 * build, or a "why didn't my lineup save" when the write was refused on
 * purpose (src/utils/deploy-environment.ts).
 *
 * Colors are hard-coded rather than tokenised, deliberately. Every token in
 * this repo has a light and a dark value, and this bar's whole job is to look
 * the same wherever it appears — a warning that restyles itself into the
 * page's palette is a warning that stops being noticed. It also sidesteps the
 * trap in docs/claude/rules/theming-and-assets.md: a `var(--x)` with no
 * definition renders its fallback in both themes, so light looks perfect and
 * dark ships unreadable.
 */
import { isStagingRequest, isNonProductionDeploy, deployEnvLabel } from '../../utils/deploy-environment';

// Two questions, both of which mean "not production":
//   - the HOST is a staging site (staging.theleague.us, …)
//   - the DEPLOYMENT is not production (any PR preview, reached by its
//     *.vercel.app URL, which is no staging host but shares the same risk)
const onStagingHost = isStagingRequest(Astro.url);
const nonProduction = isNonProductionDeploy();
const show = onStagingHost || nonProduction;

// Name the environment precisely. "Staging" and "Preview" behave identically
// for safety purposes but mean different things to whoever is reading: one is
// this week's release candidate, the other is one unmerged branch.
const label = onStagingHost ? 'Staging' : `Preview (${deployEnvLabel()})`;
---

{
	show && (
		<div class="staging-banner" role="status" aria-live="polite">
			<span class="staging-banner__dot" aria-hidden="true" />
			<span class="staging-banner__label">{label}</span>
			<span class="staging-banner__detail">
				Real data, but not the live site — MFL writes, push and chat posts are
				switched off here.
			</span>
		</div>
	)
}

<style>
	.staging-banner {
		position: sticky;
		top: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		padding: 0.35rem 1rem;
		background: #7c2d12;
		color: #fff7ed;
		font-size: 0.8125rem;
		line-height: 1.3;
		text-align: center;
		/* Above the page but never over a modal's backdrop-blur seam. */
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
	}

	.staging-banner__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #fb923c;
		flex: none;
	}

	.staging-banner__label {
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.staging-banner__detail {
		opacity: 0.9;
	}

	/* On a phone the detail sentence would take three lines and push the nav
	   off-screen. The label alone still answers "where am I?", which is the
	   question that matters. */
	@media (max-width: 34rem) {
		.staging-banner__detail {
			display: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.staging-banner__dot {
			animation: staging-banner-pulse 2.4s ease-in-out infinite;
		}
	}

	@keyframes staging-banner-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.35;
		}
	}
</style>
