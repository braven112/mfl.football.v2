---
/**
 * The roster page's header, shared by both leagues.
 *
 * Three bands: the club's own nameplate in its brand colour and the gameday
 * bar it carries (both RosterNameplate), then the team switcher. Replaces what
 * were two forked headers — TheLeague's team card with view tabs and a
 * division accordion, the AFL's team card with a `<select>` — so a fix to one
 * is a fix to both.
 *
 * The view tabs are gone on purpose. Roster / Analytics / Planner were three
 * pages wearing one URL; Analytics and Planner now live on the Front Office
 * hub, and this page is a roster again.
 *
 * Ships no client script. TheLeague's page enhances the switcher into an
 * in-place swap using the `alternates` slot below; the AFL has always
 * navigated on a team change, so it passes nothing and the links stand alone.
 */
import RosterNameplate from './RosterNameplate.astro';
import TeamDivisionRow from './TeamDivisionRow.astro';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import type { HeaderGroup, RailWeek, HeaderPlayer } from '../../../utils/roster-header-data';
import type { StandingsSummary } from '../../../utils/standings-summary';

interface HeaderGame {
  week: number;
  opponentId: string;
  isHome: boolean;
  played: boolean;
  score: number | null;
  opponentScore: number | null;
  outcome: 'W' | 'L' | 'T' | null;
}

/** A week's worth of games — one most of the season, two in a doubleheader. */
interface HeaderWeek {
  week: number;
  games: HeaderGame[];
}

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** The club on screen. */
  franchiseId: string;
  teamName: string;
  teamIcon: string | null;
  /** "Northwest Division", or "American League · North" where there are two. */
  teamMeta: string;
  /** Eyebrow pill — what this page IS for this league. */
  label: string;
  season: number;
  standing: StandingsSummary;
  /** League-specific stats after record / rank / points-for (cap space, …). */
  extraStats?: Array<{ value: string; label: string }>;
  lastPlayed: HeaderWeek | null;
  upNext: HeaderWeek | null;
  rail: RailWeek[];
  /** The live NFL week, or NULL when this season is not the one being played. */
  currentWeek: number | null;
  groups: HeaderGroup[];
  viewerFranchiseId: string | null;
  nameOf: (franchiseId: string) => string;
  iconOf: (franchiseId: string) => string | null;
  recordOf: (franchiseId: string) => string | null;
  teamHref: (franchiseId: string) => string;
  /** Prefetch strategy for the crest links; see TeamDivisionRow. */
  prefetch?: false | 'tap' | 'hover' | 'viewport' | 'load';
  scheduleHref: (week?: number) => string;
  /** When this week's lineups lock, in the viewer's clock; null if nothing to warn about. */
  lineupLock?: string | null;
  /** How recently this club's owner was on the site; forwarded to the nameplate. */
  ownerLastSeen?: { level: 'active' | 'idle' | 'dormant' | 'unknown'; text: string } | null;
  /** The club's featured player; forwarded straight to the nameplate. */
  featuredPlayer?: HeaderPlayer | null;
}

const {
  leagueSlug,
  franchiseId,
  teamName,
  teamIcon,
  teamMeta,
  label,
  season,
  standing,
  extraStats = [],
  lastPlayed,
  upNext,
  rail,
  currentWeek,
  groups,
  viewerFranchiseId,
  nameOf,
  iconOf,
  recordOf,
  teamHref,
  prefetch = false,
  scheduleHref,
  lineupLock = null,
  ownerLastSeen = null,
  featuredPlayer = null,
} = Astro.props;
---

{/* `data-league` so a controller from the OTHER league's roster page — both
    render `.roster-page`, and a cross-league navigation is a ClientRouter swap
    rather than a fresh document — cannot mistake this header for its own. */}
<header class="rhdr" data-league={leagueSlug}>
  {/* `data-rhdr-team` is what TheLeague's in-place switcher replaces. It holds
      only the per-club half, so a switch never rebuilds the crest row. */}
  <div data-rhdr-team={franchiseId}>
    <RosterNameplate
      leagueSlug={leagueSlug}
      franchiseId={franchiseId}
      teamName={teamName}
      teamIcon={teamIcon}
      teamMeta={teamMeta}
      label={label}
      season={season}
      standing={standing}
      extraStats={extraStats}
      lastPlayed={lastPlayed}
      upNext={upNext}
      rail={rail}
      currentWeek={currentWeek}
      nameOf={nameOf}
      iconOf={iconOf}
      recordOf={recordOf}
      scheduleHref={scheduleHref}
      lineupLock={lineupLock}
      ownerLastSeen={ownerLastSeen}
      featuredPlayer={featuredPlayer}
    />
  </div>

  <TeamDivisionRow
    groups={groups}
    activeFranchiseId={franchiseId}
    viewerFranchiseId={viewerFranchiseId}
    teamHref={teamHref}
    prefetch={prefetch}
  />

  {/* Every other club's nameplate, inert in <template>s until the switcher
      needs one. A page that navigates instead (the AFL) renders nothing. */}
  <slot name="alternates" />
</header>

<style>
  /*
   * `min-width: 0` is load-bearing, not tidiness.
   *
   * `.roster-page` is a GRID and this header is one of its items. A grid item
   * defaults to `min-width: auto`, which refuses to shrink below its content's
   * intrinsic minimum — and this header's content is wide by nature (a row of
   * 16 or 24 crests, a three-column scoreboard). So the item blew the grid out
   * to 699px on TheLeague and 1076px on the AFL inside a 390px viewport,
   * taking the nav and breadcrumbs with it and giving the whole PAGE a
   * horizontal scrollbar. The inner `overflow-x: auto` never got a chance:
   * a box only scrolls once something constrains its width.
   */
  .rhdr {
    display: block;
    min-width: 0;
  }
</style>
