---
/**
 * The roster header's team switcher: every club in the league as a crest,
 * grouped by division, always open.
 *
 * `data-team-id` is the hook TheLeague's in-place switcher reads; the active
 * ring is keyed off `aria-current`, which that switcher moves, so the styling
 * and the accessible state can never disagree.
 *
 * Replaces TheLeague's expanding accordion and the AFL's `<select>` with one
 * component, so the two leagues stop drifting. Each crest is a plain LINK, not
 * a button — switching team is a navigation, so it must be bookmarkable,
 * middle-clickable and reachable with JavaScript off. That also means this
 * component ships no client script at all.
 *
 * Two marks, deliberately distinct: the club being VIEWED carries the ring
 * (`aria-current="page"`), and the viewer's OWN club carries a dot. They are
 * usually the same club and occasionally not, and when they differ the reader
 * needs to find both.
 */
import type { HeaderGroup } from '../../../utils/roster-header-data';

interface Props {
  groups: HeaderGroup[];
  /** The club whose roster is on screen. */
  activeFranchiseId: string | null;
  /** The viewer's own club, if they have one in THIS league. */
  viewerFranchiseId: string | null;
  /** Builds the href for one club's roster. */
  teamHref: (franchiseId: string) => string;
  /**
   * Prefetch strategy for the crest links, or false to leave them alone.
   *
   * Opt-in per league, because the two leagues follow these links differently.
   * TheLeague intercepts the click and switches in place, so its pages are
   * never navigated to and prefetching them would download 4.6 MB for nothing.
   * The AFL really does navigate, which is why its switch measured ~840 ms
   * against TheLeague's ~130 ms, so it asks for `tap`.
   *
   * `tap` and not `hover`: the row holds up to 24 crests side by side, and a
   * mouse crossing it would prefetch every page in the league. `tap` fires on
   * `touchstart`/`mousedown` — only the link being activated, and early
   * enough to overlap the render with the press.
   */
  prefetch?: false | 'tap' | 'hover' | 'viewport' | 'load';
}

const { groups, activeFranchiseId, viewerFranchiseId, teamHref, prefetch = false } = Astro.props;

// A conference rail is only meaningful when there is more than one to tell
// apart; a single-table league renders the divisions with no outer label.
const showConferences = groups.length > 1;

/**
 * Which conference opens. `groups` already arrives in the viewer's own order
 * (`conferenceOrder`), so the first one IS theirs — resolved from the session,
 * then their remembered club, then the historical AL-first default.
 */
const openIndex = 0;

/** Unique per render, so two headers on one document cannot share a group. */
const radioName = `rhdr-conf-${Math.random().toString(36).slice(2, 9)}`;
---

<nav class="rhdr-teams" aria-label="Switch team">
  {/* ONE CONFERENCE AT A TIME, and no client script.
      Twenty-four crests plus six division labels do not fit a desktop column,
      so the row used to scroll sideways and the last division was cut off the
      screen. A radio per conference with the rails as its labels collapses
      the other one to its rail, which is a CSS-only accordion: this component
      ships no JavaScript at all (tests/rosters-team-nav-clientrouter.test.ts
      pins that), and radios are what enforce "exactly one open" without any.
      Rendered only when there IS more than one conference, so TheLeague's
      single table is untouched. */}
  {showConferences && groups.map((group, index) => (
    <input
      type="radio"
      name={radioName}
      id={`${radioName}-${index}`}
      class="rhdr-teams__radio"
      checked={index === openIndex}
      aria-label={`Show ${group.conferenceName}`}
    />
  ))}
  {groups.map((group, index) => (
    <div
      class="rhdr-teams__conf"
      style={group.conferenceColor ? `--rhdr-conf: ${group.conferenceColor};` : undefined}
    >
      {showConferences && group.conferenceName && (
        <label
          class:list={['rhdr-teams__conflabel', { 'is-mine': group.divisions.some((division) =>
            division.teams.some((team) => team.franchiseId === viewerFranchiseId),
          ) }]}
          for={`${radioName}-${index}`}
          title={`Show ${group.conferenceName}`}
        >{group.conferenceShort ?? group.conferenceName}</label>
      )}
      <div class="rhdr-teams__divisions">
        {/* No `has-active` class on the division: TheLeague's switcher moves
            `aria-current` across crests without re-rendering, so a class
            computed here goes stale on the first click. `:has()` in the
            stylesheet asks the DOM instead, and follows the swap for free. */}
        {group.divisions.map((division) => (
          <div class="rhdr-teams__division">
            <span class="rhdr-teams__divlabel">{division.name}</span>
            <div class="rhdr-teams__crests">
              {division.teams.map((team) => (
                <a
                  href={teamHref(team.franchiseId)}
                  data-astro-prefetch={prefetch || undefined}
                  class="rhdr-teams__crest"
                  style={`--rhdr-ring:${team.ringLight};--rhdr-ring-dark:${team.ringDark}`}
                  data-team-id={team.franchiseId}
                  data-mine={team.franchiseId === viewerFranchiseId ? 'true' : undefined}
                  aria-current={team.franchiseId === activeFranchiseId ? 'page' : undefined}
                >
                  {team.icon ? (
                    <img src={team.icon} alt="" width="34" height="34" loading="lazy" decoding="async" />
                  ) : (
                    <span class="rhdr-teams__fallback" aria-hidden="true">{team.shortName.slice(0, 2)}</span>
                  )}
                  {/* The link's accessible name. Visually hidden, never a
                      tooltip — and never a `title` attribute either, which
                      does not surface on touch and reads late on a screen
                      reader. */}
                  <span class="rhdr-teams__name">
                    {team.name}
                    {team.franchiseId === viewerFranchiseId ? ' (your team)' : ''}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</nav>

<style>
  /* The radios live at the start of the nav so `~` can reach every conference
     after them. Visually hidden, never `display: none` — that would drop them
     from the tab order and make the rails unreachable by keyboard. */
  .rhdr-teams__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  /* nth-of-type counts the radios; nth-child would count the conferences too. */
  .rhdr-teams__radio:nth-of-type(1):checked ~ .rhdr-teams__conf:nth-of-type(1) .rhdr-teams__divisions,
  .rhdr-teams__radio:nth-of-type(2):checked ~ .rhdr-teams__conf:nth-of-type(2) .rhdr-teams__divisions {
    display: flex;
  }
  .rhdr-teams__radio:focus-visible + .rhdr-teams__conf .rhdr-teams__conflabel,
  .rhdr-teams__radio:focus-visible ~ .rhdr-teams__conf .rhdr-teams__conflabel {
    outline: 2px solid var(--page-text);
    outline-offset: -3px;
  }

  .rhdr-teams {
    position: relative;
    display: flex;
    align-items: stretch;
    /* Pairs with the header's own min-width:0 — without a constrained width
       this box has nothing to scroll within and pushes the page instead. */
    min-width: 0;
    background: var(--content-bg-muted);
    border-bottom: 1px solid var(--content-border-color);
    /* One conference at a time fits a desktop column — twelve crests and two
       division labels — so this no longer scrolls there. It stays `auto` for
       the narrow case, where even one conference can overflow; contained
       here, it never moves the page body. */
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* `flex: 1 0 auto` throughout, not `flex: 1`.
     Grow to share the full row when everything fits — 16 crests left a third
     of the row empty otherwise — but NEVER shrink below content, because the
     AFL's 24 clubs plus six division labels do not fit and must keep their
     natural width so the strip scrolls instead of crushing the crests.
     `flex: 1` would set flex-basis: 0 and do exactly that crushing. */
  .rhdr-teams__conf {
    display: flex;
    align-items: stretch;
    flex: 1 0 auto;
  }
  .rhdr-teams__conf + .rhdr-teams__conf {
    border-left: 3px solid var(--content-border-color);
  }

  .rhdr-teams__conflabel {
    display: flex;
    align-items: center;
    flex: none;
    cursor: pointer;
    padding: 0 0.6rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-white, #fff);
    /* The CONFERENCE's own colour, sampled from its mark (`getConferenceColor`)
       — AL red, NL blue. Grey read as chrome and left the vertical label as
       the only way to tell which half of the row you were looking at, which is
       a lot to ask of two rotated letters. Dimmed while collapsed so the open
       conference is obviously the live one. */
    background: var(--rhdr-conf, var(--content-text-muted));
    opacity: 0.55;
    transition: opacity 0.14s ease;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    /* The short code always fits the row's height; clip rather than spill if a
       future league ever carries a longer one. */
    overflow: hidden;
  }
  /* The OPEN conference is at full strength; the collapsed one is dimmed.
     That, plus which side the crests are on, is what says which is which —
     the colour says WHICH conference, the opacity says which is showing. */
  .rhdr-teams__radio:nth-of-type(1):checked ~ .rhdr-teams__conf:nth-of-type(1) .rhdr-teams__conflabel,
  .rhdr-teams__radio:nth-of-type(2):checked ~ .rhdr-teams__conf:nth-of-type(2) .rhdr-teams__conflabel {
    opacity: 1;
  }
  .rhdr-teams__conflabel:hover { opacity: 0.85; }

  /* The viewer's own conference is marked on the rail itself, since it is no
     longer the only one wearing a colour. */
  .rhdr-teams__conflabel.is-mine {
    box-shadow: inset 3px 0 0 var(--page-text);
  }

  .rhdr-teams__divisions {
    display: flex;
    align-items: stretch;
    flex: 1 0 auto;
  }
  /* Collapsed unless this conference's radio is the checked one. Scoped to a
     row that HAS radios, so a single-table league never hides its divisions:
     `:has()` asks the DOM rather than trusting a class the server guessed. */
  .rhdr-teams:has(.rhdr-teams__radio) .rhdr-teams__divisions { display: none; }
  /* A collapsed conference is its RAIL and nothing else — `flex: 1 0 auto`
     kept its share of the row and left a dead band between the two rails. */
  .rhdr-teams:has(.rhdr-teams__radio) .rhdr-teams__conf { flex: none; }
  .rhdr-teams__radio:nth-of-type(1):checked ~ .rhdr-teams__conf:nth-of-type(1),
  .rhdr-teams__radio:nth-of-type(2):checked ~ .rhdr-teams__conf:nth-of-type(2) {
    flex: 1 0 auto;
  }

  .rhdr-teams__division {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-right: 1px solid var(--content-border-color);
  }
  .rhdr-teams__division:last-child { border-right: 0; }

  .rhdr-teams__divlabel {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-align: center;
    color: var(--content-text-muted);
  }
  /* Asked of the DOM, not of a render-time class — see the markup note. The
     active division's label is full ink rather than a colour: the coloured
     mark in this row is the club's own, and a second colour up here made the
     row look like it was reporting two different things. */
  .rhdr-teams__division:has(.rhdr-teams__crest[aria-current='page']) .rhdr-teams__divlabel {
    color: var(--page-text);
  }

  .rhdr-teams__crests {
    display: flex;
    justify-content: center;
    /* Wide enough that the active club's ring never touches its neighbour,
       and that a thumb can land on one crest on a phone. The row scrolls
       sideways, so the gap costs nothing but scroll length. */
    gap: 0.7rem;
  }

  .rhdr-teams__crest {
    position: relative;
    display: block;
    line-height: 0;
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.14s ease;
  }
  /* FULL strength, and a SQUARE box.
     These were dimmed to 0.56 at rest so the row would sit behind the
     scoreboard, which just made sixteen clubs look switched off — the crest
     is the only thing identifying the link, so dimming it dims the one signal
     it carries. Rank the row down with size and surface, never by fading the
     artwork.
     `border-radius: 50%` went with it: these marks are not all circles, and a
     circle mask ate the corners of every one that is not. `contain` in a
     square box shows the whole mark, with a small radius on the BOX only so
     the ring below has something to follow. */
  .rhdr-teams__crest img,
  .rhdr-teams__fallback {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    object-fit: contain;
  }
  .rhdr-teams__fallback {
    display: grid;
    place-items: center;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: var(--content-text-muted);
    background: var(--color-surface-3);
  }

  .rhdr-teams__crest:hover { transform: translateY(-2px); }

  /* The club being VIEWED is ringed in ITS OWN colour, set per crest from the
     brand value held to 3:1 against this row in each theme (see
     `ringLight`/`ringDark` in roster-header-data.ts). It was `--color-accent`,
     which is #2e8743 in TheLeague — the same green as a win on the rail above,
     so the header marked "you are here" and "you won" identically.
     The inner 2px of row surface is the gap that keeps the ring off the
     artwork; the ring follows the box's radius, so it is square-ish like the
     mark rather than a circle drawn around one. */
  .rhdr-teams__crest[aria-current='page'] img,
  .rhdr-teams__crest[aria-current='page'] .rhdr-teams__fallback {
    box-shadow:
      0 0 0 2px var(--content-bg-muted),
      0 0 0 5px var(--rhdr-ring, var(--page-text));
  }
  :global(html.dark) .rhdr-teams__crest[aria-current='page'] img,
  :global(html.dark) .rhdr-teams__crest[aria-current='page'] .rhdr-teams__fallback {
    box-shadow:
      0 0 0 2px var(--content-bg-muted),
      0 0 0 5px var(--rhdr-ring-dark, var(--page-text));
  }

  /* The viewer's OWN club, which is usually but not always the one on screen.
     Ink rather than a colour: it has to stay distinguishable from the ring
     above it, and shape already does that work. */
  .rhdr-teams__crest[data-mine='true']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--page-text);
  }

  .rhdr-teams__crest:focus-visible {
    outline: 2px solid var(--page-text);
    outline-offset: 4px;
  }

  /* The club name is the link's ACCESSIBLE NAME and nothing else — never a
     visible tooltip.
     It used to reveal on hover and focus, which on a touch screen means it
     reveals on TAP: the name flashed up over the row on the way to switching
     team, and the leftmost crest's label ran off the edge of the phone. The
     crests are the identification — an owner knows their own league's marks.
     Screen readers still get the full name (plus "(your team)"), because this
     is clipped rather than `display: none`; a display:none label would leave
     every crest an unlabelled link. */
  .rhdr-teams__name {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* A phone gets MORE room between crests, not less: the row is scrolled and
     tapped with a thumb there, the ring plus its gap already eats 7px of the
     space between two marks, and the row scrolls sideways — so the only thing
     a wider gap costs is scroll length. */
  @media (max-width: 640px) {
    .rhdr-teams__crests { gap: 1.35rem; }
    .rhdr-teams__division { padding: 0.6rem 0.95rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rhdr-teams__crest { transition: none; }
    .rhdr-teams__crest:hover { transform: none; }
  }
</style>
