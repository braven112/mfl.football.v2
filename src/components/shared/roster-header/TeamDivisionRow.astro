---
/**
 * The roster header's team switcher: every club in the league as a crest,
 * grouped by division, always open.
 *
 * `data-team-id` is the hook TheLeague's in-place switcher reads; the active
 * ring is keyed off `aria-current`, which that switcher moves, so the styling
 * and the accessible state can never disagree.
 *
 * Replaces TheLeague's expanding accordion and the AFL's `<select>` with one
 * component, so the two leagues stop drifting. Each crest is a plain LINK, not
 * a button — switching team is a navigation, so it must be bookmarkable,
 * middle-clickable and reachable with JavaScript off. That also means this
 * component ships no client script at all.
 *
 * Two marks, deliberately distinct: the club being VIEWED carries the ring
 * (`aria-current="page"`), and the viewer's OWN club carries a dot. They are
 * usually the same club and occasionally not, and when they differ the reader
 * needs to find both.
 */
import type { HeaderGroup } from '../../../utils/roster-header-data';

interface Props {
  groups: HeaderGroup[];
  /** The club whose roster is on screen. */
  activeFranchiseId: string | null;
  /** The viewer's own club, if they have one in THIS league. */
  viewerFranchiseId: string | null;
  /** Builds the href for one club's roster. */
  teamHref: (franchiseId: string) => string;
}

const { groups, activeFranchiseId, viewerFranchiseId, teamHref } = Astro.props;

// A conference rail is only meaningful when there is more than one to tell
// apart; a single-table league renders the divisions with no outer label.
const showConferences = groups.length > 1;
---

<nav class="rhdr-teams" aria-label="Switch team">
  {groups.map((group) => (
    <div class="rhdr-teams__conf">
      {showConferences && group.conferenceName && (
        <span
          class:list={['rhdr-teams__conflabel', { 'is-mine': group.divisions.some((division) =>
            division.teams.some((team) => team.franchiseId === viewerFranchiseId),
          ) }]}
          aria-label={group.conferenceName}
          title={group.conferenceName}
        >{group.conferenceShort ?? group.conferenceName}</span>
      )}
      <div class="rhdr-teams__divisions">
        {/* No `has-active` class on the division: TheLeague's switcher moves
            `aria-current` across crests without re-rendering, so a class
            computed here goes stale on the first click. `:has()` in the
            stylesheet asks the DOM instead, and follows the swap for free. */}
        {group.divisions.map((division) => (
          <div class="rhdr-teams__division">
            <span class="rhdr-teams__divlabel">{division.name}</span>
            <div class="rhdr-teams__crests">
              {division.teams.map((team) => (
                <a
                  href={teamHref(team.franchiseId)}
                  class="rhdr-teams__crest"
                  style={`--rhdr-ring:${team.ringLight};--rhdr-ring-dark:${team.ringDark}`}
                  data-team-id={team.franchiseId}
                  data-mine={team.franchiseId === viewerFranchiseId ? 'true' : undefined}
                  aria-current={team.franchiseId === activeFranchiseId ? 'page' : undefined}
                >
                  {team.icon ? (
                    <img src={team.icon} alt="" width="34" height="34" loading="lazy" decoding="async" />
                  ) : (
                    <span class="rhdr-teams__fallback" aria-hidden="true">{team.shortName.slice(0, 2)}</span>
                  )}
                  {/* The accessible name, and the hover label. Never a `title`
                      attribute: it does not surface on touch and reads late on
                      a screen reader. */}
                  <span class="rhdr-teams__name">
                    {team.name}
                    {team.franchiseId === viewerFranchiseId ? ' (your team)' : ''}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</nav>

<style>
  .rhdr-teams {
    display: flex;
    align-items: stretch;
    /* Pairs with the header's own min-width:0 — without a constrained width
       this box has nothing to scroll within and pushes the page instead. */
    min-width: 0;
    background: var(--content-bg-muted);
    border-bottom: 1px solid var(--content-border-color);
    /* 24 clubs plus six division labels exceed a desktop column, so the strip
       scrolls sideways. Contained here, it never moves the page body. */
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* `flex: 1 0 auto` throughout, not `flex: 1`.
     Grow to share the full row when everything fits — 16 crests left a third
     of the row empty otherwise — but NEVER shrink below content, because the
     AFL's 24 clubs plus six division labels do not fit and must keep their
     natural width so the strip scrolls instead of crushing the crests.
     `flex: 1` would set flex-basis: 0 and do exactly that crushing. */
  .rhdr-teams__conf {
    display: flex;
    align-items: stretch;
    flex: 1 0 auto;
  }
  .rhdr-teams__conf + .rhdr-teams__conf {
    border-left: 3px solid var(--content-border-color);
  }

  .rhdr-teams__conflabel {
    display: flex;
    align-items: center;
    flex: none;
    padding: 0 0.6rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-white, #fff);
    /* Neutral by default; the viewer's OWN conference takes the accent below.
       These were the other way round at first, which read backwards — the half
       of the row that is yours was the quiet one. */
    background: var(--content-text-muted);
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    /* The short code always fits the row's height; clip rather than spill if a
       future league ever carries a longer one. */
    overflow: hidden;
  }
  /* The viewer's own conference reads STRONGER, not greener — full page ink
     against the muted grey of the other half. Green here competed with the
     scoreboard's own green above it and read as a status rather than as
     "this half is yours". */
  .rhdr-teams__conflabel.is-mine {
    background: var(--page-text);
    color: var(--card-surface);
  }

  .rhdr-teams__divisions {
    display: flex;
    align-items: stretch;
    flex: 1 0 auto;
  }

  .rhdr-teams__division {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-right: 1px solid var(--content-border-color);
  }
  .rhdr-teams__division:last-child { border-right: 0; }

  .rhdr-teams__divlabel {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-align: center;
    color: var(--content-text-muted);
  }
  /* Asked of the DOM, not of a render-time class — see the markup note. The
     active division's label is full ink rather than a colour: the coloured
     mark in this row is the club's own, and a second colour up here made the
     row look like it was reporting two different things. */
  .rhdr-teams__division:has(.rhdr-teams__crest[aria-current='page']) .rhdr-teams__divlabel {
    color: var(--page-text);
  }

  .rhdr-teams__crests {
    display: flex;
    justify-content: center;
    /* Wide enough that the active club's ring never touches its neighbour,
       and that a thumb can land on one crest on a phone. The row scrolls
       sideways, so the gap costs nothing but scroll length. */
    gap: 0.7rem;
  }

  .rhdr-teams__crest {
    position: relative;
    display: block;
    line-height: 0;
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.14s ease;
  }
  /* FULL strength, and a SQUARE box.
     These were dimmed to 0.56 at rest so the row would sit behind the
     scoreboard, which just made sixteen clubs look switched off — the crest
     is the only thing identifying the link, so dimming it dims the one signal
     it carries. Rank the row down with size and surface, never by fading the
     artwork.
     `border-radius: 50%` went with it: these marks are not all circles, and a
     circle mask ate the corners of every one that is not. `contain` in a
     square box shows the whole mark, with a small radius on the BOX only so
     the ring below has something to follow. */
  .rhdr-teams__crest img,
  .rhdr-teams__fallback {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    object-fit: contain;
  }
  .rhdr-teams__fallback {
    display: grid;
    place-items: center;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: var(--content-text-muted);
    background: var(--color-surface-3);
  }

  .rhdr-teams__crest:hover { transform: translateY(-2px); }

  /* The club being VIEWED is ringed in ITS OWN colour, set per crest from the
     brand value held to 3:1 against this row in each theme (see
     `ringLight`/`ringDark` in roster-header-data.ts). It was `--color-accent`,
     which is #2e8743 in TheLeague — the same green as a win on the rail above,
     so the header marked "you are here" and "you won" identically.
     The inner 2px of row surface is the gap that keeps the ring off the
     artwork; the ring follows the box's radius, so it is square-ish like the
     mark rather than a circle drawn around one. */
  .rhdr-teams__crest[aria-current='page'] img,
  .rhdr-teams__crest[aria-current='page'] .rhdr-teams__fallback {
    box-shadow:
      0 0 0 2px var(--content-bg-muted),
      0 0 0 5px var(--rhdr-ring, var(--page-text));
  }
  :global(html.dark) .rhdr-teams__crest[aria-current='page'] img,
  :global(html.dark) .rhdr-teams__crest[aria-current='page'] .rhdr-teams__fallback {
    box-shadow:
      0 0 0 2px var(--content-bg-muted),
      0 0 0 5px var(--rhdr-ring-dark, var(--page-text));
  }

  /* The viewer's OWN club, which is usually but not always the one on screen.
     Ink rather than a colour: it has to stay distinguishable from the ring
     above it, and shape already does that work. */
  .rhdr-teams__crest[data-mine='true']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--page-text);
  }

  .rhdr-teams__crest:focus-visible {
    outline: 2px solid var(--page-text);
    outline-offset: 4px;
  }

  /* The club name is the link's accessible name and its hover label. Clipped
     rather than `display:none` so assistive tech still reads it. */
  .rhdr-teams__name {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 7px);
    transform: translateX(-50%);
    z-index: 5;
    padding: 0.25rem 0.5rem;
    border-radius: 5px;
    font-size: 0.72rem;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--card-surface);
    background: var(--page-text);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease;
  }
  .rhdr-teams__crest:hover .rhdr-teams__name,
  .rhdr-teams__crest:focus-visible .rhdr-teams__name { opacity: 1; }

  /* A phone gets MORE room between crests, not less: the row is scrolled with
     a thumb there, and the ring plus its gap is 7px of the space between two
     marks. */
  @media (max-width: 640px) {
    .rhdr-teams__crests { gap: 0.9rem; }
    .rhdr-teams__division { padding: 0.6rem 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rhdr-teams__crest,
    .rhdr-teams__name { transition: none; }
    .rhdr-teams__crest:hover { transform: none; }
  }
</style>
