---
/**
 * Ask Roger — the rules chatbot page, shared by every league that has one
 * (TheLeague, the AFL, and package leagues with the "Ask Roger" box ticked).
 *
 * The route owns the league's data imports and auth; this renders. Colours
 * come from the league theme's tokens, so a league needs no CSS of its own.
 */
import RulesChatIsland from './RulesChat';
import type { RulesQA } from '../../../types/rules-qa';
import '../../../styles/loading.css';

interface Props {
  league: { slug: string };
  seedData: RulesQA[];
  isAuthenticated: boolean;
  isAdmin: boolean;
  teamIcons: Array<{ franchiseId: string; icon: string }>;
  /** Where the chat posts questions (the league's rules-qa endpoint). */
  apiEndpoint: string;
  /** The league's Rules page. */
  rulesHref: string;
  /** "the constitution", "the AFL constitution", "the league rulebook"… */
  rulebookName: string;
  /** Roger's one-line bio in the sidebar card. */
  bio: string;
  /** The "Support Roger" donate box (TheLeague's). */
  showSupport?: boolean;
}

const {
  league,
  seedData,
  isAuthenticated,
  isAdmin,
  teamIcons,
  apiEndpoint,
  rulesHref,
  rulebookName,
  bio,
  showSupport = false,
} = Astro.props;
---

<div class="rqa-page" data-league={league.slug}>
    <!-- ── Left: Main Column ── -->
    <div class="rqa-main">
      <header class="rqa-hero">
        <div class="rqa-hero__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="rqa-hero__text">
          <div class="rqa-section-title">Ask Roger</div>
          <p class="rqa-hero__sub">Roger is our AI rules expert. He's read {rulebookName} so you don't have to. His answers are <em>probably</em> right — for definitive rulings, ask the actual Commissioner.</p>
        </div>
      </header>

      <div class="rqa-body">
        <RulesChatIsland
          client:load
          preSeeded={seedData}
          isAuthenticated={isAuthenticated}
          isAdmin={isAdmin}
          teamIcons={teamIcons}
          apiEndpoint={apiEndpoint}
        />
      </div>
    </div>

    <!-- ── Right: Sticky Sidebar ── -->
    <aside class="rqa-sidebar">
      <div class="rqa-sidebar__inner">
        <!-- Roger's personality card -->
        <div class="rqa-roger-card">
          <img
            src="/assets/commissioner-avatar.webp?v=5"
            alt="Roger — AI Rules Expert"
            class="rqa-roger-card__avatar"
            width="80"
            height="80"
            loading="eager"
          />
          <div class="rqa-roger-card__name">Roger</div>
          <div class="rqa-roger-card__role">AI Rules Expert</div>
          <p class="rqa-roger-card__bio">{bio}</p>
          <a href={rulesHref} class="cta cta--primary rqa-roger-card__cta">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            Read the Rulebook
          </a>
        </div>

        <!-- Disclaimer -->
        <div class="rqa-sidebar__section">
          <div class="rqa-sidebar__label">Disclaimer</div>
          <p class="rqa-sidebar__disclaimer">
            Roger is an AI chatbot. His answers are based on the <a href={rulesHref}>official rules</a> and are <em>probably</em> right — but not guaranteed. When in doubt, the Commissioner's word is final.
          </p>
        </div>

        {/* Tip Roger */}
        {showSupport && (
          <div class="rqa-sidebar__section">
            <div class="rqa-sidebar__label">Support</div>
            <p class="rqa-sidebar__tip-text">
              If Roger saved you a trip to the rulebook, consider giving him a hug. If you're not the hugging type, PayPal works too — each question costs about 10 cents.
            </p>
            <div class="rqa-donate-btns">
              <a href="https://paypal.me/mfladdons" target="_blank" rel="noopener noreferrer" class="cta cta--ghost rqa-donate-btn">
                <svg class="rqa-donate-btn__icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-paypal" /></svg>
                PayPal
              </a>
              <a href="https://venmo.com/braven112" target="_blank" rel="noopener noreferrer" class="cta cta--ghost rqa-donate-btn">
                <svg class="rqa-donate-btn__icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-venmo" /></svg>
                Venmo
              </a>
            </div>
          </div>
        )}
      </div>
    </aside>
  </div>

<style>
  /* ── 2-Column Blog Layout ── */
  .rqa-page {
    /* The page's colours come from the league theme (league-themes.generated.css):
       the accent for text and rules, the CTA fill under white text. TheLeague's
       accent IS its primary, so both leagues read the same tokens. */
    --rqa-accent: var(--league-accent, var(--color-primary, #1c497c));
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 1.5rem;
    margin: 0 auto;
    align-items: start;
  }

  /* ── Left: Main Column ── */
  .rqa-main {
    display: flex;
    flex-direction: column;
    gap: var(--padding-lg, 1.5rem);
    min-width: 0;
  }

  /* Hero */
  .rqa-hero {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 2rem;
    background: var(--card-bg, #fff);
    border-radius: var(--radius-lg, 1rem);
    box-shadow: var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1));
  }
  :global(html.dark) .rqa-hero {
    box-shadow: 0 0 0 1px var(--content-border, #555), var(--shadow-lg);
  }
  .rqa-hero__icon {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: var(--radius-full, 9999px);
    background: var(--color-gray-100, #f3f4f6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rqa-accent);
  }
  .rqa-section-title {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-left: 0.625rem;
    border-left: 2px solid var(--rqa-accent);
    color: var(--color-gray-900, #111827);
  }
  .rqa-hero__sub {
    font-size: var(--font-size-sm);
    color: var(--color-gray-500, #6b7280);
    margin: 0.25rem 0 0 0;
    padding-left: 0.625rem;
  }

  /* Body */
  .rqa-body {
    background: var(--card-bg, #fff);
    border-radius: var(--radius-lg, 1rem);
    box-shadow: var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1));
    padding: 1.5rem;
  }
  :global(html.dark) .rqa-body {
    box-shadow: 0 0 0 1px var(--content-border, #555), var(--shadow-lg);
  }

  /* ── Right: Sticky Sidebar ── */
  .rqa-sidebar {
    position: sticky;
    top: 1rem;
  }
  .rqa-sidebar__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Roger personality card */
  .rqa-roger-card {
    background: var(--card-bg, #fff);
    border-radius: var(--radius-lg, 1rem);
    box-shadow: var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1));
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  :global(html.dark) .rqa-roger-card {
    box-shadow: 0 0 0 1px var(--content-border, #555), var(--shadow-lg);
  }
  .rqa-roger-card__avatar {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full, 9999px);
    object-fit: cover;
    border: 3px solid var(--color-gray-100, #f3f4f6);
    margin-bottom: 0.75rem;
  }
  .rqa-roger-card__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-gray-900, #111827);
    line-height: 1;
  }
  .rqa-roger-card__role {
    font-size: var(--font-size-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--rqa-accent);
    margin-top: 0.25rem;
  }
  .rqa-roger-card__bio {
    font-size: var(--font-size-xs);
    line-height: 1.5;
    color: var(--color-gray-400, #9ca3af);
    margin: 0.75rem 0 0 0;
  }
  .rqa-roger-card__cta {
    display: flex;
    margin-top: 1rem;
    padding: 0.625rem 1rem;
    font-size: 0.8125rem;
  }

  /* Sidebar sections */
  .rqa-sidebar__section {
    background: var(--card-bg, #fff);
    border-radius: var(--radius-lg, 1rem);
    box-shadow: var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1));
    padding: 1rem 1.25rem;
  }
  :global(html.dark) .rqa-sidebar__section {
    box-shadow: 0 0 0 1px var(--content-border, #555), var(--shadow-lg);
  }
  .rqa-sidebar__label {
    font-size: var(--font-size-3xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-400, #9ca3af);
    padding-left: 0.5rem;
    border-left: 2px solid var(--color-gray-200, #e5e7eb);
    margin-bottom: 0.625rem;
  }
  .rqa-sidebar__disclaimer {
    font-size: var(--font-size-2xs);
    line-height: 1.55;
    color: var(--color-gray-500, #6b7280);
    margin: 0;
  }
  .rqa-sidebar__disclaimer a {
    color: var(--rqa-accent);
    text-decoration: none;
  }
  .rqa-sidebar__disclaimer a:hover {
    text-decoration: underline;
  }
  .rqa-sidebar__tip-text {
    font-size: var(--font-size-2xs);
    line-height: 1.55;
    color: var(--color-gray-500, #6b7280);
    margin: 0 0 0.75rem 0;
  }

  /* Donate buttons */
  .rqa-donate-btns {
    display: flex;
    gap: 0.375rem;
  }
  /* Low-emphasis grey chips — the ghost CTA re-coloured, not link-blue. */
  .rqa-donate-btn {
    --cta-bg: var(--color-gray-50, #f9fafb);
    --cta-bg-hover: var(--color-gray-50, #f9fafb);
    --cta-ink: var(--color-gray-600, #4b5563);
    --cta-border: var(--content-border, #e2e8f0);
    --cta-border-hover: var(--rqa-accent);
    gap: 0.375rem;
    flex: 1;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm, 0.25rem);
    font-size: var(--font-size-2xs);
    font-weight: 600;
  }
  .rqa-donate-btn__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: currentColor;
  }

  /* ── Mobile: Single Column ── */
  @media (max-width: 860px) {
    .rqa-page {
      grid-template-columns: 1fr;
      max-width: 800px;
    }
    .rqa-sidebar {
      position: static;
      order: 1;
    }
    .rqa-main {
      order: 0;
    }
    .rqa-sidebar__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .rqa-roger-card {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 1rem;
      text-align: left;
      padding: 1rem 1.25rem;
    }
    .rqa-roger-card__avatar {
      width: 56px;
      height: 56px;
      margin-bottom: 0;
      flex-shrink: 0;
    }
    .rqa-roger-card__bio {
      margin-top: 0.375rem;
    }
  }

  @media (max-width: 600px) {
    .rqa-hero {
      padding: 1.25rem;
      gap: 0.75rem;
    }
    .rqa-hero__icon {
      width: 44px;
      height: 44px;
      min-width: var(--touch-target-min);
    }
    .rqa-body {
      padding: 1rem;
    }
    .rqa-sidebar__inner {
      grid-template-columns: 1fr;
    }
    .rqa-roger-card {
      flex-direction: column;
      text-align: center;
    }
    .rqa-roger-card__avatar {
      width: 64px;
      height: 64px;
    }
    .rqa-donate-btns {
      justify-content: center;
    }
  }
</style>

<!-- Component styles (global so React components can use them) -->
<style is:global>
  /* ── Ask Input ── */
  .rqa-input {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-gray-100, #f3f4f6);
  }
  .rqa-input__field-wrap {
    position: relative;
  }
  .rqa-input__field {
    width: 100%;
    padding: 0.75rem;
    padding-right: 4rem;
    font-size: var(--font-size-sm);
    font-family: inherit;
    color: var(--input-text, #1f2937);
    background: var(--color-gray-50, #f9fafb);
    border: 1px solid var(--content-border, #e2e8f0);
    border-left: 2px solid var(--color-gray-300, #d1d5db);
    border-radius: var(--radius-sm, 0.25rem);
    box-sizing: border-box;
    resize: none;
    overflow: hidden;
    min-height: var(--touch-target-min);
    max-height: 160px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .rqa-input__field::placeholder {
    color: var(--color-gray-400, #9ca3af);
  }
  .rqa-input__field:focus-visible {
    outline: none;
    border-color: var(--rqa-accent);
    border-left-color: var(--rqa-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rqa-accent) 10%, transparent);
    background: var(--input-bg, #fff);
  }
  .rqa-input__count {
    position: absolute;
    right: 0.75rem;
    bottom: 0.5rem;
    font-size: var(--font-size-2xs);
    color: var(--color-gray-400, #9ca3af);
    font-variant-numeric: tabular-nums;
  }
  .rqa-input__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--cta-fill, var(--rqa-accent));
    color: var(--on-cta-fill, #fff);
    border: none;
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background var(--transition-fast), opacity var(--transition-fast);
    align-self: flex-end;
  }
  .rqa-input__submit:hover:not(:disabled) {
    background: var(--cta-fill-hover, var(--rqa-accent));
  }
  .rqa-input__submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .rqa-input__submit:focus-visible {
    outline: 2px solid var(--rqa-accent);
    outline-offset: 2px;
  }
  .rqa-input__hint {
    font-size: 0.8125rem;
    color: var(--color-gray-500, #6b7280);
    margin: 0;
    font-style: italic;
  }

  /* ── Login Prompt ── */
  .rqa-login-prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-gray-50, #f9fafb);
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: var(--radius-sm, 0.25rem);
    font-size: 0.8125rem;
    color: var(--color-gray-500, #6b7280);
    margin-bottom: 1.5rem;
  }

  /* ── Error ── */
  .rqa-error {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0.75rem;
    background: var(--color-error-light, #fef2f2);
    border: 1px solid var(--color-error-border, #fecaca);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-error, #dc2626);
    font-size: 0.8125rem;
    margin-bottom: 1rem;
  }
  /* --color-error-border isn't inverted for dark mode in tokens-dark.css,
     so its light-pink fallback would survive; re-derive from the
     (dark-inverted) --color-error instead, scoped to this page only. */
  html.dark .rqa-error {
    border-color: color-mix(in srgb, var(--color-error, #f87171) 40%, transparent);
  }

  /* ── Q&A List ── */
  .rqa-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .rqa-empty {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--color-gray-400, #9ca3af);
    font-size: var(--font-size-sm);
  }
  .rqa-count {
    text-align: center;
    padding-top: 1rem;
    font-size: var(--font-size-2xs);
    color: var(--color-gray-400, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* ── QA Card ── */
  .rqa-card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-gray-100, #f3f4f6);
    transition: background var(--transition-slow);
  }
  .rqa-card:first-child {
    padding-top: 0;
  }
  .rqa-card:last-child {
    border-bottom: none;
  }
  .rqa-card--new {
    animation: rqa-highlight 2s ease-out;
  }
  @keyframes rqa-highlight {
    0% { background: color-mix(in srgb, var(--rqa-accent) 6%, transparent); }
    100% { background: transparent; }
  }
  .rqa-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .rqa-card__avatar {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: var(--radius-full, 9999px);
    background: var(--cta-fill, var(--rqa-accent));
    color: var(--on-cta-fill, #fff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-3xs);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .rqa-card__avatar--office {
    background: var(--color-gray-200, #e5e7eb);
    color: var(--color-gray-500, #6b7280);
  }
  .rqa-card__avatar:has(.rqa-card__team-icon) {
    background: transparent !important;
  }
  .rqa-card__team-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .rqa-card__meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1;
  }
  .rqa-card__delete {
    margin-left: auto;
    padding: 0.25rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-gray-400, #9ca3af);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .rqa-card:hover .rqa-card__delete { opacity: 1; }
  .rqa-card__delete:hover {
    color: var(--color-error, #dc2626);
    border-color: var(--color-error-border, #fecaca);
    background: var(--color-error-light, #fef2f2);
  }
  html.dark .rqa-card__delete:hover {
    border-color: color-mix(in srgb, var(--color-error, #f87171) 40%, transparent);
  }

  /* "This answer looks wrong" — owner report control + state. */
  .rqa-card__flag-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    margin-top: 0.625rem;
    padding: 0.4375rem 0.5625rem;
    border: 1px solid var(--color-error-border, #fecaca);
    border-radius: var(--radius-sm, 0.25rem);
    background: var(--color-error-light, #fef2f2);
    color: var(--color-error, #dc2626);
    font-size: var(--font-size-xs);
    line-height: 1.4;
  }
  .rqa-card__flag-banner svg { flex: none; margin-top: 0.125rem; }
  html.dark .rqa-card__flag-banner {
    border-color: color-mix(in srgb, var(--color-error, #f87171) 40%, transparent);
    background: color-mix(in srgb, var(--color-error, #f87171) 12%, transparent);
  }
  .rqa-card__flaggers {
    margin: 0.375rem 0 0;
    padding-left: 1rem;
    font-size: var(--font-size-2xs);
    color: var(--color-gray-600, #4b5563);
    line-height: 1.5;
  }
  .rqa-card__flag-noreason { color: var(--color-gray-400, #9ca3af); }
  .rqa-card__resolve-btn {
    margin-top: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: none;
    border: 1px solid var(--color-gray-200, #e5e7eb);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-gray-500, #6b7280);
    font-size: var(--font-size-2xs);
    font-weight: 500;
    cursor: pointer;
  }
  .rqa-card__resolve-btn:hover:not(:disabled) { color: var(--color-gray-700, #374151); }
  .rqa-card__resolve-btn:disabled { opacity: 0.6; cursor: default; }
  html.dark .rqa-card__resolve-btn { border-color: var(--content-border, #374151); }
  .rqa-card__report { margin-top: 0.5rem; }
  .rqa-card__report-btn,
  .rqa-card__report-cancel {
    padding: 0.25rem 0.5rem;
    background: none;
    border: 1px solid var(--color-gray-200, #e5e7eb);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-gray-500, #6b7280);
    font-size: var(--font-size-2xs);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }
  .rqa-card__report-btn:hover:not(:disabled) {
    color: var(--color-error, #dc2626);
    border-color: var(--color-error-border, #fecaca);
    background: var(--color-error-light, #fef2f2);
  }
  .rqa-card__report-btn--active {
    color: var(--color-error, #dc2626);
    border-color: var(--color-error-border, #fecaca);
