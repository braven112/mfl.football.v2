---
/**
 * The Front Office hub — the front door to contracts, cap, salary and trade
 * pages, shared by both leagues. Mirrors DraftHubPage.astro
 * (src/components/shared/draft-hub/) with one structural difference and one
 * bug fix, both recorded here rather than silently copied:
 *
 * - No live-state band. The Draft Hub earns its countdown/status section
 *   because a draft is a dated event with three discrete states; nothing in
 *   the Front Office has an equivalent, and building one (a cap-space band,
 *   say) would need the full roster + contract feeds on a page whose only job
 *   is routing — exactly the duplication the performance review is briefed to
 *   catch, and TheLeague-only besides (AFL runs salaryCap:false). The one
 *   personal touch kept is the signed-in owner's team name in the header, at
 *   zero marginal cost (same team data the wrapper already resolves).
 * - Root is a `<div>`, not `<main>` — DraftHubPage.astro renders `<main
 *   class="dh">` INSIDE TheLeagueLayout, which already owns the page's one
 *   `<main>` landmark. Do not repeat that here.
 *
 * Groups render as headed sections when the league has 3+ populated groups
 * (TheLeague: Your Team / Cap Planning / Reports & Archive) and as one flat
 * grid otherwise (AFL: 2 groups, 4 cards) — a flat 4-card grid needs no
 * outline, and a grid of exactly 11 cards badly needs one. This is a rule
 * about GROUP COUNT, not a per-league branch, so a future league gets the
 * right treatment for free.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import FrontOfficeNav from '../front-office-nav/FrontOfficeNav.astro';
import { spriteUrl } from '../../../utils/sprite-url';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug } from '../../../config/leagues';
import { frontOfficeGroupsFor, type FrontOfficeLeagueSlug } from '../front-office-nav/front-office-pages';

interface Props {
  leagueSlug: FrontOfficeLeagueSlug;
  /** The signed-in owner's franchise IN THIS LEAGUE, or null. */
  myTeam: { id: string; name: string; icon?: string } | null;
  leagueYear: number;
}

const { leagueSlug, myTeam, leagueYear } = Astro.props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${leagueSlug}${path}`, hideLeaguePrefix);
const groups = frontOfficeGroupsFor(leagueSlug);
const grouped = groups.length >= 3;

const subtitle =
  leagueSlug === 'afl-fantasy'
    ? 'Rosters, keepers, and every trade you’re thinking about.'
    : 'Contracts, the cap, and every trade you’re thinking about.';
---

<TheLeagueLayout title={`${league.name} — Front Office`}>
  <div class="fo">
    <FrontOfficeNav leagueSlug={leagueSlug} current="hub" />

    <header class="fo__head">
      <h1 class="fo__title">
        Front Office
        {myTeam && (
          <span class="fo__team">
            {myTeam.icon && <img src={myTeam.icon} alt="" class="fo__team-icon" width="24" height="24" />}
            {myTeam.name}
          </span>
        )}
      </h1>
      <p class="fo__sub">{subtitle} · {leagueYear}</p>
    </header>

    {grouped ? (
      groups.map((g) => (
        <section class="fo__group" aria-labelledby={`fo-g-${g.key}`}>
          <h2 class="fo__group-title" id={`fo-g-${g.key}`}>{g.title}</h2>
          <ul class="fo__cards">
            {g.pages.map((p) => (
              <li>
                <a class="fo__card" href={r(p.path)}>
                  <svg class="fo__card-icon" viewBox="0 0 512 512" aria-hidden="true">
                    <use href={`${spriteUrl}#${p.icon}`} />
                  </svg>
                  <span class="fo__card-text">
                    <span class="fo__card-title">{p.label}</span>
                    <span class="fo__card-blurb">{p.blurb}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <section class="fo__group" aria-labelledby="fo-tools">
        <h2 class="fo__group-title" id="fo-tools">Front office tools</h2>
        <ul class="fo__cards">
          {groups.flatMap((g) => g.pages).map((p) => (
            <li>
              <a class="fo__card" href={r(p.path)}>
                <svg class="fo__card-icon" viewBox="0 0 512 512" aria-hidden="true">
                  <use href={`${spriteUrl}#${p.icon}`} />
                </svg>
                <span class="fo__card-text">
                  <span class="fo__card-title">{p.label}</span>
                  <span class="fo__card-blurb">{p.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</TheLeagueLayout>

<style>
  .fo {
    --fo-accent: var(--league-accent, #1c497c);
    --fo-surface: var(--card-bg, #fff);
    --fo-surface-muted: var(--content-bg-muted, #f7f7f7);
    --fo-border: var(--content-border, #e5e5e5);
    --fo-ink: var(--page-text, #1a1a1a);
    --fo-ink-muted: var(--content-text-muted, #666);
    --fo-on-accent: var(--btn-primary-text, #fff);

    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
  }

  :global(html.dark) .fo {
    --fo-on-accent: #0b1220;
    --fo-ink-muted: var(--color-gray-700, #c0c0c0);
  }

  .fo__head { margin: 1rem 0 1.25rem; }

  .fo__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--fo-ink);
  }

  .fo__team {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--fo-ink-muted);
  }

  .fo__team-icon {
    border-radius: 0.3rem;
    object-fit: contain;
  }

  .fo__sub {
    margin: 0.35rem 0 0;
    color: var(--fo-ink-muted);
    font-size: 0.875rem;
  }

  .fo__group + .fo__group {
    margin-top: 1.5rem;
  }

  .fo__group-title {
    display: flex;
    align-items: center;
    margin: 0 0 0.6rem;
    padding-left: 0.625rem;
    border-left: 2px solid var(--fo-accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fo-ink);
  }

  .fo__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(255px, 100%), 1fr));
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  /* Equal-height cards WITHOUT a percentage height — see DraftHubPage's
     .dh__cards comment: this repo has no global border-box, so a percentage
     height plus the card's own padding/border overflows its row. */
  .fo__cards > li {
    display: flex;
  }

  .fo__card {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    flex: 1;
    box-sizing: border-box;
    padding: 0.85rem;
    border: 1px solid var(--fo-border);
    border-radius: 0.6rem;
    background: var(--fo-surface);
    text-decoration: none;
  }

  .fo__card:hover {
    border-color: var(--fo-accent);
    background: var(--fo-surface-muted);
  }

  .fo__card:focus-visible {
    outline: 2px solid var(--fo-accent);
    outline-offset: 2px;
  }

  .fo__card-icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    fill: var(--fo-accent);
    color: var(--fo-accent);
  }

  .fo__card-text { display: flex; flex-direction: column; gap: 0.15rem; }

  .fo__card-title {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--fo-ink);
  }

  .fo__card-blurb {
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--fo-ink-muted);
  }

  @media (max-width: 560px) {
    .fo { padding: 0.75rem; }
    .fo__title { font-size: 1.2rem; }
  }
</style>
