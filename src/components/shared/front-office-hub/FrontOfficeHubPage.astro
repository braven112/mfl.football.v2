---
/**
 * The Front Office hub — no longer a links-only landing page. It now IS the
 * League Planner (TheLeague) / Keeper Planner (AFL), with a sidebar of every
 * other Front Office tool alongside it. Shared shell for both leagues; each
 * league's route wrapper passes its own primary content into the default
 * slot and an optional team switcher into the `switcher` slot.
 *
 * History: this used to be a pure link grid (mirroring DraftHubPage.astro).
 * The PO's read after seeing it live: "doesn't add any value" — a page whose
 * only job is routing elsewhere isn't worth a click of its own. This shell
 * is the replacement: the hub is now a real destination, and the other
 * Front Office pages are one sidebar away instead of the whole page.
 *
 * Three departures from the old hub, each deliberate:
 * - No `FrontOfficeNav` pill strip above the headline. The PO rejected it
 *   explicitly during the mockup review — the sidebar rail already covers
 *   every page that strip did, and a page whose OWN content is the planner
 *   doesn't need a tab bar pointing at itself. `FrontOfficeNav` is untouched
 *   and still renders on every OTHER Front Office page (Contracts, Trade
 *   Builder, etc.) — only the hub stops rendering it.
 * - Root is a `<div>`, not `<main>` — TheLeagueLayout owns the page's one
 *   `<main>` landmark (carried over from the old hub, still correct here).
 * - `max-width` is 1232px, not the old hub's 1100px — TheLeagueLayout's own
 *   `<main>` caps at 1232px, and the two-column layout (content + a 220px
 *   sticky rail) needs the room to read the planner cards at the same width
 *   `/rosters?view=planner` renders them at.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../theleague/Breadcrumbs.astro';
import FrontOfficeToolRail from './FrontOfficeToolRail.astro';
import { getLeagueBySlug } from '../../../config/leagues';
import type { FrontOfficeLeagueSlug } from '../front-office-nav/front-office-pages';

interface Props {
  leagueSlug: FrontOfficeLeagueSlug;
  /** The signed-in owner's franchise IN THIS LEAGUE, or null. */
  myTeam: { id: string; name: string; icon?: string } | null;
  leagueYear: number;
}

const { leagueSlug, myTeam, leagueYear } = Astro.props;
const league = getLeagueBySlug(leagueSlug)!;

const subtitle =
  leagueSlug === 'afl-fantasy'
    ? 'Rosters, keepers, and every trade you’re thinking about.'
    : 'Contracts, the cap, and every trade you’re thinking about.';
---

<TheLeagueLayout title={`${league.name} — Front Office`}>
  <div class="fo">
    <Breadcrumbs items={[{ label: 'Home', href: `/${leagueSlug}` }, { label: 'Front Office' }]} />

    <slot name="switcher" />

    <header class="fo__head">
      <h1 class="fo__title">
        Front Office
        {myTeam && (
          <span class="fo__team">
            {myTeam.icon && <img src={myTeam.icon} alt="" class="fo__team-icon" width="24" height="24" />}
            {myTeam.name}
          </span>
        )}
      </h1>
      <p class="fo__sub">{subtitle} · {leagueYear}</p>
    </header>

    <div class="fo__layout">
      <div class="fo__main">
        <slot />
      </div>
      <FrontOfficeToolRail leagueSlug={leagueSlug} />
    </div>
  </div>
</TheLeagueLayout>

<style>
  .fo {
    --fo-accent: var(--league-accent, #1c497c);
    --fo-surface: var(--card-bg, #fff);
    --fo-surface-muted: var(--content-bg-muted, #f7f7f7);
    --fo-border: var(--content-border, #e5e5e5);
    --fo-ink: var(--page-text, #1a1a1a);
    --fo-ink-muted: var(--content-text-muted, #666);
    --fo-on-accent: var(--btn-primary-text, #fff);

    max-width: 1232px;
    margin: 0 auto;
    padding: 1rem;
  }

  :global(html.dark) .fo {
    --fo-on-accent: #0b1220;
    --fo-ink-muted: var(--color-gray-700, #c0c0c0);
  }

  .fo__head { margin: 1rem 0 1.25rem; }

  .fo__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--fo-ink);
  }

  .fo__team {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--fo-ink-muted);
  }

  .fo__team-icon {
    border-radius: 0.3rem;
    object-fit: contain;
  }

  .fo__sub {
    margin: 0.35rem 0 0;
    color: var(--fo-ink-muted);
    font-size: 0.875rem;
  }

  .fo__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .fo__layout {
      grid-template-columns: minmax(0, 1fr) 220px;
    }
  }

  .fo__main {
    min-width: 0;
  }

  @media (max-width: 560px) {
    .fo { padding: 0.75rem; }
    .fo__title { font-size: 1.2rem; }
  }
</style>
