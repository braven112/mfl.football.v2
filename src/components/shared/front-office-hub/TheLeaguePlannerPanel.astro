---
/**
 * TheLeague's League Planner — the Front Office hub's primary content.
 * Duplicated from rosters.astro's "nextyear"/planner view (its template
 * around lines 2701-2887, CSS around 3586-3642, and the team-switch panel
 * logic around 7783-8004 and 11750-11876) — see front-office-planner-data.ts
 * for why this is a duplicate and not an extraction.
 *
 * Two departures from rosters.astro's version, both from the approved design
 * spec / PO review:
 * - All four sections get a titled header (rosters.astro only titles
 *   Extensions) — better screen-reader navigation on a long stacked page,
 *   and it's what the approved mockup showed.
 * - No live client-side cap-math recomputation. Front Office has no cut /
 *   declare / extend actions, so every team's metrics are precomputed
 *   server-side as display strings (front-office-planner-data.ts) and the
 *   team switch just swaps which team's precomputed panels/strings show.
 *
 * Two sections do NOT come from rosters.astro's planner view, because that
 * view does not have them:
 * - **Roster Analytics** — the shared <RosterAnalyticsPanel> the AFL's hub
 *   introduced, plus the four cap charts TheLeague's rosters.astro renders
 *   on a DIFFERENT tab (Analytics) and only client-side. Here they are
 *   server-rendered, per team.
 * - **Draft Assets** — now one <DraftAssetChips> card instead of up to two
 *   ChartCards holding DraftTeamAssetsView / DraftPicksCard. Those two
 *   components are untouched and still serve rosters.astro.
 */
import ChartCard from '../../theleague/ChartCard.astro';
import MetricCard from '../../theleague/MetricCard.astro';
import FranchiseOptions from '../../theleague/FranchiseOptions.astro';
import VeteranExtensionCandidates from '../../theleague/VeteranExtensionCandidates.astro';
import FreeAgentNeedsCard from '../../theleague/FreeAgentNeedsCard.astro';
import DraftAssetChips from './DraftAssetChips.astro';
import RosterAnalyticsPanel from './RosterAnalyticsPanel.astro';
import NflCollegeStacks from './NflCollegeStacks.astro';
import PlayerDetailsModal from '../../theleague/PlayerDetailsModal.astro';
import WatchListBridge from '../WatchListBridge.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { TARGET_ACTIVE_COUNT, RESERVE_FOR_ROOKIES } from '../../../utils/salary-calculations';
import type { FrontOfficePlannerData } from '../../../utils/front-office-planner-data';

interface Props extends FrontOfficePlannerData {
  selectedTeamId: string;
  /** Whether the viewer is signed in as a TheLeague owner (any team — the
   *  team switcher lets a signed-in owner browse a different team than
   *  their own, and watching a player is a viewer-level action either way). */
  signedIn: boolean;
}

const {
  teamsList,
  leagueYear,
  plannerPhase,
  extensionSeason,
  salaryAveragesBySeason,
  allPlayers,
  freeAgentNeedsByTeam,
  teamMetrics,
  teamAnalytics,
  draftChipsByTeam,
  selectedTeamId,
  signedIn,
} = Astro.props;

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/theleague${path}`, hideLeaguePrefix);

// A team absent from the season payload (a brand-new franchise, or a feed
// that has not landed yet) must render an empty panel, not throw.
const EMPTY_ANALYTICS = {
  rosterSize: 0,
  positionDistribution: [],
  donutSegments: [],
  ageBuckets: [],
  ageStats: { avg: null, oldest: null, youngest: null },
  ageByPositionDots: [],
  ageStripRange: { min: 22, max: 36, ticks: [] },
};

const selectedMetrics = teamMetrics[selectedTeamId] ?? {
  capSpaceDisplay: '—',
  avgPerPlayerDisplay: '—',
  playersSignedDisplay: '—',
  cutHint: null,
  deadMoneyDisplay: '—',
  averageAgeDisplay: 'N/A',
};

// One JSON blob, precomputed display strings only — no cap math ships to
// the client (see this file's header comment).
const clientConfig = {
  teams: Object.fromEntries(teamsList.map((t) => [t.id, teamMetrics[t.id]])),
};
---

<PlayerDetailsModal />
<WatchListBridge signedIn={signedIn} claimVerb="Bid" />

<div class="fo-planner" data-planner-phase={plannerPhase.phase}>
  <div class="planner-section planner-section--extensions">
    <h2 class="planner-section__title">Extensions</h2>
    <div class="chart-grid">
      <ChartCard title={`Franchise Tag Options (${leagueYear + 1})`} subtitle="Potential franchise tag candidates">
        <FranchiseOptions
          players={allPlayers as any}
          salaryAverages={salaryAveragesBySeason as any}
          season={extensionSeason}
          franchiseId={selectedTeamId}
        />
      </ChartCard>
      <ChartCard title="Veteran Extension Candidates" subtitle="Potential contract extension candidates">
        <VeteranExtensionCandidates
          players={allPlayers as any}
          salaryAverages={salaryAveragesBySeason as any}
          season={extensionSeason}
          franchiseId={selectedTeamId}
        />
      </ChartCard>
    </div>
  </div>

  <div class="planner-section planner-section--fa-needs">
    <h2 class="planner-section__title">Free Agent Needs</h2>
    <div id="fo-fa-needs-panels">
      {teamsList.map((team) => (
        <div
          class="fa-needs-panel"
          data-fa-needs-team-id={team.id}
          style={`display: ${team.id === selectedTeamId ? 'block' : 'none'}`}
        >
          <FreeAgentNeedsCard needs={freeAgentNeedsByTeam[team.id] ?? []} franchiseId={team.id} showActions />
        </div>
      ))}
    </div>
  </div>

  <div class="planner-section planner-section--metrics">
    <h2 class="planner-section__title">{leagueYear} at a Glance</h2>
    <div class="chart-metrics">
      <MetricCard label="Cap Space" value={selectedMetrics.capSpaceDisplay} valueId="fo-metric-cap" />
      <MetricCard label="Avg per Player*" value={selectedMetrics.avgPerPlayerDisplay} valueId="fo-metric-avg" />
      <MetricCard
        label="Players Signed"
        value={selectedMetrics.playersSignedDisplay}
        valueId="fo-metric-signed"
        hint={selectedMetrics.cutHint ?? undefined}
        hintVariant="error"
        hintId="fo-metric-signed-hint"
      />
      <MetricCard label="Dead Money" value={selectedMetrics.deadMoneyDisplay} valueId="fo-metric-dead" />
      <MetricCard label="Average Age" value={selectedMetrics.averageAgeDisplay} valueId="fo-metric-age" />
    </div>
    <small class="chart-metrics__hint">
      *Based on filling to {TARGET_ACTIVE_COUNT} active players. Reserves ${(RESERVE_FOR_ROOKIES / 1_000_000).toFixed(0)}M for practice squad rookies and free agents.
    </small>
  </div>

  <div class="planner-section planner-section--draft-assets">
    <h2 class="planner-section__title">Draft Assets</h2>
    {/* One card with a year subhead per group — not the two side-by-side
        ChartCards this used to render. See DraftAssetChips.astro's header
        for why the chip row replaced DraftTeamAssetsView / DraftPicksCard
        here, and why those two components still exist for rosters.astro. */}
    <div id="fo-draft-chip-panels">
      {teamsList.map((team) => (
        <div
          class="draft-chips-panel"
          data-draft-chips-team-id={team.id}
          style={`display: ${team.id === selectedTeamId ? 'block' : 'none'}`}
        >
          <DraftAssetChips
            groups={draftChipsByTeam[team.id] ?? []}
            title={null}
            href={r('/draft/order?view=assets')}
            hrefTitle="View full draft assets"
          />
        </div>
      ))}
    </div>
  </div>

  <div class="planner-section planner-section--analytics">
    <h2 class="planner-section__title">Roster Analytics</h2>
    {/* CHARTS are pre-rendered for every team and toggled by the switcher,
        exactly like the FA-needs panels above — the hub swaps display, it
        never fetches. They are pure SVG and cost ~26 KB a team. */}
    <div id="fo-analytics-panels">
      {teamsList.map((team) => (
        <div
          class="analytics-panel"
          data-analytics-team-id={team.id}
          style={`display: ${team.id === selectedTeamId ? 'block' : 'none'}`}
        >
          <RosterAnalyticsPanel
            analytics={teamAnalytics[team.id]?.analytics ?? EMPTY_ANALYTICS}
            cap={teamAnalytics[team.id]?.cap ?? null}
            title={null}
          />
        </div>
      ))}
    </div>

    {/* STACKS are NOT pre-rendered per team, unlike everything else on this
        page. Each one is ~19 PlayerCells and a PlayerCell is ~2 KB rendered
        (a three-deep headshot `onerror` chain plus the modal's JSON), so all
        16 teams came to 1.45 MB raw / 133 KB gzipped — a doubling of the
        whole page to pre-paint fifteen teams nobody is looking at. Measured,
        not estimated.

        So only the selected team's stacks render, and switching to another
        team offers a link that reloads the page for it. The charts above
        still swap instantly, which is the part of this section an owner
        actually flips between teams to compare. */}
    <div id="fo-stacks-host" data-stacks-team-id={selectedTeamId}>
      <NflCollegeStacks
        playersByNflTeam={teamAnalytics[selectedTeamId]?.playersByNflTeam ?? []}
        playersByCollege={teamAnalytics[selectedTeamId]?.playersByCollege ?? []}
      />
    </div>
    <p id="fo-stacks-link" class="fo-stacks-link" hidden>
      <a href="#" data-stacks-href>View this team’s NFL &amp; college stacks →</a>
    </p>
  </div>
</div>

<script id="front-office-planner-config" type="application/json" set:html={JSON.stringify(clientConfig)}></script>

<script>
  // Team switching is display-only here — no cap math runs client-side (see
  // this file's header comment). On `fo:team-change` (dispatched by
  // FrontOfficeTeamSwitcher.astro, a SIBLING under a different slot, so this
  // must listen on `document` rather than an ancestor of both):
  //   - swap the precomputed metric strings for the newly selected team
  //   - toggle the FA-needs / draft-assets panels by their team-id attribute
  //   - mutate the two extension components' `data-current-team` so THEY
  //     re-render (they already hold the full league-wide player list — see
  //     FranchiseOptions.astro / VeteranExtensionCandidates.astro's own
  //     scripts, which read `dataset.allPlayers` / `dataset.currentTeam`)
  //
  // Re-init on every ClientRouter navigation, guarded on DOM identity (never
  // a module-scoped flag — see FrontOfficeTeamSwitcher.astro's own comment
  // for why). The `document` listener is removed and re-added each time,
  // using a module-scoped handler reference, to avoid the "document
  // listeners stack across navigations" trap.
  let currentHandler: ((event: Event) => void) | null = null;

  function initTheLeaguePlannerPanel() {
    const root = document.querySelector<HTMLElement>('.fo-planner');
    if (!root) return; // AFL, or any page without this panel

    const configEl = document.getElementById('front-office-planner-config');
    const readConfig = (): { teams: Record<string, any> } => {
      try {
        return configEl ? JSON.parse(configEl.textContent || '{}') : { teams: {} };
      } catch {
        return { teams: {} };
      }
    };

    if (currentHandler) document.removeEventListener('fo:team-change', currentHandler);

    currentHandler = (event: Event) => {
      const teamId = (event as CustomEvent<{ teamId: string }>).detail?.teamId;
      if (!teamId) return;

      const config = readConfig();
      const metrics = config.teams?.[teamId];
      if (metrics) {
        const setText = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };
        setText('fo-metric-cap', metrics.capSpaceDisplay ?? '—');
        setText('fo-metric-avg', metrics.avgPerPlayerDisplay ?? '—');
        setText('fo-metric-signed', metrics.playersSignedDisplay ?? '—');
        setText('fo-metric-dead', metrics.deadMoneyDisplay ?? '—');
        setText('fo-metric-age', metrics.averageAgeDisplay ?? 'N/A');

        const hintEl = document.getElementById('fo-metric-signed-hint');
        if (hintEl) {
          if (metrics.cutHint) {
            hintEl.textContent = metrics.cutHint;
            hintEl.style.display = '';
          } else {
            hintEl.textContent = '';
            hintEl.style.display = 'none';
          }
        }
      }

      const togglePanels = (selector: string, attr: string) => {
        const panels = document.querySelectorAll<HTMLElement>(selector);
        panels.forEach((panel) => {
          panel.style.display = panel.getAttribute(attr) === teamId ? 'block' : 'none';
        });
      };
      togglePanels('[data-fa-needs-team-id]', 'data-fa-needs-team-id');
      togglePanels('[data-draft-chips-team-id]', 'data-draft-chips-team-id');
      togglePanels('[data-analytics-team-id]', 'data-analytics-team-id');

      // The stacks exist for the loaded team only (see the markup comment).
      // Show them when the viewer switches back to that team; otherwise
      // offer a link that reloads the page for the team they picked.
      const stacksHost = document.getElementById('fo-stacks-host');
      const stacksLink = document.getElementById('fo-stacks-link');
      if (stacksHost && stacksLink) {
        const isLoadedTeam = stacksHost.dataset.stacksTeamId === teamId;
        stacksHost.style.display = isLoadedTeam ? '' : 'none';
        stacksLink.hidden = isLoadedTeam;
        const anchor = stacksLink.querySelector<HTMLAnchorElement>('[data-stacks-href]');
        if (anchor && !isLoadedTeam) {
          // Same param the route already resolves (and writes its cookie
          // from), so the reloaded page lands on this team everywhere.
          const url = new URL(window.location.href);
          url.searchParams.set('myteam', teamId);
          anchor.href = `${url.pathname}${url.search}`;
        }
      }

      const franchiseTagEl = document.querySelector<HTMLElement>('.franchise-tag-eligibility');
      if (franchiseTagEl) franchiseTagEl.dataset.currentTeam = teamId;
      const veteranExtensionEl = document.querySelector<HTMLElement>('.veteran-extension-candidates');
      if (veteranExtensionEl) veteranExtensionEl.dataset.currentTeam = teamId;
    };

    document.addEventListener('fo:team-change', currentHandler);
  }

  initTheLeaguePlannerPanel();
  document.addEventListener('astro:page-load', initTheLeaguePlannerPanel);
</script>

<style>
  .fo-planner {
    container-type: inline-size;
    container-name: fo-main;
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .fo-planner > * {
    min-width: 0;
  }

  .planner-section__title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--page-text, #111827);
    padding-left: 0.625rem;
    border-left: 2px solid var(--league-accent, #1c497c);
  }

  :global(html.dark) .planner-section__title {
    color: var(--page-text, #ededed);
  }

  .chart-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--padding-md, 1rem);
    row-gap: var(--padding-lg, 1.5rem);
  }

  .chart-grid:has(> :only-child) {
    grid-template-columns: 1fr;
  }

  /* `.draft-cards-grid` is gone with the two side-by-side draft ChartCards
     it existed to lay out — DraftAssetChips renders one card carrying both
     years. */
  @container fo-main (min-width: 1150px) {
    .chart-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chart-grid:has(> :only-child) {
      grid-template-columns: 1fr;
    }
  }

  .fo-stacks-link {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }

  .fo-stacks-link a {
    color: var(--league-accent, #1c497c);
    font-weight: 600;
  }

  .chart-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
    gap: 0.75rem;
  }

  .chart-metrics__headline {
    margin: 0 0 0.75rem;
  }

  .chart-metrics__hint {
    display: block;
    margin-top: 0.5rem;
    color: var(--content-text-muted, #6b7280);
    font-size: 0.78rem;
  }

</style>
