  }
  .sch-chip.is-win { background: var(--badge-success-bg); color: var(--badge-success-text); }
  .sch-chip.is-loss { background: var(--badge-error-bg); color: var(--badge-error-text); }
  .sch-chip.is-tie { background: var(--color-gray-100, #f3f4f6); color: var(--color-gray-600, #4b5563); }
  .sch-chip.is-now { background: var(--sch-accent); color: var(--color-white, #fff); }
  .sch-row__crest { width: 34px; height: 34px; object-fit: contain; flex-shrink: 0; }
  .sch-row__team { flex: 1; min-width: 0; }
  .sch-row__nameline { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .sch-row__name {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--page-text, #111827);
  }
  .sch-tag {
    flex-shrink: 0;
    padding: 1px 7px;
    border-radius: var(--radius-sm, 0.25rem);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-bold, 700);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: var(--color-gray-100, #f3f4f6);
