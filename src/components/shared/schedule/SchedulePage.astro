    gap: 1.375rem;
    margin-top: auto;
    flex-wrap: wrap;
  }
  .sch-stat { display: flex; flex-direction: column; }
  .sch-stat__value {
    font-size: 2.4rem;
    font-weight: var(--font-weight-bold, 700);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .sch-stat__value--sm { font-size: 1.4rem; line-height: 1.15; }
  .sch-stat__label {
    font-family: var(--font-display, 'UFC Sans Condensed', 'Arial Narrow', sans-serif);
    font-size: 0.6875rem;
