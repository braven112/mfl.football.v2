---
/**
 * Schedule — shared render for every league.
 *
 * Two views behind one route, switched by `?view=` with plain links so the
 * page ships no client JS and every state is bookmarkable:
 *
 *   my     — the signed-in owner's own season: form rail, next opponent, and
 *            one row per game with the result once it has been played.
 *   league — the compact weeks x clubs grid, club column pinned.
 *
 * `my` is the default for an owner and unavailable to everyone else, so a
 * signed-out visitor lands on `league` rather than on an empty personal view.
 *
 * ── What this page reads, and what it must not ─────────────────────────────
 *
 * The matchups come from the committed `schedule.json` feed (see
 * `src/utils/schedule-data.mjs` for the two shapes in it that bite). Records
 * come from `standings.json` and are printed as MFL wrote them: its row ORDER
 * already applies the constitution's tiebreakers, including head-to-head we
 * cannot reproduce, so the rank shown here is the feed's own position and
 * nothing re-sorts it.
 *
 * Week dates come from `nfl-week-starts.mjs` and the playoff boundary from
 * `fantasy-bracket.mjs`. Neither is derived locally: kickoff is not "the
 * Thursday after Labor Day" (2026 opened on a Wednesday) and the bracket is
 * not a literal 15/16/17.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../theleague/Breadcrumbs.astro';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { getCurrentNFLWeek } from '../../../utils/current-week';
import { nflWeekStartIsoDate } from '../../../utils/nfl-week-starts.mjs';
import { PLAYOFFS_START_WEEK } from '../../../utils/fantasy-bracket.mjs';
import {
  chooseTeamName,
  resolveConfigForYear,
  resolvePreferredTeamIdForYear,
} from '../../../utils/team-names';
import {
  findNextGame,
  franchiseSchedule,
  opponentsByWeek,
  parseWeeklySchedule,
} from '../../../utils/schedule-data.mjs';
import { resolveHeroFranchiseSkin } from '../../../utils/hero-crest';
import '../../../styles/hero-franchise-backdrop.css';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** The league's own config file, imported by the route wrapper. */
  config: { teams: any[]; conferences?: { name: string; code: string }[] };
  /** `import.meta.glob` of that league's schedule feeds, keyed by file path. */
  scheduleFeeds: Record<string, unknown>;
  /** Same, for standings — the only source of a club's record. */
  standingsFeeds: Record<string, unknown>;
  /** The viewer's franchise IN THIS LEAGUE, already league-checked. */
  viewerFranchiseId: string | null;
}

const { leagueSlug, config, scheduleFeeds, standingsFeeds, viewerFranchiseId } = Astro.props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(path, hideLeaguePrefix);

/** `…/mfl-feeds/2026/schedule.json` → `2026`. */
const yearOf = (path: string) => Number(path.match(/mfl-feeds\/(\d{4})\//)?.[1]);
function byYear(feeds: Record<string, unknown>) {
  const out = new Map<number, unknown>();
  for (const [path, feed] of Object.entries(feeds)) {
    const year = yearOf(path);
    if (Number.isFinite(year)) out.set(year, feed);
  }
  return out;
}

const schedulesByYear = byYear(scheduleFeeds);
const standingsByYear = byYear(standingsFeeds);

// getCurrentSeasonYear() is the results-shaped clock (rolls at Labor Day).
// A season MFL has not created yet falls back to the newest feed on disk
// rather than rendering an empty page for six months of the calendar.
const liveYear = getCurrentSeasonYear();
const availableYears = [...schedulesByYear.keys()].sort((a, b) => b - a);
// Existence is not enough: MFL creates the new season's feed before it draws
// the schedule, so `has(liveYear)` can be true with nothing in it. Fall back
// to the newest season that actually carries matchups.
const parsedByYear = new Map(availableYears.map((y) => [y, parseWeeklySchedule(schedulesByYear.get(y))]));
const hasGames = (y: number) => (parsedByYear.get(y)?.length ?? 0) > 0;
const defaultYear = hasGames(liveYear)
  ? liveYear
  : (availableYears.find(hasGames) ?? liveYear);

// `?year=` is a whitelist lookup, never a cast: an arbitrary number would ask
// for a season with no feed and render an empty page. Anything not in the
// seasons on disk falls back to the default rather than 404ing.
const yearParam = Number(Astro.url.searchParams.get('year'));
const year = availableYears.includes(yearParam) && hasGames(yearParam) ? yearParam : defaultYear;
const seasonYears = availableYears.filter(hasGames);
const isLiveSeason = year === liveYear;

const weeks = parsedByYear.get(year) ?? [];
// "Now" only means something in the season being played. Asking
// getCurrentNFLWeek for a season that ended years ago returns a week number
// that would highlight an arbitrary column of a finished grid as live.
const currentWeek = isLiveSeason ? (getCurrentNFLWeek(new Date(), year) ?? 1) : -1;

const teams = resolveConfigForYear(config as { teams: any[] }, year).teams ?? [];

/**
 * The viewer's franchise IN THE SEASON BEING SHOWN — not the slot they hold
 * today.
 *
 * MFL franchise ids get REASSIGNED. TheLeague's 0011 was franchise 0010 from
 * 2011-2015 and has been 0011 only since 2019, so reading `?year=2013` off the
 * raw id presents ANOTHER owner's 2013 season as "My Schedule", and 2016-2018
 * is a gap year that must resolve to nothing rather than to someone else.
 * `/standings` and `/playoffs` already do this for their own season pickers
 * (both call the same helper); this page needed it the moment it grew one.
 */
const viewerTeamIdForYear = resolvePreferredTeamIdForYear(
  config as { teams: any[] },
  viewerFranchiseId,
  year,
) ?? null;
const teamById = new Map(teams.map((team: any) => [team.franchiseId, team]));
const nameOf = (id: string) => {
  const team = teamById.get(id);
  if (!team) return `Franchise ${id}`;
  return chooseTeamName(
    { fullName: team.name, nameMedium: team.nameMedium, nameShort: team.nameShort, abbrev: team.abbrev },
    'default',
  );
};
/**
 * A club's short tag for the grid tile.
 *
 * The fallback is a derived tag, NOT the franchise id: a historical identity
 * may carry a name with no `abbrev` (ten AFL franchises' 2024 era entries do),
 * and printing `0006` in the cell tells a reader nothing. The full name is
 * always in the tile's label, so this only has to be recognisable.
 */
const abbrevOf = (id: string) => {
  const team = teamById.get(id);
  if (team?.abbrev) return team.abbrev;
  // A franchise with NO config entry keeps its raw id. `nameOf` answers
  // "Franchise 0034" for one, and deriving initials from that placeholder
  // renders every defunct club as "F0" — the AFL's 2003-2005 schedules carry
  // ten ids their standings never listed, so this path is reached.
  if (!team) return id;
  const name = nameOf(id);
  if (!name) return id;
  const words = name.replace(/[^A-Za-z0-9 ]/g, ' ').split(/\s+/).filter(Boolean);
  if (words.length === 0) return id;
  // Multi-word names read better as initials (Mariachi Ninjas → MN) than as a
  // truncated first word; a single word is simply clipped.
  return (words.length > 1
    ? words.map((word) => word[0]).join('')
    : words[0].slice(0, 5)
  ).toUpperCase();
};
const iconOf = (id: string) => teamById.get(id)?.icon ?? null;

// MFL's standings order IS the standing — never re-sorted here.
const standingsRows: any[] = (() => {
  const feed: any = standingsByYear.get(year);
  const rows = feed?.leagueStandings?.franchise;
  return Array.isArray(rows) ? rows : rows ? [rows] : [];
})();
const recordOf = new Map<string, string>();
const pointsForOf = new Map<string, number>();
standingsRows.forEach((row: any) => {
  const id = String(row?.id ?? '');
  if (!id) return;
  // MFL writes W-L-T; the tie segment is noise in a league that rarely ties,
  // so it is shown only when there is one.
  if (row?.h2hwlt) {
    const [w = '0', l = '0', t = '0'] = String(row.h2hwlt).split('-');
    recordOf.set(id, Number(t) > 0 ? `${w}-${l}-${t}` : `${w}-${l}`);
  }
  const pf = Number(row?.pf);
  if (Number.isFinite(pf)) pointsForOf.set(id, pf);
});

const conferences: { name: string; code: string }[] = Array.isArray(config.conferences) ? config.conferences : [];
const conferenceOf = (id: string) => String(teamById.get(id)?.conference ?? '');

/**
 * Rank within the group this page actually shows, taken by FILTERING MFL's
 * order rather than re-sorting it — the order already carries the
 * constitution's tiebreakers.
 *
 * The AFL seeds by conference, and this page groups its grid the same way, so
 * a league-wide index is the wrong number twice over: franchise 0008 finished
 * 1st in the American League and reads 3rd of 24 against the full list, and
 * the AL block's rank column would run 3, 5, 6, 7, 9. TheLeague has one table
 * and keeps the league-wide index.
 */
const rankOf = new Map<string, number>();
const groupSizeOf = new Map<string, number>();
if (conferences.length > 1) {
  for (const conference of conferences) {
    const inConference = standingsRows.filter((row: any) => conferenceOf(String(row?.id ?? '')) === conference.code);
    inConference.forEach((row: any, index: number) => {
      const id = String(row?.id ?? '');
      rankOf.set(id, index + 1);
      groupSizeOf.set(id, inConference.length);
    });
  }
} else {
  standingsRows.forEach((row: any, index: number) => {
    const id = String(row?.id ?? '');
    rankOf.set(id, index + 1);
    groupSizeOf.set(id, standingsRows.length);
  });
}

const viewParam = Astro.url.searchParams.get('view');
const canSeeMine = Boolean(viewerFranchiseId);
const view: 'my' | 'league' = canSeeMine && viewParam !== 'league' ? 'my' : 'league';

/**
 * Every control on this page is a plain link, so the page ships no client JS
 * and every state is bookmarkable — which means a season link must carry the
 * current VIEW and a view link the current SEASON, or switching one silently
 * resets the other. `year` is omitted for the default season so the canonical
 * URL stays `/schedule`.
 */
const hrefFor = (toYear: number, toView: 'my' | 'league') => {
  const params = new URLSearchParams();
  if (toView === 'league' && canSeeMine) params.set('view', 'league');
  if (toYear !== defaultYear) params.set('year', String(toYear));
  const query = params.toString();
  return `${r(`/${leagueSlug}/schedule`)}${query ? `?${query}` : ''}`;
};

const weekNumbers = weeks.map((entry) => entry.week);
const firstWeek = weekNumbers[0] ?? 1;
const lastWeek = weekNumbers[weekNumbers.length - 1] ?? firstWeek;

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
function weekDate(week: number) {
  const iso = nflWeekStartIsoDate(year, week);
  if (!iso) return { short: '', month: '', long: '' };
  const [y, m, d] = iso.split('-').map(Number);
  const month = MONTHS[m - 1] ?? '';
  return {
    short: `${month.slice(0, 3)} ${d}`,
    month: `${month} ${y}`,
    long: `${month.slice(0, 3)} ${d}, ${y}`,
  };
}

// ── My schedule ────────────────────────────────────────────────────────────
const mySchedule = viewerTeamIdForYear ? franchiseSchedule(weeks, viewerTeamIdForYear) : [];
const nextGame = findNextGame(mySchedule, currentWeek);
const myRank = viewerTeamIdForYear ? rankOf.get(viewerTeamIdForYear) ?? null : null;
// Record and points come from standings, not from summing this page's own
// rows: the feed runs through the playoff and consolation weeks, so summing it
// gave the hero 13-8 / 1927.4 beside a grid printing MFL's 11-7 / 1613.30 for
// the same club. One number, one source.
const myRecord = viewerTeamIdForYear ? recordOf.get(viewerTeamIdForYear) ?? null : null;
const myPointsFor = viewerTeamIdForYear ? pointsForOf.get(viewerTeamIdForYear) ?? null : null;
const ordinal = (n: number) => {
  const mod = n % 100;
  if (mod >= 11 && mod <= 13) return `${n}th`;
  return `${n}${({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th'}`;
};

/** One row per GAME, so a doubleheader week contributes two. */
const myRows = mySchedule.flatMap(({ week, games }) =>
  games.map((game: any, index: number) => ({
    ...game,
    week,
    isDoubleheader: games.length > 1,
    doubleheaderLabel: games.length > 1 ? `Game ${index + 1} of ${games.length}` : '',
    showWeek: index === 0,
    date: weekDate(week),
  })),
);
const myMonths: { label: string; rows: typeof myRows }[] = [];
for (const row of myRows) {
  const label = row.date.month || `Week ${row.week}`;
  const last = myMonths[myMonths.length - 1];
  if (last && last.label === label) last.rows.push(row);
  else myMonths.push({ label, rows: [row] });
}

// ── League grid ────────────────────────────────────────────────────────────
const gridByFranchise = opponentsByWeek(weeks);
/** Standings order where MFL gave us one, config order otherwise. */
const orderedTeams = [...teams].sort((a: any, b: any) => {
  const ra = rankOf.get(a.franchiseId) ?? Number.MAX_SAFE_INTEGER;
  const rb = rankOf.get(b.franchiseId) ?? Number.MAX_SAFE_INTEGER;
  return ra - rb;
});
const gridGroups = conferences.length > 1
  ? conferences.map((conference) => ({
      label: conference.name,
      teams: orderedTeams.filter((team: any) => conferenceOf(team.franchiseId) === conference.code),
    })).filter((group) => group.teams.length > 0)
  : [{ label: '', teams: orderedTeams }];

const playoffWeeks = weekNumbers.filter((week) => week >= PLAYOFFS_START_WEEK);
const title = view === 'my' ? 'My Schedule' : 'Schedule';

/**
 * My Schedule wears the OWNER'S CLUB; the league grid keeps the league's own
 * chrome. That is the site-wide rule `resolveHeroFranchiseSkin` exists to
 * carry — a league surface wears the league, a surface about one team wears
 * that team — so this takes the shared resolver rather than reaching for
 * `colorPrimary` here. Doing it by hand would mean re-deriving the gradient,
 * the wash, the measured accent and the crest artwork; and five TheLeague
 * franchises share `#181818` as their primary, so the naive version paints
 * five identical near-black heroes.
 *
 * Null for the league view, a signed-out visitor, and a club whose config
 * carries no colours — each of which correctly falls back to league chrome.
 */
// Gated on the owner still holding the SAME slot that season, because the
// resolver looks a franchise up in TODAY'S config: for a season where they
// held a different id, that id's current colours belong to whoever holds it
// now — a rival's palette on your own page. Always true for the live season,
// so the common case is unaffected and a reassigned season falls back to
// league chrome rather than to the wrong club.
const heroSkin =
  view === 'my' && viewerTeamIdForYear === viewerFranchiseId
    ? resolveHeroFranchiseSkin(viewerFranchiseId, leagueSlug)
    : null;
---

<TheLeagueLayout title={`${title} | ${league.name}`}>
  <div class="sch">
    <Breadcrumbs items={[{ label: league.name, href: r(`/${leagueSlug}`) }, { label: 'Schedule' }]} />

    <section
      class:list={['sch-hero', { 'sch-hero--franchise': !!heroSkin }]}
      style={heroSkin?.style}
    >
      <div class="sch-hero__glow" aria-hidden="true"></div>
      {heroSkin ? (
        <>
          {/* Resolved SERVER-SIDE as the dark cut with its measured outline
              inline: a franchise gradient is dark in BOTH themes, and the
              site's html.dark crest machinery fires only for a viewer whose
              SITE theme is dark. */}
          {heroSkin.crest && (
            <img
              class="hero-fb__crest"
              src={heroSkin.crest}
              style={heroSkin.crestFilter ? `filter: ${heroSkin.crestFilter};` : undefined}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
          )}
          <span class="hero-fb__wash" aria-hidden="true"></span>
        </>
      ) : viewerTeamIdForYear && iconOf(viewerTeamIdForYear) ? (
        <img src={iconOf(viewerTeamIdForYear)!} alt="" class="sch-hero__watermark" aria-hidden="true" />
      ) : null}

      <div class="sch-hero__inner">
        <div class="sch-hero__main">
          <div class="sch-hero__eyebrow">
            <span class="sch-pill">{view === 'my' ? 'My Schedule' : 'League Schedule'}</span>
            <span class="sch-hero__meta">{year} season · weeks {firstWeek}–{lastWeek}</span>
          </div>

          {viewerTeamIdForYear ? (
            <div class="sch-hero__identity">
              {/* One crest source per hero: with a franchise skin the big
                  watermark is the resolver's dark cut, so the small mark takes
                  the same art rather than pairing an era crest with it. */}
              {(heroSkin?.crest || iconOf(viewerTeamIdForYear)) && (
                <img src={heroSkin?.crest || iconOf(viewerTeamIdForYear)!} alt="" class="sch-hero__crest" width="54" height="54" />
              )}
              <h1 class="sch-hero__title">{nameOf(viewerTeamIdForYear)}</h1>
            </div>
          ) : (
            <h1 class="sch-hero__title">{league.name}</h1>
          )}

          {viewerTeamIdForYear && myRows.length > 0 && (
            <div class="sch-rail">
              <div class="sch-rail__bars">
                {myRows.map((row) => (
                  <span
                    class:list={[
                      'sch-rail__bar',
                      row.played ? (row.outcome === 'W' ? 'is-win' : row.outcome === 'L' ? 'is-loss' : 'is-tie') : '',
                      !row.played && row.week === currentWeek ? 'is-now' : '',
                      !row.played && row.week !== currentWeek ? 'is-future' : '',
                    ]}
                    title={`Week ${row.week} · ${nameOf(row.opponentId)}${row.played ? ` · ${row.outcome}` : ''}`}
                  ></span>
                ))}
              </div>
              <div class="sch-rail__scale">
                <span>Week {firstWeek}</span>
                {nextGame && <span class="sch-rail__now">Week {nextGame.week} · up next</span>}
                <span>Week {lastWeek}</span>
              </div>
            </div>
          )}

          {viewerTeamIdForYear ? (
            <div class="sch-stats">
              <div class="sch-stat">
                <span class="sch-stat__value">{myRecord ?? '0-0'}</span>
                <span class="sch-stat__label">Record</span>
              </div>
              {myRank && (
                <>
                  <span class="sch-stat__rule" aria-hidden="true"></span>
                  <div class="sch-stat">
                    <span class="sch-stat__value sch-stat__value--sm">{ordinal(myRank)}</span>
                    <span class="sch-stat__label">
                      of {groupSizeOf.get(viewerTeamIdForYear) || standingsRows.length || teams.length}
                      {conferences.length > 1 ? ` in the ${conferences.find((c) => c.code === conferenceOf(viewerTeamIdForYear))?.name ?? 'conference'}` : ''}
                    </span>
                  </div>
                </>
              )}
              {myPointsFor != null && (
                <>
                  <span class="sch-stat__rule" aria-hidden="true"></span>
                  <div class="sch-stat">
                    <span class="sch-stat__value sch-stat__value--sm">{myPointsFor.toFixed(0)}</span>
                    <span class="sch-stat__label">Points for</span>
                  </div>
                </>
              )}
            </div>
          ) : (
            <p class="sch-hero__lede">
              Every week's matchups and final scores for the {year} season. Sign in to see your own
              schedule{isLiveSeason ? ', your next opponent' : ''} and your results.
            </p>
          )}
        </div>

        {viewerTeamIdForYear && nextGame ? (
          <aside class="sch-next" aria-label="Next matchup">
            <div class="sch-next__head">
              <span class="sch-next__dot" aria-hidden="true"></span>
              <span class="sch-next__kicker">Up next · Week {nextGame.week}</span>
            </div>
            <div class="sch-next__team">
              {iconOf(nextGame.opponentId) && (
                <img src={iconOf(nextGame.opponentId)!} alt="" width="46" height="46" class="sch-next__crest" />
              )}
              <div class="sch-next__names">
                <span class="sch-next__name">{nameOf(nextGame.opponentId)}</span>
                <span class="sch-next__sub">
                  {recordOf.get(nextGame.opponentId) ?? 'No record yet'} · {nextGame.isHome ? 'at home' : 'away'}
                </span>
              </div>
            </div>
            <p class="sch-next__when">{weekDate(nextGame.week).long} · lineup locks at kickoff</p>
            <div class="sch-next__actions">
              <a href={r(`/${leagueSlug}/lineup`)} class="sch-btn">Set lineup</a>
              <a href={r(`/${leagueSlug}/live-scoring`)} class="sch-btn sch-btn--ghost">Live scoring</a>
            </div>
          </aside>
        ) : !viewerFranchiseId ? (
          <aside class="sch-next" aria-label="Sign in">
            <div class="sch-next__head">
              <span class="sch-next__kicker">Your team</span>
            </div>
            <p class="sch-next__when">
              Sign in with your MFL account to see your own season, your next opponent and your results.
            </p>
            <div class="sch-next__actions">
              <a href={r(`/${leagueSlug}/login`)} class="sch-btn">Log in</a>
            </div>
          </aside>
        ) : null}
      </div>
    </section>

    {(canSeeMine || seasonYears.length > 1) && (
    <div class="sch-controls">
      {canSeeMine && (
        <nav class="sch-tabs" aria-label="Schedule views">
          <a href={hrefFor(year, 'my')} class:list={['sch-tab', { 'is-active': view === 'my' }]} aria-current={view === 'my' ? 'page' : undefined}>My schedule</a>
          <a href={hrefFor(year, 'league')} class:list={['sch-tab', { 'is-active': view === 'league' }]} aria-current={view === 'league' ? 'page' : undefined}>League grid</a>
        </nav>
      )}
      {seasonYears.length > 1 && (
        <nav class="sch-seasons" aria-label="Season">
          <span class="sch-seasons__label">Season</span>
          <div class="sch-seasons__scroller">
            {seasonYears.map((option) => (
              <a
                href={hrefFor(option, view)}
                class:list={['sch-season', { 'is-active': option === year }]}
                aria-current={option === year ? 'page' : undefined}
              >{option}</a>
            ))}
          </div>
        </nav>
      )}
    </div>
    )}

    {view === 'my' ? (
      myRows.length === 0 ? (
        <p class="sch-empty">
          {viewerFranchiseId && !viewerTeamIdForYear
            ? `You did not have a team in ${year}.`
            : `No schedule has been published for ${year} yet.`}
        </p>
      ) : (
        <div class="sch-card">
          {myMonths.map((group) => (
            <div>
              <div class="sch-month">
                <span class="sch-month__label">{group.label}</span>
                <span class="sch-month__rule" aria-hidden="true"></span>
                <span class="sch-month__meta">
                  {group.rows.filter((row) => row.played).length} of {group.rows.length} played
                </span>
              </div>
              {group.rows.map((row) => (
                <div class:list={['sch-row', { 'is-now': !row.played && row.week === currentWeek }]}>
                  <div class="sch-row__week">
                    <span class="sch-row__weeknum">{row.showWeek ? row.week : ''}</span>
                    <span class="sch-row__date">{row.showWeek ? row.date.short : ''}</span>
                  </div>
                  <span
                    class:list={[
                      'sch-chip',
                      row.played ? (row.outcome === 'W' ? 'is-win' : row.outcome === 'L' ? 'is-loss' : 'is-tie') : '',
                      !row.played && row.week === currentWeek ? 'is-now' : '',
                    ]}
                  >{row.played ? row.outcome : row.week === currentWeek ? '•' : ''}</span>
                  {iconOf(row.opponentId) && (
                    <img src={iconOf(row.opponentId)!} alt="" width="34" height="34" class="sch-row__crest" loading="lazy" />
                  )}
                  <div class="sch-row__team">
                    <div class="sch-row__nameline">
                      <span class="sch-row__name">{nameOf(row.opponentId)}</span>
                      {row.isDoubleheader && <span class="sch-tag">Doubleheader</span>}
                      {!row.played && row.week === currentWeek && <span class="sch-tag sch-tag--now">This week</span>}
                    </div>
                    <span class="sch-row__sub">
                      {row.isHome ? 'Home' : 'Away'} · {recordOf.get(row.opponentId) ?? 'no record yet'}
                      {row.doubleheaderLabel ? ` · ${row.doubleheaderLabel}` : ''}
                    </span>
                  </div>
                  <div class="sch-row__score">
                    {row.played ? (
                      <>
                        <span class="sch-row__points">{row.score?.toFixed(1)} – {row.opponentScore?.toFixed(1)}</span>
                        <span class:list={['sch-row__margin', row.outcome === 'W' ? 'is-win' : row.outcome === 'L' ? 'is-loss' : '']}>
                          {(row.score ?? 0) - (row.opponentScore ?? 0) > 0 ? '+' : ''}
                          {((row.score ?? 0) - (row.opponentScore ?? 0)).toFixed(1)} margin
                        </span>
                      </>
                    ) : (
                      <>
                        <span class="sch-row__points sch-row__points--pending">{row.date.short}</span>
                        <span class="sch-row__margin">Not played</span>
                      </>
                    )}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      )
    ) : (
      weekNumbers.length === 0 ? (
        <p class="sch-empty">No schedule has been published for {year} yet.</p>
      ) : (
        <>
          <div class="sch-card sch-scroller">
            <table class="sch-grid">
              <thead>
                <tr>
                  <th scope="col" class="sch-grid__club">Club</th>
                  {weekNumbers.map((week) => (
                    <th
                      scope="col"
                      class:list={['sch-grid__wk', { 'is-now': week === currentWeek, 'is-playoff': week >= PLAYOFFS_START_WEEK }]}
                    >
                      <span class="sch-grid__wknum">{week}</span>
                      <span class="sch-grid__wkdate">{week === currentWeek ? 'Now' : weekDate(week).short}</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {gridGroups.map((group) => (
                  <>
                    {group.label && (
                      <tr class="sch-grid__grouprow">
                        <th scope="rowgroup" class="sch-grid__group" colspan={weekNumbers.length + 1}>{group.label}</th>
                      </tr>
                    )}
                    {group.teams.map((team: any) => {
                      const id = team.franchiseId;
                      const row = gridByFranchise.get(id);
                      const mine = id === viewerTeamIdForYear;
                      return (
                        <tr class:list={['sch-grid__row', { 'is-mine': mine }]}>
                          <th scope="row" class:list={['sch-grid__club', { 'is-mine': mine }]}>
                            <div class="sch-grid__clubinner">
                              <span class="sch-grid__rank">{rankOf.get(id) ?? ''}</span>
                              {team.icon && <img src={team.icon} alt="" width="26" height="26" class="sch-grid__crest" loading="lazy" />}
                              <span class="sch-grid__name">{nameOf(id)}</span>
                              <span class="sch-grid__record">{recordOf.get(id) ?? ''}</span>
                            </div>
                          </th>
                          {weekNumbers.map((week) => {
                            const games = row?.get(week) ?? [];
                            return (
                              <td class:list={['sch-grid__cell', { 'is-now': week === currentWeek }]}>
                                {games.length === 0 ? (
                                  <span class="sch-tile sch-tile--bye">—</span>
                                ) : (
                                  games.map((game: any) => {
                                    // The result is carried by tint and an
                                    // edge bar, which a screen reader cannot
                                    // see, and the legend is not associated
                                    // with the cell — so each tile states its
                                    // own outcome.
                                    const outcomeWord = !game.played
                                      ? 'still to play'
                                      : game.outcome === 'W'
                                        ? 'won'
                                        : game.outcome === 'L'
                                          ? 'lost'
                                          : 'tied';
                                    // Rounded to keep 17 columns legible, with
                                    // the exact score in the label a screen
                                    // reader and a hover both get — EXCEPT
                                    // where rounding would print a decided
                                    // game as a tie. 97 of the archive's 8,413
                                    // decided games are sub-point, and
                                    // "115–115" inside a green WIN tile reads
                                    // as a bug in the tile, not as rounding.
                                    const mine = game.score ?? 0;
                                    const theirs = game.opponentScore ?? 0;
                                    const roundsToATie =
                                      Math.round(mine) === Math.round(theirs) && mine !== theirs;
                                    const fmt = (n: number) =>
                                      roundsToATie ? n.toFixed(1) : String(Math.round(n));
                                    const scoreLine = game.played ? `${fmt(mine)}–${fmt(theirs)}` : '';
                                    const exact = game.played
                                      ? `, ${(game.score ?? 0).toFixed(1)} to ${(game.opponentScore ?? 0).toFixed(1)}`
                                      : '';
                                    const label = `Week ${week}, ${game.isHome ? 'vs' : 'at'} ${nameOf(game.opponentId)}, ${outcomeWord}${exact}`;
                                    return (
                                      <span
                                        class:list={[
                                          'sch-tile',
                                          game.played ? (game.outcome === 'W' ? 'is-win' : game.outcome === 'L' ? 'is-loss' : 'is-tie') : 'is-pending',
                                        ]}
                                        role="img"
                                        aria-label={label}
                                        title={label}
                                      >
                                        <span class="sch-tile__opp">{abbrevOf(game.opponentId)}</span>
                                        {scoreLine && <span class="sch-tile__score">{scoreLine}</span>}
                                      </span>
                                    );
                                  })
                                )}
                              </td>
                            );
                          })}
                        </tr>
                      );
                    })}
                  </>
                ))}
              </tbody>
            </table>
          </div>

          <ul class="sch-legend">
            <li><span class="sch-swatch is-win" aria-hidden="true"></span>Won</li>
            <li><span class="sch-swatch is-loss" aria-hidden="true"></span>Lost</li>
            <li><span class="sch-swatch is-pending" aria-hidden="true"></span>To play</li>
            <li class="sch-legend__note">
              Each played game shows its final score. Two tiles in one cell is a doubleheader.
              {playoffWeeks.length > 0 && ` Weeks ${playoffWeeks[0]}–${playoffWeeks[playoffWeeks.length - 1]} are the playoff window.`}
            </li>
          </ul>
        </>
      )
    )}
  </div>
</TheLeagueLayout>

<style>
  /* The hero is a dark brand card in BOTH themes, exactly as the event heroes
     are (AflEventHero / EventHeroShell): AFL keeps its navy in light and dark,
     TheLeague deepens. Hence literal values here rather than surface tokens —
     these ARE the brand chrome, not the page surface. */
  .sch {
    --sch-hero: #1c497c;
    /* AA at 13px in both directions: white on this is 6.4:1 (the pill, the
       CTA) and this on the page ground is 6.0:1 (the active tab). #3b82f6 was
       3.7:1 and 3.0:1 — the reason this is a darker blue than the hero's. */
    --sch-accent: #1d4ed8;
    --sch-accent-ink: #93bbfd;
    --sch-glow: rgba(28, 73, 124, 0.55);
    --sch-accent-soft: rgba(59, 130, 246, 0.08);
    --sch-ink-soft: rgba(255, 255, 255, 0.72);
    --sch-ink-faint: rgba(255, 255, 255, 0.6);
    --sch-divider: rgba(255, 255, 255, 0.16);
    --sch-raised: rgba(255, 255, 255, 0.07);
    max-width: var(--container-max-width, 1232px);
    margin: 0 auto;
    padding: 0 var(--spacing-md, 1rem) var(--spacing-2xl, 3rem);
  }
  :global(html.dark) .sch {
    --sch-hero: #0f1e2e;
  }
  /* Same specificity as the dark rule and later in source, so the AFL navy
     survives in dark mode too — the league's chrome, not a light-mode look. */
  :global(html[data-league='afl']) .sch {
    --sch-hero: #002244;
    --sch-accent: #c41e3a;
    --sch-accent-ink: #c9a94e;
    --sch-glow: rgba(196, 30, 58, 0.6);
    --sch-accent-soft: rgba(196, 30, 58, 0.07);
  }

  /* ── Hero ── */
  .sch-hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg, 1rem);
    background: var(--sch-hero);
    color: var(--color-white, #fff);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
    margin-bottom: var(--spacing-md, 1rem);
  }
  .sch-hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(86% 92% at 3% -4%, var(--sch-glow), transparent 64%);
    pointer-events: none;
    z-index: 1;
  }
  .sch-hero__watermark {
    position: absolute;
    right: clamp(1rem, 4vw, 2.75rem);
    top: 50%;
    transform: translateY(-50%);
    width: clamp(150px, 22vw, 240px);
    opacity: 0.14;
    object-fit: contain;
    z-index: 0;
  }
  /* ── The owner's club, on My Schedule only ──
     The card swaps its league navy for the franchise gradient and every
     league-accented mark inside it swaps to the measured franchise accent.
     Which accent is NOT a style choice: the resolver clears `accent` to 3:1
     over the copy band and `accent-panel` to 4.5:1 over the card's FAR end,
     because one accent cannot serve both on a high-contrast gradient —
     Midwestside runs gold at one end and black at the other. So the main
     column takes `accent`, the slotted Up-next panel takes `accent-panel`,
     and anything with a FILL takes the pill pair, whose ink is picked per
     franchise rather than assumed to be white.

     The league glow goes: it is a radial of --sch-glow, the league's own
     colour, and leaving it on lights the franchise gradient's top-left
     corner with the wrong brand. */
  /* Literal fallback like both sibling heroes carry: an undefined custom
     property here would paint the card transparent in BOTH themes. */
  .sch-hero--franchise { background: var(--hero-fb-gradient, #10161f); }
  .sch-hero--franchise .sch-hero__glow { display: none; }
  .sch-hero--franchise .sch-pill {
    background: var(--hero-fb-pill-bg);
    color: var(--hero-fb-pill-ink);
  }
  .sch-hero--franchise .sch-rail__bar.is-now { background: var(--hero-fb-accent); }
  .sch-hero--franchise .sch-rail__now { color: var(--hero-fb-accent); }
  .sch-hero--franchise .sch-next__dot { background: var(--hero-fb-accent-panel); }
  .sch-hero--franchise .sch-next__kicker { color: var(--hero-fb-accent-panel); }
  .sch-hero--franchise .sch-btn {
    background: var(--hero-fb-pill-bg);
    color: var(--hero-fb-pill-ink);
  }
  .sch-hero--franchise .sch-btn:hover { color: var(--hero-fb-pill-ink); }
  /* The ghost button is a translucent white on the card, so it keeps the
     white ink the franchise fill does not apply to. */
  .sch-hero--franchise .sch-btn--ghost {
    background: var(--sch-raised);
    color: var(--color-white, #fff);
  }

  .sch-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
