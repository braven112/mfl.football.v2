---
/**
 * The Throwback Week era picker — the owner-facing half of the feature, shared
 * by `/throwback-settings` and the `/preferences` page.
 *
 * ONE implementation, deliberately: the cards, the save-on-change script and
 * the imposed-rebrand panel are the feature, and a second copy on the
 * preferences page would be the forked-sibling bug class applied to a
 * component instead of a route. The settings page adds a heading and the
 * commissioner panel around it; the preferences page adds its own heading and
 * nothing else.
 *
 * `scoreboardPath` is the league's live-scoring route ALREADY run through
 * `resolveLeaguePath` — the full path, not a base to concatenate onto:
 * resolving the bare prefix yields `/` on an apex domain, and `/` +
 * `/live-scoring` is a protocol-relative URL pointing at another host.
 */
import type { ThrowbackPickerView } from '../../utils/throwback-settings-view';
import { eraBannerStyle } from '../../utils/era-banner-style';
import { eraPickKey, throwbackEraProvenance } from '../../utils/throwback-identity';

interface Props {
  view: ThrowbackPickerView;
  /** This league's live-scoring path, prefix already resolved. */
  scoreboardPath: string;
}

const { view, scoreboardPath } = Astro.props as Props;
const {
  team,
  imposedEra,
  eligibleEras,
  poolEras,
  claimedBy,
  outbid,
  locked,
  selectedKey,
  ownDefaultKey,
  previewWeek,
  slotNames,
} = view;

const scoreboard = `${scoreboardPath}?week=${previewWeek}&demo=1`;
/** "Week 8" etc. — the copy must never hardcode TheLeague's Week 4. */
const weekLabel = `Week ${previewWeek}`;
/** Open the pool when the owner's pick lives in it, so they can see it. */
const poolHasSelection = poolEras.some((e) => eraPickKey(e) === selectedKey);
/**
 * Pool eras grouped by the slot they came from, labelled with the franchise
 * that holds that slot today — "Sabertooths (2007)" means little on its own,
 * "from the Pacific Pigskins' slot" says where to picture it.
 */
const poolGroups = (() => {
  const groups = new Map<string, typeof poolEras>();
  for (const era of poolEras) {
    const slot = era.sourceFranchiseId ?? '';
    if (!groups.has(slot)) groups.set(slot, []);
    groups.get(slot)!.push(era);
  }
  return [...groups.entries()].map(([slot, eras]) => ({ slot, eras }));
})();
const allEras = [...eligibleEras, ...poolEras];

type Row =
  | { kind: 'heading'; title: string; note?: string; pool: boolean; toggle?: boolean }
  | { kind: 'era'; era: (typeof allEras)[number]; pool: boolean; claimedBy: string | undefined };
const eraRow = (era: (typeof allEras)[number], pool: boolean): Row => ({
  kind: 'era',
  era,
  pool,
  claimedBy: claimedBy[eraPickKey(era)],
});
const rows: Row[] = [
  ...(eligibleEras.length > 0 && poolEras.length > 0
    ? [{ kind: 'heading' as const, title: 'Your eras', pool: false }]
    : []),
  ...eligibleEras.map((era) => eraRow(era, false)),
  ...(poolEras.length > 0
    ? [{
        kind: 'heading' as const,
        title: 'Up for grabs',
        note: "Looks from owners who have left the league. First come, first served — one team per era.",
        pool: false,
        toggle: true,
      }]
    : []),
  ...poolGroups.flatMap(({ slot, eras }) => [
    { kind: 'heading' as const, title: `From the ${slotNames[slot] ?? `franchise ${slot}`} slot`, pool: true },
    ...eras.map((era) => eraRow(era, true)),
  ]),
];
---

<p class="tbw-lede">
  {imposedEra ? (
    <>
      {team.name} is serving a last-place rebrand, so its Throwback Week
      identity is assigned rather than chosen. Here's what you wear on live
      scoring, matchups and your lineup.
    </>
  ) : (
    <>
      Pick which era shows up for {team.name} on live scoring, matchups, and
      your lineup during a designated Throwback Week — one of your own, or any
      look from an owner who has left the league. Those are first come, first
      served: once somebody claims one, it's theirs. Your choice is saved
      automatically and stays put until you change it.
    </>
  )}
</p>

<a class="tbw-preview-link" href={scoreboard}>
  Preview it on the scoreboard &rarr;
</a>

{imposedEra ? (
  <section class="tbw-imposed" aria-labelledby="tbw-imposed-title">
    <img
      class="tbw-imposed__banner"
      src={imposedEra.banner}
      alt={`${imposedEra.name} banner`}
      style={eraBannerStyle(imposedEra)}
    />
    <div class="tbw-imposed__body">
      <img class="tbw-imposed__icon" src={imposedEra.icon} alt="" />
      <div>
        <p class="tbw-imposed__eyebrow">The Throwback Rebrand</p>
        <h2 id="tbw-imposed-title" class="tbw-imposed__name">{imposedEra.name}</h2>
        <p class="tbw-imposed__note">
          You finished last, so you don't get to pick. On {weekLabel} you
          wear {imposedEra.name} — borrowed from another franchise's worst
          season. Win more and it's somebody else's problem next year.
        </p>
      </div>
    </div>
  </section>
) : allEras.length === 0 ? (
  <p class="tbw-empty">
    {team.name} doesn't have any eligible legacy eras yet — check back
    once more vintage art is recovered.
  </p>
) : (
  <form id="tbw-form" data-selected={selectedKey ?? ''}>
    {locked && (
      <p class="tbw-notice">
        Throwback Week is underway, so eras are locked until the week is over.
      </p>
    )}
    {outbid && !locked && (
      <p class="tbw-notice">
        Another team claimed your era first, so you're wearing your default
        until you pick something else.
      </p>
    )}
    {/* ONE grid and ONE card template for both groups. The pool is hidden by
        a CSS-only toggle (a checkbox outside the `eraKey` radios, so the save
        handler never sees it) rather than split into a second container,
        which would have meant a second copy of the card markup. */}
    {poolEras.length > 0 && (
      <input
        type="checkbox"
        id="tbw-pool-toggle"
        class="tbw-pool-toggle"
        checked={poolHasSelection}
      />
    )}
    <div class="tbw-grid">
      {rows.map((row) =>
        row.kind === 'heading' ? (
          <div class={`tbw-group ${row.pool ? 'tbw-group--pool' : ''}`} data-pool={row.pool ? '' : undefined}>
            <h3 class="tbw-group__title">{row.title}</h3>
            {row.note && <p class="tbw-group__note">{row.note}</p>}
            {row.toggle && (
              <label for="tbw-pool-toggle" class="tbw-group__toggle">
                <span class="tbw-group__toggle-show">Show {poolEras.length} eras</span>
                <span class="tbw-group__toggle-hide">Hide them</span>
              </label>
            )}
          </div>
        ) : (
          <label
            class={`tbw-card ${row.claimedBy ? 'tbw-card--claimed' : ''}`}
            data-era-key={eraPickKey(row.era)}
            data-pool={row.pool ? '' : undefined}
          >
            <input
              type="radio"
              name="eraKey"
              value={eraPickKey(row.era)}
              checked={eraPickKey(row.era) === selectedKey}
              disabled={locked || !!row.claimedBy}
            />
            <img
              class="tbw-card__banner"
              src={row.era.banner}
              alt={`${row.era.name} banner`}
              style={eraBannerStyle(row.era)}
              loading="lazy"
            />
            <div class="tbw-card__body">
              <img class="tbw-card__icon" src={row.era.icon} alt="" loading="lazy" />
              <div>
                <div class="tbw-card__name">
                  {row.era.name}
                  {eraPickKey(row.era) === ownDefaultKey && (
                    <span class="tbw-card__default-chip">Your {weekLabel} default</span>
                  )}
                  {row.claimedBy && (
                    <span class="tbw-card__claimed-chip">Claimed by {row.claimedBy}</span>
                  )}
                </div>
                <div class="tbw-card__years">
                  {row.era.yearStart}–{row.era.yearEnd}
                  {row.era.eraLabel && <span class="tbw-card__era-label">· {row.era.eraLabel}</span>}
                  {/* The pool's slot is named by its group heading instead. */}
                  {(() => {
                    const provenance = row.pool ? null : throwbackEraProvenance(row.era);
                    return provenance && (
                      <span class="tbw-card__slot" title={provenance.title}>
                        · {provenance.label}
                      </span>
                    );
                  })()}
                </div>
              </div>
              {/* Interactive content inside a label doesn't activate the radio,
                  so following this link neither selects nor saves the era. */}
              <a
                class="tbw-card__preview"
                href={`${scoreboard}&previewEra=${eraPickKey(row.era)}`}
                aria-label={`Preview ${row.era.name} (${row.era.yearStart}) on the scoreboard without saving`}
              >
                Preview →
              </a>
            </div>
          </label>
        )
      )}
    </div>
  </form>
)}

<p id="tbw-status" class="tbw-status" role="status" aria-live="polite"></p>

<script>
  // Bind on astro:page-load (fires on initial load AND after every ClientRouter
  // navigation) — a top-level bind runs once per module and leaves the form
  // dead when the user navigates away and returns via a view transition.
  //
  // The gate is a flag on the FORM, a node the router replaces, so the same
  // picker arriving on another page (or the other league's copy of this one)
  // binds its own form rather than inheriting a stale one. No league name is
  // needed in the gate because there is one component, not a forked pair, and
  // the endpoint takes its scope from the session.
  function initThrowbackPicker() {
    const form = document.getElementById('tbw-form') as HTMLFormElement | null;
    const status = document.getElementById('tbw-status');
    if (!form || form.dataset.tbwBound === '1') return;
    form.dataset.tbwBound = '1';

    form.addEventListener('change', async (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name !== 'eraKey') return;

      const revert = () => {
        const previous = form.dataset.selected ?? '';
        form.querySelectorAll<HTMLInputElement>('input[name="eraKey"]').forEach((input) => {
          input.checked = input.value === previous;
        });
      };

      // `{slot}:{year}` for an era inherited from a franchise slot this team
      // used to occupy, a bare year for its own — the API validates both.
      const [a, b] = target.value.split(':');
      const payload = b === undefined
        ? { yearStart: Number(a) }
        : { yearStart: Number(b), sourceFranchiseId: a };
      if (status) status.textContent = 'Saving…';

      try {
        // No league parameter: the endpoint takes the scope from the session
        // cookie, so this one URL serves every league and a client cannot
        // aim a write at another league's bucket.
        const res = await fetch('/api/throwback-preference', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.success) {
          form.dataset.selected = target.value;
          if (status) status.textContent = 'Saved.';
        } else {
          // Claimed by someone else (409) or locked (423): the radio must not
          // keep showing an era the owner does not hold.
          revert();
          if (status) status.textContent = data.error || 'Failed to save.';
        }
      } catch {
        revert();
        if (status) status.textContent = 'Failed to save — check your connection.';
      }
    });
  }

  document.addEventListener('astro:page-load', initThrowbackPicker);
</script>

<style>
  .tbw-lede {
    margin: 0;
    color: var(--content-text-muted);
    max-width: 60ch;
  }

  .tbw-imposed {
    margin: 1rem 0 1.5rem;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    background: var(--content-bg);
  }
  .tbw-imposed__banner {
    display: block;
    width: 100%;
    /* Capped and contained rather than `height: auto`, which renders a
       square legacy logo as a 589px-tall page header. The inline gradient
       (see `eraBannerStyle`) fills whatever the art doesn't. */
    height: 140px;
    object-fit: contain;
    background: var(--content-border);
  }
  .tbw-imposed__body {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
  }
  .tbw-imposed__icon {
    width: 64px;
    height: 64px;
    flex: none;
    object-fit: contain;
  }
  .tbw-imposed__eyebrow {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .tbw-imposed__name {
    margin: 0.15rem 0 0.4rem;
    font-size: var(--font-size-xl);
  }
  .tbw-imposed__note {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--content-text-muted, inherit);
  }

  .tbw-preview-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .tbw-preview-link:hover,
  .tbw-preview-link:focus-visible {
    text-decoration: underline;
  }

  .tbw-empty {
    color: var(--content-text-muted);
  }

  .tbw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .tbw-notice {
    margin: 1rem 0 0;
    padding: 0.6rem 0.8rem;
    border-left: 3px solid var(--color-accent);
    background: var(--card-surface);
    font-size: var(--font-size-sm);
  }

  /* Group headings span the whole grid row. */
  .tbw-group {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-top: 0.5rem;
  }
  .tbw-group__title {
    margin: 0;
    font-size: var(--font-size-lg);
  }
  .tbw-group--pool .tbw-group__title {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--content-text-muted);
  }
  .tbw-group__note {
    margin: 0;
    flex-basis: 100%;
    font-size: var(--font-size-sm);
    color: var(--content-text-muted);
  }
  .tbw-group__toggle {
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    cursor: pointer;
  }
  .tbw-group__toggle:hover {
    text-decoration: underline;
  }

  /* The pool collapses behind a checkbox, no script: hidden until toggled. */
  .tbw-pool-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  #tbw-form:not(:has(.tbw-pool-toggle:checked)) [data-pool],
  #tbw-form:not(:has(.tbw-pool-toggle:checked)) .tbw-group__toggle-hide,
  #tbw-form:has(.tbw-pool-toggle:checked) .tbw-group__toggle-show {
    display: none;
  }
  #tbw-form:has(.tbw-pool-toggle:focus-visible) .tbw-group__toggle {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .tbw-card--claimed {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .tbw-card__claimed-chip {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    vertical-align: middle;
  }

  .tbw-card {
    position: relative;
    display: block;
    border: 2px solid var(--card-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    background: var(--card-surface);
    transition: border-color 0.15s ease;
  }

  .tbw-card:has(input:checked) {
    border-color: var(--color-accent);
  }

  .tbw-card input {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 20px;
    height: 20px;
  }

  .tbw-card__banner {
    display: block;
    width: 100%;
    height: 90px;
    /* Fit the whole banner (letterboxed) so wordmarks are never clipped —
       legacy banners vary wildly in aspect ratio, and 21 of them are the
       square 2003/04 MFL franchise logo rather than a banner at all. The
       letterbox is filled by the era's own palette inline, so `contain`
       costs nothing; see `eraBannerStyle` for why cropping is worse. */
    object-fit: contain;
    background: var(--content-border);
  }

  .tbw-card__body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
  }

  .tbw-card__preview {
    margin-left: auto;
    flex: none;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .tbw-card__preview:hover,
  .tbw-card__preview:focus-visible {
    text-decoration: underline;
  }

  .tbw-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .tbw-card__name {
    font-weight: 600;
  }

  .tbw-card__default-chip {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }

  .tbw-card__years {
    font-size: var(--font-size-sm);
    color: var(--content-text-muted);
  }

  .tbw-status {
    margin-top: 1rem;
    min-height: 1.2em;
    color: var(--content-text-muted);
  }

  .tbw-card__slot {
    font-style: italic;
    opacity: 0.85;
  }

  .tbw-card__era-label {
    font-style: italic;
  }
</style>
