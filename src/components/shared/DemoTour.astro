---
/**
 * The custom-site demo's "Try these" card (docs/plans/custom-site-demo.md):
 * shown on each demo league's HOME only, and nowhere off the demo.
 *
 * It points a prospect at three things that never show up by clicking around
 * a league page: the light/dark skin (a live switch, the site's own
 * ThemeToggle), the Preferences page (country and clocks) and the Sunday
 * Ticket board, whose channels follow the country. Closable for the visit,
 * like the demo banner.
 *
 * Links name the route SLOT (`/theleague/...`); the demo's HTML pass rewrites
 * them to the demo path (`/dynasty/...`).
 */
import ThemeToggle from './ThemeToggle.astro';
import { isDemoDeploy } from '../../utils/deploy-environment';
import { demoLeaguePaths } from '../../config/leagues-data.mjs';

interface Props {
  /** The route slot's path prefix, e.g. '/theleague'. */
  base: string;
}

const { base } = Astro.props;

// Home = the slot root, under its own name or its demo path.
const demoPaths = demoLeaguePaths();
const shownBase = Object.entries(demoPaths).find(([, slug]) => `/${slug}` === base)?.[0];
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = here === base || (shownBase !== undefined && here === `/${shownBase}`);
const show = isDemoDeploy() && isHome;
---

{
  show && (
    <section class="demo-tour" aria-labelledby="demo-tour-title" data-demo-tour>
      <div class="demo-tour__head">
        <h2 id="demo-tour-title" class="demo-tour__title">Try these</h2>
        <p class="demo-tour__lede">Three things every owner gets that you won't find by clicking around.</p>
        <button type="button" class="demo-tour__close" data-demo-tour-close aria-label="Hide these tips">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
      <ol class="demo-tour__list">
        <li class="demo-tour__item">
          <h3>Light or dark, your call</h3>
          <p>Every page, crest and chart has its own dark skin, not a filter. Flip it here and look around.</p>
          <ThemeToggle class="demo-tour__toggle" />
        </li>
        <li class="demo-tour__item">
          <h3>Set your country</h3>
          <p>US, Canada, Mexico, the UK or Australia: kickoff times read in your clocks, and TV listings follow where you watch.</p>
          <a class="demo-tour__link" href={`${base}/preferences`}>Open Preferences →</a>
        </li>
        <li class="demo-tour__item">
          <h3>Sunday Ticket, by country</h3>
          <p>Every game this week with the channel it's on. Switch the country and watch the channels change.</p>
          <a class="demo-tour__link" href={`${base}/sunday-ticket`}>Open Sunday Ticket →</a>
        </li>
      </ol>
    </section>
  )
}

<style>
  .demo-tour {
    position: relative;
    max-width: 1200px;
    margin: 1rem auto 0;
    padding: 1rem 1.25rem 1.25rem;
    border-radius: var(--radius-lg, 16px);
    background: var(--card-surface);
    border: 1px solid var(--content-border);
    border-top: 4px solid #fca311;
  }
  @media (max-width: 1232px) {
    .demo-tour { margin-inline: 16px; }
  }
  .demo-tour__head {
    padding-right: 2.5rem;
  }
  .demo-tour__title {
    margin: 0;
    font-size: 1.125rem;
  }
  .demo-tour__lede {
    margin: 0.2rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
  }
  .demo-tour__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--content-text-muted);
    cursor: pointer;
  }
  .demo-tour__close:hover,
  .demo-tour__close:focus-visible {
    background: var(--content-bg-muted);
    color: var(--page-text);
  }
  .demo-tour__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 0.75rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }
  .demo-tour__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem;
    border-radius: var(--radius-md, 10px);
    background: var(--content-bg-muted);
  }
  .demo-tour__item h3 {
    margin: 0;
    font-size: 0.95rem;
  }
  .demo-tour__item p {
    margin: 0;
    flex: 1;
    font-size: 0.85rem;
    color: var(--content-text-muted);
  }
  .demo-tour__link {
    font-weight: 700;
    font-size: var(--font-size-sm);
    color: var(--league-accent);
    text-decoration: none;
  }
  .demo-tour__link:hover { text-decoration: underline; }

  :global(html.demo-tour-dismissed) .demo-tour { display: none; }
</style>

<script>
  // Same pattern as DemoBanner: hidden for the rest of the visit once closed,
  // re-asserted on every page load and swap (the router replaces <html>'s class).
  const KEY = 'demoTourDismissed';
  function dismissed() {
    try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; }
  }
  function apply() {
    if (dismissed()) document.documentElement.classList.add('demo-tour-dismissed');
  }
  function init() {
    apply();
    const close = document.querySelector<HTMLButtonElement>('[data-demo-tour-close]');
    if (!close || close.dataset.bound) return;
    close.dataset.bound = '1';
    close.addEventListener('click', () => {
      document.documentElement.classList.add('demo-tour-dismissed');
      try { sessionStorage.setItem(KEY, '1'); } catch {}
    });
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:after-swap', apply);
</script>
