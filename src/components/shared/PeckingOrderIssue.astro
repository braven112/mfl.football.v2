---
/**
 * PeckingOrderIssue — renders a single weekly issue of The Pecking Order, the
 * Tuesday-morning power-rankings column. Shared by both leagues; the per-league
 * pages are thin wrappers that pass their own issue JSON and navSlug.
 *
 * Driven entirely by the JSON document at
 * <dataPath>/pecking-order/<year>-<week>.json (written by
 * scripts/generate-pecking-order.mjs). Blurbs arrive Schefter-voiced when
 * the generator ran with an API key, templated otherwise — the shape is
 * identical either way.
 *
 * Nothing here assumes a field size: TheLeague ranks 16, the AFL 24, and the
 * AFL's four divisions arrive tagged with their conference (franchise ids
 * collide across leagues, which is also why the accent tokens are scoped by
 * `data-league` rather than resolved here).
 */
import { getPersonaLabels } from '../../utils/persona-server';
import { getLeagueConfig } from '../../utils/league-config';
import { getLeagueByNavSlug, getLeagueBySlug } from '../../config/leagues';
import { franchiseSlug } from '../../utils/franchise-marks';
import type { LeagueSlug } from '../../types/nav';
import { teamAccentVar } from '../../utils/team-accent-css';
import { getLeaguePrefix, resolveLeaguePath } from '../../utils/nav-utils';
import { isRetroactivelyGenerated } from '../../utils/pecking-order-landing';
import { capSentences, LEDE_MAX_SENTENCES } from '../../utils/pecking-order-lede.mjs';
import { spellOutShorthand } from '../../utils/pecking-order-wording.mjs';
import type { OwnersPollBlock } from './owners-poll/OwnersPollResults.astro';

export interface RankingRow {
  rank: number;
  franchiseId: string;
  previousRank: number | null;
  trend: 'up' | 'down' | 'flat';
  blurb: string;
  metrics: {
    composite: number | null;
    rolling3Ppg: number | null;
    seasonPpg: number | null;
    allPlayPct?: number | null;
    avgMargin?: number | null;
    allPlayScore?: number | null;
    formScore?: number | null;
  };
}

export interface AwardCard {
  franchiseId?: string;
  homeId?: string;
  awayId?: string;
  title: string;
  blurb: string;
}

export interface StandingsTeamRow {
  franchiseId: string;
  name: string;
  nameMedium: string;
  abbrev: string;
  division: string;
  wins: number;
  losses: number;
  ties: number;
  pf: number;
  pa: number;
  ppg: number;
  allPlayPct: number;
  allPlayWLT: string;
}

export interface PeckingOrderData {
  league?: string;
  year: number;
  week: number;
  publishedAt: string;
  generatedAt: string;
  voiceMode: string;
  methodology?: string;
  headline: string;
  lede: string;
  rankings: RankingRow[];
  /**
   * The Owners' Poll for this week. ABSENT on every issue written before the
   * poll existed and on any league that doesn't run it, which is why the
   * section renders nothing at all rather than an empty state — the archive
   * must not sprout a "no poll" notice on 40 old issues.
   */
  ownersPoll?: OwnersPollBlock | null;
  awards: {
    statOfWeek: AwardCard | null;
    benchBlunder: AwardCard | null;
    tradeOfWeek: AwardCard | null;
    cutOfShame: AwardCard | null;
    heaterOfWeek: AwardCard | null;
    coolerOfWeek: AwardCard | null;
    matchupOfWeek: AwardCard | null;
  };
  standings: {
    divisions: { name: string; conference?: string; teams: StandingsTeamRow[] }[];
    allPlay: { franchiseId: string; name: string; nameMedium: string; abbrev: string; division: string; allPlayPct: number; allPlayWLT: string; pf: number }[];
  };
  /**
   * A big league's cut (registry `peckingOrder.topN`): only rows ranked 1..N
   * carry a blurb and render as cards; every team still appears, ranked, in
   * its division list.
   */
  topN?: number;
}

export interface Props {
  issue: PeckingOrderData;
  /** Nav slug of the league this issue belongs to. */
  league?: LeagueSlug;
  /**
   * 'sample' is the landing page rendering a past issue as a format demo
   * during the preseason. It drops the headline to h2 (the page already has
   * its own h1 above) and hides the publish date, which for a sample is both
   * meaningless and actively confusing — a Week 14 2025 issue stamped with
   * the day it was generated reads as fresh news.
   */
  variant?: 'live' | 'sample';
}

/**
 * The issue JSON records the league that generated it (canonical slug), so a
 * page that forgets the prop still renders against the right franchise config
 * rather than silently drawing AFL rankings with TheLeague's names and icons —
 * franchise ids collide across leagues, so that failure looks like real data.
 * The prop still wins when both are present.
 */
const issueNavSlug = (slug: string | undefined): LeagueSlug | undefined =>
  slug ? (getLeagueBySlug(slug)?.navSlug as LeagueSlug | undefined) : undefined;

const { issue, league: leagueProp, variant = 'live' } = Astro.props as Props;
const isSample = variant === 'sample';
const HeadlineTag = isSample ? 'h2' : 'h1';
const league: LeagueSlug =
  leagueProp ?? issueNavSlug(issue.league) ?? 'theleague';

// Build franchise lookup for icons/colors
const teams = new Map<string, any>();
for (const t of getLeagueConfig(league).teams) {
  teams.set(t.franchiseId, t);
}

// Franchise links are internal routes (/afl-fantasy/franchises/0001); on a
// league's own apex host the prefix is redundant and gets stripped, same as
// Breadcrumbs does.
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
// A package league has no franchise pages; its team page is the brand book's.
const leagueDef = getLeagueByNavSlug(league);
const isPackageLeague = !!(leagueDef.optInNav && leagueDef.logo);
const franchiseHref = (franchiseId: string) => {
  const team = teams.get(franchiseId);
  return isPackageLeague && team
    ? resolveLeaguePath(`/${leagueDef.slug}/brand/${franchiseSlug(team)}`, hideLeaguePrefix)
    : resolveLeaguePath(`${getLeaguePrefix(league)}/franchises/${franchiseId}`, hideLeaguePrefix);
};

/**
 * Brand accent for a card — the site-wide franchise token, not the raw config
 * color. It paints the rank numeral and the card's top edge, so it has to clear
 * 3:1 on whichever theme is rendering; the token carries a value per theme
 * (src/utils/team-accent-css.ts). Raw brand colors miss that badly in one
 * direction or the other — Bring The Pain's near-black is 1.2:1 on a dark
 * card, Midwestside's yellow 1.5:1 on a white one.
 */
const accentStyle = (franchiseId: string | undefined) =>
  `--pr-accent: ${teamAccentVar(franchiseId ?? '', 'var(--color-primary, #2563eb)')}`;

const formattedDate = new Date(issue.publishedAt).toLocaleDateString('en-US', {
  month: 'short', day: 'numeric',
});

/**
 * The dateline is only shown when `publishedAt` is actually a publication
 * date. Issues generated after the fact (launch seeds, backfills) carry the
 * day the FILE was written, and printing that as a dateline stamped a Week 14
 * 2025 issue "August 14, 2026" — which reads as this morning's column. There
 * is no honest date to substitute, so the kicker just carries the week.
 */
const showDateline = !isSample && !isRetroactivelyGenerated(issue);

// Issues carry the methodology they were generated under, so an archived issue
// keeps describing its own math. The fallback matches describeMethodology()
// (scripts/lib/pecking-order-math.mjs) for issues written before that field.
const methodology = issue.methodology
  ?? '50% all-play record · 50% scoring over the last three weeks';
// Owner-facing copy follows the league's persona (src/utils/persona.mjs).
const labels = await getPersonaLabels(leagueDef.slug);

/**
 * The column is the RANKINGS (commissioner, 2026-10-15): the intro is capped at
 * three sentences, and the awards, division tables and standings snapshot that
 * used to follow the order are gone — they buried the one thing owners come
 * for. Older issues carry longer ledes, so the cap is applied here as well as
 * in the generator.
 */
// Published issues still carry "W2" / "L3" shorthand; spell it out for every issue.
const lede = spellOutShorthand(capSentences(issue.lede, LEDE_MAX_SENTENCES));

// ── Top-N cut (a 99-team league) ────────────────────────────────────────────
// Rows ranked 1..N carry a blurb and render as cards; the rest of the order
// follows as compact rows so every team is still placed.
const featured = issue.topN ? issue.rankings.filter((r) => r.rank <= issue.topN!) : issue.rankings;
const remainder = issue.topN ? issue.rankings.filter((r) => r.rank > issue.topN!) : [];
const recordOf = new Map(
  (issue.standings?.divisions ?? []).flatMap((d) => d.teams.map((t) => [t.franchiseId, t] as const)),
);
const record = (franchiseId: string) => {
  const t = recordOf.get(franchiseId);
  return t ? `${t.wins}-${t.losses}${t.ties ? `-${t.ties}` : ''}` : null;
};
/** Places moved since last week: positive is up. Null when there is no prior rank. */
const moved = (row: RankingRow) => (row.previousRank == null ? null : row.previousRank - row.rank);
---

<article class="pr-issue">
  <header class="pr-hero">
    <p class="pr-hero__kicker">
      The Pecking Order <span aria-hidden="true">·</span> Week {issue.week}, {issue.year}
      {showDateline && (
        <> <span aria-hidden="true">·</span> <time datetime={issue.publishedAt}>{formattedDate}</time></>
      )}
    </p>
    <HeadlineTag class="pr-hero__title">{issue.headline}</HeadlineTag>
    <p class="pr-hero__lede">{lede}</p>
  </header>

  <ol class="pr-rankings" aria-label={issue.topN ? `The Pecking Order, top ${featured.length} of ${issue.rankings.length}` : 'The Pecking Order'}>
    {featured.map((row) => {
      const team = teams.get(row.franchiseId);
      const delta = moved(row);
      const wl = record(row.franchiseId);
      return (
        <li class="pr-card" style={accentStyle(row.franchiseId)}>
          <div class="pr-card__head">
            <span class="pr-card__rank">{row.rank}</span>
            {team?.icon && <img class="pr-card__icon" src={team.icon} alt="" loading="lazy" width="36" height="36" />}
            <h3 class="pr-card__name">
              <a href={franchiseHref(row.franchiseId)}>{team?.name ?? row.franchiseId}</a>
              {wl && <span class="pr-card__record">{wl}</span>}
            </h3>
            {delta ? (
              <span class={`pr-move pr-move--${delta > 0 ? 'up' : 'down'}`} title={`Last week: #${row.previousRank}`}>
                <span aria-hidden="true">{delta > 0 ? '▲' : '▼'}</span>
                <span class="sr-only">{delta > 0 ? 'Up' : 'Down'}</span> {Math.abs(delta)}
              </span>
            ) : null}
          </div>
          <p class="pr-card__blurb">{spellOutShorthand(row.blurb)}</p>
          {(row.metrics.allPlayPct != null || row.metrics.rolling3Ppg != null) && (
            <p class="pr-card__stats">
              {row.metrics.allPlayPct != null && <span><strong>{(row.metrics.allPlayPct * 100).toFixed(1)}%</strong> all-play</span>}
              {row.metrics.rolling3Ppg != null && <span><strong>{row.metrics.rolling3Ppg.toFixed(1)}</strong> PPG, last three weeks</span>}
            </p>
          )}
        </li>
      );
    })}
  </ol>

  {remainder.length > 0 && (
    <section class="pr-rest" aria-labelledby="pr-rest-title">
      <h2 class="pr-rest__title" id="pr-rest-title">The rest of the order</h2>
      <ol class="pr-rest__list">
        {remainder.map((row) => {
          const team = teams.get(row.franchiseId);
          const delta = moved(row);
          return (
            <li class="pr-rest__row" style={accentStyle(row.franchiseId)}>
              <span class="pr-rest__rank">{row.rank}</span>
              <a class="pr-rest__name" href={franchiseHref(row.franchiseId)}>{team?.nameMedium ?? team?.name ?? row.franchiseId}</a>
              <span class="pr-rest__record">{record(row.franchiseId) ?? ''}</span>
              <span class={`pr-move pr-move--${delta ? (delta > 0 ? 'up' : 'down') : 'flat'}`}>
                {delta ? <><span aria-hidden="true">{delta > 0 ? '▲' : '▼'}</span><span class="sr-only">{delta > 0 ? 'Up' : 'Down'}</span> {Math.abs(delta)}</> : <span aria-label="No change">–</span>}
              </span>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  <footer class="pr-footnote">
    {/*
      The Owners' Poll is its own feature (/owners-poll); the column keeps a
      single link to it and nothing else — the owner rankings sit behind a vote.
    */}
    {issue.ownersPoll && (
      <a class="pr-footnote__link" href={resolveLeaguePath(`${getLeaguePrefix(league)}/owners-poll`, hideLeaguePrefix)}>
        The Owners’ Poll: how the owners rank it ›
      </a>
    )}
    <details class="pr-footnote__how">
      <summary>How the order is calculated</summary>
      <p>
        Composite score: {methodology}. Rankings are computed from the week's
        final MFL feeds; commentary is {labels.name}'s.
      </p>
    </details>
  </footer>
</article>

<style>
/* No container of its own: <main> in the layout is already the site's content
   column, so this fills it and the left edge matches the rest of the site. */

/* <main>'s phone gutter is 8px, which left the intro paragraph touching the
   screen edge. Every Pecking Order route wraps its breadcrumbs and this column
   in .pr-page, so the extra gutter goes there (styled from here, where all
   three leagues' routes share it, rather than in six route wrappers) and the
   breadcrumbs stay aligned with the column. Above 768px main grows its own. */
@media (max-width: 767px) {
  :global(.pr-page) { padding-inline: var(--spacing-sm); }
}
.pr-issue {
  padding: var(--spacing-lg) 0 var(--spacing-2xl);
  max-width: 760px;
}
.pr-hero { margin-bottom: var(--spacing-lg); }
.pr-hero__kicker {
  margin: 0 0 var(--spacing-sm);
  font-size: var(--font-size-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--content-text-muted, #6b7280);
}
.pr-hero__title {
  font-size: var(--font-size-2xl);
  line-height: 1.1;
  margin: 0 0 var(--spacing-md);
  color: var(--page-text, #111827);
}
.pr-hero__lede {
  font-size: var(--font-size-base);
  line-height: 1.6;
  color: var(--content-text-muted, #4b5563);
  margin: 0;
  max-width: 62ch;
}

.pr-rankings {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: var(--spacing-md);
}
.pr-card {
  background: var(--card-bg, #fff);
  border: 1px solid var(--content-border, #e5e7eb);
  border-top: 4px solid var(--pr-accent);
  border-radius: 12px;
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-md);
}
.pr-card__head {
  display: flex;
  align-items: center;
  gap: 0.7rem;
}
.pr-card__rank {
  font-family: var(--font-display);
  font-size: var(--font-size-2xl);
  line-height: 0.9;
  min-width: 1.6ch;
  color: var(--pr-accent);
  font-variant-numeric: tabular-nums;
}
.pr-card__icon {
  flex: none;
  width: 36px;
  height: 36px;
  object-fit: contain;
}
.pr-card__name {
  flex: 1;
  min-width: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  /* The layout gives every h3 the condensed display face; a team name in a
     card reads in the body face like the blurb under it. */
  font-family: var(--font-family-base);
  font-size: var(--font-size-base);
  font-weight: 700;
  line-height: 1.2;
}
.pr-card__name a { color: var(--page-text, #111827); text-decoration: none; }
.pr-card__name a:hover { text-decoration: underline; }
.pr-card__record {
  margin-top: 0.15rem;
  font-size: var(--font-size-xs);
  font-weight: 500;
  color: var(--content-text-muted, #6b7280);
  font-variant-numeric: tabular-nums;
}
.pr-card__blurb {
  margin: var(--spacing-md) 0 0;
  font-size: var(--font-size-base);
  line-height: 1.55;
  color: var(--page-text, #111827);
}
.pr-card__stats {
  margin: var(--spacing-md) 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs) var(--spacing-lg);
  font-size: var(--font-size-xs);
  color: var(--content-text-muted, #6b7280);
}
.pr-card__stats strong { color: var(--page-text, #111827); font-weight: 700; }

/* Movement chip. 12px bold — small text, so 4.5:1 in both themes: the light
   literals are darkened greens/reds, dark mode takes the token pair. */
.pr-move {
  flex: none;
  font-size: var(--font-size-xs);
  font-weight: 700;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.pr-card .pr-move {
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
  background: var(--content-bg-muted, #f3f4f6);
}
.pr-move--up { color: #15803d; }
.pr-move--down { color: #b91c1c; }
:global(html.dark) .pr-move--up { color: var(--color-success-dark, #6ee7b7); }
:global(html.dark) .pr-move--down { color: var(--color-error-dark, #fca5a5); }
.pr-move--flat { color: var(--content-text-muted, #6b7280); }

/* A top-N league's tail: every remaining team, one compact row each. */
.pr-rest { margin-top: var(--spacing-xl); }
.pr-rest__title {
  font-size: var(--font-size-lg);
  margin: 0 0 var(--spacing-sm);
  color: var(--page-text, #111827);
}
.pr-rest__list {
  list-style: none;
  margin: 0;
  padding: 0;
  background: var(--card-bg, #fff);
  border: 1px solid var(--content-border, #e5e7eb);
  border-radius: 12px;
  overflow: hidden;
}
.pr-rest__row {
  display: grid;
  grid-template-columns: 3ch 1fr auto 3.5ch;
  align-items: center;
  gap: 0.75rem;
  min-height: var(--touch-target-min);
  padding: 0 var(--spacing-md);
  border-left: 4px solid var(--pr-accent);
}
.pr-rest__row + .pr-rest__row { border-top: 1px solid var(--content-border, #e5e7eb); }
.pr-rest__rank {
  font-family: var(--font-display);
  font-size: var(--font-size-lg);
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.pr-rest__name {
  font-weight: 600;
  color: var(--page-text, #111827);
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pr-rest__name:hover { text-decoration: underline; }
.pr-rest__record {
  font-size: var(--font-size-sm);
  color: var(--content-text-muted, #6b7280);
  font-variant-numeric: tabular-nums;
}
.pr-rest__row .pr-move { text-align: right; }

.pr-footnote {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-xl);
  padding-top: var(--spacing-md);
  border-top: 1px solid var(--content-border, #e5e7eb);
  font-size: var(--font-size-sm);
  color: var(--content-text-muted, #6b7280);
}
.pr-footnote__link { color: var(--page-text, #111827); font-weight: 600; }
.pr-footnote__how summary { cursor: pointer; }
.pr-footnote__how p { margin: var(--spacing-sm) 0 0; line-height: 1.5; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
</style>
