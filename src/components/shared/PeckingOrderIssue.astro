---
/**
 * PeckingOrderIssue — renders a single weekly issue of The Pecking Order, the
 * Tuesday-morning power-rankings column. Shared by both leagues; the per-league
 * pages are thin wrappers that pass their own issue JSON and navSlug.
 *
 * Driven entirely by the JSON document at
 * <dataPath>/pecking-order/<year>-<week>.json (written by
 * scripts/generate-pecking-order.mjs). Blurbs arrive Schefter-voiced when
 * the generator ran with an API key, templated otherwise — the shape is
 * identical either way.
 *
 * Nothing here assumes a field size: TheLeague ranks 16, the AFL 24, and the
 * AFL's four divisions arrive tagged with their conference (franchise ids
 * collide across leagues, which is also why the accent tokens are scoped by
 * `data-league` rather than resolved here).
 */
import theleagueConfig from '../../data/theleague.config.json';
import aflConfig from '../../../data/afl-fantasy/afl.config.json';
import type { LeagueSlug } from '../../types/nav';
import { teamAccentVar } from '../../utils/team-accent-css';
import { getLeaguePrefix, resolveLeaguePath } from '../../utils/nav-utils';

export interface RankingRow {
  rank: number;
  franchiseId: string;
  previousRank: number | null;
  trend: 'up' | 'down' | 'flat';
  blurb: string;
  metrics: {
    composite: number | null;
    rolling3Ppg: number | null;
    seasonPpg: number | null;
    allPlayPct?: number | null;
    avgMargin?: number | null;
    allPlayScore?: number | null;
    formScore?: number | null;
  };
}

export interface AwardCard {
  franchiseId?: string;
  homeId?: string;
  awayId?: string;
  title: string;
  blurb: string;
}

export interface StandingsTeamRow {
  franchiseId: string;
  name: string;
  nameMedium: string;
  abbrev: string;
  division: string;
  wins: number;
  losses: number;
  ties: number;
  pf: number;
  pa: number;
  ppg: number;
  allPlayPct: number;
  allPlayWLT: string;
}

export interface PeckingOrderData {
  league?: string;
  year: number;
  week: number;
  publishedAt: string;
  generatedAt: string;
  voiceMode: string;
  methodology?: string;
  headline: string;
  lede: string;
  rankings: RankingRow[];
  awards: {
    statOfWeek: AwardCard | null;
    benchBlunder: AwardCard | null;
    tradeOfWeek: AwardCard | null;
    cutOfShame: AwardCard | null;
    heaterOfWeek: AwardCard | null;
    coolerOfWeek: AwardCard | null;
    matchupOfWeek: AwardCard | null;
  };
  standings: {
    divisions: { name: string; conference?: string; teams: StandingsTeamRow[] }[];
    allPlay: { franchiseId: string; name: string; nameMedium: string; abbrev: string; division: string; allPlayPct: number; allPlayWLT: string; pf: number }[];
  };
}

export interface Props {
  issue: PeckingOrderData;
  /** Nav slug of the league this issue belongs to. */
  league?: LeagueSlug;
}

const CONFIGS: Partial<Record<LeagueSlug, { teams: any[] }>> = {
  theleague: theleagueConfig as any,
  afl: aflConfig as any,
};

/**
 * The issue JSON records the league that generated it (canonical slug), so a
 * page that forgets the prop still renders against the right franchise config
 * rather than silently drawing AFL rankings with TheLeague's names and icons —
 * franchise ids collide across leagues, so that failure looks like real data.
 * The prop still wins when both are present.
 */
const ISSUE_SLUG_TO_NAV: Record<string, LeagueSlug> = {
  theleague: 'theleague',
  'afl-fantasy': 'afl',
};

const { issue, league: leagueProp } = Astro.props as Props;
const league: LeagueSlug =
  leagueProp ?? (issue.league ? ISSUE_SLUG_TO_NAV[issue.league] : undefined) ?? 'theleague';

// Build franchise lookup for icons/colors
const teams = new Map<string, any>();
for (const t of (CONFIGS[league] ?? theleagueConfig as any).teams) {
  teams.set(t.franchiseId, t);
}

// Franchise links are internal routes (/afl-fantasy/franchises/0001); on a
// league's own apex host the prefix is redundant and gets stripped, same as
// Breadcrumbs does.
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const franchiseHref = (franchiseId: string) =>
  resolveLeaguePath(`${getLeaguePrefix(league)}/franchises/${franchiseId}`, hideLeaguePrefix);

/**
 * Brand accent for a card — the site-wide franchise token, not the raw config
 * color. It paints the rank numeral (28px bold — WCAG "large text") and the
 * card's brand edge, so it has to clear 3:1 on whichever theme is rendering;
 * the token carries a value per theme (src/utils/team-accent-css.ts). Raw
 * brand colors miss that badly in one direction or the other — Bring The
 * Pain's near-black is 1.2:1 on a dark card, Midwestside's yellow 1.5:1 on a
 * white one.
 */
const accentStyle = (franchiseId: string | undefined) =>
  `--pr-accent: ${teamAccentVar(franchiseId ?? '', 'var(--color-primary, #2563eb)')}`;

/**
 * Three awards carry a meaning-colored edge instead of the winner's brand
 * color — cold blue for the cooler, hot orange-red for the heater, pink for
 * the bench blunder. The values are theme-pair tokens declared on `.pr-issue`
 * below (a raw hex here would be stuck on one theme); everything else keeps
 * the franchise accent.
 */
const AWARD_ACCENTS: Record<string, string> = {
  coolerOfWeek: 'var(--pr-award-cooler)',
  heaterOfWeek: 'var(--pr-award-heater)',
  benchBlunder: 'var(--pr-award-blunder)',
};

const awardAccentStyle = (key: string, franchiseId: string | undefined) =>
  AWARD_ACCENTS[key] ? `--pr-accent: ${AWARD_ACCENTS[key]}` : accentStyle(franchiseId);

const trendGlyph = (t: 'up' | 'down' | 'flat') =>
  t === 'up' ? '▲' : t === 'down' ? '▼' : '–';

const formattedDate = new Date(issue.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const orderedAwards: { key: string; card: AwardCard | null }[] = [
  { key: 'statOfWeek',     card: issue.awards.statOfWeek },
  { key: 'benchBlunder',   card: issue.awards.benchBlunder },
  { key: 'heaterOfWeek',   card: issue.awards.heaterOfWeek },
  { key: 'coolerOfWeek',   card: issue.awards.coolerOfWeek },
  { key: 'matchupOfWeek',  card: issue.awards.matchupOfWeek },
  { key: 'tradeOfWeek',    card: issue.awards.tradeOfWeek },
  { key: 'cutOfShame',     card: issue.awards.cutOfShame },
];

// Issues carry the methodology they were generated under, so an archived issue
// keeps describing its own math. The fallback matches describeMethodology()
// (scripts/lib/pecking-order-math.mjs) for issues written before that field.
const methodology = issue.methodology
  ?? '50% all-play record · 50% last 3 weeks (rolling-3wk PPG)';
---

<article class="pr-issue">
  <header class="pr-hero">
    <div class="pr-hero__eyebrow">
      <span class="pr-hero__badge">The Pecking Order</span>
      <span class="pr-hero__dot" aria-hidden="true"></span>
      <span>Week {issue.week} · {issue.year}</span>
      <span class="pr-hero__dot" aria-hidden="true"></span>
      <time datetime={issue.publishedAt}>{formattedDate}</time>
    </div>
    <h1 class="pr-hero__title">{issue.headline}</h1>
    <p class="pr-hero__lede">{issue.lede}</p>
  </header>

  <section class="pr-section" aria-label={`The Pecking Order 1-${issue.rankings.length}`}>
    <h2 class="pr-section__title pr-section__title--brand">
      <img
        class="pr-section__avatar"
        src="/assets/claude-schefter-avatar.webp"
        alt=""
        aria-hidden="true"
        width="36"
        height="36"
        loading="lazy"
      />
      <span>The Pecking Order</span>
    </h2>
    <ol class="pr-rankings">
      {issue.rankings.map(row => {
        const team = teams.get(row.franchiseId);
        return (
          <li class="pr-card" style={accentStyle(row.franchiseId)}>
            <div class="pr-card__rank">
              <div class="pr-card__rank-num">{row.rank}</div>
              {row.previousRank != null && (
                <div class={`pr-card__trend pr-card__trend--${row.trend}`} title={`Previous: #${row.previousRank}`}>
                  {trendGlyph(row.trend)}
                  {row.trend !== 'flat' && (
                    <span class="pr-card__trend-delta">{Math.abs(row.previousRank - row.rank)}</span>
                  )}
                </div>
              )}
            </div>
            <div class="pr-card__crest">
              {team?.icon && <img class="pr-card__icon" src={team.icon} alt="" loading="lazy" width="32" height="32" />}
            </div>
            <div class="pr-card__body">
              <h3 class="pr-card__name">
                <a href={franchiseHref(row.franchiseId)}>{team?.name ?? row.franchiseId}</a>
              </h3>
              <p class="pr-card__blurb">{row.blurb}</p>
              <div class="pr-card__metrics">
                {row.metrics.allPlayPct != null && (
                  <span class="pr-card__metric"><span>All-play</span><strong>{(row.metrics.allPlayPct * 100).toFixed(1)}%</strong></span>
                )}
                {row.metrics.rolling3Ppg != null && (
                  <span class="pr-card__metric"><span>L3 PPG</span><strong>{row.metrics.rolling3Ppg.toFixed(1)}</strong></span>
                )}
                {row.metrics.seasonPpg != null && (
                  <span class="pr-card__metric"><span>Season PPG</span><strong>{row.metrics.seasonPpg.toFixed(1)}</strong></span>
                )}
                {row.metrics.avgMargin != null && (
                  <span class="pr-card__metric"><span>Avg margin</span><strong>{row.metrics.avgMargin > 0 ? '+' : ''}{row.metrics.avgMargin.toFixed(1)}</strong></span>
                )}
                {row.metrics.composite != null && (
                  <span class="pr-card__metric"><span>Score</span><strong>{row.metrics.composite.toFixed(1)}</strong></span>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="pr-section" aria-label="Weekly awards">
    <h2 class="pr-section__title">Awards</h2>
    <div class="pr-awards">
      {orderedAwards.filter(a => a.card).map(({ key, card }) => {
        const fid = card!.franchiseId ?? card!.homeId;
        const team = fid ? teams.get(fid) : null;
        const second = card!.awayId ? teams.get(card!.awayId) : null;
        return (
          <div class="pr-award" style={awardAccentStyle(key, fid)}>
            <div class="pr-award__title">{card!.title}</div>
            <div class="pr-award__recipient">
              {team?.icon && <img src={team.icon} alt="" loading="lazy" width="28" height="28" />}
              <span>{team?.nameMedium ?? fid ?? '—'}</span>
              {second && (
                <>
                  <span class="pr-award__vs">vs</span>
                  {second?.icon && <img src={second.icon} alt="" loading="lazy" width="28" height="28" />}
                  <span>{second?.nameMedium}</span>
                </>
              )}
            </div>
            <p class="pr-award__blurb">{card!.blurb}</p>
          </div>
        );
      })}
    </div>
  </section>

  {issue.standings && (
    <section class="pr-section" aria-label="Standings snapshot">
      <h2 class="pr-section__title">Standings Snapshot</h2>
      <div class="pr-standings">
        <div class="pr-standings__col">
          {issue.standings.divisions.map(div => (
            <div class="pr-table-block">
              <h3 class="pr-table-block__title">
                {div.conference && <span class="pr-table-block__conf">{div.conference} · </span>}{div.name}
              </h3>
              <div class="pr-table-wrap">
                <table class="pr-table">
                  <thead>
                    <tr><th class="pr-table__team">Team</th><th>W-L</th><th>PF</th><th>PPG</th></tr>
                  </thead>
                  <tbody>
                    {div.teams.map(t => (
                      <tr>
                        <td class="pr-table__team">{t.nameMedium}</td>
                        <td>{t.wins}-{t.losses}{t.ties ? `-${t.ties}` : ''}</td>
                        <td>{t.pf.toFixed(1)}</td>
                        <td>{t.ppg.toFixed(1)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
        <div class="pr-standings__col">
          <div class="pr-table-block">
            <h3 class="pr-table-block__title">All-Play</h3>
            <div class="pr-table-wrap">
              <table class="pr-table">
                <thead>
                  <tr><th class="pr-table__team">Team</th><th>All-Play</th><th>Pct</th><th>PF</th></tr>
                </thead>
                <tbody>
                  {issue.standings.allPlay.map(t => (
                    <tr>
                      <td class="pr-table__team">{t.nameMedium}</td>
                      <td>{t.allPlayWLT || '—'}</td>
                      <td>{(t.allPlayPct * 100).toFixed(1)}%</td>
                      <td>{t.pf.toFixed(1)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <footer class="pr-footnote">
    <p>
      Composite score: {methodology}. Rankings and awards are computed from the
      week's final MFL feeds; commentary is Claude Schefter's.
    </p>
  </footer>
</article>

<style>
/* No container of its own: <main> in the layout is already the site's content
   column (1232px, centered, with its own padding), so a second centered
   1100px box inside it inset this column ~47px from where every other page's
   content starts. Fill main and the left edge matches the rest of the site. */
.pr-issue {
  padding: 1.5rem 0 4rem;

  /* Award edge colors that mean something rather than naming a team: cold blue
     for the cooler, hot orange-red for the heater, pink for the bench blunder.
     Light values first, dark below — each side clears 3:1 on its own card
     surface (5.2:1 / 5.2:1 / 6.0:1 on white, 6.0:1 / 6.7:1 / 5.7:1 on #262626). */
  --pr-award-cooler: #2563eb;
  --pr-award-heater: #c2410c;
  --pr-award-blunder: #be185d;
}
:global(html.dark) .pr-issue {
  --pr-award-cooler: #60a5fa;
  --pr-award-heater: #fb923c;
  --pr-award-blunder: #f472b6;
}
.pr-hero {
  border-bottom: 1px solid var(--content-border, #e5e7eb);
  padding-bottom: 1.5rem;
  margin-bottom: 2rem;
}
.pr-hero__eyebrow {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--content-text-muted, #6b7280);
  margin-bottom: 0.75rem;
}
.pr-hero__badge {
  background: var(--color-primary, #2563eb);
  color: #fff;
  padding: 0.15rem 0.5rem;
  border-radius: 0.25rem;
  font-weight: 600;
}
.pr-hero__dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--content-text-muted, #6b7280);
}
.pr-hero__title {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  line-height: 1.1;
  margin: 0 0 0.5rem;
  color: var(--page-text, #111827);
}
.pr-hero__lede {
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--content-text-muted, #4b5563);
  margin: 0;
  max-width: 70ch;
}

.pr-section { margin-bottom: 2.5rem; }
.pr-section__title {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0 0 1rem;
  color: var(--page-text, #111827);
  border-left: 3px solid var(--color-primary, #2563eb);
  padding-left: 0.6rem;
}
/* Avatar + heading, in normal flow, starting on the page's content edge. */
.pr-section__title--brand {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  border-left: none;
  padding-left: 0;
  font-size: 1.75rem;
}
.pr-section__avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid var(--content-border, #e5e7eb);
  background: var(--content-bg-muted, #f3f4f6);
}

.pr-rankings {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.6rem;
}
/* rank | crest | text. The crest gets its OWN fixed-width column rather than
   sitting inline with the team name, so the name, the blurb and the metric row
   share one left edge — and a franchise with no icon file leaves an empty cell
   instead of sliding its card out of line with the rest of the column. */
.pr-card {
  display: grid;
  grid-template-columns: 3.5rem 2rem 1fr;
  column-gap: 0.75rem;
  align-items: center;
  padding: 0.85rem;
  border: 1px solid var(--content-border, #e5e7eb);
  border-left: 4px solid var(--pr-accent);
  border-radius: 0.5rem;
  background: var(--card-bg, #fff);
}
.pr-card__rank {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.15rem;
}
.pr-card__rank-num {
  font-size: 1.75rem;
  font-weight: 800;
  line-height: 1;
  color: var(--pr-accent);
}
.pr-card__trend {
  display: inline-flex;
  align-items: center;
  gap: 0.15rem;
  font-size: 0.7rem;
  font-weight: 700;
}
/* The delta is 11px bold — small text, so it needs 4.5:1 in both themes. Light
   literals are darkened from the old #16a34a/#dc2626 (3.1:1 / 4.5:1 on white);
   dark mode takes the token pair, which is tuned for a dark surface. */
.pr-card__trend--up { color: #15803d; }
.pr-card__trend--down { color: #b91c1c; }
:global(html.dark) .pr-card__trend--up { color: var(--color-success-dark, #6ee7b7); }
:global(html.dark) .pr-card__trend--down { color: var(--color-error-dark, #fca5a5); }
.pr-card__trend--flat { color: var(--content-text-muted, #6b7280); }
.pr-card__crest {
  display: flex;
  align-items: center;
  justify-content: center;
}
.pr-card__icon {
  border-radius: 0.25rem;
  width: 2rem;
  height: 2rem;
  object-fit: contain;
}
.pr-card__name {
  font-size: 1.05rem;
  margin: 0 0 0.25rem;
  font-weight: 700;
}
.pr-card__name a { color: inherit; text-decoration: none; }
.pr-card__name a:hover { text-decoration: underline; }
.pr-card__blurb {
  margin: 0.1rem 0 0.4rem;
  color: var(--content-text-muted, #4b5563);
  font-size: 0.95rem;
  line-height: 1.4;
}
.pr-card__metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  font-size: 0.75rem;
  color: var(--content-text-muted, #6b7280);
}
.pr-card__metric {
  display: inline-flex;
  align-items: baseline;
  gap: 0.25rem;
}
.pr-card__metric strong {
  color: var(--page-text, #111827);
  font-weight: 700;
}

.pr-awards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 0.75rem;
}
.pr-award {
  background: var(--card-bg, #fff);
  border: 1px solid var(--content-border, #e5e7eb);
  border-top: 3px solid var(--pr-accent);
  border-radius: 0.5rem;
  padding: 0.85rem;
}
.pr-award__title {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--content-text-muted, #6b7280);
  font-weight: 600;
  margin-bottom: 0.4rem;
}
.pr-award__recipient {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-weight: 700;
  font-size: 0.95rem;
  margin-bottom: 0.35rem;
}
.pr-award__vs {
  font-weight: 400;
  color: var(--content-text-muted, #6b7280);
}
.pr-award__blurb {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.4;
  color: var(--content-text-muted, #4b5563);
}

.pr-standings {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  align-items: start;
}
@media (max-width: 860px) {
  .pr-standings { grid-template-columns: 1fr; }
}
.pr-standings__col {
  display: grid;
  gap: 1rem;
}
.pr-table-block__title {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--content-text-muted, #6b7280);
  margin: 0 0 0.4rem;
}
/* Conference qualifier on a division heading (AFL only — TheLeague's four
   divisions have no parent). Lighter than the division itself so the eye lands
   on the part that changes between blocks. */
.pr-table-block__conf { font-weight: 400; opacity: 0.75; }
.pr-table-wrap { overflow-x: auto; }
.pr-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  background: var(--card-bg, #fff);
  border: 1px solid var(--content-border, #e5e7eb);
  border-radius: 0.5rem;
}
.pr-table th,
.pr-table td {
  padding: 0.4rem 0.6rem;
  text-align: right;
  white-space: nowrap;
  border-bottom: 1px solid var(--content-border, #e5e7eb);
  color: var(--page-text, #111827);
}
.pr-table th {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--content-text-muted, #6b7280);
}
.pr-table tbody tr:last-child td { border-bottom: none; }
.pr-table__team { text-align: left; font-weight: 600; }

.pr-footnote {
  margin-top: 2rem;
  padding-top: 1rem;
  border-top: 1px dashed var(--content-border, #e5e7eb);
  font-size: 0.8rem;
  color: var(--content-text-muted, #6b7280);
}
.pr-footnote p { margin: 0; }

@media (max-width: 720px) {
  .pr-section__title--brand { font-size: 1.5rem; }
  .pr-section__avatar { width: 32px; height: 32px; }
}
</style>
