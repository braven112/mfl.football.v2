---
import '../../styles/player-modal-band.css';
/**
 * WelcomeModal — the shell of a once-per-device welcome popup: the Throwback
 * Week "This week you're playing as …" (ThrowbackWeekModal) and a seasonal
 * theme's "Your … look" (SeasonWelcomeModal).
 *
 * Same shell as the player card (PlayerDetailsModal): frosted scrim, a
 * composite team-colour band (`.pmb`) over a card body, centred on desktop and
 * a bottom sheet at ≤640px. A native <dialog> rather than the player card's
 * hand-rolled one, so focus trapping and Esc come from the platform. The body
 * (eyebrow, title, note, actions) is the caller's slot, styled here with the
 * `twm__*` classes.
 *
 * The seen-flag is written when the popup OPENS, not when it closes —
 * navigating away without dismissing it still counts as having seen it. Only
 * one welcome opens per page: the first one not yet seen.
 */

interface Props {
  /** Element id; also the dialog's own label is `${id}-title`, on the slot's heading. */
  id: string;
  /** Registry slug of the league this page belongs to (ClientRouter gate). */
  leagueSlug: string;
  /** localStorage key — one sighting per device. */
  storageKey: string;
  /** Watermark word behind the crest. */
  ghost: string;
  crest?: string;
  crestFilter?: string;
  /** `square` for a drawn mark with corners of its own (a sweater patch), which a round crop would cut. */
  crestShape?: 'round' | 'square';
  bandStart: string;
  bandEnd: string;
  bandGlow: string;
  /** Stories only: render already open (non-modal), since a closed dialog draws nothing. */
  previewOpen?: boolean;
}

const {
  id,
  leagueSlug,
  storageKey,
  ghost,
  crest,
  crestFilter,
  crestShape = 'round',
  bandStart,
  bandEnd,
  bandGlow,
  previewOpen = false,
} = Astro.props;
// The measured stroke rides inline (it must beat the global html.dark rule);
// restate the lift with it, since an inline `filter` replaces the class's.
const CREST_LIFT = 'drop-shadow(0 6px 16px rgba(0, 0, 0, 0.35))';
const bandStyle = `--pmb-g1:${bandStart};--pmb-g2:${bandEnd};--pmb-glow:${bandGlow}`;
---

<dialog
  class="ui-modal twm"
  id={id}
  data-welcome-modal
  data-league={leagueSlug}
  data-storage-key={storageKey}
  aria-labelledby={`${id}-title`}
  open={previewOpen}
  tabindex="-1"
>
  <button type="button" class="twm__close" data-twm-close aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M14 4L4 14M4 4l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>

  <div class="twm__band pmb pmb--no-cutout" style={bandStyle}>
    <span class="pmb__ghost" aria-hidden="true">{ghost}</span>
    <div class="pmb__glow" aria-hidden="true"></div>
    {crest && (
      <img
        class:list={['twm__crest', { 'twm__crest--square': crestShape === 'square' }]}
        src={crest}
        alt=""
        width="112"
        height="112"
        style={crestFilter ? `filter:${crestFilter} ${CREST_LIFT}` : undefined}
      />
    )}
  </div>

  <div class="twm__body">
    <slot />
  </div>
</dialog>

<script>
  /**
   * CLIENTROUTER-SAFE INIT: re-run on every astro:page-load and look the
   * dialog up fresh — it lives in the swapped body, so whichever one is in the
   * DOM belongs to the page now showing, and the bound flag sits on that node.
   * There is one shared script (not a forked pair), so no other league's
   * listener can act on it. No document listeners beyond the page-load hook —
   * the dialog's own handlers go with it on the next swap.
   */
  const readSeen = (key: string): boolean => {
    try {
      return localStorage.getItem(key) === '1';
    } catch {
      // Storage blocked (private mode, policy) — show it rather than never.
      return false;
    }
  };
  const markSeen = (key: string) => {
    try {
      localStorage.setItem(key, '1');
    } catch {
      /* nothing to remember with */
    }
  };

  function init() {
    // Every welcome on the page is bound once; only the first unseen one opens.
    const dlg = Array.from(document.querySelectorAll<HTMLDialogElement>('dialog[data-welcome-modal][data-league]')).find(
      (d) => d.dataset.bound !== '1' && !d.open && d.dataset.storageKey && !readSeen(d.dataset.storageKey),
    );
    document.querySelectorAll<HTMLDialogElement>('dialog[data-welcome-modal]').forEach((d) => (d.dataset.bound = '1'));
    const key = dlg?.dataset.storageKey;
    if (!dlg || !key || typeof dlg.showModal !== 'function') return;

    dlg.querySelectorAll('[data-twm-close]').forEach((btn) => {
      btn.addEventListener('click', () => dlg.close());
    });
    // Click on the backdrop (the dialog box itself, outside the panel content).
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    markSeen(key);
    dlg.showModal();
    // Land on the dialog, not its first button — the close X opening with a
    // focus ring reads as if it were the default action.
    dlg.focus();
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .twm {
    padding: 0;
    width: calc(100% - 2rem);
    max-width: 440px;
    max-height: 88vh;
    overflow: hidden auto;
    animation: twm-enter 0.22s ease-out;
  }

  .twm:focus {
    outline: none;
  }

  @keyframes twm-enter {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Frosted chip over the band — same as the player card's close button. */
  .twm__close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    z-index: 3;
    background: rgba(6, 9, 13, 0.4);
    backdrop-filter: blur(2px);
    border: none;
    border-radius: var(--radius-full, 9999px);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .twm__close:hover {
    background: rgba(6, 9, 13, 0.65);
    color: #fff;
  }

  .twm__band {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 168px;
    padding: 1.5rem 1rem;
  }

  /* The crest is the subject here, not a watermark — full opacity, centred.
     Round slot + cover, like every crest slot on the site; a free-standing
     era mark is un-clipped by the global `iconFreeform` rule keyed on its src. */
  .twm__crest {
    position: relative;
    z-index: 1;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.35));
  }

  /* A drawn patch keeps its own corners, a little larger than a round crest. */
  .twm__crest--square {
    width: 132px;
    height: 132px;
    border-radius: 0;
    object-fit: contain;
  }

  .twm__body {
    padding: 1.25rem 1.5rem 1.5rem;
    text-align: center;
  }

  .twm :global(.twm__eyebrow) {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .twm :global(.twm__title) {
    margin: 0 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .twm :global(.twm__lead) {
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .twm :global(.twm__name) {
    font-size: var(--font-size-xl);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .twm :global(.twm__years) {
    color: var(--color-text-secondary);
    font-weight: 700;
    margin-right: 0.3em;
  }

  .twm :global(.twm__note) {
    margin: 0 0 1.25rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-secondary);
  }

  .twm :global(.twm__actions) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* The body is the caller's slot, so its classes are reached through
     :global under the dialog. */

  /* Shape only — colours, hover and focus come from the shared CTA pattern
     (src/styles/cta.css), which every base layout imports. */
  .twm :global(.twm__btn) {
    /* <a> and <button> differ here — only the button defaults to border-box,
       so without this the link's padding pushes it past the card. */
    box-sizing: border-box;
    width: 100%;
    min-height: var(--touch-target-min);
    font-size: var(--font-size-base);
  }

  /* Bottom sheet on a phone — the player card's mobile shape. */
  @media (max-width: 640px) {
    .twm {
      width: 100%;
      max-width: 100%;
      max-height: 92vh;
      margin: auto 0 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      animation-name: twm-sheet-enter;
    }

    .twm__body {
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @keyframes twm-sheet-enter {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .twm {
      animation: none;
    }
  }
</style>
