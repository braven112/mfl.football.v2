---
/**
 * Throwback Week settings — shared render for every league that runs it.
 *
 * Owner-facing picker: choose which legacy era your team wears during a
 * designated Throwback Week, plus a commissioner panel showing every
 * franchise's adoption state.
 *
 * The picker itself is `ThrowbackEraPicker` — the same component `/preferences`
 * renders beside the country and clock. This page owns the heading and the
 * commissioner panel and nothing else about the cards.
 *
 * One component, two routes. The auth gate, the league's config import and the
 * redirect all live in the thin route wrappers — a static import specifier
 * can't be a runtime variable, and `Astro.redirect()` only redirects from a
 * PAGE (from here it would return a blank 200). The shared decision behind the
 * data lives in `utils/throwback-settings-view.ts`.
 *
 * Every league-specific string arrives as a prop. `scoreboardPath` is the
 * league's live-scoring route ALREADY run through `resolveLeaguePath`, so
 * preview links stay correct on the apex domains where the league prefix is
 * hidden. It is the full path, not a base to concatenate onto: resolving the
 * bare prefix yields `/` on an apex domain, and `/` + `/live-scoring` is a
 * protocol-relative URL pointing at another host.
 */
import TheLeagueLayout from '../../layouts/TheLeagueLayout.astro';
import ThrowbackEraPicker from './ThrowbackEraPicker.astro';
import type { ThrowbackSettingsView } from '../../utils/throwback-settings-view';
import { eraBannerStyle } from '../../utils/era-banner-style';

interface Props {
  view: ThrowbackSettingsView;
  /** Page title, league-specific. */
  title: string;
  /** This league's live-scoring path, prefix already resolved. */
  scoreboardPath: string;
}

const { view, title, scoreboardPath } = Astro.props as Props;
const { previewWeek, isAdmin, storageAvailable, commishRows } = view;

const scoreboard = `${scoreboardPath}?week=${previewWeek}&demo=1`;
/** "Week 8" etc. — the copy must never hardcode TheLeague's Week 4. */
const weekLabel = `Week ${previewWeek}`;
---

<TheLeagueLayout title={title}>
  <main class="tbw-page">
    <header class="tbw-header">
      <h1>Throwback Week</h1>
    </header>

    <ThrowbackEraPicker view={view} scoreboardPath={scoreboardPath} />

    {isAdmin && (
      <section class="tbw-admin" aria-labelledby="tbw-admin-title">
        <h2 id="tbw-admin-title">Commissioner: every team's eras</h2>
        <p class="tbw-admin__intro">
          Each franchise's eligible eras, what they'll wear at {weekLabel} as of
          right now, and a scoreboard preview for any era on any team.
          Previews never save anything — only each owner can save their pick.
        </p>
        {!storageAvailable && (
          <p class="tbw-admin__warning">
            Preference storage is unavailable right now — showing every team on
            its default era.
          </p>
        )}
        {commishRows.map((row) => (
          <article class="tbw-cg" aria-label={row.teamName}>
            <header class="tbw-cg__head">
              <img class="tbw-cg__team-icon" src={row.icon} alt="" loading="lazy" />
              <span class="tbw-cg__team-name">{row.teamName}</span>
              <span class="tbw-cg__wears">
                {row.wearsName === null ? (
                  'no eligible eras — stays current'
                ) : (
                  <>
                    {row.hasPick ? (
                      <span class="tbw-cg__badge tbw-cg__badge--picked">picked</span>
                    ) : (
                      <span class="tbw-cg__badge">default</span>
                    )}
                    wears {row.wearsName} ({row.wearsYear})
                  </>
                )}
              </span>
            </header>
            {row.eras.length > 0 && (
              <div class="tbw-cg__eras">
                {row.eras.map((era) => (
                  <div class={`tbw-cg__era${era.isPicked ? ' tbw-cg__era--picked' : era.isDefault ? ' tbw-cg__era--default' : ''}`}>
                    <img
                      class="tbw-cg__banner"
                      src={era.banner}
                      alt={`${era.name} banner`}
                      style={eraBannerStyle(era)}
                      loading="lazy"
                    />
                    <div class="tbw-cg__era-body">
                      <img class="tbw-cg__era-icon" src={era.icon} alt="" loading="lazy" />
                      <div class="tbw-cg__era-meta">
                        <span class="tbw-cg__era-name">{era.name}</span>
                        <span class="tbw-cg__era-years">
                          {era.yearStart}{era.yearEnd ? `–${era.yearEnd}` : ''}
                          {era.eraLabel && ` · ${era.eraLabel}`}
                        </span>
                      </div>
                      <a
                        class="tbw-cg__preview"
                        href={`${scoreboard}&previewFranchise=${row.franchiseId}&previewEra=${era.key}`}
                        aria-label={`Preview ${row.teamName} as ${era.name} (${era.yearStart}) on the scoreboard`}
                      >
                        Preview →
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </article>
        ))}
      </section>
    )}
  </main>
</TheLeagueLayout>

<style>
  .tbw-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  .tbw-header h1 {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-2xl);
  }

  .tbw-admin {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--card-border);
  }

  .tbw-admin h2 {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-lg);
  }

  .tbw-admin__warning {
    color: var(--content-text-muted);
    font-style: italic;
  }

  .tbw-admin__intro {
    margin: 0 0 1rem;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
    max-width: 62ch;
  }

  .tbw-cg {
    margin-bottom: 1.25rem;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    overflow: hidden;
  }

  .tbw-cg__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--card-border);
  }

  /* Franchise crests are square art with ink to their own corners, not
     portraits — a round frame with object-fit: cover clipped the edges off.
     Contain in a square box so the whole crest shows. */
  .tbw-cg__team-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    object-position: center;
    flex-shrink: 0;
  }

  .tbw-cg__team-name {
    font-weight: 700;
    min-width: 0;
  }

  .tbw-cg__wears {
    margin-left: auto;
    font-size: var(--font-size-sm);
    color: var(--content-text-muted);
    text-align: right;
  }

  .tbw-cg__badge {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--content-text-muted);
    color: #fff;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .tbw-cg__badge--picked {
    background: var(--color-accent);
  }

  .tbw-cg__eras {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
    padding: 0.75rem 0.9rem 0.9rem;
  }

  .tbw-cg__era {
    border: 1px solid var(--card-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .tbw-cg__era--default {
    border-color: var(--content-text-muted);
  }

  .tbw-cg__era--picked {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .tbw-cg__banner {
    display: block;
    width: 100%;
    height: 56px;
    object-fit: contain;
    background: var(--content-border);
  }

  .tbw-cg__era-body {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
  }

  .tbw-cg__era-icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .tbw-cg__era-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tbw-cg__era-name {
    font-weight: 600;
    font-size: var(--font-size-sm);
  }

  .tbw-cg__era-years {
    font-size: var(--font-size-xs);
    color: var(--content-text-muted);
  }

  .tbw-cg__preview {
    margin-left: auto;
    flex: none;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .tbw-cg__preview:hover,
  .tbw-cg__preview:focus-visible {
    text-decoration: underline;
  }
</style>
