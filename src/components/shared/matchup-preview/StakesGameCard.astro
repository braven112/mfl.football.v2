---
/**
 * One game in the chart-led Matchup Preview (owner's "recommended mix", Nov
 * 2026): the rivalry and its last five meetings, both teams' last five weeks,
 * what the game does to their playoff (or bye) odds, and The Gauntlet's next
 * four weeks. Every section draws only when its data is on the snapshot.
 *
 * Owner's rule: the last-five-meetings scores stay on ONE line on a phone.
 */
import type { MatchupVisualsMatchup, MatchupStakesSide, GauntletStrip, LastFiveWeek } from '../../../types/schefter';
import { teamAccentVar } from '../../../utils/team-accent-css';
import type { MatchupTeam } from './MatchupPreviewSection.astro';
import { shortenParagraphs } from '../../../utils/article-paragraphs.mjs';
import { normalizeTeamCode } from '../../../utils/nfl-logo';
import MatchupMiniMap from './MatchupMiniMap.astro';
import type { StoredHometown } from '../../../utils/owner-hometowns';
import '../../../styles/playoff-race.css';

export interface Props {
  m: MatchupVisualsMatchup;
  teamA: MatchupTeam;
  teamB: MatchupTeam;
  kicker: string;
  rivalryHref?: string;
  /** Owner Map hometowns; the card draws its mini map only when both are set. */
  homeA?: StoredHometown | null;
  homeB?: StoredHometown | null;
}

const { m, teamA, teamB, kicker, rivalryHref, homeA = null, homeB = null } = Astro.props;
// Schefter's write-up for this game: plain text, rendered escaped, re-flowed
// into one- or two-sentence paragraphs like every column.
const story: string[] = shortenParagraphs(m.story ?? []);
// Chart rows are narrow on a phone: the abbreviation, never a clipped name.
const tag = (t: MatchupTeam) => t.abbrev ?? t.short;
// The header leads with the FULL name and falls back to a shorter one only
// when the full name will not fit its column (the script below measures).
const names = (t: MatchupTeam) => (t.names && t.names.length > 0 ? t.names : [t.name]);
const a = m.a.franchiseId;
const b = m.b.franchiseId;
// The NFL game that swings this one: most projected points across both
// teams' starters, the Sunday Ticket board's question asked of one game.
const keyGame = m.keyGame && m.keyGame.players.length > 0 ? m.keyGame : null;
// The week so far (Nov 2026): the score when the preview was written, after
// the week's early NFL games. Absent before the first kickoff.
const live = m.live ?? null;
const left = (n: number) => `${n} starter${n === 1 ? '' : 's'} left`;
const nfl = (code: string) => normalizeTeamCode(code);
// A defense's name is already "the Chicago Bears defense": no position prefix.
const playerLabel = (p: { position: string; name: string }) =>
  p.position === 'Def' ? p.name.replace(/^the /, '') : `${p.position} ${p.name}`;
const record = (s: { wins: number; losses: number; ties: number }) => `${s.wins}-${s.losses}${s.ties ? `-${s.ties}` : ''}`;
const pct = (x: number) => (x >= 0.995 && x < 1 ? '>99%' : x > 0 && x < 0.005 ? '<1%' : `${Math.round(x * 100)}%`);
const fmt = (x: number) => (Number.isInteger(x) ? String(x) : x.toFixed(0));

const series = m.series && !m.series.disputed ? m.series : null;
const seriesTotal = series ? series.aWins + series.bWins : 0;
const recent = m.recent ?? [];

// One bar scale for both teams, so the taller bar really is the bigger week.
const fa: LastFiveWeek[] = m.lastFive?.a ?? [];
const fb: LastFiveWeek[] = m.lastFive?.b ?? [];
const maxScore = Math.max(1, ...fa.map((w) => w.score), ...fb.map((w) => w.score));
const weekLabels = (fa.length >= fb.length ? fa : fb).map((w) => w.week);
const barH = (s: number) => `${Math.max(30, Math.round((s / maxScore) * 100))}%`;

const stakes = m.stakes && m.stakes.swing >= 0.01 ? m.stakes : null;
const key = stakes?.kind === 'bye' ? 'bye' : 'playoff';
const oddsRows = stakes
  ? ([[stakes.a, teamA, a], [stakes.b, teamB, b]] as Array<[MatchupStakesSide | null, MatchupTeam, string]>)
      .filter(([s]) => s)
  : [];

const ga: GauntletStrip | null = m.gauntlet?.a ?? null;
const gb: GauntletStrip | null = m.gauntlet?.b ?? null;
const gWeeks = (ga?.cells.length ?? 0) >= (gb?.cells.length ?? 0) ? ga?.cells ?? [] : gb?.cells ?? [];
const ordinal = (n: number) => {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return `${n}${s[(v - 20) % 10] ?? s[v] ?? s[0]}`;
};
---

<article class="sgc" style={`--sgc-a: ${teamAccentVar(a)}; --sgc-b: ${teamAccentVar(b)}; --mpv-a: var(--sgc-a); --mpv-b: var(--sgc-b)`}>
  <span class="sgc-kicker">{kicker}</span>
  <div class="sgc-head">
    <div class="sgc-team">
      {teamA.icon && <img src={teamA.icon} alt="" width="32" height="32" loading="lazy" />}
      <span class="sgc-id">
        <span class="sgc-name" style="color: var(--sgc-a)" data-names={JSON.stringify(names(teamA))}>{names(teamA)[0]}</span>
        <span class="sgc-rec sgc-num">{record(m.a)}</span>
      </span>
    </div>
    <span class="sgc-vs">vs</span>
    <div class="sgc-team sgc-team--b">
      {teamB.icon && <img src={teamB.icon} alt="" width="32" height="32" loading="lazy" />}
      <span class="sgc-id">
        <span class="sgc-name" style="color: var(--sgc-b)" data-names={JSON.stringify(names(teamB))}>{names(teamB)[0]}</span>
        <span class="sgc-rec sgc-num">{record(m.b)}</span>
      </span>
    </div>
  </div>

  {/* The two hometowns and the miles between them, under the names (owner's
      call, 2026-11-16: the map is back on every game card). */}
  <MatchupMiniMap homeA={homeA} homeB={homeB} teamA={teamA} teamB={teamB} routeId={`${a}-${b}`} />

  {live && (
    <div class="sgc-sec sgc-sofar">
      <h4>So far{live.through ? `, through ${live.through}` : ''}</h4>
      <div class="sgc-sofar-score" role="img" aria-label={`Score so far: ${teamA.name} ${live.a.score.toFixed(1)}, ${teamB.name} ${live.b.score.toFixed(1)}`}>
        <span class="sgc-lbl" style="color: var(--sgc-a)">{tag(teamA)}</span>
        <b class="sgc-num" style="color: var(--sgc-a)">{live.a.score.toFixed(1)}</b>
        <span class="sgc-sofar-dash">–</span>
        <b class="sgc-num" style="color: var(--sgc-b)">{live.b.score.toFixed(1)}</b>
        <span class="sgc-lbl" style="color: var(--sgc-b)">{tag(teamB)}</span>
      </div>
      <p class="sgc-swing">
        {([[live.a, teamA], [live.b, teamB]] as const).map(([side, team], i) => (
          <Fragment>{i > 0 && ' '}{team.short}: {left(side.left)}{side.projFinal != null && <Fragment>, projected <b>{Math.round(side.projFinal)}</b></Fragment>}.</Fragment>
        ))}
      </p>
      {live.done.length > 0 && (
        <ul class="sgc-keyp">
          {live.done.map((p) => (
            <li>
              <span class="sgc-lbl" style={`color: ${p.franchiseId === a ? 'var(--sgc-a)' : 'var(--sgc-b)'}`}>{tag(p.franchiseId === a ? teamA : teamB)}</span>
              <span class="sgc-keyname">{playerLabel(p)} <span class="sgc-keyteam">{nfl(p.nflTeam)} · final</span></span>
              <span class="sgc-num">{p.score.toFixed(1)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  {story.length > 0 && (
    <div class="sgc-story">
      {story.map((p) => <p>{p}</p>)}
    </div>
  )}

  {keyGame && (
    <div class="sgc-sec sgc-key">
      <h4>Key NFL game{live ? ' still to play' : ''}: {nfl(keyGame.away)} at {nfl(keyGame.home)}</h4>
      <p class="sgc-swing"><b class="sgc-num">{keyGame.projTotal.toFixed(1)}</b> projected points from these two lineups.</p>
      <ul class="sgc-keyp">
        {keyGame.players.map((p) => (
          <li>
            <span class="sgc-lbl" style={`color: ${p.franchiseId === a ? 'var(--sgc-a)' : 'var(--sgc-b)'}`}>{tag(p.franchiseId === a ? teamA : teamB)}</span>
            <span class="sgc-keyname">{playerLabel(p)} <span class="sgc-keyteam">{nfl(p.nflTeam)}</span></span>
            <span class="sgc-num">{p.proj.toFixed(1)}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="sgc-sec">
    <h4>The rivalry</h4>
    {series && seriesTotal > 0 ? (
      <div class="sgc-series sgc-num" role="img" aria-label={`All-time series: ${teamA.short} ${series.aWins}, ${teamB.short} ${series.bWins}${series.ties ? `, ${series.ties} ties` : ''}`}>
        <span style={`width:${((series.aWins / seriesTotal) * 100).toFixed(1)}%`}>{series.aWins}</span>
        <span style={`width:${((series.bWins / seriesTotal) * 100).toFixed(1)}%`}>{series.bWins}</span>
      </div>
    ) : (
      <p class="sgc-swing">First meeting under the current owners.</p>
    )}
    {recent.length > 0 && (
      <div class="sgc-meet" style={`grid-template-columns: repeat(${recent.length}, minmax(0, 1fr))`}>
        {recent.map((g) => (
          <div>
            <i style={`background: ${g.score >= g.opp ? 'var(--sgc-a)' : 'var(--sgc-b)'}`}></i>
            <b class="sgc-num">{fmt(g.score)}-{fmt(g.opp)}</b>
            <span>{g.year}</span>
          </div>
        ))}
      </div>
    )}
    {rivalryHref && series && <a class="sgc-link" href={rivalryHref}>The full rivalry</a>}
  </div>

  {(fa.length > 0 || fb.length > 0) && (
    <div class="sgc-sec">
      <h4>Last five weeks</h4>
      <div class="sgc-form">
        {([[fa, teamA, 'var(--sgc-a)'], [fb, teamB, 'var(--sgc-b)']] as Array<[LastFiveWeek[], MatchupTeam, string]>).map(([weeks, team, color]) => (
          <Fragment>
            <span class="sgc-lbl" style={`color: ${color}`}>{tag(team)}</span>
            <div class="sgc-bars" role="img" aria-label={`${team.name}, last five weeks: ${weeks.map((w) => `${w.score} ${w.result === 'S' ? 'split' : w.result}`).join(', ')}`}>
              {weeks.map((w) => (
                <div class={`sgc-bar sgc-bar--${w.result}`} style={`height:${barH(w.score)}`}>
                  <span class="sgc-num">{Math.round(w.score)}</span>
                </div>
              ))}
            </div>
          </Fragment>
        ))}
        <span></span>
        <div class="sgc-weeks">{weekLabels.map((wk) => <span>Wk {wk}</span>)}</div>
      </div>
    </div>
  )}

  {stakes && (
    <div class="sgc-sec">
      <h4>What's at stake: {key === 'bye' ? 'the bye' : 'the playoffs'}</h4>
      {oddsRows.map(([s, team, id]) => {
        const lo = s!.loss[key];
        const hi = s!.win[key];
        const now = s!.now[key];
        return (
          <div class="sgc-odds" role="img" aria-label={`${team.name}: ${pct(now)} ${key} odds today, ${pct(hi)} with a win, ${pct(lo)} with a loss`}>
            <span class="sgc-lbl" style={`color: ${id === a ? 'var(--sgc-a)' : 'var(--sgc-b)'}`}>{tag(team)}</span>
            <div class="sgc-otrack">
              <span class="sgc-orange" style={`left:${(lo * 100).toFixed(1)}%;width:${(Math.max(0, hi - lo) * 100).toFixed(1)}%`}></span>
              <span class="sgc-omark sgc-omark--lo" style={`left:${(lo * 100).toFixed(1)}%`}></span>
              <span class="sgc-omark sgc-omark--hi" style={`left:${(hi * 100).toFixed(1)}%`}></span>
              <span class="sgc-omark sgc-omark--now" style={`left:${(now * 100).toFixed(1)}%`}></span>
            </div>
            <span class="sgc-oval sgc-num">{pct(now)}</span>
          </div>
        );
      })}
      <p class="sgc-swing">
        {oddsRows.map(([s, team], i) => (
          <Fragment>{i > 0 && ' '}{team.short}: <b>{pct(s!.win[key])}</b> with a win, <b>{pct(s!.loss[key])}</b> with a loss.</Fragment>
        ))}
      </p>
    </div>
  )}

  {gWeeks.length > 0 && (
    <div class="sgc-sec">
      <h4>The Gauntlet: what's left</h4>
      <div class="sgc-gs" style={`--sgc-cols: ${gWeeks.length}`}>
        <span></span>
        {gWeeks.map((c) => <span class="sgc-gh">Wk {c.week}</span>)}
        <span class="sgc-gh">Rank</span>
        {([[ga, teamA, 'var(--sgc-a)'], [gb, teamB, 'var(--sgc-b)']] as Array<[GauntletStrip | null, MatchupTeam, string]>).map(([g, team, color]) => (
          <Fragment>
            <span class="sgc-lbl" style={`color: ${color}`}>{tag(team)}</span>
            {gWeeks.map((wk) => {
              const c = g?.cells.find((x) => x.week === wk.week);
              return c
                ? <span class={`sgc-cell sgc-cell--${c.bye ? 0 : c.step}`}>{c.bye ? 'Bye' : c.opps.join(' ')}</span>
                : <span class="sgc-cell sgc-cell--0">–</span>;
            })}
            <span class="sgc-rank sgc-num">{g?.rank ? ordinal(g.rank) : '–'}</span>
          </Fragment>
        ))}
      </div>
    </div>
  )}
</article>

<script>
  // Header names: show the longest of the team's names that fits its column
  // in at most two lines, never an ellipsis (owner's rule, Nov 2026). Text
  // width depends on the font and the phone, so this has to be measured.
  //
  // ClientRouter: this module evaluates once per session, so the listeners
  // below are registered once and re-query the swapped DOM on every run.
  const MAX_LINES = 2;

  function fitNames() {
    document.querySelectorAll<HTMLElement>('.sgc-name[data-names]').forEach((el) => {
      let names: string[];
      try {
        names = JSON.parse(el.dataset.names ?? '[]');
      } catch {
        return;
      }
      if (names.length < 2) return;
      const line = parseFloat(getComputedStyle(el).lineHeight) || el.offsetHeight;
      const fits = () => el.scrollWidth <= el.clientWidth + 1 && el.scrollHeight <= line * MAX_LINES + 1;
      for (const name of names) {
        el.textContent = name;
        if (fits()) return;
      }
    });
  }

  let resizeTimer: number | undefined;
  document.addEventListener('astro:page-load', fitNames);
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(fitNames, 150);
  });
  // Web fonts change the measure: re-fit once they land.
  document.fonts?.ready.then(fitNames);
</script>
