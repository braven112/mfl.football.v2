---
/**
 * The Owners' Poll on the homepage — the once-a-week quick-vote pop-up only.
 *
 * The homepage used to carry a permanent poll card (top five + "Change your
 * vote") with this pop-up inside it. The card came off in Oct 2026: nobody
 * used it, and on a phone it sat between the hero and the owner's own team.
 * The pop-up is what actually collects ballots, so it stays — for owners with
 * no ballot or a stale one — and the ranking itself lives on the poll page and
 * in the Pecking Order column.
 */
import { ensureLeaguePrefix, getLeagueBySlug, leagueClock } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import OwnersPollPopup from './OwnersPollPopup';
import { buildBallotTeams, type BallotStandingsRow } from '../../../utils/owners-poll-ballot-teams';
// The pop-up renders the poll page's BallotBuilder, so it needs that page's styles.
import '../../../styles/owners-poll.css';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** The poll page, where the full ballot lives. */
  ballotHref: string;
  /**
   * Standings rows from the NEWEST issue (`newestIssueStandings`) — the stats
   * on the pop-up's ballot cards. Empty is fine; the cards lose their line.
   */
  ballotStandings?: BallotStandingsRow[];
}

const { leagueSlug, ballotHref, ballotStandings = [] } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const ballotTeams = buildBallotTeams(leagueSlug, ballotStandings);
const vapidPublicKey = (import.meta.env.PUBLIC_VAPID_PUBLIC_KEY as string | undefined) ?? '';
---

<!--
  client:idle, NEVER client:visible: the pop-up renders nothing until it knows
  whether THIS viewer owes a ballot, so a client:visible island has zero
  height, never intersects, and never hydrates.
-->
<OwnersPollPopup
  client:idle
  leagueSlug={league.slug}
  leagueParam={league.navSlug}
  teams={ballotTeams}
  slots={league.ownersPoll.slots}
  ballotHref={ballotHref}
  columnHref={ensureLeaguePrefix(league, '/pecking-order')}
  officialClock={leagueClock(league.slug)}
  vapidPublicKey={vapidPublicKey}
/>
