---
/**
 * The Owners' Poll page — shared implementation.
 *
 * Every league that runs the poll renders this through a thin route wrapper
 * (see src/pages/theleague/owners-poll/index.astro). The auth gate is NOT
 * here: `Astro.redirect()` only redirects from a page, so the routes own it
 * and hand the resolved session down.
 *
 * The flow is vote → see the results. The latest owner rankings render here,
 * and only for an owner with a ballot on file (`resultsUnlocked`); everyone
 * else gets the ballot and a locked card saying what voting unlocks. Every
 * Claude post about the poll links to this page for exactly that reason.
 *
 * Team cards are ordered ALPHABETICALLY, never by the Pecking Order composite.
 * The column already published the machine's ranking, and re-sorting the
 * ballot by it would anchor every owner to that order — which is precisely the
 * thing the poll exists to disagree with. Records and PPG are shown as neutral
 * context; the composite rank is deliberately absent from the card.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import BallotBuilder from './BallotBuilder';
import PollWindowAdmin from './PollWindowAdmin';
import OwnersPollResults, { type OwnersPollBlock } from './OwnersPollResults.astro';
import { getLeagueTeamBrands } from '../../../utils/league-team-brands';
import { ensureLeaguePrefix, leagueClock, type LeagueDefinition } from '../../../config/leagues';
import { isCommissionerOrAdmin } from '../../../utils/auth';
import '../../../styles/owners-poll.css';
import type { AuthUser } from '../../../utils/auth';

/** The slice of a Pecking Order issue this page reads for card context. */
export interface BallotStandingsRow {
  franchiseId: string;
  wins?: number;
  losses?: number;
  ties?: number;
  ppg?: number;
}

interface Props {
  league: LeagueDefinition;
  user: AuthUser;
  /**
   * Standings rows from the most recent issue, for card context. Passed in by
   * the ROUTE because the issue glob has to be a literal per league.
   * Empty is fine — the cards just lose their record line.
   */
  standings: BallotStandingsRow[];
  /** The newest closed week with a consensus, or null before the first one. */
  result: { week: number; poll: OwnersPollBlock } | null;
  /** Franchise config by id — names and crests for the results table. */
  teamConfigs: Map<string, any>;
  /** False only when the viewer positively has no ballot in an open poll. */
  resultsUnlocked: boolean;
}

const { league, user, standings, result, teamConfigs, resultsUnlocked } = Astro.props as Props;

const poll = league.ownersPoll;
const brands = getLeagueTeamBrands(league.slug);
const byFranchise = new Map(standings.map((row) => [row.franchiseId, row]));

const teams = Object.values(brands)
  .map((brand) => {
    const row = byFranchise.get(brand.franchiseId);
    const wins = row?.wins;
    const losses = row?.losses;
    const ties = row?.ties;
    return {
      ...brand,
      record:
        wins != null && losses != null
          ? `${wins}-${losses}${ties ? `-${ties}` : ''}`
          : null,
      ppg: row?.ppg ?? null,
    };
  })
  // Alphabetical — see the anchoring note above.
  .sort((a, b) => a.nameShort.localeCompare(b.nameShort));

const columnHref = ensureLeaguePrefix(league, '/pecking-order');
const votersHref = ensureLeaguePrefix(league, '/owners-poll/voters');
const showResults = Boolean(result) && resultsUnlocked;
const locked = Boolean(result) && !resultsUnlocked;

// The panel renders for a commissioner only. Gated on the SERVER as well as
// inside the island: shipping the control markup to every owner and hiding it
// with a client check is the kind of gate view-source defeats.
const isCommish = isCommissionerOrAdmin(user);

// Empty when push isn't configured on this deployment; the prompt then renders
// nothing rather than offering a button that cannot work.
const vapidPublicKey = (import.meta.env.PUBLIC_VAPID_PUBLIC_KEY as string | undefined) ?? '';
---

<TheLeagueLayout title={`The Owners’ Poll | ${league.name}`}>
  <div class="op-page">
    <header class="op-hero">
      <h1 class="op-hero__title">The Owners’ Poll</h1>
      <p class="op-hero__lede">
        The computer ranks the league by the numbers. This is where the owners
        get a say. Rank your top {poll.slots} — your own team included, if you
        think you belong there — and see how the whole room voted.
      </p>
    </header>

    {showResults && result && (
      <OwnersPollResults poll={result.poll} teams={teamConfigs} week={result.week} />
    )}

    {locked && (
      <aside class="op-callout op-locked" aria-label="The owners' rankings are locked">
        <strong>🔒 Vote to see the owners’ rankings</strong>
        <p>
          The full Week {result!.week} owners’ rankings — every team’s points,
          first-place votes and how far the room sits from the computer — unlock
          as soon as your ballot is in.
        </p>
      </aside>
    )}

    {isCommish && (
      <PollWindowAdmin
        client:load
        leagueParam={league.navSlug}
        slots={poll.slots}
      />
    )}

    <BallotBuilder
      client:load
      teams={teams}
      slots={poll.slots}
      leagueParam={league.navSlug}
      ownFranchiseId={user.franchiseId}
      columnHref={columnHref}
      revealOnSave={locked}
      vapidPublicKey={vapidPublicKey}
      officialClock={leagueClock(league.slug)}
    />

    <footer class="op-footnote">
      <p>
  Every ballot is worth the same: {poll.slots} points for your first pick
        down to 1 for your {poll.slots}th. However many ballots come in, that
        is the result — there is no minimum.
      </p>
      <p>
        <strong>Voting is always open.</strong> Your ballot stands until you
        change it — you do not file a new one each week. Change it before the
        next count and it applies to that result; change it after and it
        applies to the following one.
      </p>
      <p>
        Ballots stay private until the count is taken, then publish on the{' '}
        <a href={votersHref}>voters page</a>.
      </p>
    </footer>
  </div>
</TheLeagueLayout>
