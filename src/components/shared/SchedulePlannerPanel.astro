---
/**
 * Shared body for the schedule planner pages.
 *
 * NO AUTH GATE LIVES HERE. `Astro.redirect()` returned from a COMPONENT does
 * not redirect — it just stops rendering that component and the response is
 * still a 200 with a blank body. The gate belongs in each thin route wrapper
 * (see docs/claude/rules/schedule-optimization.md and the same note in
 * CLAUDE.md about /cr).
 */
import SchedulePlanner from './SchedulePlanner.tsx';
import { scheduleConstraints, TIER_LABEL } from '../../utils/schedule-constraints.mjs';
import '../../styles/schedule-planner.css';

interface Props {
  leagueSlug: string;
  leagueName: string;
  defaultYear: number;
  /** Seasons we hold an NFL bye calendar for — the only schedulable ones. */
  seasons: number[];
}
const { leagueSlug, leagueName, defaultYear, seasons } = Astro.props;
// No `season` here, deliberately. The builder DRAWS a schedule, so it applies
// every rule the league has adopted, whichever year it is pointed at — the
// planner is always current. Only the reveal page passes a season, because it
// DISPLAYS a draw that already happened and must not backdate a rule onto it.
const constraints = scheduleConstraints();
---

<section class="schedplan">
  <header class="schedplan__head">
    <h1>Schedule Builder</h1>
    <p>
      Generates {leagueName}&rsquo;s regular season against this year&rsquo;s NFL bye calendar, then hands you the
      text to paste into MFL. Nothing here writes to MFL &mdash; MFL has no schedule write API, so the paste is
      always yours to make.
    </p>
  </header>

  <SchedulePlanner
    client:load
    leagueSlug={leagueSlug}
    leagueName={leagueName}
    defaultYear={defaultYear}
    seasons={seasons}
  />

  <footer class="schedplan__foot">
    <h2>What it enforces, in priority order</h2>
    {/* Same ordered list the reveal page and Schefter's column read, so the
        three cannot drift into three different accounts of what outranks
        what. The order is the order the planner applies. */}
    <ol class="schedplan__rules">
      {constraints.map((c) => (
        <li>
          <span class="schedplan__tier">{TIER_LABEL[c.tier]}</span>
          {c.rule}
        </li>
      ))}
    </ol>
    <p class="schedplan__stale">
      New season? Refresh the NFL bye calendar first: <code>node scripts/fetch-nfl-bye-weeks.mjs</code>. Without it
      this page has nothing to schedule against and will say so.
    </p>
  </footer>
</section>

<style>
  .schedplan {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .schedplan__head h1 {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
    color: var(--color-text-primary, #0f172a);
  }

  .schedplan__head p {
    max-width: 46rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary, #475569);
  }

  .schedplan__foot {
    padding: 1rem;
    background: var(--color-surface-2, #f8fafc);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: 10px;
  }

  .schedplan__foot h2 {
    margin: 0 0 0.6rem;
    font-size: 0.9375rem;
    color: var(--color-text-primary, #0f172a);
  }

  .schedplan__rules {
    margin: 0;
    padding-left: 1.35rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #475569);
  }

  .schedplan__rules li {
    margin-bottom: 0.3rem;
  }

  /* The tier in words, not only in position — the number says WHERE a rule
     sits, this says what happens when it loses. */
  .schedplan__tier {
    display: inline-block;
    margin-right: 0.4rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-disabled, #94a3b8);
  }

  .schedplan__stale {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-secondary, #475569);
  }

  .schedplan__stale code {
    padding: 0.1em 0.35em;
    background: var(--color-surface-3, #eef2f7);
    border-radius: 4px;
  }
</style>
