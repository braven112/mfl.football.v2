---
/**
 * The custom-site demo's standing notice (docs/plans/custom-site-demo.md):
 * shown on every page of a demo deployment, nowhere else.
 *
 * Two jobs. It tells a prospect nothing they do is real — the moment a lineup
 * "saves", someone will wonder whether it went anywhere. And it carries the
 * pitch: the salary-cap extras they are looking at were built for this kind of
 * league, and a purchased site is built around theirs.
 *
 * Hard-coded colours for the same reason as StagingBanner: a notice that
 * restyles itself into the page's palette stops being noticed, and a token
 * with no dark value ships unreadable in one theme.
 *
 * It scrolls away with the page rather than pinning to the top, and a prospect
 * can close it for the rest of the visit (sessionStorage). Pinned at z-index
 * 9999 it sat over every modal's close button.
 */
import { isDemoDeploy } from '../../utils/deploy-environment';
import { demoLeaguePaths } from '../../config/leagues-data.mjs';
import { getLeagueBySlug } from '../../config/leagues';

const show = isDemoDeploy();
// Which demo this page belongs to: the first path segment is a demo path
// (`/redraft/...`) or, after the middleware's rewrite, the slot's own slug.
const segment = Astro.url.pathname.split('/')[1] ?? '';
const slug = demoLeaguePaths()[segment] ?? segment;
const bestBall = Boolean(getLeagueBySlug(slug)?.bestBall);
const pitch = bestBall
	? 'The draft room, board and mock drafts here were built for this league; your site is built around how yours works.'
	: slug === 'keeper'
		? 'The keeper planner and every tool here were built for this league; your site is built around how yours works.'
		: slug === 'afl-fantasy'
		? 'The conference standings, tier tables and playoff brackets here were built for this league; your site is built around how yours works.'
		: 'The salary-cap tools here were built for this league; your site is built around how yours works.';
---

{
	show && (
		<div class="demo-banner" role="note" data-demo-banner>
			<span class="demo-banner__label">Demo</span>
			<span class="demo-banner__detail">
				A fictional league — nothing is sent to MyFantasyLeague. {pitch}
			</span>
			<button type="button" class="demo-banner__close" data-demo-banner-close aria-label="Dismiss the demo notice">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
			</button>
		</div>
	)
}

<style>
	.demo-banner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		padding: 0.4rem 2.75rem;
		background: #14213d;
		color: #f8fafc;
		font-size: 0.8125rem;
		line-height: 1.35;
		text-align: center;
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
	}

	.demo-banner__label {
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.05rem 0.45rem;
		border-radius: 0.25rem;
		background: #fca311;
		color: #14213d;
	}

	.demo-banner__detail {
		max-width: 60rem;
	}

	.demo-banner__close {
		position: absolute;
		top: 50%;
		right: 0.5rem;
		transform: translateY(-50%);
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.demo-banner__close:hover,
	.demo-banner__close:focus-visible {
		background: rgba(255, 255, 255, 0.15);
	}

	.demo-banner__close:focus-visible {
		outline: 2px solid #fca311;
		outline-offset: 1px;
	}

	:global(html.demo-banner-dismissed) .demo-banner {
		display: none;
	}
</style>

<script>
	// Hide on every page once closed this visit. Re-read per page load: the
	// ClientRouter swaps the banner in fresh on each navigation, but <html>
	// (and its class) survives, so the class is re-asserted from storage.
	const KEY = 'demoBannerDismissed';
	function readDismissed() {
		try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; }
	}
	function init() {
		if (readDismissed()) document.documentElement.classList.add('demo-banner-dismissed');
		const close = document.querySelector<HTMLButtonElement>('[data-demo-banner-close]');
		if (!close || close.dataset.bound) return;
		close.dataset.bound = '1';
		close.addEventListener('click', () => {
			document.documentElement.classList.add('demo-banner-dismissed');
			try { sessionStorage.setItem(KEY, '1'); } catch {}
		});
	}
	document.addEventListener('astro:page-load', init);
	// The router copies the new page's <html> attributes over, dropping the
	// class; put it back before paint rather than waiting for page-load.
	document.addEventListener('astro:after-swap', () => {
		if (readDismissed()) document.documentElement.classList.add('demo-banner-dismissed');
	});
</script>
