---
/**
 * One service page, rendered from src/data/mfl-services.ts. The order is
 * deliberate for search and AI answer tools: the H1 carries the phrase people
 * search for, the first paragraph answers "what is this?" on its own, and the
 * FAQ is plain visible text marked up as FAQPage, so a tool that quotes one
 * answer quotes the whole answer.
 */
import MarketingShell from './MarketingShell.astro';
import { ALL_LEAGUES, crossHostLeagueHref } from '../../../config/leagues';
import { SERVICES, FORMER_BRAND, type Service } from '../../../data/mfl-services';
import { breadcrumbJsonLd, faqJsonLd, organizationJsonLd, serviceJsonLd } from '../../../utils/structured-data';

export interface Props {
	service: Service;
}

const { service } = Astro.props as Props;

// The leagues the homepage advertises (src/pages/index.astro): full-management
// leagues their owners have agreed to show. They are the live examples.
const exampleLeagues = ALL_LEAGUES.filter((l) => !l.bestBall && l.advertiseOnSharedHost !== false);
const examples = service.examplePaths.flatMap((ex) =>
	exampleLeagues.map((league) => ({
		label: ex.label,
		body: ex.body,
		league: league.name,
		href: crossHostLeagueHref(Astro.url.hostname, `/${league.slug}${ex.suffix}`),
	})),
);

const others = SERVICES.filter((s) => s.slug !== service.slug);

const jsonLd = [
	organizationJsonLd(),
	serviceJsonLd(service),
	faqJsonLd(service.faqs),
	breadcrumbJsonLd([
		{ name: 'MFL.football', path: '/' },
		{ name: service.eyebrow, path: service.path },
	]),
];
const isExternal = (href: string) => /^https?:/.test(href);

// The hero's league card is the proof: the first league running this service,
// linked to its real site. A service with no live example gets a solo hero.
const proof = exampleLeagues[0]
	? {
			name: exampleLeagues[0].name,
			host: exampleLeagues[0].domains?.[0],
			href: crossHostLeagueHref(Astro.url.hostname, `/${exampleLeagues[0].slug}`),
		}
	: null;
---

<MarketingShell title={service.title} description={service.description} canonicalPath={service.path} jsonLd={jsonLd}>
	<article class="svc">
		<header class:list={['sp-hero', { 'sp-hero--solo': !proof || examples.length === 0 }]}>
			<div class="sp-hero__copy">
				<p class="sp-eyebrow"><span>{service.eyebrow} <span class="svc-former">· Formerly {FORMER_BRAND}</span></span></p>
				<h1>{service.h1}</h1>
				<p class="svc-answer">{service.answer}</p>
				<p class="sp-lede">{service.lede}</p>
				<div class="sp-ctas">
					{service.cta.kind === 'interest' ? (
						<button type="button" class="cta cta--primary" data-interest={service.cta.product} data-interest-name={service.cta.name}>
							{service.cta.label}
						</button>
					) : (
						<a class="cta cta--primary" href={service.cta.href}>{service.cta.label}</a>
					)}
					{service.secondary && (
						<a class="cta cta--ghost" href={service.secondary.href} rel={isExternal(service.secondary.href) ? 'noopener' : undefined}>
							{service.secondary.label}
						</a>
					)}
				</div>
			</div>
			{proof && examples.length > 0 && (
				<div class="sp-hero__visual">
					<a class="sp-lcard svc-lcard" href={proof.href}>
						<span class="sp-lcard__top">
							<span>
								<span class="sp-lcard__name">{proof.name}</span><br />
								<span class="sp-lcard__meta">Running {service.navLabel.toLowerCase()} today</span>
							</span>
							<svg class="sp-lcard__ball" viewBox="-10 -8 20 16" aria-hidden="true"><path d="M-6.5 0Q0-5.4 6.5 0Q0 5.4-6.5 0Z" stroke-width="3" stroke-linejoin="round" transform="rotate(-15)" /></svg>
						</span>
						{proof.host && <span class="sp-lcard__host">{proof.host}</span>}
						<span class="sp-lcard__row">
							<span class="sp-lcard__label">Run by MFL.football</span>
							<span class="sp-lcard__label">See it live →</span>
						</span>
					</a>
				</div>
			)}
		</header>

		<section class="sp-section" aria-labelledby="svc-what">
			<div class="sp-head">
				<div class="sp-head__title">
					<p class="sp-eyebrow">What's included</p>
					<h2 id="svc-what">What you get</h2>
				</div>
			</div>
			<ul class:list={['sp-grid', { 'sp-grid--4': service.features.length % 4 === 0 }]}>
				{service.features.map((f) => (
					<li class="ui-card sp-card">
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</li>
				))}
			</ul>
		</section>

		{examples.length > 0 && (
			<section class="sp-section" aria-labelledby="svc-live">
				<div class="sp-head">
					<div class="sp-head__title">
						<p class="sp-eyebrow">See it running</p>
						<h2 id="svc-live">See it live</h2>
					</div>
					<p class="sp-head__note">Real MFL leagues running on MFL.football today. Tap through; nothing to sign up for.</p>
				</div>
				<ul class="sp-grid">
					{examples.map((ex) => (
						<li class="svc-cell">
							<a class="ui-card sp-card" href={ex.href}>
								<span class="sp-card__who">{ex.league}</span>
								<h3>{ex.label}</h3>
								<p>{ex.body}</p>
								<span class="sp-card__more">Open</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<section class="sp-section" aria-labelledby="svc-faq">
			<div class="sp-head">
				<div class="sp-head__title">
					<p class="sp-eyebrow">Questions</p>
					<h2 id="svc-faq">Questions</h2>
				</div>
			</div>
			<dl class="svc-faq">
				{service.faqs.map((f) => (
					<div class="ui-card sp-card">
						<dt>{f.q}</dt>
						<dd>{f.a}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="sp-band sp-band--cta" aria-labelledby="svc-cta">
			<div class="sp-band__copy">
				<p class="sp-eyebrow">{service.eyebrow}</p>
				<h2 id="svc-cta">{service.cta.kind === 'interest' ? 'Want this for your league?' : 'Ready when you are.'}</h2>
			</div>
			<div class="sp-ctas">
				{service.cta.kind === 'interest' ? (
					<button type="button" class="cta cta--primary" data-interest={service.cta.product} data-interest-name={service.cta.name}>
						{service.cta.label}
					</button>
				) : (
					<a class="cta cta--primary" href={service.cta.href}>{service.cta.label}</a>
				)}
				{proof && examples.length > 0 && <a class="cta cta--ghost" href={proof.href}>Visit {proof.host ?? proof.name}</a>}
			</div>
		</section>

		<section class="sp-section" aria-labelledby="svc-more">
			<div class="sp-head">
				<div class="sp-head__title">
					<p class="sp-eyebrow">More</p>
					<h2 id="svc-more">More for MFL leagues</h2>
				</div>
			</div>
			<ul class="sp-grid">
				{others.map((s) => (
					<li class="svc-cell">
						<a class="ui-card sp-card" href={s.path}>
							<h3>{s.eyebrow}</h3>
							<p>{s.description}</p>
							<span class="sp-card__more">Learn more</span>
						</a>
					</li>
				))}
				<li class="svc-cell">
					<a class="ui-card sp-card" href="/compare">
						<h3>How MFL.football compares</h3>
						<p>Next to free MFL scripts, MFLHistory.com and MFL’s default skins.</p>
						<span class="sp-card__more">Compare</span>
					</a>
				</li>
			</ul>
		</section>
	</article>
</MarketingShell>

<style>
	/* Page layout only; every surface comes from src/styles/soft-premium.css. */
	.svc-former {
		font-weight: 600;
		letter-spacing: 0.06em;
	}

	.sp-hero h1 {
		font-size: clamp(2.1rem, 5vw, 3.5rem);
	}

	.svc-answer {
		max-width: 56ch;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.5;
		color: var(--sp-ink);
	}

	.svc-lcard {
		margin-inline: auto;
	}

	/* A linked card fills its grid cell; the li is only a wrapper. */
	.svc-cell {
		display: flex;
	}

	.svc-cell > .sp-card {
		flex: 1;
	}

	.svc-faq {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
	}

	.svc-faq dt {
		font-weight: 700;
		font-size: var(--sp-text-base);
	}

	.svc-faq dd {
		margin: 0;
		font-size: var(--sp-text-md);
		line-height: 1.55;
		color: var(--sp-muted);
	}

	@media (max-width: 760px) {
		.svc-faq {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
