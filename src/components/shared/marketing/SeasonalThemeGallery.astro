---
/**
 * The before-and-after gallery on /mfl-league-themes. Every mark here is a
 * real file from The League's and the AFL's seasonal sets
 * (src/config/seasonal-themes.mjs), shown next to the regular mark it
 * replaces. Halloween marks are drawn as pale silhouettes, so their "after"
 * tile always sits on a dark ground, in both site themes. Teams were picked
 * for safe-for-work names and no real-person likenesses.
 */
import { LEAGUES } from '../../../config/leagues';

interface Pair {
	label: string;
	before: string;
	after: string;
}
interface Group {
	title: string;
	pairs: Pair[];
}
interface Theme {
	id: 'halloween' | 'christmas';
	name: string;
	shot: string;
	shotAlt: string;
	groups: Group[];
}

const TL = LEAGUES.theleague.slug;
const AFL = LEAGUES['afl-fantasy'];
// AFL art lives under its nav slug (public/assets/afl/…), not the registry slug.
const A = 'afl';

const TL_TEAMS: [string, string, string][] = [
	['0001', 'Pacific Pigskins', 'pigskins'],
	['0009', 'Wascawy Wabbits', 'wabbits'],
	['0013', 'Gridiron Geeks', 'geeks'],
	['0010', 'Computer Jocks', 'computer_jocks'],
	['0015', 'Dark Magicians of Chaos', 'dark_magicians'],
	['0016', 'Running down the Dream', 'the_dream'],
];
const AFL_TEAMS: [string, string, string][] = [
	['0003', 'Team Minty Fresh', 'minty'],
	['0020', 'The Boondock Saints', 'saints'],
	['0024', 'No Soup For You', 'no_soup'],
	['0021', 'Chatmaster', 'chat'],
	['0019', 'Badd Boys', 'badd_boys'],
	['0007', 'Avenging Amish', 'amish'],
];
const DIVISIONS = ['central', 'east', 'northwest', 'southwest'];
const title = (s: string) => s.replace(/(^|\s)\S/g, (c) => c.toUpperCase());

function groupsFor(theme: 'halloween' | 'christmas'): Group[] {
	const ext = theme === 'halloween' ? 'svg' : 'png';
	const tl = `/assets/${TL}/${theme}-marks`;
	const afl = `/assets/${A}/${theme}-marks`;
	return [
		{
			title: 'League logos',
			pairs: [
				{ label: LEAGUES.theleague.name, before: '/assets/logos/theleague-logo.svg', after: `${tl}/logo.${ext}` },
				{ label: AFL.name, before: '/assets/logos/afl-logo.svg', after: `${afl}/logo.${ext}` },
			],
		},
		{
			title: 'Division, tier and conference logos',
			pairs: [
				...DIVISIONS.map((d) => ({
					label: `${title(d)} Division`,
					before: `/assets/${TL}/division-badges/${d}.svg`,
					after: `${tl}/division-badges/${d}.${ext}`,
				})),
				{ label: 'AFL Premier League', before: `/assets/${A}/premier.svg`, after: `${afl}/premier.${ext}` },
				{ label: 'AFL D-League', before: `/assets/${A}/dleague.svg`, after: `${afl}/dleague.${ext}` },
				{ label: 'American League', before: `/assets/${A}/conferences/al.svg`, after: `${afl}/conferences/al.${ext}` },
				{ label: 'National League', before: `/assets/${A}/conferences/nl.svg`, after: `${afl}/conferences/nl.${ext}` },
			],
		},
		{
			title: 'Team logos',
			pairs: [
				...TL_TEAMS.map(([id, name, icon]) => ({
					label: name,
					before: `/assets/${TL}/icons/${icon}.png`,
					after: `${tl}/${id}.png`,
				})),
				...AFL_TEAMS.map(([id, name, icon]) => ({
					label: name,
					before: `/assets/${A}/icons/${icon}.png`,
					after: `${afl}/${id}.png`,
				})),
			],
		},
	];
}

const THEMES: Theme[] = [
	{
		id: 'halloween',
		name: 'Halloween',
		shot: '/assets/home/theme-halloween.webp',
		shotAlt: 'The League’s standings page in its Halloween theme',
		groups: groupsFor('halloween'),
	},
	{
		id: 'christmas',
		name: 'Christmas Week',
		shot: '/assets/home/theme-christmas.webp',
		shotAlt: 'The League’s standings page in its Christmas theme',
		groups: groupsFor('christmas'),
	},
];

const OWN_SEASONS = [
	{ name: 'Breast Cancer Awareness Month', body: 'A pink palette for October, with every team logo wearing the ribbon.' },
	{ name: 'Military Appreciation Month', body: 'A camouflage and flag palette for November, with salute versions of each logo.' },
	{ name: 'Thanksgiving', body: 'An autumn palette for the holiday week. We have not built this one yet; it is next in line.' },
	{ name: 'Your league’s own event', body: 'A founder’s anniversary, a draft weekend, a trip: any week or two you choose.' },
];

const regularShot = '/assets/home/theme-regular.webp';
---

<section class="sp-section stg" aria-labelledby="stg-title">
	<h2 id="stg-title" class="visually-hidden">Before and after</h2>

	<figure class="stg__shot">
		<img src={regularShot} alt="The League’s standings page in its regular look" width="1200" height="560" loading="lazy" decoding="async" />
		<figcaption>Regular</figcaption>
	</figure>

	{THEMES.map((theme) => (
		<div class={`stg__theme stg__theme--${theme.id}`}>
			<h3 class="stg__name">{theme.name}</h3>
			<figure class="stg__shot">
				<img src={theme.shot} alt={theme.shotAlt} width="1200" height="560" loading="lazy" decoding="async" />
				<figcaption>{theme.name}</figcaption>
			</figure>
			{theme.groups.map((group) => (
				<div class="stg__group">
					<h4>{group.title}</h4>
					<ul class="stg__pairs">
						{group.pairs.map((p) => (
							<li class="stg__pair">
								<div class="stg__tiles">
									<span class="stg__tile stg__tile--before">
										<img src={p.before} alt={`${p.label}, regular logo`} loading="lazy" decoding="async" />
									</span>
									<span class="stg__arrow" aria-hidden="true">→</span>
									<span class="stg__tile stg__tile--after">
										<img src={p.after} alt={`${p.label}, ${theme.name} logo`} loading="lazy" decoding="async" />
									</span>
								</div>
								<span class="stg__label">{p.label}</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	))}
</section>

<section class="sp-section stg" aria-labelledby="stg-own">
	<div class="sp-head">
		<div class="sp-head__title">
			<p class="sp-eyebrow">Made to order</p>
			<h2 id="stg-own">Your own season</h2>
		</div>
		<p class="sp-head__note">Pick any week or two. We build the colors and remake the logos for it.</p>
	</div>
	<ul class="sp-grid sp-grid--4">
		{OWN_SEASONS.map((s) => (
			<li class="ui-card sp-card">
				<h3>{s.name}</h3>
				<p>{s.body}</p>
			</li>
		))}
	</ul>
	<p class="stg__note">These are examples of what we can build. Only Halloween and Christmas Week exist today.</p>
</section>

<style>
	/* Soft Premium (src/styles/soft-premium.css): surfaces, ink and type
	   come from the --sp-* tokens, like the rest of the service page. */
	.stg {
		padding-top: 1rem;
	}
	.stg__note {
		margin-top: 1rem;
		font-size: var(--sp-text-sm);
		color: var(--sp-muted);
	}
	.stg__theme {
		margin-top: 2.5rem;
	}
	.stg__name {
		font-size: var(--sp-text-2xl);
	}
	.stg__shot {
		margin: 1rem 0;
	}
	.stg__shot img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--sp-radius-sm);
		box-shadow: var(--sp-shadow);
	}
	.stg__shot figcaption {
		margin-top: 0.6rem;
		font-size: var(--sp-text-sm);
		font-weight: 600;
		color: var(--sp-muted);
	}
	.stg__group h4 {
		font-size: var(--sp-text-lg);
		margin: 1.75rem 0 0.85rem;
	}
	.stg__pairs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 1rem;
	}
	.stg__pair {
		padding: 0.9rem;
		border-radius: var(--sp-radius-sm);
		background: var(--sp-surface);
		box-shadow: var(--sp-shadow);
	}
	.stg__tiles {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem;
	}
	.stg__tile {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		border-radius: 14px;
		padding: 0.6rem;
		/* A fixed light ground in both site themes: the regular marks are
		   drawn for white, and some carry dark ink. */
		background: #f2f3f5;
	}
	.stg__tile img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
	.stg__theme--halloween .stg__tile--after {
		background: #1b1724;
	}
	.stg__arrow {
		color: var(--sp-red);
	}
	.stg__label {
		display: block;
		margin-top: 0.6rem;
		font-size: var(--sp-text-sm);
		font-weight: 600;
		text-align: center;
		color: var(--sp-ink);
	}
	@media (max-width: 640px) {
		.stg__pairs {
			grid-template-columns: 1fr 1fr;
			gap: 0.75rem;
		}
		.stg__pair {
			padding: 0.55rem;
		}
		.stg__label {
			font-size: var(--sp-text-xs);
		}
	}
</style>
