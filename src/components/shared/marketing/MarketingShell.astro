---
/**
 * MarketingShell — the chrome for MFL.football's public service pages
 * (/mfl-commissioner-tools, /mfl-league-history, /custom-mfl-league-website,
 * /mfl-skins, /about, /compare). Same wordmark, brand tokens and footer as
 * the homepage (src/pages/index.astro), so a visitor who lands here from a
 * search moves between them without a seam.
 *
 * Every page that uses it is indexable on purpose, so it always passes a
 * canonical path, a description and its JSON-LD through to SplashLayout.
 */
import SplashLayout from '../../../layouts/SplashLayout.astro';
import ProductInterest from '../ProductInterest.astro';
import { SERVICES, FORMER_BRAND } from '../../../data/mfl-services';
import type { JsonLd } from '../../../utils/structured-data';

export interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	jsonLd?: JsonLd[];
	ogImage?: string;
}

const { title, description, canonicalPath, jsonLd = [], ogImage = '/assets/home/league-site.webp' } = Astro.props as Props;
const here = canonicalPath;
---

<SplashLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} ogImage={ogImage}>
	{/* Soft Premium (src/styles/soft-premium.css): the same header, footer,
	    hero, card and band as the homepage, so the pages read as one brand. */}
	<div class="mkt sp">
		<header class="sp-top">
			<a class="sp-brand" href="/" aria-label="MFL.football home">
				<img class="sp-brand__light" src="/assets/logos/mfl-football-wordmark.svg" width="5404" height="680" alt="" />
				<img class="sp-brand__dark" src="/assets/logos/mfl-football-wordmark-dark.svg" width="5404" height="680" alt="" />
			</a>
			<nav class="sp-top__links" aria-label="Services">
				{SERVICES.map((s) => (
					<a href={s.path} aria-current={s.path === here ? 'page' : undefined}>{s.navLabel}</a>
				))}
				<a href="/pricing" aria-current={here === '/pricing' ? 'page' : undefined}>Pricing</a>
				<a class="sp-top__live" href="/live">Live scores</a>
			</nav>
			<div class="sp-top__end">
				<a class="cta cta--ghost" href="/login">Sign in</a>
			</div>
		</header>

		<slot />

		<footer class="sp-foot">
			<p>
				<strong>MFL.football</strong> · formerly {FORMER_BRAND}. Skins, tools, history and websites for MyFantasyLeague leagues.
			</p>
			<nav class="sp-foot__links" aria-label="Site">
				{SERVICES.map((s) => <a href={s.path}>{s.eyebrow}</a>)}
				<a href="/pricing">Pricing</a>
				<a href="/mfl-all-play-standings">Free all-play standings</a>
				<a href="/live">Live scores</a>
				<a href="/compare">Compare</a>
				<a href="/about">About</a>
				<a href="/instructions">Template instructions</a>
				<a href="/privacy">Privacy</a>
			</nav>
		</footer>

		<ProductInterest />
	</div>
</SplashLayout>

<style>
	/* /about, /compare and the all-play report still style with the old brand
	   names; they point at the Soft Premium tokens so those pages follow the
	   one palette in both themes. */
	.mkt {
		--brand-ink: var(--sp-ink);
		--brand-red: var(--sp-red);
		--brand-red-hover: var(--sp-red-hover);
	}
</style>
