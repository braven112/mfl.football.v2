---
/**
 * SundayTicketBox — one of the four multiview boxes: a game with your players
 * in it, or the RedZone box that fills an open slot.
 *
 * Props-only (no feeds, no auth, no clock) so it stories from a fixture. The
 * NFL logos are the site's own `/assets/nfl-logos/<code>.svg`, swapped to the
 * dark cut by `NflLogoDarkStyles` exactly as everywhere else. The network is
 * the channel in the viewer's COUNTRY (`resolveChannel`): CBS at home, DAZN
 * in Canada, Kayo in Australia — drawn as the channel's mark from
 * `/assets/tv-logos/` when one exists, its name when not. Each player row is
 * the site's standard PlayerCell (headshot on a team-color chip, DEF rows
 * wearing the team logo, the MFL-photo fallback chain) with the league's
 * projection beside it — the same lockup as rosters, lineups and free agents.
 *
 * Once a league is being scored live, that league's LIVE points lead and the
 * projection drops to a secondary. This component stays props-only: the
 * numbers arrive server-rendered, and the single `SundayTicketLive` island
 * updates them in place through the `data-st-live*` hooks below. That keeps
 * the whole board at ONE hydration root and one React-free renderer, rather
 * than a React copy of this markup (which is exactly the kind of fork
 * `page-fork-ratchet` exists to stop).
 */
import { nflLogoUrl } from '../../../utils/live/nfl-logo-url';
import type { SlateBox } from '../../../utils/sunday-ticket-slate';
import { formatKickoffZones, displayProjectionFor } from '../../../utils/sunday-ticket-slate';
import { REDZONE_LOGO, countryTimeZones, resolveChannel, type CountryCode, type KickoffZone } from '../../../utils/broadcast-channels';
import PlayerCell from '../../theleague/PlayerCell.astro';
import { isClockRunning } from '../../../utils/live-win-probability';

export interface Props {
  box: SlateBox;
  /** 1-based position on the grid — the multiview's own numbering. (`slot` is Astro's reserved named-slot attribute, so not that.) */
  rank: number;
  /** Whose channels to show. */
  country?: CountryCode;
  /** The viewer's chosen clocks (/preferences); omitted, the country's default pair. */
  zones?: KickoffZone[];
  /**
   * Show the league + franchise line above each player group. Any league that
   * CAN go live shows it regardless of this flag, because that line is the
   * subtotal's only home and the island can only patch a span that the server
   * rendered. Gating on `liveResolved` instead meant a single-league owner who
   * opened the board before kickoff never got the element, so the running
   * total never appeared for them no matter how long they watched.
   *
   * It has to name the league either way: scoring is not comparable across
   * leagues, so an unattributed number would read as a cross-league sum.
   */
  multiLeague?: boolean;
  /** An owner's board (counts read "starters"); false for the league-wide fallback. */
  personalized?: boolean;
}

const { box, rank, country = 'US', zones, multiLeague = false, personalized = false } = Astro.props;

/** The league-wide list is every projected player on both teams; cap it. */
const MAX_PLAYERS_LEAGUE_WIDE = 5;

// The multiview grid is near-black in BOTH themes (sunday-ticket.css), so the
// `html.dark` swap never fires for a light-theme viewer here. Ask for the dark
// ground directly instead of rendering the light mark on a near-black tile.
const logo = (code: string) => nflLogoUrl(code, 'dark');

/**
 * The projection cell's tooltip, which has to name which number it is.
 *
 * Blended while the clock is running and the raw projection otherwise, so the
 * label moves with it — "projected final" over an untouched projection is the
 * cell and its own tooltip disagreeing. `isClockRunning` is the SAME predicate
 * `displayProjectionFor` branches on, for exactly that reason.
 */
const projTitle = (p: { proj: number; live?: number; secondsRemaining?: number }) =>
  p.live !== undefined && p.secondsRemaining !== undefined && isClockRunning(p.secondsRemaining)
    ? `${displayProjectionFor(p as never).toFixed(1)} projected final`
    : `${p.proj.toFixed(1)} projected`;
// The kickoff in the viewer's own clocks — ET/PT at home, AEST/AWST in
// Australia, where a Sunday 1pm ET game is Monday morning and says so.
const clocks = box.kind === 'game'
  ? formatKickoffZones(box.game.kickoff, zones && zones.length > 0 ? zones : countryTimeZones(country))
  : [];
const kickoff = clocks[0] ?? null;
const channel = box.kind === 'game' ? resolveChannel(box.game.broadcast, country) : null;
const channelTitle = channel
  ? [channel.name, channel.note, channel.subscription].filter(Boolean).join(' · ')
  : '';
const starters = (n: number) => `${n} starter${n === 1 ? '' : 's'}`;
// Starters rank the box; roster-only players (a league whose lineup could not
// be read) are listed but say so, both here and in the league line below.
---

{box.kind === 'redzone' ? (
  <article class="st-box st-box--redzone" aria-label={`Box ${rank}: NFL RedZone`}>
    <span class="st-box__rank" aria-hidden="true">#{rank}</span>
    <div class="st-box__rz">
      <img class="st-box__rz-logo" src={REDZONE_LOGO} alt="NFL RedZone" width="180" height="60" loading="lazy" />
      <p class="st-box__rz-copy">Every touchdown, every game. Takes the open box.</p>
    </div>
  </article>
) : (
  <article
    class="st-box"
    aria-label={`Box ${rank}: ${box.game.away} at ${box.game.home}${kickoff ? `, ${kickoff.day} ${kickoff.time} ${kickoff.label}` : ''}${channel ? `, on ${channel.name}` : ''}`}
  >
    <span class="st-box__rank" aria-hidden="true">#{rank}</span>
    <header class="st-box__head">
      <div class="st-box__teams">
        <span class="st-box__team">
          <img class="st-box__logo" src={logo(box.game.away)} alt="" width="44" height="44" loading="lazy" />
          <span class="st-box__code">{box.game.away}</span>
        </span>
        <span class="st-box__at" aria-hidden="true">@</span>
        <span class="st-box__team">
          <img class="st-box__logo" src={logo(box.game.home)} alt="" width="44" height="44" loading="lazy" />
          <span class="st-box__code">{box.game.home}</span>
        </span>
      </div>
      <div class="st-box__meta">
        {clocks.length > 0 && (
          <span class="st-box__kick">
            {clocks.map((c, i) => (
              <span class:list={['st-box__kick-zone', i > 0 && 'st-box__kick-zone--alt']}>
                {c.dayDiffers && <span class="st-box__kick-day">{c.day} </span>}{c.time} {c.label}
              </span>
            ))}
          </span>
        )}
        {channel && (
          channel.logo ? (
            <span class="st-net st-net--mark" title={channelTitle}>
              <img class="st-net__logo" src={channel.logo} alt={channel.name} loading="lazy" />
            </span>
          ) : (
            <span class="st-net" title={channelTitle}>{channel.name}</span>
          )
        )}
        <span class="st-box__count">
          {personalized
            ? (box.starterCount > 0
                ? `${starters(box.starterCount)}${box.rosterCount > 0 ? ` + ${box.rosterCount} on roster` : ''}`
                : `${box.rosterCount} on roster`)
            : `${box.projTotal.toFixed(1)} proj`}
        </span>
      </div>
    </header>

    <div class="st-box__body">
      {box.byLeague.map((group) => {
        const shown = personalized ? group.players : group.players.slice(0, MAX_PLAYERS_LEAGUE_WIDE);
        const hidden = group.players.length - shown.length;
        return (
          <div class="st-box__league">
            {(multiLeague || group.liveSupported) && (
              <h4 class="st-box__league-name">
                {group.leagueName}
                {group.franchiseName && <span class="st-box__franchise"> · {group.franchiseName}</span>}
                {!group.lineupResolved && personalized && <span class="st-box__unset"> · roster, no lineup yet</span>}
                {group.liveSupported && (
                  <span
                    class:list={['st-box__league-live', !group.liveResolved && 'st-box__league-live--idle']}
                    data-st-live-box={`${group.leagueId}:${box.game.id}`}
                  >{group.liveResolved ? group.liveTotal.toFixed(1) : ''}</span>
                )}
              </h4>
            )}
            <ul class="st-box__players">
              {shown.map((p) => (
                <li class="st-box__player">
                  <PlayerCell
                    name={p.name}
                    headshot={p.headshot}
                    position={p.position}
                    nflTeam={p.nflTeam}
                    mflId={p.playerId}
                    size="compact"
                  />
                  <span class="st-box__score">
                    {group.liveSupported ? (
                      <span
                        class:list={['st-box__live', p.live === undefined && 'st-box__live--idle']}
                        data-st-live={`${group.leagueId}:${p.playerId}`}
                      >{p.live === undefined ? '' : p.live.toFixed(1)}</span>
                    ) : null}
                    {/* The PROJECTED FINAL, blended: a full-game projection
                        printed beside a live score reads as points still to
                        come, and mid-game it is not — see
                        `displayProjectionFor`. Before kickoff and after the
                        whistle the projection is printed untouched, so this
                        cell never just repeats the live one beside it.

                        `data-st-proj-base` carries the RAW full-game number so
                        the poller can re-blend against the clock it just read;
                        without it the cell would freeze at whatever the first
                        paint computed and drift for the rest of the afternoon.

                        No title when there is no projection: `proj` is 0 for
                        "the league has none", and the row deliberately shows an
                        em-dash — a "0.0 projected" tooltip over it reads as a
                        real forecast of zero. The blend never fills that in
                        either: with no projection there is nothing to blend,
                        and printing the live score here would duplicate the
                        column beside it as though it were a forecast. */}
                    <span
                      class="st-box__proj"
                      data-st-proj={`${group.leagueId}:${p.playerId}`}
                      data-st-proj-base={p.proj}
                      title={p.proj > 0 ? projTitle(p) : undefined}
                    >{p.proj > 0 ? displayProjectionFor(p).toFixed(1) : '—'}</span>
                  </span>
                </li>
              ))}
              {hidden > 0 && <li class="st-box__more">+{hidden} more</li>}
            </ul>
          </div>
        );
      })}
    </div>
  </article>
)}
