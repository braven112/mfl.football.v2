---
export interface Props {
  /** runner_up: a division's second seed — MAD POWER 99 (archies) only. */
  status: 'division_winner' | 'runner_up' | 'wild_card' | null;
  seed?: number;
}

const { status, seed } = Astro.props;
---

{status === 'division_winner' && (
  <div class="ui-badge badge badge-division-winner" title="Division Winner">
    <span class="badge-label">DIV</span>
    {seed && <span class="badge-seed">#{seed}</span>}
  </div>
)}

{status === 'runner_up' && (
  <div class="ui-badge badge badge-runner-up" title="Division Runner-Up">
    <span class="badge-label">2ND</span>
    {seed && <span class="badge-seed">#{seed}</span>}
  </div>
)}

{status === 'wild_card' && (
  <div class="ui-badge badge badge-wild-card" title="Wild Card">
    <span class="badge-label">WC</span>
    {seed && <span class="badge-seed">#{seed}</span>}
  </div>
)}

<style>
  .badge {
    /* Kit: ui-badge supplies the shared badge shape; what follows is this badge's own look. */
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge-division-winner {
    background-color: #ffd700;
    color: #1a1a1a;
    box-shadow: 0 2px 4px rgba(255, 215, 0, 0.3);
  }

  /* The league's primary, which every league redefines for dark mode — so
     the pill stays legible on both grounds without its own dark rule. */
  .badge-runner-up {
    background-color: color-mix(in srgb, var(--color-primary, #3b82f6) 30%, transparent);
    outline: 1px solid var(--color-primary, #3b82f6);
    outline-offset: -1px;
    color: var(--page-text, #1a1a1a);
  }

  .badge-wild-card {
    background-color: #c0c0c0;
    color: #1a1a1a;
    box-shadow: 0 2px 4px rgba(192, 192, 192, 0.3);
  }

  .badge-label {
    font-weight: 700;
  }

  .badge-seed {
    font-size: 0.65rem;
    font-weight: 500;
  }
</style>
