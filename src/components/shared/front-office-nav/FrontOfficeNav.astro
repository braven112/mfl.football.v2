---
/**
 * FrontOfficeNav — the strip that sits on top of every page in the Front
 * Office section, mirroring DraftNav.astro (src/components/shared/draft-nav/).
 *
 * Real `<a>` links, deliberately — DraftViewSelector's own history records why:
 * its tabs were buttons with a click handler that never bound under the
 * ClientRouter and shipped dead. Links need no script and survive view
 * transitions.
 *
 * Three deliberate departures from DraftNav, each with a reason recorded here
 * rather than silently copied:
 *
 * 1. Labels stay visible at EVERY width, never hidden under 560px. DraftNav's
 *    strip tops out at 7 items; this one has up to 11 (TheLeague), and several
 *    of its icons (bar-chart / standings-2 / line-chart) are visually close
 *    enough that icon-only chips would be a guessing game, not a nav aid.
 * 2. The active pill gets its own dark-mode ink and its own focus ring.
 *    `--league-accent` is LIGHT in dark mode (#3b82f6 / #ef5350), so white ink
 *    on it measures 3.68:1 / 3.49:1 — under AA for a 0.82rem/700 label (not
 *    large text). And the global focus ring IS `--color-primary`, i.e. the
 *    active pill's own fill — an invisible ring on the item a keyboard user
 *    lands on most.
 * 3. A ~15-line script keeps the current item scrolled into view. Progressive
 *    enhancement only: the strip works without it, the active item is simply
 *    wherever it falls.
 */
import { spriteUrl } from '../../../utils/sprite-url';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import Breadcrumbs from '../../theleague/Breadcrumbs.astro';
import {
  FRONT_OFFICE_HUB_PATH,
  frontOfficePagesFor,
  type FrontOfficeLeagueSlug,
} from './front-office-pages';

interface Props {
  leagueSlug: FrontOfficeLeagueSlug;
  /** `key` of the page rendering this strip, or 'hub'. */
  current: string;
  /** Trailing breadcrumb for this page. Omit on the hub. */
  crumb?: string;
  /**
   * Drop the chrome's own top padding — for a page (Roster/Salary, Keeper
   * Planner, …) that already owns its page-level gutter, so the strip does
   * not double it.
   */
  bare?: boolean;
}

const { leagueSlug, current, crumb, bare = false } = Astro.props;
const trail = [
  { label: 'Home', href: `/${leagueSlug}` },
  ...(crumb
    ? [{ label: 'Front Office', href: `/${leagueSlug}${FRONT_OFFICE_HUB_PATH}` }, { label: crumb }]
    : [{ label: 'Front Office' }]),
];
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${leagueSlug}${path}`, hideLeaguePrefix);
const pages = frontOfficePagesFor(leagueSlug);
---

<div class:list={['fonav-chrome', { 'fonav-chrome--bare': bare }]}>
  <Breadcrumbs items={trail} />
  <nav class="fonav" aria-label="Front Office pages">
  <a
    href={r(FRONT_OFFICE_HUB_PATH)}
    class:list={['fonav__item', 'fonav__item--hub', { 'fonav__item--on': current === 'hub' }]}
    aria-current={current === 'hub' ? 'page' : undefined}
  >
    <svg class="fonav__icon" viewBox="0 0 512 512" aria-hidden="true"><use href={`${spriteUrl}#icon-wallet`} /></svg>
    <span class="fonav__label">Front Office</span>
  </a>
  <span class="fonav__divider" aria-hidden="true"></span>
  <ul class="fonav__list">
    {pages.map((p) => (
      <li>
        <a
          href={r(p.path)}
          class:list={['fonav__item', { 'fonav__item--on': p.key === current }]}
          aria-current={p.key === current ? 'page' : undefined}
          title={p.label}
        >
          <svg class="fonav__icon" viewBox="0 0 512 512" aria-hidden="true"><use href={`${spriteUrl}#${p.icon}`} /></svg>
          <span class="fonav__label">{p.shortLabel}</span>
        </a>
      </li>
    ))}
  </ul>
  </nav>
</div>

<script>
  // Keep the current item in view on a scrolling strip. Instant assignment,
  // not scrollIntoView(): the latter can move the whole document vertically,
  // and an instant jump needs no prefers-reduced-motion guard. Re-runs on
  // every in-site navigation — module scope alone is once-per-session under
  // the ClientRouter.
  function centerCurrentFrontOfficeItem() {
    document.querySelectorAll('.fonav').forEach((nav) => {
      const on = nav.querySelector('[aria-current="page"]') as HTMLElement | null;
      if (!on) return;
      const el = nav as HTMLElement;
      el.scrollLeft = on.offsetLeft - (el.clientWidth - on.offsetWidth) / 2;
    });
  }
  centerCurrentFrontOfficeItem();
  document.addEventListener('astro:page-load', centerCurrentFrontOfficeItem);
</script>

<style>
  .fonav-chrome {
    padding: 0.75rem 1rem 0;
  }

  .fonav-chrome--bare {
    padding: 0 0 0;
  }

  .fonav {
    --fo-accent: var(--league-accent, #1c497c);
    --fo-surface: var(--card-bg, #fff);
    --fo-surface-muted: var(--content-bg-muted, #f7f7f7);
    --fo-border: var(--content-border, #e5e5e5);
    --fo-ink: var(--page-text, #1a1a1a);
    --fo-ink-muted: var(--content-text-muted, #666);
    --fo-on-accent: var(--btn-primary-text, #fff);

    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 0 1rem;
    padding: 0.35rem;
    border: 1px solid var(--fo-border);
    border-radius: 0.6rem;
    background: var(--fo-surface);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 0.5rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  :global(html.dark) .fonav {
    /* --league-accent is LIGHT in dark mode; white on it fails AA (see header
       comment). Dark ink on the same fill measures 5.09:1 / 5.37:1. */
    --fo-on-accent: #0b1220;
    /* --content-text-muted is #8a8a8a in TheLeague dark: 4.38:1 on #262626,
       under the 4.5:1 floor. gray-700 is the readable muted gray in dark. */
    --fo-ink-muted: var(--color-gray-700, #c0c0c0);
  }

  .fonav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fonav__divider {
    flex: 0 0 auto;
    width: 1px;
    align-self: stretch;
    background: var(--fo-border);
    margin: 0 0.2rem;
  }

  .fonav__item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.4rem;
    color: var(--fo-ink-muted);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    scroll-snap-align: start;
  }

  @media (pointer: coarse) {
    .fonav__item {
      min-height: 2.75rem;
    }
  }

  .fonav__item:hover {
    background: var(--fo-surface-muted);
    color: var(--fo-ink);
  }

  .fonav__item--on {
    background: var(--fo-accent);
    color: var(--fo-on-accent);
  }

  .fonav__item--hub {
    font-weight: 700;
  }

  .fonav__item:focus-visible {
    outline: 2px solid var(--fo-accent);
    outline-offset: 2px;
  }

  .fonav__item--on:focus-visible {
    outline: 2px solid var(--fo-on-accent);
    outline-offset: -3px;
  }

  .fonav__icon {
    width: 16px;
    height: 16px;
    fill: currentColor;
    color: currentColor;
    flex: 0 0 auto;
  }

  @media (max-width: 560px) {
    .fonav__item {
      padding: 0.4rem 0.5rem;
    }
  }
</style>
