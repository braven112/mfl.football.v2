---
/**
 * Division-vs-division matrix — each row's record against each column.
 *
 * Shared by the all-time view and the season view; the only difference is
 * which set of division records is handed in.
 *
 * Geometry is lifted from `src/pages/theleague/rivalries/index.astro`: sticky
 * row headers, heat-tinted cells, the light/dark hue pairs. Note that only the
 * ROW headers actually stick — `.dsm-scroll` caps no height, so it never
 * scrolls vertically and the column headers' `top: 0` never engages. That is
 * harmless at 4x4 to 7x7 (the matrix fits the fold) and is left in place for
 * the day one of these grids gets tall enough to need it.
 *
 * Three things are deliberately DIFFERENT from that page, each fixing a gap
 * rather than restyling it:
 *
 *  1. **Explicit `headers` on every cell.** Rivalries is 16x16 and relies on
 *     `scope` alone. At 4x4 or 6x6 the explicit wiring costs 16-36 attributes
 *     and removes all inference.
 *  2. **The diagonal keeps its cell in the grid.** Rivalries puts
 *     `aria-hidden="true"` on the whole `<td>`, which removes it from the row
 *     and breaks column counting for assistive tech. Here the CONTENT is
 *     hidden and the cell stays.
 *  3. **Every cell carries a full-sentence `aria-label`.** Rivalries puts the
 *     context in `title` only, so a screen reader announces "24 dash 18" with
 *     no subject.
 *
 * Heat encodes MARGIN, not rivalry closeness: the question this page asks is
 * dominance, so a lopsided cell should be the loud one — the opposite of the
 * rivalries page, where a dead-even series is the interesting one.
 */
import { formatRecord, formatWinPct } from '../../../utils/division-strength.mjs';
import type { DivisionRecord } from '../../../types/division-strength';

interface MatrixRow {
  name: string;
  slug: string;
  vs: Record<string, DivisionRecord>;
}

interface Props {
  rows: MatrixRow[];
  /** Anchors row headers at `#<panelIdPrefix><slug>` when the view has panels. */
  panelIdPrefix?: string | null;
  caption: string;
  idPrefix: string;
}

const { rows, panelIdPrefix = null, caption, idPrefix } = Astro.props as Props;

/**
 * 0..1, driving the cell tint. `.500` is colourless and a sweep produces the
 * strongest tint at roughly .700 / .300 rather than only at the theoretical
 * extremes, which no division-vs-division sample ever reaches.
 */
const heatFor = (rec: DivisionRecord | undefined): number => {
  if (!rec || rec.games === 0 || rec.winPct === null) return 0;
  return Math.min(1, Math.abs(rec.winPct - 0.5) * 2.5);
};

const colId = (slug: string) => `${idPrefix}-col-${slug}`;
const rowId = (slug: string) => `${idPrefix}-row-${slug}`;
---

<div class="dsm-scroll">
  <table class="dsm">
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th class="dsm-corner" scope="col"><span class="visually-hidden">Division</span></th>
        {rows.map((col) => (
          <th id={colId(col.slug)} scope="col" class="dsm-col-header">
            <span class="dsm-col-name" title={col.name}>{col.name}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th id={rowId(row.slug)} scope="row" class="dsm-row-header">
            {panelIdPrefix ? (
              <a href={`#${panelIdPrefix}${row.slug}`}>{row.name}</a>
            ) : (
              <span>{row.name}</span>
            )}
          </th>
          {rows.map((col) => {
            if (col.slug === row.slug) {
              return (
                <td class="dsm-cell dsm-self" headers={`${rowId(row.slug)} ${colId(col.slug)}`}>
                  <span class="visually-hidden">{row.name} does not play itself</span>
                  <span aria-hidden="true">—</span>
                </td>
              );
            }
            const rec = row.vs[col.name];
            if (!rec || rec.games === 0) {
              return (
                <td class="dsm-cell dsm-empty" headers={`${rowId(row.slug)} ${colId(col.slug)}`}>
                  <span class="visually-hidden">{row.name} and {col.name} never met</span>
                  <span aria-hidden="true">—</span>
                </td>
              );
            }
            const heat = heatFor(rec);
            const winning = rec.winPct !== null && rec.winPct > 0.5;
            const losing = rec.winPct !== null && rec.winPct < 0.5;
            return (
              <td
                class:list={['dsm-cell', { 'dsm-cell--win': winning, 'dsm-cell--loss': losing }]}
                headers={`${rowId(row.slug)} ${colId(col.slug)}`}
                style={`--ds-heat: ${heat.toFixed(2)};`}
                aria-label={`${row.name} versus ${col.name}: ${rec.wins} ${rec.wins === 1 ? 'win' : 'wins'}, ${rec.losses} ${rec.losses === 1 ? 'loss' : 'losses'}${rec.ties ? `, ${rec.ties} ${rec.ties === 1 ? 'tie' : 'ties'}` : ''}, ${formatWinPct(rec)}`}
              >
                <span class="dsm-rec" aria-hidden="true">{formatRecord(rec)}</span>
                <span class="dsm-pct" aria-hidden="true">{formatWinPct(rec)}</span>
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="dsm-legend">
  <span class="dsm-legend__key"><span class="dsm-legend__swatch dsm-legend__swatch--win"></span> winning record</span>
  <span class="dsm-legend__key"><span class="dsm-legend__swatch dsm-legend__swatch--loss"></span> losing record</span>
  <span class="dsm-legend__key dim">stronger tint = wider margin</span>
</p>

<style>
  /* Defined locally, not inherited from the page's `.ds-page` block: this
     component should render correctly wherever it is used, and a focus ring
     that silently changes colour when the cascade shifts is exactly the kind
     of half-defined token the design-system rules warn about.
     --league-accent, never --color-primary — the latter is blue on AFL light. */
  .dsm-scroll,
  .dsm-legend {
    --ds-accent: var(--league-accent, #1c497c);
  }
  .dsm-scroll {
    overflow-x: auto;
    border: 1px solid var(--content-border, #e5e5e5);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--card-bg, #fff);
  }
  .dsm {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    font-variant-numeric: tabular-nums;
    /* Containing block for the visually-hidden <caption> — see .dsm-cell. */
    position: relative;
  }
  /* NOTE: no `padding: 0` reset here.
   *
   * `.dsm th` outranks a bare `.dsm-row-header` on specificity, so a blanket
   * reset silently defeated EVERY per-cell padding rule below — the matrix
   * shipped with its labels flush against the cell borders and no rule
   * appeared to be wrong when read in isolation. Each cell class owns its own
   * padding instead; every cell in this table carries one. */
  .dsm th,
  .dsm td {
    border-bottom: 1px solid var(--content-border, #f0f0f0);
    border-right: 1px solid var(--content-border, #f0f0f0);
    text-align: center;
    vertical-align: middle;
    font-size: 0.8125rem;
  }
  .dsm tr:last-child th,
  .dsm tr:last-child td { border-bottom: none; }
  .dsm tr th:last-child,
  .dsm tr td:last-child { border-right: none; }

  .dsm-corner {
    background: var(--content-bg-muted, #f7f7f7);
    padding: 0.5rem 0.75rem;
    width: 10rem;
    min-width: 10rem;
    position: sticky;
    left: 0;
    z-index: 3;
  }
  .dsm-col-header {
    background: var(--content-bg-muted, #f7f7f7);
    padding: 0.5rem 0.25rem;
    width: 5.5rem;
    min-width: 5.5rem;
    position: sticky;
    top: 0;
    z-index: 1;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted, #666);
  }
  .dsm-col-name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .dsm-row-header {
    background: var(--content-bg-muted, #f7f7f7);
    padding: 0.375rem 0.75rem;
    text-align: left;
    width: 10rem;
    min-width: 10rem;
    position: sticky;
    left: 0;
    z-index: 2;
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .dsm-row-header a {
    color: inherit;
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .dsm-row-header span { display: flex; align-items: center; min-height: 44px; }
  .dsm-row-header a:hover { text-decoration: underline; }
  /* Inset, and lifted above the sticky headers — an outset ring on a sticky
     cell inside an overflow container is clipped on two sides. */
  .dsm-row-header a:focus-visible {
    outline: 2px solid var(--ds-accent, var(--league-accent, #1c497c));
    /* Inset, so the ring is drawn INSIDE the cell and cannot be clipped by the
       sticky header or the scroll container. (An earlier z-index here did
       nothing: the sticky row header creates a stacking context, so a child
       can never rise above it. The inset is doing all the work.) */
    outline-offset: -3px;
    border-radius: 0.25rem;
  }

  /* `position: relative` is LOAD-BEARING, not decoration.
   *
   * Every cell holds a `.visually-hidden` span, which is `position: absolute`
   * with `left`/`top` auto — so it renders at its STATIC position inside
   * whatever its containing block turns out to be. Without a positioned cell
   * that containing block is the initial one, and a span belonging to a column
   * far along a horizontally-scrolled table then sits hundreds of pixels
   * outside the viewport IN DOCUMENT COORDINATES. It is 1px wide and clipped,
   * so nothing is visible — but the document's scrollable width grows and the
   * whole page scrolls sideways on mobile.
   *
   * That is why the rivalries page doesn't hit this: it puts cell context in a
   * `title` attribute instead of a real span, which is also why a screen reader
   * there announces "24 dash 18" with no subject. Keeping the spans is the
   * better answer; this is the rule that makes them safe. */
  .dsm-cell {
    --ds-heat: 0;
    height: 3.25rem;
    padding: 0.375rem 0.5rem;
    line-height: 1.25;
    position: relative;
  }
  .dsm-rec { display: block; font-weight: 600; }
  .dsm-pct { display: block; font-size: 0.6875rem; opacity: 0.75; }

  .dsm-self {
    background: repeating-linear-gradient(
      45deg,
      var(--content-bg-muted, #f0f0f0) 0,
      var(--content-bg-muted, #f0f0f0) 4px,
      var(--table-row-bg-hover, #e6e6e6) 4px,
      var(--table-row-bg-hover, #e6e6e6) 8px
    );
    color: var(--content-text-muted, #aaa);
  }
  .dsm-empty { color: var(--content-text-muted, #bbb); }

  /* Result hues are literals on purpose: green-means-won must hold its meaning
     in both themes, so it cannot ride a themed token. Dark mixes toward the
     muted surface rather than transparent, or the tint washes out to nothing —
     same reasoning as rivalries/index.astro. */
  .dsm-cell--win {
    background: color-mix(in srgb, #1f5d2d calc(var(--ds-heat) * 28%), transparent);
    color: #1f5d2d;
  }
  .dsm-cell--loss {
    background: color-mix(in srgb, #8b2a1f calc(var(--ds-heat) * 28%), transparent);
    color: #8b2a1f;
  }
  :global(html.dark) .dsm-cell--win {
    background: color-mix(in srgb, #2f9e56 calc(var(--ds-heat) * 32%), var(--content-bg-muted));
    color: #7ee0a0;
  }
  :global(html.dark) .dsm-cell--loss {
    background: color-mix(in srgb, #d9564a calc(var(--ds-heat) * 32%), var(--content-bg-muted));
    color: #ff9c8a;
  }

  .dsm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #666);
  }
  .dsm-legend__key { display: inline-flex; align-items: center; gap: 0.375rem; }
  .dsm-legend__swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 0.25rem;
  }
  .dsm-legend__swatch--win { background: color-mix(in srgb, #1f5d2d 30%, transparent); }
  .dsm-legend__swatch--loss { background: color-mix(in srgb, #8b2a1f 30%, transparent); }
  :global(html.dark) .dsm-legend__swatch--win {
    background: color-mix(in srgb, #2f9e56 45%, var(--content-bg-muted));
  }
  :global(html.dark) .dsm-legend__swatch--loss {
    background: color-mix(in srgb, #d9564a 45%, var(--content-bg-muted));
  }
  .dim { color: var(--content-text-muted, #888); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .dsm-corner,
    .dsm-row-header { width: 7rem; min-width: 7rem; }
    .dsm-row-header { font-size: 0.75rem; padding-inline: 0.5rem; }
    .dsm-col-header { width: 4.25rem; min-width: 4.25rem; }
  }
</style>
