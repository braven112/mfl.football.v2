---
/**
 * Strength of Division — shared render for both leagues.
 *
 * One route, two reports: the all-time view (default) and a single season
 * (`?year=`). The season rail switches between them.
 *
 * ── Why this page refuses to name an all-time strongest division ───────────
 *
 * Sample size, not shyness. Rates flatter a short run: the AFL's Atlantic ran a
 * single season at .556 and tops the list outright, above divisions carrying
 * twenty-plus years of evidence. So the full ordering is shown with the season
 * count beside every short run, and no division is crowned.
 *
 * The all-time list shows and sorts by the OVERALL record — the owner's call,
 * made after measuring that overall and interdivisional win% order the
 * divisions identically, 7 for 7 in both leagues (the intra-division slice is
 * exactly .500 by arithmetic, so it pulls every division toward the middle by a
 * similar factor). One number per row, and it is the one people already know.
 *
 * The per-SEASON rank is still computed on the interdivisional rate
 * (`rankDivisionsByStrength`), because there the two can genuinely diverge on a
 * small sample and interdivisional is the defensible one. Deliberate, not
 * drift: the season view makes a claim ("strongest"), the all-time list only
 * orders rows.
 *
 * The table arrives sorted by SEASONS, neutral with respect to strength:
 * whichever column it sorts by on arrival reads as the answer no matter what
 * the prose says, so that default is a product decision.
 *
 * A SINGLE SEASON has no such problem, so the season view is deliberately
 * decisive: one strongest, one weakest, stated plainly. The tonal contrast is
 * the argument that the all-time restraint is a position, not indecision.
 *
 * ── Zero client JS ─────────────────────────────────────────────────────────
 *
 * Every control is a link that changes a URL param, and the owner-era
 * disclosure is a native `<details>`. Nothing hydrates, nothing is serialized
 * to the client, and every view is bookmarkable. The repo's own rule — a
 * control whose only job is switching a URL param should be an `<a href>` —
 * is why `components/theleague/YearSelector.astro` is NOT used here: it
 * drives navigation from an inline `onchange`, so it dead-ends without script.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../theleague/Breadcrumbs.astro';
import MetricCard from '../../theleague/MetricCard.astro';
import DivisionMatrix from './DivisionMatrix.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { formatRecord, formatRuns, formatWinPct } from '../../../utils/division-strength.mjs';
import type {
  DivisionAllTime,
  DivisionOwnerRef,
  DivisionStrengthFile,
  DivisionStrengthYear,
} from '../../../types/division-strength';
import type { AllTimeSortKey, DivisionStrengthView } from '../../../utils/division-strength-view';
// `rankEras` pre-formats each row's year span, so `formatEraYears` is not
// imported here — the template must never re-derive a label the ranking
// already resolved, or the two drift on the "–present" case.
import {
  ERA_MIN_SEASONS,
  berthRate,
  divisionAlumni,
  eraTeamSeasons,
  playoffFieldRange,
  rankEras,
} from '../../../utils/division-strength-view';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  data: DivisionStrengthFile;
  view: Extract<DivisionStrengthView, { kind: 'all-time' } | { kind: 'season' }>;
}

const { leagueSlug, data, view } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);

const BASE = '/division-strength';

/** "1st" / "2nd" / "3rd" / "4th" — 11-13 take "th". */
const ordinal = (n: number): string => {
  const rem100 = n % 100;
  if (rem100 >= 11 && rem100 <= 13) return `${n}th`;
  return `${n}${['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
};

const isSeason = view.kind === 'season';
const season: DivisionStrengthYear | null = isSeason
  ? (data.years.find((y) => y.year === view.year) ?? null)
  : null;

// ── Season rail ────────────────────────────────────────────────────────────
// Newest first, so the interesting end is the visible end.
const railYears = [...data.yearsCovered].sort((a, b) => b - a);
/**
 * The rail must draw the SAME distinction the page body does.
 *
 * `yearsWithoutGameLog` holds two different things: a season that was played
 * but whose game log was lost (the AFL's 2003 — standings survived), and a
 * season that has not happened at all (2026 — nothing to have a log of).
 * Labelling both "standings only" told a screen-reader user that 2026 had
 * standings, which is the one distinction this page exists to draw.
 */
const notPlayedYears = new Set(
  data.years
    .filter((y) => y.divisions.length === 0 || y.divisions.every((d) => d.totals.games === 0))
    .map((y) => y.year)
);
const noLog = new Set(data.yearsWithoutGameLog.filter((y) => !notPlayedYears.has(y)));

// ── All-time ranks ─────────────────────────────────────────────────────────
// Computed once here and rendered into BOTH metric columns, so the reader sees
// both orderings without sorting anything.
const rankMap = (values: Array<{ slug: string; value: number | null }>) => {
  const ranked = values
    .filter((v) => v.value !== null)
    .sort((a, b) => (b.value as number) - (a.value as number));
  const out = new Map<string, number>();
  ranked.forEach((entry, i) => {
    const prev = ranked[i - 1];
    out.set(entry.slug, prev && prev.value === entry.value ? (out.get(prev.slug) as number) : i + 1);
  });
  return out;
};

const interRanks = rankMap(
  data.divisions.map((d) => ({ slug: d.slug, value: d.interDivision.games ? d.interDivision.winPct : null }))
);

// ── Postseason ─────────────────────────────────────────────────────────────
//
// The page used to lead this column with DIVISION TITLES, and that number was
// a season counter: one division winner per division per season means a
// 15-season division has 15 titles, always, in both leagues. It read as a
// trophy case and sorted the table exactly like the Seasons column beside it.
// What separates divisions is what their teams did against the rest of the
// league — berths and championships — so that is what is reported here.
//
// Division titles are still real per OWNER inside a division (four owners
// split fifteen of them) and are still in the owner table below.

/** "47%" — a berth rate, or an em dash when there is nothing to rate. */
const formatBerthRate = (rate: number | null) =>
  rate === null ? '—' : `${Math.round(rate * 100)}%`;

/**
 * The caveat on every berth rate, when the league has one.
 *
 * A rate only compares within a fixed playoff field, so a league that has
 * changed how many teams it seeds needs the reader told. NEITHER LEAGUE HAS —
 * TheLeague has seeded 7 of 16 every season since 2007 and the AFL 8 of 24
 * every season since 2003 — so this renders nowhere today, and that is the
 * point of measuring it from the data instead of writing a footnote into the
 * prose. An earlier draft of this page asserted the AFL's field had shrunk,
 * on the strength of a derived count that was wrong: it read playoff
 * participants out of MFL bracket 1, which stopped being the AFL's entry
 * bracket in 2018 (see src/utils/playoff-entry-brackets.mjs). The claim was
 * about the bug, not the league.
 */
const fieldRange = playoffFieldRange(data);
const fieldMoved = !!fieldRange && fieldRange.max > fieldRange.min;

/**
 * Championships with the near misses beside them.
 *
 * A division with six finalists and one ring is not the same as one that has
 * been to a final once, and the bare count cannot tell them apart. Zeroes are
 * dropped rather than printed — "0 runner-up" is noise, and both leagues have
 * divisions with no third-place game on record at all.
 */
const finalsSubtitle = (d: DivisionAllTime): string => {
  const parts: string[] = [];
  if (d.runnerUps > 0) parts.push(`${d.runnerUps} runner-up`);
  if (d.thirdPlaces > 0) parts.push(`${d.thirdPlaces} third`);
  if (parts.length) return parts.join(' · ');
  return d.championships > 0 ? 'no other podium finishes' : 'never won it';
};

// ── All-time sorting ───────────────────────────────────────────────────────
const sortValue = (d: DivisionAllTime, key: AllTimeSortKey): number | string => {
  switch (key) {
    case 'name': return d.name;
    case 'seasons': return d.seasons;
    case 'record': return d.totals.winPct ?? -1;
    case 'interPct': return d.interDivision.games ? (d.interDivision.winPct ?? -1) : -1;
    // The RATE, not the count, for the same reason `record` sorts on win% —
    // the count is longevity, and the Seasons column already sorts by that.
    case 'playoffs': return berthRate(d.playoffBerths, d.teamSeasons) ?? -1;
    case 'championships': return d.championships;
  }
};

const sortedDivisions = [...data.divisions].sort((a, b) => {
  const av = sortValue(a, view.sort);
  const bv = sortValue(b, view.sort);
  const cmp =
    typeof av === 'string' || typeof bv === 'string'
      ? String(av).localeCompare(String(bv))
      : (av as number) - (bv as number);
  // Name ties never happen (names are the key), so a stable secondary sort by
  // name is enough to make every ordering total and reproducible.
  return (view.dir === 'desc' ? -cmp : cmp) || a.name.localeCompare(b.name);
});

/**
 * Sort link, preserving the other params. The `#strength-table` fragment
 * restores scroll position across the server round trip — without it, sorting
 * a table two screens down bounces the reader back to the top every time.
 */
const sortHref = (key: AllTimeSortKey) => {
  const params = new URLSearchParams(Astro.url.search);
  params.set('sort', key);
  // Numeric columns want their best value first; a NAME column wants A-Z.
  const firstClickDir = key === 'name' ? 'asc' : 'desc';
  const flipped = view.dir === firstClickDir ? (firstClickDir === 'asc' ? 'desc' : 'asc') : firstClickDir;
  params.set('dir', view.sort === key ? flipped : firstClickDir);
  return `${r(BASE)}?${params.toString()}#strength-table`;
};
/**
 * The screen-reader half of a sort header.
 *
 * Centralised while the markup stays inline: the `<th>` cannot move into its
 * own component, because Astro scoped CSS does not apply to markup a child
 * component emits (the child's tags carry a different `data-astro-cid`), so
 * extracting it silently killed the sticky-header and sort-link styling. This
 * string is the part a sighted reviewer never sees and the part most likely to
 * drift, so it is the part worth sharing.
 */
const sortHint = (key: AllTimeSortKey, describedAs: string) =>
  view.sort === key
    ? `, currently sorted ${view.dir === 'desc' ? 'descending' : 'ascending'}; activate to reverse`
    : `, activate to sort by ${describedAs}`;

const ariaSort = (key: AllTimeSortKey) =>
  view.sort === key ? (view.dir === 'desc' ? 'descending' : 'ascending') : undefined;

const SORT_LABELS: Record<AllTimeSortKey, string> = {
  name: 'division name',
  seasons: 'seasons played',
  record: 'overall win percentage',
  interPct: 'interdivisional win percentage',
  playoffs: 'playoff berth rate',
  championships: 'championships',
};

// ── The two orderings ──────────────────────────────────────────────────────
//
// These are FULL rankings, not top-three podiums, and that is the whole point.
// A podium crowns, and both metrics here are led by the same short-lived
// division — the AFL's Atlantic ran one season at .556 and tops both. Cutting
// the list at three would have made that division the answer twice over, which
// is a stronger claim than the underlying table supports and precisely the
// claim this page exists not to make. A complete ordering, with the season
// count visible on every short run, reads as data instead.
const byOverall = data.divisions
  .filter((d) => d.totals.games > 0)
  .sort((a, b) => (b.totals.winPct ?? 0) - (a.totals.winPct ?? 0));

/**
 * Who has actually been in each division, resolved once per row.
 *
 * The ranking above orders NAMES, and a name outlives its teams — "Central
 * .484 over 19 seasons" is six franchises' work, not the four sitting in it
 * now. The crests say whose record it is without the reader opening a panel.
 * Built here rather than in the template so the walk happens once per
 * division rather than once per render site.
 */
const alumniBySlug = new Map(data.divisions.map((d) => [d.slug, divisionAlumni(d)]));
const alumniOf = (d: DivisionAllTime) => alumniBySlug.get(d.slug) ?? [];

/**
 * The era board: the same comparison, made honest.
 *
 * Every run of consecutive seasons a division kept an identical lineup, long
 * enough to count, ranked across divisions. This is the one ordering on the
 * page where two rows describe the same KIND of thing — a fixed group of
 * OWNERS measured over its whole shared span — which is why it is allowed
 * to sit directly under the all-time list rather than replacing it. The
 * all-time list answers "which name has the record"; this answers "which group
 * of owners was actually the toughest to sit in".
 *
 * A division appears more than once when it has held two long-lived groups
 * (TheLeague's Central is here three times), and not at all when it never held
 * one together for `ERA_MIN_SEASONS`. Since eras break on a takeover as well as
 * a realignment, the board is shorter than the number of divisions suggests —
 * 6 rows in TheLeague and 4 in the AFL, not one or two per name.
 */
const rankedEras = rankEras(data.divisions);
// Named in the note so a reader who scans for their own division and misses it
// gets told why, rather than assuming the board is broken.
//
// Tested against MEMBERSHIP, not against what reached the board. `rankEras`
// also drops an era with no game log, and a division absent for THAT reason
// has in fact kept a lineup together — saying "no group has stayed together
// that long" about it would be a false claim in generated prose, which is a
// bug this feature has shipped once before. Unreachable today (no era of
// four-plus seasons lacks games in either league) and deliberately not
// dependent on that staying true.
const erasMissing = data.divisions
  .filter((d) => d.totals.games > 0 && d.membershipEras.every((e) => e.seasons < ERA_MIN_SEASONS))
  .map((d) => d.name);

// A division that ran a season or two is not a small sample of a long run —
// it is a short division. Saying so inline, next to the name, is what stops
// `.556` over one season from reading as a claim.
const SHORT_RUN_SEASONS = 5;
const isShortRun = (d: DivisionAllTime) => d.seasons < SHORT_RUN_SEASONS;

// Does a short run currently sit atop either ordering? If so the note says so
// outright, rather than reporting the leader as a finding. Both leagues hit
// this today — the AFL's Atlantic (1 season) and TheLeague's Midwest (4) lead
// both columns — so this is the normal path, not an edge case.
const shortRunLeader = byOverall[0] && isShortRun(byOverall[0]) ? byOverall[0] : null;
// Both leagues' copy quotes these, so they are read off the data rather than
// written in — TheLeague's shortest run is 4 seasons and the AFL's is 1, and a
// hardcoded number is wrong on one league the day it ships.
const bySeasonCount = [...data.divisions].sort((a, b) => b.seasons - a.seasons);
const longestRun = bySeasonCount[0];
const shortestRun = bySeasonCount[bySeasonCount.length - 1];

/**
 * The like-for-like comparison: every division's CURRENT lineup, longest-
 * standing first.
 *
 * This is the closest the page gets to answering "which division is toughest"
 * fairly, because within one era the same OWNERS are being compared across
 * their whole shared span. The all-time columns can't do that — a division
 * name outlives the people who earned its record. The price is that an era can
 * be short (a takeover ends one), which is why `Founded` carries the
 * division's own age beside it and `eraVsAllTime` withholds its arrow below
 * `SHORT_RUN_SEASONS`.
 */
/**
 * The alignment for the season about to be played, when there is one.
 *
 * Records belong to played seasons; MEMBERSHIP does not. Keying "as currently
 * constituted" off the last played year rendered last season's lineup — and
 * last season's owner — under a heading that promises today's. TheLeague's
 * franchise 0004 changed hands for 2026 and the table showed the outgoing
 * owner. Null in-season, when the newest season on file is the one being
 * played and nothing is pending.
 */
const upcoming = data.upcoming;
const upcomingFor = (name: string) => upcoming?.divisions.find((d) => d.name === name) ?? null;

/**
 * How an owner is LABELLED in this report: by team, not by person.
 *
 * Owners are the grouping key — a mid-tenure rename must not split one stint
 * into two entities — but `title` concatenates every name that owner has worn
 * ("Vit's Brother / Avenging Amish / Broke Back 'lil Half Dead's Brother"),
 * which is not a team name and wrapped to three lines. The label is the latest
 * name within that owner's own tenure.
 *
 * Latest-within-TENURE, never latest-for-the-franchise: AFL franchise 0004 has
 * had nine different owners, so a franchise-wide "current name" would stamp a
 * stranger's team onto someone else's stint.
 *
 * Two forms, because the right one depends on where it lands. The fallback
 * chain behind each is the same and still ends at `title` — a ref that somehow
 * reaches the page without a resolved identity renders the long string rather
 * than nothing.
 */
type OwnerLabelRef = {
  latestNameMedium?: string | null;
  latestName?: string | null;
  title?: string | null;
  slug?: string;
};

/** In a table cell, where the short form keeps the row on one line. */
const teamLabel = (o: OwnerLabelRef) =>
  o.latestNameMedium ?? o.latestName ?? o.title ?? o.slug ?? '';

/** In a sentence, where the short form reads clipped ("Dead Cap takes over"). */
const teamLabelLong = (o: OwnerLabelRef) =>
  o.latestName ?? o.latestNameMedium ?? o.title ?? o.slug ?? '';

/**
 * Is the team name worth saying alongside the incoming owner's label?
 *
 * Owners here are usually titled after the team they run, so naming both gives
 * "Dead Cap Walking takes over Dead Cap". Compare on letters only, and treat
 * either being a prefix of the other as the same thing.
 */
const namesTeamToo = (m: { name: string | null; nameMedium: string | null; newOwners: OwnerLabelRef[] }) => {
  const team = (m.nameMedium ?? m.name ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
  if (!team) return false;
  return !m.newOwners.some((o) => {
    const owner = teamLabelLong(o).toLowerCase().replace(/[^a-z0-9]/g, '');
    return owner && (owner.startsWith(team) || team.startsWith(owner));
  });
};

/** Tooltip for a crest: team name, plus who took it over when that's news. */
const memberTitle = (m: { name: string | null; newOwner?: boolean; newOwners?: OwnerLabelRef[] }) => {
  const base = m.name ?? '';
  if (!m.newOwner || !m.newOwners?.length) return base;
  return `${base} — new owner for ${upcoming?.year}: ${m.newOwners.map(teamLabelLong).join(' & ')}`;
};

/**
 * What started this era, read against the one before it (`list` is newest-first,
 * so the predecessor is the NEXT index).
 *
 * Same franchises, new era = the division changed hands; a different franchise
 * set = a realignment. Null for the oldest era and across a gap year, where
 * there is nothing to have changed FROM.
 */
const eraChangeLabel = (
  era: { yearStart: number; franchiseIds: string[] },
  previous?: { yearEnd: number; franchiseIds: string[] }
) => {
  if (!previous || previous.yearEnd !== era.yearStart - 1) return null;
  return era.franchiseIds.join(',') === previous.franchiseIds.join(',') ? 'new owner' : 'realigned';
};

/**
 * How the current lineup's interdivisional rate compares with everything ever
 * done under that division's name — i.e. how much of the name's reputation
 * belongs to the teams still in it. Null when either side has no games, or
 * when the era IS the whole history (nothing to compare against).
 *
 * Also null for a short era. Eras break on a takeover, so a division can be one
 * season old — the AFL's North took a new owner for 2025 — and an arrow reading
 * "▲.084 vs all-time" off a single season is a comparative claim the sample
 * cannot carry. The record still shows, with "1 yr" next to it.
 */
const eraVsAllTime = (d: DivisionAllTime, era: { seasons: number; interDivision: { winPct: number | null } }) => {
  const now = era.interDivision.winPct;
  const ever = d.interDivision.winPct;
  if (now === null || ever === null || era.seasons === d.seasons) return null;
  if (era.seasons < SHORT_RUN_SEASONS) return null;
  const delta = now - ever;
  if (Math.abs(delta) < 0.005) return null;
  return { up: delta > 0, text: Math.abs(delta).toFixed(3).replace(/^0/, '') };
};

// Everything each row needs is resolved ONCE here. Calling the helpers from
// the template instead meant `eraVsAllTime` and `upcomingFor` ran three to
// four times per row apiece, on every request.
/** One crest in the current-lineup row, flattened from either member shape. */
type MemberRow = {
  franchiseId: string;
  name: string | null;
  nameMedium: string | null;
  icon: string | null;
  newOwner: boolean;
  newOwners: DivisionOwnerRef[];
};

const currentLineups = data.divisions
  .filter((d) => d.currentEra)
  .map((d) => {
    const era = d.currentEra!;
    const up = upcomingFor(d.name);
    // Normalize the two member shapes to ONE row type here rather than letting
    // the template union `UpcomingMember[] | DivisionMember[]` and reach for
    // `newOwner` through a cast — `DivisionMember` has no such field, so the
    // cast was hiding a genuine mismatch rather than resolving it.
    // Branch on the SOURCE, not on the member. `UpcomingMember` extends
    // `DivisionMember`, so `'newOwner' in m` cannot separate them — TypeScript
    // narrows to `DivisionMember & Record<'newOwner', unknown>` and every
    // consumer downstream then fails on the `unknown`. Each array's element
    // type is already concrete, so picking the array first is exact and needs
    // no cast.
    const members: MemberRow[] = up
      ? up.members.map((m) => ({
          franchiseId: m.franchiseId,
          name: m.name,
          nameMedium: m.nameMedium,
          icon: m.icon,
          newOwner: m.newOwner,
          newOwners: m.newOwners,
        }))
      : era.members.map((m) => ({
          franchiseId: m.franchiseId,
          name: m.name,
          nameMedium: m.nameMedium,
          icon: m.icon,
          newOwner: false,
          newOwners: [],
        }));
    return { division: d, era, upcoming: up, delta: eraVsAllTime(d, era), members };
  })
  .sort((a, b) => b.era.seasons - a.era.seasons || b.era.yearStart - a.era.yearStart);


const spanLabel = (d: DivisionAllTime) => {
  if (!d.active) return formatRuns(d.eras);
  const runs = d.eras.map((era, i) =>
    i === d.eras.length - 1 ? { ...era, present: true } : { ...era, present: false }
  );
  return runs
    .map((run) =>
      run.present
        ? `${run.yearStart}–present`
        : run.yearStart === run.yearEnd
          ? `${run.yearStart}`
          : `${run.yearStart}–${run.yearEnd}`
    )
    .join(', ');
};

// Timeline-bar geometry: position each era against the league's whole span.
const firstYear = data.yearsCovered[0];
const lastYear = data.yearsCovered[data.yearsCovered.length - 1];
// INCLUSIVE of both ends: `to` divides by (yearEnd - firstYear + 1), so the
// denominator must count the same way or the final era overhangs its track.
// Masked today only because yearsCovered carries the unplayed 2026 while eras
// stop at 2025 — the moment 2026 is played it would render 20/19.
const spanRange = Math.max(1, lastYear - firstYear + 1);
const segments = (d: DivisionAllTime) =>
  d.eras.map((era) => ({
    from: (era.yearStart - firstYear) / spanRange,
    to: (era.yearEnd - firstYear + 1) / spanRange,
  }));

const ownerHref = (slug: string) => r(`/owners/${slug}`);

const generatedDate = new Date(data.generatedAt);
const generatedLabel = Number.isNaN(generatedDate.getTime())
  ? null
  : generatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const pageTitle = isSeason
  ? `Division Strength ${view.year} — ${league.name}`
  : `Division Strength — ${league.name}`;

// Season-view derived bits.
const seasonRanked = season ? [...season.divisions].sort((a, b) => (a.rank ?? 99) - (b.rank ?? 99)) : [];
const seasonHasGames = !!season?.gamesResolved;
const seasonNotPlayed = !!season && !season.gamesResolved && season.divisions.every(
  (d) => d.totals.wins + d.totals.losses + d.totals.ties === 0
);
// AFL 2003: standings survived, the game log did not. Distinct from "not yet
// played", and the page must say which it is.
const seasonStandingsOnly = !!season && !season.gamesResolved && !seasonNotPlayed;

/**
 * A season with no PLAYED franchise-seasons has no division blocks of its own —
 * every record-bearing structure is built from played rows. For the season
 * about to start, the alignment still exists and is the whole story, so it is
 * rendered from `upcoming` instead.
 *
 * Without this the page shipped "Teams 0 · 0 divisions", a "2026 by division"
 * heading and an empty panel grid, directly under copy asserting "Divisions are
 * set" — stating as fact the one thing it was failing to show.
 */
const upcomingSeason = season && upcoming && upcoming.year === season.year ? upcoming : null;
const seasonPreview = !!season && season.divisions.length === 0 ? upcomingSeason : null;
const seasonHasNothing = !!season && season.divisions.length === 0 && !seasonPreview;
---

<TheLeagueLayout title={pageTitle}>
  <div class="ds-page">
    <Breadcrumbs
      items={[
        { label: league.name, href: `/${league.slug}` },
        { label: 'Division Strength' },
      ]}
    />

    <header class="ds-head">
      <h1>Strength of Division{isSeason && <span class="ds-head__year"> · {view.year}</span>}</h1>
      {isSeason ? (
        seasonPreview ? (
          <p class="lede">
            Who lines up where in {view.year}. The season hasn't started, so there are no records
            yet — this is the alignment those records will be built from.
          </p>
        ) : seasonStandingsOnly ? (
          <p class="lede">
            How each division finished in {view.year}. This season's game log is missing, so the
            standings are all there is — no interdivisional splits, no ranking.
          </p>
        ) : (
          <p class="lede">
            How each division stacked up in {view.year} — every team's record, the division's
            combined mark, and how it fared against the rest of the league.
          </p>
        )
      ) : (
        <p class="lede">
          Every division's all-time record, strongest to weakest. We don't crown a winner: a
          division that ran {shortestRun.seasons} season{shortestRun.seasons === 1 ? '' : 's'} and
          one that ran {longestRun.seasons} aren't the same claim. Pick a season and we'll name one.
        </p>
      )}
    </header>

    <nav class="season-rail" aria-label="Report scope">
      <div class="season-rail__track">
        <a
          class="season-chip season-chip--alltime"
          href={r(BASE)}
          aria-current={!isSeason ? 'page' : undefined}
        >All-time</a>
        {railYears.map((year) => (
          <a
            class:list={['season-chip', {
              'season-chip--nolog': noLog.has(year),
              'season-chip--upcoming': notPlayedYears.has(year),
            }]}
            href={`${r(BASE)}?year=${year}`}
            aria-current={isSeason && view.year === year ? 'page' : undefined}
          >
            {year}
            {noLog.has(year) && <span class="visually-hidden"> (standings only, no game log)</span>}
            {notPlayedYears.has(year) && <span class="visually-hidden"> (not yet played)</span>}
          </a>
        ))}
      </div>
    </nav>
    {(noLog.size > 0 || notPlayedYears.size > 0) && (
      <p class="rail-legend">
        {noLog.size > 0 && (
          <span class="rail-legend__key">
            <span class="rail-legend__dot" aria-hidden="true"></span>
            no game-by-game log — standings only
          </span>
        )}
        {notPlayedYears.size > 0 && (
          <span class="rail-legend__key">
            <span class="rail-legend__ring" aria-hidden="true"></span>
            not played yet
          </span>
        )}
      </p>
    )}

    {!isSeason && (
      <>
        {data.divisions.length === 0 ? (
          <p class="notice">No division data yet.</p>
        ) : (
          <>
            {currentLineups.length > 0 && (
              <section aria-labelledby="lineups-heading">
                <div class="section-header">
                  <h2 id="lineups-heading" class="section-header__title">As currently constituted</h2>
                  <p class="section-header__sub">
                    Each division's record with the owners in it, over however long that exact group
                    has been together. A realignment resets the clock and so does a team changing
                    hands, so some divisions have far more shared history than others — Founded is
                    the division's own age, Together is this group's.
                    {upcoming
                      ? <> Records run through {upcoming.previousPlayedYear}, the last completed season; the crests are the {upcoming.year} lineup.</>
                      : null}
                  </p>
                </div>

                {upcoming && upcoming.anyChange && (
                  <div class="whats-changed" role="note">
                    <p class="whats-changed__kicker">New for {upcoming.year}</p>
                    <ul class="whats-changed__list">
                      {upcoming.divisions.filter((d) => !d.unchanged).map((d) => (
                        <li>
                          {/* The panels below are built from PLAYED seasons, so a
                              division with no history has no #div- anchor and the
                              link would scroll nowhere. Name it, don't link it. */}
                          {d.isNewDivision
                            ? <span class="whats-changed__div">{d.name}</span>
                            : <a href={`#div-${d.slug}`} class="whats-changed__div">{d.name}</a>}
                          {d.isNewDivision && <span class="whats-changed__item">is new for {upcoming.year}</span>}
                          {d.dissolved && (
                            <span class="whats-changed__item dim">
                              is dissolved — its {d.departures.length} team{d.departures.length === 1 ? '' : 's'} move elsewhere
                            </span>
                          )}
                          {d.newOwners.map((m) => (
                            <span class="whats-changed__item">
                              {m.icon && <img src={m.icon} alt="" loading="lazy" width="20" height="20" />}
                              {m.newOwners.map((o) => (
                                <a href={ownerHref(o.slug)}><strong>{teamLabelLong(o)}</strong></a>
                              ))}
                              {/* An owner is usually titled after the team, so naming
                                  both reads as "Dead Cap Walking takes over Dead Cap".
                                  Say the team only when it adds something. */}
                              {namesTeamToo(m) ? <> takes over {m.nameMedium ?? m.name}</> : <> takes over</>}
                              {m.previousOwners.length > 0 && (
                                <span class="dim"> from {m.previousOwners.map(teamLabelLong).join(' & ')}</span>
                              )}
                            </span>
                          ))}
                          {d.arrivals.filter((m) => !m.newOwner).map((m) => (
                            <span class="whats-changed__item">
                              {m.icon && <img src={m.icon} alt="" loading="lazy" width="20" height="20" />}
                              <strong>{m.nameMedium ?? m.name}</strong>
                              {m.previousDivision ? <> moves in from the {m.previousDivision}</> : <> joins</>}
                            </span>
                          ))}
                          {/* A dissolved division's departures are ALL of it, and
                              the line above already said so — listing each team
                              as "leaves" would just restate it four times. */}
                          {!d.dissolved && d.departures.map((m) => (
                            <span class="whats-changed__item dim">
                              {m.icon && <img src={m.icon} alt="" loading="lazy" width="20" height="20" />}
                              {m.name} leaves
                            </span>
                          ))}
                        </li>
                      ))}
                    </ul>
                    <p class="whats-changed__note">
                      A division with an incoming owner has not played a game with this exact group
                      yet, so its record below still belongs to the lineup that finished
                      {' '}{upcoming.previousPlayedYear}.
                    </p>
                  </div>
                )}

                <div class="table-scroll">
                  <table class="strength-table lineup-table">
                    <caption class="visually-hidden">
                      Current division lineups, longest-standing first, with the year each division
                      was founded and its record over the span that exact set of owners has been
                      together.
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Division</th>
                        <th scope="col" class="num">Founded</th>
                        <th scope="col" class="num">Together</th>
                        <th scope="col" class="num">Record</th>
                        <th scope="col" class="num">Interdivisional</th>
                        <th scope="col" class="num">Playoffs<span class="visually-hidden"> (berths, over the share of the lineup's franchise-seasons)</span></th>
                        <th scope="col" class="num">Champs<span class="visually-hidden"> (championships)</span></th>
                        <th scope="col">Teams</th>
                      </tr>
                    </thead>
                    <tbody>
                      {currentLineups.map(({ division, era, upcoming: up, delta, members }) => (
                        <tr>
                          <th scope="row" class="name-cell">
                            <a href={`#div-${division.slug}`} class="name-link">{division.name}</a>
                          </th>
                          {/* Founded is the DIVISION's own clock and never moves;
                              Together is the current owners' and restarts on any
                              change. Two columns because one number cannot be
                              both, and merging them is the bug this table had. */}
                          <td class="num">
                            <span class="rec">{division.firstYear}</span>
                            <span class="pct">{division.seasons} season{division.seasons === 1 ? '' : 's'}</span>
                          </td>
                          <td class="num">
                            <span class="rec">{era.seasons}<span class="unit"> yr</span></span>
                            {/* The years the group was together, not "since 2016" —
                                every other number in the row is bounded by the last
                                played season, so the span says where it stops too. */}
                            <span class="pct">{era.seasons === division.seasons
                              ? 'never changed'
                              : era.yearStart === era.yearEnd
                                ? `${era.yearStart}`
                                : `${era.yearStart}–${era.yearEnd}`}</span>
                          </td>
                          <td class="num">
                            <span class="rec">{formatRecord(era.totals)}</span>
                            <span class="pct">{formatWinPct(era.totals)}</span>
                          </td>
                          <td class="num metric-col">
                            <span class="rec">{formatRecord(era.interDivision)}</span>
                            <span class="pct">
                              {formatWinPct(era.interDivision)}
                              {delta && (
                                <span class:list={['delta', delta.up ? 'delta--up' : 'delta--down']}>
                                  <span aria-hidden="true">{delta.up ? '▲' : '▼'}</span><span class="visually-hidden">{delta.up ? 'up ' : 'down '}</span>{delta.text}
                                </span>
                              )}
                            </span>
                          </td>
                          {/* Berths, not division titles: this lineup won one of
                              those every season it played, so the column would
                              have restated Together for every row. */}
                          <td class="num">
                            <span class="rec">{era.playoffBerths}</span>
                            <span class="pct">{formatBerthRate(berthRate(era.playoffBerths, eraTeamSeasons(era)))}</span>
                          </td>
                          <td class="num">{era.championships}</td>
                          {/* Crests come from the UPCOMING alignment when there is one,
                              so the column shows who is in the division now rather than
                              who finished last season. A changed holding is marked. */}
                          <td class="member-cell">
                            <span class="member-icons">
                              {members.map((m) => (
                                <span class:list={['member-slot', { 'member-slot--new': m.newOwner }]}>
                                  {m.icon
                                    ? <img src={m.icon} alt={m.nameMedium ?? m.name ?? ''} title={memberTitle(m)} loading="lazy" width="24" height="24" />
                                    : <span class="member-initials" title={memberTitle(m)}>{(m.nameMedium ?? m.name ?? '?').slice(0, 2)}</span>}
                                </span>
                              ))}
                            </span>
                            {up?.newOwners.length ? <span class="pill pill--new">new owner</span> : null}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="table-note">
                  The arrow compares each division's interdivisional record under its current lineup
                  against that division name's whole history — how much of the name's record belongs
                  to the teams still in it. Together counts only seasons this exact group of owners
                  has played together — a team changing hands starts a new count, which is why a
                  division founded decades ago can show a short one.
                </p>
              </section>
            )}

            <section class="verdict-pair" aria-labelledby="verdict-heading">
              <h2 id="verdict-heading" class="section-title">Strongest to weakest</h2>
              <ol class="verdict-list verdict-list--solo">
                {byOverall.map((d, i) => (
                  <li>
                    <span class="verdict-rank">{i + 1}</span>
                    <a href={`#div-${d.slug}`} class="verdict-name">{d.name}</a>
                    {isShortRun(d) && <span class="pill pill--sample">{d.seasons} season{d.seasons === 1 ? '' : 's'}</span>}
                    {/* Whose record this actually is. A departed franchise is
                        dimmed rather than dropped — it earned part of the
                        number on the right. */}
                    <span class="member-icons member-icons--alumni">
                      {alumniOf(d).map((m) => (
                        <span class:list={['member-slot', { 'member-slot--past': !m.current }]}>
                          {m.icon
                            ? <img src={m.icon} alt={m.nameMedium ?? m.name ?? ''} title={m.current ? (m.name ?? '') : `${m.name ?? ''} — no longer in the ${d.name}`} loading="lazy" width="20" height="20" />
                            : <span class="member-initials" title={m.name ?? ''}>{(m.nameMedium ?? m.name ?? '?').slice(0, 2)}</span>}
                        </span>
                      ))}
                    </span>
                    <span class="verdict-value">
                      {formatRecord(d.totals)} <span class="dim">{formatWinPct(d.totals)}</span>
                    </span>
                  </li>
                ))}
              </ol>
              <p class="verdict-note">
                All-time record, every game included, with every franchise that has sat in the
                division — dimmed once it has moved on.
                {shortRunLeader && (
                  <>
                    {' '}{shortRunLeader.name} tops it on {shortRunLeader.seasons}
                    {' '}season{shortRunLeader.seasons === 1 ? '' : 's'} — a short run goes further on a
                    percentage, so the season count sits next to it.
                  </>
                )}
                {' '}These are division NAMES, though, and a name outlives its teams. The board
                below compares the lineups themselves.
              </p>
            </section>

            {rankedEras.length > 0 && (
              <section class="verdict-pair" aria-labelledby="eras-heading">
                <h2 id="eras-heading" class="section-title">Every lineup, ranked</h2>
                <p class="section-header__sub">
                  A division's record belongs to the owners in it, so this ranks the owners. Each
                  row is a run of consecutive seasons one division kept the exact same group —
                  a realignment ends the run, and so does a team changing hands — and a group has
                  to hold together {ERA_MIN_SEASONS} seasons to make the board. A division that has
                  held two long-lived groups appears more than once.
                </p>
                <ol class="verdict-list verdict-list--solo era-board">
                  {rankedEras.map((row, i) => (
                    <li>
                      <span class="verdict-rank">{i + 1}</span>
                      <span class="era-board__name">
                        <a href={`#div-${row.divisionSlug}`} class="verdict-name">{row.divisionName}</a>
                        <span class="era-board__years">{row.years}</span>
                        {row.era.current && <span class="pill pill--sample">current</span>}
                      </span>
                      <span class="member-icons">
                        {row.era.members.map((m) => (
                          m.icon
                            ? <img src={m.icon} alt={m.nameMedium ?? m.name ?? ''} title={m.name ?? ''} loading="lazy" width="20" height="20" />
                            : <span class="member-initials" title={m.name ?? ''}>{(m.nameMedium ?? m.name ?? '?').slice(0, 2)}</span>
                        ))}
                      </span>
                      <span class="verdict-value">
                        {formatRecord(row.era.totals)} <span class="dim">{formatWinPct(row.era.totals)}</span>
                        <span class="era-board__inter">
                          {formatWinPct(row.era.interDivision)} <span class="dim">vs others</span>
                        </span>
                      </span>
                    </li>
                  ))}
                </ol>
                <p class="verdict-note">
                  {ERA_MIN_SEASONS} seasons is the floor because a lineup that lasted one
                  realignment cycle has a record, not a history.
                  {erasMissing.length > 0 && (
                    <>
                      {' '}The{' '}
                      {erasMissing.join(', ').replace(/, ([^,]*)$/, erasMissing.length > 2 ? ', and $1' : ' and $1')}
                      {' '}{erasMissing.length === 1 ? 'is absent' : 'are absent'} — no group of
                      owners has stayed together that long under
                      {erasMissing.length === 1 ? ' that name' : ' those names'}.
                    </>
                  )}
                  {' '}Both figures cover the era's own seasons only; the second excludes games
                  inside the division, which are zero-sum and cannot separate anyone.
                </p>
              </section>
            )}

            <section aria-labelledby="table-heading">
              <div class="section-header">
                <h2 id="table-heading" class="section-header__title">Every division, all-time</h2>
                <p class="section-header__sub">
                  {data.summary.activeDivisions.length} active, {data.summary.retiredDivisions.length} retired.
                  Sorted by {SORT_LABELS[view.sort]}.
                </p>
              </div>

              <div class="table-scroll">
                <table class="strength-table" id="strength-table">
                  <caption class="visually-hidden">
                    Every division all-time, sorted by {SORT_LABELS[view.sort]},
                    {view.dir === 'desc' ? ' highest first' : ' lowest first'}.
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col" class="sortable" aria-sort={ariaSort('name')}>
                        <a class="sort-link" href={sortHref('name')}>
                          <span>Division</span><span class="sort-caret" aria-hidden="true"></span><span class="visually-hidden">{sortHint('name', 'division name')}</span>
                        </a>
                      </th>
                      <th scope="col" class="sortable num" aria-sort={ariaSort('seasons')}>
                        <a class="sort-link" href={sortHref('seasons')}>
                          <span>Seasons</span><span class="sort-caret" aria-hidden="true"></span><span class="visually-hidden">{sortHint('seasons', 'seasons played')}</span>
                        </a>
                      </th>
                      <th scope="col" class="sortable num" aria-sort={ariaSort('record')}>
                        <a class="sort-link" href={sortHref('record')}>
                          <span>Overall</span><span class="sort-caret" aria-hidden="true"></span><span class="visually-hidden">{sortHint('record', 'overall win percentage')}</span>
                        </a>
                      </th>
                      <th scope="col" class="sortable num metric-col" aria-sort={ariaSort('interPct')}>
                        <a class="sort-link" href={sortHref('interPct')}>
                          <span>Interdivisional</span><span class="sort-caret" aria-hidden="true"></span><span class="visually-hidden">{sortHint('interPct', 'interdivisional win percentage')}</span>
                        </a>
                      </th>
                      <th scope="col" class="sortable num" aria-sort={ariaSort('playoffs')}>
                        <a class="sort-link" href={sortHref('playoffs')}>
                          <span>Playoffs</span><span class="sort-caret" aria-hidden="true"></span><span class="visually-hidden">{sortHint('playoffs', 'playoff berth rate')}</span>
                        </a>
                      </th>
                      <th scope="col" class="sortable num" aria-sort={ariaSort('championships')}>
                        <a class="sort-link" href={sortHref('championships')}>
                          <span>Champs</span><span class="sort-caret" aria-hidden="true"></span><span class="visually-hidden">{sortHint('championships', 'championships')}</span>
                        </a>
                      </th>
                      {/* Not sortable: there is no ordering of "who was in it"
                          that means anything, and a sort control that produces
                          an arbitrary order is worse than none. */}
                      <th scope="col">Teams<span class="visually-hidden"> that have been in the division</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {sortedDivisions.map((d) => (
                      <tr class:list={['strength-row', { 'strength-row--retired': !d.active }]}>
                        <th scope="row" class="name-cell">
                          <a href={`#div-${d.slug}`} class="name-link">{d.name}</a>
                          {!d.active && <span class="pill pill--retired">Retired {d.lastYear}</span>}
                          {isShortRun(d) && <span class="pill pill--sample">{d.seasons} season{d.seasons === 1 ? '' : 's'}</span>}
                          <span class="span-text">{spanLabel(d)}</span>
                        </th>
                        <td class="num">{d.seasons}</td>
                        <td class="num">
                          <span class="rec">{formatRecord(d.totals)}</span>
                          <span class="pct">{formatWinPct(d.totals)}</span>
                        </td>
                        <td class="num metric-col">
                          {interRanks.has(d.slug) && (
                            <span class:list={['rank-chip', { 'rank-chip--top': interRanks.get(d.slug) === 1 }]}>{interRanks.get(d.slug)}</span>
                          )}
                          <span class="rec">{formatRecord(d.interDivision)}</span>
                          <span class="pct">{formatWinPct(d.interDivision)}</span>
                        </td>
                        <td class="num">
                          <span class="rec">{d.playoffBerths}</span>
                          <span class="pct">{formatBerthRate(berthRate(d.playoffBerths, d.teamSeasons))}</span>
                        </td>
                        <td class="num">{d.championships}</td>
                        <td class="member-cell">
                          <span class="member-icons member-icons--alumni">
                            {alumniOf(d).map((m) => (
                              <span class:list={['member-slot', { 'member-slot--past': !m.current }]}>
                                {m.icon
                                  ? <img src={m.icon} alt={m.nameMedium ?? m.name ?? ''} title={m.current ? (m.name ?? '') : `${m.name ?? ''} — no longer in the ${d.name}`} loading="lazy" width="24" height="24" />
                                  : <span class="member-initials" title={m.name ?? ''}>{(m.nameMedium ?? m.name ?? '?').slice(0, 2)}</span>}
                              </span>
                            ))}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="table-note">
                Playoffs is every berth the division's teams have earned, over the share of its
                franchise-seasons that reached the postseason — the share is what compares, because
                the count is longevity.
                {fieldMoved && (
                  <> Compare shares within an era: the league has seeded as few as {fieldRange!.min}
                  {' '}teams in a season and as many as {fieldRange!.max}, so the same rate is not the
                  same achievement either side of that change.</>
                )}
                {' '}Teams lists every franchise that has ever been in the division, most recent
                first; one that has since moved elsewhere is dimmed.
              </p>
            </section>

            <section aria-labelledby="matrix-heading">
              <div class="section-header">
                <h2 id="matrix-heading" class="section-header__title">Division vs division</h2>
                <p class="section-header__sub">
                  Every division's all-time record against every other. Regular season only.
                </p>
              </div>
              <DivisionMatrix
                rows={data.divisions.map((d) => ({ name: d.name, slug: d.slug, vs: d.vs }))}
                panelIdPrefix="div-"
                idPrefix="alltime"
                caption="Each row shows that division's all-time record against the division named in the column."
              />
            </section>

            <section aria-labelledby="panels-heading">
              <div class="section-header">
                <h2 id="panels-heading" class="section-header__title">Who built each division</h2>
                <p class="section-header__sub">
                  Every owner who has held a team in a division, current and former.
                </p>
              </div>
              <div class="division-panels">
                {sortedDivisions.map((d) => (
                  <article
                    id={`div-${d.slug}`}
                    class:list={['division-panel', { 'division-panel--retired': !d.active }]}
                  >
                    <header class="panel-head">
                      <h3 class="panel-name">{d.name}</h3>
                      <p class="panel-span">
                        <span class="span-text">{spanLabel(d)}</span>
                        <span
                          class:list={['span-bar', d.active ? 'span-bar--active' : 'span-bar--retired']}
                          role="img"
                          aria-label={`${d.active ? 'Active' : 'Retired'}, ${spanLabel(d)}, ${d.seasons} season${d.seasons === 1 ? '' : 's'}`}
                        >
                          {segments(d).map((seg) => (
                            <span class="span-bar__seg" style={`--from: ${seg.from.toFixed(4)}; --to: ${seg.to.toFixed(4)};`}></span>
                          ))}
                        </span>
                      </p>
                      {!d.active && <span class="pill pill--retired">Retired {d.lastYear}</span>}
                    </header>

                    <div class="metrics-grid">
                      <MetricCard label="Overall" value={formatRecord(d.totals)} subtitle={formatWinPct(d.totals)} />
                      <MetricCard label="Interdivisional" value={formatRecord(d.interDivision)} subtitle={formatWinPct(d.interDivision)} />
                      <MetricCard
                        label="Playoff berths"
                        value={String(d.playoffBerths)}
                        subtitle={`${formatBerthRate(berthRate(d.playoffBerths, d.teamSeasons))} of ${d.teamSeasons} franchise-seasons`}
                      />
                      <MetricCard label="Championships" value={String(d.championships)} subtitle={finalsSubtitle(d)} />
                    </div>

                    <dl class="detail-rows">
                      <div class="detail-row">
                        <dt class="detail-label">Best</dt>
                        <dd class="detail-value">{d.bestYear ? `${d.bestYear.year} — ${ordinal(d.bestYear.rank)} of ${d.bestYear.of}` : '—'}</dd>
                      </div>
                      <div class="detail-row">
                        <dt class="detail-label">Worst</dt>
                        <dd class="detail-value">{d.worstYear ? `${d.worstYear.year} — ${ordinal(d.worstYear.rank)} of ${d.worstYear.of}` : '—'}</dd>
                      </div>
                      <div class="detail-row">
                        <dt class="detail-label">Teams</dt>
                        <dd class="detail-value">{d.teamSeasons} franchise-seasons</dd>
                      </div>
                      {d.currentEra && (
                        <div class="detail-row">
                          <dt class="detail-label">Lineup</dt>
                          <dd class="detail-value">
                            same {d.currentEra.members.length} teams and the same owners since {d.currentEra.yearStart}
                            <span class="dim"> · {formatRecord(d.currentEra.totals)} together</span>
                          </dd>
                        </div>
                      )}
                    </dl>

                    {d.membershipEras.length > 1 && (
                      <details class="owner-eras">
                        <summary class="owner-eras__summary">
                          <span class="owner-eras__caret" aria-hidden="true"></span>
                          <span class="owner-eras__label">
                            <span class="visually-hidden">{d.name}: </span>
                            <strong>{d.membershipEras.length} lineups</strong>
                            <span class="dim"> · changed {d.membershipEras.length - 1} time{d.membershipEras.length === 2 ? '' : 's'}</span>
                          </span>
                        </summary>
                        <div class="owner-eras__reveal">
                          <div class="owner-eras__inner">
                            <ul class="era-list">
                              {/* Eras break on a takeover as well as a realignment, and a
                                  takeover usually keeps the crest — so consecutive rows can
                                  carry an IDENTICAL set of icons and read as duplicates.
                                  Name what ended the previous one. */}
                              {[...d.membershipEras].reverse().map((era, i, list) => (
                                <li>
                                  <span class="era-years">
                                    {era.yearStart === era.yearEnd ? era.yearStart : `${era.yearStart}–${era.current ? 'present' : era.yearEnd}`}
                                  </span>
                                  {eraChangeLabel(era, list[i + 1]) && (
                                    <span class="era-change">{eraChangeLabel(era, list[i + 1])}</span>
                                  )}
                                  <span class="member-icons">
                                    {era.members.map((m) => (
                                      m.icon
                                        ? <img src={m.icon} alt={m.nameMedium ?? m.name ?? ''} title={m.name ?? ''} loading="lazy" width="20" height="20" />
                                        : <span class="member-initials" title={m.name ?? ''}>{(m.nameMedium ?? m.name ?? '?').slice(0, 2)}</span>
                                    ))}
                                  </span>
                                  <span class="era-rec">
                                    {formatRecord(era.totals)}
                                    {era.interDivision.games > 0 && <> · {formatWinPct(era.interDivision)} vs others</>}
                                  </span>
                                  {era.current && <span class="pill pill--sample era-current">current</span>}
                                </li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      </details>
                    )}

                    <details class="owner-eras">
                      <summary class="owner-eras__summary">
                        <span class="owner-eras__caret" aria-hidden="true"></span>
                        <span class="owner-eras__faces" aria-hidden="true">
                          {d.owners.slice(0, 3).map((o) => (
                            o.icon && <img src={o.icon} alt="" loading="lazy" width="24" height="24" />
                          ))}
                        </span>
                        <span class="owner-eras__label">
                          <span class="visually-hidden">{d.name}: </span>
                          Built by <strong>{d.owners.length} owner{d.owners.length === 1 ? '' : 's'}</strong>
                          {d.owners.length > 0 && (
                            <span class="dim"> · {d.owners.slice(0, 2).map(teamLabel).filter(Boolean).join(', ')}{d.owners.length > 2 ? ` and ${d.owners.length - 2} more` : ''}</span>
                          )}
                        </span>
                      </summary>
                      <div class="owner-eras__reveal">
                        <div class="owner-eras__inner">
                          {d.owners.some((o) => o.sharedSeasons > 0) && (
                            <p class="table-note" id={`oe-note-${d.slug}`}>
                              Co-owned seasons count for both owners, so these seasons add up to more
                              than the division's {d.seasons}.
                            </p>
                          )}
                          <div class="owner-eras__scroll">
                            <table class="owner-era-table" aria-describedby={d.owners.some((o) => o.sharedSeasons > 0) ? `oe-note-${d.slug}` : undefined}>
                              <caption class="visually-hidden">
                                Owners who have held a team in the {d.name}, most seasons first.
                              </caption>
                              <thead>
                                <tr>
                                  <th scope="col">Team</th>
                                  <th scope="col">Years here</th>
                                  <th scope="col" class="num">Sn<span class="visually-hidden"> (seasons)</span></th>
                                  <th scope="col" class="num">Record</th>
                                  <th scope="col" class="num">Inter<span class="visually-hidden">divisional win percentage</span></th>
                                  <th scope="col" class="num">Po<span class="visually-hidden"> (playoff berths)</span></th>
                                  {/* Division titles ARE a real number here, unlike at the
                                      division level: the division hands out one a season and
                                      these owners split them. */}
                                  <th scope="col" class="num">Div<span class="visually-hidden"> (division titles)</span></th>
                                  <th scope="col" class="num">Ch<span class="visually-hidden"> (championships)</span></th>
                                </tr>
                              </thead>
                              <tbody>
                                {d.owners.map((o) => (
                                  <tr>
                                    <th scope="row" class="owner-cell">
                                      <a href={ownerHref(o.slug)} class="owner-link">
                                        {o.icon && <img src={o.icon} alt="" loading="lazy" width="20" height="20" />}
                                        <span>{teamLabel(o)}</span>
                                      </a>
                                      {o.sharedSeasons > 0 && <span class="pill pill--shared">Co-owned</span>}
                                    </th>
                                    {/* One line on purpose: a newline between the separator
                                        expression and the span renders as a literal space,
                                        which shipped as "2003 , 2005–2012". */}
                                    <td class="stints">{o.stints.map((s, i) => (<span class="stint">{i > 0 ? ', ' : ''}{s.yearStart === s.yearEnd ? `${s.yearStart}` : `${s.yearStart}–${s.yearEnd}`}</span>))}</td>
                                    <td class="num">{o.seasons}</td>
                                    <td class="num">{formatRecord(o.totals)}</td>
                                    <td class="num">{formatWinPct(o.interDivision)}</td>
                                    <td class="num">{o.playoffBerths || ''}</td>
                                    <td class="num">{o.divisionTitles || ''}</td>
                                    <td class="num">{o.championships || ''}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>
                    </details>
                  </article>
                ))}
              </div>
            </section>
          </>
        )}
      </>
    )}

    {isSeason && season && (
      <>
        {seasonNotPlayed && (
          <p class="notice" id={`notplayed-${season.year}`} role="note">
            <strong>The {season.year} season hasn't been played yet.</strong>
            {seasonPreview
              ? <> Here is the alignment it starts from — records begin in Week 1.</>
              : <> Its alignment hasn't been published yet either; divisions appear here once they're set.</>}
          </p>
        )}
        {seasonStandingsOnly && (
          <p class="notice" id={`nolog-${season.year}`} role="note">
            <strong>{season.year} has no game-by-game log.</strong> Interdivisional records can't be
            computed for this season, so no division is ranked. Final standings are shown instead.
          </p>
        )}

        {seasonHasGames && season.strongest && (
          <section class="verdict-banner" aria-labelledby="season-verdict">
            <h2 id="season-verdict" class="visually-hidden">Strongest and weakest division in {season.year}</h2>
            <div class="verdict-banner__main">
              <p class="verdict-banner__kicker">Strongest</p>
              <p class="verdict-banner__name">{season.strongest}</p>
              <p class="verdict-banner__stat">
                {(() => {
                  const d = season.divisions.find((x) => x.name === season.strongest);
                  return d?.interDivision ? `${formatRecord(d.interDivision)} (${formatWinPct(d.interDivision)}) against the rest of the league` : '';
                })()}
              </p>
            </div>
            <div class="verdict-banner__foil">
              <p class="verdict-banner__kicker">Weakest</p>
              <p class="verdict-banner__name">{season.weakest}</p>
              <p class="verdict-banner__stat">
                {(() => {
                  const d = season.divisions.find((x) => x.name === season.weakest);
                  return d?.interDivision ? `${formatRecord(d.interDivision)} (${formatWinPct(d.interDivision)})` : '';
                })()}
              </p>
            </div>
          </section>
        )}

        {/* Suppressed entirely when there is nothing to count: publishing
            "Teams 0 · 0 divisions · 0 playoff berths" presents absence as a
            finding. A previewed season reports its alignment instead. */}
        {seasonPreview ? (
          <div class="metrics-grid metrics-grid--season">
            <MetricCard label="Teams" value={String(seasonPreview.divisions.reduce((n, d) => n + d.members.length, 0))} subtitle={`${seasonPreview.divisions.length} divisions`} />
            <MetricCard label="Regular season" value={season.lastRegularSeasonWeek ? `${season.lastRegularSeasonWeek} weeks` : '—'} subtitle="scheduled" />
            <MetricCard label="New owners" value={String(seasonPreview.totalNewOwners)} subtitle="since last season" />
          </div>
        ) : !seasonHasNothing ? (
          <div class="metrics-grid metrics-grid--season">
            <MetricCard label="Teams" value={String(season.leagueSize)} subtitle={`${season.divisionCount} divisions`} />
            <MetricCard label="Regular season" value={season.lastRegularSeasonWeek ? `${season.lastRegularSeasonWeek} weeks` : '—'} subtitle={seasonHasGames ? 'game log complete' : 'no game log'} />
            <MetricCard label="Playoff berths" value={String(season.divisions.reduce((n, d) => n + d.playoffBerths, 0))} subtitle="across all divisions" />
          </div>
        ) : null}

        {seasonHasGames && season.divisions.length > 1 && (
          <section aria-labelledby="season-matrix-heading">
            <div class="section-header">
              <h2 id="season-matrix-heading" class="section-header__title">Division vs division, {season.year}</h2>
              <p class="section-header__sub">Regular season only.</p>
            </div>
            <DivisionMatrix
              rows={season.divisions.map((d) => ({ name: d.name, slug: d.slug, vs: d.vs }))}
              idPrefix={`y${season.year}`}
              caption={`Each row shows that division's ${season.year} record against the division named in the column.`}
            />
          </section>
        )}

        {seasonPreview && (
          <section aria-labelledby="season-preview-heading">
            <div class="section-header">
              <h2 id="season-preview-heading" class="section-header__title">{season.year} alignment</h2>
              <p class="section-header__sub">
                Who is in each division for the coming season. No games played yet, so there are no
                records to show — {seasonPreview.totalNewOwners > 0
                  ? <>an owner marked <em>new</em> took over since {seasonPreview.previousPlayedYear}.</>
                  : <>every team is where it finished {seasonPreview.previousPlayedYear}.</>}
              </p>
            </div>
            <div class="division-panels">
              {seasonPreview.divisions.map((d) => (
                <article class="division-panel">
                  <header class="panel-head">
                    <h3 class="panel-name">{d.name}</h3>
                    {!d.unchanged && <span class="pill pill--new">changed</span>}
                  </header>
                  <ul class="preview-members">
                    {d.members.map((m) => (
                      <li class:list={['preview-member', { 'preview-member--new': m.newOwner }]}>
                        {m.icon && <img src={m.icon} alt="" loading="lazy" width="26" height="26" />}
                        {/* One label, not two. Now that an owner is labelled by
                            team, a separate owner column repeated the team name
                            on 38 of these 41 rows — so the name IS the link.
                            The one co-owned holding keeps the name unlinked
                            rather than picking one of the two to point at; the
                            owner-era table below links both. */}
                        {m.owners.length === 1 ? (
                          <a class="preview-team" href={ownerHref(m.owners[0].slug)}>{m.nameMedium ?? m.name}</a>
                        ) : (
                          <span class="preview-team">{m.nameMedium ?? m.name}</span>
                        )}
                        {m.owners.length > 1 && <span class="pill pill--shared">Co-owned</span>}
                        {m.newOwner && (
                          <span class="pill pill--new">
                            new<span class="visually-hidden"> owner{m.previousOwners.length > 0 ? `, replacing ${m.previousOwners.map(teamLabelLong).join(' and ')}` : ''}</span>
                          </span>
                        )}
                        {m.movedDivision && m.previousDivision && (
                          <span class="pill pill--sample">from {m.previousDivision}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        )}

        {!seasonPreview && !seasonHasNothing && (
        <section aria-labelledby="season-divisions-heading">
          <div class="section-header">
            <h2 id="season-divisions-heading" class="section-header__title">{season.year} by division</h2>
            <p class="section-header__sub">
              {seasonHasGames ? 'Strongest first.' : 'In division order.'}
            </p>
          </div>
          <div class="division-panels">
            {(seasonHasGames ? seasonRanked : season.divisions).map((d) => (
              <article class="division-panel">
                <header class="panel-head">
                  <h3 class="panel-name">{d.name}</h3>
                  {d.rank !== null && (
                    <span class:list={['rank-chip', 'rank-chip--lg', { 'rank-chip--top': d.rank === 1 }]}>
                      {ordinal(d.rank)}<span class="visually-hidden"> strongest of {season.divisionCount}</span>
                    </span>
                  )}
                </header>

                <dl class="detail-rows">
                  <div class="detail-row">
                    <dt class="detail-label">Record</dt>
                    <dd class="detail-value">{formatRecord(d.totals)} <span class="dim">({formatWinPct(d.totals)})</span></dd>
                  </div>
                  {d.interDivision && (
                    <div class="detail-row">
                      <dt class="detail-label">vs others</dt>
                      <dd class="detail-value">{formatRecord(d.interDivision)} <span class="dim">({formatWinPct(d.interDivision)})</span></dd>
                    </div>
                  )}
                  <div class="detail-row">
                    <dt class="detail-label">Winner</dt>
                    <dd class="detail-value">{d.divisionWinner?.name ?? '—'}</dd>
                  </div>
                </dl>

                <div class="table-scroll">
                  <table class="season-team-table"
                    aria-describedby={seasonStandingsOnly ? `nolog-${season.year}` : seasonNotPlayed ? `notplayed-${season.year}` : undefined}>
                    <caption class="visually-hidden">{d.name} teams in {season.year}</caption>
                    <thead>
                      <tr>
                        <th scope="col">Team</th>
                        {!seasonNotPlayed && <th scope="col" class="num">W-L</th>}
                        {!seasonNotPlayed && <th scope="col" class="num">PF</th>}
                        {seasonHasGames && <th scope="col" class="num">PA</th>}
                      </tr>
                    </thead>
                    <tbody>
                      {d.teams.map((t) => (
                        <tr>
                          <th scope="row" class="team-cell">
                            <span class="team-lockup">
                              {t.icon && <img src={t.icon} alt="" loading="lazy" width="22" height="22" />}
                              <span class="team-name">{t.nameMedium ?? t.name}</span>
                              {t.wonDivision && <span class="tag" role="img" aria-label="Division winner" title="Division winner">🛡</span>}
                              {t.playoffResult === 'champion' && <span class="tag" role="img" aria-label="League champion" title="League champion">🏆</span>}
                            </span>
                          </th>
                          {!seasonNotPlayed && <td class="num">{formatRecord(t)}</td>}
                          {!seasonNotPlayed && <td class="num">{t.pointsFor.toFixed(1)}</td>}
                          {seasonHasGames && <td class="num">{t.pointsAgainst?.toFixed(1) ?? '—'}</td>}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </article>
            ))}
          </div>
        </section>
        )}
      </>
    )}

    <p class="footnote">
      Built from every season's final standings and its own game log, {firstYear}–{lastYear}.
      Includes seasons played under former owners, which franchise pages don't show.
      {generatedLabel && <> Updated {generatedLabel}.</>}
    </p>
  </div>
</TheLeagueLayout>

<style>
  /* Local aliases so no child hardcodes a token name — and so the accent is
     changed in exactly one place if it ever needs to be.

     --ds-accent is --league-accent, NOT --color-primary. That is deliberate:
     --color-primary is BLUE on AFL light mode (only html.dark[data-league=afl]
     pins red), so every accent painted with it wears TheLeague's identity on
     an AFL page. Do not "fix" this back to --color-primary. */
  .ds-page {
    --ds-accent: var(--league-accent, #1c497c);
    --ds-surface: var(--card-bg, #fff);
    --ds-surface-muted: var(--content-bg-muted, #f7f7f7);
    --ds-border: var(--content-border, #e5e5e5);
    --ds-ink: var(--page-text, #1a1a1a);
    --ds-ink-muted: var(--content-text-muted, #666);
    --ds-section-size: 0.75rem;

    padding: 1.5rem 1rem 4rem;
  }
  /* AFL sets its body face to UFC Sans Condensed, which reads visibly smaller
     at the same size — hence 0.9rem for its section titles. A bare
     html[data-league='afl'] inside a scoped style block gets scoped and dies,
     so this needs :global(). */
  :global(html[data-league='afl']) .ds-page { --ds-section-size: 0.9rem; }

  .ds-head { margin: 0.25rem 0 1.5rem; }
  h1 {
    margin: 0.25rem 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .ds-head__year { color: var(--ds-ink-muted); font-weight: 400; }
  .lede {
    margin: 0;
    max-width: 70ch;
    color: var(--ds-ink-muted);
    line-height: 1.55;
  }
  .dim { color: var(--ds-ink-muted); }

  /* ── Section headers ───────────────────────────────────────────────────── */
  .section-title,
  .section-header__title {
    margin: 0;
    font-size: var(--ds-section-size);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ds-ink);
    border-left: 2px solid var(--ds-accent);
    padding-left: 0.625rem;
    line-height: 1.3;
  }
  .section-header { margin: 2.5rem 0 1rem; }
  .section-header__sub {
    margin: 0.375rem 0 0 0.75rem;
    font-size: 0.8125rem;
    color: var(--ds-ink-muted);
  }
  section + section { margin-top: 0; }

  /* ── Season rail ───────────────────────────────────────────────────────── */
  .season-rail { margin: 0 0 0.5rem; }
  .season-rail__track {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    overflow-x: auto;
    padding: 0.25rem 0 0.5rem;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    /* Keyboard focus scrolls a chip flush to left:0 — exactly where the opaque
       sticky "All-time" chip is painted one layer above, hiding the focus ring.
       Reserve its width so a tabbed-to chip lands clear of it. */
    scroll-padding-left: 7rem;
  }
  .season-chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-full, 999px);
    background: var(--ds-surface);
    color: var(--ds-ink);
    text-decoration: none;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    scroll-snap-align: start;
    flex: 0 0 auto;
    /* Containing block for the "(standings only)" visually-hidden span — an
     * absolutely positioned span with auto offsets otherwise resolves against
     * the initial containing block and sits far outside the viewport in
     * document coordinates, growing the page's scroll width. The AFL rail (24
     * chips) pushed the whole page 679px sideways before this. Same trap
     * documented at length in DivisionMatrix.astro's .dsm-cell. */
    position: relative;
  }
  .season-chip:hover { border-color: var(--ds-accent); }
  .season-chip[aria-current='page'] {
    background: var(--ds-accent);
    border-color: var(--ds-accent);
    color: #fff;
    font-weight: 700;
  }
  /* --league-accent is a LIGHT blue/red in dark mode (#3b82f6 / #ef5350), so
     white-on-accent measures 3.68:1 and 3.49:1 — under the 4.5:1 floor, and
     14px/700 does not qualify as large text (that floor is 18.66px bold). This
     is the current-page marker on the page's primary control, so it is the one
     chip that must be legible. Dark ink on the same accent measures 5.09:1 and
     5.37:1. Note this also protects best-ball, whose dark accent (#34d399) is
     1.92:1 against white — the page is not on bb1 today, but the moment it is,
     white ink here would be unreadable. */
  :global(html.dark) .season-chip[aria-current='page'] { color: #0b1220; }
  /* Sticky so the way back to all-time is one click from anywhere in the rail,
     even scrolled 24 years to the right. */
  .season-chip--alltime {
    position: sticky;
    left: 0;
    z-index: 1;
    box-shadow: 0.5rem 0 0.5rem -0.5rem rgb(0 0 0 / 0.12);
  }
  .season-chip--nolog::after {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--ds-ink-muted);
    margin-left: 0.375rem;
  }
  .rail-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0 0 1.5rem;
    font-size: 0.75rem;
    color: var(--ds-ink-muted);
  }
  .rail-legend__key { display: inline-flex; align-items: center; gap: 0.375rem; }
  .rail-legend__dot {
    width: 4px; height: 4px; border-radius: 999px;
    background: var(--ds-ink-muted);
  }
  /* A ring, not a second dot — the two states must differ in SHAPE, since a
     filled vs hollow 4px dot is not a distinction anyone can make. */
  .rail-legend__ring {
    width: 6px; height: 6px; border-radius: 999px;
    border: 1px solid var(--ds-ink-muted);
  }
  .season-chip--upcoming::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    border: 1px solid currentColor;
    opacity: 0.7;
    margin-left: 0.375rem;
  }

  /* ── The paired podium ─────────────────────────────────────────────────── */
  .verdict-pair { margin: 1.5rem 0 0; }
  .verdict-list { list-style: none; margin: 0; padding: 0; }
  .verdict-list--solo {
    margin-top: 1rem;
    padding: 0.5rem 1.25rem;
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-md, 0.625rem);
  }
  /* `center`, not `baseline`: every row now carries crests, and a 20px image
     sitting on a text baseline hangs the row. */
  .verdict-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--ds-border);
  }
  .verdict-list li:last-child { border-bottom: none; }
  .verdict-rank {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ds-ink-muted);
    min-width: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .verdict-name { font-weight: 700; color: inherit; text-decoration: none; }
  .verdict-name:hover { text-decoration: underline; }
  .verdict-value {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .verdict-note {
    margin: 0.875rem 0 0;
    max-width: 78ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ds-ink-muted);
  }

  /* ── Crests inside a ranked row ────────────────────────────────────────── */
  /* Pushed right so they form a column of their own instead of trailing a
     name whose width changes every row. The `+` selector out-specifies
     `.verdict-value { margin-left: auto }` — with two `auto` margins the gap
     splits between them and neither column lines up. */
  .verdict-list .member-icons { margin-left: auto; flex: 0 0 auto; }
  .verdict-list .member-icons + .verdict-value { margin-left: 1rem; }
  .verdict-list .member-icons img,
  .verdict-list .member-initials { width: 20px; height: 20px; }
  /* A franchise that has left the division still earned part of the record,
     so it stays in the row and reads as history. Never colour alone — the
     title attribute says "no longer in the …" too. */
  .member-slot--past { opacity: 0.4; filter: grayscale(1); }

  /* ── The era board ─────────────────────────────────────────────────────── */
  .era-board__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .era-board__years {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ds-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .era-board .verdict-value { text-align: right; }
  .era-board__inter {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ds-ink-muted);
  }
  /* Below the fold of a phone the crests and the record cannot share a line,
     so the row becomes three: identity, crests, numbers. `flex-basis: 100%`
     rather than letting the crests wrap on their own — a wrap that depends on
     name length puts them beside a short name and under a long one, so the
     board alternates two- and three-line rows down the column. Claiming the
     whole line also pushes the record onto its own line on every row, which
     is what keeps the numbers in a straight right-hand edge. */
  @media (max-width: 559px) {
    .verdict-list li { flex-wrap: wrap; row-gap: 0.25rem; }
    .verdict-list .member-icons { margin-left: 0; order: 3; flex: 0 0 100%; }
    .verdict-list .member-icons + .verdict-value { margin-left: auto; order: 4; }
    .verdict-rank { order: 1; }
    /* Direct children only. `.verdict-name` and `.pill` are nested inside
       `.era-board__name` on the era board, and that span is itself a flex
       container — an unscoped `order: 2` reached in and reordered ITS
       children, leaving `.era-board__years` on the implicit 0 and flipping
       the label to "2019-present North" on a phone while desktop read
       "North 2019-present". */
    .era-board__name,
    .verdict-list > li > .verdict-name,
    .verdict-list > li > .pill { order: 2; }
    .era-board__inter { display: inline; margin-left: 0.5rem; }
  }

  /* ── Pills ─────────────────────────────────────────────────────────────── */
  .pill {
    display: inline-block;
    padding: 0.0625rem 0.4375rem;
    border-radius: var(--radius-full, 999px);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
  }
  .pill--retired {
    background: var(--ds-surface-muted);
    color: var(--ds-ink-muted);
    border: 1px solid var(--ds-border);
  }
  .pill--sample {
    background: transparent;
    color: var(--ds-ink-muted);
    border: 1px dashed var(--ds-border);
    font-weight: 600;
  }
  .pill--shared {
    background: var(--ds-surface-muted);
    color: var(--ds-ink-muted);
    border: 1px solid var(--ds-border);
    font-weight: 600;
  }

  /* ── All-time table ────────────────────────────────────────────────────── */
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--ds-surface);
  }
  /* Every one of these tables lives inside a horizontal scroller and carries
   * visually-hidden spans (captions, sort-state text, rank context). They and
   * their cells need their own containing block or those spans escape to the
   * initial containing block and widen the document — see .season-chip above. */
  .strength-table { scroll-margin-top: 5rem; }
  .strength-table,
  .owner-era-table,
  .season-team-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    position: relative;
  }
  .strength-table th,
  .strength-table td,
  .owner-era-table th,
  .owner-era-table td,
  .season-team-table th,
  .season-team-table td { position: relative; }
  .strength-table thead th,
  .owner-era-table thead th,
  .season-team-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--ds-surface);
    box-shadow: inset 0 -1px 0 var(--ds-border);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ds-ink-muted);
    text-align: left;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
  }
  .strength-table th.num,
  .owner-era-table th.num,
  .season-team-table th.num,
  .strength-table td.num,
  .owner-era-table td.num,
  .season-team-table td.num { text-align: right; }
  .strength-table tbody td,
  .strength-table tbody th,
  .owner-era-table tbody td,
  .owner-era-table tbody th,
  .season-team-table tbody td,
  .season-team-table tbody th {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--ds-border);
    text-align: left;
    font-weight: 400;
    vertical-align: middle;
  }
  .strength-table tbody tr:last-child td,
  .strength-table tbody tr:last-child th,
  .owner-era-table tbody tr:last-child td,
  .owner-era-table tbody tr:last-child th,
  .season-team-table tbody tr:last-child td,
  .season-team-table tbody tr:last-child th { border-bottom: none; }
  .strength-table tbody tr:hover,
  .owner-era-table tbody tr:hover,
  .season-team-table tbody tr:hover { background: var(--table-row-bg-hover, #f4f4f4); }

  .sort-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .sort-link:hover { color: var(--ds-ink); }
  .sort-link:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  th.num .sort-link { justify-content: flex-end; }
  /* Space is reserved on every header so sorting doesn't shift the layout;
     only the active column's caret is visible. */
  .sort-caret { width: 0.6em; visibility: hidden; font-size: 0.75em; }
  .sort-caret::before { content: '▾'; }
  th[aria-sort] .sort-caret { visibility: visible; color: var(--ds-accent); }
  th[aria-sort='ascending'] .sort-caret::before { content: '▴'; }

  .name-cell { min-width: 12rem; }
  .name-link {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    margin-right: 0.375rem;
  }
  .name-link:hover { text-decoration: underline; }
  .span-text {
    display: block;
    font-size: 0.75rem;
    color: var(--ds-ink-muted);
    font-variant-numeric: tabular-nums;
    margin-top: 0.125rem;
  }
  .strength-row--retired { background: var(--ds-surface-muted); }
  .strength-row--retired .name-link { font-weight: 600; }

  .rec { display: block; font-weight: 600; }
  .pct { display: block; font-size: 0.75rem; color: var(--ds-ink-muted); }
  .metric-col { min-width: 7rem; }
  .unit { font-weight: 400; font-size: 0.75rem; color: var(--ds-ink-muted); }

  /* ── Current-lineup table ──────────────────────────────────────────────── */
  /* Both tables now carry a crest column, so the floor applies to both. The
     all-time one runs wider than this on its own — every franchise ever in the
     division, twelve of them in the AFL's West — and both tables sit in a
     horizontal scroller, so it grows rather than squeezing the numbers. */
  .strength-table .member-cell { min-width: 8rem; }
  .member-icons { display: inline-flex; align-items: center; }
  .member-icons img,
  .member-initials {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    object-fit: contain;
    background: var(--ds-surface-muted);
    border: 1px solid var(--ds-surface);
    margin-left: -5px;
  }
  .member-icons img:first-child,
  .member-initials:first-child { margin-left: 0; }
  .member-initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ds-ink-muted);
  }
  /* A slot whose holder changed for the coming season gets a ring in the
     league accent — plus the "new owner" pill and the What's Changed list, so
     the signal is never colour alone. */
  .member-slot { display: inline-flex; border-radius: 999px; }
  .member-slot--new {
    box-shadow: 0 0 0 2px var(--ds-accent);
    position: relative;
    z-index: 1;
  }
  .pill--new {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.0625rem 0.4375rem;
    border-radius: var(--radius-full, 999px);
    background: color-mix(in srgb, var(--ds-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--ds-accent) 35%, transparent);
    color: var(--ds-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ── What's changed for the coming season ──────────────────────────────── */
  .whats-changed {
    margin: 0 0 1rem;
    padding: 0.875rem 1rem;
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-left: 3px solid var(--ds-accent);
    border-radius: var(--radius-md, 0.5rem);
  }
  .whats-changed__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ds-accent);
  }
  .whats-changed__list { list-style: none; margin: 0; padding: 0; }
  .whats-changed__list li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.25rem 0;
    font-size: 0.875rem;
  }
  .whats-changed__div {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    min-width: 6rem;
  }
  .whats-changed__div:hover { text-decoration: underline; }
  .whats-changed__item { display: inline-flex; align-items: center; gap: 0.375rem; }
  .whats-changed__item img { width: 20px; height: 20px; object-fit: contain; border-radius: 999px; }
  .whats-changed__item a { color: inherit; }
  .whats-changed__note {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ds-ink-muted);
  }

  /* Direction is carried by the glyph as well as the hue, so this survives
     grayscale and colour-blind viewing. */
  .delta { margin-left: 0.3125rem; font-weight: 700; }
  .delta--up { color: #1f5d2d; }
  .delta--down { color: #8b2a1f; }
  :global(html.dark) .delta--up { color: #7ee0a0; }
  :global(html.dark) .delta--down { color: #ff9c8a; }

  /* ── Season preview (alignment set, nothing played yet) ────────────────── */
  .preview-members { list-style: none; margin: 0; padding: 0; }
  .preview-member {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.4375rem 0;
    border-bottom: 1px solid var(--ds-border);
    font-size: 0.875rem;
  }
  .preview-member:last-child { border-bottom: none; }
  .preview-member img { width: 26px; height: 26px; object-fit: contain; flex: 0 0 auto; }
  .preview-team { font-weight: 700; }
  a.preview-team { color: inherit; text-decoration: none; }
  a.preview-team:hover { text-decoration: underline; }
  .preview-member--new .preview-team { color: var(--ds-accent); }

  /* ── Membership era history ────────────────────────────────────────────── */
  .era-list { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .era-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.25rem 0;
    font-size: 0.8125rem;
    border-bottom: 1px solid var(--ds-border);
  }
  .era-list li:last-child { border-bottom: none; }
  .era-years { font-weight: 700; font-variant-numeric: tabular-nums; min-width: 6.5rem; }
  .era-rec { color: var(--ds-ink-muted); font-variant-numeric: tabular-nums; }
  /* Why the era before this one ended — a takeover keeps the crests, so
     without it two rows can look identical. */
  .era-change {
    font-size: 0.6875rem;
    color: var(--ds-ink-muted);
    border: 1px solid var(--ds-border);
    border-radius: 999px;
    padding: 0.0625rem 0.375rem;
    white-space: nowrap;
  }
  .era-current { margin-left: auto; }
  /* The shared .member-icons rule sizes to 24px; the era list runs denser. */
  .era-list .member-icons img,
  .era-list .member-initials { width: 20px; height: 20px; }

  .rank-chip {
    display: inline-block;
    min-width: 1.25rem;
    padding: 0 0.25rem;
    margin-right: 0.375rem;
    border-radius: 0.25rem;
    background: var(--ds-surface-muted);
    border: 1px solid var(--ds-border);
    color: var(--ds-ink-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    text-align: center;
    vertical-align: 1px;
  }
  .rank-chip--top {
    background: color-mix(in srgb, var(--ds-accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--ds-accent) 35%, transparent);
    color: var(--ds-accent);
  }
  .rank-chip--lg {
    font-size: 0.8125rem;
    padding: 0.125rem 0.5rem;
    margin: 0;
  }

  /* ── Season verdict banner — deliberately decisive ─────────────────────── */
  .verdict-banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.375rem;
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-left: 3px solid var(--ds-accent);
    border-radius: var(--radius-md, 0.625rem);
  }
  @media (min-width: 640px) {
    .verdict-banner { grid-template-columns: 2fr 1fr; align-items: end; }
  }
  .verdict-banner__kicker {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-ink-muted);
  }
  .verdict-banner__name {
    margin: 0.125rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--ds-ink);
  }
  .verdict-banner__foil .verdict-banner__name { font-size: 1.0625rem; font-weight: 700; }
  .verdict-banner__stat {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ds-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── Metric strip ──────────────────────────────────────────────────────── */
  /* Two columns, not three: the division panel's strip carries FOUR cards
     (overall, interdivisional, berths, championships), and a three-up grid
     strands the fourth alone on a second row at every width. The season strip
     still carries three and keeps its own column count. */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
    margin: 0.875rem 0;
  }
  .metrics-grid--season {
    grid-template-columns: repeat(3, 1fr);
    margin: 1.5rem 0 0;
  }
  @media (max-width: 767px) {
    .metrics-grid--season { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Division panels ───────────────────────────────────────────────────── */
  .division-panels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: 1rem;
  }
  .division-panel {
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-left: 3px solid var(--ds-accent);
    border-radius: var(--radius-md, 0.625rem);
    padding: 1rem 1.125rem 1.125rem;
    scroll-margin-top: 5rem;
  }
  .division-panel--retired { border-left-color: var(--ds-border); }
  .panel-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .panel-name { margin: 0; font-size: 1.125rem; font-weight: 800; }
  .panel-span {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    flex: 1 1 auto;
  }
  .panel-span .span-text { margin: 0; }

  /* Active and retired differ in SHAPE, not saturation — the active bar fades
     out at its right edge (ongoing), the retired one ends on a hard tick
     (a tombstone). Survives grayscale and colour-blind viewing. */
  .span-bar {
    position: relative;
    display: block;
    height: 4px;
    width: 6rem;
    flex: 0 0 auto;
    border-radius: var(--radius-full, 999px);
    background: var(--ds-border);
  }
  .span-bar__seg {
    position: absolute;
    inset-block: 0;
    border-radius: var(--radius-full, 999px);
    left: calc(var(--from) * 100%);
    width: calc((var(--to) - var(--from)) * 100%);
  }
  .span-bar--active .span-bar__seg {
    background: var(--ds-accent);
  }
  .span-bar--active .span-bar__seg:last-child {
    mask-image: linear-gradient(90deg, #000 78%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 78%, transparent);
  }
  .span-bar--retired .span-bar__seg { background: var(--ds-ink-muted); }
  .span-bar--retired .span-bar__seg:last-child::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 2px;
    height: 10px;
    background: var(--ds-ink-muted);
    border-radius: 1px;
  }

  .detail-rows { margin: 0 0 0.875rem; }
  .detail-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.1875rem 0;
    font-size: 0.8125rem;
  }
  .detail-label {
    flex: 0 0 4.5rem;
    text-align: right;
    color: var(--ds-ink-muted);
    font-weight: 600;
  }
  .detail-value { margin: 0; font-variant-numeric: tabular-nums; }

  /* ── Owner eras ────────────────────────────────────────────────────────── */
  .owner-eras { border-top: 1px solid var(--ds-border); padding-top: 0.75rem; }
  .owner-eras__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    min-height: 44px;
    font-size: 0.875rem;
    list-style: none;
  }
  .owner-eras__summary::-webkit-details-marker { display: none; }
  .owner-eras__summary:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  .owner-eras__caret {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--ds-ink-muted);
    border-bottom: 2px solid var(--ds-ink-muted);
    transform: rotate(-45deg);
    transition: transform var(--transition-base, 0.2s ease);
  }
  .owner-eras[open] .owner-eras__caret { transform: rotate(45deg); }
  .owner-eras__faces { display: inline-flex; }
  .owner-eras__faces img {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    object-fit: contain;
    background: var(--ds-surface-muted);
    border: 1px solid var(--ds-surface);
    margin-left: -6px;
  }
  .owner-eras__faces img:first-child { margin-left: 0; }
  .owner-eras__label { flex: 1 1 auto; }

  /* The 0fr → 1fr reveal needs BOTH wrappers: without `min-height: 0` on the
     inner one the table's intrinsic height defeats the 0fr track and nothing
     collapses. Browsers hide <details> content on close, so this animates open
     only and closes instantly — accepted, since the alternative needs JS. */
  .owner-eras__reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base, 0.25s ease);
  }
  .owner-eras[open] .owner-eras__reveal { grid-template-rows: 1fr; }
  .owner-eras__inner {
    min-height: 0;
    overflow: hidden;
  }
  .owner-eras__scroll {
    max-height: 30rem;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--ds-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--ds-surface-muted);
  }
  /* AFL dark collapses --card-bg / --card-surface / --content-bg to one value,
     so a table inside a panel inside the page is three identical surfaces.
     --color-surface-3 is dark-only by design — safe only in here. */
  :global(html.dark) .owner-eras__scroll { background: var(--color-surface-3); }
  .owner-era-table thead th { background: var(--ds-surface-muted); }
  :global(html.dark) .owner-era-table thead th { background: var(--color-surface-3); }
  .table-note {
    margin: 0.625rem 0 0.5rem;
    font-size: 0.75rem;
    color: var(--ds-ink-muted);
    line-height: 1.5;
  }
  .owner-cell { min-width: 10rem; max-width: 14rem; }
  .owner-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }
  /* Labelling by latest team name removed the 68-character rebrand-joined
   * titles that dragged a row to three lines, but a team name can still be
   * long ("Broke Back Mountaineers"). Keep the fallback: one line, ellipsis,
   * full text on the owner page the link points at. */
  .owner-link > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .owner-link:hover { text-decoration: underline; }
  .owner-link img { width: 20px; height: 20px; object-fit: contain; flex: 0 0 auto; }
  /* Wrap BETWEEN runs, never inside one — "2011–" / "2013" on two lines is
     unreadable. */
  .stints { white-space: normal; font-variant-numeric: tabular-nums; }
  .stint { white-space: nowrap; }

  /* ── Season team tables ────────────────────────────────────────────────── */
  /* The lockup is an inner span, NOT the cell.
   *
   * `display: flex` on a <th>/<td> stops it being a table cell: it leaves the
   * column grid and draws its border-bottom across its own box instead of the
   * row, which shipped here as a row underline that stopped short under any
   * team whose name wrapped. Lay the children out inside the cell instead. */
  .team-cell { min-width: 11rem; padding-left: 0.875rem; }
  .team-lockup { display: flex; align-items: center; gap: 0.5rem; }
  .team-lockup img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex: 0 0 auto;
