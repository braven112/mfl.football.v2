---
/**
 * Site search — the searchable index of every page a league has.
 *
 * Shared body behind /theleague/search and /afl-fantasy/search. It was
 * TheLeague's page alone until Sep 2026; extracted here rather than copied so
 * the AFL's copy can't drift (see tests/page-fork-ratchet.test.ts).
 *
 * The index (league scoping, hrefs, usage ranking) is built by
 * src/utils/page-search-index.ts, which the header's inline search
 * (HeaderSearch.astro) reads too. `?q=` arrives pre-typed when someone presses
 * "See all results" in that dropdown.
 *
 * Typing a player's name lists him above the pages, from the same prerendered
 * player index and the same links as the header's search
 * (src/utils/player-search-client.ts), fetched on the first keystroke.
 */
import { spriteUrlFor } from '../../../utils/sprite-url';
const spriteUrl = spriteUrlFor(Astro.url);
import { getAuthUser, isCommissionerOrAdminForLeague } from '../../../utils/auth';
import { getLeagueBySlug, type CanonicalLeagueSlug } from '../../../config/leagues';
import { buildPageSearchIndex } from '../../../utils/page-search-index';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { playerIndexUrl } from '../../../utils/player-search-client';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
}

const { leagueSlug } = Astro.props;

const authUser = getAuthUser(Astro.request);
// Admin of THIS league: the plain role check carries no league, and both
// leagues' search pages are one click apart on the shared host.
const leagueId = getLeagueBySlug(leagueSlug)?.id;
const isAdmin = !!authUser && !!leagueId && isCommissionerOrAdminForLeague(authUser, leagueId);

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;

// Scoped to this league, hrefs prefixed for this host, ranked by real use —
// all in the builder the header's inline search reads too.
const pages = await buildPageSearchIndex(leagueSlug, { isAdmin, hideLeaguePrefix });

// Where a player opens: his team's roster, or Free Agents for a free agent.
const rostersHref = resolveLeaguePath(`/${leagueSlug}/rosters`, hideLeaguePrefix);
const freeAgentsHref = resolveLeaguePath(`/${leagueSlug}/players`, hideLeaguePrefix);

const categories = [
  { id: 'popular', label: 'Popular' },
  { id: 'my-team', label: 'My Team' },
  { id: 'reports', label: 'Reports' },
  { id: 'tools', label: 'Tools' },
  { id: 'info', label: 'Info' },
];
---

<section
  class="directory"
  data-player-index-url={playerIndexUrl(leagueSlug)}
  data-rosters-href={rostersHref}
  data-free-agents-href={freeAgentsHref}
>
  <header class="directory__header">
    <div class="directory__title-row">
      <h1 class="directory__title">Search</h1>
      <span class="directory__count">{pages.length} pages</span>
    </div>
    <p class="directory__subtitle">Find any page by name, category, or keyword, or any player by name.</p>

    <div class="directory__search-bar">
      <svg class="directory__search-icon" viewBox="0 0 512 512" aria-hidden="true">
        <use href={`${spriteUrl}#icon-search`}></use>
      </svg>
      <input
        type="search"
        class="directory__search"
        data-site-search-input
        placeholder="Search pages and players... (e.g. trade, Josh Allen)"
        autocomplete="off"
      />
    </div>
  </header>

  <nav class="directory__filters" aria-label="Filter by category">
    {categories.map(cat => (
      <button class="directory__chip" data-category={cat.id} type="button">
        {cat.label}
      </button>
    ))}
    <button class="directory__chip directory__chip--clear" type="button" style="display:none;">
      &times; Clear
    </button>
  </nav>

  <div class="directory__players" hidden>
    <h2 class="directory__section-title">Players</h2>
    <div class="directory__player-grid"></div>
    <h2 class="directory__section-title" data-pages-title>Pages</h2>
  </div>

  <div class="directory__grid">
    {pages.map(page => (
      <a
        href={page.href}
        class="directory__card"
        data-search={page.search}
        data-category={page.category}
        data-rank={page.rank}
      >
        <div class="directory__card-icon">
          <svg viewBox="0 0 512 512" aria-hidden="true">
            <use href={`${spriteUrl}#icon-${page.icon}`}></use>
          </svg>
        </div>
        <div class="directory__card-content">
          <div class="directory__card-title-row">
            <h2 class="directory__card-title">{page.title}</h2>
            {page.admin && (
              <span class="directory__admin-badge">Admin</span>
            )}
          </div>
          <p class="directory__card-desc">{page.description}</p>
          <div class="directory__card-tags">
            {page.tags.slice(0, 4).map((tag: string) => (
              <span class="directory__tag">{tag}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>

  <p class="directory__no-results" style="display:none;">Nothing matches your search.</p>
</section>

<style>
  .directory {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: 3rem;
  }

  .directory__header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .directory__title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .directory__title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-gray-900, #0f172a);
  }

  .directory__count {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gray-400, #94a3b8);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .directory__subtitle {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-gray-500, #64748b);
  }

  .directory__search-bar {
    position: relative;
    margin-top: 0.75rem;
    max-width: 480px;
  }

  .directory__search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    fill: var(--color-gray-400, #94a3b8);
    pointer-events: none;
  }

  .directory__search {
    width: 100%;
    padding: 0.6rem 0.75rem 0.6rem 2.25rem;
    border: 2px solid var(--color-gray-100, #e2e8f0);
    border-radius: 10px;
    font-size: var(--font-size-sm);
    color: var(--input-text, #0f172a);
    background: var(--input-bg, #fff);
    outline: none;
    transition: border-color 0.15s;
  }

  .directory__search:focus {
    border-color: #3b82f6;
  }

  .directory__search::placeholder {
    color: var(--color-gray-400, #94a3b8);
  }

  /* Category filter chips */
  .directory__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .directory__chip {
    padding: 0.35rem 0.85rem;
    border: 2px solid var(--color-gray-100, #e2e8f0);
    border-radius: 20px;
    background: var(--card-bg, #fff);
    color: var(--color-gray-600, #475569);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }

  .directory__chip:hover {
    border-color: var(--color-gray-400, #94a3b8);
    color: var(--color-gray-900, #0f172a);
  }

  .directory__chip.active {
    background: var(--color-gray-900, #0f172a);
    border-color: var(--color-gray-900, #0f172a);
    color: var(--page-bg, #fff);
  }

  .directory__chip--clear {
    border-color: var(--color-error, #ef4444);
    color: var(--color-error, #ef4444);
  }

  .directory__chip--clear:hover {
    background: var(--color-error, #ef4444);
    border-color: var(--color-error, #ef4444);
    color: var(--btn-primary-text, #fff);
  }

  /* Card grid */
  .directory__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0.75rem;
  }

  .directory__card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem;
    border: 1px solid var(--color-gray-100, #e2e8f0);
    border-radius: 12px;
    background: var(--card-bg, #fff);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .directory__card:hover {
    border-color: var(--color-gray-200, #cbd5e1);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  }

  :global(html.dark) .directory__card {
    box-shadow: 0 0 0 1px var(--content-border, #555), var(--shadow-lg);
  }

  :global(html.dark) .directory__card:hover {
    box-shadow: 0 0 0 1px var(--color-gray-200, #555), var(--shadow-lg);
  }

  .directory__card[hidden] {
    display: none;
  }

  .directory__card-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-gray-50, #f8fafc);
  }

  .directory__card-icon svg {
    width: 20px;
    height: 20px;
    fill: var(--color-primary, #1c497c);
    color: var(--color-primary, #1c497c);
  }

  .directory__card-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .directory__card-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .directory__card-title {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-gray-900, #0f172a);
    line-height: 1.3;
  }

  .directory__admin-badge {
    flex-shrink: 0;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--badge-warning-bg, #fef3c7);
    color: var(--badge-warning-text, #92400e);
    font-size: var(--font-size-3xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .directory__card-desc {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-gray-500, #64748b);
    line-height: 1.4;
  }

  .directory__card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }

  .directory__tag {
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--color-gray-50, #f1f5f9);
    color: var(--color-gray-500, #64748b);
    font-size: var(--font-size-3xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Players: shown above the pages while a search names one */
  .directory__players {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .directory__players[hidden] {
    display: none;
  }

  .directory__section-title {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-500, #64748b);
  }

  .directory__player-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  /* Player cards are built in the script, so they carry no scope attribute:
     style them through the scoped grid that holds them. */
  .directory__player-grid :global(.directory__player) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem;
    border: 1px solid var(--color-gray-100, #e2e8f0);
    border-radius: 12px;
    background: var(--card-bg, #fff);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .directory__player-grid :global(.directory__player:hover) {
    border-color: var(--color-gray-200, #cbd5e1);
    box-shadow: var(--shadow-md);
  }

  :global(html.dark) .directory__player-grid :global(.directory__player) {
    border-color: var(--content-border, #555);
    box-shadow: var(--shadow-lg);
  }

  .directory__player-grid :global(.directory__pos) {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-gray-50, #f8fafc);
    color: var(--color-primary, #1c497c);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .directory__player-grid :global(.directory__player-text) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .directory__player-grid :global(.directory__player-name) {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-gray-900, #0f172a);
    line-height: 1.3;
  }

  .directory__player-grid :global(.directory__player-detail) {
    font-size: var(--font-size-xs);
    color: var(--color-gray-500, #64748b);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory__no-results {
    text-align: center;
    color: var(--color-gray-500, #64748b);
    font-size: 0.9375rem;
    padding: 2rem 0;
  }

  @media (max-width: 640px) {
    .directory__grid {
      grid-template-columns: 1fr;
    }

    .directory__search-bar {
      max-width: none;
    }

    .directory__player-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { matchPages } from '../../../utils/page-search-match';
  import { loadPlayerIndex, searchPlayers, type PlayerLink } from '../../../utils/player-search-client';

  const MAX_PLAYERS = 12;

  function playerCard(link: PlayerLink): HTMLAnchorElement {
    const a = document.createElement('a');
    a.className = 'directory__player';
    a.href = link.href;
    if (link.reload) a.setAttribute('data-astro-reload', '');
    const pos = document.createElement('span');
    pos.className = 'directory__pos';
    pos.setAttribute('aria-hidden', 'true');
    pos.textContent = link.pos;
    const text = document.createElement('span');
    text.className = 'directory__player-text';
    const name = document.createElement('span');
    name.className = 'directory__player-name';
    name.textContent = link.name;
    const detail = document.createElement('span');
    detail.className = 'directory__player-detail';
    detail.textContent = link.detail;
    text.append(name, detail);
    a.append(pos, text);
    return a;
  }


  // Runs once per session under the ClientRouter, so the page is wired on
  // every astro:page-load and every element is read fresh inside init().
  function init() {
    const searchInput = document.querySelector<HTMLInputElement>('.directory__search');
    const grid = document.querySelector<HTMLElement>('.directory__grid');
    if (!searchInput || !grid || grid.dataset.wired) return;
    grid.dataset.wired = '1';

    const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.directory__card'));
    const originalOrder = [...cards]; // preserve initial DOM order
    const entries = cards.map((card) => ({
      card,
      search: card.dataset.search || '',
      title: card.querySelector('.directory__card-title')?.textContent ?? '',
      rank: parseInt(card.dataset.rank || '0', 10),
    }));
    const chips = document.querySelectorAll<HTMLButtonElement>('.directory__chip:not(.directory__chip--clear)');
    const clearBtn = document.querySelector<HTMLButtonElement>('.directory__chip--clear');
    const countEl = document.querySelector<HTMLSpanElement>('.directory__count');
    const noResults = document.querySelector<HTMLParagraphElement>('.directory__no-results');
    const total = cards.length;
    const section = document.querySelector<HTMLElement>('.directory');
    const playersBox = document.querySelector<HTMLElement>('.directory__players');
    const playerGrid = document.querySelector<HTMLElement>('.directory__player-grid');
    let activeCategory: string | null = null;
    let visiblePages = total;
    let playerCount = 0;

    function updateNoResults() {
      if (noResults) noResults.style.display = visiblePages === 0 && playerCount === 0 ? 'block' : 'none';
      const pagesTitle = playersBox?.querySelector<HTMLElement>('[data-pages-title]');
      if (pagesTitle) pagesTitle.hidden = visiblePages === 0;
    }

    // Players are not pages, so a category chip hides them.
    async function renderPlayers() {
      const query = searchInput!.value.trim();
      const url = section?.dataset.playerIndexUrl;
      let links: PlayerLink[] = [];
      if (query && !activeCategory && url && playersBox && playerGrid) {
        const index = await loadPlayerIndex(url).catch(() => null);
        // The box may have moved on while the index loaded.
        if (searchInput!.value.trim() !== query || activeCategory || !playersBox.isConnected) return;
        if (index) {
          const hrefs = {
            rostersHref: section!.dataset.rostersHref!,
            freeAgentsHref: section!.dataset.freeAgentsHref!,
          };
          links = searchPlayers(index, query, hrefs, MAX_PLAYERS);
        }
      }
      playerCount = links.length;
      playerGrid?.replaceChildren(...links.map(playerCard));
      if (playersBox) playersBox.hidden = !playerCount;
      updateNoResults();
    }

    function filterAndSort() {
      const query = searchInput!.value.trim();
      // Same matcher as the header's inline search, so both find the same pages.
      const hits = query ? matchPages(entries, query) : null;
      const matched = hits ? new Set(hits.map((e) => e.card)) : null;
      let visible = 0;

      cards.forEach((card) => {
        const matchesSearch = !matched || matched.has(card);
        const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
        const show = matchesSearch && matchesCategory;
        card.hidden = !show;
        if (show) visible++;
      });

      // When searching, order visible cards as the matcher does (title hits,
      // then real use);
      // when not, restore the original order.
      if (hits) {
        hits
          .filter((e) => !e.card.hidden)
          .forEach((e) => grid!.appendChild(e.card));
        cards.filter((c) => c.hidden).forEach((card) => grid!.appendChild(card));
      } else {
        originalOrder.forEach((card) => grid!.appendChild(card));
      }

      const hasFilter = query || activeCategory;
      if (countEl) {
        countEl.textContent = hasFilter ? `${visible} of ${total} pages` : `${total} pages`;
      }
      visiblePages = visible;
      updateNoResults();
      if (clearBtn) clearBtn.style.display = hasFilter ? 'inline-block' : 'none';
      void renderPlayers();
    }

    function clearAll() {
      activeCategory = null;
      chips.forEach((c) => c.classList.remove('active'));
      searchInput!.value = '';
      filterAndSort();
    }

    searchInput.addEventListener('input', filterAndSort);
    clearBtn?.addEventListener('click', clearAll);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.category || '';
        if (activeCategory === cat) {
          activeCategory = null;
          chip.classList.remove('active');
        } else {
          chips.forEach((c) => c.classList.remove('active'));
          activeCategory = cat;
          chip.classList.add('active');
        }
        filterAndSort();
      });
    });

    // "See all results" in the header's inline search arrives as ?q=.
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      searchInput.value = q;
      filterAndSort();
    }
    searchInput.focus();
  }

  document.addEventListener('astro:page-load', init);
</script>
