---
/**
 * LeagueCompositeHero — a resolved hero view (`EventHeroView`) rendered as a
 * composite, for any league. The AFL routes most of its hero states here
 * (`AflHero`); TheLeague routes its waiver-day card here (`WaiverWireHero`).
 * The `league` prop picks the crest, franchise skin and fallback mark.
 *
 * It began as the AFL's answer to TheLeague's per-phase composites: instead of one branded
 * promo card for every state, the phases with a real identity get the spotlight
 * treatment — a navy or trophy-gold gradient, the phase's own ghost wordmark,
 * a glow tinted by whoever the hero is about, and the cast player's cutout.
 *
 * All copy comes from the resolved `EventHeroView`, so nothing is written
 * twice: the keeper deadline's summary, the conference drafts' conference-aware
 * headline and CTA, the countdown and its label all still live in
 * `afl-hero-resolver.ts`. This component only decides how they LOOK, and even
 * that is handed to it (`view.composite`) for the same reason.
 *
 * Which states arrive here is `AflHero`'s call, and it is conservative: a state
 * without a `composite` treatment, or without a cast model, renders the branded
 * `AflEventHero` exactly as before. A missing feed degrades to the card that
 * always worked rather than to an empty flank.
 */
import type { EventHeroView } from '../../utils/afl-hero-resolver';
import { LEAGUES } from '../../config/leagues';
import { getNflTeamColors } from '../../utils/nfl-team-colors';
import { normalizeTeamCode } from '../../utils/nfl-logo';
import { resolveHeroCrest, resolveHeroFranchiseSkin } from '../../utils/hero-crest';
import CompositeHero from './CompositeHero.astro';
import '../../styles/whats-new-hero-shot.css';

interface Props {
  view: EventHeroView;
  regionLabel: string;
  /**
   * Two-line cap on the summary. The What's New state alone asks for it: its
   * copy is an ENTRY DESCRIPTION written for an article page, and at the width
   * the copy column keeps beside the screenshot frame it ran eight lines and
   * pushed the card to 366px. TheLeague's feature composite has always clamped
   * for the same reason.
   *
   * Not the default, and not derived from `view.screenshot` here: every other
   * state's summary is resolver-written and short, and the one thing worse
   * than a tall card is a keeper deadline whose instruction stops mid-sentence.
   * The router knows the state's kind; this component does not.
   */
  clampSummary?: boolean;
  /**
   * Whose card this is. The AFL's by default; TheLeague renders its waiver-day
   * card through this same component (`WaiverWireHero`), and the league picks
   * the crest artwork, the franchise skin, the fallback mark and the
   * screenshot frame's domain — never the palette, which is `view.composite`.
   */
  league?: 'afl-fantasy' | 'theleague';
}

const { view, regionLabel, clampSummary = false, league = 'afl-fantasy' } = Astro.props;
// The article card's author. Rendered in the footer beside the CTA rather than
// over the art: the flank belongs to the player the STORY is about, and a
// reporter's face there would displace the subject of his own reporting.
const byline = view.byline ?? null;
const treatment = view.composite!;
const model = view.model ?? null;

/**
 * A What's New entry's own screenshot is the art, exactly as it is on
 * TheLeague's feature composite — the feature IS the picture, and a player
 * cutout over it would cover the thing being announced. So this is the one
 * state that can render with no cast model at all: `castAflHeroModel` casts a
 * player for a feature ONLY when the entry names one, and an entry that names
 * nobody still has a screenshot worth showing.
 *
 * Theme pair and frame URL follow AflEventHero's rules rather than a second
 * set: same `-dark` filename convention from capture-whats-new-screenshots.mjs,
 * same registry-derived domain (never a hardcoded one).
 */
const shotSrc = view.screenshot ? `/assets/whats-new/${view.screenshot}` : null;
const shotDarkSrc = shotSrc ? shotSrc.replace(/\.(\w+)$/, '-dark.$1') : null;
const leagueEntry = LEAGUES[league];
const shotFrameUrl = view.link
  ? `${leagueEntry.domains[0]}${view.link.replace(`/${leagueEntry.slug}`, '')}`
  : leagueEntry.domains[0];
// The model wins when there is one: a named player is a deliberate casting
// choice by whoever wrote the entry, and the screenshot is the fallback art.
const artMode: 'model' | 'shot' | 'logo' = model ? 'model' : shotSrc ? 'shot' : 'logo';

const teamCode = model ? normalizeTeamCode(model.nflTeam) : '';
// `modelAccent` is the viewer's own franchise colour when their conference
// rosters this player (see hero-franchise-accent.ts); otherwise his NFL team's.
const glowColor = view.modelAccent || (model ? getNflTeamColors(teamCode).primary : undefined);

// The watermark: the viewer's own club when their conference rosters this
// player (the same franchise `modelAccent` took its colour from, so the glow
// and the mark cannot disagree), otherwise his NFL team's.
const crest = resolveHeroCrest({
  franchiseId: view.modelFranchiseId,
  league,
  nflTeam: model?.nflTeam ?? null,
});

// A TEAM event wears the owning club's colours; a league event (both conference
// drafts) keeps the AFL's own navy. See CompositeHeroTreatment.scope.
const franchise =
  treatment.scope === 'team' ? resolveHeroFranchiseSkin(view.modelFranchiseId, league) : null;

// The league's crest stands in when the ESPN cutout 404s — same silhouette
// rule in both leagues, each with its own mark. It ships in model mode too:
// CompositeHero's CSS keeps it hidden until the cutout's onerror fires (and
// while a crest fills the card), so passing it only in logo mode left a free
// agent — who has no crest — with an empty flank when his headshot 404'd.
const LOGO = league === 'theleague' ? '/assets/logos/theleague-logo-dark.svg' : '/assets/logos/afl-logo-dark.svg';

// `crest` is passed only in model mode: behind a browser-framed screenshot a
// watermark reads as smudge rather than as a mark.
---

<CompositeHero
  class="fch"
  ariaLabel={regionLabel}
  accent={treatment.accent}
  tone={treatment.tone ?? null}
  wordmark={treatment.wordmark}
  crest={artMode === 'model' ? crest : null}
  franchise={franchise}
  artSlot={artMode === 'shot'}
  model={artMode === 'model' ? model : null}
  glowColor={glowColor}
  logoArt={artMode === 'shot' ? undefined : LOGO}
  pill={view.pill}
  pillDate={view.pillDate}
  title={view.headline}
  titleAccent={view.accentWord}
  summary={view.summary}
  clampSummary={clampSummary}
  styleVars="--cmh-min-h: clamp(250px, 25vw, 300px); --cmh-min-h-mobile: 270px; --cmh-ghost-size: clamp(4rem, 9vw, 7rem); --cmh-ghost-style: italic; --cmh-model-w: clamp(230px, 30vw, 350px); --cmh-logo-w: clamp(170px, 22vw, 250px); --cmh-logo-opacity: 0.2; --cmh-eyebrow-mb: 0.625rem; --cmh-content-max: min(32rem, 62%); --cmh-title-mb: 0.45rem; --cmh-summary-max: 46ch; --cmh-model-w-mobile: 175px;"
>
  <div class="cmh__footer">
    {byline && (
      <>
        <span class="lch__byline">
          <img class="lch__byline-avatar" src={byline.avatar} alt="" width="30" height="30" loading="lazy" decoding="async" />
          <span class="lch__byline-text">
            <span class="lch__byline-name">{byline.name}</span>
            <span class="lch__byline-role">Schefter Report</span>
          </span>
        </span>
        <span class="cmh__divider" aria-hidden="true"></span>
      </>
    )}
    {view.countValue !== undefined && (
      <>
        <div class="cmh__count" role="group" aria-label={view.countLabel ?? String(view.countValue)}>
          <span class="cmh__count-num" aria-hidden="true">{view.countValue}</span>
          {view.countLabel && <span class="cmh__count-label" aria-hidden="true">{view.countLabel}</span>}
        </div>
        <span class="cmh__divider" aria-hidden="true"></span>
      </>
    )}
    {view.link && (
      <a
        class="cmh__cta"
        href={view.link}
        target={view.isExternal ? '_blank' : undefined}
        rel={view.isExternal ? 'noopener noreferrer' : undefined}
      >
        {view.linkLabel ?? 'Learn more'}
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>

  {artMode === 'shot' && shotSrc && (
    <Fragment slot="art">
      <div class="fch__shot" aria-hidden="true">
        <div class="fch__shot-bar">
          <span class="fch__shot-dot fch__shot-dot--red"></span>
          <span class="fch__shot-dot fch__shot-dot--yellow"></span>
          <span class="fch__shot-dot fch__shot-dot--green"></span>
          <span class="fch__shot-url">{shotFrameUrl}</span>
        </div>
        {/* Both halves ship lazy and CSS shows the one matching the theme —
            SSR cannot know which that is.

            The two failures are NOT the same and must not share a handler.
            A missing LIGHT capture means there is no screenshot at all, so
            `fch--no-shot` drops the frame and reveals the league mark. A
            missing DARK one is only a missing VARIANT — the light capture is
            still perfectly readable — so `fch__shot--no-dark` tells the
            stylesheet to show the light half in dark mode instead. Wiring both
            to the light handler (as this first shipped) throws away a good
            screenshot because its optional sibling is absent.
            Pinned by tests/feature-shot-fallback.test.ts, across both leagues. */}
        <img
          class="fch__shot-img fch__shot-img--light"
          src={shotSrc}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.closest('.fch').classList.add('fch--no-shot')"
        />
        <img
          class="fch__shot-img fch__shot-img--dark"
          src={shotDarkSrc}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.closest('.fch__shot').classList.add('fch__shot--no-dark')"
        />
      </div>
      <img class="fch__shot-logo" src={LOGO} alt="" aria-hidden="true" loading="lazy" />
    </Fragment>
  )}

  {/* The conference drafts carry these: the sibling conference's live board
      while it is actually drafting, and the draft order once the CTA has been
      taken over by the room you draft from. Dropping them would leave an NL
      owner no route to the AL board on AL draft day. */}
  {view.secondaryLinks && view.secondaryLinks.length > 0 && (
    <nav class="cmh__chips cmh__chips--block afl-cmh__links" aria-label="Related links">
      {view.secondaryLinks.map((l) => (
        <a
          class="cmh__chip"
          href={l.href}
          target={l.isExternal ? '_blank' : undefined}
          rel={l.isExternal ? 'noopener noreferrer' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
  )}
</CompositeHero>

<style>
  .afl-cmh__links {
    margin-top: 0.75rem;
  }

  /* ── Byline — the author of the article this card promotes ───────────── */
  .lch__byline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .lch__byline-avatar {
    border-radius: var(--radius-full, 9999px);
    object-fit: cover;
    flex-shrink: 0;
    /* The avatar sits on a dark gradient in both themes, so it carries its own
       ring rather than relying on the surface for separation. */
    border: 1px solid var(--cmh-divider, rgba(255, 255, 255, 0.18));
  }

  .lch__byline-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .lch__byline-name {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--cmh-ink);
    white-space: nowrap;
  }

  .lch__byline-role {
    font-size: 0.575rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cmh-body);
    white-space: nowrap;
  }

  /* The role line is the one thing that yields on a phone — the name and the
     face are the byline; "SCHEFTER REPORT" is what the pill already said. */
  @media (max-width: 640px) {
    .lch__byline-role {
      display: none;
    }
  }
</style>
