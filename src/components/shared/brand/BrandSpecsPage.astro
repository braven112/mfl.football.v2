---
/**
 * Brand Book — asset specs. The two files a new team sends us, how big to make
 * them, and why a crest must stay simple. One page for every league, on the
 * shared host only (`src/pages/brand/specs.astro`), so it can be handed to an
 * owner before their league has a site of its own.
 *
 * Kept deliberately short (Brandon, 2026-11-07): the logo sizes, the good-versus-busy
 * example, and a link to the logo maker, which writes the AI prompt for them.
 * The spec data lives in `src/utils/brand-asset-specs.ts`, where a test pins
 * the stored sizes and templates.
 */
import MflAppLayout from '../../../layouts/MflAppLayout.astro';
import { ASSET_SPECS } from '../../../utils/brand-asset-specs';
import '../../../styles/brand-book.css';

/** The only files the page asks for: the logos, plus the optional banner. */
const SHOWN = ['crest', 'banner', 'league-logo', 'badges'] as const;
const LABELS: Record<(typeof SHOWN)[number], string> = {
  crest: 'Team icon',
  banner: 'Team banner',
  'league-logo': 'League logo',
  badges: 'Conference and division logos',
};
const specs = SHOWN.flatMap((id) => {
  const s = ASSET_SPECS.find((x) => x.id === id);
  return s ? [{ ...s, label: LABELS[id] }] : [];
});

/** A real crest at the sizes the site paints it — the case for keeping it simple. */
const SHRINK_SRC = '/assets/theleague/group-me/0001.png';
const SHRINK_SIZES = [100, 40, 16];
/**
 * Good next to bad at the same sizes. The busy crest is a made-up mark drawn
 * for this page, so no real club is held up as the bad example.
 */
const SHRINK_EXAMPLES = [
  { src: SHRINK_SRC, verdict: 'good', title: 'Simple: stays crisp' },
  { src: '/assets/brand-specs/example-busy-crest.svg', verdict: 'bad', title: 'Too busy: turns to mud' },
] as const;
---

<MflAppLayout
  title="Logo and asset specs | MFL.football"
  description="The team, league, conference and division logo sizes to send, and how to keep a logo crisp."
>
  <main class="brand specs">
    <header class="brand__header">
      <p class="brand__eyebrow"><a href="/get-started">Get started</a> &middot; <a href="/brand">Brand Book</a> &middot; Specs</p>
      <h1>Logo and asset specs</h1>
      <p class="brand__lede">Send each logo as a transparent PNG or SVG at these sizes. We shrink it to fit everywhere.</p>
      <p><a class="cta cta--primary" href="/team-logo">Make your logo with our logo maker</a></p>
    </header>

    <section class="cb__section">
      <ul class="specs__grid">
        {
          specs.map((s) => (
            <li class="ui-card specs__card" id={s.id}>
              <div class="specs__card-head">
                <h3>{s.label}</h3>
                <span class:list={['specs__tag', s.required ? 'is-required' : 'is-optional']}>
                  {s.required ? 'Required' : 'Optional'}
                </span>
              </div>
              <p class="specs__size">{s.size.includes('×') ? `${s.size} px` : s.size.replace(' on the long side', '')}</p>
              {!s.size.includes('×') && <p class="specs__hint">on the longest side</p>}
              {s.template && (
                <p class="specs__card-dl">
                  <a class="cb__dl" href={s.template.svg} download>Template (SVG)</a>
                  <a class="cb__dl" href={s.template.png} download>Template (PNG)</a>
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cb__section">
      <h2 class="cb__h2">Keep it simple</h2>
      <p class="cb__note">Your icon is usually shown at 40&nbsp;px or smaller. Bold shapes stay sharp; fine detail turns to mud.</p>
      {
        SHRINK_EXAMPLES.map((ex) => (
          <figure class:list={['specs__example', `is-${ex.verdict}`]}>
            <figcaption>{ex.title}</figcaption>
            <ul class="specs__shrink">
              {SHRINK_SIZES.map((px) => (
                <li>
                  <span class="specs__shrink-box">
                    <img src={ex.src} alt="" width={px} height={px} loading="lazy" />
                  </span>
                  <span class="specs__shrink-label">{px} px</span>
                </li>
              ))}
            </ul>
          </figure>
        ))
      }
    </section>
  </main>
</MflAppLayout>

<style>
  .specs h3 {
    margin: 0;
    font-size: var(--font-size-base, 1rem);
    color: var(--page-text, #111827);
  }
  .specs__size {
    margin: 0.35rem 0 0;
    font-size: var(--font-size-xl, 1.25rem);
    font-weight: 700;
    color: var(--page-text, #111827);
  }
  .specs__hint {
    margin: 0;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-gray-500, #6b7280);
  }
  .specs__example {
    margin: 0 0 1rem;
  }
  .specs__example figcaption {
    margin-bottom: 0.4rem;
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 700;
  }
  .specs__example.is-good figcaption {
    color: var(--color-success, #10b981);
  }
  .specs__example.is-bad figcaption {
    color: var(--color-error, #dc2626);
  }
  .specs__shrink {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
  }
  .specs__shrink li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .specs__shrink-box {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border-radius: var(--radius-sm, 4px);
    background: #ffffff;
    border: var(--style-card-border, 1px solid var(--color-gray-300, #d1d5db));
    box-shadow: var(--style-card-shadow, none);
  }
  .specs__shrink img {
    display: block;
  }
  .specs__shrink-label {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-gray-500, #6b7280);
  }
  .specs__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--spacing-sm, 0.75rem);
  }
  .specs__card {
    min-width: 0;
    padding: 0.9rem 1rem;
  }
  .specs__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .specs__tag {
    flex: none;
    font-size: var(--font-size-2xs, 0.6875rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm, 4px);
  }
  .specs__tag.is-required {
    background: var(--color-accent, #2563eb);
    color: var(--on-color-accent, #fff);
  }
  .specs__tag.is-optional {
    border: 1px solid var(--color-gray-300, #d1d5db);
    color: var(--color-gray-500, #6b7280);
  }
  .specs__card-dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
  }
  /* These panes paint their OWN ground, so the site's dark-mode crest swap and
     ring must not fire on them — same opt-out as the rest of the Brand Book. */
  :global(html.dark) .specs__shrink img {
    content: normal !important;
    filter: none !important;
  }
</style>
