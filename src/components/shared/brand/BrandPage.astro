---
/**
 * Brand Book — the index. Every mark this site draws, on its own color.
 *
 * TWO subjects under one roof, in this order: the LEAGUE's own franchises
 * (`FranchiseBrandPage`), then the 32 NFL clubs (`ClubBrandPage`). They share
 * the page because they answer the same question — which cut does each ground
 * draw — and splitting them into two destinations would put two things called
 * "brand" in the nav a click apart.
 *
 * Thin route wrappers under src/pages/<league>/brand.astro own any auth gate
 * and per-league static import; this component owns the markup. Keep it that
 * way: Astro.redirect() only works from a page, and a static import specifier
 * cannot be a runtime variable.
 *
 * `leagueSlug` is OPTIONAL, and its absence is the shared host — which gets
 * the NFL half ALONE. NFL club marks belong to no league, so `mfl.football/brand`
 * renders in MflAppLayout with no league identity; TheLeagueLayout wears one
 * league's crest, nav and manifest, and this surface must claim none of them.
 * The shared host is deliberately not a second front door for a league that
 * has its own apex (`resolveSharedHostHiddenLeague`), so this is its OWN route
 * at the root rather than a link into /theleague/brand.
 *
 * A FRANCHISE mark, by contrast, belongs to exactly one league, and three of
 * them (Computer Jocks, Da Dangsters, Midwestside, the Ninjas, Vitside) field
 * a franchise in BOTH — so their slugs collide and a league-less
 * `/brand/<slug>` could not say which one it meant. That is why the franchise
 * half appears only on a league's copy, rather than being a rule about tidiness.
 *
 * Each tile is the club's color with the mark its BAND ground draws — which
 * is the dark cut for almost every club, because almost every club color is
 * dark. That is the whole thesis of docs/plans/nfl-mark-assignments.md shown
 * 32 times: a club-color band is a third ground, not a light one.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import MflAppLayout from '../../../layouts/MflAppLayout.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { allClubs, inkOn } from '../../../utils/nfl-marks';
import { allFranchiseBrands, leagueHasBrandBook } from '../../../utils/franchise-marks';
import BrandFranchiseTiles from './BrandFranchiseTiles.astro';
import BrandSubjectTiles from './BrandSubjectTiles.astro';
import {
  allBrandFiles,
  brandSubjects,
  subjectPath,
  subjectTile,
  type BrandBookAssets,
  type BrandBookConfig,
  type SubjectTile,
} from '../../../utils/brand-book-subjects';
import '../../../styles/brand-book.css';

interface Props {
  /** Omitted on the shared host, where this page belongs to no league. */
  leagueSlug?: CanonicalLeagueSlug;
  /**
   * The league's aggregated asset file and config, from the route. With them
   * the index adds the league, conference, division and archive pages and the
   * file search; without them (the shared host, a package league) it is the
   * club grids alone.
   */
  assets?: BrandBookAssets;
  config?: BrandBookConfig;
}

const { leagueSlug, assets, config } = Astro.props;
const league = leagueSlug ? getLeagueBySlug(leagueSlug) : null;
if (leagueSlug && !league) throw new Error(`BrandPage: unknown league ${leagueSlug}`);

const Layout = league ? TheLeagueLayout : MflAppLayout;
const hide = Astro.locals.hideLeaguePrefix ?? false;
const clubHref = (code: string) =>
  leagueSlug
    ? resolveLeaguePath(`/${leagueSlug}/brand/${code.toLowerCase()}`, hide)
    : `/brand/${code.toLowerCase()}`;

const clubs = allClubs();
const derived = clubs.filter((c) => c.marks.some((m) => m.derived));

/**
 * The league's own franchises. Empty on the shared host and for any league the
 * Brand Book does not cover (Best Ball is draft-only and carries no crest art),
 * which renders the NFL half alone rather than an empty section.
 */
const franchises = leagueSlug && leagueHasBrandBook(leagueSlug) ? allFranchiseBrands(leagueSlug) : [];
const franchiseHref = (slug: string) =>
  leagueSlug ? resolveLeaguePath(`/${leagueSlug}/brand/${slug}`, hide) : `/brand/${slug}`;

/**
 * The league's own subjects — the Brand Files library's league, championship,
 * conference and division art, and its retired clubs — each on its own page
 * now, reached from these tiles.
 */
const brandHref = (path: string) => (leagueSlug ? resolveLeaguePath(`/${leagueSlug}/brand/${path}`, hide) : `/brand/${path}`);
const subjects = leagueSlug && assets && config ? brandSubjects(leagueSlug, assets, config) : [];
const SUBJECT_EYEBROW = { league: 'League', conference: 'Conference' } as const;
const subjectTiles: SubjectTile[] = subjects.map((s) =>
  subjectTile(s, brandHref(subjectPath(s)), s.kind === 'division' ? (s.parent?.name ?? 'Division') : SUBJECT_EYEBROW[s.kind]),
);
if (subjects.length && assets?.teams?.some((t) => t.category === 'former')) {
  subjectTiles.push({ href: brandHref('archive'), name: 'Retired clubs', eyebrow: 'Archive', art: null, artForDark: false });
}

/**
 * Every file the league's Brand Book pages show, for "Find a file" — what the
 * retired library was good AT. Shipped as JSON and rendered on input, rather
 * than as several hundred hidden rows.
 */
const fileIndex =
  leagueSlug && assets && config
    ? allBrandFiles(leagueSlug, assets, config).map((f) => ({
        l: f.label,
        f: f.filename,
        u: f.url,
        p: f.pageName,
        h: brandHref(f.page),
      }))
    : [];
---

<Layout title={league ? `Brand Book | ${league.name}` : 'NFL Brand Book'}>
  <main class="brand">
    <header class="brand__header">
      <p class="brand__eyebrow">
        Reference &middot;
        {franchises.length > 0 && <>{franchises.length} league clubs &middot; </>}
        {clubs.length} NFL clubs
      </p>
      <h1>{league ? 'Brand Book' : 'NFL Brand Book'}</h1>
      <p class="brand__lede">
        Official marks and colors, and which cut to use on each ground &mdash; a white cell, a
        dark card, or the club's own color.
      </p>
      {
        derived.length > 0 && (
          <p class="brand__note">
            {derived.map((c, i) => (
              <>
                {i > 0 && ', '}
                <a href={clubHref(c.code)}>{c.code}</a>
              </>
            ))}{' '}
            use a reversed cut drawn in-house &mdash; no official reversed mark is published.
          </p>
        )
      }
      {
        !league && (
          <p class="brand__note">
            Joining with a new league or team? <a href="/brand/specs">Logo and asset specs</a> lists every file to send,
            with sizes and templates.
          </p>
        )
      }
    </header>

    {
      subjectTiles.length > 0 && league && (
        <section class="cb__section">
          <h2 class="cb__h2">League marks</h2>
          <p class="cb__note">
            The league's own marks, its conferences and divisions, and the clubs that have left.
          </p>
          <BrandSubjectTiles tiles={subjectTiles} />
        </section>
      )
    }

    {
      franchises.length > 0 && league && (
        <section class="cb__section">
          <h2 class="cb__h2">{league.name} clubs</h2>
          <p class="cb__note">
            Each tile is the club's official color wearing the cut that ground takes.
          </p>
          <BrandFranchiseTiles franchises={franchises} hrefFor={franchiseHref} />
        </section>
      )
    }

    {
      fileIndex.length > 0 && (
        <section class="cb__section">
          <h2 class="cb__h2">
            <label for="brand-file-search">Find a file</label>
          </h2>
          <p class="cb__note">
            Search all {fileIndex.length} files by club, league, division or file name.
          </p>
          <input
            class="brand__search"
            id="brand-file-search"
            type="search"
            autocomplete="off"
            placeholder="Pigskins, east.svg, banner…"
          />
          <ul class="brand__hits" id="brand-file-hits" aria-live="polite"></ul>
          <script type="application/json" id="brand-file-index" set:html={JSON.stringify(fileIndex).replace(/</g, '\\u003c')} />
        </section>
      )
    }

    {franchises.length > 0 && <h2 class="cb__h2 brand__nfl-h2">NFL clubs</h2>}

    <ul class="brand__grid">
      {
        clubs.map((club) => {
          const bg = club.colors[0] ?? '#111111';
          const ink = inkOn(bg);
          const band = club.grounds.find((g) => g.ground === 'band');
          return (
            <li class="brand__cell">
              <a
                class="brand__tile"
                href={clubHref(club.code)}
                style={`--tile-bg:${bg};--tile-ink:${ink}`}
              >
                <span class="brand__art">
                  {band && <img src={band.url} alt="" loading="lazy" width="72" height="72" />}
                </span>
                <span class="brand__name">
                  <span class="brand__city">{club.city}</span>
                  <span class="brand__nick">{club.nick}</span>
                </span>
                {club.marks.some((m) => m.derived) ? (
                  <span class="brand__flag">made here</span>
                ) : (
                  club.customised && <span class="brand__flag">custom</span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>

<script is:inline>
  (() => {
    /**
     * "Find a file". CLIENTROUTER-SAFE: the listener sits on `document`, which
     * survives every swap, so the previous registration is replaced rather
     * than stacked; the gate and the data are read from the CURRENT document
     * on every keystroke, never captured, so a swap to the other league's
     * Brand Book searches that league's files.
     */
    const MAX = 40;
    const onInput = (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || input.id !== 'brand-file-search') return;
      const list = document.getElementById('brand-file-hits');
      const data = document.getElementById('brand-file-index');
      if (!list || !data) return;
      const q = input.value.trim().toLowerCase();
      list.replaceChildren();
      if (q.length < 2) return;
      let files = [];
      try {
        files = JSON.parse(data.textContent || '[]');
      } catch {
        return;
      }
      const hits = files.filter((f) => `${f.l} ${f.f} ${f.p}`.toLowerCase().includes(q));
      for (const f of hits.slice(0, MAX)) {
        const li = document.createElement('li');
        li.className = 'brand__hit';
        const page = document.createElement('a');
        page.href = f.h;
        page.textContent = `${f.p} — ${f.l}`;
        const name = document.createElement('code');
        name.textContent = f.f;
        const dl = document.createElement('a');
        dl.className = 'cb__dl';
        dl.href = f.u;
        dl.setAttribute('download', '');
        dl.textContent = 'Download';
        li.append(page, name, dl);
        list.append(li);
      }
      const more = document.createElement('li');
      more.className = 'brand__hit';
      more.textContent = hits.length === 0 ? 'No files match.' : hits.length > MAX ? `${hits.length - MAX} more — keep typing to narrow it.` : '';
      if (more.textContent) list.append(more);
    };
    if (window.__brandBookSearch) {
      document.removeEventListener('input', window.__brandBookSearch);
    }
    window.__brandBookSearch = onInput;
    document.addEventListener('input', onInput);
  })();
</script>

<style>

  /* ── The Brand Book opts OUT of the global dark swap ────────────────────
     `buildNflLogoDarkCss` emits `html.dark img[src="<light src>"] { content:
     url(<dark cut>) }` for every light src the site can render, so in dark
     mode a light mark silently becomes the dark one. On every other page that
     is the whole point; here it destroys the page. This page's job is to show
     the cuts SIDE BY SIDE, and each pane paints its own ground rather than the
     viewer's theme — so the light pane, the "Light surfaces" ground card and
     the Primary/ESPN-light entries in the filmstrip would all render the DARK
     cut for a dark-mode reader, and the comparison would show one mark twice.
     Scoped to the tiles' artwork, never the whole page: every tile already
     declares its ground (the club's own color) and must look the same in both
     themes, but nothing else here should be frozen out of the swap.

     `!important` because the swap rule's specificity matches this one's and
     load order between the layout head and a scoped component style is not
     something to rely on. Pinned by tests/nfl-marks-page-data.test.ts. */
  html.dark :global(.brand__art img) {
    content: normal !important;
  }
  /* NO `filter` reset here, unlike an earlier draft of this block. Every tile
     on this index paints the club's or franchise's OWN color, which is a dark
     ground for almost all of them — so a ring belongs on it, and the inline one
     this page sets is already correct. Resetting the filter also killed
     `--nfl-logo-ring`, which `nfl-logo-dark-css.ts` emits once guarded by
     `html.dark` and once UNGUARDED for the dark cuts of stroked clubs; doing
     that inside an `html.dark` block left Carolina ringed in light mode and
     bare in dark. The `revert-layer` that was meant to rescue the inline ring
     could not: the style attribute is not a cascade layer, so it rolled back to
     the UA value `none`. */
</style>
