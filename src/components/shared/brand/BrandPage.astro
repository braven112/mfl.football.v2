---
/**
 * Brand Book — the index. Every mark this site draws, on its own colour.
 *
 * TWO subjects under one roof, in this order: the LEAGUE's own franchises
 * (`FranchiseBrandPage`), then the 32 NFL clubs (`ClubBrandPage`). They share
 * the page because they answer the same question — which cut does each ground
 * draw — and splitting them into two destinations would put two things called
 * "brand" in the nav a click apart.
 *
 * Thin route wrappers under src/pages/<league>/brand.astro own any auth gate
 * and per-league static import; this component owns the markup. Keep it that
 * way: Astro.redirect() only works from a page, and a static import specifier
 * cannot be a runtime variable.
 *
 * `leagueSlug` is OPTIONAL, and its absence is the shared host — which gets
 * the NFL half ALONE. NFL club marks belong to no league, so `mfl.football/brand`
 * renders in MflAppLayout with no league identity; TheLeagueLayout wears one
 * league's crest, nav and manifest, and this surface must claim none of them.
 * The shared host is deliberately not a second front door for a league that
 * has its own apex (`resolveSharedHostHiddenLeague`), so this is its OWN route
 * at the root rather than a link into /theleague/brand.
 *
 * A FRANCHISE mark, by contrast, belongs to exactly one league, and three of
 * them (Computer Jocks, Da Dangsters, Midwestside, the Ninjas, Vitside) field
 * a franchise in BOTH — so their slugs collide and a league-less
 * `/brand/<slug>` could not say which one it meant. That is why the franchise
 * half appears only on a league's copy, rather than being a rule about tidiness.
 *
 * Each tile is the club's colour with the mark its BAND ground draws — which
 * is the dark cut for almost every club, because almost every club colour is
 * dark. That is the whole thesis of docs/plans/nfl-mark-assignments.md shown
 * 32 times: a club-colour band is a third ground, not a light one.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import MflAppLayout from '../../../layouts/MflAppLayout.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { allClubs, inkOn } from '../../../utils/nfl-marks';
import { allFranchiseBrands, leagueHasBrandBook } from '../../../utils/franchise-marks';
import '../../../styles/brand-book.css';

interface Props {
  /** Omitted on the shared host, where this page belongs to no league. */
  leagueSlug?: CanonicalLeagueSlug;
}

const { leagueSlug } = Astro.props;
const league = leagueSlug ? getLeagueBySlug(leagueSlug) : null;
if (leagueSlug && !league) throw new Error(`BrandPage: unknown league ${leagueSlug}`);

const Layout = league ? TheLeagueLayout : MflAppLayout;
const hide = Astro.locals.hideLeaguePrefix ?? false;
const clubHref = (code: string) =>
  leagueSlug
    ? resolveLeaguePath(`/${leagueSlug}/brand/${code.toLowerCase()}`, hide)
    : `/brand/${code.toLowerCase()}`;

const clubs = allClubs();
const customised = clubs.filter((c) => c.customised);
const derived = clubs.filter((c) => c.marks.some((m) => m.derived));

/**
 * The league's own franchises. Empty on the shared host and for any league the
 * Brand Book does not cover (Best Ball is draft-only and carries no crest art),
 * which renders the NFL half alone rather than an empty section.
 */
const franchises = leagueSlug && leagueHasBrandBook(leagueSlug) ? allFranchiseBrands(leagueSlug) : [];
const franchiseHref = (slug: string) =>
  leagueSlug ? resolveLeaguePath(`/${leagueSlug}/brand/${slug}`, hide) : `/brand/${slug}`;
const filesHref = leagueSlug ? resolveLeaguePath(`/${leagueSlug}/brand/files`, hide) : null;
---

<Layout title={league ? `Brand Book | ${league.name}` : 'NFL Brand Book'}>
  <main class="brand">
    <header class="brand__header">
      <p class="brand__eyebrow">
        Reference &middot;
        {franchises.length > 0 && <>{franchises.length} league clubs &middot; </>}
        {clubs.length} NFL clubs
      </p>
      <h1>{league ? 'Brand Book' : 'NFL Brand Book'}</h1>
      <p class="brand__lede">
        Every mark this site draws, and which cut each surface uses. A mark sits on one of
        <strong>three grounds</strong> &mdash; a white cell, a dark card, or the club's own
        colour &mdash; and the third is not a variant of the first two, which is why a
        club-colour band below shows the <em>dark</em> mark even in light mode.
      </p>
      {
        filesHref && (
          <p class="brand__note">
            Looking for a specific file? The <a href={filesHref}>searchable file list</a> has every
            asset in the league, historical clubs and league art included.
          </p>
        )
      }
      {
        customised.length > 0 && (
          <p class="brand__note">
            {customised.map((c) => c.code).join(', ')}{' '}
            {customised.length === 1 ? 'draws' : 'draw'} something other than the default on at
            least one ground.
          </p>
        )
      }
      {
        derived.length > 0 && (
          <p class="brand__note">
            {derived.map((c, i) => (
              <>
                {i > 0 && ', '}
                <a href={clubHref(c.code)}>{c.code}</a>
              </>
            ))}{' '}
            carry a <strong>reversed</strong> cut we made ourselves &mdash; no public source
            publishes one, so it is derived from our own SVG by a hand-reviewed colour map.
          </p>
        )
      }
    </header>

    {
      franchises.length > 0 && league && (
        <section class="cb__section">
          <h2 class="cb__h2">{league.name} clubs</h2>
          <p class="cb__note">
            Each tile is the franchise's own colour wearing the cut its BAND ground draws &mdash;
            the dark cut for almost every one of them, because almost every franchise primary is
            dark. Five of them wear <code>#181818</code>.
          </p>
          {/*
            The SAME `brand__*` tile markup the NFL grid below uses, not a
            parallel set. The franchise half briefly had its own classes and
            promptly re-shipped a bug the club template had already fixed.
          */}
          <ul class="brand__grid">
            {franchises.map((fr) => {
              const tileBg = fr.bandColor;
              const tileInk = inkOn(tileBg);
              const tileBand = fr.grounds.find((g) => g.ground === 'band');
              return (
                <li class="brand__cell">
                  <a
                    class="brand__tile"
                    href={franchiseHref(fr.slug)}
                    style={`--tile-bg:${tileBg};--tile-ink:${tileInk}`}
                  >
                    <span class="brand__art">
                      {tileBand && (
                        <img
                          src={tileBand.url}
                          alt=""
                          loading="lazy"
                          width="72"
                          height="72"
                          style={tileBand.filter ? `filter:${tileBand.filter}` : undefined}
                        />
                      )}
                    </span>
                    <span class="brand__name">
                      {fr.division && <span class="brand__city">{fr.division}</span>}
                      <span class="brand__nick brand__nick--franchise">{fr.name}</span>
                    </span>
                    {!fr.hasDarkCut && <span class="brand__flag">light only</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {franchises.length > 0 && <h2 class="cb__h2 brand__nfl-h2">NFL clubs</h2>}

    <ul class="brand__grid">
      {
        clubs.map((club) => {
          const bg = club.colors[0] ?? '#111111';
          const ink = inkOn(bg);
          const band = club.grounds.find((g) => g.ground === 'band');
          return (
            <li class="brand__cell">
              <a
                class="brand__tile"
                href={clubHref(club.code)}
                style={`--tile-bg:${bg};--tile-ink:${ink}`}
              >
                <span class="brand__art">
                  {band && <img src={band.url} alt="" loading="lazy" width="72" height="72" />}
                </span>
                <span class="brand__name">
                  <span class="brand__city">{club.city}</span>
                  <span class="brand__nick">{club.nick}</span>
                </span>
                {club.marks.some((m) => m.derived) ? (
                  <span class="brand__flag">made here</span>
                ) : (
                  club.customised && <span class="brand__flag">custom</span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>

<style>

  /* ── The Brand Book opts OUT of the global dark swap ────────────────────
     `buildNflLogoDarkCss` emits `html.dark img[src="<light src>"] { content:
     url(<dark cut>) }` for every light src the site can render, so in dark
     mode a light mark silently becomes the dark one. On every other page that
     is the whole point; here it destroys the page. This page's job is to show
     the cuts SIDE BY SIDE, and each pane paints its own ground rather than the
     viewer's theme — so the light pane, the "Light surfaces" ground card and
     the Primary/ESPN-light entries in the filmstrip would all render the DARK
     cut for a dark-mode reader, and the comparison would show one mark twice.
     Scoped to the tiles' artwork, never the whole page: every tile already
     declares its ground (the club's own colour) and must look the same in both
     themes, but nothing else here should be frozen out of the swap.

     `!important` because the swap rule's specificity matches this one's and
     load order between the layout head and a scoped component style is not
     something to rely on. Pinned by tests/nfl-marks-page-data.test.ts. */
  html.dark :global(.brand__art img) {
    content: normal !important;
    filter: none !important;
  }
  /* …except the measured ring this page sets INLINE on the one franchise
     ground that needs it, which the blanket `filter: none` would strip. */
  html.dark :global(.brand__art img[style*='drop-shadow']) {
    filter: revert-layer !important;
  }
  /* A club nickname is one word; a franchise name is up to four ("Running Down
     The Dream"), so the franchise tiles take a smaller, balanced line rather
     than the nickname's size. Everything else about the tile is identical. */
  .brand__nick--franchise {
    font-size: 0.9rem;
    line-height: 1.2;
    text-wrap: balance;
  }
  .brand__nfl-h2 {
    margin-top: 2.5rem;
  }
  /* Tokens with fallbacks only — a var() with no definition renders its
     fallback in BOTH themes (docs/claude/rules/theming-and-assets.md). */
  .brand {
    max-width: var(--container-max-width, 1100px);
    margin: 0 auto;
    padding: var(--spacing-lg, 1.5rem) var(--spacing-md, 1rem);
  }
  .brand__header {
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .brand__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gray-500, #6b7280);
  }
  .brand h1 {
    margin: 0 0 0.5rem;
    font-size: 1.85rem;
    line-height: 1.1;
  }
  .brand__lede {
    margin: 0;
    max-width: 62ch;
    color: var(--color-gray-600, #4b5563);
  }
  .brand__note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--color-gray-500, #6b7280);
  }
  .brand__note a {
    color: inherit;
    font-weight: 700;
  }

  .brand__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--spacing-sm, 0.75rem);
  }
  .brand__cell {
    margin: 0;
  }
  .brand__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 0.75rem 0.9rem;
    border-radius: var(--radius-md, 8px);
    background: var(--tile-bg);
    color: var(--tile-ink);
    text-decoration: none;
    min-height: 148px;
    justify-content: center;
  }
  .brand__tile:hover,
  .brand__tile:focus-visible {
    outline: 2px solid var(--tile-ink);
    outline-offset: 2px;
  }
  .brand__art img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    display: block;
  }
  .brand__name {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1.15;
  }
  .brand__city {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .brand__nick {
    font-size: 1.05rem;
    font-weight: 700;
  }
  .brand__flag {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm, 4px);
    background: color-mix(in srgb, var(--tile-ink) 18%, transparent);
  }

  @media (max-width: 480px) {
    .brand__grid {
      grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    }
    .brand__art img {
      width: 56px;
      height: 56px;
    }
  }
</style>
