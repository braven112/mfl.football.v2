---
/**
 * One NFL club's brand page — the "club showcase" layout.
 *
 * Full-bleed club colour, the mark at scale, every cut on file as a filmstrip,
 * then what the site actually does with it: which cut each ground draws, the
 * real components that render it, and who in this league rosters its players.
 *
 * ── Why the hero uses the DARK mark ───────────────────────────────────────
 * The hero band is the club's own colour, which for almost every club is a
 * dark ground. It is therefore neither a light nor a dark SURFACE — it is a
 * third ground, and it resolves to whichever assignment suits that colour's
 * luminance (`bandSlot`). Same rule `franchise-band-brand.ts` already applies
 * to fantasy-team crests. See docs/plans/nfl-mark-assignments.md.
 *
 * ── Why the previews carry their own colours ──────────────────────────────
 * Each preview below stands in for a real app surface, so it paints its OWN
 * light or dark ground and inherits nothing from the page theme. A "light"
 * preview that went dark for a dark-mode viewer would make the two previews
 * identical, which is the entire comparison.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import MflAppLayout from '../../../layouts/MflAppLayout.astro';
import PlayerCell from '../../theleague/PlayerCell.astro';
import CompositeHero from '../CompositeHero.astro';
import NflGamesStrip from '../NflGamesStrip';
/* The strip's own stylesheet. A React island does NOT carry it — rendered
   without this the logos have no sizing rule and each one fills the column,
   which is the same trap `docs/claude/rules/storybook.md` records for stories:
   a real component, correct markup, no styles. */
import '../../../styles/nfl-games-strip.css';
import '../../../styles/network-badge.css';
/* The Brand Book's template, shared with the FRANCHISE half of this page.
   It used to be a scoped <style> block here; the franchise copy grew a
   parallel set of rules and promptly re-shipped the themed-h1 bug this one
   already solved (`.cb__nick { color: inherit }`). One sheet, one template —
   and global rather than scoped, because Astro scoped CSS never reaches an
   element JS created and the franchise half's copy buttons toggle a class at
   runtime. */
import '../../../styles/brand-book.css';
import type { NflGame } from '../../../types/live-scoring';
import type { HeroModel } from '../../../utils/hero-casting';
import { resolveHeroFranchiseBackdrop } from '../../../utils/hero-franchise-backdrop';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { allClubs, clubBrand, inkOn, type ClubBrand } from '../../../utils/nfl-marks';
import { clubRosterHolders } from '../../../utils/nfl-club-rosters';

interface Props {
  /**
   * Omitted on the shared host. NFL club marks belong to no league, so
   * `mfl.football/brand/<code>` renders this page in MflAppLayout with no
   * league identity and no roster panel — the roster panel is the ONLY
   * league-specific thing here, which is what makes the neutral copy possible
   * at all rather than a fork.
   */
  leagueSlug?: CanonicalLeagueSlug;
  code: string;
}

const { leagueSlug, code } = Astro.props;
const league = leagueSlug ? getLeagueBySlug(leagueSlug) : null;
if (leagueSlug && !league) throw new Error(`ClubBrandPage: unknown league ${leagueSlug}`);

const Layout = league ? TheLeagueLayout : MflAppLayout;
const club = clubBrand(code) as ClubBrand;
const hide = Astro.locals.hideLeaguePrefix ?? false;
const indexPath = leagueSlug ? resolveLeaguePath(`/${leagueSlug}/brand`, hide) : '/brand';

const bg = club.colors[0] ?? '#111111';
const ink = inkOn(bg);
const band = club.grounds.find((g) => g.ground === 'band');
const light = club.grounds.find((g) => g.ground === 'light');
const dark = club.grounds.find((g) => g.ground === 'dark');

const { year, holders } = leagueSlug
  ? clubRosterHolders(club.code, leagueSlug)
  : { year: null, holders: [] };
const rosteredCount = holders.reduce((n, h) => n + h.players.length, 0);

/**
 * A sample slate for the games strip, so the REAL component renders here.
 *
 * `NflGamesStrip`'s `demo` prop exists for exactly this: it renders
 * `initialGames` and does no network at all, so a showcase cannot be
 * overwritten by a live poll (or make one from a page nobody is watching a
 * game on). The opponent is deterministic — the next club alphabetically —
 * because this card is about the ARTWORK, and an opponent chosen by some
 * cleverer rule would still be arbitrary while looking like it meant
 * something.
 */
const opponent = (() => {
  const all = allClubs().map((c) => c.code);
  const i = all.indexOf(club.code);
  return all[(i + 1) % all.length];
})();

const demoGames: NflGame[] = [
  {
    id: `brand-${club.code}`,
    state: 'in',
    shortDetail: '1:58 - 4th',
    period: 4,
    clock: '1:58',
    home: { code: club.code, score: 24 },
    away: { code: opponent, score: 21 },
    possession: club.code,
    date: new Date().toISOString(),
    broadcast: 'FOX',
  },
];

/**
 * The homepage composite hero, rendered for real with this club's mark as its
 * CREST WATERMARK and its primary as the radial glow.
 *
 * This is the surface that answers "where does a club mark end up biggest" —
 * a hero paints it at ~300px behind the copy, which is where a cut that only
 * works at 16px falls apart. `CompositeHero` is the live shell every composite
 * on both homepages renders through, so what appears here is what a homepage
 * would draw; `hero-showcase/ShowcasePage.astro` already proved a fixture can
 * drive it, and records what happened the three times a gallery reproduced the
 * treatment inline instead (the crest watermark never appeared at all).
 *
 * The crest takes the BAND ground's cut, not the light one: a hero's glow and
 * gradient make it a dark surface in both themes, which is the same reason
 * `hero-franchise-backdrop.ts` resolves a franchise crest server-side rather
 * than leaving it to the `html.dark` swap.
 *
 * The cast player is a real one this league rosters when there is one — the
 * league copies have a roster to draw from, the shared host does not, and
 * `model: null` renders the silhouette the live shell already falls back to.
 *
 * The CARD takes the club's own gradient through `resolveHeroFranchiseBackdrop`
 * rather than a phase accent. That is the prop's stated purpose — "a hero that
 * is about a TEAM rather than about the league" — and it is the difference
 * between a Saints hero and a blue hero with a Saints crest on it: `accent`
 * paints the phase gradient and `glowColor` is only a faint radial over it, so
 * a gold club came out blue. The resolver also does the work a hand-built
 * gradient would skip: it floors the pair for white text and clears the accent,
 * pill and CTA inks against the gradient that is ACTUALLY rendered, per band.
 */
const heroBackdrop = resolveHeroFranchiseBackdrop(
  { colorPrimary: club.colors[0], colorSecondary: club.colors[1] ?? club.colors[0] },
  league?.slug === 'afl-fantasy' ? 'afl' : 'theleague',
);

const heroCast = holders[0]?.players.find((pl) => pl.position !== 'DEF') ?? null;
const heroModel: HeroModel | null = heroCast
  ? {
      mflId: heroCast.id,
      name: heroCast.name,
      position: heroCast.position,
      nflTeam: club.code,
      headshot: heroCast.headshot,
      descriptor: club.nick,
    }
  : null;

const GROUND_COPY: Record<string, string> = {
  light: 'Player cells, bench rows, the games strip — anything on a white card.',
  dark: 'The same surfaces in dark mode, swapped in by CSS.',
  band: 'The club-colour band, dark in both themes — so it follows the ' + (band?.slot ?? 'dark') + ' assignment.',
};
---

<Layout
  title={
    league
      ? `${club.name} marks | NFL Brand Book | ${league.name}`
      : `${club.name} marks | NFL Brand Book`
  }
>
  <main class="cb">
    <nav class="cb__crumb"><a href={indexPath}>&larr; NFL Brand Book</a></nav>

    <header class="cb__hero" style={`--hero-bg:${bg};--hero-ink:${ink}`}>
      {band && <img class="cb__ghost" src={band.url} alt="" aria-hidden="true" />}
      <div class="cb__hero-in">
        {band && <img class="cb__mark" src={band.url} alt={`${club.name} logo`} width="120" height="120" />}
        <div>
          <p class="cb__city">{club.city}</p>
          <h1 class="cb__nick">{club.nick}</h1>
        </div>
      </div>
    </header>

    <section class="cb__section">
      <h2 class="cb__h2">Club colours</h2>
      <p class="cb__note">The club's official colours, in order: primary first, then secondary.</p>
      <ul class="cb__swatches">
        {
          club.colors.map((c) => (
            <li>
              <span class="cb__swatch" style={`background:${c}`} />
              <code>{c}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cb__section">
      <h2 class="cb__h2">Marks on file</h2>
      <p class="cb__note">
        {club.marks.length} cuts.
        {
          club.nflDotComIsDark && (
            <>
              {' '}NFL.com publishes only a <strong>for-dark</strong> cut for this club.
            </>
          )
        }
      </p>
      {
        club.reversalNote && (
          <p class="cb__derived">
            <strong>The reversed cut is ours.</strong> No public source publishes one &mdash; ESPN,
            NFL.com, Fox's web CDN, nflverse and Sleeper all serve the standard mark &mdash; so we
            derive it from our own artwork with a hand-reviewed colour map, checked on a dark
            render. {club.reversalNote}
          </p>
        )
      }
      <ul class="cb__film">
        {
          club.marks.map((m) => (
            <li class="cb__cut">
              <span class={`cb__cut-box ${m.forDark ? 'is-dark' : 'is-light'}`}>
                <img src={m.url} alt={`${club.name} — ${m.label}`} loading="lazy" />
                {m.derived && <span class="cb__made">made here</span>}
              </span>
              <span class="cb__cut-label">{m.label}</span>
              <span class="cb__cut-meta">{m.format.toUpperCase()} &middot; {m.source}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cb__section">
      <h2 class="cb__h2">What each ground draws</h2>
      <p class="cb__note">
        Use the light cut on a white cell, and the dark cut on a dark card <em>and</em> on the
        club's own colour.
      </p>
      <ul class="cb__grounds">
        {
          club.grounds.map((g) => (
            <li class={`cb__ground ${g.slot === 'dark' || g.ground === 'band' ? 'is-dark' : 'is-light'}`}>
              <span class="cb__ground-head">
                {g.ground === 'band' ? 'Club colour' : g.ground === 'light' ? 'Light surfaces' : 'Dark surfaces'}
              </span>
              <span
                class="cb__ground-art"
                style={g.ground === 'band' ? `background:${bg}` : undefined}
              >
                <img src={g.url} alt="" loading="lazy" />
              </span>
              <span class="cb__ground-mark">{g.mark.label}</span>
              <span class="cb__ground-why">{GROUND_COPY[g.ground]}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cb__section">
      <h2 class="cb__h2">In the app</h2>
      <p class="cb__note">
        The real components, on their real grounds. The club-colour band is a ground, not a
        surface the app paints today.
      </p>
      <ul class="cb__situ">
        <li class="cb__demo">
          <span class="cb__demo-cap">Player cell &mdash; DEF <em>the mark IS the avatar</em></span>
          {/*
            The REAL PlayerCell, not a lookalike. A hand-rolled copy is a second
            implementation of the DEF rule (the mark becomes the avatar and the
            meta row drops the duplicate logo) and would drift from it silently
            — which is the opposite of what this section is for.

            `nflLogo` is passed explicitly because this page opts out of the
            global dark swap: left to derive its own src, both panes would draw
            the same cut and the comparison would collapse. The ground decides
            the artwork here, exactly as it does everywhere else.
          */}
          <span class="cb__pane is-light">
            <PlayerCell
              name={`${club.nick} D/ST`}
              position="DEF"
              nflTeam={club.code}
              nflLogo={light?.url}
            />
          </span>
          <span class="cb__pane is-dark">
            <PlayerCell
              name={`${club.nick} D/ST`}
              position="DEF"
              nflTeam={club.code}
              nflLogo={dark?.url}
            />
          </span>
        </li>

        <li class="cb__demo">
          <span class="cb__demo-cap">Lineup bench row <em>18px</em></span>
          <span class="cb__pane is-light">
            <span class="cb__bench"><span>Bench &middot; FLEX</span><span class="cb__opp"><img src={light?.url} alt="" loading="lazy" />{club.code}</span></span>
          </span>
          <span class="cb__pane is-dark">
            <span class="cb__bench"><span>Bench &middot; FLEX</span><span class="cb__opp"><img src={dark?.url} alt="" loading="lazy" />{club.code}</span></span>
          </span>
        </li>

        <li class="cb__demo cb__demo--wide">
          <span class="cb__demo-cap">
            Composite hero <em>the mark as a crest watermark, ~300px</em>
          </span>
          <CompositeHero
            ariaLabel={`${club.name} hero example`}
            accent="feature"
            franchise={heroBackdrop}
            wordmark={club.nick.toUpperCase()}
            crest={band ? { src: band.url } : null}
            model={heroModel}
            eager={false}
            pill="NFL Brand Book"
            title={club.city}
            titleAccent={club.nick}
            summary={`The club's mark as a homepage hero draws it: the crest as a watermark behind the copy, on the club's own gradient.`}
            ctaLabel="Every cut on file"
            ctaHref={indexPath}
          />
        </li>

        <li class="cb__demo cb__demo--wide">
          <span class="cb__demo-cap">
            Games strip <em>the real component, sample slate &mdash; follows your theme</em>
          </span>
          {/*
            ONE pane, not the light/dark pair the others get. A game card paints
            itself from the site's own tokens rather than declaring a ground, so
            two panes would render two identical cards and claim a comparison
            that isn't there. Its MARKS still swap with the theme, which is why
            this surface is left in the swap rather than opted out.

            NO client directive, deliberately. In `demo` the hook is disabled
            (`enabled: !demo`) and never polls, so the server render IS the
            final render and hydrating would ship JS to do nothing. It also
            steps around the hazard `tests/network-badge.test.ts` records:
            `client:visible` observes an island's CHILDREN, so an island that
            server-rendered nothing never hydrates and the rail is invisible
            forever. `demoGames` is a non-empty constant, so this mount cannot
            render empty — but an unhydrated island cannot have the bug at all.
          */}
          <span class="cb__pane">
            <NflGamesStrip week={1} year={2026} demo initialGames={demoGames} label={null} />
          </span>
        </li>

        <li class="cb__demo">
          <span class="cb__demo-cap">Club colour <em>the third ground</em></span>
          <span class="cb__pane" style={`background:${bg};color:${ink}`}>
            <span class="cb__bcast">
              {band && <img src={band.url} alt="" loading="lazy" />}
              <span>
                <span class="cb__bname">{club.nick.toUpperCase()}</span>
                <span class="cb__bmeta" style={`color:${ink};opacity:.75`}>{club.city}</span>
              </span>
            </span>
          </span>
        </li>
      </ul>
    </section>

    {league && (
    <section class="cb__section">
      <h2 class="cb__h2">Who rosters {club.nick} in {league.name}</h2>
      {
        holders.length === 0 ? (
          <p class="cb__note">
            {year
              ? `No ${club.nick} on any roster in the ${year} league year.`
              : 'No roster feed on this build.'}
          </p>
        ) : (
          <>
            <p class="cb__note">
              {rosteredCount} {rosteredCount === 1 ? 'player' : 'players'} across{' '}
              {holders.length} {holders.length === 1 ? 'franchise' : 'franchises'}
              {year ? ` — ${year} league year.` : '.'}
            </p>
            <ul class="cb__holders">
              {holders.map((h) => (
                <li class="cb__holder">
                  <span class="cb__holder-name">{h.franchiseName}</span>
                  <span class="cb__holder-players">
                    {h.players.map((p) => (
                      <PlayerCell
                        name={p.name}
                        position={p.position}
                        nflTeam={club.code}
                        headshot={p.headshot}
                        mflId={p.id}
                        espnId={p.espnId ?? undefined}
                        size="compact"
                      />
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>
    )}
  </main>
</Layout>

