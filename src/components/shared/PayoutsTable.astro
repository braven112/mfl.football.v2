---
/**
 * A league's published prize table, rendered from the league registry.
 *
 * `payouts` in `src/config/leagues-data.mjs` is the only prize table (see
 * docs/claude/rules/accounting.md). Both rules pages listed their amounts as
 * hand-typed markup until Aug 2026 — TheLeague's as a `<ul>` in
 * `rules.astro`, the AFL's inside the static `docs/rules.html` constitution —
 * so a prize change had to be remembered in three places and never was.
 *
 * Shared by both leagues' rules pages. Nothing here knows an amount: every
 * number comes from `getPrizeTableRows()`.
 */
import {
  formatPrizeAmount,
  getDerivedPrizeTotal,
  getPrizePool,
  getPrizeTableRows,
} from '../../utils/prize-display';

interface Props {
  /** Registry slug whose payout table to render. */
  leagueSlug: string;
  /** Optional note rendered under the table (e.g. the AFL's double-title footnote). */
  footnote?: string;
}

const { leagueSlug, footnote } = Astro.props as Props;

const rows = getPrizeTableRows(leagueSlug);
const pool = getPrizePool(leagueSlug);
const derivedTotal = getDerivedPrizeTotal(leagueSlug);

// The pool is the constitution's STATED total; the derived total is what the
// listed prizes add up to. Showing both, and the drift between them, is the
// documented behaviour — silently correcting a total is how a real prize
// disappears. `derivedTotal` is null when the registry alone can't say (a
// playoff-seed prize pays its seeds in every conference, and the payout table
// does not carry a conference count), in which case only the pool is shown.
const drift = pool !== null && derivedTotal !== null ? derivedTotal - pool : null;
---

{rows.length > 0 && (
  <div class="payouts-table-card">
    <div class="payouts-table-scroll">
      <table class="payouts-table">
        <thead>
          <tr>
            <th scope="col">Prize</th>
            <th scope="col" class="payouts-table__amount">Amount</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">
                <span class="payouts-table__label">{row.label}</span>
                {row.note && <span class="payouts-table__note">{row.note}</span>}
              </th>
              <td class="payouts-table__amount">
                <span class="payouts-amount">{row.amount}</span>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          {derivedTotal !== null && (
            <tr>
              <th scope="row">Total prizes</th>
              <td class="payouts-table__amount">
                <span class="payouts-amount">{formatPrizeAmount(derivedTotal)}</span>
              </td>
            </tr>
          )}
          {pool !== null && (
            <tr class="payouts-table__pool">
              <th scope="row">
                <span class="payouts-table__label">Stated prize pool</span>
                <span class="payouts-table__note">From the constitution</span>
              </th>
              <td class="payouts-table__amount">{formatPrizeAmount(pool)}</td>
            </tr>
          )}
        </tfoot>
      </table>
    </div>

    {drift !== null && drift !== 0 && (
      <p class="payouts-table__drift">
        Listed prizes differ from the stated pool by {formatPrizeAmount(Math.abs(drift))}.
      </p>
    )}
    {footnote && <p class="payouts-table__footnote">{footnote}</p>}
  </div>
)}

<style>
  .payouts-table-card {
    margin: 1rem 0 1.5rem;
  }
  /* Wide content scrolls inside its own container so the page body never
     scrolls sideways on a phone. */
  .payouts-table-scroll {
    overflow-x: auto;
  }
  .payouts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .payouts-table th,
  .payouts-table td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--content-border);
  }
  .payouts-table thead th {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted);
    font-weight: 700;
  }
  .payouts-table tbody th {
    font-weight: 600;
    color: var(--page-text);
  }
  .payouts-table__label {
    display: block;
  }
  .payouts-table__note {
    display: block;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--content-text-muted);
  }
  .payouts-table__amount {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .payouts-amount {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--prize-seed-bg);
    border: 1px solid var(--prize-seed-border);
    color: var(--prize-seed-text);
    font-weight: 700;
  }
  .payouts-table tfoot th,
  .payouts-table tfoot td {
    border-bottom: none;
    border-top: 2px solid var(--content-border);
    font-weight: 700;
    color: var(--page-text);
  }
  .payouts-table__pool th,
  .payouts-table__pool td {
    border-top: 1px solid var(--content-border);
    font-weight: 600;
    color: var(--prize-pool-text);
  }
  .payouts-table__drift,
  .payouts-table__footnote {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--content-text-muted);
  }
</style>
