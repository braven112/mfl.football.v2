---
/**
 * The Broadcast's landing in MFL Live (`/live/broadcast`) — the page you meet
 * BEFORE the fullscreen board, built to sell the product it opens.
 *
 * The fullscreen board itself is untouched. What changed is everything in
 * front of it: the toolbar of three bare buttons above a full-bleed board read
 * as parts that were not meant to be there. This is a product page instead —
 *
 *  - the copy, the live numbers and one primary action (Go full screen);
 *  - the REAL board, playing inside a TV frame (see "The preview" below);
 *  - the leagues it watches, as on/off cards;
 *  - pairing a television by QR code, and the TVs already paired.
 *
 * ── THE PREVIEW IS THE BOARD ─────────────────────────────────────────────
 * The frame does not hold a screenshot. It holds the island itself, rendered
 * at the size of THIS viewport (100vw x 100vh, which is what every vh/vw on
 * the board is measured against) and scaled down with a transform to fit the
 * frame. So the preview is exactly what this screen shows in fullscreen, in
 * any orientation — and "Go full screen" fullscreens that same element. The
 * UA stylesheet gives a fullscreen element `transform: none !important` and
 * the top layer ignores its ancestors' transforms, so the board leaves the
 * frame at full size. Nothing is mounted twice.
 *
 * No layout of its own and no cookie writes: the route owns both
 * (`Astro.cookies.set()` from a component throws after the headers commit).
 */
import type { AssembledBoard } from '../../../utils/broadcast-board';
import type { LiveBroadcastPageData } from '../../../types/live-broadcast';
import type { PassSummary } from '../../../utils/broadcast-tv-pairing';
import { mflLoginUrl } from '../../../utils/mfl-login-redirect';
import {
  broadcastHref,
  defaultLeagueSelection,
  toggleLeagueSelection,
} from '../../../utils/broadcast-selection';

interface Props {
  viewer: { via: 'session' | 'tv'; name: string; device: string | null } | null;
  board: AssembledBoard | null;
  pageData: LiveBroadcastPageData | null;
  failed: boolean;
  week: number;
  explicitWeek: boolean;
  sound: boolean;
  tvs: PassSummary[];
  /** This host, for "go to <host>/tv". */
  host: string;
}

const { viewer, board, pageData, failed, week, explicitWeek, sound, tvs, host } = Astro.props;

const PATH = '/live/broadcast';
const weekForHref = explicitWeek ? week : null;

// ── The numbers in the hero ────────────────────────────────────────────────
const games = pageData?.initial.games ?? [];
const liveGames = games.filter((g) => g.state === 'in').length;
const gamesToCome = games.filter((g) => g.state === 'pre').length;
const onAir = liveGames > 0;

/** The viewer's own team in a league, and its score line. */
function matchupLine(leagueId: string): { line: string; icon: string } | null {
  const panel = board?.panels.find((p) => p.leagueId === leagueId);
  const matchup = panel?.matchups[0];
  if (!panel || !matchup) return null;
  const scores = pageData?.initial.leagues.find((l) => l.leagueId === leagueId);
  const mine = scores?.teams[matchup.mine.franchiseId]?.live;
  const theirs = matchup.opponent ? scores?.teams[matchup.opponent.franchiseId]?.live : undefined;
  const fmt = (n: number | undefined) => (typeof n === 'number' ? n.toFixed(1) : '–');
  const line = matchup.opponent
    ? `${matchup.mine.nameShort} ${fmt(mine)} – ${fmt(theirs)} ${matchup.opponent.nameShort}`
    : `${matchup.mine.nameShort} · ${fmt(mine)} pts`;
  return { line, icon: matchup.mine.iconSmall || matchup.mine.icon };
}

let starters = 0;
for (const panel of board?.panels ?? []) {
  const scores = pageData?.initial.leagues.find((l) => l.leagueId === panel.leagueId);
  for (const m of panel.matchups) {
    starters += (scores?.teams[m.mine.franchiseId]?.players ?? []).filter((p) => p.status === 'starter').length;
  }
}

const stats = [
  { value: board?.enabled.length ?? 0, label: (board?.enabled.length ?? 0) === 1 ? 'League' : 'Leagues' },
  { value: starters, label: 'Your starters' },
  onAir
    ? { value: liveGames, label: liveGames === 1 ? 'NFL game live' : 'NFL games live' }
    : { value: gamesToCome, label: gamesToCome === 1 ? 'NFL game to come' : 'NFL games to come' },
];

// ── The league cards ───────────────────────────────────────────────────────
const enabled = board?.enabled ?? [];
const allIds = (board?.leagues ?? []).map((l) => l.id);
const defaults = board ? defaultLeagueSelection(board.leagues) : [];
const leagueCards = (board?.leagues ?? []).map((league) => {
  const on = enabled.includes(league.id);
  // The last league on cannot be switched off: an empty selection means
  // "the default" to the resolver, which would silently turn the others BACK on.
  const locked = on && enabled.length <= 1;
  const matchup = on ? matchupLine(league.id) : null;
  return {
    id: league.id,
    name: league.name,
    on,
    locked,
    logo: league.registered?.logo ?? null,
    icon: matchup?.icon ?? '',
    initials: league.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase(),
    line: on ? (matchup?.line ?? 'On the broadcast') : 'Not on the broadcast',
    href: broadcastHref(PATH, toggleLeagueSelection(enabled, allIds, league.id, defaults), weekForHref),
  };
});

const boardHref = `${PATH}?view=board${explicitWeek ? `&week=${week}` : ''}`;
const fmtDate = (ms: number) =>
  new Date(ms).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<div class="bcl">
  <section class="bcl-hero" aria-labelledby="bcl-title">
    <div class="bcl-hero__copy">
      <p class="bcl-eyebrow">
        <span class:list={['bcl-eyebrow__dot', { 'is-live': onAir }]} aria-hidden="true"></span>
        {onAir ? `On air · Week ${week}` : `MFL Football · Week ${week}`}
      </p>
      <h1 id="bcl-title" class="bcl-hero__title">The Broadcast</h1>
      <p class="bcl-hero__sub">
        Every score from every league you play in, built for the TV across the room. Your
        touchdowns take the whole screen. So do theirs.
      </p>

      {pageData ? (
        <Fragment>
          <dl class="bcl-stats">
            {stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>

          <div class="bcl-actions">
            {/* A LINK first: with no Fullscreen API (an iPhone) or no script,
                it opens the board on its own page. The script turns it into a
                real fullscreen request wherever the browser can make one. */}
            <a class="cta cta--primary bcl-go" href={boardHref} data-bcl-fullscreen>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span data-bcl-fullscreen-label>Go full screen</span>
            </a>
            <button
              type="button"
              class="cta cta--ghost bcl-sound"
              data-bcl-sound
              data-on={sound ? 'true' : 'false'}
              aria-pressed={sound ? 'true' : 'false'}
            >
              <svg class="bcl-sound__on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" /><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              <svg class="bcl-sound__off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" /><path d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
              <span data-bcl-sound-label>{sound ? 'Sound on' : 'Sound off'}</span>
            </button>
            {/* The NFL games the owner's starters are in, and the TV app that opens each. */}
            <a class="cta cta--ghost bcl-sound" href="/live/broadcast/watch">Where to watch</a>
          </div>
          <p class="bcl-keys">
            Press <kbd>F</kbd> any time. <kbd>Esc</kbd>, or Back on a TV remote, comes back out.
          </p>
        </Fragment>
      ) : viewer && failed ? (
        <div class="bcl-actions">
          <p class="bcl-note">
            We couldn&rsquo;t read your leagues from MyFantasyLeague just now. Refreshing usually
            sorts it.
          </p>
          <a class="cta cta--primary bcl-go" href={PATH}>Try again</a>
        </div>
      ) : (
        <div class="bcl-actions">
          <a class="cta cta--primary bcl-go" href={mflLoginUrl(PATH)}>Sign in with MyFantasyLeague</a>
          <a class="cta cta--ghost bcl-sound" href="/tv">This is a TV</a>
        </div>
      )}
    </div>

    <div class="bcl-hero__stage">
      {pageData ? (
        <div class="bcl-screen" data-bcl-screen>
          <div class="bcl-screen__glass" data-bcl-screen-glass>
            <div class="bcl-screen__viewport" data-bcl-viewport>
              <slot name="board" />
            </div>
            {/* The preview is for looking at. A click anywhere on it goes
                fullscreen, which is the only thing a click on a TV picture
                could mean — and it keeps the board's own pointer handling
                from waking the board inside a frame. */}
            {/* A labeled button, not a bare icon: the little preview is only
                worth anything once it is opened, and an unlabeled corner
                glyph did not read as "this opens". */}
            <a class="bcl-screen__hit" href={boardHref} data-bcl-fullscreen aria-label="Open full broadcast">
              <span class="bcl-screen__expand" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Open full broadcast</span>
              </span>
            </a>
          </div>
          <div class="bcl-screen__stand" aria-hidden="true"></div>
          {/* Under the frame, not on it: a badge on the picture sat on top of
              whatever the board drew in that corner. */}
          <p class="bcl-screen__caption">
            <span class:list={['bcl-eyebrow__dot', { 'is-live': onAir }]} aria-hidden="true"></span>
            {onAir ? 'Live preview' : 'Preview'} · this is what this screen shows in full screen
          </p>
        </div>
      ) : (
        <div class="bcl-screen bcl-screen--idle" aria-hidden="true">
          <div class="bcl-screen__glass bcl-screen__glass--idle">
            <div class="bcl-idle">
              <p class="bcl-idle__kicker">Touchdown</p>
              <p class="bcl-idle__name">Your player</p>
              <p class="bcl-idle__line">takes the whole screen</p>
            </div>
          </div>
          <div class="bcl-screen__stand"></div>
        </div>
      )}
    </div>
  </section>

  {board && leagueCards.length > 0 && (
    <section class="bcl-section" aria-labelledby="bcl-leagues-title">
      <header class="bcl-section__head">
        <h2 id="bcl-leagues-title">On this broadcast</h2>
        <p>Tap a league to put it on the board or take it off.</p>
      </header>
      <ul
        class="bcl-leagues"
        data-bcl-leagues
        data-all={allIds.join(',')}
        data-defaults={defaults.join(',')}
        data-week={weekForHref ?? ''}
        data-path={PATH}
      >
        {leagueCards.map((card) => {
          const inner = (
            <Fragment>
              <span class="bcl-league__mark">
                {card.logo ? (
                  <Fragment>
                    <img class="bcl-logo-light" src={card.logo.light} alt="" loading="lazy" />
                    <img class="bcl-logo-dark" src={card.logo.dark} alt="" loading="lazy" />
                  </Fragment>
                ) : card.icon ? (
                  <img src={card.icon} alt="" loading="lazy" />
                ) : (
                  <span class="bcl-league__initials">{card.initials}</span>
                )}
              </span>
              <span class="bcl-league__text">
                <strong>{card.name}</strong>
                <span>{card.line}</span>
              </span>
              <span class="bcl-switch" data-on={card.on ? 'true' : 'false'} aria-hidden="true"></span>
            </Fragment>
          );
          return (
            <li>
              {/* LINKS, so a TV browser with no script can still change them.
                  `aria-current` marks the on state; `aria-pressed` is not
                  valid on an anchor. */}
              {card.locked ? (
                <span
                  class:list={['bcl-league', 'is-on', 'is-locked']}
                  data-league-id={card.id}
                  title="At least one league stays on"
                >
                  {inner}
                </span>
              ) : (
                <a
                  class:list={['bcl-league', { 'is-on': card.on }]}
                  href={card.href}
                  data-league-id={card.id}
                  data-name={card.name}
                  aria-current={card.on ? 'true' : undefined}
                  aria-label={`${card.name}: ${card.on ? 'on — tap to remove' : 'off — tap to add'}`}
                >
                  {inner}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="bcl-section bcl-tv" aria-labelledby="bcl-tv-title">
    <div class="bcl-tv__pitch">
      <h2 id="bcl-tv-title">Put it on a TV</h2>
      {viewer?.via === 'tv' ? (
        <p>
          This {viewer.device ?? 'TV'} is paired to {viewer.name}&rsquo;s broadcast. It can only watch the
          scoreboard.
        </p>
      ) : (
        <ol class="bcl-steps">
          <li><span>1</span><p>On the TV&rsquo;s web browser, go to <strong>{host}/tv</strong>.</p></li>
          <li><span>2</span><p>Scan the code it shows with your phone and tap <strong>Approve</strong>.</p></li>
          <li><span>3</span><p>The TV opens your board. No typing passwords with a remote.</p></li>
        </ol>
      )}
    </div>

    <div class="bcl-tv__panel">
      {viewer?.via === 'tv' ? (
        <Fragment>
          <p class="bcl-tv__label">This TV</p>
          <p class="bcl-tv__empty">Paired with a watch-only pass.</p>
          <button type="button" class="cta cta--ghost bcl-tv__btn" data-bcl-unpair-self>Unpair this TV</button>
        </Fragment>
      ) : viewer ? (
        <Fragment>
          <p class="bcl-tv__label">Your TVs</p>
          {tvs.length === 0 ? (
            <p class="bcl-tv__empty">No TVs paired yet.</p>
          ) : (
            <ul class="bcl-tv__list">
              {tvs.map((tv) => (
                <li data-bcl-tv={tv.id}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 21h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                  <span><strong>{tv.device}</strong><small>Paired {fmtDate(tv.createdAt)}</small></span>
                  <button type="button" class="cta-link bcl-tv__remove" data-bcl-unpair={tv.id}>Remove</button>
                </li>
              ))}
            </ul>
          )}
          {/* Always offered: a TV paired while signed in to the other league
              is not in this list, and the remote page says what to do when
              it finds none. */}
          <a class="cta cta--primary bcl-tv__btn" href="/live/broadcast/remote">Open the TV remote</a>
          <a class="cta cta--ghost bcl-tv__btn" href="/live/broadcast/pair">Enter a TV code</a>
        </Fragment>
      ) : (
        <Fragment>
          <p class="bcl-tv__label">On the TV now?</p>
          <p class="bcl-tv__empty">Start here, and finish on your phone.</p>
          <a class="cta cta--primary bcl-tv__btn" href="/tv">Pair this TV</a>
        </Fragment>
      )}
    </div>
  </section>

  <section class="bcl-features" aria-label="What the broadcast does">
    <div>
      <h3>Big plays take the screen</h3>
      <p>A touchdown in any of your leagues becomes a full-screen reveal in your team&rsquo;s colours.</p>
    </div>
    <div>
      <h3>You see theirs too</h3>
      <p>When your opponent scores, a lower third slides in without hiding your board.</p>
    </div>
    <div>
      <h3>Made for a second TV</h3>
      <p>Runs all day without a touch, with burn-in protection and dimming built in.</p>
    </div>
  </section>
</div>

{/* Sized before first paint, so the frame never flashes at the wrong size.
    Inline, so it runs in document order right here; the module script below
    keeps it right on resize. Same arithmetic in both. */}
<script is:inline>
  (function () {
    var glass = document.querySelector('[data-bcl-screen-glass]');
    if (!glass) return;
    var vw = window.innerWidth, vh = window.innerHeight;
    var max = vh > vw ? vh * 0.5 : vh * 0.62;
    var s = Math.min((glass.parentElement.clientWidth - 20) / vw, max / vh, 1);
    glass.style.setProperty('--bcl-s', String(s));
    glass.style.setProperty('--bcl-vw', vw + 'px');
    glass.style.setProperty('--bcl-vh', vh + 'px');
  })();
</script>

<script>
  /**
   * Three things, each idempotent so a ClientRouter re-init cannot stack them:
   * the preview's scale, Go full screen, and the sound toggle. Plus unpairing.
   *
   * Every element is looked up per init (the router replaces them), and every
   * handler is ASSIGNED rather than added.
   */
  import { BROADCAST_MODE_COOKIE, resolveBroadcastMode } from '../../../utils/broadcast-mode';
  import {
    BROADCAST_LEAGUE_COOKIE,
    BROADCAST_LEAGUE_MAX_AGE,
    broadcastHref,
    toggleLeagueSelection,
  } from '../../../utils/broadcast-selection';

  type FsElement = Element & {
    webkitRequestFullscreen?: () => Promise<void> | void;
  };

  function sizePreview() {
    const glass = document.querySelector<HTMLElement>('[data-bcl-screen-glass]');
    if (!glass || !glass.parentElement) return;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Portrait screens preview a portrait board; cap its height so the copy
    // and the button stay on screen with it.
    const max = vh > vw ? vh * 0.5 : vh * 0.62;
    // 20px: the frame's padding, which sits outside the scaled screen.
    const s = Math.min((glass.parentElement.clientWidth - 20) / vw, max / vh, 1);
    glass.style.setProperty('--bcl-s', String(s));
    glass.style.setProperty('--bcl-vw', `${vw}px`);
    glass.style.setProperty('--bcl-vh', `${vh}px`);
  }

  function requestFn(el: FsElement | null) {
    if (!el) return null;
    const fn = el.requestFullscreen ?? el.webkitRequestFullscreen;
    return typeof fn === 'function' ? fn : null;
  }

  function initFullscreen() {
    // Support is a property of the browser; check it on the root element.
    if (!requestFn(document.documentElement as FsElement)) return;
    // A phone or tablet follows the link to `?view=board`, which renders the
    // handheld board. Fullscreening the preview would give it the TV board,
    // which this preview is pinned to.
    const handheld = resolveBroadcastMode({
      cookie: document.cookie.match(new RegExp(`(?:^|;\\s*)${BROADCAST_MODE_COOKIE}=([^;]*)`))?.[1] ?? null,
      maxTouchPoints: navigator.maxTouchPoints ?? 0,
      coarsePointer: window.matchMedia?.('(pointer: coarse)').matches ?? false,
      screenShortSide: Math.min(window.screen?.width ?? 0, window.screen?.height ?? 0),
    }) === 'handheld';
    document.querySelectorAll<HTMLAnchorElement>('[data-bcl-fullscreen]').forEach((link) => {
      link.onclick = (e: MouseEvent) => {
        if (handheld) return; // fall through to the link
        const board = document.querySelector('[data-bcl-viewport] .lbc.is-board') as FsElement | null;
        const request = requestFn(board);
        if (!board || !request) return; // fall through to the link
        e.preventDefault();
        void Promise.resolve(request.call(board)).catch(() => {
          window.location.href = link.href;
        });
      };
    });
  }

  function paintSound(btn: HTMLElement, on: boolean) {
    btn.dataset.on = on ? 'true' : 'false';
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    const label = btn.querySelector('[data-bcl-sound-label]');
    if (label) label.textContent = on ? 'Sound on' : 'Sound off';
  }

  function initSound() {
    const btn = document.querySelector<HTMLElement>('[data-bcl-sound]');
    if (!btn || btn.tagName !== 'BUTTON') return;
    const m = document.cookie.match(/(?:^|;\s*)bc_sound=([01])/);
    if (m) paintSound(btn, m[1] === '1');
    btn.onclick = () => {
      const next = btn.dataset.on !== 'true';
      paintSound(btn, next);
      try {
        document.cookie = `bc_sound=${next ? '1' : '0'}; path=/; max-age=${180 * 24 * 60 * 60}; samesite=lax`;
      } catch {
        /* the board still hears the event below */
      }
      // The island listens on `lbc:sound` and ignores only its own echo.
      document.dispatchEvent(new CustomEvent('lbc:sound', { detail: { on: next, from: 'landing' } }));
    };
  }

  async function unpair(body: Record<string, unknown>) {
    const res = await fetch('/api/broadcast-tv/revoke', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(body),
    });
    return res.ok;
  }

  function initUnpair() {
    document.querySelectorAll<HTMLButtonElement>('[data-bcl-unpair]').forEach((btn) => {
      btn.onclick = async () => {
        btn.disabled = true;
        const ok = await unpair({ id: btn.dataset.bclUnpair }).catch(() => false);
        if (ok) btn.closest('li')?.remove();
        else btn.disabled = false;
      };
    });
    const self = document.querySelector<HTMLButtonElement>('[data-bcl-unpair-self]');
    if (self) {
      self.onclick = async () => {
        self.disabled = true;
        await unpair({ self: true }).catch(() => false);
        window.location.href = '/tv';
      };
    }
  }

  /**
   * League toggles change in place. They are LINKS (a TV browser with no
   * script still follows them), and following one re-rendered the whole page:
   * scroll back to the top and the preview board rebuilt from nothing, for
   * one switch.
   *
   * With script, a tap flips the switch at once and a league switched OFF
   * leaves the preview board on the same tap (`lbc:leagues`). The same href is
   * then fetched in the background: that request is what remembers the choice
   * (the route sets the cookie), and its page supplies the fresh league rows,
   * the numbers in the hero and the board data for the new set — the only way
   * a league switched ON gets its panels.
   *
   * Nothing is REPLACED. Replacing the list (as this first did) dropped the
   * remote's focus with the card it sat on, so the next D-pad press started
   * from the top of the page — on a TV, indistinguishable from a reload. So
   * each card is patched where it stands, and the board takes its new data
   * through `lbc:board-data` rather than being remounted.
   *
   * Only the newest tap's answer is applied, so a quick second tap is never
   * undone by the first one's. That holds for the cookie too: the older
   * request is aborted, and the newest choice is written here as well,
   * because two requests' Set-Cookie headers land in whatever order the
   * server answers them.
   */
  let toggleSeq = 0;
  let toggleAbort: AbortController | null = null;
  /** The leagues the preview board has data for — what a failed request leaves it able to show. */
  let loaded = new Set<string>();
  /**
   * The latest word sent to the board. The island hydrates on its own clock,
   * so a switch pressed first would be shouted at nobody; it asks for this
   * with `lbc:board-ready` once it is listening.
   */
  let pendingBoard: { leagues?: string[]; data?: unknown } = {};

  function tellBoard(update: { leagues?: string[]; data?: unknown }) {
    if (update.data) pendingBoard = { data: update.data };
    else if (update.leagues) {
      // A removal after fresh data still has to take that league off.
      pendingBoard = { ...pendingBoard, leagues: update.leagues };
    }
    if (update.data) document.dispatchEvent(new CustomEvent('lbc:board-data', { detail: { data: update.data } }));
    if (update.leagues) document.dispatchEvent(new CustomEvent('lbc:leagues', { detail: { enabled: update.leagues } }));
  }

  const ids = (raw: string | undefined) => (raw ? raw.split(',').filter(Boolean) : []);

  function paintCard(card: HTMLElement, on: boolean) {
    card.classList.toggle('is-on', on);
    card.querySelector<HTMLElement>('.bcl-switch')?.setAttribute('data-on', on ? 'true' : 'false');
    const line = card.querySelector('.bcl-league__text > span');
    if (line) line.textContent = on ? 'On the broadcast' : 'Not on the broadcast';
    if (card instanceof HTMLAnchorElement) {
      if (on) card.setAttribute('aria-current', 'true');
      else card.removeAttribute('aria-current');
      card.setAttribute('aria-label', `${card.dataset.name ?? ''}: ${on ? 'on — tap to remove' : 'off — tap to add'}`);
    }
  }

  function writeLeagueCookie(href: string) {
    const leagues = new URL(href, location.href).searchParams.get('leagues') ?? 'default';
    try {
      document.cookie = `${BROADCAST_LEAGUE_COOKIE}=${encodeURIComponent(leagues)}; path=/; max-age=${BROADCAST_LEAGUE_MAX_AGE}; samesite=lax`;
    } catch {
      /* the server's own Set-Cookie still stands */
    }
  }

  /**
   * One card brought up to date from the fresh page, in place.
   *
   * Same element whenever it can be, so focus stays on it. Only a card that
   * changes between a link and the locked span (the last league on) has to be
   * swapped, and that is never the card just pressed: a pressed card is a
   * link before and after.
   */
  function patchCard(card: HTMLElement, fresh: HTMLElement) {
    if (card.tagName !== fresh.tagName) {
      card.replaceWith(document.importNode(fresh, true));
      return;
    }
    for (const attr of Array.from(card.attributes)) {
      if (!fresh.hasAttribute(attr.name)) card.removeAttribute(attr.name);
    }
    for (const attr of Array.from(fresh.attributes)) {
      if (card.getAttribute(attr.name) !== attr.value) card.setAttribute(attr.name, attr.value);
    }
    if (card.innerHTML !== fresh.innerHTML) card.innerHTML = fresh.innerHTML;
  }

  function patchLeagues(list: HTMLElement, freshList: HTMLElement) {
    // The list's own data (the set, the defaults) comes across too.
    for (const attr of Array.from(freshList.attributes)) list.setAttribute(attr.name, attr.value);
    const current = new Map(
      Array.from(list.querySelectorAll<HTMLElement>('[data-league-id]')).map((c) => [c.dataset.leagueId!, c]),
    );
    const freshCards = Array.from(freshList.querySelectorAll<HTMLElement>('[data-league-id]'));
    const sameLeagues =
      freshCards.length === current.size && freshCards.every((c) => current.has(c.dataset.leagueId!));
    if (!sameLeagues) {
      // A different set of leagues altogether (MFL answered differently this
      // time): nothing to patch against, so take the fresh list whole.
      list.replaceWith(document.importNode(freshList, true));
      return;
    }
    for (const fresh of freshCards) patchCard(current.get(fresh.dataset.leagueId!)!, fresh);
  }

  /**
   * The board data out of the fresh page's island props. Astro serializes a
   * plain prop as `[0, value]`; anything else means the format moved, and the
   * caller falls back to swapping the island.
   */
  function boardDataFrom(next: Document): unknown {
    const island = next.querySelector('[data-bcl-viewport] astro-island');
    try {
      const raw = JSON.parse(island?.getAttribute('props') ?? '')?.pageData;
      return Array.isArray(raw) && raw[0] === 0 && typeof raw[1] === 'string' ? JSON.parse(raw[1]) : null;
    } catch {
      return null;
    }
  }

  /** Last resort: the new page's island in place of the old one, unmounted first so it stops polling. */
  function swapBoard(next: Document) {
    const oldIsland = document.querySelector('[data-bcl-viewport] astro-island');
    const newIsland = next.querySelector('[data-bcl-viewport] astro-island');
    if (!oldIsland || !newIsland) return;
    oldIsland.dispatchEvent(new CustomEvent('astro:unmount'));
    oldIsland.replaceWith(document.importNode(newIsland, true));
  }

  async function applyToggle(href: string, seq: number, adding: boolean) {
    toggleAbort?.abort();
    const abort = new AbortController();
    toggleAbort = abort;
    // Remembered now, not when the server answers: the board already shows
    // the new set, and a reload must too.
    writeLeagueCookie(href);
    history.replaceState(history.state, '', href);
    let html: string;
    try {
      const res = await fetch(href, {
        credentials: 'same-origin',
        headers: { accept: 'text/html' },
        signal: abort.signal,
      });
      if (!res.ok) throw new Error(String(res.status));
      html = await res.text();
    } catch {
      // A removal is already done — the switch, the board and the cookie all
      // say so — and the rows catch up on the next visit. A league the board
      // has no data for (this tap's add, or an earlier one whose request this
      // tap aborted) cannot be drawn without the server, so only then does
      // the page go fetch it.
      if (seq !== toggleSeq || abort.signal.aborted) return;
      const wanted = new URL(href, location.href).searchParams.get('leagues')?.split(',') ?? [];
      if (wanted.some((id) => id && id !== 'default' && !loaded.has(id))) window.location.href = href;
      return;
    }
    if (seq !== toggleSeq) return;
    writeLeagueCookie(href);
    const next = new DOMParser().parseFromString(html, 'text/html');
    const list = document.querySelector<HTMLElement>('[data-bcl-leagues]');
    const freshList = next.querySelector<HTMLElement>('[data-bcl-leagues]');
    if (list && freshList) patchLeagues(list, freshList);
    const stats = document.querySelector('.bcl-stats');
    const freshStats = next.querySelector('.bcl-stats');
    if (stats && freshStats) stats.replaceWith(document.importNode(freshStats, true));
    const data = boardDataFrom(next) as { enabled?: unknown } | null;
    if (data) tellBoard({ data });
    else swapBoard(next);
    const on = Array.isArray(data?.enabled) ? (data.enabled as string[]) : null;
    loaded = new Set(on ?? enabledCards());
    initLeagueToggles();
  }

  function enabledCards(): string[] {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-bcl-leagues] [data-league-id].is-on')).map(
      (c) => c.dataset.leagueId!,
    );
  }

  function initLeagueToggles() {
    const list = document.querySelector<HTMLElement>('[data-bcl-leagues]');
    if (!list) return;
    list.onclick = (e: MouseEvent) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const card = (e.target as Element | null)?.closest<HTMLElement>('[data-league-id]');
      if (!card || !list.contains(card)) return;
      e.preventDefault();
      if (card.classList.contains('is-locked')) return;
      const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-league-id]'));
      const enabled = cards.filter((c) => c.classList.contains('is-on')).map((c) => c.dataset.leagueId!);
      const id = card.dataset.leagueId!;
      // The last league on stays on: an empty selection means "the default"
      // to the resolver, which would silently turn the others back on.
      if (enabled.length === 1 && enabled[0] === id) return;
      const all = ids(list.dataset.all);
      const selection = toggleLeagueSelection(enabled, all, id, ids(list.dataset.defaults));
      const week = list.dataset.week ? Number(list.dataset.week) : null;
      const adding = !card.classList.contains('is-on');
      paintCard(card, adding);
      if (!adding) {
        // Off the board on the tap. `selection` is null when the set is back
        // to the defaults, so the board is told the cards' own answer.
        loaded.delete(id);
        tellBoard({ leagues: enabled.filter((x) => x !== id) });
      }
      toggleSeq += 1;
      void applyToggle(broadcastHref(list.dataset.path || '/live/broadcast', selection, week), toggleSeq, adding);
    };
  }

  /**
   * Start the remote's focus ON the preview, so OK is the one press that goes
   * full screen (owner's call, Oct 2026). A TV's first focus otherwise lands
   * on the bar's brand link, which leaves the page. Not on a touch device,
   * which has no focus to steer, and never over a focus someone already moved.
   */
  function focusPreview() {
    if (navigator.maxTouchPoints > 0) return;
    const active = document.activeElement;
    if (active && active !== document.body) return;
    document.querySelector<HTMLElement>('.bcl-screen__hit')?.focus({ preventScroll: true });
  }

  function initBroadcastLanding() {
    if (!document.querySelector('.bcl')) return;
    sizePreview();
    initFullscreen();
    focusPreview();
    initSound();
    initUnpair();
    // A fresh page: its board was rendered with exactly the cards that are on.
    pendingBoard = {};
    loaded = new Set(enabledCards());
    initLeagueToggles();
  }

  // Registered once at module scope; each looks its nodes up per event.
  window.addEventListener('resize', sizePreview);
  document.addEventListener('lbc:sound', (e: Event) => {
    const detail = (e as CustomEvent<{ on: boolean; from?: string }>).detail;
    if (detail?.from === 'landing') return;
    const btn = document.querySelector<HTMLElement>('[data-bcl-sound]');
    if (btn && typeof detail?.on === 'boolean') paintSound(btn, detail.on);
  });

  document.addEventListener('lbc:board-ready', () => {
    if (!document.querySelector('[data-bcl-leagues]')) return;
    const { data, leagues } = pendingBoard;
    if (data) document.dispatchEvent(new CustomEvent('lbc:board-data', { detail: { data } }));
    if (leagues) document.dispatchEvent(new CustomEvent('lbc:leagues', { detail: { enabled: leagues } }));
  });

  initBroadcastLanding();
  document.addEventListener('astro:page-load', initBroadcastLanding);
</script>

