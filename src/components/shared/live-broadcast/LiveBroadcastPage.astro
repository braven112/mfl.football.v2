---
/**
 * Live Scoring Broadcast — the shared page body.
 *
 * ONE implementation; the per-league routes are thin wrappers that own the
 * auth gate and the cookie writes, because neither can live in a component:
 * `Astro.redirect()` from a component's frontmatter merely stops rendering it
 * and ships a blank 200, and `Astro.cookies.set()` from one runs after the
 * headers are committed and throws.
 *
 * The board calls `assembleBroadcastBoard` IN PROCESS. It does not fetch
 * `/api/broadcast-live` to render itself — a server that already knows the
 * league's registry host has nothing to gain by asking its own edge for what
 * it can read directly, and the hop that does has already silently stopped
 * landing once, printing "scores will appear when games begin" over a live
 * slate.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import LiveBroadcast from './LiveBroadcast';
import BroadcastControls from './BroadcastControls.astro';
import { assembleBroadcastBoard, toPageData } from '../../../utils/broadcast-board';
import {
  broadcastHref,
  resolveBroadcastSound,
  toggleLeagueSelection,
  BROADCAST_LEAGUE_COOKIE,
  BROADCAST_SOUND_COOKIE,
} from '../../../utils/broadcast-selection';
import { getCurrentSeasonYear, getTestDateFromSearchParams } from '../../../utils/league-year';
import { getCurrentNFLWeek } from '../../../utils/current-week';
import type { AuthUser } from '../../../utils/auth';
import '../../../styles/live-broadcast.css';
// The global `.visually-hidden` — imported in FRONTMATTER, never with an
// `@import` inside a <style> block, which Vite scopes and which would render
// the live region as visible page text.
import '../../../styles/utilities.css';

interface Props {
  user: AuthUser;
}

const { user } = Astro.props;

// `?testDate=YYYY-MM-DD` shifts the reference date server-side so the board can
// be rendered at the Labor Day boundary, where its season year turns. Without
// it `/rollover-check` cannot exercise this page at all — the repo's contract
// for anything date-dependent — and the default week could not be tested
// either, since it is derived from the same clock.
const testDate = getTestDateFromSearchParams(Astro.url.searchParams) ?? undefined;

// Results-shaped: the SEASON clock (Labor Day), never the league year.
const year = getCurrentSeasonYear(testDate);
const weekParam = Astro.url.searchParams.get('week');
const parsedWeek = weekParam ? parseInt(weekParam, 10) : NaN;
// Clamped to the same 1-25 the poll endpoint enforces. Unclamped, `?week=26`
// rendered an initial MFL board and then took 400s from the island forever,
// so the NFL half of the screen silently stopped matching the MFL half.
const week = Number.isFinite(parsedWeek) && parsedWeek >= 1 && parsedWeek <= 25
  ? parsedWeek
  : (getCurrentNFLWeek(testDate ?? new Date()) ?? 1);

const board = await assembleBroadcastBoard({
  user,
  leaguesParam: Astro.url.searchParams.get('leagues'),
  leaguesCookie: Astro.cookies.get(BROADCAST_LEAGUE_COOKIE)?.value ?? null,
  week,
  year,
});

const sound = resolveBroadcastSound(
  Astro.url.searchParams.get('sound'),
  Astro.cookies.get(BROADCAST_SOUND_COOKIE)?.value ?? null,
);

/**
 * `?demo=1` runs the scripted rehearsal. Deliberately NOT remembered in a
 * cookie the way the league set and the sound are: a television left on a
 * demo it silently resumed next Sunday is the failure this whole flag exists
 * to avoid.
 */
const demo = Astro.url.searchParams.get('demo') === '1';

const pageData = toPageData(board, { week, year, sound, pathname: Astro.url.pathname, demo });

/** Back to the board, keeping the set the chips just built. */
const doneHref = broadcastHref(
  Astro.url.pathname,
  board.enabled.length > 0 ? board.enabled : null,
  Number.isFinite(parsedWeek) ? week : null,
);

/**
 * The Leagues button's destination — the setup screen, CARRYING THE WEEK.
 *
 * `broadcastHref`'s contract is that an explicit `?week=` survives a trip
 * through the chips, and the picker is on that trip: `doneHref` reads
 * `parsedWeek` off the PICKER's URL, so a link that dropped the week sent an
 * owner looking at week 3 back to the current week the moment he opened
 * Leagues and pressed Done. Same `Number.isFinite(parsedWeek)` test as every
 * other href on this page — a week nobody asked for explicitly stays out of
 * the URL.
 */
const pickerHref = `${broadcastHref(
  Astro.url.pathname,
  board.enabled.length > 0 ? board.enabled : null,
  Number.isFinite(parsedWeek) ? week : null,
)}&picker=1`;

/**
 * Does the viewer want the picker?
 *
 * It used to render ONLY when nothing was enabled — and since the two
 * full-management leagues are on by default, that branch never ran for a real
 * owner. So Best Ball and every outside league were opt-in through a screen
 * there was no way to reach, which makes them not opt-in at all. `?picker=1`
 * (a link in the board's chrome) asks for it explicitly.
 */
const wantsPicker = Astro.url.searchParams.get('picker') === '1' || board.enabled.length === 0;

/**
 * The picker's chips. Each href carries the CUMULATIVE set with this league
 * toggled, not just its own id — a chip that replaced the whole selection
 * meant an owner could never watch two leagues at once.
 */
const allIds = board.leagues.map((l) => l.id);
const chips = board.leagues.map((league) => ({
  id: league.id,
  name: league.name,
  on: board.enabled.includes(league.id),
  href: broadcastHref(
    Astro.url.pathname,
    toggleLeagueSelection(board.enabled, allIds, league.id, board.enabled),
    Number.isFinite(parsedWeek) ? week : null,
  ),
}));

const title = `Live Broadcast — Week ${week}`;
---

<TheLeagueLayout title={title} hideMobileNavIcons>
{
  wantsPicker ? (
    <main class="lbc" aria-label="Live scoring broadcast">
      <div class="lbc-setup">
        <BroadcastControls
          chips={chips}
          sound={sound}
          doneHref={board.enabled.length > 0 ? doneHref : undefined}
          variant="setup"
          empty={board.leagues.length === 0}
        />
      </div>
    </main>
  ) : (
    <Fragment>
      {/* ABOVE the board, in normal page flow — never over it. The controls
          used to float at the board's bottom-left and covered the scores; on
          a television the page is scrolled to the board and this strip is
          simply off the top of the picture, while on a laptop or phone it is
          the obvious place to change leagues. */}
      <BroadcastControls
        chips={chips}
        sound={sound}
        variant="strip"
        pickerHref={pickerHref}
      />
      <LiveBroadcast client:load pageData={JSON.stringify(pageData)} />
    </Fragment>
  )
}
</TheLeagueLayout>
