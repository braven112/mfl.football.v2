---
/**
 * The Rosters page's Year picker and My Rank sources, behind ONE sliders
 * button on a phone (user, 2026-10-29: "hide the year switcher behind the
 * filter icon ... in both leagues"). Above the phone breakpoint the button is
 * gone and the two controls sit inline, as they always did.
 *
 * Every league's Rosters page renders this, so the year picker looks and
 * behaves the same everywhere; what a year CHANGE does stays the page's own
 * (TheLeague swaps the season in place, the shared page navigates to
 * `?year=`), wired to the select by `selectId`.
 *
 * My Rank keeps its own trigger (MyRankEditor), which hides itself until the
 * owner has two boards to blend; in the menu it shows as a labelled row.
 */
import MyRankEditor from '../rankings/MyRankEditor.astro';
import type { LeagueSlug } from '../../../types/nav';

interface Props {
  /** Seasons in the picker, newest first. */
  years: Array<string | number>;
  selectedYear: string | number;
  /** The select's id — the page's season handler binds to it. */
  selectId: string;
  /** The league's nav slug for My Rank; omit when the league has no rankings page. */
  rankingsLeague?: LeagueSlug | null;
}

const { years, selectedYear, selectId, rankingsLeague = null } = Astro.props;
const panelId = `${selectId}-options`;
---

<div class="roster-options" data-roster-options>
  <button
    type="button"
    class="roster-options__toggle"
    data-roster-options-toggle
    aria-expanded="false"
    aria-controls={panelId}
    aria-label="Roster options: year and My Rank sources"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" aria-hidden="true">
      <line x1="4" y1="8" x2="20" y2="8" /><circle cx="10" cy="8" r="2.4" fill="currentColor" stroke="none" />
      <line x1="4" y1="16" x2="20" y2="16" /><circle cx="16" cy="16" r="2.4" fill="currentColor" stroke="none" />
    </svg>
  </button>
  <div class="roster-options__panel" id={panelId}>
    <div class="roster-options__year">
      <label for={selectId}>Year</label>
      <select id={selectId} data-current-year={selectedYear}>
        {years.map((year) => (
          <option value={year} selected={String(year) === String(selectedYear)}>{year}</option>
        ))}
      </select>
    </div>
    {rankingsLeague && <MyRankEditor league={rankingsLeague} />}
  </div>
</div>

<style>
  .roster-options {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .roster-options__toggle {
    display: none;
  }

  .roster-options__panel {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .roster-options__year {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .roster-options__year label {
    font-size: var(--font-size-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500, #6b7280);
  }

  .roster-options__year select {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--input-border, #e5e7eb);
    border-radius: var(--radius-sm, 0.25rem);
    background: var(--input-bg, #fff);
    font-size: var(--font-size-sm);
    color: var(--input-text, #111827);
    cursor: pointer;
  }

  /* Phone: one sliders button; the controls drop down beneath it. Same
     breakpoint as src/styles/rosters-mobile.css. */
  @media (max-width: 767px) {
    .roster-options__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--content-border, #d1d5db);
      border-radius: var(--radius-md, 0.5rem);
      background: var(--content-bg, #fff);
      color: var(--color-primary, #1c497c);
      cursor: pointer;
    }

    .roster-options__toggle[aria-expanded='true'] {
      border-color: var(--color-primary, #1c497c);
    }

    .roster-options__panel {
      display: none;
      position: absolute;
      top: calc(100% + 0.375rem);
      right: 0;
      z-index: 30;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      min-width: 13rem;
      padding: 0.875rem;
      border: var(--style-card-border, 1px solid var(--content-border, #d1d5db));
      border-radius: var(--radius-md, 0.5rem);
      background: var(--content-bg, #fff);
      box-shadow: var(--shadow-lg, 0 10px 25px rgba(0, 0, 0, 0.18));
    }

    .roster-options[data-open] .roster-options__panel {
      display: flex;
    }

    .roster-options__year {
      justify-content: space-between;
    }

    .roster-options__year select {
      min-height: var(--touch-target-min, 44px);
      font-size: var(--font-size-base);
    }

    /* In the menu, My Rank is a labelled row rather than a floating pill. */
    .roster-options__panel :global(.mre-trigger:not([hidden])) {
      align-self: stretch;
      justify-content: center;
      min-height: var(--touch-target-min, 44px);
      font-size: var(--font-size-sm);
    }
  }

  html.dark .roster-options__toggle {
    color: var(--color-primary-light, #60a5fa);
  }
</style>

<script>
  // Delegated on `document` once per session: it serves every league's
  // Rosters page and survives ClientRouter swaps without re-binding.
  const w = window as Window & { __rosterOptionsBound?: boolean };
  if (!w.__rosterOptionsBound) {
    w.__rosterOptionsBound = true;

    const close = (root: Element) => {
      root.removeAttribute('data-open');
      root.querySelector('[data-roster-options-toggle]')?.setAttribute('aria-expanded', 'false');
    };
    const closeAll = (except?: Element | null) =>
      document.querySelectorAll('[data-roster-options][data-open]').forEach((root) => {
        if (root !== except) close(root);
      });

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      const toggle = target.closest('[data-roster-options-toggle]');
      if (toggle) {
        const root = toggle.closest('[data-roster-options]');
        if (!root) return;
        const open = !root.hasAttribute('data-open');
        closeAll(root);
        root.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        return;
      }
      // Choosing My Rank opens its own dialog; tidy the menu away first.
      if (target.closest('[data-roster-options] [data-mre-trigger]')) {
        closeAll();
        return;
      }
      if (!target.closest('[data-roster-options]')) closeAll();
    });

    document.addEventListener('change', (event) => {
      const root = (event.target as Element).closest('[data-roster-options]');
      if (root && (event.target as Element).matches('select')) close(root);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll();
    });
  }
</script>
