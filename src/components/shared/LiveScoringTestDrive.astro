---
/**
 * TEMPORARY — the live-scoring preseason hero, for one weekend.
 *
 * During the window this REPLACES the league's normal hero (the homepages gate
 * on `showTestDriveHero`), so it has to carry the page on its own rather than
 * sit above something. One message, one button, no disclosure panels: an owner
 * on a phone during a game gets a reason and a tap target.
 *
 * The query string that makes `?demo=live` work is on the button and nowhere
 * else — it is plumbing, and printing it was making the reader do setup that
 * the link already does (owner direction, 2026-08-21).
 *
 * Delete with src/utils/live-scoring-test-drive.ts once the window lapses.
 */
import { isTestDriveWindow, testDriveBoard } from '../../utils/live-scoring-test-drive';

interface Props {
  /** Canonical slug of the league whose homepage this is. */
  slug: string;
  /**
   * REQUIRED, and it must be the SAME instance the page passed to
   * `showTestDriveHero`. The page uses that call to suppress its normal hero,
   * so if this component reached for its own `new Date()` the two could land
   * on opposite sides of the window boundary within one request — the page
   * hides `SeasonDailyHero`, this renders nothing, and the homepage has NO
   * hero. Making the prop non-optional turns that into a type error instead
   * of a once-a-window race (review finding, #569).
   */
  referenceDate: Date;
}

const { slug, referenceDate } = Astro.props;
const board = isTestDriveWindow(referenceDate) ? testDriveBoard(slug) : null;
---

{board && (
  <section class="ls-td" aria-labelledby="ls-td-title">
    <p class="ls-td__kicker">
      <span class="ls-td__flag">Preseason</span>
      Live Scoring test drive
    </p>

    <h2 class="ls-td__title" id="ls-td-title">
      The new Live Scoring board is running on this week&rsquo;s preseason games.
    </h2>

    <p class="ls-td__lede">
      It reads the actual NFL game now — real quarter and clock, red-zone alerts,
      each starter&rsquo;s live box-score line, and a ticker of the scoring plays
      your guys were in. Tap through and it puts your current roster against
      tonight&rsquo;s <strong>preseason</strong> slate.
    </p>

    <a class="ls-td__cta" href={board.path}>Watch the preseason games live &rarr;</a>

    <p class="ls-td__note">
      Fantasy totals will all read <strong>0.0</strong> — MFL doesn&rsquo;t switch
      its own scoring on until Week 1, and preseason stats never count. Everything
      on the NFL side is real. Anything that looks wrong — a name, a clock, a stat
      line — say so in the chat. Phones especially.
    </p>
  </section>
)}

<style>
  /* Hero-scale on purpose: for this weekend it IS the hero, so it carries the
     top of the page rather than sitting above something bigger. */
  .ls-td {
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--league-accent);
    border-radius: var(--radius-lg);
    background: var(--card-surface);
    padding: var(--spacing-xl) var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }
  .ls-td__kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--content-text-muted);
  }
  /* The one word the hero is really about. Warning tokens, not the league
     accent: this is a "these games don't count" flag, not branding, and both
     tokens carry a light value and an html.dark override. */
  .ls-td__flag {
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--badge-warning-bg);
    color: var(--badge-warning-text);
    letter-spacing: 0.08em;
  }
  .ls-td__title {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4.5vw, 2.1rem);
    line-height: 1.12;
    color: var(--page-text);
    max-width: 24ch;
  }
  .ls-td__lede {
    margin: 0 0 var(--spacing-lg);
    color: var(--content-text-muted);
    font-size: var(--font-size-lg);
    line-height: 1.5;
    max-width: 60ch;
  }
  .ls-td__lede strong, .ls-td__note strong { color: var(--page-text); }

  .ls-td__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--league-accent);
    border-radius: var(--radius-md);
    background: var(--league-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-base);
    text-decoration: none;
  }
  .ls-td__cta:hover { text-decoration: none; opacity: 0.9; }
  .ls-td__cta:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  .ls-td__note {
    margin: var(--spacing-lg) 0 0;
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--content-text-muted);
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .ls-td { padding: var(--spacing-lg) var(--spacing-md); }
    .ls-td__title { max-width: none; }
    .ls-td__lede { font-size: var(--font-size-base); }
    /* Full-width tap target — this hero is aimed at a phone during a game. */
    .ls-td__cta { display: flex; justify-content: center; }
  }
</style>
