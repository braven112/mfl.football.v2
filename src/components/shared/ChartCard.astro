---
/**
 * ChartCard - Reusable card wrapper for charts and visualizations
 * Provides consistent header/body layout across all chart components
 */

export interface Props {
  /** Card title/heading */
  title: string;
  /** Optional subtitle/description */
  subtitle?: string;
  /** Additional CSS classes for the card */
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class:list={['chart-card', className]}>
  <div class="chart-card__header">
    <div class="chart-card__title-section">
      <h3>{title}</h3>
      {subtitle && <p class="chart-card__sub">{subtitle}</p>}
    </div>
    <div class="chart-card__actions">
      <slot name="actions" />
    </div>
  </div>
  <div class="chart-card__body">
    <slot />
  </div>
</div>

<style>
  .chart-card {
    /* A grid/flex item's automatic min-width is its own content's
       min-content, NOT 0 — so `overflow: auto` below could never engage:
       the card simply grew to fit a wide table and pushed its track and
       the page sideways. Measured at 533px inside a 412px phone viewport
       on the Front Office hub. Same trap RosterAnalyticsPanel's own
       .chart-card comment records. */
    min-width: 0;
    background: var(--card-bg-color, #fff);
    border-radius: 1rem;
    padding: 1.5rem 1.5rem 2rem;
    box-shadow: var(--box-shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1));
    display: grid;
    gap: 0.75rem;
    overflow: auto;
  }

  /* Dark mode: border ring so cards separate from the page (raised-card
     recipe — light stays borderless). */
  :global(html.dark) .chart-card {
    box-shadow:
      0 0 0 1px var(--content-border, #555555),
      var(--shadow-lg);
  }

  .chart-card__header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: start;
    font-weight: bold;
  }

  .chart-card__title-section {
    grid-column: 1;
  }

  .chart-card__header h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900, #111827);
  }

  .chart-card__actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
    grid-column: 2;
    grid-row: 1;
  }

  .chart-card__sub {
    margin: 0.15rem 0 0;
    color: var(--content-text-muted, #64748b);
    font-size: 0.9rem;
  }

  .chart-card__body {
    display: block;
    /* Second link in the same chain: the body is a grid item of the card,
       so it needs its own min-width: 0 before a wide child can scroll
       instead of push. */
    min-width: 0;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .chart-card {
      padding: 0.875rem;
    }

    .chart-card__header h3 {
      font-size: 1rem;
    }

    .chart-card__sub {
      font-size: 0.825rem;
    }
  }
</style>
