---
/**
 * WaiverClaimModal — file a waiver claim without leaving for MFL.
 *
 * ONE component for both leagues, because the two waiver systems differ in
 * ways that are data, not layout:
 *   TheLeague  BBID_FCFS     → blind bid: amount + drop + round
 *   AFL        WAIVERS_FCFS  → rolling priority: drop + round, no bid at all
 * The `system` field in the config decides which fields render. Forking this
 * into two components is how this repo grew 24 forked siblings
 * (tests/page-fork-ratchet.test.ts); don't.
 *
 * The identity block is the SAME composite band the player modals use
 * (`.pmb`, painted by applyPlayerModalBand — see
 * src/styles/player-modal-band.css). Layout below mirrors `.cdm-band` so the
 * action modals cannot drift apart.
 *
 * The trigger is delegated on document, so it survives the player table being
 * re-rendered via innerHTML on every sort/filter.
 */
import '../../styles/player-modal-band.css';
import { NFL_LOGO_ONERROR, NFL_LOGO_ONLOAD } from '../../constants/roster-constants';

export interface WaiverClaimConfig {
  canClaim: boolean;
  system: 'bbid' | 'priority';
  franchiseId: string | null;
  rules: { minimum: number; increment: number; conditional: boolean; maxRounds: number };
  roster: Array<{ id: string; name: string }>;
  year: number;
  /** Remaining blind-bid budget, for the hint line. Omitted on priority leagues. */
  balance?: number;
  /** Live waiver window from MFL's calendar: 'waiver' | 'fcfs' | 'unknown'. */
  windowMode: 'waiver' | 'fcfs' | 'unknown';
  /** One-line description of the window, shown in the modal and on the page. */
  windowLabel: string;
}

interface Props {
  /**
   * SSR claim config. Optional: PlayerClaimBridge mounts this dialog on pages
   * that never computed one and calls `window.configureWaiverClaim` once
   * /api/claim-context answers. The blob must still render valid JSON in that
   * case — `undefined` would make init's JSON.parse throw and take the whole
   * page script with it.
   */
  config?: WaiverClaimConfig;
}
const { config } = Astro.props;
const configJson = JSON.stringify(config ?? { canClaim: false });
// Bound non-null so the template below is not a possibly-undefined read (the
// repo's ratcheted null-safety class). Empty when there is no SSR config —
// wire() writes the real window label once the fetched context arrives, which
// is the only source on the pages that mount this without one.
const windowLabel = config?.windowLabel ?? '';
---

<script type="application/json" id="waiver-claim-config" set:html={configJson}></script>

<dialog id="waiver-claim-modal" class="wcm" aria-labelledby="wcm-player-name">
  <!-- Hero identity band — same composite as the player modals. -->
  <div class="wcm-band pmb" id="wcm-band">
    <span class="pmb__ghost" aria-hidden="true"></span>
    <div class="pmb__glow" aria-hidden="true"></div>
    <img class="pmb__crest" alt="" aria-hidden="true" loading="lazy" decoding="async" style="display:none" />
    <img class="pmb__cutout" alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="wcm-band__info">
      <div class="wcm-band__name-row">
        <h3 class="wcm-band__name" id="wcm-player-name">&mdash;</h3>
      </div>
      <div class="wcm-band__meta">
        <img class="wcm-band__team-logo" id="wcm-nfl-logo" src="" alt="" onerror={NFL_LOGO_ONERROR} onload={NFL_LOGO_ONLOAD} />
        <span class="wcm-band__meta-text" id="wcm-meta-text">&mdash;</span>
      </div>
      <div class="wcm-band__sub" id="wcm-sub-text"></div>
    </div>
    <button type="button" class="wcm-close" id="wcm-close" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M14 4L4 14M4 4l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="wcm-body">
    <p class="wcm-window" id="wcm-window">{windowLabel}</p>

    <div class="wcm-field" id="wcm-bid-field">
      <label for="wcm-bid">Bid</label>
      <input type="number" id="wcm-bid" inputmode="numeric" />
      <p class="wcm-hint" id="wcm-bid-hint"></p>
    </div>

    <div class="wcm-field">
      <label for="wcm-drop">Drop if awarded</label>
      <select id="wcm-drop">
        <option value="0000">Nobody &mdash; add without dropping</option>
      </select>
    </div>

    <div class="wcm-field">
      <label for="wcm-round">Waiver round</label>
      <select id="wcm-round"></select>
      <p class="wcm-hint" id="wcm-round-hint"></p>
    </div>

    <p class="wcm-error" id="wcm-error" role="alert" hidden></p>
    <p class="wcm-confirm" id="wcm-confirm" hidden>
      <a id="wcm-confirm-link" href="#" target="_blank" rel="noopener">Check it on MyFantasyLeague &#8599;</a>
    </p>

    <div class="wcm-actions">
      <button type="button" id="wcm-cancel" class="wcm-btn wcm-btn--ghost">Cancel</button>
      <button type="button" id="wcm-submit" class="wcm-btn">Submit claim</button>
    </div>
  </div>
</dialog>

<script>
  import { applyPlayerModalBand } from '../../utils/player-modal-band';
  import { resumePendingClaim } from '../../utils/claim-resume';

  // `window.configureWaiverClaim` / `window.openWaiverClaim` are declared in
  // src/utils/player-claim-client.ts — one declaration, so the .ts callers and
  // this component cannot drift on the signature.

  /**
   * CLIENTROUTER-SAFE INIT (frontend.md, "Interactive scripts must re-init on
   * astro:page-load"). A component's module script is evaluated ONCE per
   * document, and ClientRouter swaps the DOM without re-evaluating it. Every
   * element below — and the config blob itself — therefore has to be re-read
   * inside init(), or after the first in-site navigation back onto Free Agents
   * they all point at the previous page's detached nodes and `dlg.showModal()`
   * opens a dialog that is not in the document. The Bid button silently does
   * nothing until a hard reload. That shipped; see
   * docs/claude/insights/features/waiver-claims.md.
   *
   * `document` is the one thing that SURVIVES the swap, so the delegated
   * `.claim-open` listener is the one thing that would stack — one more per
   * navigation. It is held here and removed before it is re-added, which gives
   * exactly one listener AND a closure over the live nodes. (A once-flag would
   * give one listener over DEAD nodes, which is the same bug wearing a hat.)
   */
  let onDocumentClick: ((e: MouseEvent) => void) | null = null;
  /**
   * The dialog element this module is currently wired to. Wiring is per DOM
   * INSTANCE, not per document: ClientRouter hands us a fresh dialog on every
   * navigation (init nulls this), while a deferred configure on the SAME page
   * must not stack a second submit listener on the same button.
   */
  let wiredDialog: HTMLDialogElement | null = null;

  /**
   * Build the form from a claim config and arm its triggers.
   *
   * Called either with the SSR config the free-agent pages inline, or later
   * with the one PlayerClaimBridge fetches from /api/claim-context — the
   * modal cannot tell the difference, and must not need to.
   */
  function wire(cfg: any) {
    const dlg = document.getElementById('waiver-claim-modal') as HTMLDialogElement | null;
    if (!dlg || wiredDialog === dlg) return;
    if (onDocumentClick) document.removeEventListener('click', onDocumentClick);
    onDocumentClick = null;
    wiredDialog = dlg;
    const band = document.getElementById('wcm-band');
    const nameEl = document.getElementById('wcm-player-name')!;
    const metaEl = document.getElementById('wcm-meta-text')!;
    const subEl = document.getElementById('wcm-sub-text')!;
    const logoEl = document.getElementById('wcm-nfl-logo') as HTMLImageElement;
    const bidField = document.getElementById('wcm-bid-field')!;
    const bidInput = document.getElementById('wcm-bid') as HTMLInputElement;
    const bidHint = document.getElementById('wcm-bid-hint')!;
    const dropSel = document.getElementById('wcm-drop') as HTMLSelectElement;
    const roundSel = document.getElementById('wcm-round') as HTMLSelectElement;
    const roundHint = document.getElementById('wcm-round-hint')!;
    const errBox = document.getElementById('wcm-error')!;
    const confirmBox = document.getElementById('wcm-confirm')!;
    const confirmLink = document.getElementById('wcm-confirm-link') as HTMLAnchorElement;
    /**
     * Offer MFL's own add/drop page, which lists the round's pending claims.
     * The owner asked for this: a filed claim is invisible on our side until
     * waivers process, so "it worked" should come with somewhere to go and see
     * it. The URL comes from the server (registry-derived per league) — never
     * built here, where it would be a hardcoded host.
     */
    const showConfirmLink = (url?: string) => {
      if (!url) { confirmBox.hidden = true; return; }
      confirmLink.href = url;
      confirmBox.hidden = false;
    };
    const submitBtn = document.getElementById('wcm-submit') as HTMLButtonElement;

    // FCFS adds resolve IMMEDIATELY at the league minimum — there is nothing to
    // bid and no round to file under. `unknown` falls back to the queued claim,
    // matching the server: a claim that bounces is recoverable, an unintended
    // instant pickup is not.
    const immediate = cfg.windowMode === 'fcfs';
    /** Sub-line under the player name; set below once the mode is known. */
    let subLine = '';
    const isBid = cfg.system === 'bbid' && !immediate;
    const money = (n: number) => '$' + Number(n).toLocaleString();

    // The window line is SSR-empty on every page that has no SSR config, so it
    // is written here rather than left to the template — otherwise the form
    // opens on a blank first line telling the owner nothing about the window
    // their claim would land in.
    const windowEl = document.getElementById('wcm-window');
    if (windowEl) windowEl.textContent = cfg.windowLabel ?? '';

    bidField.hidden = !isBid;
    (roundSel.closest('.wcm-field') as HTMLElement).hidden = immediate;
    if (isBid) {
      bidInput.min = String(cfg.rules.minimum);
      bidInput.step = String(cfg.rules.increment);
      bidHint.textContent =
        `Minimum ${money(cfg.rules.minimum)}, in ${money(cfg.rules.increment)} steps.` +
        (cfg.balance != null ? ` You have ${money(cfg.balance)} left.` : '');
    } else if (!immediate) {
      roundHint.textContent = 'Claims are awarded by waiver priority, not by bid.';
    }
    if (immediate) {
      subLine = cfg.system === 'bbid'
        ? `Free agent pickup at the league minimum (${money(cfg.rules.minimum)})`
        : 'Free agent pickup — first come, first served';
    }
    submitBtn.textContent = immediate ? 'Add player' : 'Submit claim';

    // Replace, never append: wire() is guarded to one call per dialog, but a
    // doubled drop list is a silent, awful bug and the reset costs nothing.
    dropSel.querySelectorAll('option[value]:not([value="0000"])').forEach((o) => o.remove());
    roundSel.replaceChildren();
    for (const p of cfg.roster) {
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.name;
      dropSel.appendChild(opt);
    }
    for (let r = 1; r <= cfg.rules.maxRounds; r++) {
      const opt = document.createElement('option');
      opt.value = String(r);
      opt.textContent = `Round ${r}`;
      roundSel.appendChild(opt);
    }

    let activeId: string | null = null;
    const showError = (msg: string) => {
      errBox.textContent = msg;
      errBox.hidden = !msg;
      confirmBox.hidden = true;
      errBox.classList.remove('wcm-error--warn');
    };
    /** Softer than an error: MFL took the write but we could not confirm it. */
    const showWarning = (msg: string) => {
      errBox.textContent = msg;
      errBox.hidden = !msg;
      errBox.classList.add('wcm-error--warn');
    };
    const reset = () => {
      submitBtn.disabled = false;
      submitBtn.textContent = immediate ? 'Add player' : 'Submit claim';
    };

    /**
     * Open the form on one player.
     *
     * The public entry point — `window.openWaiverClaim` — because the trigger
     * is no longer only a button in a table. The player modal offers the claim
     * from inside a dialog of its own, and the post-sign-in resume has nothing
     * to click at all; both need to say "open on this player" without
     * synthesising a DOM node for the delegated listener to find.
     */
    const openFor = (player: {
      id?: string | null; name?: string | null; position?: string | null;
      nflTeam?: string | null; espnId?: string | null; headshot?: string | null;
    }) => {
      activeId = player.id ?? null;
      const name = player.name || '';
      const pos = player.position || '';
      const team = player.nflTeam || '';

      nameEl.textContent = name;
      metaEl.textContent = [pos, team].filter(Boolean).join(' · ');
      subEl.textContent = subLine || (isBid ? 'Blind bid' : 'Waiver priority claim');
      logoEl.src = team ? `/assets/nfl/${team.toLowerCase()}.svg` : '';
      logoEl.style.display = team ? '' : 'none';

      // Same painter the player modals use — gradient, ghost wordmark, cutout.
      applyPlayerModalBand(band, {
        name,
        position: pos,
        nflTeam: team,
        espnId: player.espnId ?? null,
        headshot: player.headshot ?? null,
      });

      if (isBid) bidInput.value = String(cfg.rules.minimum);
      dropSel.value = '0000';
      showError('');
      reset();
      dlg.showModal();
    };
    window.openWaiverClaim = openFor;

    // The declarative trigger stays: any `.claim-open` element with
    // `data-claim-*` still opens the form, and it is delegated on `document`
    // so it survives a table re-rendered via innerHTML.
    onDocumentClick = (e) => {
      const btn = (e.target as HTMLElement)?.closest?.('.claim-open') as HTMLElement | null;
      if (!btn) return;
      openFor({
        id: btn.getAttribute('data-claim-id'),
        name: btn.getAttribute('data-claim-name'),
        position: btn.getAttribute('data-claim-pos'),
        nflTeam: btn.getAttribute('data-claim-team'),
        espnId: btn.getAttribute('data-claim-espn'),
        headshot: btn.getAttribute('data-claim-headshot'),
      });
    };
    document.addEventListener('click', onDocumentClick);

    document.getElementById('wcm-cancel')!.addEventListener('click', () => dlg.close());
    document.getElementById('wcm-close')!.addEventListener('click', () => dlg.close());

    submitBtn.addEventListener('click', async () => {
      // No player, no request. `openFor` is a public entry point now
      // (`window.openWaiverClaim`, and the declarative `.claim-open` path),
      // so a caller can open the form on a payload with no id — every caller
      // in the repo guards, but the one that does not would POST
      // `addPlayerId: null` and get a server error that says nothing useful.
      if (!activeId) {
        return showError('No player selected — close this and try again.');
      }
      const bid = isBid ? Number(bidInput.value) : undefined;
      if (isBid) {
        if (!Number.isFinite(bid!) || bid! < cfg.rules.minimum) {
          return showError(`Bid must be at least ${money(cfg.rules.minimum)}.`);
        }
        if (bid! % cfg.rules.increment !== 0) {
          return showError(`Bid must be a multiple of ${money(cfg.rules.increment)}.`);
        }
      }
      showError('');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';
      try {
        const res = await fetch('/api/waiver-claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            claims: [{ addPlayerId: activeId, ...(isBid ? { bid } : {}), dropPlayerId: dropSel.value }],
            round: Number(roundSel.value || 1),
            year: cfg.year,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          reset();
          return showError(data.message || `Claim failed (HTTP ${res.status}).`);
        }
        // `success` only means MFL acknowledged the write; `verified` means the
        // server read the claim back out of MFL afterwards. A checkmark on an
        // UNVERIFIED write is the whole bug this modal shipped with — the owner
        // is told it's filed, closes the tab, and nothing is on MFL. So show
        // the caveat and leave the modal open for them to act on.
        // Tell the claims panel on this page to re-read, BEFORE branching on
        // `verified`. A claim can land on MFL and still come back unverified —
        // the read-back is best-effort — so the unverified path is exactly when
        // a stale list is most misleading. The panel owns the refresh; this
        // only says something changed.
        //
        // The player id rides along: the player modal takes him out of its
        // claimable set on the strength of this, which is the only way it can
        // stop offering someone the viewer just claimed (MFL's rosters export
        // lags its own writes, so re-reading would still say "free agent").
        document.dispatchEvent(
          new CustomEvent('waiver-claims:changed', { detail: { playerId: activeId } }),
        );

        if (data.verified === false) {
          reset();
          showWarning(data.message || 'Submitted, but we could not confirm it with MFL.');
          // Especially here: we could not confirm, so hand them the page that can.
          return showConfirmLink(data.confirmUrl);
        }
        submitBtn.textContent = immediate ? 'Added ✓' : 'Submitted ✓';
        showConfirmLink(data.confirmUrl);
        // Long enough to read the confirmation and click through if they want
        // to; a filed claim is invisible on our side until waivers process.
        setTimeout(() => dlg.close(), data.confirmUrl ? 3200 : 900);
      } catch {
        reset();
        showError('Network error — your claim was not submitted.');
      }
    });
  }

  /**
   * Configure the modal after the fact, from a context fetched at runtime.
   *
   * This is what lets the player modal offer a claim on pages that never
   * computed a claim config at SSR time (rosters, the homepage, What's New).
   * A config that cannot claim is ignored rather than wired to nothing.
   */
  window.configureWaiverClaim = (cfg: any) => {
    if (cfg?.canClaim) wire(cfg);
  };

  function init() {
    // ALREADY WIRED TO THIS EXACT DOM → nothing here is stale, so leave it
    // alone. Not a micro-optimisation: init also runs when the form was
    // configured BEFORE this listener fired (the /api/claim-context path), and
    // tearing that wiring down and rebuilding it would leave two submit
    // listeners on one button — two POSTs, two claims. A ClientRouter
    // navigation swaps the dialog node, so the check fails there and the
    // teardown below runs as it must.
    if (wiredDialog && wiredDialog === document.getElementById('waiver-claim-modal')) return;

    // Drop the previous page's handler before building this page's — see above.
    if (onDocumentClick) document.removeEventListener('click', onDocumentClick);
    onDocumentClick = null;
    wiredDialog = null;
    // The opener closes over the PREVIOUS page's dialog. Drop it before this
    // page decides whether it has a claim form at all — a stale one would
    // showModal() on a detached node and do nothing, visibly.
    window.openWaiverClaim = undefined;

    const raw = document.getElementById('waiver-claim-config')?.textContent;
    const cfg = raw ? JSON.parse(raw) : null;

    if (cfg?.canClaim) wire(cfg);

    // The other half of the race publishContext() documents: on the pages with
    // no SSR config, /api/claim-context can land BEFORE this module evaluates,
    // in which case configureWaiverClaim did not exist to be called. The
    // context is parked on window for exactly that case.
    const parked = window.__playerClaimContext as { canClaim?: boolean } | undefined;
    if (!cfg?.canClaim && parked?.canClaim) wire(parked);

    // Did this page load come from the sign-in modal? If so, reopen the form on
    // the player they were trying to claim when we interrupted them.
    //
    // OUTSIDE the `canClaim` block on purpose. This call is also the only thing
    // that CLEARS the parked id, so gating it on claimability would leave the id
    // parked through every load that cannot use it — a visitor who dismisses the
    // sign-in dialog and signs in through the nav later would then get a claim
    // form they never asked for. Here it runs on every Free Agents load; with no
    // matching button the observer simply times out. See claim-resume.ts.
    //
    // LAST, because its first act is a synchronous click on the parked player's
    // button — the delegated handler above has to be wired before that lands.
    resumePendingClaim();
  }

  // Fires on the initial load too, so there is no separate first-run call to
  // double up with.
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* Layout mirrors .cdm-band so the action modals cannot drift. .pmb paints
     the gradient, ghost wordmark, glow, crest and cutout. */
  .wcm {
    padding: 0;
    border: none;
    border-radius: var(--radius-md, 0.5rem);
    max-width: 26rem;
    width: calc(100% - 2rem);
    overflow: hidden;
    background: var(--content-bg, #ffffff);
    color: var(--color-gray-900, #111827);
  }
  .wcm::backdrop { background: rgb(0 0 0 / 0.55); }

  .wcm-band {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 108px;
    padding: 1.1rem 1.5rem 1rem 1.75rem;
  }
  .wcm-band__info {
    position: relative;
    z-index: 2;
    flex: 1;
    min-width: 0;
    padding-right: clamp(88px, 30%, 170px);
  }
  .wcm-band.pmb--no-cutout .wcm-band__info { padding-right: 2.25rem; }
  .wcm-band__name-row { display: flex; align-items: baseline; gap: 0.5rem; }
  .wcm-band__name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }
  .wcm-band__meta { display: flex; align-items: center; gap: 0.4rem; margin-top: 0.2rem; }
  .wcm-band__team-logo { width: 18px; height: 18px; object-fit: contain; }
  .wcm-band__meta-text,
  .wcm-band__sub {
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.85);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }
  .wcm-band__sub { margin-top: 0.15rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .wcm-close {
    position: relative;
    z-index: 3;
    align-self: flex-start;
    background: none;
    border: none;
    color: rgb(255 255 255 / 0.85);
    cursor: pointer;
    padding: 0.25rem;
  }
  .wcm-close:hover { color: #fff; }

  .wcm-body { padding: 1rem 1.25rem 1.25rem; }
  .wcm-field + .wcm-field { margin-top: 0.85rem; }
  .wcm-field label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--content-text-muted, #6b7280);
    margin-bottom: 0.3rem;
  }
  .wcm-field input,
  .wcm-field select {
    width: 100%;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--input-border, #d1d5db);
    border-radius: var(--radius-sm, 0.375rem);
    background: var(--input-bg, #ffffff);
    color: var(--input-text, #111827);
  }
  .wcm-window {
    margin: 0 0 0.9rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm, 0.375rem);
    background: var(--color-gray-100, #f3f4f6);
    color: var(--content-text-muted, #6b7280);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .wcm-hint { margin: 0.3rem 0 0; font-size: 0.72rem; color: var(--content-text-muted, #6b7280); }
  .wcm-error { margin: 0.9rem 0 0; font-size: 0.8rem; color: var(--color-error, #b91c1c); }
  /* "MFL took it but we could not confirm it" — a caution, not a rejection.
     `--color-warning-dark`, not `--color-warning`: the plain token is #f59e0b
     amber, which is unreadable at 0.8rem on the light modal. The -dark variant
     is defined in BOTH tokens.css (#d97706) and tokens-dark.css (#fcd34d), so
     it reads correctly in each theme. */
  .wcm-error--warn { color: var(--color-warning-dark, #b45309); }
  .wcm-confirm { margin: 0.6rem 0 0; font-size: 0.8rem; }
  .wcm-confirm a {
    color: var(--league-accent, var(--color-primary, #1c497c));
    font-weight: 600;
    text-decoration: underline;
  }
  .wcm-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1.1rem; }
  .wcm-btn {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm, 0.375rem);
    border: 1px solid transparent;
    background: var(--color-primary, #1c497c);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .wcm-btn[disabled] { opacity: 0.6; cursor: default; }
  .wcm-btn--ghost {
    background: transparent;
