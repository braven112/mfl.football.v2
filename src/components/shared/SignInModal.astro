---
/**
 * SignInModal — sign in without leaving the page you came to use.
 *
 * REPLACES A DEEP-LINK TO MFL. The Free Agents pages used to hand a signed-out
 * visitor an "Add ↗" link straight to MyFantasyLeague's add/drop page, which
 * ended their visit here and dropped them into a UI this site exists to
 * replace. This is the same MFL login (the credentials go to /api/auth/login,
 * which authenticates against MFL and mints our session), but the visitor
 * lands back on the page — and on the player — they started from.
 *
 * WHY IT RELOADS RATHER THAN JUST HIDING THE DIALOG. Whether an owner may
 * claim is decided in SSR frontmatter (franchise, roster, conference, waiver
 * window), and the Claim/Bid column isn't in the DOM at all for a signed-out
 * visitor. A reload is what makes the buttons exist; LoginForm's `redirectUrl`
 * carries the current path so it is a reload, not a bounce to a league home.
 *
 * RESUMING THE PLAYER. A trigger may carry `data-signin-player="<mflId>"`,
 * which we park via `rememberPendingClaim`. The matching read runs in
 * WaiverClaimModal after the reload — the two halves cannot share a component,
 * because this one only renders for a signed-out visitor and that one only
 * once they can claim. See src/utils/claim-resume.ts.
 */
import LoginForm from '../theleague/LoginForm.astro';

export interface SignInModalConfig {
  /** MFL league id to authenticate against — from the registry, never a literal. */
  leagueId: string;
  /** Season year override forwarded to MFL (the AFL needs one; see LoginForm). */
  seasonYear?: number | string;
  /** Where to land after a successful sign-in. Defaults to the current URL. */
  redirectUrl: string;
  logoSrc?: string;
  logoAlt?: string;
  subtitle?: string;
}

interface Props {
  config: SignInModalConfig;
}
const { config } = Astro.props;
---

<dialog id="signin-modal" class="sim" aria-label="Sign in">
  <button type="button" class="sim-close" id="sim-close" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M14 4L4 14M4 4l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="sim-body">
    <LoginForm
      compact
      leagueId={config.leagueId}
      seasonYear={config.seasonYear}
      redirectUrl={config.redirectUrl}
      logoSrc={config.logoSrc}
      logoAlt={config.logoAlt}
      subtitle={config.subtitle}
    />
  </div>
</dialog>

<script>
  import { rememberPendingClaim } from '../../utils/claim-resume';

  /**
   * CLIENTROUTER-SAFE INIT — same shape as WaiverPriorityModal, same reason
   * (frontend.md, "Interactive scripts must re-init on astro:page-load"). The
   * module is evaluated once per document; ClientRouter swaps the DOM without
   * re-evaluating it, so a `dlg` captured at module scope points at a detached
   * dialog after the first in-site navigation and `showModal()` shows nothing.
   * Elements are re-resolved per page load; the delegated document listener,
   * which would stack, goes on once behind a module-scoped flag.
   */
  let wired = false;
  let dialog: HTMLDialogElement | null = null;

  /**
   * Closing without signing in is an explicit abandon, so drop the parked
   * player rather than leaving it for some later load to consume. Only the
   * deliberate dismissals (close button, backdrop) — NOT the dialog's `close`
   * event, which also fires on the success path as LoginForm navigates away and
   * would clear the very id the reload is meant to pick up.
   */
  const abandonPendingClaim = () => rememberPendingClaim(null);

  const onDocumentClick = (e: MouseEvent) => {
    const trigger = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-signin-open]');
    if (!trigger || !dialog) return;
    e.preventDefault();

    // The other half of this runs in WaiverClaimModal, after the reload — see
    // src/utils/claim-resume.ts for why they can't live together.
    rememberPendingClaim(trigger.getAttribute('data-signin-player'));

    if (!dialog.open) dialog.showModal();
    // Focus the username field so a keyboard user can start typing.
    (dialog.querySelector('[autocomplete="username"]') as HTMLInputElement | null)?.focus();
  };

  function init() {
    dialog = document.getElementById('signin-modal') as HTMLDialogElement | null;
    if (!dialog) return;
    const dlg = dialog;

    // New nodes after every swap, so these cannot stack.
    document.getElementById('sim-close')?.addEventListener('click', () => {
      abandonPendingClaim();
      dlg.close();
    });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) {
        abandonPendingClaim();
        dlg.close();
      }
    });

    // Escape closes a <dialog> through `cancel`, which neither click path
    // above sees — so without this an Escape-dismissed sign-in leaves the
    // player parked. `cancel` is the right event rather than `close`: `close`
    // also fires on the success path while LoginForm navigates away, and would
    // drop the very id the reload is meant to pick up.
    dlg.addEventListener('cancel', abandonPendingClaim);

    if (!wired) {
      wired = true;
      document.addEventListener('click', onDocumentClick);
    }
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .sim {
    position: relative;
    padding: 0;
    border: none;
    border-radius: var(--radius-md, 0.5rem);
    max-width: 24rem;
    width: calc(100% - 2rem);
    background: var(--content-bg, #ffffff);
    color: var(--color-gray-900, #111827);
  }
  .sim::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(2px);
  }
  .sim-body { padding: 1.25rem 1.25rem 1.4rem; }
  .sim-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    background: none;
    border: none;
    color: var(--content-text-muted, #6b7280);
    cursor: pointer;
    padding: 0.25rem;
    line-height: 0;
  }
  .sim-close:hover { color: var(--color-gray-900, #111827); }
</style>
