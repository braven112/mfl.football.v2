---
/**
 * The shared franchises index: every club as a card (career record, seasons,
 * points), grouped as the league groups them, then the former identities
 * strip. Moved out of the AFL's page — the repeatable one (the owner's call,
 * Oct 2026; TheLeague's stays its own). The AFL and package leagues with the
 * Franchise pages box render it.
 *
 * A league hands in its groups (the AFL's two conferences; a package league's
 * divisions), each card's numbers already computed from its own record source,
 * and optionally `CardBadges` — the AFL's title badges, its own competition,
 * rendered by its own component with its own styles.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { teamAccentVar } from '../../../utils/team-accent-css';
import RelatedPagesCard from '../RelatedPagesCard.astro';

export interface FranchiseCardRow {
  team: { franchiseId: string; name: string; nameMedium?: string; icon?: string };
  record: string;
  pct: string;
  seasons: number;
  points: number;
  /** The line under the name, e.g. "North Division · Premier League". */
  subtitle: string;
  /** Passed through to `CardBadges`. */
  titles?: unknown;
}

interface Props {
  leagueSlug: string;
  title: string;
  heading: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  lede: string;
  notes: string[];
  groups: Array<{ name: string; rows: FranchiseCardRow[] }>;
  CardBadges?: any;
  historicalIdentities: Array<{ name: string; icon?: string; yearStart: number; yearEnd: number }>;
  identityHref: (identity: any) => string;
}

const { leagueSlug, title, heading, breadcrumbs, lede, notes, groups, CardBadges, historicalIdentities, identityHref } =
  Astro.props;
---

<TheLeagueLayout title={title}>
  <div class="franchises-page">
    <header>
      <Breadcrumbs items={breadcrumbs} />
      <h1>{heading}</h1>
      <p class="lede">{lede}</p>
      {notes.map((note) => (
        <p class="points-note">{note}</p>
      ))}
    </header>

    {groups.map((conf) => (
      <section class="conference-section">
        <h2 class="conference-title">
          {conf.name}
          <span class="conference-count">{conf.rows.length} teams</span>
        </h2>
        <div class="franchise-grid">
          {conf.rows.map(({ team, record, pct, seasons, points, subtitle, titles }) => (
            <a
              class="franchise-card"
              href={`/${leagueSlug}/franchises/${team.franchiseId}`}
              style={`--accent: ${teamAccentVar(team.franchiseId, 'var(--league-accent, #c41e3a)')};`}
            >
              <div class="card-body">
                <div class="lockup">
                  <img
                    class="lockup-icon"
                    src={team.icon}
                    alt=""
                    loading="lazy"
                    width="64"
                    height="64"
                  />
                  <div class="lockup-text">
                    <h3 class="name">{team.nameMedium || team.name}</h3>
                    <p class="division">{subtitle}</p>
                  </div>
                </div>
                <dl class="stats">
                  <div>
                    <dt>All-Time</dt>
                    <dd>{record} <span class="dim">({pct})</span></dd>
                  </div>
                  <div>
                    <dt>Seasons</dt>
                    <dd>{seasons}</dd>
                  </div>
                  <div>
                    <dt>Points</dt>
                    <dd>{Math.round(points).toLocaleString()}</dd>
                  </div>
                </dl>
                {CardBadges && <CardBadges team={team} titles={titles} />}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    {historicalIdentities.length > 0 && (
      <section class="historical-identities">
        <h2>Former Identities</h2>
        <p class="historical-identities__sub">
          Every name these clubs have played under — punitive last-place
          rebrands included. Each links to the owner who ran it.
        </p>
        <ul class="identity-list">
          {historicalIdentities.map((h) => (
            <li>
              <a href={identityHref(h)}>
                {h.icon && <img class="identity-icon" src={h.icon} alt="" loading="lazy" width="32" height="32" />}
                <strong>{h.name}</strong>
                <span class="identity-years">{h.yearStart === h.yearEnd ? h.yearStart : `${h.yearStart}–${h.yearEnd}`}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <RelatedPagesCard hostPath="/franchises" leagueSlug={leagueSlug} />
  </div>
</TheLeagueLayout>

<style>
  .franchises-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl, 32px) var(--spacing-md, 16px) var(--spacing-2xl, 48px);
  }

  header {
    margin-bottom: var(--spacing-xl, 32px);
  }

  h1 {
    margin: 0.25rem 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--page-text, #1a1a1a);
  }

  .lede {
    margin: 0;
    color: var(--content-text-muted, #6b7280);
    max-width: 60ch;
  }

  .points-note {
    margin: var(--spacing-sm, 8px) 0 0;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
  }

  .conference-section {
    margin-bottom: var(--spacing-2xl, 48px);
  }

  .conference-title {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-lg, 24px);
    display: flex;
    align-items: center;
    gap: var(--spacing-md, 16px);
    padding-bottom: var(--spacing-sm, 8px);
    border-bottom: 2px solid var(--content-border, #e5e7eb);
    color: var(--league-accent, #c41e3a);
  }

  .conference-count {
    font-size: var(--font-size-sm);
    font-weight: 400;
    color: var(--content-text-muted, #6b7280);
  }

  .franchise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-md, 16px);
  }

  .franchise-card {
    --accent: var(--league-accent, #c41e3a);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .card-body {
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e5e7eb);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  :global(html.dark) .card-body {
    box-shadow: 0 0 0 1px var(--content-border, #555);
  }

  .franchise-card:hover .card-body {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lockup-icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .lockup-text {
    min-width: 0;
  }

  .name {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.2;
    color: var(--page-text, #1a1a1a);
  }

  .division {
    margin: 0.125rem 0 0;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted, #6b7280);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stats dt {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--content-text-muted, #6b7280);
    font-weight: 600;
  }

  .stats dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--page-text, inherit);
  }

  .dim {
    color: var(--content-text-muted, #6b7280);
    font-weight: 400;
  }

  .historical-identities {
    margin-top: var(--spacing-2xl, 48px);
    padding-top: var(--spacing-lg, 24px);
    border-top: 1px solid var(--content-border, #e5e7eb);
  }

  .historical-identities h2 {
    margin: 0 0 0.25rem;
    /* AFL editorial section title — 0.9rem (UFC Sans Condensed compensation) */
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-left: 0.625rem;
    border-left: 2px solid var(--league-accent, #c41e3a);
    color: var(--page-text, #111827);
  }

  .historical-identities__sub {
    margin: var(--spacing-sm, 8px) 0 var(--spacing-md, 16px);
    padding-left: 0.625rem;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
    max-width: 60ch;
  }

  .identity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
  }

  .identity-list a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e5e7eb);
    text-decoration: none;
    color: var(--page-text, #111827);
    font-size: var(--font-size-sm);
  }

  .identity-list a:hover {
    border-color: var(--league-accent, #c41e3a);
  }

  .identity-list a strong {
    flex: 1;
    min-width: 0;
    /* break-word (not anywhere) — anywhere collapses the flex item to
       min-content and splits AFL's long names mid-word */
    overflow-wrap: break-word;
  }

  .identity-list .identity-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--content-bg, #fff);
  }

  .identity-years {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--content-text-muted, #6b7280);
    font-variant-numeric: tabular-nums;
  }
</style>
