---
/**
 * "Previous owners of this franchise" — the link back from a franchise slot to
 * the people whose seasons that slot no longer shows.
 *
 * Franchise pages are owner-scoped: `attributeYear()` drops any season
 * belonging to a previous owner, which is correct (Midwestside's owner should
 * not inherit the Warlocks' record) but left 110 franchise-seasons in
 * TheLeague and 230 in the AFL reachable from no page at all. This section is
 * the destination — from the slot they were played on.
 *
 * SHARED on purpose. The AFL grew a prior-owner list months before TheLeague
 * did, as a flat unlinked strip of names; TheLeague had none. Two copies of
 * "who used to own this slot" is exactly the drift the owners feature exists
 * to reduce, so both leagues render this one.
 *
 * Astro scoped CSS does not cross into a child component, so every rule this
 * markup needs lives at the bottom of THIS file — see EraSeasonTable's trap-4
 * note. Nothing here relies on the host page's styles.
 */
import { getLeagueBySlug, type CanonicalLeagueSlug } from '../../../config/leagues';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import type { Owner, OwnerTenuresFile } from '../../../types/owner-tenures';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** The slot whose history to show. */
  franchiseId: string;
  data: OwnerTenuresFile;
  /** Heading level, so a page can nest this under its own h2. */
  headingLevel?: 'h2' | 'h3';
}

const { leagueSlug, franchiseId, data, headingLevel = 'h2' } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);

const bySlug = new Map((data.owners as Owner[]).map((o) => [o.slug, o]));

/**
 * The owner whose page this franchise page effectively already is — the one
 * still holding the slot. Listing them under "previous owners" would be wrong
 * twice over: they haven't left, and their seasons are the ones already on
 * screen above.
 *
 * Keyed on `currentFranchiseId`, never on position in `bySlot`: an owner who
 * MOVED slots is current somewhere else, and reading the last entry of this
 * slot's list would show them as still holding a slot they left.
 */
const isStillHere = (owner: Owner) =>
  owner.isCurrent && owner.currentFranchiseId === franchiseId;

const formatRecord = (w: number, l: number, t: number) => (t > 0 ? `${w}-${l}-${t}` : `${w}-${l}`);

/**
 * One row per HOLDING, not per owner.
 *
 * `bySlot` lists one slug per OWNER, and a shared team is held by two people
 * who wear the same identities and the same record — so walking it directly
 * renders a co-owned tenure twice, as two identical rows. `owner-tenures.mjs`
 * collapses co-owners into a single holding for `slotSuccession` for exactly
 * this reason; this does the same for display, and names both people on the
 * one row. Not reachable today (the only shared holding is current, so
 * `isStillHere` filters it), but it is one handover away from being the
 * first thing anyone notices on that franchise's page.
 */
const seenSlugs = new Set<string>();

/** Newest first — the reader is walking backwards from the team they know. */
const entries = (data.bySlot[franchiseId] ?? [])
  .map((slug) => bySlug.get(slug))
  .filter((owner): owner is Owner => Boolean(owner) && !isStillHere(owner as Owner))
  .filter((owner) => {
    if (seenSlugs.has(owner.slug)) return false;
    seenSlugs.add(owner.slug);
    for (const co of owner.coOwners ?? []) seenSlugs.add(co.slug);
    return true;
  })
  .map((owner) => {
    const tenure = owner.tenures.find((t) => t.franchiseId === franchiseId);
    // Every slug in bySlot[franchiseId] has a tenure on it by construction, but
    // a hand-edited registry could break that; skip rather than throw in a page.
    if (!tenure) return null;

    // Seasons actually PLAYED. A preseason row is 0-0-0 with no points — it is
    // a row, not a season, and counting rows put "11 seasons" beside the same
    // franchise's own "10 seasons" once already (see EraSeasonTable).
    const played = tenure.seasons.filter((s) => s.wins || s.losses || s.ties || s.pointsFor);
    const record = played.reduce(
      (acc, s) => ({ w: acc.w + s.wins, l: acc.l + s.losses, t: acc.t + s.ties }),
      { w: 0, l: 0, t: 0 }
    );

    // Trophies are scoped to THIS tenure's years, not the owner's career: an
    // owner who also ran another slot must not show that slot's ring here.
    const years = new Set(played.map((s) => s.year));
    const inTenure = (list: number[]) => list.filter((y) => years.has(y)).length;
    const titles = inTenure(owner.totals.championships);
    const divisions = owner.totals.divisionTitles.filter((d) => years.has(d.year)).length;

    // Co-owners of this same tenure, folded into this row by the filter above.
    // Named here so a shared team reads as two people, not as one arbitrary
    // winner of a dedupe — their own page carries the reciprocal link.
    const coOwnerNames = (owner.coOwners ?? [])
      .map((co) => co.displayName ?? co.title)
      .filter(Boolean) as string[];

    // The 💀 tag the AFL's franchise page has always shown for a last-place
    // rename. It is per-IDENTITY, not per-tenure: an owner punished for one
    // season keeps their ordinary name for the rest of the stint.
    const punitiveNames = tenure.identities
      .filter((identity) => identity.punitive)
      .map((identity) => identity.name)
      .filter(Boolean) as string[];

    return {
      slug: owner.slug,
      href: r(`/owners/${owner.slug}`),
      title: owner.displayName ?? owner.title,
      coOwnerNames,
      punitiveNames,
      icon: tenure.identities[0]?.icon ?? owner.icon,
      years:
        tenure.yearStart === tenure.yearEnd
          ? String(tenure.yearStart)
          : `${tenure.yearStart}–${tenure.yearEnd}`,
      seasons: played.length,
      record: played.length ? formatRecord(record.w, record.l, record.t) : null,
      titles,
      divisions,
      /** They still own a team, just not this one — worth saying. */
      movedOn: owner.isCurrent,
    };
  })
  .filter((e): e is NonNullable<typeof e> => e !== null)
  .reverse();

const Heading = headingLevel;
---

{entries.length > 0 && (
  <div class="previous-owners">
    <Heading>Previous owners of this franchise</Heading>
    <p class="previous-owners__sub">
      Their seasons are credited to them, not to this team — which is why they
      aren't in the record above.
    </p>
    <ul class="previous-owners__list">
      {entries.map((entry) => (
        <li class="previous-owners__item">
          <a class="previous-owners__link" href={entry.href}>
            {entry.icon && (
              <img class="previous-owners__icon" src={entry.icon} alt="" loading="lazy" width="40" height="40" />
            )}
            <span class="previous-owners__text">
              <span class="previous-owners__name">
                {entry.title}
                {entry.movedOn && <span class="previous-owners__tag">still in the league</span>}
                {entry.punitiveNames.map((name) => (
                  <span class="previous-owners__tag previous-owners__tag--rebrand" title={`Punitive last-place rename: ${name}`}>
                    💀 Last-Place Rebrand
                  </span>
                ))}
              </span>
              {entry.coOwnerNames.length > 0 && (
                <span class="previous-owners__co">
                  Co-owned with {entry.coOwnerNames.join(' and ')}
                </span>
              )}
              <span class="previous-owners__meta">
                {entry.years}
                {entry.record && <> · {entry.record}</>}
                {entry.seasons > 0 && <> · {entry.seasons} season{entry.seasons === 1 ? '' : 's'}</>}
              </span>
            </span>
            <span class="previous-owners__trophies">
              {entry.titles > 0 && <span class="previous-owners__trophy" title={`${entry.titles} championship${entry.titles === 1 ? '' : 's'}`}>🏆 {entry.titles}</span>}
              {entry.divisions > 0 && <span class="previous-owners__trophy" title={`${entry.divisions} division title${entry.divisions === 1 ? '' : 's'}`}>🛡 {entry.divisions}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .previous-owners {
    margin-top: var(--spacing-lg, 24px);
  }

  .previous-owners h2,
  .previous-owners h3 {
    margin: 0 0 var(--spacing-xs, 8px);
    font-size: 1.05rem;
    color: var(--color-gray-900);
  }

  .previous-owners__sub {
    margin: 0 0 var(--spacing-md, 16px);
    font-size: 0.85rem;
    color: var(--content-text-muted, #666);
  }

  .previous-owners__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-xs, 8px);
  }

  .previous-owners__link {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm, 12px);
    padding: var(--spacing-sm, 12px);
    border: 1px solid var(--content-border, #e5e5e5);
    border-radius: var(--radius-md, 8px);
    background: var(--card-bg, #fff);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .previous-owners__link:hover,
  .previous-owners__link:focus-visible {
    border-color: var(--content-text-muted, #999);
    transform: translateY(-1px);
  }

  .previous-owners__icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .previous-owners__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .previous-owners__name {
    font-weight: 600;
    color: var(--color-gray-900);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs, 8px);
    flex-wrap: wrap;
  }

  .previous-owners__tag {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border-radius: var(--radius-sm, 4px);
    background: var(--content-bg-muted, #f0f0f0);
    color: var(--content-text-muted, #555);
  }

  .previous-owners__meta {
    font-size: 0.82rem;
    color: var(--content-text-muted, #666);
  }

  .previous-owners__co {
    font-size: 0.78rem;
    color: var(--content-text-muted, #666);
  }

  /* Deliberately louder than the neutral tag beside it — a last-place rename
     is a punishment the league wants visible, not a footnote. */
  .previous-owners__tag--rebrand {
    background: var(--content-bg-muted, #f0f0f0);
    text-transform: none;
    letter-spacing: 0;
  }

  .previous-owners__trophies {
    display: flex;
    gap: var(--spacing-xs, 8px);
    flex-shrink: 0;
  }

  .previous-owners__trophy {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--content-text-muted, #555);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .previous-owners__link {
      flex-wrap: wrap;
    }
  }
</style>
