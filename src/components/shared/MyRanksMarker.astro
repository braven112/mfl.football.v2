---
/**
 * Tells the client which league's "My Rank" to load
 * (src/utils/my-ranks-client.ts). Every viewer gets the default board
 * (/api/default-ranks, FantasySharks); the site owner's session also carries
 * `data-owner`, which switches it to his own ranks from /api/my-ranks
 * (private, no-store). The ranks never ride in this HTML, so a cached page
 * can't carry them, and nobody else's page hints that a private board exists.
 *
 * Its only visible state is the owner's fallback notice, shown by the client
 * when his board can't load and the page falls back to the default.
 */
import { BOARD_KEY_BY_SLUG } from '../../utils/private-rankings';
import { isSiteOwnerIn } from '../../utils/site-owner';
import type { AuthUser } from '../../utils/auth';

interface Props {
  user: AuthUser | null;
  slug: string;
}
const { user, slug } = Astro.props;
const owner = Boolean(BOARD_KEY_BY_SLUG[slug]) && isSiteOwnerIn(user, slug);
---
{owner ? (
  <p class="my-ranks-notice" role="status" data-my-ranks data-league={slug} data-owner hidden>
    Your rankings board couldn't load, so My Rank shows the default for now.
  </p>
) : (
  <span data-my-ranks data-league={slug} hidden></span>
)}
<style>
  .my-ranks-notice {
    margin: 0.5rem auto;
    max-width: 60rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: var(--font-size-sm);
    color: var(--content-text-muted);
    background: var(--content-bg-muted);
  }
  .my-ranks-notice[hidden] {
    display: none;
  }
</style>
