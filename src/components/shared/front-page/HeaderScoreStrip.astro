---
/**
 * The front-page style's score strip, at the very top of EVERY page of a
 * league on that style (Header.astro renders it). It reads the league's own
 * schedule and standings, so it resolves its data here rather than from the
 * route: the layout serves every page and no route can hand it a glob.
 *
 * The globs are league-wildcards because a shared component cannot name a
 * league; each page's own globs already bundle the same files. A league with
 * no config or no schedule yet renders nothing.
 */
import ScoreStrip from './ScoreStrip.astro';
import type { FrontTeamArt } from './types';
import { getLeagueBySlug } from '../../../config/leagues';
import { packageLeagueHasPath } from '../../../config/package-league-routes.mjs';
import { getAuthUser, franchiseIdForLeague } from '../../../utils/auth';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { parseTestDate } from '../../../utils/hero-resolver';
import { loadSeasonFeed, resolveSeason, seasonsFromGlob, unwrapFeedModule, type LazyFeedGlob } from '../../../utils/mfl-feed-glob';
import { groupStandingsByDivision, type PackageDivision, type PackageTeam } from '../../../utils/package-league';
import { parseWeeklySchedule } from '../../../utils/schedule-data.mjs';
import { buildScoreStrip, type ParsedWeek } from '../../../utils/front-page';
import { frontTeamArt } from '../../../utils/front-page-art';
import { franchiseSlug, leagueHasBrandBook } from '../../../utils/franchise-marks';
import { resolveLeaguePath } from '../../../utils/nav-utils';

interface Props {
  leagueSlug: string;
  hideLeaguePrefix: boolean;
}

const { leagueSlug, hideLeaguePrefix } = Astro.props;
const league = getLeagueBySlug(leagueSlug);

const ALL_SCHEDULES = import.meta.glob('../../../../data/*/mfl-feeds/*/schedule.json');
const ALL_STANDINGS = import.meta.glob('../../../../data/*/mfl-feeds/*/standings.json');
const ALL_CONFIGS = import.meta.glob('../../../../data/*/*.config.json');
const forLeague = (glob: LazyFeedGlob): LazyFeedGlob =>
  Object.fromEntries(Object.entries(glob).filter(([path]) => path.includes(`/data/${leagueSlug}/`)));

let strip = null as ReturnType<typeof buildScoreStrip>;
const teams: Record<string, FrontTeamArt> = {};
let allHref: string | null = null;

const configLoader = Object.entries(forLeague(ALL_CONFIGS))[0]?.[1];
const config = configLoader
  ? (unwrapFeedModule(await configLoader().catch(() => null)) as { teams?: PackageTeam[]; divisions?: PackageDivision[] } | null)
  : null;

if (league && config?.teams?.length) {
  const r = (p: string) => resolveLeaguePath(p, hideLeaguePrefix);
  const base = `/${league.slug}`;
  const now = parseTestDate(Astro.url.searchParams.get('testDate')) ?? new Date();
  const seasonYear = getCurrentSeasonYear(now);
  const schedules = forLeague(ALL_SCHEDULES);
  const standings = forLeague(ALL_STANDINGS);
  const scheduleYear = resolveSeason(null, seasonsFromGlob(schedules), seasonYear);
  const standingYear = resolveSeason(null, seasonsFromGlob(standings), seasonYear);
  const [scheduleFeed, standingsFeed] = await Promise.all([
    scheduleYear ? loadSeasonFeed(schedules, scheduleYear) : null,
    standingYear ? loadSeasonFeed(standings, standingYear) : null,
  ]);

  const byId = Object.fromEntries(config.teams.map((t) => [t.franchiseId, t]));
  const rows = new Map(
    groupStandingsByDivision(standingsFeed, config.teams, config.divisions ?? []).flatMap((g) =>
      g.rows.map((row) => [row.franchiseId, row] as const),
    ),
  );
  const mine = franchiseIdForLeague(getAuthUser(Astro.request), league.id);
  strip = buildScoreStrip({
    weeks: parseWeeklySchedule(scheduleFeed) as ParsedWeek[],
    mine,
    divisionOf: (id) => byId[id]?.divisionId,
    winsOf: (id) => rows.get(id)?.wins ?? 0,
  });

  const teamHref = (id: string) =>
    leagueHasBrandBook(league.slug) && byId[id]
      ? r(`${base}/brand/${franchiseSlug(byId[id])}`)
      : r(`${base}/rosters?franchise=${id}`);
  for (const g of strip?.games ?? []) {
    for (const s of g.sides) {
      if (byId[s.franchiseId] && !teams[s.franchiseId]) {
        teams[s.franchiseId] = frontTeamArt(byId[s.franchiseId], league.slug, teamHref(s.franchiseId), rows.get(s.franchiseId)?.record);
      }
    }
  }
  const hasPage = (p: string) => packageLeagueHasPath(league, p);
  allHref = hasPage('/live-scoring') ? r(`${base}/live-scoring`) : hasPage('/standings') ? r(`${base}/standings`) : null;
}
---

{strip && strip.games.length > 0 && <ScoreStrip strip={strip} teams={teams} allHref={allHref} variant="bar" />}
