---
/**
 * "Top headlines": the list beside the lead story, every line marked with the
 * crest of the team it is about (MLB's Latest News idiom). Pinned stories —
 * the viewer's weekly rivalry, two in a doubleheader — sit first, tinted.
 * A move carries a second link to its official record.
 */
import ThemeImage from '../ThemeImage.astro';
import type { FrontStory } from '../../../utils/front-page';
import type { FrontTeamArt } from './types';

interface Props {
  stories: FrontStory[];
  teams: Record<string, FrontTeamArt>;
  /** The league's mark in both cuts: the list's card follows the theme. */
  leagueMark: { light: string; dark: string };
  /** Each story's day, already in the viewer's clock. */
  times: Record<string, { day: string }>;
}

const { stories, teams, leagueMark, times } = Astro.props;
---

<section class="fp-heads" aria-labelledby="fp-heads-title">
  <h2 id="fp-heads-title" class="fp-section-title">Top headlines</h2>
  {stories.length === 0 ? (
    <p class="fp-heads__empty">Headlines land here as the week's stories are written.</p>
  ) : (
    <ul class="fp-heads__list">
      {stories.map((s) => {
        const marks = s.franchiseIds.map((id) => teams[id]).filter(Boolean).slice(0, s.kind === 'rivalry' ? 2 : 1);
        return (
          <li class:list={['fp-heads__item', { 'fp-heads__item--pinned': s.pinned }]}>
            <span class="fp-heads__marks" aria-hidden="true">
              {marks.length > 0 ? (
                marks.map((t) => <img class:list={['fp-heads__mark', { 'fp-heads__mark--round': t.round }]} src={t.icon} alt="" width="28" height="28" loading="lazy" decoding="async" />)
              ) : (
                <ThemeImage class="fp-heads__mark" src={leagueMark.light} darkSrc={leagueMark.dark} alt="" width="28" height="28" />
              )}
            </span>
            <span class="fp-heads__body">
              {s.href ? <a class="fp-heads__headline" href={s.href}>{s.headline}</a> : <span class="fp-heads__headline">{s.headline}</span>}
              <span class="fp-heads__meta">
                <span class="fp-heads__kicker">{s.kicker}</span>
                {times[s.id] && <span> · {times[s.id].day}</span>}
                {s.action && <a class="fp-heads__action" href={s.action.href}>{s.action.label} ▸</a>}
              </span>
            </span>
          </li>
        );
      })}
    </ul>
  )}
</section>

<style>
  .fp-heads {
    background: var(--card-bg);
    border: 1px solid var(--content-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1rem 0.4rem;
    min-width: 0;
  }
  .fp-heads__empty { margin: 0 0 0.6rem; color: var(--content-text-muted); font-size: var(--font-size-sm); }
  .fp-heads__list { list-style: none; margin: 0; padding: 0; }
  .fp-heads__item {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.6rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--content-border);
  }
  .fp-heads__item:first-child { border-top: 0; }
  .fp-heads__item--pinned {
    margin: 0 -1rem;
    padding: 0.65rem 1rem;
    background: var(--content-bg-muted);
    border-left: 4px solid var(--league-accent);
  }
  .fp-heads__marks { display: flex; align-items: flex-start; }
  .fp-heads__mark { width: 1.75rem; height: 1.75rem; object-fit: contain; flex: none; }
  .fp-heads__mark + .fp-heads__mark { margin-left: -0.7rem; }
  .fp-heads__mark--round { border-radius: var(--radius-full); object-fit: cover; }
  .fp-heads__body { display: grid; gap: 0.2rem; min-width: 0; }
  .fp-heads__headline {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    line-height: 1.3;
    color: var(--page-text);
    text-decoration: none;
    text-wrap: pretty;
  }
  a.fp-heads__headline:hover { color: var(--page-text); text-decoration: underline; }
  .fp-heads__meta { font-size: var(--font-size-3xs); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--content-text-muted); }
  .fp-heads__kicker { color: var(--league-accent-fg, var(--league-accent)); font-weight: var(--font-weight-semibold); }
  .fp-heads__action { margin-left: 0.5rem; color: var(--page-text); font-weight: var(--font-weight-bold); text-decoration: none; }
  .fp-heads__action:hover { color: var(--page-text); text-decoration: underline; }
</style>
