---
/**
 * The thin score strip across the top of the front page: this week's games as
 * crest + name + score pairs. It follows the theme (white in light, the card
 * surface in dark), so it draws each team's theme-following icon, which the
 * site-wide dark swap (TeamIconDarkStyles) turns to its dark cut.
 *
 * A signed-in owner sees their own division's games, their own first; anyone
 * else sees the games between the best records (src/utils/front-page.ts).
 */
import type { ScoreStrip as Strip } from '../../../utils/front-page';
import type { FrontTeamArt } from './types';

interface Props {
  strip: Strip;
  teams: Record<string, FrontTeamArt>;
  allHref: string | null;
  /** `card` sits in a page's content; `bar` runs edge to edge atop the site header. */
  variant?: 'card' | 'bar';
}

const { strip, teams, allHref, variant = 'card' } = Astro.props;
const fmt = (n: number | null) => (n == null ? '' : n.toFixed(1));
const label = strip.state === 'upcoming' ? 'This week' : 'Final';
const scopeLabel = strip.scope === 'division' ? 'Your division' : 'Top games';
---

<nav class:list={['fp-strip', `fp-strip--${variant}`]} aria-label={`Week ${strip.week} scores`}>
  <div class="fp-strip__inner">
    <div class="fp-strip__week">
      <strong>Week {strip.week}</strong>
      <span>{label} · {scopeLabel}</span>
    </div>
    <ul class="fp-strip__games">
      {strip.games.map((g) => {
        const scored = g.sides.every((s) => s.score != null);
        const leader = scored ? (g.sides[0].score! >= g.sides[1].score! ? 0 : 1) : -1;
        return (
          <li class:list={['fp-strip__game', { 'fp-strip__game--mine': g.mine }]}>
            {g.sides.map((s, i) => {
              const t = teams[s.franchiseId];
              return (
                <a class:list={['fp-strip__side', { 'fp-strip__side--lead': i === leader, 'fp-strip__side--trail': leader !== -1 && i !== leader }]} href={t?.href}>
                  {t?.icon || t?.crest ? (
                    <img
                      class:list={['fp-strip__crest', { 'fp-strip__crest--round': t.round }]}
                      src={t.icon || t.crest}
                      alt=""
                      width="20"
                      height="20"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : <span class="fp-strip__crest" />}
                  <span class="fp-strip__name">{t?.name ?? s.franchiseId}</span>
                  <span class="fp-strip__score">{scored ? fmt(s.score) : t?.record ?? ''}</span>
                </a>
              );
            })}
          </li>
        );
      })}
    </ul>
    {allHref && (
      <a class="fp-strip__all" href={allHref}>
        All scores{strip.hidden > 0 ? ` (+${strip.hidden})` : ''}
      </a>
    )}
  </div>
</nav>

<style>
  .fp-strip {
    background: var(--content-bg);
    color: var(--page-text);
    border: 1px solid var(--content-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .fp-strip--bar { border-radius: 0; border-width: 0 0 1px; }
  .fp-strip--bar .fp-strip__inner { max-width: 1180px; margin: 0 auto; }
  .fp-strip__inner {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fp-strip__inner::-webkit-scrollbar { display: none; }
  .fp-strip__week {
    flex: none;
    display: grid;
    align-content: center;
    gap: 0.1rem;
    padding: 0.5rem 0.9rem;
    border-right: 1px solid var(--content-border);
  }
  .fp-strip__week strong {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    line-height: 1;
    text-transform: uppercase;
  }
  .fp-strip__week span {
    font-size: var(--font-size-3xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    opacity: 0.75;
    white-space: nowrap;
  }
  .fp-strip__games {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fp-strip__game {
    flex: none;
    display: grid;
    gap: 0.15rem;
    min-width: 9rem;
    padding: 0.45rem 0.8rem;
    border-right: 1px solid var(--content-border);
  }
  .fp-strip__game--mine { background: var(--content-bg-muted); }
  .fp-strip__side {
    display: grid;
    grid-template-columns: 1.25rem 1fr auto;
    gap: 0.4rem;
    align-items: center;
    color: var(--page-text);
    text-decoration: none;
    font-size: var(--font-size-xs);
  }
  .fp-strip__side:hover { color: var(--page-text); text-decoration: none; }
  .fp-strip__side--lead { font-weight: var(--font-weight-bold); }
  .fp-strip__side--trail { color: var(--content-text-muted); }
  .fp-strip__crest { width: 1.25rem; height: 1.25rem; object-fit: contain; }
  .fp-strip__crest--round { border-radius: var(--radius-full); object-fit: cover; }
  .fp-strip__name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 7rem; }
  .fp-strip__score { font-family: var(--font-numeric); font-variant-numeric: tabular-nums; }
  .fp-strip__all {
    flex: none;
    display: grid;
    place-items: center;
    padding: 0 0.9rem;
    margin-left: auto;
    color: var(--page-text);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
    text-decoration: none;
  }
  .fp-strip__all:hover { color: var(--page-text); text-decoration: underline; }
</style>
