---
/**
 * Owner Map — shared render for every league that has the route.
 *
 * Thin route wrappers under src/pages/<league>/owner-map.astro own the
 * auth gate and the league's owner-tenures import; this component owns the
 * markup. Keep it that way: Astro.redirect() only works from a page, and a
 * static import specifier cannot be a runtime variable.
 *
 * TEST PAGE: every hometown is a sample city (src/utils/owner-map.ts) until
 * owners can pick the city their team represents. The banner below says so.
 *
 * The map itself is a MapLibre island (owner-map-client.ts), loaded only on
 * this page. The list under it carries the same pins as plain text, because a
 * WebGL canvas is invisible to a screen reader.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import type { OwnerTenuresFile } from '../../../types/owner-tenures';
import { buildOwnerMapPins, cityLabel } from '../../../utils/owner-map';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  data: OwnerTenuresFile;
}

const { leagueSlug, data } = Astro.props;
const league = getLeagueBySlug(leagueSlug);
if (!league) throw new Error(`OwnerMapPage: unknown league ${leagueSlug}`);

const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);

const pins = buildOwnerMapPins(data, league.slug, (franchiseId) => r(`/franchises/${franchiseId}`));
const hasSample = pins.some((pin) => pin.isSample);
---

<TheLeagueLayout title={`Owner Map | ${league.name}`}>
  <div class="owner-map" data-owner-map data-league={league.slug}>
    <Breadcrumbs items={[{ label: 'Owners', href: `/${league.slug}/owners` }, { label: 'Owner Map' }]} />

    <header class="owner-map__head">
      <h1>Owner Map</h1>
      <p class="owner-map__lede">The hometown every {league.name} team represents, chosen by its owner. Tap a logo to see who's from there.</p>
    </header>

    {hasSample && (
      <p class="owner-map__notice" role="note">
        <strong>Test page.</strong> These hometowns are samples. Before this goes live, each owner will pick the city
        their team represents.
      </p>
    )}

    <div class="ui-pills owner-map__toolbar" role="group" aria-label="Map view">
      <button type="button" class="ui-pill" data-owner-map-view="us" aria-pressed="true">United States</button>
      <button type="button" class="ui-pill" data-owner-map-view="world" aria-pressed="false">World</button>
    </div>

    <div class="owner-map__frame">
      <div class="owner-map__canvas" data-owner-map-canvas aria-hidden="true"></div>
      <div class="owner-map__panel" data-owner-map-panel hidden>
        <button type="button" class="owner-map__panel-close" data-owner-map-panel-close aria-label="Close">×</button>
        <div class="om-pop" data-owner-map-panel-rows></div>
      </div>
    </div>

    <section class="owner-map__list-section" aria-labelledby="owner-map-list-heading">
      <h2 id="owner-map-list-heading" class="owner-map__section-title">Teams by hometown</h2>
      <ul class="owner-map__list">
        {pins.map((pin) => (
          <li>
            <a class="owner-map__row" href={pin.href}>
              <img class="owner-map__row-icon" src={pin.icon} alt="" width="40" height="40" loading="lazy" />
              <span class="owner-map__row-text">
                <span class="owner-map__row-team">{pin.teamName}</span>
                <span class="owner-map__row-meta">{pin.ownerName} · {cityLabel(pin.city)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <script type="application/json" data-owner-map-pins set:html={JSON.stringify(pins).replace(/</g, '\\u003c')} />
  </div>
</TheLeagueLayout>

<script>
  import { mountOwnerMap } from './owner-map-client';

  let unmount: (() => void) | null = null;

  // `document` survives every ClientRouter swap, so this listener runs on
  // every page. Gate on the swapped-in root, which also names its league,
  // per the CLAUDE.md rule on astro:page-load gates.
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-owner-map][data-league]');
    if (!root || root.dataset.ownerMapReady) return;
    root.dataset.ownerMapReady = '1';
    mountOwnerMap(root)
      .then((dispose) => {
        unmount = dispose;
      })
      .catch((error) => {
        console.error('[owner-map] failed to start', error);
        root.querySelector('.owner-map__frame')?.classList.add('owner-map__frame--failed');
      });
  });

  document.addEventListener('astro:before-swap', () => {
    unmount?.();
    unmount = null;
  });
</script>

<style>
  .owner-map {
    max-width: var(--container-max-width, 1100px);
    margin: 0 auto;
    padding: var(--spacing-lg, 1.5rem) var(--spacing-md, 1rem);
  }
  .owner-map__head h1 {
    margin: 0.5rem 0 0.5rem;
    font-size: var(--font-size-xl);
  }
  .owner-map__lede {
    margin: 0 0 1rem;
    max-width: 62ch;
    color: var(--content-text-muted, #555);
    line-height: 1.55;
  }
  .owner-map__notice {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--alert-warning-border);
    border-radius: var(--card-radius, 8px);
    background: var(--alert-warning-bg);
    color: var(--alert-warning-text);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.45;
  }

  .owner-map__toolbar {
    margin-bottom: 0.75rem;
  }

  .owner-map__frame {
    /* Read by the map (owner-map-client.ts solidToken), not by CSS. */
    --om-land: color-mix(in srgb, var(--page-text) 9%, var(--content-bg));
    --om-border: color-mix(in srgb, var(--page-text) 28%, var(--content-bg));
    position: relative;
    /* Shaped like the lower 48 on a phone (about 4:3), taller on desktop. */
    height: clamp(300px, 72vw, 560px);
    border: var(--style-card-border, 1px solid var(--content-border));
    box-shadow: var(--style-card-shadow, none);
    border-radius: var(--card-radius, 8px);
    overflow: hidden;
    background: var(--content-bg-muted);
  }
  .owner-map__canvas {
    position: absolute;
    inset: 0;
  }
  .owner-map__frame--failed::after {
    content: 'The map could not load. The list below has every owner.';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    color: var(--content-text-muted, #555);
  }

  .owner-map__list-section {
    margin-top: 1.5rem;
  }
  .owner-map__section-title {
    margin: 0 0 0.75rem;
    padding-left: var(--style-section-rule-gap, 0.6rem);
    padding-bottom: var(--style-section-mark-pad, 0);
    border-left: var(--style-section-rule, 4px solid var(--league-accent));
    background: var(--style-section-mark, none);
    font-size: var(--font-size-sm, 0.875rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .owner-map__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .owner-map__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: var(--style-card-border, 1px solid var(--content-border));
    box-shadow: var(--style-card-shadow, none);
    border-radius: var(--card-radius, 8px);
    background: var(--card-bg);
    color: var(--page-text);
    text-decoration: none;
  }
  .owner-map__row:hover {
    border-color: var(--league-accent);
    text-decoration: none;
  }
  .owner-map__row-icon {
    flex: none;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .owner-map__row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .owner-map__row-team {
    font-weight: var(--font-weight-semibold, 600);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .owner-map__row-meta {
    color: var(--content-text-muted, #555);
    font-size: var(--font-size-sm, 0.875rem);
  }

  /* Markers and popups are created by MapLibre outside this component's
     scope, so their rules are global (prefixed om- to stay contained). */
  :global(.om-marker) {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  :global(.om-marker__icon) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 2px solid var(--league-accent);
    border-radius: 50%;
    overflow: hidden;
    background: var(--content-bg);
    box-shadow: var(--box-shadow-md);
  }
  :global(.om-marker__icon img) {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }
  :global(.om-marker--group .om-marker__icon + .om-marker__icon) {
    margin-left: -20px;
  }
  :global(.om-marker__count) {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 11px;
    background: var(--league-accent);
    color: var(--on-league-accent, #fff);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold, 700);
    line-height: 22px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .owner-map__panel {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 2;
    max-width: 360px;
    padding: 0.5rem;
    border: var(--style-card-border, 1px solid var(--content-border));
    border-radius: var(--card-radius, 8px);
    background: var(--content-bg);
    box-shadow: var(--box-shadow-lg);
  }
  .owner-map__panel[hidden] {
    display: none;
  }
  .owner-map__panel-close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    color: var(--content-text-muted, #555);
    font-size: var(--font-size-lg);
    line-height: 1;
    cursor: pointer;
  }
  .om-pop {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: 180px;
    overflow-y: auto;
    padding-right: 2rem;
  }
  /* Rows are injected by the map script, so they are outside this scope;
     doubled class beats the layouts' global a / a:hover color. */
  :global(.om-pop__row.om-pop__row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    border-radius: 6px;
    color: var(--page-text);
    text-decoration: none;
  }
  :global(.om-pop__row.om-pop__row:hover) {
    background: var(--content-bg-muted);
    color: var(--page-text);
    text-decoration: none;
  }
  :global(.om-pop__icon) {
    flex: none;
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  :global(.om-pop__text) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  :global(.om-pop__team) {
    font-weight: var(--font-weight-semibold, 600);
  }
  :global(.om-pop__meta) {
    color: var(--content-text-muted, #555);
    font-size: var(--font-size-xs);
  }
  :global(.owner-map .maplibregl-ctrl-group) {
    background: var(--card-bg);
  }
  :global(.owner-map .maplibregl-ctrl.maplibregl-ctrl-attrib) {
    background: var(--content-bg);
    color: var(--content-text-muted, #555);
  }
  :global(.owner-map .maplibregl-ctrl-attrib a) {
    color: inherit;
  }
  :global(html.dark .owner-map .maplibregl-ctrl-attrib-button),
  :global(html.dark .owner-map .maplibregl-ctrl-icon) {
    filter: invert(1);
  }
</style>
