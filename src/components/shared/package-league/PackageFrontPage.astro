---
/**
 * A package league's homepage in the Primetime site style (registry
 * `siteTheme: 'primetime'`; Archie's is the first). The adapter between the feeds
 * PackageLeagueHome already loaded and the style's view model
 * (../front-page/types.ts): it writes the stories from the league's own data,
 * resolves each team's art once, and hands FrontHomePage a finished model.
 *
 * Every story comes from data the league already has, so the page is never
 * empty in season:
 *   rivalry       the viewer's opponent(s) this week, from franchise history
 *                 (two in a doubleheader week), pinned to the headlines
 *   gauntlet      Schefter's columns and articles
 *   pecking-order the latest issue
 *   recap         the week in the books
 *   transaction   the latest moves, each linking its official record
 */
import FrontHomePage from '../front-page/FrontHomePage.astro';
import type { FrontPageModel, FrontTeamArt, RaceEntry, TeamBandModel } from '../front-page/types';
import type { LeagueDefinition } from '../../../config/leagues';
import type { DivisionStandings, PackageTeam } from '../../../utils/package-league';
import { rosterPlayerIds, standingsRows as feedStandingsRows } from '../../../utils/package-league';
import { parseWeeklySchedule } from '../../../utils/schedule-data.mjs';
import { weekInTheBooks } from '../../../utils/package-league-home';
import {
  arrangeStories,
  buildPeckingOrderStory,
  buildRecapStory,
  buildRivalryStory,
  buildTransactionStory,
  buildWire,
  opponentsInWeek,
  podium,
  meetingsBetween,
  rivalryFacts,
  storiesFromPosts,
  stripWeek,
  teamsMentioned,
  topScorer,
  type FrontStory,
  type MoveInput,
  type ParsedWeek,
} from '../../../utils/front-page';
import { loadSeasonFeed, unwrapFeedModule, type LazyFeedGlob } from '../../../utils/mfl-feed-glob';
import { recordBook } from '../../../utils/league-history/records.mjs';
import { frontTeamArt } from '../../../utils/front-page-art';
import { readViewerClock } from '../../../utils/viewer-preferences-page';
import { formatForViewer, formatMomentZones } from '../../../utils/viewer-clock';
import { eventZonesFor } from '../../../utils/viewer-preferences';
import { getAuthUser } from '../../../utils/auth';
import type { PlayerIdentity } from '../../../utils/player-map';
import type { SchefterPost } from '../../../types/schefter';

interface Props {
  league: LeagueDefinition;
  teamsById: Record<string, PackageTeam>;
  groups: DivisionStandings[];
  standingsFeed: unknown;
  scheduleFeed: unknown;
  rostersFeed: unknown;
  mine: string | null;
  teamHref: (franchiseId: string) => string;
  /** Resolves a league path for this host (prefix or not). */
  r: (path: string) => string;
  hasPage: (path: string) => boolean;
  signInHref: string | null;
  posts: SchefterPost[];
  latestIssue: (Record<string, any> & { year: number; week: number }) | null;
  moves: MoveInput[];
  players: Map<string, PlayerIdentity>;
  playerName: (id: string) => string;
  /** Lazy glob of data/<league>/derived/league-history.json (one file): the rivalry stories' head-to-head. */
  historyFeeds?: LazyFeedGlob;
  /** Lazy glob of data/<league>/mfl-feeds/<year>/playerScores-ytd.json. */
  ytdScoreFeeds?: LazyFeedGlob;
  seasonYear: number;
}

const {
  league,
  teamsById,
  groups,
  standingsFeed,
  scheduleFeed,
  rostersFeed,
  mine,
  teamHref,
  r,
  hasPage,
  signInHref,
  posts,
  latestIssue,
  moves,
  players,
  playerName,
  historyFeeds = {},
  ytdScoreFeeds = {},
  seasonYear,
} = Astro.props;
const base = `/${league.slug}`;
const leagueName = league.shortName ?? league.name;
const nameOf = (id: string) => teamsById[id]?.name ?? `Team ${id}`;

// ── Standings rows by team (MFL order inside each division) ────────────────
const rowOf = new Map(groups.flatMap((g) => g.rows.map((row) => [row.franchiseId, { row, division: g.division }] as const)));
const recordOf = (id: string) => rowOf.get(id)?.row.record;
const ordinal = (n: number) => {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return `${n}${s[(v - 20) % 10] ?? s[v] ?? s[0]}`;
};

// ── The schedule ────────────────────────────────────────────────────────────
const weeks = parseWeeklySchedule(scheduleFeed) as ParsedWeek[];
const current = stripWeek(weeks);
const thisWeek = current?.state === 'upcoming' ? current.week : undefined;
const opponents = opponentsInWeek(thisWeek, mine);

// ── Stories ─────────────────────────────────────────────────────────────────
const historyModule = Object.values(historyFeeds)[0];
const historyData = historyModule ? unwrapFeedModule(await historyModule().catch(() => null)) : null;
const historyIndex = historyData ? recordBook(historyData).ix : null;

const stories: FrontStory[] = [];
/** The series over a rivalry card's art: the viewer's all-time record, or "first meeting". */
const overlays: Record<string, { text: string; label?: string }> = {};
if (mine && teamsById[mine] && thisWeek) {
  for (const opp of opponents) {
    if (!teamsById[opp]) continue;
    const meetings = meetingsBetween(historyIndex, mine, opp);
    const f = rivalryFacts(meetings);
    overlays[`rivalry-${thisWeek.week}-${opp}`] =
      f.meetings === 0
        ? { text: 'New', label: 'First meeting' }
        : { text: f.ties ? `${f.wins}–${f.losses}–${f.ties}` : `${f.wins}–${f.losses}`, label: 'All-time' };
    stories.push(
      buildRivalryStory({
        mine: teamsById[mine],
        opponent: teamsById[opp],
        week: thisWeek.week,
        meetings,
        opponentRecord: recordOf(opp),
        href: teamHref(opp),
      }),
    );
  }
}
const teamList = Object.values(teamsById);
for (const s of storiesFromPosts(posts)) {
  stories.push(s.franchiseIds.length ? s : { ...s, franchiseIds: teamsMentioned(`${s.headline} ${s.dek ?? ''}`, teamList) });
}
if (latestIssue) {
  const po = buildPeckingOrderStory(
    latestIssue as Parameters<typeof buildPeckingOrderStory>[0],
    r(`${base}/pecking-order/${latestIssue.year}/${latestIssue.week}`),
  );
  if (po) stories.push(po);
}
const recap = buildRecapStory(weekInTheBooks(weeks as any), nameOf, hasPage('/standings') ? r(`${base}/standings`) : undefined);
if (recap) stories.push(recap);
const officialMoves = hasPage('/transactions') ? r(`${base}/transactions`) : undefined;
for (const m of moves.slice(0, 6)) {
  const s = buildTransactionStory(m, nameOf, playerName, officialMoves);
  if (s) stories.push(s);
}
const { lead, headlines, cards } = arrangeStories(stories);

// ── The race: the top three in MFL's own order, each with its best scorer ───
const ytdYear = Object.keys(ytdScoreFeeds).length ? seasonYear : null;
const ytdFeed = ytdYear ? ((await loadSeasonFeed(ytdScoreFeeds, ytdYear)) as { playerScores?: { playerScore?: unknown } } | null) : null;
const ytdRows = ([] as Array<{ id: string; score: string }>).concat((ytdFeed?.playerScores?.playerScore as any) ?? []);
const top3 = podium(feedStandingsRows(standingsFeed).map((row) => ({ id: String(row.id ?? '') })).filter((row) => row.id));

// ── Art, resolved once for every team the page draws ───────────────────────
const artFor = (id: string): FrontTeamArt | null =>
  teamsById[id] ? frontTeamArt(teamsById[id], league.slug, teamHref(id), recordOf(id)) : null;
const wanted = new Set<string>([
  ...(mine ? [mine] : []),
  ...opponents,
  ...stories.flatMap((s) => s.franchiseIds),
  ...top3.map((t) => t.id),
]);
const teams: Record<string, FrontTeamArt> = {};
for (const id of wanted) {
  const art = artFor(id);
  if (art) teams[id] = art;
}

// Where each division is its own player pool the same star is on several
// rosters, so each podium card takes the best scorer not already shown.
const shownStars = new Set<string>();
const race: RaceEntry[] = top3
  .filter((t) => teams[t.id])
  .map((t, i) => {
    const roster = rostersFeed ? rosterPlayerIds(rostersFeed, t.id).map((p) => p.id).filter((id) => !shownStars.has(id)) : [];
    const starId = topScorer(roster, ytdRows);
    if (starId) shownStars.add(starId);
    const star = starId ? players.get(starId) : undefined;
    const at = rowOf.get(t.id);
    return {
      place: i + 1,
      team: teams[t.id],
      line: [at?.row.record, at ? `${at.row.pointsFor.toFixed(1)} pts` : null].filter(Boolean).join(' · '),
      star: star?.headshot ? { name: star.name, headshot: star.headshot } : null,
    };
  });

// ── The viewer's band ───────────────────────────────────────────────────────
const mineAt = mine ? rowOf.get(mine) : undefined;
const band: TeamBandModel | null =
  mine && mineAt && teams[mine]
    ? {
        team: teams[mine],
        standing: `${ordinal(mineAt.row.place)} in the ${mineAt.division.name}`,
        week: thisWeek?.week ?? null,
        opponents: opponents.map((id) => teams[id]).filter(Boolean),
        links: [
          { label: 'Roster', href: r(`${base}/rosters?franchise=${mine}`), page: '/rosters' },
          { label: 'Lineup', href: r(`${base}/lineup`), page: '/lineup' },
          { label: 'Standings', href: r(`${base}/standings`), page: '/standings' },
          { label: 'Free agents', href: r(`${base}/free-agents`), page: '/free-agents' },
        ]
          .filter((l) => hasPage(l.page))
          .map(({ label, href }) => ({ label, href })),
      }
    : null;

// Story times in the viewer's own clock (the league's PT until they choose
// one). READING the clock is side-effect free; only the route may write it.
const clock = await readViewerClock(Astro.cookies, getAuthUser(Astro.request), league.slug);
const times: FrontPageModel['times'] = {};
for (const s of [lead, ...headlines].filter((x): x is FrontStory => !!x?.at)) {
  const at = new Date(s.at!);
  times[s.id] = {
    line: formatForViewer(at, clock, { weekday: true }),
    day: formatMomentZones(at, eventZonesFor(clock), { time: false })[0]?.day ?? '',
  };
}

const model: FrontPageModel = {
  leagueName,
  // The score strip rides the site header on every page of this style
  // (HeaderScoreStrip), so the homepage does not draw a second one.
  strip: null,
  stripHref: null,
  band,
  signInHref: mine ? null : signInHref,
  lead,
  headlines,
  cards,
  race,
  raceTitle: league.standingsSeeding?.kind === 'mad' ? 'The race for MAD Power 99' : 'The race',
  raceHref: r(`${base}/standings`),
  wire: buildWire(posts, new Set(mine && rostersFeed ? rosterPlayerIds(rostersFeed, mine).map((p) => p.id) : [])),
  teams,
  leagueMark: league.logo,
  times,
};
---

<FrontHomePage
  title={league.name}
  model={model}
  cardsTitle={`This week in ${leagueName}`}
  overlays={overlays}
  wireHref={hasPage('/news') ? r(`${base}/news`) : null}
/>
