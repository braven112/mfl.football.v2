---
/**
 * Standings for a package league — division cards, victory points, MFL order.
 *
 * The route passes the lazy glob over its standings feeds (a static import
 * specifier cannot be a runtime variable, and a cron-written feed must never
 * be a static import — docs/claude/rules/storage-and-build.md).
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../../theleague/Breadcrumbs.astro';
import DivisionStandings from './DivisionStandings.astro';
import { getLeagueBySlug, type CanonicalLeagueSlug } from '../../../config/leagues';
import { getAuthUser, franchiseIdForLeague } from '../../../utils/auth';
import { groupStandingsByDivision, type PackageDivision, type PackageTeam } from '../../../utils/package-league';
import { loadSeasonFeed, resolveSeason, seasonsFromGlob, type LazyFeedGlob } from '../../../utils/mfl-feed-glob';
import { getCurrentSeasonYear } from '../../../utils/league-year';
import { franchiseSlug } from '../../../utils/franchise-marks';
import { resolveLeaguePath } from '../../../utils/nav-utils';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  standingsFeeds: LazyFeedGlob;
  config: { teams: PackageTeam[]; divisions?: PackageDivision[] };
}

const { leagueSlug, standingsFeeds, config } = Astro.props;
const league = getLeagueBySlug(leagueSlug)!;
const hide = Astro.locals.hideLeaguePrefix ?? false;
const r = (p: string) => resolveLeaguePath(p, hide);

const years = seasonsFromGlob(standingsFeeds);
const year = resolveSeason(Astro.url.searchParams.get('year'), years, getCurrentSeasonYear());
const feed = year ? await loadSeasonFeed(standingsFeeds, year) : null;
const groups = groupStandingsByDivision(feed, config.teams, config.divisions ?? []);

const authUser = getAuthUser(Astro.request);
const mine = franchiseIdForLeague(authUser, league.id);
const teamSlugs = Object.fromEntries(config.teams.map((t) => [t.franchiseId, franchiseSlug(t)]));
---

<TheLeagueLayout title={`Standings${year ? ` ${year}` : ''} | ${league.name}`}>
  <div class="pkg-page">
    <Breadcrumbs items={[{ label: league.name, href: `/${league.slug}` }, { label: 'Standings' }]} />
    <header class="pkg-page__head">
      <h1>Standings{year ? ` · ${year}` : ''}</h1>
      <p>Sorted the way MFL sorts them: victory points, then points for, then head-to-head.</p>
    </header>
    {groups.length > 0 ? (
      <DivisionStandings
        groups={groups}
        teamHrefBase={r(`/${league.slug}/brand`)}
        teamSlugs={teamSlugs}
        highlightFranchiseId={mine}
      />
    ) : (
      <p class="pkg-page__empty">No standings yet — they appear once the season's first week is scored.</p>
    )}
  </div>
</TheLeagueLayout>

<style>
  .pkg-page { max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3rem; }
  .pkg-page__head h1 { margin: 0.5rem 0 0.25rem; color: var(--page-text); }
  .pkg-page__head p { margin: 0 0 1.25rem; color: var(--content-text-muted); font-size: 0.9rem; }
  .pkg-page__empty { color: var(--content-text-muted); }
</style>
