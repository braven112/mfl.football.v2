---
/**
 * The hero for a package league's homepage (archies first).
 *
 * League-agnostic by construction: built only from what every MFL league has
 * — a schedule, scores, standings, the league's news and its calendar — via
 * `resolvePackageHero` (src/utils/package-league-home.ts). Four states:
 *
 *   my-week         a signed-in owner's games this week (all of them: a
 *                   doubleheader week is two games), with last week's results
 *   my-season-done  their season is over: how the last week went
 *   league-week     everyone else in season: the league's latest scored week
 *   offseason       nothing scored yet: the next calendar event
 *
 * Colours are semantic tokens only (the league's palette drives them), so the
 * hero recolours with the league.
 */
import type { PackageHeroState, HomeGame, WeekInTheBooks } from '../../../utils/package-league-home';
import { gameResultLine } from '../../../utils/package-league-home';
import type { PackageTeam } from '../../../utils/package-league';
import type { ResolvedLeagueEvent } from '../../../types/league-events';

interface Props {
  state: PackageHeroState;
  teams: Record<string, PackageTeam>;
  /** franchiseId → team page href. */
  teamHref: (franchiseId: string) => string;
  /** The viewer's franchise (for the "you" side). */
  mine: string | null;
  /** Latest column, shown as a strip under the hero when present. */
  latestColumn?: { headline: string; href: string; byline: string } | null;
  /** The next calendar event, for the offseason state. */
  nextEvent?: ResolvedLeagueEvent | null;
  signInHref: string;
  standingsHref: string;
  /** The viewer's roster page. */
  rosterHref: string;
  leagueName: string;
}

const { state, teams, teamHref, mine, latestColumn, nextEvent, signInHref, standingsHref, rosterHref, leagueName } =
  Astro.props;

const team = (id: string) => teams[id];
const name = (id: string) => team(id)?.name ?? `Team ${id}`;
const icon = (id: string) => team(id)?.icon;
const fmt = (n: number) => n.toFixed(2);
const dateFmt = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/Los_Angeles' });

const weekRecord = (games: HomeGame[]) => {
  const w = games.filter((g) => g.outcome === 'W').length;
  const l = games.filter((g) => g.outcome === 'L').length;
  const t = games.filter((g) => g.outcome === 'T').length;
  return t ? `${w}-${l}-${t}` : `${w}-${l}`;
};

const leagueLines = (b: WeekInTheBooks) =>
  [
    { label: 'Top score', id: b.top.franchiseId, value: fmt(b.top.score) },
    b.blowout && { label: 'Biggest win', id: b.blowout.winnerId, value: `by ${fmt(b.blowout.margin)}`, vs: b.blowout.loserId },
    b.nailBiter && { label: 'Closest game', id: b.nailBiter.winnerId, value: `by ${fmt(b.nailBiter.margin)}`, vs: b.nailBiter.loserId },
  ].filter(Boolean) as Array<{ label: string; id: string; value: string; vs?: string }>;
---

<section class="pkg-hero" aria-label="This week">
  {state.kind === 'my-week' && (
    <div class="pkg-hero__body">
      <p class="pkg-hero__eyebrow">Week {state.week} · your {state.games.length > 1 ? 'games' : 'game'}</p>
      <ul class="pkg-hero__games">
        {state.games.map((g) => (
          <li class="pkg-hero__game">
            <a class="pkg-hero__side" href={teamHref(mine!)}>
              {icon(mine!) && <img src={icon(mine!)} alt="" width="56" height="56" />}
              <span>{name(mine!)}</span>
            </a>
            <span class="pkg-hero__vs">{g.isHome ? 'vs' : '@'}</span>
            <a class="pkg-hero__side pkg-hero__side--opp" href={teamHref(g.opponentId)}>
              {icon(g.opponentId) && <img src={icon(g.opponentId)} alt="" width="56" height="56" />}
              <span>{name(g.opponentId)}</span>
            </a>
          </li>
        ))}
      </ul>
      {state.lastWeek && (
        <p class="pkg-hero__sub">
          Week {state.lastWeek.week}: went {weekRecord(state.lastWeek.games)}
          {' — '}
          {state.lastWeek.games.map((g) => `${gameResultLine(g)} vs ${name(g.opponentId)}`).join(', ')}
        </p>
      )}
      <div class="pkg-hero__actions">
        <a class="pkg-hero__btn" href={rosterHref}>Your roster</a>
        <a class="pkg-hero__link" href={standingsHref}>Standings →</a>
      </div>
    </div>
  )}

  {state.kind === 'my-season-done' && (
    <div class="pkg-hero__body">
      <p class="pkg-hero__eyebrow">Season wrap · week {state.lastWeek.week}</p>
      <h2 class="pkg-hero__title">{name(mine!)} went {weekRecord(state.lastWeek.games)} to close it out</h2>
      <p class="pkg-hero__sub">
        {state.lastWeek.games.map((g) => `${gameResultLine(g)} vs ${name(g.opponentId)}`).join(' · ')}
      </p>
      <div class="pkg-hero__actions">
        <a class="pkg-hero__btn" href={standingsHref}>Final standings</a>
      </div>
    </div>
  )}

  {state.kind === 'league-week' && (
    <div class="pkg-hero__body">
      <p class="pkg-hero__eyebrow">Week {state.league.week} in the books · {leagueName}</p>
      <ul class="pkg-hero__stats">
        {leagueLines(state.league).map((l) => (
          <li>
            <span class="pkg-hero__stat-label">{l.label}</span>
            <a class="pkg-hero__stat-team" href={teamHref(l.id)}>
              {icon(l.id) && <img src={icon(l.id)} alt="" width="40" height="40" />}
              <span>{name(l.id)}</span>
            </a>
            <span class="pkg-hero__stat-value">
              {l.value}
              {l.vs && <span class="pkg-hero__stat-vs"> over {name(l.vs)}</span>}
            </span>
          </li>
        ))}
      </ul>
      <div class="pkg-hero__actions">
        <a class="pkg-hero__btn" href={standingsHref}>Standings</a>
        {!mine && <a class="pkg-hero__link" href={signInHref}>Sign in to see your games →</a>}
      </div>
    </div>
  )}

  {state.kind === 'offseason' && (
    <div class="pkg-hero__body">
      <p class="pkg-hero__eyebrow">{leagueName}</p>
      {nextEvent ? (
        <>
          <h2 class="pkg-hero__title">{nextEvent.definition.name}</h2>
          <p class="pkg-hero__sub">
            {dateFmt.format(nextEvent.startDate)}
            {nextEvent.daysUntilStartCalendar > 0 &&
              ` · ${nextEvent.daysUntilStartCalendar} ${nextEvent.daysUntilStartCalendar === 1 ? 'day' : 'days'} away`}
          </p>
        </>
      ) : (
        <h2 class="pkg-hero__title">The new season is on its way</h2>
      )}
      <div class="pkg-hero__actions">
        <a class="pkg-hero__btn" href={standingsHref}>Standings</a>
      </div>
    </div>
  )}

  {latestColumn && (
    <a class="pkg-hero__column" href={latestColumn.href}>
      <span class="pkg-hero__column-label">Latest column</span>
      <span class="pkg-hero__column-headline">{latestColumn.headline}</span>
      <span class="pkg-hero__column-byline">{latestColumn.byline}</span>
    </a>
  )}
</section>

<style>
  .pkg-hero {
    background: var(--inverse-content-bg);
    color: var(--inverse-text);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-card);
  }
  .pkg-hero__body { padding: 1.25rem 1.5rem 1.25rem; }
  .pkg-hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
  }
  .pkg-hero__title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--inverse-text);
  }
  .pkg-hero__sub {
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, var(--inverse-text) 78%, transparent);
    font-size: 0.95rem;
  }
  .pkg-hero__games { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .pkg-hero__game {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--inverse-text) 8%, transparent);
  }
  .pkg-hero__side {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--inverse-text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    min-width: 0;
  }
  .pkg-hero__side span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* row-reverse puts the crest on the outer edge; flex-start is then the RIGHT edge. */
  .pkg-hero__side--opp { justify-content: flex-start; text-align: right; flex-direction: row-reverse; }
  .pkg-hero__side img { border-radius: var(--radius-md); flex: none; }
  .pkg-hero__vs {
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .pkg-hero__stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .pkg-hero__stats li {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--inverse-text) 8%, transparent);
  }
  .pkg-hero__stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--inverse-text) 70%, transparent);
  }
  .pkg-hero__stat-team {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--inverse-text);
    text-decoration: none;
    font-weight: 700;
    min-width: 0;
  }
  .pkg-hero__stat-team img { border-radius: var(--radius-sm); flex: none; }
  .pkg-hero__stat-value { font-variant-numeric: tabular-nums; font-weight: 700; text-align: right; }
  .pkg-hero__stat-vs { font-weight: 400; color: color-mix(in srgb, var(--inverse-text) 70%, transparent); }
  .pkg-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1rem; }
  .pkg-hero__btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    text-decoration: none;
    font-weight: 700;
  }
  .pkg-hero__btn:hover { background: var(--btn-primary-bg-hover); }
  .pkg-hero__link { color: var(--inverse-text); font-weight: 600; }
  .pkg-hero__column {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--inverse-text) 15%, transparent);
    color: var(--inverse-text);
    text-decoration: none;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .pkg-hero__column:hover .pkg-hero__column-headline { text-decoration: underline; }
  .pkg-hero__column-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 700;
  }
  .pkg-hero__column-headline { font-weight: 700; font-size: 1.05rem; }
  .pkg-hero__column-byline { font-size: 0.8rem; color: color-mix(in srgb, var(--inverse-text) 70%, transparent); }

  @media (max-width: 600px) {
    .pkg-hero__body { padding: 1rem; }
    /* Keep each game on one row; shrink rather than stack. */
    .pkg-hero__game { gap: 0.4rem; padding: 0.6rem; }
    .pkg-hero__side { font-size: 0.95rem; gap: 0.4rem; }
    .pkg-hero__side img { width: 32px; height: 32px; }
    .pkg-hero__vs { font-size: 0.75rem; }
    .pkg-hero__stats li { grid-template-columns: 1fr auto; }
    .pkg-hero__stat-label { grid-column: 1 / -1; }
  }
</style>
