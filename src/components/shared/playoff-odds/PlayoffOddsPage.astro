---
/**
 * Playoff Odds — one shared page for every league with a registry
 * `playoffOdds` format (TheLeague, the AFL, and the package leagues through
 * templates/package-league/playoff-odds.astro.tmpl).
 *
 * Reads the newest weekly file scripts/compute-playoff-odds.mjs wrote — the
 * SAME file the Saturday Matchup Preview snapshots and the standings Playoff
 * tab reads — so the three never disagree. The route owns the data import
 * (a static specifier) and passes the lazy file map in.
 */
import PlayoffRaceBoard from '../matchup-preview/PlayoffRaceBoard.astro';
import type { MatchupTeam } from '../matchup-preview/MatchupPreviewSection.astro';
import {
  formatOdds,
  loadLatestPlayoffOdds,
  playoffOddsBoards,
  type PlayoffOddsFile,
} from '../../../utils/playoff-odds-view';
import { teamAccentVar } from '../../../utils/team-accent-css';
import '../../../styles/playoff-race.css';

interface TeamConfigEntry {
  franchiseId: string;
  name: string;
  nameMedium?: string;
  nameShort?: string;
  abbrev?: string;
  icon?: string;
}

export interface Props {
  leagueName: string;
  files: Record<string, () => Promise<PlayoffOddsFile>>;
  teams: TeamConfigEntry[];
  myTeamId?: string | null;
  /** Resolved links (r(...)) — omit any the league does not have. */
  standingsHref?: string;
  gauntletHref?: string;
}

const { leagueName, files, teams, myTeamId = null, standingsHref, gauntletHref } = Astro.props;
const odds = await loadLatestPlayoffOdds(files);
const byId = new Map(teams.map((t) => [t.franchiseId, t]));
const teamOf = (id: string): MatchupTeam => {
  const t = byId.get(id);
  return {
    name: t?.nameMedium ?? t?.name ?? id,
    short: t?.abbrev ?? t?.nameShort ?? t?.name ?? id,
    icon: t?.icon,
  };
};
const boards = odds ? playoffOddsBoards(odds) : [];
const hasByes = (odds?.format?.byes ?? 0) > 0;
const byeLeaders = odds && hasByes
  ? [...odds.teams].filter((t) => t.bye >= 0.01).sort((a, b) => b.bye - a.bye).slice(0, 6)
  : [];
const bigGames = (odds?.games ?? []).filter((g) => g.stakes.swing >= 0.02).slice(0, 5);
const final = odds ? odds.week > odds.lastWeek : false;
---

<div class="pop">
  <header class="pop-head">
    <h1>Playoff Odds</h1>
    {odds ? (
      <p class="pop-sub">
        {leagueName} · {odds.year} · after Week {odds.completedWeek}
        {odds.lastWeek - odds.completedWeek > 0 && ` · ${odds.lastWeek - odds.completedWeek} week${odds.lastWeek - odds.completedWeek === 1 ? '' : 's'} left`}
      </p>
    ) : (
      <p class="pop-sub">Odds start once the first week of the season is final.</p>
    )}
  </header>

  {odds && (
    <Fragment>
      <section class="ui-card pop-card">
        <h2 class="pop-title">Chance to make the playoffs</h2>
        {boards.map((b) => (
          <Fragment>
            {b.label && <h3 class="prb-group">{b.label}</h3>}
            <PlayoffRaceBoard race={b.race} teamOf={teamOf} showSked={false} myTeamId={myTeamId} />
          </Fragment>
        ))}
      </section>

      {byeLeaders.length > 0 && (
        <section class="ui-card pop-card">
          <h2 class="pop-title">Chance at a first-round bye</h2>
          <ul class="pop-list">
            {byeLeaders.map((t) => (
              <li style={`--prb-team: ${teamAccentVar(t.franchiseId)}`}>
                <span class="pop-name">{teamOf(t.franchiseId).name}</span>
                <span class="pop-val prb-num">{formatOdds(t.bye)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {bigGames.length > 0 && !final && (
        <section class="ui-card pop-card">
          <h2 class="pop-title">Week {odds.week}: the games that move it most</h2>
          <ul class="pop-games">
            {bigGames.map((g) => {
              const key = g.stakes.kind === 'bye' ? 'bye' : 'playoff';
              return (
                <li>
                  <span class="pop-game">{teamOf(g.a.franchiseId).name} vs {teamOf(g.b.franchiseId).name}</span>
                  <span class="pop-what">{key === 'bye' ? 'Bye odds' : 'Playoff odds'}</span>
                  {[g.a, g.b].map((s) => (
                    <span class="pop-side">
                      <b style={`color: ${teamAccentVar(s.franchiseId)}`}>{teamOf(s.franchiseId).short}</b>
                      {' '}<span class="prb-num">{formatOdds(s[key])}</span> now,{' '}
                      <span class="prb-num">{formatOdds(s.win[key])}</span> with a win,{' '}
                      <span class="prb-num">{formatOdds(s.loss[key])}</span> with a loss
                    </span>
                  ))}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <section class="ui-card pop-card pop-how">
        <h2 class="pop-title">How these are figured</h2>
        <p>
          We play out the rest of the regular season {odds.iterations.toLocaleString('en-US')} times. Each team scores
          around its season average (pulled a little toward the league average early on), with the week-to-week swing
          this league actually has. Every simulated season is seeded the way the league seeds, and the odds are how often
          each team got in.
        </p>
        <p>
          Ties are broken with this league's own tiebreakers, in the league's order (head-to-head, division record and
          the rest). MFL's Power Rank is the one step we can't reproduce, so it's skipped and the next one decides.
          It's still an estimate of the weeks left, not a guarantee.
        </p>
        {(standingsHref || gauntletHref) && (
          <p class="pop-links">
            {standingsHref && <a class="cta-link" href={standingsHref}>Standings</a>}
            {gauntletHref && <a class="cta-link" href={gauntletHref}>The Gauntlet: schedule left</a>}
          </p>
        )}
      </section>
    </Fragment>
  )}
</div>

<style>
  .pop {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pop-head h1 {
    margin: 0.5rem 0 0.25rem;
  }
  .pop-sub {
    margin: 0;
    color: var(--color-text-secondary, #6b7280);
    font-size: var(--font-size-sm, 0.875rem);
  }
  .pop-card {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pop-title {
    margin: 0 0 0.25rem;
    font-size: var(--style-section-size, 0.9rem);
    text-transform: uppercase;
    letter-spacing: var(--style-section-tracking, 0.08em);
    font-family: var(--style-section-font, inherit);
    border-left: var(--style-section-rule, 3px solid var(--color-primary, #1c497c));
    background: var(--style-section-mark, none);
    padding-bottom: var(--style-section-mark-pad, 0);
    padding-left: var(--style-section-rule-gap, 0.6rem);
  }
  .pop-list,
  .pop-games {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pop-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pop-name {
    font-weight: 700;
    color: var(--prb-team);
  }
  .pop-val {
    font-weight: 700;
  }
  .pop-games li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle, rgba(127, 127, 127, 0.2));
  }
  .pop-games li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .pop-game {
    font-weight: 700;
  }
  .pop-what {
    font-size: var(--font-size-2xs, 0.6875rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary, #6b7280);
  }
  .pop-side {
    font-size: var(--font-size-sm, 0.875rem);
  }
  .pop-how p {
    margin: 0;
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.5;
  }
  .pop-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
