---
/**
 * The shared league homepage: the AFL's homepage made shared (the owner's call,
 * Oct 2026 — the AFL's pages are the repeatable ones; TheLeague's homepage
 * stays its own). The AFL and every package league render it.
 *
 * The page owns the shell every league shares:
 *   install banner     the app prompt, for a signed-in owner of THIS league
 *   hero               LeagueHero (or the preseason live-scoring test drive)
 *   rail               the league's news desk (SchefterFeedCompact) — the
 *                      right-hand column on desktop, stacked straight under
 *                      the hero on a phone (opening on three stories)
 *   Owners' Poll       the quick-vote pop-up, when the league runs one and its
 *                      window is open (the homepage card was removed Oct 2026)
 *   quick links        the league's pages from the page directory
 *   What's New         platform updates, minus the one the hero features
 *   debug strip        under ?testDate
 *
 * A league's own cards come in through slots, in this order: `snapshot` (its
 * team card), `after-snapshot`, `whats-next`, `standings`, `extras`. They are
 * the league's own — the AFL's conference and tier cards, a package league's
 * division standings, MAD qualifiers, Pecking Order and transactions — and
 * the shared page never learns their rules (CLAUDE.md, "Share the standard
 * views; a league's own competition stays its own").
 *
 * Every value is resolved by the route (or a league's adapter) and handed in:
 * globs are literal per route, and the `?myteam` cookie WRITE must happen in a
 * page (`Astro.cookies.set()` from a component throws after the headers
 * commit). This component only lays the page out.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import SchefterFeedCompact from '../SchefterFeedCompact.astro';
import LeagueHero from '../league-hero/LeagueHero.astro';
import OwnersPollHomePopup from '../owners-poll/OwnersPollHomePopup.astro';
import type { BallotStandingsRow } from '../../../utils/owners-poll-ballot-teams';
import LiveScoringTestDrive from '../LiveScoringTestDrive.astro';
import QuickLinks, { type QuickLinkPage } from '../hp-sections/QuickLinks.astro';
import WhatsNewRow from '../WhatsNewRow.astro';
import InstallAppPrompt from '../pwa/InstallAppPrompt.astro';
import type { SchefterPost } from '../../../types/schefter';
import type { CanonicalLeagueSlug } from '../../../config/leagues';

import '../../../styles/schefter-feed.css';
import '../../../styles/schefter-feed-compact.css';
import TopPlayersPromo from '../hp-sections/TopPlayersPromo.astro';
import type { TopPlayersFile } from '../../../types/top-players';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** The league's Top Players file; renders the homepage poster when set. */
  topPlayers?: TopPlayersFile | null;
  /** The document title. */
  title: string;
  /** The app-install banner's league name, or null to show no banner. */
  installBanner: { leagueName: string } | null;
  effectiveDate: Date;
  /** The preseason live-scoring test drive replaces the hero while it runs. */
  testDriveHero: boolean;
  hero: {
    state: any;
    liveScoring?: any;
    /** Monday's closest-game spotlight (monday-spotlight-props.ts). */
    mondaySpotlight?: any;
    backdrop?: any;
    /** Optional inputs some heroes read (the AFL's tier/standings slots). */
    config?: any;
    standings?: any[];
    userFranchiseId?: string;
  };
  /** The Owners' Poll pop-up, or null when the league's poll is not open now. */
  ownersPoll: { ballotHref: string; ballotStandings?: BallotStandingsRow[] } | null;
  /** Passed to QuickLinks; undefined leaves its default. */
  quickLinksAuthenticated?: boolean;
  /** QuickLinks' cards, for a league with no page-directory entries; omit to read the directory. */
  quickLinks?: QuickLinkPage[];
  /** WhatsNewRow's props, less `count` (always two); null for a league with no What's New page. */
  whatsNew: Record<string, unknown> | null;
  testMode: boolean;
  rail: {
    label: string;
    posts: SchefterPost[];
    isAuthenticated: boolean;
    userFranchiseId?: string;
    personalized?: any;
    forYouIds?: any;
    watching?: any;
    emptyText?: string;
  };
}

const {
  leagueSlug,
  topPlayers,
  title,
  installBanner,
  effectiveDate,
  testDriveHero,
  hero,
  ownersPoll,
  quickLinksAuthenticated,
  quickLinks,
  whatsNew,
  testMode,
  rail,
} = Astro.props;
---

<TheLeagueLayout title={title}>
  <div class="league-hp">
    {installBanner && <InstallAppPrompt variant="banner" leagueName={installBanner.leagueName} leagueSlug={leagueSlug} />}
    {/*
      DOM order is hero → rail → everything else, so a phone (one column)
      reads the news straight under the hero. On desktop the rail is placed
      in the right-hand column spanning both rows, which looks exactly as it
      did when it came last in the source.
    */}
    <section class="league-hp__lead" aria-labelledby="league-hp-hero-heading">
      <h2 id="league-hp-hero-heading" class="visually-hidden">League Overview</h2>

      {testDriveHero ? (
        <LiveScoringTestDrive slug={leagueSlug} referenceDate={effectiveDate} />
      ) : (
        <LeagueHero
          league={leagueSlug}
          state={hero.state}
          liveScoring={hero.liveScoring}
          mondaySpotlight={hero.mondaySpotlight}
          config={hero.config}
          standings={hero.standings}
          userFranchiseId={hero.userFranchiseId}
          backdrop={hero.backdrop}
        />
      )}
    </section>

    <aside class="league-hp__sidebar" aria-label={rail.label} tabindex="0">
      <SchefterFeedCompact
        posts={rail.posts}
        isAuthenticated={rail.isAuthenticated}
        userFranchiseId={rail.userFranchiseId}
        personalized={rail.personalized}
        forYouIds={rail.forYouIds}
        watching={rail.watching}
        emptyText={rail.emptyText}
      />
    </aside>

    <div class="league-hp__main">
      {ownersPoll && (
        <OwnersPollHomePopup
          leagueSlug={leagueSlug}
          ballotHref={ownersPoll.ballotHref}
          ballotStandings={ownersPoll.ballotStandings}
        />
      )}

      <slot name="snapshot" />
      <slot name="after-snapshot" />
      <slot name="standings" />
      {topPlayers && <TopPlayersPromo leagueSlug={leagueSlug} data={topPlayers} />}
      <slot name="extras" />

      <QuickLinks league={leagueSlug} isAuthenticated={quickLinksAuthenticated} pages={quickLinks} />

      <slot name="whats-next" />

      {whatsNew && <WhatsNewRow {...(whatsNew as any)} count={2} />}


      {testMode && (
        <div class="league-hp__debug" id="league-hp-debug">
          <div class="league-hp__debug-phase">
            <code>Hero: {hero.state.kind} · priority {hero.state.priority} · ref {effectiveDate.toISOString()}</code>
          </div>
        </div>
      )}
    </div>
  </div>
</TheLeagueLayout>

<style>
  .league-hp {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 2rem 1.5rem;
    align-items: start;
  }

  .league-hp__lead,
  .league-hp__main {
    grid-column: 1;
    min-width: 0;
  }

  .league-hp__main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Right-hand column, beside both the hero and the cards below it. */
  .league-hp__sidebar {
    grid-column: 2;
    grid-row: span 2;
    min-width: 0;
    position: sticky;
    top: 2rem;
    max-height: calc(100dvh - var(--header-height, 3.5rem) - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--sf-border, #e5e7eb) transparent;
    border-radius: var(--radius-lg, 0.75rem);
  }

  .league-hp__debug {
    margin-top: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-gray-50, #f9fafb);
    border: 1px dashed var(--content-border, #e2e8f0);
    border-radius: var(--radius-md, 0.5rem);
    font-size: var(--font-size-2xs);
    color: var(--color-gray-500, #6b7280);
  }

  @container (max-width: 1024px) {
    .league-hp {
      grid-template-columns: 1fr 320px;
      column-gap: 1rem;
    }
  }

  @container (max-width: 880px) {
    .league-hp {
      grid-template-columns: 1fr;
    }

    /* Stacked under the hero: the feed opens on three stories plus "Show
       more" (SchefterFeedCompact reads --sfc-stacked), so the owner's team
       card is still near the top of the page. */
    .league-hp__sidebar {
      grid-column: 1;
      grid-row: auto;
      position: static;
      max-height: none;
      overflow-y: visible;
      --sfc-stacked: 1;
    }

    /* Hold those three before the feed's script runs (it sets
       data-sfc-ready), so the page does not paint ten and then collapse. */
    .league-hp__sidebar :global(.sfc-feed:not([data-sfc-ready]) .sfc-feed__item:nth-child(n + 4)) {
      display: none;
    }
  }
</style>
