---
/**
 * WatchListBridge — My Watch List for pages whose main script cannot import.
 *
 * The free-agent pages drive their table from a `define:vars` script, which
 * is a CLASSIC script: no imports, so it cannot reach
 * src/utils/watch-list-client.ts directly. This component is the bridge:
 *
 * - exposes the store on `window.watchListStore` (same functions, same
 *   per-league cache, same `watchlist:change` event) for the classic script
 *   to read the watched set and re-render;
 * - mounts the shared PlayerActionModal and wires the delegated click for
 *   any `[data-pa-open]` button (the ⋮ kebab a row renders), opening the
 *   sheet with the Watch action built from the button's data attributes;
 * - warms the list on page load when the page says the viewer is signed in
 *   to THIS league (`signedIn`), so the first paint has the right marks;
 * - adds a Bid / Claim action to the sheet. This used to be derived by reading
 *   the row's own acquisition button out of the DOM, which worked only while
 *   the free-agent table HAD such a column. It no longer does — the claim moved
 *   into the player modal so it can be offered on every page — so the action is
 *   now built from two independent verdicts, and needs BOTH: the page says the
 *   player is a free agent IN THIS VIEW (`data-pa-claimable` on the ⋮ button,
 *   which in a duplicate-player league is a per-conference fact only the page
 *   knows), and src/utils/player-claim-client.ts says this VIEWER may claim
 *   him. A signed-out visitor gets the same option wired to sign-in, and the
 *   post-reload resume reopens the form on that player.
 *
 * Signed-in is the page's SSR decision — an owner logged into the other
 * league is "signed out" here, because MFL's watch list belongs to the
 * league the session is scoped to. The page computes it ONCE
 * (`franchiseIdForLeague` in src/utils/auth.ts) and this element's
 * `data-signed-in` is the only client-side copy: this module's `pageSignedIn`
 * and the page's own classic script both read it off the DOM, so the two
 * scripts cannot carry different verdicts (tests/free-agent-session.test.ts).
 */
import PlayerActionModal from './PlayerActionModal.astro';
import '../../styles/player-action-button.css';

interface Props {
  signedIn: boolean;
  /**
   * The league's word for an acquisition — 'Claim' (rolling priority) or
   * 'Bid' (blind bid). Resolved once per page by claimVerb() so the table
   * header, this sheet and the player modal cannot call it three things.
   */
  claimVerb?: 'Bid' | 'Claim';
  /**
   * The page renders a SignInModal and wants signed-out visitors offered the
   * claim through it, rather than nothing at all.
   */
  promptSignIn?: boolean;
}
const { signedIn, claimVerb = 'Claim', promptSignIn = false } = Astro.props;
---

<div
  id="watch-list-bridge"
  data-signed-in={signedIn ? 'true' : 'false'}
  data-claim-verb={claimVerb}
  data-prompt-signin={promptSignIn ? 'true' : 'false'}
  hidden
></div>
<PlayerActionModal />

<script>
  import {
    getWatchedIds, isWatched, loadWatchList, toggleWatch, getWatchListAuth, onWatchListChange,
  } from '../../utils/watch-list-client';
  import {
    buildWatchAction, openPlayerActionModal, requestSignIn, type PlayerActionSpec,
  } from '../../utils/player-actions';
  import { loadClaimContext, offerFor } from '../../utils/player-claim-client';
  import { rememberPendingClaim } from '../../utils/claim-resume';

  declare global {
    interface Window {
      watchListStore?: {
        getWatchedIds: typeof getWatchedIds;
        isWatched: typeof isWatched;
        loadWatchList: typeof loadWatchList;
        toggleWatch: typeof toggleWatch;
        getWatchListAuth: typeof getWatchListAuth;
        onWatchListChange: typeof onWatchListChange;
        requestSignIn: typeof requestSignIn;
        /** The page's SSR verdict for THIS league, re-read per page load. */
        isSignedIn: () => boolean;
      };
    }
  }

  /** Every page verdict is re-read off the DOM per call, never captured: a
   *  single module instance survives a ClientRouter navigation. */
  const bridgeEl = () => document.getElementById('watch-list-bridge');
  const pageSignedIn = () => bridgeEl()?.dataset.signedIn === 'true';
  const pageVerb = () => (bridgeEl()?.dataset.claimVerb === 'Bid' ? 'Bid' : 'Claim');
  const pagePromptsSignIn = () => bridgeEl()?.dataset.promptSignin === 'true';

  window.watchListStore = {
    getWatchedIds, isWatched, loadWatchList, toggleWatch, getWatchListAuth, onWatchListChange,
    requestSignIn,
    isSignedIn: pageSignedIn,
  };

  let delegationBound = false;

  /**
   * The acquisition action for a player, or null when there is none to offer.
   *
   * Two gates, and both must pass. The page's `data-pa-claimable` is the only
   * thing that knows whether he is a free agent IN THE VIEW being browsed;
   * the claim context is the only thing that knows whether THIS viewer has a
   * franchise here and a roster to drop from. Either one alone has shipped a
   * button that 400s.
   */
  function buildAcquireAction(player: {
    id: string; name: string; position: string | null; nflTeam: string | null;
    espnId: string | null; headshot: string | null;
  }, claimable: boolean, acqUrl: string, acqLabel: string): PlayerActionSpec | null {
    if (!claimable) return null;
    const verb = pageVerb();

    // MFL's own flow, when the page says that is the intended path — the
    // offseason auction's per-player Place Bid page, or a visitor we can offer
    // neither an in-place form nor a sign-in. Checked FIRST because it is the
    // page overriding the default, not a fallback: during auction season an
    // owner who could otherwise bid in place must still go to MFL.
    if (acqUrl) {
      return {
        id: 'acquire',
        label: `${acqLabel || verb} on MyFantasyLeague`,
        desc: 'Opens MFL in a new tab',
        icon: 'icon-gavel',
        closeFirst: true,
        run: async () => {
          window.open(acqUrl, '_blank', 'noopener');
          return { ok: true };
        },
      };
    }

    if (!pageSignedIn()) {
      // Same option, wired to sign-in. The player is parked so the reload
      // lands back on his claim form rather than on 600 anonymous rows.
      if (!pagePromptsSignIn()) return null;
      return {
        id: 'acquire',
        label: `Sign in to ${verb.toLowerCase()}`,
        desc: 'Sign in with MFL and we will bring you back here',
        icon: 'icon-gavel',
        closeFirst: true,
        run: async () => {
          rememberPendingClaim(player);
          requestSignIn();
          return { ok: true };
        },
      };
    }

    const offer = offerFor(player.id);
    if (!offer) return null;
    return {
      id: 'acquire',
      label: `${offer.verb} this player`,
      desc: offer.verb === 'Bid'
        ? 'Opens the bid form — you choose the amount and the drop there'
        : 'Opens the claim form — you choose the drop and confirm there',
      icon: 'icon-gavel',
      closeFirst: true,
      run: async () => {
        window.openWaiverClaim?.(player);
        return { ok: true };
      },
    };
  }

  function onDocumentClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-pa-open]');
    if (!btn) return;
    e.preventDefault();
    const d = btn.dataset;
    const id = d.paId || '';
    if (!id) return;
    const player = {
      id,
      name: d.paName || 'Player',
      position: d.paPos || null,
      nflTeam: d.paTeam || null,
      espnId: d.paEspn || null,
      headshot: d.paHeadshot || null,
      franchiseId: d.paFranchise || null,
      subText: d.paSub || null,
    };
    const claimable = d.paClaimable === 'true';
    const opened = openPlayerActionModal({
      player,
      actions: () => {
        const acquire = buildAcquireAction(
          { id, name: player.name, position: player.position, nflTeam: player.nflTeam,
            espnId: player.espnId, headshot: player.headshot },
          claimable,
          d.paAcqUrl || '',
          d.paAcqLabel || '',
        );
        const watch = buildWatchAction(id, { signedIn: pageSignedIn() && getWatchListAuth() !== 'signed-out' });
        return acquire ? [acquire, watch] : [watch];
      },
    });
    if (!opened && !pageSignedIn()) requestSignIn();
  }

  function init() {
    if (!bridgeEl()) return;
    if (pageSignedIn()) {
      void loadWatchList();
      // Warmed here rather than on first sheet open: this component only ships
      // on the free-agent pages, where the acquisition IS the point, and
      // `actions()` is built synchronously when the sheet opens — an unresolved
      // context would render the sheet without its Claim option and never
      // revisit it.
      void loadClaimContext();
    }
    if (!delegationBound) {
      delegationBound = true;
      document.addEventListener('click', onDocumentClick);
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
