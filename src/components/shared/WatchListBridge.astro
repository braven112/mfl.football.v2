---
/**
 * WatchListBridge — My Watch List for pages whose main script cannot import.
 *
 * The free-agent pages drive their table from a `define:vars` script, which
 * is a CLASSIC script: no imports, so it cannot reach
 * src/utils/watch-list-client.ts directly. This component is the bridge:
 *
 * - exposes the store on `window.watchListStore` (same functions, same
 *   per-league cache, same `watchlist:change` event) for the classic script
 *   to read the watched set and re-render;
 * - mounts the shared PlayerActionModal and wires the delegated click for
 *   any `[data-pa-open]` button (the ⋮ kebab a row renders), opening the
 *   sheet with the Watch action built from the button's data attributes;
 * - warms the list on page load when the page says the viewer is signed in
 *   to THIS league (`signedIn`), so the first paint has the right marks;
 * - adds a Bid / Claim action to the sheet, derived from the row's OWN
 *   acquisition button (`.col-fa-action .place-bid-link`) so the sheet never
 *   re-decides who may claim: a `.claim-open` button opens the waiver claim
 *   form, a `[data-signin-open]` one hands off to sign-in, and an MFL deep
 *   link (auction season) navigates. No button, no action — a rostered
 *   player's sheet is Watch alone.
 *
 * Signed-in is the page's SSR decision — an owner logged into the other
 * league is "signed out" here, because MFL's watch list belongs to the
 * league the session is scoped to. The page computes it ONCE
 * (`franchiseIdForLeague` in src/utils/auth.ts) and this element's
 * `data-signed-in` is the only client-side copy: this module's `pageSignedIn`
 * and the page's own classic script both read it off the DOM, so the two
 * scripts cannot carry different verdicts (tests/free-agent-session.test.ts).
 */
import PlayerActionModal from './PlayerActionModal.astro';
import '../../styles/player-action-button.css';

interface Props {
  signedIn: boolean;
}
const { signedIn } = Astro.props;
---

<div id="watch-list-bridge" data-signed-in={signedIn ? 'true' : 'false'} hidden></div>
<PlayerActionModal />

<script>
  import {
    getWatchedIds, isWatched, loadWatchList, toggleWatch, getWatchListAuth, onWatchListChange,
  } from '../../utils/watch-list-client';
  import {
    buildWatchAction, openPlayerActionModal, requestSignIn, type PlayerActionSpec,
  } from '../../utils/player-actions';

  declare global {
    interface Window {
      watchListStore?: {
        getWatchedIds: typeof getWatchedIds;
        isWatched: typeof isWatched;
        loadWatchList: typeof loadWatchList;
        toggleWatch: typeof toggleWatch;
        getWatchListAuth: typeof getWatchListAuth;
        onWatchListChange: typeof onWatchListChange;
        requestSignIn: typeof requestSignIn;
        /** The page's SSR verdict for THIS league, re-read per page load. */
        isSignedIn: () => boolean;
      };
    }
  }

  const pageSignedIn = () =>
    document.getElementById('watch-list-bridge')?.dataset.signedIn === 'true';

  window.watchListStore = {
    getWatchedIds, isWatched, loadWatchList, toggleWatch, getWatchListAuth, onWatchListChange,
    requestSignIn,
    isSignedIn: pageSignedIn,
  };

  let delegationBound = false;

  /**
   * The acquisition action for a row, or null when the row offers none.
   * Reads the button the page already rendered rather than the page's
   * claim rules — the page is the authority on who may claim what.
   */
  const acquireButtonFor = (playerId: string) =>
    document.querySelector<HTMLElement>(
      `#player-table-body tr[data-player-id="${CSS.escape(playerId)}"] .col-fa-action .place-bid-link`,
    );

  function buildAcquireAction(playerId: string): PlayerActionSpec | null {
    const el = acquireButtonFor(playerId);
    if (!el) return null;
    const label = (el.textContent || '').replace(/[↗\u2197]/g, '').trim() || 'Bid';
    // "Claim this player" / "Bid on this player" — the page's own verb.
    const verbLabel = /^claim$/i.test(label) ? 'Claim this player' : `${label} on this player`;
    const isClaim = el.classList.contains('claim-open');
    const isSignIn = el.hasAttribute('data-signin-open');
    const isLink = !!el.getAttribute('href');
    if (!isClaim && !isSignIn && !isLink) return null;
    return {
      id: 'acquire',
      label: isLink ? `${label} on MyFantasyLeague` : verbLabel,
      desc: isClaim
        ? 'Opens the claim form — you choose the drop and confirm there'
        : isSignIn
          ? 'Sign in to file a claim'
          : 'Opens MFL in a new tab',
      icon: 'icon-gavel',
      closeFirst: true,
      // Click the row's button as it exists NOW, not the one captured when
      // the sheet opened: a Watch toggle re-renders every row, and a captured
      // node is detached by the time this runs. Clicking the live button also
      // keeps each branch on the page's own path — WaiverClaimModal's
      // delegated `.claim-open` listener, SignInModal's `[data-signin-open]`
      // listener (which parks the player for the post-login claim resume),
      // or the anchor's own navigation.
      run: async () => {
        const live = acquireButtonFor(playerId);
        if (live) live.click();
        else if (isSignIn) requestSignIn();
        return { ok: true };
      },
    };
  }

  function onDocumentClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-pa-open]');
    if (!btn) return;
    e.preventDefault();
    const d = btn.dataset;
    const id = d.paId || '';
    if (!id) return;
    const player = {
      id,
      name: d.paName || 'Player',
      position: d.paPos || null,
      nflTeam: d.paTeam || null,
      espnId: d.paEspn || null,
      headshot: d.paHeadshot || null,
      franchiseId: d.paFranchise || null,
      subText: d.paSub || null,
    };
    const opened = openPlayerActionModal({
      player,
      actions: () => {
        const acquire = buildAcquireAction(id);
        const watch = buildWatchAction(id, { signedIn: pageSignedIn() && getWatchListAuth() !== 'signed-out' });
        return acquire ? [acquire, watch] : [watch];
      },
    });
    if (!opened && !pageSignedIn()) requestSignIn();
  }

  function init() {
    if (!document.getElementById('watch-list-bridge')) return;
    if (pageSignedIn()) void loadWatchList();
    if (!delegationBound) {
      delegationBound = true;
      document.addEventListener('click', onDocumentClick);
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
