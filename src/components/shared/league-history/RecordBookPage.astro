---
/**
 * Record Book — every league record, shared by TheLeague and the AFL.
 *
 * Boards come from `recordBook()` (src/utils/league-history/records.mjs) over
 * the League History dataset the route imports. Every board MFLHistory.com
 * shows is here (single game, season, career, postseason, milestones); what
 * this page adds is the Trophy Room presentation: the record holder on a
 * plaque, the three chasing them as tiles, the rest as ranked bars.
 *
 * Grouped by OWNER (the product default, Brandon 2026-10-24), so a career
 * follows the person across franchise slots and a slot's earlier owner keeps
 * theirs.
 *
 * Every board also gets three charts (record-charts.mjs): the gap (the
 * default) and where it sits, switched by pills, beside the highlighted
 * "how the record grew" history (Brandon, 2026-10-25).
 *
 * Also (Brandon, 2026-10-25): the signed-in owner's own results light up in
 * their team color, every dot opens its game, season or owner, a season in
 * progress gets a "record watch" when a team is on pace for a season board,
 * a record saves as a share card (/api/og/league-history/record.png), and an
 * era pill reads the whole book over the last ten seasons.
 *
 * Federation FFL ideas (Brandon, 2026-11-07): every row names the round,
 * the opponent and what they scored, every season row says how that season
 * finished, a row set in the latest season wears "New" ("New record" at #1),
 * the Season boards add All-Play and luck, and an All-time standings view
 * sorts every owner's record by any column (cards with sort pills on phones).
 *
 * Zero client JS: era, category, scope, board and chart are all URL params
 * switched by links (pills filter the same leaderboard, so they are pills, not
 * tabs), and every view is bookmarkable. The charts are server-drawn SVG.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import HistoryTabs from './HistoryTabs.astro';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { teamAccentVar } from '../../../utils/team-accent-css';
import { franchiseIdForLeague, getAuthUser } from '../../../utils/auth';
import { canonicalRivalryPair } from '../../../utils/rivalries';
import {
  CATEGORIES,
  SCOPES,
  STANDINGS_SORTS,
  historyEras,
  paceSeries,
  recordBook,
  sortStandings,
} from '../../../utils/league-history/records.mjs';
import { gapChart, historyChart, paceChart, seasonBarChart, spreadChart } from '../../../utils/league-history/record-charts.mjs';
import '../../../styles/record-charts.css';

interface Row {
  value: number;
  display: string;
  name: string;
  icon: string | null;
  owner: string | null;
  context: string;
  rank: number;
  unit?: string;
  year?: number;
  franchiseId?: string;
  opponentId?: string;
  isNew?: boolean;
  isNewRecord?: boolean;
  entity: { key: string; name: string; franchiseId: string | null; ownerSlug: string | null };
}
interface StandingsRow {
  rank: number;
  entity: { key: string; name: string; franchiseId: string | null; ownerSlug: string | null };
  name: string;
  team: string | null;
  icon: string | null;
  seasons: number;
  span: string;
  w: number;
  l: number;
  t: number;
  pctDisplay: string;
  pfDisplay: string;
  titles: number;
  finals: number;
  playoffs: number;
  bestDisplay: string;
}
interface Watch {
  name: string;
  owner: string | null;
  franchiseId: string;
  projected: number;
  display: string;
  unit: string;
  rank: number;
  record: Row;
  played: number;
  full: number;
  year: number;
  weeks: number;
  fullWeeks: number;
}
interface HistoryData {
  seasons: Array<{ y: number; teams: Record<string, { h: string }> }>;
}
interface Board {
  id: string;
  label: string;
  title: string;
  note?: string;
  asc: boolean;
  population: Array<Array<number | string | null>>;
  rows: Row[];
}

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  data: unknown;
  /** The league's keeper-history file, which adds the Keepers boards (utils/league-history/keepers.mjs). */
  keepers?: unknown;
  /** The league's pick-trades file, which adds the Draft picks board (utils/league-history/pick-trades.mjs). */
  picks?: unknown;
}

const { leagueSlug, data, keepers = null, picks = null } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);
const BASE = '/history/record-book';

const SCOPE_LABEL: Record<string, string> = {
  all: 'All games',
  regular: 'Regular season',
  playoffs: 'Playoffs',
};

const params = Astro.url.searchParams;
const eras = historyEras(data, league.historyEras ?? []);
const era = eras.find((e) => e.id === params.get('era')) ?? eras[0];
const book = recordBook(data, { from: era.from, keepers, picks });
const facts = book.facts();
const categories = book.categories as Array<(typeof CATEGORIES)[number] & { table?: boolean }>;
const category = categories.find((c) => c.id === params.get('cat')) ?? categories[0];
const scopeParam = params.get('scope') ?? 'all';
const scope = category.scoped && SCOPES.includes(scopeParam) ? scopeParam : 'all';
const boards = book.category(category.id, scope) as Board[];
const board = boards.find((b) => b.id === params.get('board')) ?? boards[0];

const CHARTS = [
  { id: 'gap', label: 'The gap', draw: gapChart },
  { id: 'spread', label: 'Where it sits', draw: spreadChart },
];
const chartView = CHARTS.find((c) => c.id === params.get('chart')) ?? CHARTS[0];
// Two drawing widths, because an SVG scales its text with it. A phone's chart
// column is only 250-305px wide, so the 400 drawing shrank its labels to ~0.7x
// (Brandon, 2026-10-25: too small to read). The phone drawing is about as wide
// as that column, so its labels show near their real size; CSS picks one.
const CHART_W = 400;
const CHART_W_PHONE = 290;

// The viewer's own results: the holding (owner, or co-owners) of their
// franchise in the latest season, matched against every entity key, so an
// owner who moved slots still finds every season of theirs.
const viewerFranchise = franchiseIdForLeague(getAuthUser(Astro.request), league.id);
const latestSeason = (data as HistoryData).seasons.at(-1);
const myHolding = viewerFranchise ? (latestSeason?.teams[viewerFranchise]?.h ?? `slot:${viewerFranchise}`) : null;
const myIds = new Set(myHolding ? myHolding.split('+') : []);
const mine = (key: string | null | undefined) => !!key && key.split('+').some((id) => myIds.has(id));

// Where a dot or row opens: a game's head-to-head page, a season's franchise
// page, a career's owner page.
const entityHref = (key: string | null | undefined) => {
  if (!key) return null;
  const e = book.ix.entity(key);
  return e.ownerSlug ? r(`/owners/${e.ownerSlug}`) : e.franchiseId ? r(`/franchises/${e.franchiseId}`) : null;
};
const rowHref = (row: Row) => {
  if (row.franchiseId && row.opponentId) return r(`/rivalries/${canonicalRivalryPair(row.franchiseId, row.opponentId)}`);
  if (row.franchiseId && row.year != null) return r(`/franchises/${row.franchiseId}`);
  return entityHref(row.entity.key);
};

const watches = book.watch() as Record<string, Watch[]>;
const boardWatch = (board && watches[board.id]) || [];
const chartOpts = { mine, href: rowHref, entityHref, watch: boardWatch };
const chart = board ? chartView.draw(board, CHART_W, chartOpts) : null;
const chartPhone = board ? chartView.draw(board, CHART_W_PHONE, chartOpts) : null;
// A board that carries a per-season count (Draft picks) shows it in place of
// the record's history, which says little for a board ranked by draft year.
const series = (board as Board & { series?: Array<{ season: number; count: number }> })?.series ?? null;
const history = series ? seasonBarChart(series, CHART_W) : board ? historyChart(board, CHART_W, chartOpts) : null;
const historyPhone = series ? seasonBarChart(series, CHART_W_PHONE) : board ? historyChart(board, CHART_W_PHONE, chartOpts) : null;
const youOnBoard = !!board?.population.some((p) => mine(p[4] as string | null));
const historyBySeason = !!board?.population.length && board.population.every((p) => p[1] != null);

/** A view's URL, leaving defaults out so the plain page stays the plain URL. */
const viewHref = (next: {
  cat?: string;
  scope?: string;
  board?: string;
  chart?: string;
  hash?: string;
  era?: string;
  sort?: string;
  dir?: string;
}) => {
  const q = new URLSearchParams();
  const eraId = next.era ?? era.id;
  if (eraId !== eras[0].id) q.set('era', eraId);
  const cat = next.cat ?? category.id;
  if (cat !== CATEGORIES[0].id) q.set('cat', cat);
  const sc = next.scope ?? 'all';
  if (sc !== 'all') q.set('scope', sc);
  if (next.board) q.set('board', next.board);
  if (next.chart && next.chart !== CHARTS[0].id) q.set('chart', next.chart);
  if (next.sort) q.set('sort', next.sort);
  if (next.dir) q.set('dir', next.dir);
  const qs = q.toString();
  return `${qs ? `${r(BASE)}?${qs}` : r(BASE)}${next.hash ? `#${next.hash}` : ''}`;
};

const rows = board?.rows ?? [];
const leader = rows[0];
const tiedAtTop = rows.filter((row) => row.rank === 1).length;
const chasers = rows.slice(1, 4);
const rest = rows.slice(4);

// Bars rank the shown rows against each other: the leader fills the track and
// the tenth place still shows a stub, whichever direction the board sorts.
const best = rows[0]?.value ?? 0;
const worst = rows[rows.length - 1]?.value ?? 0;
const barWidth = (value: number) =>
  best === worst ? 100 : Math.round(35 + (65 * (value - worst)) / (best - worst));

const ownerHref = (row: Row) => (row.entity.ownerSlug ? r(`/owners/${row.entity.ownerSlug}`) : null);
const accent = (row: Row) =>
  row.entity.franchiseId ? teamAccentVar(row.entity.franchiseId, 'var(--history-gold)') : 'var(--history-gold)';
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join('');
const sub = (row: Row) => [row.owner, row.context].filter(Boolean).join(' · ');
const unit = (row: Row) => (row.unit ? ` ${row.unit}` : '');

const others = boards.filter((b) => b.id !== board?.id && b.rows.length);

// "On pace" wording: equal to the record ties it, better breaks it.
const paceLine = (w: Watch) => {
  const verdict =
    w.rank > 1
      ? `which would rank #${w.rank}`
      : w.projected === w.record.value
        ? `which would tie the record (${w.record.display})`
        : `which would break the record (${w.record.display})`;
  return `on pace for ${w.display}${w.unit ? ` ${w.unit}` : ''}, ${verdict}`;
};
// On pace (Brandon, 2026-10-26: a chart, not an alert, "very clear what was
// projected and what was real"): the season so far against the record, for
// every season board someone is on pace to break or tie, plus the board in
// view when it has a top-ten pace. The board in view comes first.
const seasonBoards = book.category('season') as Board[];
const paceBoards = seasonBoards.filter(
  (b) => (watches[b.id] ?? []).some((w) => w.rank === 1) || (b.id === board?.id && (watches[b.id] ?? []).length > 0),
);
paceBoards.sort((a, b) => Number(b.id === board?.id) - Number(a.id === board?.id));
const paceCharts = paceBoards.slice(0, 3).flatMap((b) => {
  const w = watches[b.id][0];
  const series = paceSeries(book.ix, b.id, w);
  if (!series) return [];
  const pace = {
    ...series,
    name: w.name,
    display: `${w.display}${w.unit ? ` ${w.unit}` : ''}`,
    recordValue: w.record.value,
    recordDisplay: w.record.display,
    recordLabel: [w.record.name, w.record.year].filter(Boolean).join(', '),
  };
  const wide = paceChart(pace, CHART_W);
  if (!wide) return [];
  return [{ board: b, watch: w, line: paceLine(w), wide, phone: paceChart(pace, CHART_W_PHONE) ?? wide }];
});

const shareHref = (() => {
  const q = new URLSearchParams({ league: league.slug, cat: category.id, board: board?.id ?? '' });
  if (scope !== 'all') q.set('scope', scope);
  if (era.id !== eras[0].id) q.set('era', era.id);
  return `/api/og/league-history/record.png?${q}`;
})();
// All-time standings: sorted on the server by a URL param, like every other
// view here. A tap on the sorted column reverses it, a second tap resets to the
// default (the phone sort pills' rule, rosters/phone-sort.ts nextSort).
const DEFAULT_SORT = STANDINGS_SORTS[0];
const sortSpec = STANDINGS_SORTS.find((s) => s.key === params.get('sort')) ?? DEFAULT_SORT;
const dirParam = params.get('dir');
const sortDir: 'asc' | 'desc' = dirParam === 'asc' || dirParam === 'desc' ? dirParam : (sortSpec.dir as 'asc' | 'desc');
const standings: StandingsRow[] = category.table
  ? (sortStandings(book.standings(), sortSpec.key, sortDir) as StandingsRow[])
  : [];
const anyTies = standings.some((row) => row.t > 0);
const sortHref = (key: string) => {
  const spec = STANDINGS_SORTS.find((s) => s.key === key)!;
  if (key !== sortSpec.key) return viewHref({ sort: key === DEFAULT_SORT.key ? undefined : key, hash: 'rb-standings' });
  if (sortDir === spec.dir) {
    return viewHref({ sort: key, dir: spec.dir === 'desc' ? 'asc' : 'desc', hash: 'rb-standings' });
  }
  return viewHref({ hash: 'rb-standings' });
};
const sortState = (key: string) => (key === sortSpec.key ? (sortDir === 'asc' ? 'ascending' : 'descending') : undefined);
const arrow = (key: string) => (key === sortSpec.key ? (sortDir === 'asc' ? '↑' : '↓') : '');
const STANDINGS_LABEL: Record<string, string> = {
  w: 'Wins',
  l: 'Losses',
  pct: 'Win %',
  seasons: 'Seasons',
  pf: 'Points',
  titles: 'Titles',
  finals: 'Finals',
  playoffs: 'Playoffs',
  best: 'Best finish',
};

// Each row's cell text, keyed by column, and whether a column is the sorted one.
const standingsView = standings.map((row) => ({
  row,
  values: {
    w: row.w, pct: row.pctDisplay, l: row.l, t: row.t, seasons: row.seasons, pf: row.pfDisplay,
    titles: row.titles || '–', finals: row.finals || '–', playoffs: row.playoffs || '–',
  } as Record<string, string | number>,
}));
const cell = (key: string) => (key === sortSpec.key ? '' : undefined);

// Table columns in reading order; T only when some owner has a tie.
const COLUMNS = ['seasons', 'w', 'l', ...(anyTies ? ['t'] : []), 'pct', 'pf', 'titles', 'finals', 'playoffs'];
const COLUMN_HEAD: Record<string, string> = {
  seasons: 'Seasons', w: 'W', l: 'L', t: 'T', pct: 'Pct', pf: 'Pts', titles: 'Titles', finals: 'Finals', playoffs: 'Playoffs',
};
const SORTABLE = new Set(STANDINGS_SORTS.map((s) => s.key));
// The phone's sort pills lead with what owners argue about.
const PILL_ORDER = ['w', 'pct', 'titles', 'playoffs', 'finals', 'best', 'seasons', 'pf', 'l'];
const sortPills = PILL_ORDER.map((k) => STANDINGS_SORTS.find((s) => s.key === k)!).filter(Boolean);

const pageTitle = `Record Book · ${league.name}`;
const span = facts.firstSeason && facts.lastSeason ? `${facts.firstSeason} to ${facts.lastSeason}` : '';
---

<TheLeagueLayout title={pageTitle}>
  <div class="rb">
    <Breadcrumbs
      items={[
        { label: league.name, href: `/${league.slug}` },
        { label: 'History', href: `/${league.slug}/history` },
        { label: 'Record Book' },
      ]}
    />

    <header class="rb-head">
      <p class="rb-kicker">League history · {span}</p>
      <h1 class="rb-title">Record Book</h1>
      <p class="rb-facts">
        <span><b>{facts.seasons}</b> seasons</span>
        <span><b>{facts.games.toLocaleString('en-US')}</b> games</span>
        <span><b>{facts.champions}</b> different champions</span>
      </p>
      {eras.length > 1 && (
        <ul class="ui-pills rb-pills rb-pills--era" aria-label="Seasons counted">
          {eras.map((e) => (
            <li>
              <a
                class="ui-pill"
                href={viewHref({ era: e.id, scope, board: board?.id, chart: chartView.id })}
                aria-current={e.id === era.id ? 'true' : undefined}
              >
                {e.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>


    <HistoryTabs leagueSlug={league.slug} current="record-book" />

    <nav class="rb-nav" aria-label="Record categories">
      <ul class="ui-pills rb-pills">
        {categories.map((c) => (
          <li>
            <a class="ui-pill" href={viewHref({ cat: c.id })} aria-current={c.id === category.id ? 'page' : undefined}>
              {c.label}
            </a>
          </li>
        ))}
      </ul>
      {category.scoped && (
        <ul class="ui-pills rb-pills rb-pills--scope" aria-label="Games counted">
          {SCOPES.map((s) => (
            <li>
              <a
                class="ui-pill"
                href={viewHref({ scope: s, board: board?.id, chart: chartView.id })}
                aria-current={s === scope ? 'true' : undefined}
              >
                {SCOPE_LABEL[s]}
              </a>
            </li>
          ))}
        </ul>
      )}
    </nav>

    {category.table ? (
    <section class="rb-board rb-standings" id="rb-standings" aria-labelledby="rb-standings-title"
      style={viewerFranchise ? `--rb-mine: ${teamAccentVar(viewerFranchise, 'var(--history-gold)')}` : undefined}>
      <h2 class="rb-board__title" id="rb-standings-title">All-time standings</h2>
      <p class="rb-board__note">
        Regular season, every season{era.from ? ` since ${era.from}` : ''}. Titles, finals and playoff trips count finished seasons.
      </p>
      <ul class="ui-pills rb-pills rb-pills--sort" aria-label="Sort by">
        {sortPills.map((s) => (
          <li>
            <a class="ui-pill" href={sortHref(s.key)} aria-current={s.key === sortSpec.key ? 'true' : undefined}>
              {STANDINGS_LABEL[s.key]}{arrow(s.key) && <span aria-hidden="true"> {arrow(s.key)}</span>}
              {s.key === sortSpec.key && <span class="visually-hidden">, sorted {sortState(s.key)}</span>}
            </a>
          </li>
        ))}
      </ul>
      <table class="ui-table rb-table">
        <thead>
          <tr>
            <th scope="col" class="rb-table__rank">#</th>
            <th scope="col" class="rb-table__who">Owner</th>
            {COLUMNS.map((key) => (
              <th scope="col" class="rb-table__num" aria-sort={sortState(key)} data-sorted={key === sortSpec.key ? '' : undefined}>
                {SORTABLE.has(key) ? (
                  <a href={sortHref(key)}>{COLUMN_HEAD[key]}{arrow(key) && <span aria-hidden="true">{arrow(key)}</span>}</a>
                ) : (
                  COLUMN_HEAD[key]
                )}
              </th>
            ))}
            <th scope="col" class="rb-table__best" aria-sort={sortState('best')} data-sorted={sortSpec.key === 'best' ? '' : undefined}>
              <a href={sortHref('best')}>Best finish{arrow('best') && <span aria-hidden="true">{arrow('best')}</span>}</a>
            </th>
          </tr>
        </thead>
        <tbody>
          {standingsView.map(({ row, values }) => (
              <tr class:list={['rb-table__row', { 'rb-mine': mine(row.entity.key) }]}
                style={`--rb-team: ${row.entity.franchiseId ? teamAccentVar(row.entity.franchiseId, 'var(--history-gold)') : 'var(--history-gold)'}`}>
                <td class="rb-table__rank">{row.rank}</td>
                <th scope="row" class="rb-table__who">
                  <span class="rb-table__whobox">
                  <span class="rb-table__phone-rank" aria-hidden="true">{row.rank}</span>
                  {row.icon ? (
                    <img class="rb-table__logo" src={row.icon} alt="" width="28" height="28" loading="lazy" />
                  ) : (
                    <span class="rb-table__logo rb-row__logo--blank" aria-hidden="true">{initials(row.name)}</span>
                  )}
                  <span class="rb-table__names">
                    <span class="rb-table__name">
                      {row.entity.ownerSlug ? <a href={r(`/owners/${row.entity.ownerSlug}`)}>{row.name}</a> : row.name}
                    </span>
                    <span class="rb-table__team">{[row.team, row.span].filter(Boolean).join(' · ')}</span>
                  </span>
                  </span>
                </th>
                {COLUMNS.map((key) => (
                  <td class="rb-table__num" data-label={STANDINGS_LABEL[key] ?? 'Ties'} data-sorted={cell(key)}>{values[key]}</td>
                ))}
                <td class="rb-table__best" data-label="Best finish" data-sorted={cell('best')}>{row.bestDisplay || '–'}</td>
              </tr>
          ))}
        </tbody>
      </table>
    </section>
    ) : (
    <section
      class="rb-board"
      aria-labelledby="rb-board-title"
      style={viewerFranchise ? `--rb-mine: ${teamAccentVar(viewerFranchise, 'var(--history-gold)')}` : undefined}
    >
      <ul class="ui-pills rb-pills rb-pills--boards" aria-label="Records">
        {boards.map((b) => (
          <li>
            <a
              class="ui-pill"
              href={viewHref({ scope, board: b.id, chart: chartView.id })}
              aria-current={b.id === board?.id ? 'true' : undefined}
            >
              {b.label}
            </a>
          </li>
        ))}
      </ul>

      <h2 class="rb-board__title" id="rb-board-title">
        {board?.title ?? 'No records yet'}
        {category.scoped && scope !== 'all' && <span class="rb-board__scope"> · {SCOPE_LABEL[scope]}</span>}
      </h2>
      {board?.note && <p class="rb-board__note">{board.note}</p>}


      {leader ? (
        <div class="rb-layout">
          <article class:list={['rb-plaque', { 'rb-mine': mine(leader.entity.key) }]} style={`--rb-team: ${accent(leader)}`}>
            <p class="rb-plaque__label">{tiedAtTop > 1 ? `Record · shared by ${tiedAtTop}` : 'The record'}</p>
            {leader.isNew && <p class="rb-new rb-new--record rb-plaque__new">{leader.isNewRecord ? 'New record' : 'New'}</p>}
            {leader.icon ? (
              <img class="rb-plaque__logo" src={leader.icon} alt="" width="88" height="88" loading="eager" />
            ) : (
              <span class="rb-plaque__logo rb-plaque__logo--blank" aria-hidden="true">{initials(leader.name)}</span>
            )}
            <p class="rb-plaque__value">
              {leader.display}
              {leader.unit && <span class="rb-plaque__unit">{leader.unit}</span>}
            </p>
            <p class="rb-plaque__name">
              {ownerHref(leader) ? <a href={ownerHref(leader)}>{leader.name}</a> : leader.name}
            </p>
            <p class="rb-plaque__context">{sub(leader)}</p>
            <a class="cta cta--ghost rb-share" href={shareHref} download={`${board.id}.png`}>Save as image</a>
          </article>

          {chart && (
            <figure class="rb-viz" id="rb-viz">
              <ul class="ui-pills rb-pills rb-pills--charts" aria-label="Chart">
                {CHARTS.map((c) => (
                  <li>
                    <a
                      class="ui-pill"
                      href={viewHref({ scope, board: board.id, chart: c.id, hash: 'rb-viz' })}
                      aria-current={c.id === chartView.id ? 'true' : undefined}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="rb-viz__plot rb-viz__plot--phone" set:html={chartPhone?.svg ?? chart.svg} />
              <div class="rb-viz__plot rb-viz__plot--wide" set:html={chart.svg} />
              <figcaption class="rb-viz__take">{chart.take}</figcaption>
            </figure>
          )}

          {history && (
            <figure class="rb-story">
              <p class="rb-story__kicker">{series ? 'By season' : historyBySeason ? 'How the record grew' : 'Everyone on the board'}</p>
              <p class="rb-story__title">
                {series ? 'Picks traded each season' : historyBySeason ? 'Every result, season by season' : 'The whole league on one line'}
              </p>
              <div class="rb-viz__plot rb-viz__plot--phone" set:html={historyPhone?.svg ?? history.svg} />
              <div class="rb-viz__plot rb-viz__plot--wide" set:html={history.svg} />
              <figcaption class="rb-viz__take">{history.take}</figcaption>
              {!series && <p class="rb-story__legend">
                {historyBySeason && (
                  <span class="rb-legend"><span class="rb-key rb-key--line"></span> The record at the time</span>
                )}
                <span class="rb-legend"><span class="rb-key rb-key--dot"></span> Top 10</span>
                {youOnBoard && <span class="rb-legend"><span class="rb-key rb-key--mine"></span> Your results</span>}
                {boardWatch.length > 0 && historyBySeason && (
                  <span class="rb-legend"><span class="rb-key rb-key--watch"></span> On pace this season</span>
                )}
              </p>}
            </figure>
          )}

          <div class="rb-list">
          {chasers.length > 0 && (
            <ol class="rb-chasers" aria-label="Next on the list">
              {chasers.map((row) => (
                <li class:list={['rb-tile', { 'rb-mine': mine(row.entity.key) }]} style={`--rb-team: ${accent(row)}`}>
                  <span class="rb-tile__rank">{row.rank}</span>
                  {row.icon ? (
                    <img class="rb-tile__logo" src={row.icon} alt="" width="40" height="40" loading="lazy" />
                  ) : (
                    <span class="rb-tile__logo rb-tile__logo--blank" aria-hidden="true">{initials(row.name)}</span>
                  )}
                  <span class="rb-tile__value">{row.display}<span class="visually-hidden">{unit(row)}</span></span>
                  <span class="rb-tile__name">
                    {ownerHref(row) ? <a href={ownerHref(row)}>{row.name}</a> : row.name}
                  </span>
                  <span class="rb-tile__context">{sub(row)}</span>
                  {row.isNew && <span class:list={['rb-new', { 'rb-new--record': row.isNewRecord }]}>{row.isNewRecord ? 'New record' : 'New'}</span>}
                </li>
              ))}
            </ol>
          )}

          {rest.length > 0 && (
            <ol class="rb-rows" aria-label="The rest of the top ten">
              {rest.map((row) => (
                <li
                  class:list={['rb-row', { 'rb-mine': mine(row.entity.key) }]}
                  style={`--rb-team: ${accent(row)}; --rb-bar: ${barWidth(row.value)}%`}
                >
                  <span class="rb-row__rank">{row.rank}</span>
                  {row.icon ? (
                    <img class="rb-row__logo" src={row.icon} alt="" width="28" height="28" loading="lazy" />
                  ) : (
                    <span class="rb-row__logo rb-row__logo--blank" aria-hidden="true">{initials(row.name)}</span>
                  )}
                  <span class="rb-row__body">
                    <span class="rb-row__name">
                      {ownerHref(row) ? <a href={ownerHref(row)}>{row.name}</a> : row.name}
                      {row.isNew && <span class:list={['rb-new', { 'rb-new--record': row.isNewRecord }]}>{row.isNewRecord ? 'New record' : 'New'}</span>}
                    </span>
                    <span class="rb-row__context">{sub(row)}</span>
                    <span class="rb-row__bar" aria-hidden="true"></span>
                  </span>
                  <span class="rb-row__value">{row.display}<span class="visually-hidden">{unit(row)}</span></span>
                </li>
              ))}
            </ol>
          )}
          </div>
        </div>
      ) : (
        <p class="rb-empty">Nothing on this board yet.</p>
      )}
    </section>
    )}

    {!category.table && paceCharts.length > 0 && (
      <section class="rb-pace" aria-labelledby="rb-pace-title">
        <p class="rb-pace__kicker">Record watch · {latestSeason?.y}</p>
        <h2 class="rb-pace__title" id="rb-pace-title">On pace</h2>
        <div class="rb-pace__grid">
          {paceCharts.map(({ board: b, watch: w, line, wide, phone }) => (
            <figure class="ui-card rb-pace__card" style={`--rb-team: ${teamAccentVar(w.franchiseId, 'var(--history-gold)')}`}>
              <p class="rb-pace__board">
                <a href={viewHref({ cat: 'season', board: b.id, hash: 'rb-board-title' })}>{b.title}</a>
              </p>
              <p class="rb-pace__who">
                <b>{w.name}</b>{w.owner && ` (${w.owner})`} is {line}.
              </p>
              <div class="rb-viz__plot rb-viz__plot--phone" set:html={phone.svg} />
              <div class="rb-viz__plot rb-viz__plot--wide" set:html={wide.svg} />
              <p class="rb-pace__legend">
                <span class="rb-legend"><span class="rb-key rb-key--real"></span> Played</span>
                <span class="rb-legend"><span class="rb-key rb-key--proj"></span> Projected</span>
                <span class="rb-legend"><span class="rb-key rb-key--target"></span> The record</span>
                {wide.holder && <span class="rb-legend"><span class="rb-key rb-key--line"></span> Record holder's season</span>}
              </p>
              <figcaption class="rb-viz__take">{wide.take} {w.played} of {w.full} games played.</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {!category.table && others.length > 0 && (
      <section class="rb-more" aria-labelledby="rb-more-title">
        <h2 class="rb-more__title" id="rb-more-title">More {category.label.toLowerCase()} records</h2>
        <ul class="rb-more__grid">
          {others.map((b) => {
            const top = b.rows[0];
            return (
              <li>
                <a class="rb-holder" href={viewHref({ scope, board: b.id })} style={`--rb-team: ${accent(top)}`}>
                  <span class="rb-holder__label">{b.title}</span>
                  {top.isNewRecord && <span class="rb-new rb-new--record">New record</span>}
                  <span class="rb-holder__value">
                    {top.display}{top.unit && <small> {top.unit}</small>}
                  </span>
                  <span class="rb-holder__name">{top.name}</span>
                  <span class="rb-holder__context">{top.context}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</TheLeagueLayout>

<style>
  .rb {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
    color: var(--page-text);
  }

  /* ── Header ───────────────────────────────────────────────────────────── */
  .rb-head {
    margin: 0.5rem 0 1rem;
  }
  .rb-kicker {
    margin: 0;
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rb-title {
    margin: 0.125rem 0 0.375rem;
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .rb-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
  }
  .rb-facts b {
    color: var(--page-text);
    font-variant-numeric: tabular-nums;
  }

  /* ── Pills ────────────────────────────────────────────────────────────── */
  .rb-nav {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .rb-pills--scope {
    --ui-pill-tone: var(--history-gold);
    --ui-pill-ink: var(--history-gold);
  }
  .rb-pills--boards {
    margin-bottom: 1rem;
  }
  .rb-pills--era {
    margin-top: 0.75rem;
  }

  /* ── On pace ──────────────────────────────────────────────────────────── */
  .rb-pace {
    margin-top: 1.5rem;
  }
  .rb-pace__kicker {
    margin: 0;
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rb-pace__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    text-transform: uppercase;
  }
  .rb-pace__grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .rb-pace__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .rb-pace__card {
    margin: 0;
    padding: 1rem;
    border-top: 4px solid var(--rb-team);
    border-radius: var(--radius-lg, 16px);
  }
  .rb-pace__board {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rb-pace__board a {
    color: var(--history-gold);
  }
  .rb-pace__who {
    margin: 0.25rem 0 0.5rem;
    font-size: var(--font-size-sm);
  }
  .rb-pace__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0.5rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
  }
  .rb-key--real,
  .rb-key--proj {
    width: 18px;
    vertical-align: middle;
  }
  .rb-key--real {
    height: 3px;
    border-radius: 2px;
    background: var(--page-text);
  }
  .rb-key--target {
    width: 18px;
    height: 0;
    vertical-align: middle;
    border-top: 2px dotted var(--history-gold);
  }
  .rb-key--proj {
    height: 0;
    border-top: 3px dashed var(--page-text);
    border-radius: 0;
    background: none;
  }

  /* ── The board ────────────────────────────────────────────────────────── */
  .rb-board {
    padding: 1rem;
    background: var(--card-bg);
    border: var(--style-card-border, 1px solid var(--content-border));
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--style-card-shadow, none);
  }
  .rb-board__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    text-transform: uppercase;
  }
  .rb-board__scope {
    color: var(--content-text-muted);
  }
  .rb-board__note {
    margin: 0.25rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
  }
  .rb-empty {
    color: var(--content-text-muted);
  }

  /* Plaque, charts, the record's history, then the rest of the top ten. Two
     columns from 960px: the leaderboard on the left, the charts on the right. */
  .rb-layout {
    display: grid;
    grid-template-areas: 'plaque' 'viz' 'story' 'list';
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .rb-plaque { grid-area: plaque; }
  .rb-viz { grid-area: viz; }
  .rb-story { grid-area: story; }
  .rb-list { grid-area: list; }
  @media (min-width: 960px) {
    .rb-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'plaque viz' 'list story';
      align-items: start;
    }
    /* The plaque fills the row beside the chart, its content centered. */
    .rb-plaque {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* ── Charts ───────────────────────────────────────────────────────────── */
  .rb-viz,
  .rb-story {
    min-width: 0;
    margin: 0;
    padding: 0.75rem;
    background: var(--content-bg);
    border: var(--style-card-border, 1px solid var(--content-border));
    border-radius: var(--radius-md, 12px);
    box-shadow: var(--style-card-shadow, none);
  }
  /* The highlighted one (Brandon's favorite): a gold edge and a heading. */
  .rb-story {
    border-color: var(--history-gold);
    background: linear-gradient(180deg, var(--history-gold-wash), var(--content-bg) 40%);
  }
  .rb-story p {
    margin: 0;
  }
  .rb-story__kicker {
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rb-story__title {
    margin-bottom: 0.5rem !important;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    text-transform: uppercase;
  }
  .rb-story__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.375rem !important;
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
  }
  .rb-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-right: 0.75rem;
    white-space: nowrap;
  }
  .rb-key {
    display: inline-block;
  }
  .rb-key--line {
    width: 16px;
    height: 2px;
    background: var(--history-gold);
  }
  .rb-key--dot,
  .rb-key--mine,
  .rb-key--watch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--page-text);
  }
  .rb-key--mine {
    background: var(--rb-mine, var(--history-gold));
  }
  .rb-key--watch {
    background: none;
    border: 2px dashed var(--page-text);
  }
  .rb-pills--charts {
    margin-bottom: 0.5rem;
  }
  /* The record holder, on a plaque. */
  .rb-plaque {
    position: relative;
    padding: 1.25rem 1rem 1rem;
    overflow: hidden;
    text-align: center;
    background: linear-gradient(160deg, var(--card-bg) 20%, var(--history-gold-wash));
    border: 1px solid var(--history-gold);
    border-radius: var(--radius-lg, 16px);
  }
  .rb-plaque::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--rb-team);
  }
  .rb-plaque p {
    margin: 0;
  }
  .rb-plaque__label {
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rb-plaque__logo {
    display: block;
    width: 88px;
    height: 88px;
    margin: 0.5rem auto 0.375rem;
    object-fit: contain;
  }
  .rb-plaque__value {
    font-family: var(--font-display);
    font-size: calc(var(--font-size-3xl) * 1.25);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .rb-plaque__unit {
    margin-left: 0.25rem;
    font-size: var(--font-size-sm);
    color: var(--content-text-muted);
    text-transform: uppercase;
  }
  .rb-plaque__name {
    margin-top: 0.375rem !important;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }
  .rb-plaque__context {
    margin-top: 0.25rem !important;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
  }
  .rb-share {
    align-self: center;
    margin-top: 0.75rem;
  }

  /* The signed-in owner's own entries on the list. */
  .rb-plaque.rb-mine,
  .rb-tile.rb-mine {
    outline: 2px solid var(--rb-mine, var(--history-gold));
    outline-offset: -2px;
  }
  .rb-row.rb-mine {
    padding-inline: 0.5rem;
    border-radius: var(--radius-sm, 8px);
    background: color-mix(in srgb, var(--rb-mine, var(--history-gold)) 14%, transparent);
  }

  /* Places 2 to 4, as tiles. */
  .rb-chasers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rb-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    min-width: 0;
    padding: 0.625rem 0.375rem 0.5rem;
    text-align: center;
    background: var(--content-bg);
    border: var(--style-card-border, 1px solid var(--content-border));
    border-top: 3px solid var(--rb-team);
    box-shadow: var(--style-card-shadow, none);
    border-radius: var(--radius-md, 12px);
  }
  .rb-tile__rank {
    position: absolute;
    top: 0.25rem;
    left: 0.5rem;
    color: var(--history-gold);
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }
  .rb-tile__logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .rb-tile__value {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rb-tile__name {
    max-width: 100%;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .rb-tile__context {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.25;
  }

  /* Places 5 to 10, as ranked bars. */
  .rb-rows {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rb-row {
    display: grid;
    grid-template-columns: 1.5rem 28px minmax(0, 1fr) auto;
    gap: 0.625rem;
    align-items: center;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--content-border);
  }
  .rb-row:last-child {
    border-bottom: 0;
  }
  .rb-row__rank {
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .rb-row__logo {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .rb-row__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .rb-row__name {
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
  }
  .rb-row__context {
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.3;
  }
  .rb-row__bar {
    width: var(--rb-bar);
    height: 4px;
    margin-top: 0.375rem;
    background: var(--rb-team);
    border-radius: 2px;
  }
  .rb-row__value {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-variant-numeric: tabular-nums;
  }

  /* Initials where a season has no logo. */
  .rb-plaque__logo--blank,
  .rb-tile__logo--blank,
  .rb-row__logo--blank {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--rb-team);
    color: var(--color-white);
    font-weight: var(--font-weight-bold);
  }
  .rb-plaque__logo--blank {
    font-size: var(--font-size-2xl);
  }
  .rb-tile__logo--blank,
  .rb-row__logo--blank {
    font-size: var(--font-size-xs);
  }

  .rb-board a:not(.cta),
  .rb-board a:not(.cta):hover {
    color: inherit;
  }
  .rb-board a:not(.cta):hover {
    text-decoration: underline;
  }

  /* ── Other boards' holders ────────────────────────────────────────────── */
  .rb-more {
    margin-top: 1.5rem;
  }
  .rb-more__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    text-transform: uppercase;
  }
  .rb-more__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rb-holder,
  .rb-holder:hover {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    /* Border-box, or the padding and border spill past the grid cell and
       each card runs under the next one. */
    box-sizing: border-box;
    height: 100%;
    padding: 0.75rem;
    color: var(--page-text);
    text-decoration: none;
    background: var(--card-bg);
    border: var(--style-card-border, 1px solid var(--content-border));
    border-left: 4px solid var(--rb-team);
    box-shadow: var(--style-card-shadow, none);
    border-radius: var(--radius-md, 12px);
  }
  .rb-holder:hover {
    border-color: var(--history-gold);
    border-left-color: var(--rb-team);
  }
  .rb-holder__label {
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rb-holder__value {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rb-holder__value small {
    font-size: var(--font-size-xs);
    color: var(--content-text-muted);
    text-transform: uppercase;
  }
  .rb-holder__name {
    font-weight: var(--font-weight-semibold);
  }
  .rb-holder__context {
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
  }

