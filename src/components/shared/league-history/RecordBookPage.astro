---
/**
 * Record Book — every league record, shared by TheLeague and the AFL.
 *
 * Boards come from `recordBook()` (src/utils/league-history/records.mjs) over
 * the League History dataset the route imports. Every board MFLHistory.com
 * shows is here (single game, season, career, postseason, milestones); what
 * this page adds is the Trophy Room presentation: the record holder on a
 * plaque, the three chasing them as tiles, the rest as ranked bars.
 *
 * Grouped by OWNER (the product default, Brandon 2026-10-24), so a career
 * follows the person across franchise slots and a slot's earlier owner keeps
 * theirs.
 *
 * Every board also gets three charts (record-charts.mjs): the gap (the
 * default) and where it sits, switched by pills, beside the highlighted
 * "how the record grew" history (Brandon, 2026-10-25).
 *
 * Also (Brandon, 2026-10-25): the signed-in owner's own results light up in
 * their team color, every dot opens its game, season or owner, a season in
 * progress gets a "record watch" when a team is on pace for a season board,
 * a record saves as a share card (/api/og/league-history/record.png), and an
 * era pill reads the whole book over the last ten seasons.
 *
 * Zero client JS: era, category, scope, board and chart are all URL params
 * switched by links (pills filter the same leaderboard, so they are pills, not
 * tabs), and every view is bookmarkable. The charts are server-drawn SVG.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import HistoryTabs from './HistoryTabs.astro';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { teamAccentVar } from '../../../utils/team-accent-css';
import { franchiseIdForLeague, getAuthUser } from '../../../utils/auth';
import { canonicalRivalryPair } from '../../../utils/rivalries';
import { CATEGORIES, SCOPES, historyEras, recordBook } from '../../../utils/league-history/records.mjs';
import { gapChart, historyChart, spreadChart } from '../../../utils/league-history/record-charts.mjs';

interface Row {
  value: number;
  display: string;
  name: string;
  icon: string | null;
  owner: string | null;
  context: string;
  rank: number;
  unit?: string;
  year?: number;
  franchiseId?: string;
  opponentId?: string;
  entity: { key: string; name: string; franchiseId: string | null; ownerSlug: string | null };
}
interface Watch {
  name: string;
  owner: string | null;
  franchiseId: string;
  projected: number;
  display: string;
  unit: string;
  rank: number;
  record: Row;
  played: number;
  full: number;
}
interface HistoryData {
  seasons: Array<{ y: number; teams: Record<string, { h: string }> }>;
}
interface Board {
  id: string;
  label: string;
  title: string;
  note?: string;
  asc: boolean;
  population: Array<Array<number | string | null>>;
  rows: Row[];
}

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  data: unknown;
}

const { leagueSlug, data } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);
const BASE = '/history/record-book';

const SCOPE_LABEL: Record<string, string> = {
  all: 'All games',
  regular: 'Regular season',
  playoffs: 'Playoffs',
};

const params = Astro.url.searchParams;
const eras = historyEras(data, league.historyEras ?? []);
const era = eras.find((e) => e.id === params.get('era')) ?? eras[0];
const book = recordBook(data, { from: era.from });
const facts = book.facts();
const category = CATEGORIES.find((c) => c.id === params.get('cat')) ?? CATEGORIES[0];
const scopeParam = params.get('scope') ?? 'all';
const scope = category.scoped && SCOPES.includes(scopeParam) ? scopeParam : 'all';
const boards = book.category(category.id, scope) as Board[];
const board = boards.find((b) => b.id === params.get('board')) ?? boards[0];

const CHARTS = [
  { id: 'gap', label: 'The gap', draw: gapChart },
  { id: 'spread', label: 'Where it sits', draw: spreadChart },
];
const chartView = CHARTS.find((c) => c.id === params.get('chart')) ?? CHARTS[0];
// One drawing width for every screen: the SVG scales to its column, and at 400
// its 11px labels stay readable from a phone (~0.85x) to a desktop column (~1.3x).
const CHART_W = 400;

// The viewer's own results: the holding (owner, or co-owners) of their
// franchise in the latest season, matched against every entity key, so an
// owner who moved slots still finds every season of theirs.
const viewerFranchise = franchiseIdForLeague(getAuthUser(Astro.request), league.id);
const latestSeason = (data as HistoryData).seasons.at(-1);
const myHolding = viewerFranchise ? (latestSeason?.teams[viewerFranchise]?.h ?? `slot:${viewerFranchise}`) : null;
const myIds = new Set(myHolding ? myHolding.split('+') : []);
const mine = (key: string | null | undefined) => !!key && key.split('+').some((id) => myIds.has(id));

// Where a dot or row opens: a game's head-to-head page, a season's franchise
// page, a career's owner page.
const entityHref = (key: string | null | undefined) => {
  if (!key) return null;
  const e = book.ix.entity(key);
  return e.ownerSlug ? r(`/owners/${e.ownerSlug}`) : e.franchiseId ? r(`/franchises/${e.franchiseId}`) : null;
};
const rowHref = (row: Row) => {
  if (row.franchiseId && row.opponentId) return r(`/rivalries/${canonicalRivalryPair(row.franchiseId, row.opponentId)}`);
  if (row.franchiseId && row.year != null) return r(`/franchises/${row.franchiseId}`);
  return entityHref(row.entity.key);
};

const watches = book.watch() as Record<string, Watch[]>;
const boardWatch = (board && watches[board.id]) || [];
const chartOpts = { mine, href: rowHref, entityHref, watch: boardWatch };
const chart = board ? chartView.draw(board, CHART_W, chartOpts) : null;
const history = board ? historyChart(board, CHART_W, chartOpts) : null;
const youOnBoard = !!board?.population.some((p) => mine(p[4] as string | null));
const historyBySeason = !!board?.population.length && board.population.every((p) => p[1] != null);

/** A view's URL, leaving defaults out so the plain page stays the plain URL. */
const viewHref = (next: { cat?: string; scope?: string; board?: string; chart?: string; hash?: string; era?: string }) => {
  const q = new URLSearchParams();
  const eraId = next.era ?? era.id;
  if (eraId !== eras[0].id) q.set('era', eraId);
  const cat = next.cat ?? category.id;
  if (cat !== CATEGORIES[0].id) q.set('cat', cat);
  const sc = next.scope ?? 'all';
  if (sc !== 'all') q.set('scope', sc);
  if (next.board) q.set('board', next.board);
  if (next.chart && next.chart !== CHARTS[0].id) q.set('chart', next.chart);
  const qs = q.toString();
  return `${qs ? `${r(BASE)}?${qs}` : r(BASE)}${next.hash ? `#${next.hash}` : ''}`;
};

const rows = board?.rows ?? [];
const leader = rows[0];
const tiedAtTop = rows.filter((row) => row.rank === 1).length;
const chasers = rows.slice(1, 4);
const rest = rows.slice(4);

// Bars rank the shown rows against each other: the leader fills the track and
// the tenth place still shows a stub, whichever direction the board sorts.
const best = rows[0]?.value ?? 0;
const worst = rows[rows.length - 1]?.value ?? 0;
const barWidth = (value: number) =>
  best === worst ? 100 : Math.round(35 + (65 * (value - worst)) / (best - worst));

const ownerHref = (row: Row) => (row.entity.ownerSlug ? r(`/owners/${row.entity.ownerSlug}`) : null);
const accent = (row: Row) =>
  row.entity.franchiseId ? teamAccentVar(row.entity.franchiseId, 'var(--history-gold)') : 'var(--history-gold)';
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join('');
const sub = (row: Row) => [row.owner, row.context].filter(Boolean).join(' · ');
const unit = (row: Row) => (row.unit ? ` ${row.unit}` : '');

const others = boards.filter((b) => b.id !== board?.id && b.rows.length);

// "On pace" wording: equal to the record ties it, better breaks it.
const paceLine = (w: Watch) => {
  const verdict =
    w.rank > 1
      ? `which would rank #${w.rank}`
      : w.projected === w.record.value
        ? `which would tie the record (${w.record.display})`
        : `which would break the record (${w.record.display})`;
  return `on pace for ${w.display}${w.unit ? ` ${w.unit}` : ''}, ${verdict}`;
};
// The header strip: every season board someone is on pace to break or tie,
// the best pace only (the board's own banner lists the rest).
const seasonBoards = book.category('season') as Board[];
const recordChases = seasonBoards.flatMap((b) =>
  (watches[b.id] ?? []).filter((w) => w.rank === 1).slice(0, 1).map((w) => ({ board: b, watch: w }))
);

const shareHref = (() => {
  const q = new URLSearchParams({ league: league.slug, cat: category.id, board: board?.id ?? '' });
  if (scope !== 'all') q.set('scope', scope);
  if (era.id !== eras[0].id) q.set('era', era.id);
  return `/api/og/league-history/record.png?${q}`;
})();
const pageTitle = `Record Book · ${league.name}`;
const span = facts.firstSeason && facts.lastSeason ? `${facts.firstSeason} to ${facts.lastSeason}` : '';
---

<TheLeagueLayout title={pageTitle}>
  <div class="rb">
    <Breadcrumbs
      items={[
        { label: league.name, href: `/${league.slug}` },
        { label: 'History', href: `/${league.slug}/history` },
        { label: 'Record Book' },
      ]}
    />

    <header class="rb-head">
      <p class="rb-kicker">League history · {span}</p>
      <h1 class="rb-title">Record Book</h1>
      <p class="rb-facts">
        <span><b>{facts.seasons}</b> seasons</span>
        <span><b>{facts.games.toLocaleString('en-US')}</b> games</span>
        <span><b>{facts.champions}</b> different champions</span>
      </p>
      {eras.length > 1 && (
        <ul class="ui-pills rb-pills rb-pills--era" aria-label="Seasons counted">
          {eras.map((e) => (
            <li>
              <a
                class="ui-pill"
                href={viewHref({ era: e.id, scope, board: board?.id, chart: chartView.id })}
                aria-current={e.id === era.id ? 'true' : undefined}
              >
                {e.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    {recordChases.length > 0 && (
      <aside class="rb-chase" aria-labelledby="rb-chase-title">
        <p class="rb-chase__kicker" id="rb-chase-title">Record watch · {latestSeason?.y}</p>
        <ul class="rb-chase__list">
          {recordChases.map(({ board: b, watch: w }) => (
            <li style={`--rb-team: ${teamAccentVar(w.franchiseId, 'var(--history-gold)')}`}>
              <a href={viewHref({ cat: 'season', board: b.id, hash: 'rb-board-title' })}>
                <b>{w.name}</b> is {paceLine(w)} for {b.title.toLowerCase()}.
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <HistoryTabs leagueSlug={league.slug} current="record-book" />

    <nav class="rb-nav" aria-label="Record categories">
      <ul class="ui-pills rb-pills">
        {CATEGORIES.map((c) => (
          <li>
            <a class="ui-pill" href={viewHref({ cat: c.id })} aria-current={c.id === category.id ? 'page' : undefined}>
              {c.label}
            </a>
          </li>
        ))}
      </ul>
      {category.scoped && (
        <ul class="ui-pills rb-pills rb-pills--scope" aria-label="Games counted">
          {SCOPES.map((s) => (
            <li>
              <a
                class="ui-pill"
                href={viewHref({ scope: s, board: board?.id, chart: chartView.id })}
                aria-current={s === scope ? 'true' : undefined}
              >
                {SCOPE_LABEL[s]}
              </a>
            </li>
          ))}
        </ul>
      )}
    </nav>

    <section
      class="rb-board"
      aria-labelledby="rb-board-title"
      style={viewerFranchise ? `--rb-mine: ${teamAccentVar(viewerFranchise, 'var(--history-gold)')}` : undefined}
    >
      <ul class="ui-pills rb-pills rb-pills--boards" aria-label="Records">
        {boards.map((b) => (
          <li>
            <a
              class="ui-pill"
              href={viewHref({ scope, board: b.id, chart: chartView.id })}
              aria-current={b.id === board?.id ? 'true' : undefined}
            >
              {b.label}
            </a>
          </li>
        ))}
      </ul>

      <h2 class="rb-board__title" id="rb-board-title">
        {board?.title ?? 'No records yet'}
        {category.scoped && scope !== 'all' && <span class="rb-board__scope"> · {SCOPE_LABEL[scope]}</span>}
      </h2>
      {board?.note && <p class="rb-board__note">{board.note}</p>}

      {boardWatch.length > 0 && (
        <aside class="rb-watch">
          <p class="rb-watch__kicker">Record watch · {latestSeason?.y}</p>
          <ul class="rb-watch__list">
            {boardWatch.map((w) => (
              <li style={`--rb-team: ${teamAccentVar(w.franchiseId, 'var(--history-gold)')}`}>
                <b>{w.name}</b>{w.owner && ` (${w.owner})`} is {paceLine(w)}.
                <span class="rb-watch__played">{w.played} of {w.full} games played.</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      {leader ? (
        <div class="rb-layout">
          <article class:list={['rb-plaque', { 'rb-mine': mine(leader.entity.key) }]} style={`--rb-team: ${accent(leader)}`}>
            <p class="rb-plaque__label">{tiedAtTop > 1 ? `Record · shared by ${tiedAtTop}` : 'The record'}</p>
            {leader.icon ? (
              <img class="rb-plaque__logo" src={leader.icon} alt="" width="88" height="88" loading="eager" />
            ) : (
              <span class="rb-plaque__logo rb-plaque__logo--blank" aria-hidden="true">{initials(leader.name)}</span>
            )}
            <p class="rb-plaque__value">
              {leader.display}
              {leader.unit && <span class="rb-plaque__unit">{leader.unit}</span>}
            </p>
            <p class="rb-plaque__name">
              {ownerHref(leader) ? <a href={ownerHref(leader)}>{leader.name}</a> : leader.name}
            </p>
            <p class="rb-plaque__context">{sub(leader)}</p>
            <a class="cta cta--ghost rb-share" href={shareHref} download={`${board.id}.png`}>Save as image</a>
          </article>

          {chart && (
            <figure class="rb-viz" id="rb-viz">
              <ul class="ui-pills rb-pills rb-pills--charts" aria-label="Chart">
                {CHARTS.map((c) => (
                  <li>
                    <a
                      class="ui-pill"
                      href={viewHref({ scope, board: board.id, chart: c.id, hash: 'rb-viz' })}
                      aria-current={c.id === chartView.id ? 'true' : undefined}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="rb-viz__plot" set:html={chart.svg} />
              <figcaption class="rb-viz__take">{chart.take}</figcaption>
            </figure>
          )}

          {history && (
            <figure class="rb-story">
              <p class="rb-story__kicker">{historyBySeason ? 'How the record grew' : 'Everyone on the board'}</p>
              <p class="rb-story__title">
                {historyBySeason ? 'Every result, season by season' : 'The whole league on one line'}
              </p>
              <div class="rb-viz__plot" set:html={history.svg} />
              <figcaption class="rb-viz__take">{history.take}</figcaption>
              <p class="rb-story__legend">
                {historyBySeason && (
                  <span class="rb-legend"><span class="rb-key rb-key--line"></span> The record at the time</span>
                )}
                <span class="rb-legend"><span class="rb-key rb-key--dot"></span> Top 10</span>
                {youOnBoard && <span class="rb-legend"><span class="rb-key rb-key--mine"></span> Your results</span>}
                {boardWatch.length > 0 && historyBySeason && (
                  <span class="rb-legend"><span class="rb-key rb-key--watch"></span> On pace this season</span>
                )}
              </p>
            </figure>
          )}

          <div class="rb-list">
          {chasers.length > 0 && (
            <ol class="rb-chasers" aria-label="Next on the list">
              {chasers.map((row) => (
                <li class:list={['rb-tile', { 'rb-mine': mine(row.entity.key) }]} style={`--rb-team: ${accent(row)}`}>
                  <span class="rb-tile__rank">{row.rank}</span>
                  {row.icon ? (
                    <img class="rb-tile__logo" src={row.icon} alt="" width="40" height="40" loading="lazy" />
                  ) : (
                    <span class="rb-tile__logo rb-tile__logo--blank" aria-hidden="true">{initials(row.name)}</span>
                  )}
                  <span class="rb-tile__value">{row.display}<span class="visually-hidden">{unit(row)}</span></span>
                  <span class="rb-tile__name">
                    {ownerHref(row) ? <a href={ownerHref(row)}>{row.name}</a> : row.name}
                  </span>
                  <span class="rb-tile__context">{sub(row)}</span>
                </li>
              ))}
            </ol>
          )}

          {rest.length > 0 && (
            <ol class="rb-rows" aria-label="The rest of the top ten">
              {rest.map((row) => (
                <li
                  class:list={['rb-row', { 'rb-mine': mine(row.entity.key) }]}
                  style={`--rb-team: ${accent(row)}; --rb-bar: ${barWidth(row.value)}%`}
                >
                  <span class="rb-row__rank">{row.rank}</span>
                  {row.icon ? (
                    <img class="rb-row__logo" src={row.icon} alt="" width="28" height="28" loading="lazy" />
                  ) : (
                    <span class="rb-row__logo rb-row__logo--blank" aria-hidden="true">{initials(row.name)}</span>
                  )}
                  <span class="rb-row__body">
                    <span class="rb-row__name">
                      {ownerHref(row) ? <a href={ownerHref(row)}>{row.name}</a> : row.name}
                    </span>
                    <span class="rb-row__context">{sub(row)}</span>
                    <span class="rb-row__bar" aria-hidden="true"></span>
                  </span>
                  <span class="rb-row__value">{row.display}<span class="visually-hidden">{unit(row)}</span></span>
                </li>
              ))}
            </ol>
          )}
          </div>
        </div>
      ) : (
        <p class="rb-empty">Nothing on this board yet.</p>
      )}
    </section>

    {others.length > 0 && (
      <section class="rb-more" aria-labelledby="rb-more-title">
        <h2 class="rb-more__title" id="rb-more-title">More {category.label.toLowerCase()} records</h2>
        <ul class="rb-more__grid">
          {others.map((b) => {
            const top = b.rows[0];
            return (
              <li>
                <a class="rb-holder" href={viewHref({ scope, board: b.id })} style={`--rb-team: ${accent(top)}`}>
                  <span class="rb-holder__label">{b.title}</span>
                  <span class="rb-holder__value">
                    {top.display}{top.unit && <small> {top.unit}</small>}
                  </span>
                  <span class="rb-holder__name">{top.name}</span>
                  <span class="rb-holder__context">{top.context}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</TheLeagueLayout>

<style>
  .rb {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
    color: var(--page-text);
  }

  /* ── Header ───────────────────────────────────────────────────────────── */
  .rb-head {
    margin: 0.5rem 0 1rem;
  }
  .rb-kicker {
    margin: 0;
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rb-title {
    margin: 0.125rem 0 0.375rem;
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .rb-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
  }
  .rb-facts b {
    color: var(--page-text);
    font-variant-numeric: tabular-nums;
  }

  /* ── Pills ────────────────────────────────────────────────────────────── */
  .rb-nav {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .rb-pills--scope {
    --ui-pill-tone: var(--history-gold);
    --ui-pill-ink: var(--history-gold);
  }
  .rb-pills--boards {
    margin-bottom: 1rem;
  }
  .rb-pills--era {
    margin-top: 0.75rem;
  }

  /* ── Record watch ─────────────────────────────────────────────────────── */
  .rb-chase,
  .rb-watch {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: var(--history-gold-wash);
    border: 1px solid var(--history-gold);
    border-radius: var(--radius-md, 12px);
  }
  .rb-watch {
    margin: 0.75rem 0 0;
  }
  .rb-chase__kicker,
  .rb-watch__kicker {
    margin: 0 0 0.25rem;
    color: var(--history-gold);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rb-chase__list,
  .rb-watch__list {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }
  .rb-chase__list li,
  .rb-watch__list li {
    padding-left: 0.625rem;
    border-left: 3px solid var(--rb-team);
  }
  .rb-chase a,
  .rb-chase a:hover {
    color: var(--page-text);
  }
  .rb-watch__played {
    color: var(--content-text-muted);
  }

  /* ── The board ────────────────────────────────────────────────────────── */
  .rb-board {
    padding: 1rem;
    background: var(--card-bg);
    border: var(--style-card-border, 1px solid var(--content-border));
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--style-card-shadow, none);
  }
  .rb-board__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    text-transform: uppercase;
  }
  .rb-board__scope {
    color: var(--content-text-muted);
  }
  .rb-board__note {
    margin: 0.25rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-sm);
  }
  .rb-empty {
    color: var(--content-text-muted);
  }

  /* Plaque, charts, the record's history, then the rest of the top ten. Two
     columns from 960px: the leaderboard on the left, the charts on the right. */
  .rb-layout {
    display: grid;
    grid-template-areas: 'plaque' 'viz' 'story' 'list';
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .rb-plaque { grid-area: plaque; }
