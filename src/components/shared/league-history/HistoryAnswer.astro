---
/**
 * One Ask the History answer: the answer in words, then the rows our engine
 * computed and the plain-words receipt of what was counted. Server-rendered
 * on the shared answer page; the question box's script builds the same
 * markup client-side (history-ask.css styles both).
 */
import '../../../styles/history-ask.css';
import '../../../styles/record-charts.css';
import type { AskRecordLink, AskTable } from '../../../utils/league-history/ask';
import { answerCharts, cellHref, formatCell, isNumericColumn, recordHref } from '../../../utils/league-history/ask-format.mjs';

interface Props {
  question: string;
  answer: string;
  table: AskTable | null;
  /** How far the record went when this was asked ('' or missing once every season is complete). */
  asOf?: string;
  /** Record Book boards the answer points to (missing on older answers). */
  records?: AskRecordLink[];
  /** The league's path prefix ('/theleague', or '' on its own domain). */
  base: string;
}

const { question, answer, table, asOf, records = [], base } = Astro.props as Props;
const numeric = table ? table.columns.map((_, i) => isNumericColumn(table, i)) : [];
const charts = answerCharts(table?.chart, base);
---

<article class="ha-answer">
  <p class="ha-answer__q">{question}</p>
  <p class="ha-answer__a">{answer}</p>
  {records.length > 0 && (
    <ul class="ha-records" aria-label="In the Record Book">
      {records.map((rec) => (
        <li>
          <a class="ha-record" href={recordHref(base, rec.query)}>
            <span class="ha-record__kicker">Record Book</span>
            <span class="ha-record__title">{rec.title}</span>
            {rec.leader && <span class="ha-record__leader">{rec.leader}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
  {charts.map((c) => (
    <figure class="ha-chart">
      <p class="ha-chart__title">{c.title}</p>
      <div class="rb-viz__plot rb-viz__plot--phone" set:html={c.phone} />
      <div class="rb-viz__plot rb-viz__plot--wide" set:html={c.wide} />
      <figcaption class="rb-viz__take">{c.take}</figcaption>
    </figure>
  ))}
  {table && table.rows.length > 0 && (
    <div class="ha-table-wrap">
      <table class="ui-table ha-table">
        <thead>
          <tr>{table.columns.map((c, i) => <th class:list={{ 'ha-num': numeric[i] }} scope="col">{c.label}</th>)}</tr>
        </thead>
        <tbody>
          {table.rows.map((row) => (
            <tr>
              {table.columns.map((c, i) => {
                const href = cellHref(c.key, row, base);
                const text = formatCell(c.key, row.cells[i]);
                return (
                  <td class:list={{ 'ha-num': numeric[i] }} data-label={c.label}>
                    {href ? <a href={href}>{text}</a> : text}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  {table && (
    <p class="ha-receipt">
      {table.total === 1 ? '1 match' : `${table.total.toLocaleString('en-US')} matches`}
      {table.total > table.rows.length && `, top ${table.rows.length} shown`} · {table.description}
    </p>
  )}
  {asOf && <p class="ha-receipt">{asOf}.</p>}
</article>
