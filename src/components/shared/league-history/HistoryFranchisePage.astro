---
/**
 * League History franchise page — one franchise's whole story in the Trophy
 * Room style, shared by every league with a League History dataset.
 *
 * Built only from the dataset (franchise.mjs), so it is part of the history
 * product any MFL league gets, not a page tied to our leagues' curated files
 * (Brandon, 2026-10-25). It IS the league's franchise page, at
 * /<league>/franchises/<id> and public (Brandon: "fully replace those
 * franchise pages"); the History tabs show only to viewers who can see the
 * rest of League History. A league's own sections (TheLeague's trade ledger
 * and awards, the AFL's trophy wall) come in through slots: `hero-extra`
 * under the name, `after-stats` after the plaques (the hometown map) and the
 * default slot after the head-to-head list.
 *
 * Top to bottom: the Broadcast team-color hero, the franchise's own Rafters
 * (title, title game and division banners), plaques, a season-by-season win
 * chart, the owners who ran the slot, the franchise's highs and its record
 * against every opponent. Zero client JS; the season chart is plain CSS bars.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import HistoryTabs from './HistoryTabs.astro';
import HistoryRafters from './HistoryRafters.astro';
import type { RafterBanner, RafterHonor } from './HistoryRafters.astro';
import { groupRows } from '../../../utils/league-history/rafter-rows';
import { getLeagueBySlug } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import type { LeagueSlug } from '../../../types/nav';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { franchiseIdForLeague, getAuthUser } from '../../../utils/auth';
import { canViewLeagueHistory } from '../../../utils/league-history/access';
import { getTeamColorPrimary, getTeamColorSecondary, getTeamEraColors } from '../../../utils/team-colors';
import { toBroadcastPair } from '../../../utils/draft-broadcast';
import { canonicalRivalryPair } from '../../../utils/rivalries';
import { recordBook, resultLabel } from '../../../utils/league-history/records.mjs';
import { franchiseHistory } from '../../../utils/league-history/franchise.mjs';

interface Entity {
  key: string;
  name: string;
  ownerSlug: string | null;
  franchiseId: string | null;
}
interface Tally {
  w: number;
  l: number;
  t: number;
  record: string;
  pct: number;
}
interface Season {
  y: number;
  name: string;
  icon: string | null;
  w: number;
  l: number;
  t: number;
  pf: number | null;
  rank: number | null;
  division: string | null;
  r: string | null;
  wonDivision: boolean;
  live: boolean;
  entityKey: string;
  teams: number;
}
interface GameLine {
  y: number;
  wk: number;
  s: number;
  os: number;
  opponentId: string;
  opponent: string;
  playoffs: boolean;
}
interface History {
  franchiseId: string;
  ownerOnly: boolean;
  hadOtherOwners: boolean;
  franchiseFirstYear: number;
  name: string;
  icon: string | null;
  active: boolean;
  division: string | null;
  firstYear: number;
  lastYear: number;
  owner: Entity | null;
  seasons: Season[];
  titles: number[];
  finals: number[];
  trips: number;
  divisionTitles: number[];
  regular: Tally;
  playoffs: Tally;
  games: number;
  pointsFor: number;
  pointsPerGame: number;
  owners: Array<{ entity: Entity; from: number; to: number; seasons: number; record: string; titles: number; current: boolean }>;
  headToHead: Array<
    Tally & {
      opponentId: string;
      name: string;
      icon: string | null;
      active: boolean;
      games: number;
      playoffGames: number;
    }
  >;
  highs: {
    game: GameLine | null;
    win: GameLine | null;
    season: { y: number; record: string; pf: number | null; r: string | null } | null;
  };
}

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  data: unknown;
  franchiseId: string;
  /** Whether the league has rivalry pages to link each opponent to. */
  rivalriesPage?: boolean;
  /** The league's own titles, hung in place of champion and runner-up (see RafterHonor). */
  honors?: RafterHonor[] | null;
}

const { leagueSlug, data, franchiseId, rivalriesPage = false, honors = null } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals?.hideLeaguePrefix ?? false;
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);
const navSlug = league.navSlug as LeagueSlug;

const ix = recordBook(data).ix;
// The current owner's run by default (Brandon, 2026-10-25: "we should be only
// highlighting the owner"); ?view=all counts every owner the slot has had.
const ownerOnly = Astro.url.searchParams.get('view') !== 'all';
const h = franchiseHistory(ix, franchiseId, { ownerOnly }) as History;
const pageHref = r(`/franchises/${franchiseId}`);
const ownerLabel = h.owner && !h.owner.key.startsWith('slot:') ? h.owner.name : 'Current owner';

// The viewer's own franchise, by the same holding match the Record Book uses.
const authUser = getAuthUser(Astro.request);
const viewerFranchise = franchiseIdForLeague(authUser, league.id);
const showHistoryTabs = canViewLeagueHistory(authUser);
const isMine = viewerFranchise === franchiseId;

const pair = toBroadcastPair(getTeamColorPrimary(franchiseId, navSlug), getTeamColorSecondary(franchiseId, navSlug));
const heroStyle = `--hf-a: ${pair.primary}; --hf-b: ${pair.secondary}`;
const pairStyle = (f: string) => {
  const p = toBroadcastPair(getTeamColorPrimary(f, navSlug), getTeamColorSecondary(f, navSlug));
  return `--hf-a: ${p.primary}; --hf-b: ${p.secondary}`;
};

const seasonByYear = new Map(h.seasons.map((s) => [s.y, s]));
const ownerName = (key: string) => {
  const o = h.owners.find((x) => x.entity.key === key);
  return o && !key.startsWith('slot:') ? o.entity.name : 'Earlier owner';
};
const banner = (y: number, kind: RafterBanner['kind'], label?: string): RafterBanner => {
  const s = seasonByYear.get(y)!;
  // In the all-owners view an earlier owner's banner says whose it is.
  const earlier = h.owner && s.entityKey !== h.owner.key ? ownerName(s.entityKey) : null;
  const caption = earlier ?? label ?? (kind === 'C' ? 'Champion' : kind === 'R' ? 'Runner-up' : `${s.division ?? 'Division'}`);
  return {
    year: y,
    kind,
    franchiseId,
    name: s.name,
    icon: s.icon,
    caption,
    // A banner hangs in its own era's colors whenever the team kept a look for
    // that year: an old name, or the same name under an earlier crest (Smokane
    // FC's 2006-2018 gas mask) (Brandon, 2026-10-25/26).
    colors: getTeamEraColors(franchiseId, navSlug, y),
    title: `${y} ${label ?? (kind === 'C' ? 'champion' : kind === 'R' ? 'runner-up' : 'division champion')}: ${s.name}, ${s.w}-${s.l}${s.t ? `-${s.t}` : ''}`,
  };
};
// A league with its own titles hangs every one of them, one labelled row per
// kind; otherwise champion and runner-up in one unlabelled row. Either way
// only seasons this view covers.
const titleRows: Array<{ label: string | null; banners: RafterBanner[] }> = honors
  ? groupRows(
      honors.filter((x) => x.franchiseId === franchiseId && seasonByYear.has(x.year) && !seasonByYear.get(x.year)!.live),
      (x) => banner(x.year, x.tier === 'silver' ? 'R' : 'C', x.caption),
    )
  : [
      {
        label: null,
        banners: [
          ...h.titles.map((y) => banner(y, 'C')),
          ...h.finals.filter((y) => !h.titles.includes(y)).map((y) => banner(y, 'R')),
        ].sort((a, b) => b.year - a.year),
      },
    ].filter((row) => row.banners.length > 0);
const titleCount = titleRows.reduce((n, row) => n + row.banners.length, 0);
const divisionBanners = h.divisionTitles.map((y) => banner(y, 'D')).reverse();

const pct = (n: number) => n.toFixed(3).replace(/^0(?=\.)/, '');
const fmt2 = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmt1 = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const ownerHref = (e: Entity) => (e.ownerSlug ? r(`/owners/${e.ownerSlug}`) : null);
// The rivalry page has the same two views, so the all-owners view opens its every-game view.
const rivalryHref = (opp: string) =>
  rivalriesPage ? r(`/rivalries/${canonicalRivalryPair(franchiseId, opp)}${ownerOnly ? '' : '?view=all'}`) : null;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join('');

// The season chart: one bar per season, its height the win share.
const yearLabelEvery = h.seasons.length > 14 ? 4 : 2;
const share = (s: Season) => {
  const g = s.w + s.l + s.t;
  return g ? (s.w + s.t / 2) / g : 0;
};
const barClass = (s: Season) =>
  s.live ? 'hf-bar hf-bar--live' : s.r ? `hf-bar hf-bar--${s.r === '3' ? 'P' : s.r}` : 'hf-bar';
const finish = (s: Season) => (s.live ? 'In progress' : s.r ? resultLabel(s.r) : '');
const opponents = h.headToHead.filter((o) => o.active);
const formerOpponents = h.headToHead.filter((o) => !o.active);
// Earlier names: the owner's own in the owner view; in the all-owners view an
// earlier owner's name is credited to that owner, never passed off as this one's.
const priorNames = [
  ...new Map(
    h.seasons
      .filter((s) => s.name !== h.name)
      .map((s) => [s.name, h.owner && s.entityKey !== h.owner.key ? `${s.name} (${ownerName(s.entityKey)})` : s.name]),
  ).values(),
];
---

<TheLeagueLayout title={`${h.name} · ${league.name}`}>
  <div class="hf">
    <Breadcrumbs
      items={[
        { label: league.name, href: `/${league.slug}` },
        { label: 'Franchises', href: r('/franchises') },
        { label: h.name },
      ]}
    />

    <header class="hf-hero" style={heroStyle}>
      {h.icon ? (
        <img class="hf-hero__logo" src={h.icon} alt="" width="96" height="96" />
      ) : (
        <span class="hf-hero__logo hf-hero__logo--blank" aria-hidden="true">{initials(h.name)}</span>
      )}
      <div class="hf-hero__body">
        <p class="hf-hero__kicker">
          {[h.division && `${h.division} Division`, `since ${h.firstYear}`].filter(Boolean).join(' · ')}
          {!h.active && ` · last played ${h.lastYear}`}
        </p>
        <h1 class="hf-hero__name">{h.name}</h1>
        {h.owner && !h.owner.key.startsWith('slot:') && (
          <p class="hf-hero__owner">
            {h.active ? 'Owner' : 'Last owner'}:{' '}
            {ownerHref(h.owner) ? <a href={ownerHref(h.owner)}>{h.owner.name}</a> : h.owner.name}
            {isMine && <span class="hf-hero__you">Your team</span>}
          </p>
        )}
        {priorNames.length > 0 && (
          <p class="hf-hero__aka">{ownerOnly ? 'Also played as' : 'Earlier names'} {priorNames.join(', ')}</p>
        )}
        {h.titles.length > 0 && (
          <p class="hf-hero__cups" aria-label={`${h.titles.length} championships`}>
            {h.titles.map(() => <span class="hf-cup" aria-hidden="true"></span>)}
            <b>{h.titles.length}×</b> champion
          </p>
        )}
        <slot name="hero-extra" />
      </div>
    </header>

    {showHistoryTabs && <HistoryTabs leagueSlug={league.slug} current="franchises" />}

    {h.hadOtherOwners && (
      <ul class="ui-pills hf-pills" aria-label="Seasons counted">
        <li>
          <a class="ui-pill" href={pageHref} aria-current={ownerOnly ? 'page' : undefined}>
            {ownerLabel}
          </a>
        </li>
        <li>
          <a class="ui-pill" href={`${pageHref}?view=all`} aria-current={!ownerOnly ? 'page' : undefined}>
            All owners · since {h.franchiseFirstYear}
          </a>
        </li>
      </ul>
    )}

    <section class="hf-section" aria-labelledby="hf-rafters">
      <p class="hf-section__kicker">Banners</p>
      <h2 class="hf-section__title" id="hf-rafters">The Rafters</h2>
      {titleCount + divisionBanners.length > 0 ? (
        <>
          {titleRows.map((row) => (
            <>
              {row.label && <p class="hf-rafters__label">{row.label}</p>}
              <HistoryRafters banners={row.banners} navSlug={navSlug} />
            </>
          ))}
          {divisionBanners.length > 0 && (
            <>
              <p class="hf-rafters__label">Division titles</p>
              <HistoryRafters banners={divisionBanners} navSlug={navSlug} />
            </>
          )}
        </>
      ) : (
        <p class="hf-empty">
          No banners yet. {h.trips > 0 ? `${h.trips} playoff ${h.trips === 1 ? 'trip' : 'trips'} and counting.` : 'The rafters are waiting.'}
        </p>
      )}
    </section>

    <section class="hf-plaques" aria-label="Career">
      <div class="hf-plaque hf-plaque--lead">
        <span class="hf-plaque__label">All-time record</span>
        <span class="hf-plaque__value">{h.regular.record}</span>
        <span class="hf-plaque__sub">{pct(h.regular.pct)} · regular season</span>
      </div>
      <div class="hf-plaque">
        <span class="hf-plaque__label">Playoffs</span>
        <span class="hf-plaque__value">{h.playoffs.record}</span>
        <span class="hf-plaque__sub">{h.trips} {h.trips === 1 ? 'trip' : 'trips'}</span>
      </div>
      <div class="hf-plaque">
        <span class="hf-plaque__label">Titles</span>
        <span class="hf-plaque__value">{h.titles.length}</span>
        <span class="hf-plaque__sub">{h.finals.length} title {h.finals.length === 1 ? 'game' : 'games'}</span>
      </div>
      <div class="hf-plaque">
        <span class="hf-plaque__label">Seasons</span>
        <span class="hf-plaque__value">{h.seasons.length}</span>
        <span class="hf-plaque__sub">{h.firstYear}–{h.lastYear}</span>
      </div>
      <div class="hf-plaque">
        <span class="hf-plaque__label">Per game</span>
        <span class="hf-plaque__value">{fmt1(h.pointsPerGame)}</span>
        <span class="hf-plaque__sub">{Math.round(h.pointsFor).toLocaleString('en-US')} points</span>
      </div>
    </section>

    {/* After the headline stats: the owner map's hometown card (PR #1481). */}
    <slot name="after-stats" />

    <section class="hf-section" aria-labelledby="hf-seasons">
      <p class="hf-section__kicker">Season by season</p>
      <h2 class="hf-section__title" id="hf-seasons">Win share, every year</h2>
      <p class="hf-legend">
        <span class="hf-legend__item"><span class="hf-swatch hf-bar--C"></span> Champion</span>
        <span class="hf-legend__item"><span class="hf-swatch hf-bar--R"></span> Runner-up</span>
        <span class="hf-legend__item"><span class="hf-swatch hf-bar--P"></span> Playoffs</span>
        <span class="hf-legend__item"><span class="hf-swatch hf-bar--M"></span> Missed</span>
      </p>
      <div class="hf-chart" style={`--hf-n: ${h.seasons.length}`}>
        <div class="hf-chart__plot">
          <span class="hf-chart__even" aria-hidden="true"><span>.500</span></span>
          {h.seasons.map((s) => (
            <span
              class="hf-col"
              title={`${s.y} · ${s.name} · ${s.w}-${s.l}${s.t ? `-${s.t}` : ''}${finish(s) ? ` · ${finish(s)}` : ''}`}
            >
              <span class={barClass(s)} style={`height: ${Math.max(share(s) * 100, 2).toFixed(1)}%`}></span>
            </span>
          ))}
        </div>
        <div class="hf-chart__years" aria-hidden="true">
          {h.seasons.map((s, i) => (
            <span>{i % yearLabelEvery === 0 || i === h.seasons.length - 1 ? `’${String(s.y).slice(2)}` : ''}</span>
          ))}
        </div>
      </div>
      <details class="hf-details">
        <summary>Every season ({h.seasons.length})</summary>
        <ol class="hf-seasons">
          {h.seasons
            .slice()
            .reverse()
            .map((s) => (
              <li class:list={['hf-season', { 'hf-season--title': s.r === 'C' }]}>
                <span class="hf-season__year">{s.y}</span>
                <span class="hf-season__body">
                  <span class="hf-season__record">
                    {s.w}-{s.l}
                    {s.t ? `-${s.t}` : ''}
                    {s.rank && <span class="hf-season__rank"> · #{s.rank} of {s.teams}</span>}
                  </span>
                  {s.name !== h.name && <span class="hf-season__name">as {s.name}</span>}
                </span>
                <span class="hf-season__finish">
                  {finish(s)}
                  {s.pf != null && <span class="hf-season__pf">{fmt2(s.pf)} pts</span>}
                </span>
              </li>
            ))}
        </ol>
      </details>
    </section>

    {(h.highs.game || h.highs.season) && (
      <section class="hf-section" aria-labelledby="hf-highs">
        <p class="hf-section__kicker">Franchise bests</p>
        <h2 class="hf-section__title" id="hf-highs">High-water marks</h2>
        <div class="hf-highs">
          {h.highs.season && (
            <div class="hf-high">
              <span class="hf-plaque__label">Best season</span>
              <span class="hf-high__value">{h.highs.season.record}</span>
              <span class="hf-plaque__sub">
                {h.highs.season.y}
                {h.highs.season.r ? ` · ${resultLabel(h.highs.season.r)}` : ''}
              </span>
            </div>
          )}
          {h.highs.game && (
            <a class="hf-high" href={rivalryHref(h.highs.game.opponentId) ?? undefined}>
              <span class="hf-plaque__label">Highest score</span>
              <span class="hf-high__value">{fmt2(h.highs.game.s)}</span>
              <span class="hf-plaque__sub">
                {h.highs.game.y} week {h.highs.game.wk} vs {h.highs.game.opponent}
              </span>
            </a>
          )}
          {h.highs.win && (
            <a class="hf-high" href={rivalryHref(h.highs.win.opponentId) ?? undefined}>
              <span class="hf-plaque__label">Biggest win</span>
              <span class="hf-high__value">+{fmt2(h.highs.win.s - h.highs.win.os)}</span>
              <span class="hf-plaque__sub">
                {fmt2(h.highs.win.s)}–{fmt2(h.highs.win.os)} vs {h.highs.win.opponent}, {h.highs.win.y}
              </span>
            </a>
          )}
        </div>
      </section>
    )}

    <slot name="after-highs" />

    {!ownerOnly && h.owners.length > 0 && (
      <section class="hf-section" aria-labelledby="hf-owners">
        <p class="hf-section__kicker">Who ran it</p>
        <h2 class="hf-section__title" id="hf-owners">{h.owners.length === 1 ? 'The owner' : 'The owners'}</h2>
        <ol class="hf-list">
          {h.owners
            .slice()
            .reverse()
            .map((o) => (
              <li class="hf-row">
                <span class="hf-row__body">
                  <span class="hf-row__name">
                    {o.entity.key.startsWith('slot:')
                      ? 'Owner not on record'
                      : ownerHref(o.entity)
                        ? <a href={ownerHref(o.entity)}>{o.entity.name}</a>
                        : o.entity.name}
                  </span>
                  <span class="hf-row__sub">
                    {o.from === o.to ? o.from : `${o.from}–${o.current ? 'now' : o.to}`} · {o.seasons}{' '}
                    {o.seasons === 1 ? 'season' : 'seasons'}
                  </span>
                </span>
                <span class="hf-row__stat">
                  {o.record}
                  {o.titles > 0 && <span class="hf-row__titles">{o.titles}× champ</span>}
                </span>
              </li>
            ))}
        </ol>
      </section>
    )}

    {opponents.length > 0 && (
      <section class="hf-section" aria-labelledby="hf-h2h">
        <p class="hf-section__kicker">Head to head</p>
        <h2 class="hf-section__title" id="hf-h2h">Against the league</h2>
        <ol class="hf-list">
          {opponents.map((o) => {
            const href = rivalryHref(o.opponentId);
            const Tag = href ? 'a' : 'div';
            return (
              <li>
                <Tag class:list={['hf-row', 'hf-vs', { 'hf-row--mine': o.opponentId === viewerFranchise }]} href={href ?? undefined}>
                  {o.icon ? (
                    <img class="hf-row__logo" src={o.icon} alt="" width="28" height="28" loading="lazy" />
                  ) : (
                    <span class="hf-row__logo hf-row__logo--blank" aria-hidden="true">{initials(o.name)}</span>
                  )}
                  <span class="hf-row__body">
                    <span class="hf-row__name">{o.name}</span>
                    <span class="hf-vs__bar" style={pairStyle(o.opponentId)} aria-hidden="true">
                      <span style={`width: ${(o.pct * 100).toFixed(1)}%`}></span>
                    </span>
                  </span>
                  <span class="hf-row__stat">
                    {o.record}
                    <span class="hf-row__sub">
                      {o.games} games{o.playoffGames ? `, ${o.playoffGames} in playoffs` : ''}
                    </span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ol>
        {formerOpponents.length > 0 && (
          <details class="hf-details">
            <summary>Former franchises ({formerOpponents.length})</summary>
            <ol class="hf-list">
              {formerOpponents.map((o) => (
                <li class="hf-row">
                  <span class="hf-row__body">
                    <span class="hf-row__name">{o.name}</span>
                  </span>
                  <span class="hf-row__stat">
                    {o.record}
                    <span class="hf-row__sub">{o.games} games</span>
                  </span>
                </li>
              ))}
            </ol>
          </details>
        )}
      </section>
    )}

    <slot />
  </div>
</TheLeagueLayout>

<style>
  .hf {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
    color: var(--page-text);
  }

  /* ── Hero: the Broadcast team-color split ─────────────────────────────── */
  .hf-hero {
    /* A league's hero slot content sits on the team colors: its text tokens
       read white here, whatever theme the page is in. */
    --page-text: var(--color-white);
    --content-text-muted: color-mix(in srgb, var(--color-white) 82%, transparent);
    --color-gray-400: color-mix(in srgb, var(--color-white) 72%, transparent);
    --content-border: color-mix(in srgb, var(--color-white) 30%, transparent);
    /* Phones stack the logo over the name so the text gets the full width. */
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0.5rem 0 1rem;
    padding: 1.25rem 1rem;
    color: var(--color-white);
    background: linear-gradient(120deg, var(--hf-a) 0%, var(--hf-a) 68%, var(--hf-b) 68.2%, var(--hf-b) 100%);
