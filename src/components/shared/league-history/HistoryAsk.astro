---
/**
 * Ask the History on the History home: the bar that opens the ask screen
 * (HistoryAskPage.astro), a few questions to start from, and "The league is
 * asking", this week's most-asked topics, each shown through its latest
 * answer (ask-store leagueIsAsking). What owners ask is what the home page
 * puts forward (Brandon, 2026-10-26): a topic counts each owner once, whether
 * they asked it or opened someone's link to it.
 */
import '../../../styles/history-ask.css';
import type { LeagueDefinition } from '../../../config/leagues';
import type { AskingTopic } from '../../../utils/league-history/ask-store';
import { ASK_EXAMPLES } from '../../../utils/league-history/ask-format.mjs';
import { answerTeam } from '../../../utils/league-history/ask-render';

interface Props {
  league: LeagueDefinition;
  /** The league's path prefix ('/theleague', or '' on its own domain). */
  base: string;
  asking?: { week: 'this' | 'last'; topics: AskingTopic[] };
}

const { league, base, asking = { week: 'this', topics: [] } } = Astro.props as Props;
const askPage = `${base}/history/ask`;
const [hot, ...rest] = asking.topics;
const most = Math.max(1, ...asking.topics.map((t) => t.owners));
const owners = (n: number) => `${n} ${n === 1 ? 'owner' : 'owners'}`;
const teamStyle = (t: AskingTopic) => {
  const team = answerTeam(t.answer.table);
  return team ? `--ha-team: var(--team-accent-${team}, var(--history-gold))` : undefined;
};
---

<section class="ha" aria-labelledby="ha-title">
  <h2 class="visually-hidden" id="ha-title">Ask the History</h2>
  <a class="ha-bar" href={askPage}>
    <svg class="ha-bar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
    <span class="ha-bar__text">Ask the History anything…</span>
    <span class="ha-bar__go">Ask</span>
  </a>
  <ul class="ha__examples" aria-label={`Questions to ask about ${league.name}`}>
    {ASK_EXAMPLES.slice(0, 4).map((q) => (
      <li><a class="ha__example" href={`${askPage}?q=${encodeURIComponent(q)}`}>{q}</a></li>
    ))}
  </ul>

  {hot && (
    <div class="ha-asking">
      <div class="ha-asking__head">
        <h3 class="ha-asking__title">The league is asking</h3>
        <span class="ha-asking__when">{asking.week === 'this' ? 'This week' : 'Last week'}</span>
      </div>

      <article class="ui-card ha-hot" style={teamStyle(hot)}>
        <a class="ha-hot__main" href={`${base}/history/ask/${hot.answer.id}`}>
          <span class="ha-hot__kicker">Most asked</span>
          {hot.answer.headline ? (
            <>
              <span class="ha-hot__value">{hot.answer.headline.value}</span>
              <span class="ha-hot__label">{hot.answer.headline.label}</span>
            </>
          ) : (
            <span class="ha-hot__label">{hot.answer.question}</span>
          )}
          <span class="ha-hot__answer">{hot.answer.answer}</span>
        </a>
        <div class="ha-hot__foot">
          <span class="ha-hot__meta">{owners(hot.owners)} · “{hot.answer.question}”</span>
          <a class="ha-hot__follow" href={`${askPage}?after=${hot.answer.id}`}>Ask a follow-up</a>
        </div>
      </article>

      {rest.length > 0 && (
        <ol class="ha-asked-list">
          {rest.map((t) => (
            <li>
              <a class="ha-asked" href={`${base}/history/ask/${t.answer.id}`}>
                <span class="ha-asked__row">
                  <span class="ha-asked__q">{t.answer.question}</span>
                  {t.answer.headline && <span class="ha-asked__value">{t.answer.headline.value}</span>}
                </span>
                <span class="ha-asked__row">
                  <span class="ha-asked__heat" aria-hidden="true"><span style={`width: ${Math.round((t.owners / most) * 100)}%`}></span></span>
                  <span class="ha-asked__meta">{owners(t.owners)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  )}
</section>
