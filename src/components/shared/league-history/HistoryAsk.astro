---
/**
 * Ask the History on the History home: the ask box, a few questions to start
 * from, and "The league is
 * asking", this week's most-asked topics, each shown through its latest
 * answer (ask-store leagueIsAsking). What owners ask is what the home page
 * puts forward (Brandon, 2026-10-26): a topic counts each owner once, whether
 * they asked it or opened someone's link to it.
 *
 * For an owner who can ask, the box IS the chat (Brandon, 2026-11-26: typing
 * "just opens up another page … it doesn't feel like someone is really
 * answering me right where I was"): Buck answers right here, live, and the
 * box stays under the latest answer for the next follow-up. A signed-out
 * visitor to the public demo league chats in place too (Brandon, same day:
 * "it links me to another page first … then I have to hit X to go back"),
 * with names masked by the API; only once their free questions are gone does
 * a link send them to the ask screen, which carries the email box. Anyone
 * else (signed in to another league) still opens the ask screen.
 */
import '../../../styles/history-ask.css';
import type { LeagueDefinition } from '../../../config/leagues';
import type { AskingTopic } from '../../../utils/league-history/ask-store';
import { ASK_EXAMPLES } from '../../../utils/league-history/ask-format.mjs';
import { answerTeam } from '../../../utils/league-history/ask-render';
import { getAuthUser } from '../../../utils/auth';
import { canAskLeagueHistory } from '../../../utils/league-history/access';
import { canGuestAsk, GUEST_FREE_QUESTIONS } from '../../../utils/league-history/guest-ask';

interface Props {
  league: LeagueDefinition;
  /** The league's path prefix ('/theleague', or '' on its own domain). */
  base: string;
  asking?: { week: 'this' | 'last'; topics: AskingTopic[] };
}

const { league, base, asking = { week: 'this', topics: [] } } = Astro.props as Props;
const askPage = `${base}/history/ask`;
// "My team" means nothing to a signed-out visitor (the public demo asks as a guest).
const authUser = getAuthUser(Astro.request);
const examples = authUser ? ASK_EXAMPLES : ASK_EXAMPLES.filter((q) => !/\bmy\b/i.test(q));
const guest = !authUser && canGuestAsk(league.slug);
const inPlace = canAskLeagueHistory(authUser, league.id) || guest;
const [hot, ...rest] = asking.topics;
const most = Math.max(1, ...asking.topics.map((t) => t.owners));
const owners = (n: number) => `${n} ${n === 1 ? 'owner' : 'owners'}`;
const teamStyle = (t: AskingTopic) => {
  const team = answerTeam(t.answer.table);
  return team ? `--ha-team: var(--team-accent-${team}, var(--history-gold))` : undefined;
};
---

<section class="ha" aria-labelledby="ha-title" data-ha-chat={inPlace ? '' : undefined} data-guest={guest ? 'true' : undefined} data-league={league.slug} data-base={base}>
  <h2 class="visually-hidden" id="ha-title">Ask the History</h2>
  {inPlace ? (
    <>
      <div class="ha-chat" data-ha-thread hidden aria-live="polite"></div>
      <form class="ha-bar" data-ha-form>
        <svg class="ha-bar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
        <label class="visually-hidden" for={`ha-q-${league.slug}`}>Ask the History</label>
        <input id={`ha-q-${league.slug}`} class="ha-bar__input" name="question" maxlength="300" autocomplete="off" enterkeyhint="send" placeholder="Ask the History anything…" required />
        <button class="ha-bar__go" type="submit">Ask</button>
      </form>
      <p class="hask-status" data-ha-status role="status" aria-live="polite"></p>
      {guest && <p class="ha-chat__guest" data-ha-guest>{GUEST_FREE_QUESTIONS} free questions a day · owner names hidden</p>}
      <ul class="ha__examples" data-ha-chips aria-label={`Questions to ask about ${league.name}`}>
        {examples.slice(0, 4).map((q) => (
          <li><button class="ha__example" type="button" data-ha-suggest>{q}</button></li>
        ))}
      </ul>
      <p class="ha-chat__foot" data-ha-foot hidden>
        <a class="cta-link" data-ha-full href={askPage}>Open full screen</a>
      </p>
    </>
  ) : (
    <>
      <a class="ha-bar" href={askPage}>
        <svg class="ha-bar__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
        <span class="ha-bar__text">Ask the History anything…</span>
        <span class="ha-bar__go">Ask</span>
      </a>
      <ul class="ha__examples" aria-label={`Questions to ask about ${league.name}`}>
        {examples.slice(0, 4).map((q) => (
          <li><a class="ha__example" href={`${askPage}?q=${encodeURIComponent(q)}`}>{q}</a></li>
        ))}
      </ul>
    </>
  )}

  {hot && (
    <div class="ha-asking">
      <div class="ha-asking__head">
        <h3 class="ha-asking__title">The league is asking</h3>
        <span class="ha-asking__when">{asking.week === 'this' ? 'This week' : 'Last week'}</span>
      </div>

      <article class="ui-card ha-hot" style={teamStyle(hot)}>
        <a class="ha-hot__main" href={`${base}/history/ask/${hot.answer.id}`}>
          <span class="ha-hot__kicker">Most asked</span>
          {hot.answer.headline ? (
            <>
              <span class="ha-hot__value">{hot.answer.headline.value}</span>
              <span class="ha-hot__label">{hot.answer.headline.label}</span>
            </>
          ) : (
            <span class="ha-hot__label">{hot.answer.question}</span>
          )}
          <span class="ha-hot__answer">{hot.answer.answer}</span>
        </a>
        <div class="ha-hot__foot">
          <span class="ha-hot__meta">{owners(hot.owners)} · “{hot.answer.question}”</span>
          <a class="ha-hot__follow" href={`${askPage}?after=${hot.answer.id}`}>Ask a follow-up</a>
        </div>
      </article>

      {rest.length > 0 && (
        <ol class="ha-asked-list">
          {rest.map((t) => (
            <li>
              <a class="ha-asked" href={`${base}/history/ask/${t.answer.id}`}>
                <span class="ha-asked__row">
                  <span class="ha-asked__q">{t.answer.question}</span>
                  {t.answer.headline && <span class="ha-asked__value">{t.answer.headline.value}</span>}
                </span>
                <span class="ha-asked__row">
                  <span class="ha-asked__heat" aria-hidden="true"><span style={`width: ${Math.round((t.owners / most) * 100)}%`}></span></span>
                  <span class="ha-asked__meta">{owners(t.owners)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  )}
</section>

<script>
  import { renderAnswer } from '../../../utils/league-history/ask-render';
  import { prefetchCard, shareAnswer } from '../../../utils/league-history/share-answer';
  import { chatTurn } from '../../../utils/league-history/ask-live';

  /** The follow-ups Buck suggests take the starter questions' place under the box. */
  function setChips(root: HTMLElement, questions: string[]) {
    const list = root.querySelector<HTMLElement>('[data-ha-chips]');
    if (!list || !questions.length) return;
    list.setAttribute('aria-label', 'Suggested follow-ups');
    list.replaceChildren(
      ...questions.map((q) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.className = 'ha__example';
        b.type = 'button';
        b.dataset.haSuggest = '';
        b.textContent = q;
        li.append(b);
        return li;
      }),
    );
  }

  async function ask(root: HTMLElement, question: string): Promise<boolean> {
    const thread = root.querySelector<HTMLElement>('[data-ha-thread]');
    const status = root.querySelector<HTMLElement>('[data-ha-status]');
    if (!thread || root.dataset.busy) return false;
    root.dataset.busy = 'true';
    if (status) status.textContent = '';
    thread.hidden = false;
    const n = Number(root.dataset.turns ?? '0');
    if (n === 0) root.dataset.firstQuestion = question;
    try {
      const outcome = await chatTurn(
        {
          thread,
          league: root.dataset.league ?? '',
          base: root.dataset.base ?? '',
          question,
          after: root.dataset.after ?? '',
          turns: n,
          firstQuestion: root.dataset.firstQuestion ?? question,
        },
        renderAnswer,
      );
      const allowance = (outcome.data as { guest?: GuestAllowance | null } | null)?.guest;
      if (allowance) showGuest(root, allowance);
      if (!outcome.ok) {
        if (status) {
          status.textContent = outcome.error;
          // Out of free questions: the ask screen has the email box for more.
          const needEmail = (outcome.data as { needEmail?: boolean } | null)?.needEmail === true;
          if (root.dataset.guest && (needEmail || (allowance && allowance.used >= allowance.limit))) {
            const more = document.createElement('a');
            more.className = 'cta-link';
            more.href = `${root.dataset.base ?? ''}/history/ask`;
            more.textContent = 'Get more questions';
            status.append(' ', more);
          }
        }
        if (n === 0) thread.hidden = true;
        return false;
      }
      root.dataset.turns = String(n + 1);
      const id = outcome.data.id;
      if (id) {
        root.dataset.after = id;
        void prefetchCard({ league: root.dataset.league ?? '', id });
        const full = root.querySelector<HTMLAnchorElement>('[data-ha-full]');
        if (full) full.href = `${root.dataset.base ?? ''}/history/ask?after=${encodeURIComponent(id)}`;
        root.querySelector<HTMLElement>('[data-ha-foot]')?.removeAttribute('hidden');
      }
      setChips(root, outcome.data.followUps ?? []);
      const input = root.querySelector<HTMLInputElement>('.ha-bar__input');
      if (input) input.placeholder = 'Ask a follow-up…';
      return true;
    } finally {
      delete root.dataset.busy;
    }
  }

  interface GuestAllowance {
    used: number;
    limit: number;
    hasEmail: boolean;
  }

  /** A guest's questions left today, under the box. */
  function showGuest(root: HTMLElement, a: GuestAllowance) {
    const line = root.querySelector<HTMLElement>('[data-ha-guest]');
    if (!root.dataset.guest || !line) return;
    const left = Math.max(0, a.limit - a.used);
    line.textContent = `${left > 0 ? `${left} free ${left === 1 ? 'question' : 'questions'} left today` : 'No free questions left today'} · owner names hidden`;
  }

  function init() {
    // A fresh page each navigation (the section is swapped), so the flag is per page.
    const root = document.querySelector<HTMLElement>('[data-ha-chat]');
    if (!root || root.dataset.init) return;
    root.dataset.init = 'true';
    const form = root.querySelector<HTMLFormElement>('[data-ha-form]');
    const input = form?.querySelector<HTMLInputElement>('input');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const q = input?.value.trim() ?? '';
      if (!q || !input || q.length < 5) return;
      input.value = '';
      if (!(await ask(root, q))) input.value = q;
    });
    root.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const chip = target.closest<HTMLButtonElement>('[data-ha-suggest]');
      if (chip && !chip.disabled) return void ask(root, chip.textContent?.trim() ?? '');
      const share = target.closest<HTMLButtonElement>('[data-hask-share]');
      if (!share?.dataset.id) return;
      const outcome = await shareAnswer({ league: root.dataset.league ?? '', base: root.dataset.base ?? '', id: share.dataset.id, question: share.dataset.question ?? '' });
      if (outcome === 'copied') share.textContent = 'Link copied';
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
