---
/**
 * A shared Ask the History answer, /<league>/history/ask/<id> — shared by
 * TheLeague and the AFL. Readable by anyone with the link, like every other
 * history page; asking another question is still for signed-in owners
 * (HistoryAsk.astro). The answer and its table are the ones saved when it was
 * asked (ask-store.ts), so the link reads the same next season.
 *
 * A follow-up's link shows the WHOLE conversation, first question down, each
 * earlier answer with its own chart (Brandon, 2026-11-26: sharing a follow-up
 * "doesn't give any context to the first one").
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import HistoryTabs from './HistoryTabs.astro';
import HistoryAnswer from './HistoryAnswer.astro';
import { getLeagueBySlug, type CanonicalLeagueSlug } from '../../../config/leagues';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { conversationTurns, countAnswerOpen, loadConversation, type SavedAnswer } from '../../../utils/league-history/ask-store';
import { franchiseIdForLeague, getAuthUser } from '../../../utils/auth';
import { ANSWER_CARD_HEIGHT, ANSWER_CARD_WIDTH } from '../../../utils/league-history/answer-card';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  saved: SavedAnswer;
}

const { leagueSlug, saved } = Astro.props as Props;
const league = getLeagueBySlug(leagueSlug)!;
const hideLeaguePrefix = Astro.locals.hideLeaguePrefix ?? false;
const base = resolveLeaguePath(`/${league.slug}`, hideLeaguePrefix).replace(/\/$/, '');
const r = (path: string) => resolveLeaguePath(`/${league.slug}${path}`, hideLeaguePrefix);
// Another owner opening the link counts toward the History home's "The league
// is asking". A Redis hiccup must not cost the page.
await countAnswerOpen(saved, franchiseIdForLeague(getAuthUser(Astro.request), league.id)).catch(() => {});
// The portrait share card (answer-card.ts) is the link's unfurl, so a pasted
// link shows the same picture the Share button sends.
const card = new URL(`/api/og/league-history/answer.png?league=${league.slug}&id=${encodeURIComponent(saved.id)}`, Astro.url).href;
const chain = await loadConversation(saved).catch(() => []);
const earlier = conversationTurns(saved, chain);
const firstQuestion = earlier.length ? ('full' in earlier[0] ? earlier[0].full.question : earlier[0].text.question) : saved.question;
const kicker = (i: number) => (i === 0 ? 'You asked' : 'Then you asked');
const asked = new Date(saved.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<TheLeagueLayout title={`Ask the history · ${league.name}`} og={{ title: earlier.length ? `${firstQuestion} · ${saved.question}` : saved.question, description: saved.answer, image: card, imageWidth: ANSWER_CARD_WIDTH, imageHeight: ANSWER_CARD_HEIGHT }}>
  <div class="hap">
    <Breadcrumbs
      items={[
        { label: league.name, href: `/${league.slug}` },
        { label: 'History', href: r('/history') },
        { label: 'Ask the history' },
      ]}
    />
    <HistoryTabs leagueSlug={league.slug} current="home" />
    {earlier.length === 0 ? (
      <HistoryAnswer question={saved.question} headline={saved.headline} answer={saved.answer} table={saved.table} asOf={saved.asOf} records={saved.records} base={base} />
    ) : (
      <div class="hap__chat">
        {earlier.map((t, i) => (
          <section class="hask-turn">
            <p class="hask-asked"><span class="hask-asked__kicker">{kicker(i)}</span>{'full' in t ? t.full.question : t.text.question}</p>
            {'full' in t ? (
              <HistoryAnswer headline={t.full.headline} answer={t.full.answer} table={t.full.table} asOf={t.full.asOf} records={t.full.records} base={base} />
            ) : (
              <p class="hask-earlier">{t.text.answer}</p>
            )}
          </section>
        ))}
        <section class="hask-turn">
          <p class="hask-asked"><span class="hask-asked__kicker">{kicker(earlier.length)}</span>{saved.question}</p>
          <HistoryAnswer headline={saved.headline} answer={saved.answer} table={saved.table} asOf={saved.asOf} records={saved.records} base={base} />
        </section>
      </div>
    )}
    <p class="hap__meta">
      Asked {saved.guest ? 'by a visitor ' : saved.askedBy.name ? `by ${saved.askedBy.name} ` : ''}on {asked}. Counted from the games played up to then.
    </p>
    <p class="hap__next">
      <button
        class="cta cta--primary hap__share"
        type="button"
        data-hap-share
        data-league={league.slug}
        data-base={base}
        data-id={saved.id}
        data-question={firstQuestion}
      >Share to the group chat</button>
      <a class="cta cta--ghost" href={`${base}/history/ask?after=${saved.id}`}>Ask a follow-up</a>
      <a class="cta cta--ghost" href={`${base}/history/ask`}>Ask your own</a>
    </p>
  </div>
</TheLeagueLayout>

<style>
  .hap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
    color: var(--page-text);
  }
  .hap__chat {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
    margin-top: 1rem;
  }
  .hap__meta {
    margin: 0.5rem 0 0;
    color: var(--content-text-muted);
    font-size: var(--font-size-xs);
  }
  .hap__next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }
</style>

<script>
  import { shareAnswer } from '../../../utils/league-history/share-answer';

  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-hap-share]');
    if (!button || button.dataset.init) return;
    button.dataset.init = 'true';
    const answer = {
      league: button.dataset.league ?? '',
      base: button.dataset.base ?? '',
      id: button.dataset.id ?? '',
      question: button.dataset.question ?? '',
    };
    button.addEventListener('click', async () => {
      const outcome = await shareAnswer(answer);
      if (outcome === 'copied') button.textContent = 'Link copied';
    });
  });
</script>
