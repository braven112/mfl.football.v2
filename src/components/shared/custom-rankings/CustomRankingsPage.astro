---
/**
 * Custom Rankings — shared implementation (extracted from TheLeague's page so
 * the AFL gets the identical board via a thin wrapper).
 *
 * Hidden, admin-only page for creating personalized player rankings. Seeds
 * from the composite "My Rank" average built on Import Rankings, supports
 * drag-and-drop reordering, tier breaks, and position filtering. State
 * persists via Vercel KV, keyed per league (src/utils/rankings-scope.ts) —
 * an owner's AFL board and their TheLeague board are separate opinions.
 *
 * Leagues without a salary cap (the AFL) are handled without a branch: with
 * no salaries on the roster feed, pointsPerDollar resolves to 0 and
 * pointsToDollarValue short-circuits, so vorpDollar comes out 0 while the
 * vorpPoints column — the only one the board renders — stays meaningful.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import CustomRankingsPageIsland from './CustomRankingsPage';
import { spriteUrlFor } from '../../../utils/sprite-url';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { getPlayerMap } from '../../../utils/player-map';
import { getLeagueContext } from '../../../utils/league-context';
import { getLeagueBySlug, ensureLeaguePrefix } from '../../../config/leagues';
import { defaultRankingSourcesFor } from '../../../config/leagues-data.mjs';
import { resolveDraftAvailability } from '../../../utils/draft-availability';
import { liveRostersFeed } from '../../../utils/rosters/live-rosters-feed';
import '../../../styles/player-cell.css';
import '../../../styles/custom-rankings.css';
import '../../../styles/player-action-button.css';
import PlayerActionModal from '../PlayerActionModal.astro';
import { parseNumber } from '../../../utils/formatters';
import { calculatePointsPerDollar } from '../../../utils/surplus-value';
import { calculateAllVORP } from '../../../utils/vorp';
import espnCollegeIds from '../../../../data/theleague/espn-college-ids.json';
import type { AuthUser } from '../../../utils/auth';
import { loadLeagueData } from '../../../utils/league-data';

interface Props {
  /** Page <title>; defaults to TheLeague's original string. */
  title?: string;
  /**
   * The authorized session, resolved and gated by the ROUTE.
   *
   * The gate cannot live here: `Astro.redirect()` only produces a redirect
   * from a page, endpoint, or middleware — returning it from a component's
   * frontmatter just stops rendering, which shipped a blank 200 instead of
   * bouncing the visitor. Each thin wrapper calls
   * `resolveCustomRankingsAccess` and redirects, then hands the user down.
   */
  user: AuthUser;
}

const { title = 'My Draft List | The League', user } = Astro.props as Props;

const leagueSlug = getLeagueContext(Astro.url).slug;
const league = getLeagueBySlug(leagueSlug)!;

// Per-league year clock — the AFL rolls June 1, TheLeague Feb 14.
const leagueYear = getLeagueYearForSlug(leagueSlug);
const leagueYearStr = String(leagueYear);
const isAfl = leagueSlug === 'afl-fantasy';

// ---------------------------------------------------------------------------
// Load MFL players for enrichment (headshot URLs, positions)
// ---------------------------------------------------------------------------
// Read through the league-data loader for the current league year only —
// never a glob, which compiled every season of both leagues' players.json into
// the serverless function (storage-and-build.md § "League data lives in Blob").
// Every league but the AFL reads TheLeague's feeds, as the per-league globs
// this replaced did.
const feedLeague = getLeagueBySlug(isAfl ? 'afl-fantasy' : 'theleague')!;
const yearFeed = (file: string) => `${feedLeague.dataPath}/mfl-feeds/${leagueYearStr}/${file}`;
const [playersData, projScoreData, committedRostersData, leagueFeedData, builtinSnapshot] = await Promise.all([
  loadLeagueData<any>(yearFeed('players.json')),
  loadLeagueData<any>(yearFeed('projectedScores.json')),
  loadLeagueData<any>(yearFeed('rosters.json')),
  loadLeagueData<any>(yearFeed('league.json')),
  // Built-in ranking sources — see "Built-in ranking sources" below.
  loadLeagueData<any>(`data/ranking-sources/${leagueYearStr}.json`),
]);

// Build player array with headshot info for client-side enrichment
const crPlayerIdentityMap = getPlayerMap(leagueYear);
const rawPlayers = playersData?.players?.player ?? [];
const mflPlayers = rawPlayers
  .filter((p: any) => p.name && p.position)
  .map((p: any) => {
    const identity = crPlayerIdentityMap.get(p.id);
    return {
      id: p.id,
      name: identity?.name ?? p.name,
      position: identity?.position ?? (p.position === 'Def' ? 'DEF' : p.position),
      team: identity?.nflTeam ?? p.team ?? '',
      espnId: identity?.espnId ?? (p.espn_id || (espnCollegeIds as any).players?.[p.id]?.espnCollegeId || null),
    };
  });

// `status` is carried separately from the display list: it drives the draft
// pool test (see draft-availability.ts) and has no business in the island's
// player props, which are about rendering a row. Declared HERE, after
// rawPlayers — `const` is not hoisted, so sitting it above that line threw
// "Cannot access 'rawPlayers' before initialization" and served a blank page.
const playerStatusById = new Map<string, string | null>(
  rawPlayers.map((p: any) => [p.id, p.status ?? null]),
);

// ---------------------------------------------------------------------------
// Load projected scores + rosters for VORP calculation
// ---------------------------------------------------------------------------
// projectedScores.json and rosters.json were loaded above, with players.json.
let rostersData: any = committedRostersData;
// Live, because "Available only" is a claim about who is on a roster RIGHT
// NOW: the committed rosters.json is a once-a-day snapshot
// (scripts/lib/held-sync-files.mjs), and on draft night a day-old copy offers
// players already taken. Falls back to the committed copy.
rostersData = await liveRostersFeed(rostersData, leagueYear, league.id);

// Build maps for VORP
const projectedScores = new Map<string, number>();
for (const ps of (projScoreData?.projectedScores?.playerScore ?? [])) {
  const score = parseNumber(ps.score);
  if (score > 0) projectedScores.set(ps.id, score);
}

const playerPositionMap = new Map<string, { position: string }>();
for (const p of mflPlayers) {
  playerPositionMap.set(p.id, { position: p.position });
}

// Calculate points-per-dollar ratio from rostered players. Resolves to 0 in a
// league with no salary cap, which pointsToDollarValue handles.
const rosteredPlayers = new Map<string, { salary: number; position: string }>();
for (const franchise of (rostersData?.rosters?.franchise ?? [])) {
  for (const rp of (Array.isArray(franchise.player) ? franchise.player : [])) {
    const salary = parseNumber(rp.salary);
    const meta = playerPositionMap.get(rp.id);
    if (meta) {
      rosteredPlayers.set(rp.id, { salary, position: meta.position });
    }
  }
}
const pointsPerDollar = calculatePointsPerDollar(projectedScores, rosteredPlayers);

// ---------------------------------------------------------------------------
// Built-in ranking sources (data/ranking-sources/<year>.json)
// ---------------------------------------------------------------------------
// Read on the SERVER and handed to the island, mirroring ImportRankingsPage.
// The board needs these because it can no longer assume the owner has already
// visited Import Rankings: syncBuiltinImports was called from that page and
// nowhere else, so a browser that never opened it had no composite — and the
// board, whose only seeds were the composite and MFL, had nothing to show and
// nothing to push. That was a dead end for exactly the owner this page is for:
// one with no MFL draft list yet who wants to build their first.
// (Loaded above, with the feeds: data/ranking-sources/<year>.json.)

// ---------------------------------------------------------------------------
// Draftable-player availability (the "Available only" filter)
// ---------------------------------------------------------------------------
// Computed on the SERVER from the feeds this page already reads, so the board
// needs no extra request to know what the owner can take. Two league-specific
// rules, both handled in draft-availability.ts: the league's draftPlayerPool
// (TheLeague drafts rookies only; the AFL drafts anyone) and roster membership
// scoped to THIS owner's conference — the AFL holds the same player once per
// conference, so "on a roster" is not the same question as "unavailable to
// you". Resolves to null when the feeds can't be trusted, and the island then
// hides the filter rather than hiding players wrongly.
// (league.json was loaded above, with the other feeds.)

const availability = resolveDraftAvailability({
  players: mflPlayers.map((p: any) => ({ id: p.id, status: playerStatusById.get(p.id) })),
  leagueJson: leagueFeedData,
  rostersJson: rostersData,
  franchiseId: user.franchiseId,
});

// Calculate VORP for all players
const vorpResults = calculateAllVORP(projectedScores, playerPositionMap, pointsPerDollar);
const vorpMap: Record<string, { vorpPoints: number; vorpDollar: number }> = {};
for (const [id, result] of vorpResults) {
  vorpMap[id] = result;
}
---

<TheLeagueLayout title={title}>
  <CustomRankingsPageIsland
    client:load
    mflPlayersJson={JSON.stringify(mflPlayers)}
    franchiseId={user.franchiseId}
    vorpMapJson={JSON.stringify(vorpMap)}
    importRankingsHref={ensureLeaguePrefix(league, '/import-rankings')}
    builtinSnapshotJson={JSON.stringify(builtinSnapshot)}
    defaultSourceIds={defaultRankingSourcesFor(leagueSlug)}
    availableIdsJson={availability ? JSON.stringify(availability.availableIds) : null}
    draftPool={availability?.pool ?? null}
    availabilityPerConference={availability?.perConference ?? false}
    spriteUrl={spriteUrlFor(Astro.url)}
  />
  <PlayerActionModal />
</TheLeagueLayout>
