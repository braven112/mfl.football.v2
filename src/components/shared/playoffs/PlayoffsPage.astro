---
/**
 * The shared Playoffs page: every league's playoff brackets, rendered from
 * MFL's committed bracket feed. Moved whole out of the AFL's page — the
 * repeatable one (the owner's call, Oct 2026; TheLeague's playoffs page stays
 * its own). The AFL and every package league with the Playoffs box ticked
 * render it.
 *
 * What a league hands in, and why it is not decided here:
 *   - `brackets`: already built (src/utils/playoff-bracket-views.ts) through
 *     the league's OWN seeding resolver, and already filtered to `tabView`.
 *     Seeding is league-specific (the AFL seeds per conference and runs an NIT;
 *     a package league takes MFL's resolved franchises as they are).
 *   - `tabs`: the league's views. One tab hides the selector.
 *   - `customView`: the current tab is the league's own competition (the AFL's
 *     Prizes), rendered into the default slot — the shared page never learns
 *     its rules (CLAUDE.md, "Share the standard views; a league's own competition stays its own").
 * The year redirect and any cookie write stay in the route: `Astro.redirect()`
 * only redirects from a PAGE, and `Astro.cookies.set()` from a component
 * throws after the headers commit.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import YearSelector from '../YearSelector.astro';
import EmptyState from '../states/EmptyState.astro';
import '../../../styles/loading.css';
import { spriteUrl } from '../../../utils/sprite-url';
import { getLeagueBySlug } from '../../../config/leagues';
import type { BracketView } from '../../../utils/playoff-bracket-views';

export interface PlayoffTab {
  view: string;
  title: string;
  /** Sprite symbol id, e.g. `icon-trophy`. */
  icon: string;
}

interface Props {
  leagueSlug: string;
  availableYears: number[];
  selectedYear: number;
  /** The current tab's brackets, built and filtered by the route. */
  brackets: BracketView[];
  /** Every week the season's brackets play — polled for live scores. */
  liveWeeks: number[];
  tabs: PlayoffTab[];
  tabView: string;
  /** True when the current tab is the league's own view, passed as the default slot. */
  customView?: boolean;
  usedReconstructedBracket?: boolean;
}

const {
  leagueSlug,
  availableYears,
  selectedYear,
  brackets,
  liveWeeks,
  tabs,
  tabView,
  customView = false,
  usedReconstructedBracket = false,
} = Astro.props;

// The league's own MFL host and id — never TheLeague's env-scoped globals
// (that bug once pointed every AFL live-scoring link at TheLeague).
const league = getLeagueBySlug(leagueSlug)!;
const envHost = `https://${league.mflHost}`;
const envLeagueId = league.id;
const hasBrackets = brackets.length > 0;
---

<TheLeagueLayout title="Playoff Brackets">
  <section class="playoff-page" data-league={leagueSlug}>
    <header class="playoff-hero">
      <div>
        <h1 class="hero-title">Playoff Brackets</h1>
        {usedReconstructedBracket && (
          <p class="hero-note">
            Rebuilt from the season schedule — MFL never recorded brackets this far back.
          </p>
        )}
      </div>
      {tabs.length > 1 && (
        <div class="view-selector">
          {tabs.map(tab => (
            <button class={`view-tab ${tabView === tab.view ? 'active' : ''}`} data-view={tab.view} title={tab.title}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="view-tab__icon">
                <use href={`${spriteUrl}#${tab.icon}`}></use>
              </svg>
            </button>
          ))}
        </div>
      )}
    </header>

    <div class="season-row">
      <div class="filter-item">
        <span class="filter-label">Season:</span>
        <YearSelector currentYear={selectedYear} availableYears={availableYears} />
      </div>
    </div>

    {!customView && !hasBrackets && (
      <EmptyState
        title="No brackets yet"
        body="This season's brackets appear once playoff seeds are set."
      />
    )}

    {customView ? (
      <slot />
    ) : hasBrackets && (
      <div class="brackets-grid">
        {brackets.map(bracket => (
          <article
            class={`bracket-card ${bracket.emphasis ? 'bracket-card--championship' : ''} ${bracket.rounds?.length > 1 ? 'bracket-card--full' : ''}`}
            id={`bracket-${bracket.id}`}
          >
            <div class="bracket-header">
              <div>
                <p class="bracket-label">{bracket.emphasis ? 'Championship' : 'Bracket'}</p>
                <h2 class="bracket-title">{bracket.name || `Bracket ${bracket.id}`}</h2>
                <p class="bracket-meta">
                  Starts week {bracket.startWeek || '?'} · {bracket.teamsInvolved ?? '?'} teams
                </p>
              </div>
              <div class="bracket-pill">
                {bracket.emphasis ? 'Primary' : 'Side bracket'}
              </div>
            </div>

            {bracket.roundsView.length === 0 ? (
              <div class="bracket-missing">Bracket data not available for this season.</div>
            ) : (
              <>
                {/* Earlier rounds (or all rounds if less than 4) */}
                <div class="bracket-scroll" data-bracket-id={bracket.id} aria-label={`${bracket.name || 'Bracket'} rounds`}>
                  {(bracket.roundsView.length >= 4
                    ? bracket.roundsView.slice(0, -1)
                    : bracket.roundsView
                  ).map((round, roundIdx) => (
                    <div class="bracket-round" data-week={bracket.rounds[roundIdx]?.week ?? roundIdx + 1}>
                      <p class="round-label">Week {bracket.rounds[roundIdx]?.week ?? roundIdx + 1}</p>
                      {round.map(game => {
                      const homeId = game.home.team?.id || '';
                      const liveScoreUrl = homeId
                        ? `${envHost}/${selectedYear}/ajax_ls?L=${envLeagueId}&W=${game.week}&FRANCHISE=${homeId}`
                        : `${envHost}/${selectedYear}/ajax_ls?L=${envLeagueId}&W=${game.week}`;
                      return (
                      <a
                        href={liveScoreUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="matchup-card-link"
                      >
                        <div class="matchup-card" data-status={game.status}>
                        <div class="team-row">
                          <div class="team-info">
                            <span class="seed-badge">{game.home.seedLabel || '—'}</span>
                            {game.home.icon ? (
                              <img
                                src={game.home.icon}
                                alt={`${game.home.label} logo`}
                                class="team-icon"
                                loading="lazy"
                              />
                            ) : (
                              <div class="team-icon team-icon--placeholder" aria-hidden="true"></div>
                            )}
                            <div class="team-text">
                              <div class="team-name">{game.home.label}</div>
                              {game.home.record && <div class="team-record">{game.home.record}</div>}
                            </div>
                          </div>
                          <div
                            class="score"
                            data-live-week={game.week}
                            data-live-team={game.home.team?.id || ''}
                          >
                            {typeof game.scores.home === 'number' ? game.scores.home.toFixed(2) : '—'}
                          </div>
                        </div>

                        <div class="team-row">
                          <div class="team-info">
                            <span class="seed-badge">{game.away.seedLabel || '—'}</span>
                            {game.away.icon ? (
                              <img
                                src={game.away.icon}
                                alt={`${game.away.label} logo`}
                                class="team-icon"
                                loading="lazy"
                              />
                            ) : (
                              <div class="team-icon team-icon--placeholder" aria-hidden="true"></div>
                            )}
                            <div class="team-text">
                              <div class="team-name">{game.away.label}</div>
                              {game.away.record && <div class="team-record">{game.away.record}</div>}
                            </div>
                          </div>
                          <div
                            class="score"
                            data-live-week={game.week}
                            data-live-team={game.away.team?.id || ''}
                          >
                            {typeof game.scores.away === 'number' ? game.scores.away.toFixed(2) : '—'}
                          </div>
                        </div>

                        <div class="matchup-status">
                          <div class="status-left">
                            <span class={`status-pill status-${game.status}`}>
                              {game.status === 'live' && 'Live'}
                              {game.status === 'final' && 'Final'}
                              {game.status === 'scheduled' && 'Scheduled'}
                            </span>
                            <div class="matchup-refresh-progress">
                              <div class="refresh-progress-container">
                                <div class="refresh-progress-bar" data-week={game.week}></div>
                              </div>
                            </div>
                          </div>
                          {game.winnerId && (
                            <span class="winner-flag">
                              Winner:{' '}
                              {game.winnerId === game.home.team?.id
                                ? game.home.label
                                : game.away.label}
                            </span>
                          )}
                        </div>
                      </div>
                      </a>
                      );
                    })}
                  </div>
                ))}
              </div>
              <div class="scroll-indicators" data-bracket-id={bracket.id}>
                {(bracket.roundsView.length >= 4
                  ? bracket.roundsView.slice(0, -1)
                  : bracket.roundsView
                ).map((_, roundIdx) => (
                  <button
                    class="scroll-indicator"
                    data-round-index={roundIdx}
                    aria-label={`Go to week ${bracket.rounds[roundIdx]?.week ?? roundIdx + 1}`}
                  />
                ))}
              </div>

              {/* Championship game below earlier rounds (if 4+ rounds) */}
              {bracket.roundsView.length >= 4 && (
                <div class="championship-highlight">
                  {/* Title and week come from the bracket, not a constant: this
                      block used to say "NIT Championship / Week 18" for any
                      4-round bracket, which is wrong for 2003-2006 (the bracket
                      is named just "NIT") and for every reconstructed season
                      (their finals are week 17). */}
                  <h2 class="bracket-title">{bracket.name || `Bracket ${bracket.id}`}</h2>
                  <p class="round-label">
                    Week {bracket.rounds[bracket.rounds.length - 1]?.week ?? '?'}
                  </p>
                  <div class="championship-game">
                    {bracket.roundsView[bracket.roundsView.length - 1].map(game => {
                      const homeId = game.home.team?.id || '';
                      const liveScoreUrl = homeId
                        ? `${envHost}/${selectedYear}/ajax_ls?L=${envLeagueId}&W=${game.week}&FRANCHISE=${homeId}`
                        : `${envHost}/${selectedYear}/ajax_ls?L=${envLeagueId}&W=${game.week}`;
                      return (
                      <a
                        href={liveScoreUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="matchup-card-link"
                      >
                        <div class="matchup-card" data-status={game.status}>
                          <div class="team-row">
                          <div class="team-info">
                            <span class="seed-badge">{game.home.seedLabel || '—'}</span>
                            {game.home.icon ? (
                              <img
                                src={game.home.icon}
                                alt={`${game.home.label} logo`}
                                class="team-icon"
                                loading="lazy"
                              />
                            ) : (
                              <div class="team-icon team-icon--placeholder" aria-hidden="true"></div>
                            )}
                            <div class="team-text">
                              <div class="team-name">{game.home.label}</div>
                              {game.home.record && <div class="team-record">{game.home.record}</div>}
                            </div>
                          </div>
                          <div
                            class={`score ${game.status === 'final' && typeof game.scores.home === 'number' && typeof game.scores.away === 'number' && game.scores.home < game.scores.away ? 'score-losing' : ''}`}
                            data-live-week={game.week}
                            data-live-team={game.home.team?.id || ''}
                          >
                            {typeof game.scores.home === 'number' ? game.scores.home.toFixed(2) : '—'}
                          </div>
                        </div>

                        <div class="team-row">
                          <div class="team-info">
                            <span class="seed-badge">{game.away.seedLabel || '—'}</span>
                            {game.away.icon ? (
                              <img
                                src={game.away.icon}
                                alt={`${game.away.label} logo`}
                                class="team-icon"
                                loading="lazy"
                              />
                            ) : (
                              <div class="team-icon team-icon--placeholder" aria-hidden="true"></div>
                            )}
                            <div class="team-text">
                              <div class="team-name">{game.away.label}</div>
                              {game.away.record && <div class="team-record">{game.away.record}</div>}
                            </div>
                          </div>
                          <div
                            class={`score ${game.status === 'final' && typeof game.scores.home === 'number' && typeof game.scores.away === 'number' && game.scores.away < game.scores.home ? 'score-losing' : ''}`}
                            data-live-week={game.week}
                            data-live-team={game.away.team?.id || ''}
                          >
                            {typeof game.scores.away === 'number' ? game.scores.away.toFixed(2) : '—'}
                          </div>
                        </div>

                        <div class="matchup-status">
                          <div class="status-left">
                            <span class={`status-pill status-${game.status}`}>
                              {game.status === 'live' && 'Live'}
                              {game.status === 'final' && 'Final'}
                              {game.status === 'scheduled' && 'Scheduled'}
                            </span>
                            <div class="matchup-refresh-progress">
                              <div class="refresh-progress-container">
                                <div class="refresh-progress-bar" data-week={game.week}></div>
                              </div>
                            </div>
                          </div>
                          {game.winnerId && (
                            <span class="winner-flag">
                              Winner:{' '}
                              {game.winnerId === game.home.team?.id
                                ? game.home.label
                                : game.away.label}
                            </span>
                          )}
                        </div>
                      </div>
                      </a>
                      );
                    })}
                  </div>
                </div>
              )}
              </>
            )}
          </article>
        ))}
      </div>
    )}

    <div class="mfl-link-footer">
      <p>
        <a href={`${envHost}/${selectedYear}/options?L=${envLeagueId}&O=79`} target="_blank" rel="noopener noreferrer" class="mfl-link">
          View MFL Playoff Bracket →
        </a>
      </p>
      {hasBrackets && (
        <p class="data-disclaimer" id="live-scores-timestamp">
          Scores updated: <span id="last-updated-time"><span class="loading-skeleton loading-skeleton--text" style="width: 4.5rem; display: inline-block; vertical-align: middle;" role="status" aria-busy="true" aria-live="polite" aria-label="Loading update time"></span></span>
        </p>
      )}
    </div>
  </section>
</TheLeagueLayout>

<style>
  .playoff-page {
    color: var(--page-text, #0f172a);
  }

  .playoff-hero {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: 20px;
    box-shadow: var(--box-shadow-lg);
    margin-bottom: 1rem;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(1.8rem, 2vw, 2.2rem);
    color: var(--page-text, #0f172a);
  }

  .hero-subtitle {
    margin: 0.35rem 0 0;
    color: var(--content-text-muted, #475569);
    max-width: 720px;
    font-size: 0.98rem;
  }

  /* Shown only when a bracket came from the schedule reconstruction rather
     than MFL's own export — an inference should never be silently presented
     as the league's record. */
  .hero-note {
    margin: 0.35rem 0 0;
    color: var(--content-text-muted, #475569);
    max-width: 720px;
    font-size: 0.85rem;
    font-style: italic;
  }

  .season-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--card-bg, #ffffff);
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: 16px;
    box-shadow: var(--box-shadow-lg);
    margin-bottom: 1rem;
  }

  .filter-item {
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
  }

  .filter-label {
    font-size: 0.85rem;
    color: var(--content-text-muted, #475569);
  }

  .view-selector {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .view-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.5rem .7rem;
    border: 2px solid transparent;
    border-radius: 0.5rem;
    background: var(--content-bg-muted, #f8fafc);
    cursor: pointer;
    transition: all var(--transition-base);
    position: relative;
    min-width: 69px;
  }
  @media (min-width: 640px) {
    .view-tab {
    padding: 0.75rem;
    }
  }

  .view-tab:hover {
    background: var(--table-row-bg-hover, #e2e8f0);
    border-color: var(--content-border, #cbd5e1);
  }

  .view-tab.active {
    background: color-mix(in srgb, var(--color-primary, #3b82f6) 18%, var(--content-bg, #fff));
    border-color: var(--color-primary, #3b82f6);
  }

  .view-tab__icon {
    max-width: var(--icon-btn-default-size, 30px);
    max-height: var(--icon-btn-default-size, 30px);
    width: 100%;
    height: 100%;
    fill: var(--icon-btn-default-text-color);
    color: var(--icon-btn-default-text-color);
  }

  .view-tab[data-active="true"] .view-tab__icon {
    fill: var(--icon-btn-default-focus-color);
    color: var(--icon-btn-default-focus-color);
  }

  .brackets-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
    background: var(--card-bg, #fff);
    border-radius: 1rem;
     box-shadow: var(--box-shadow-lg);
  }

  :global(html.dark) .brackets-grid {
    box-shadow:
      0 0 0 1px var(--content-border, #555555),
      var(--box-shadow-lg);
  }



  /* No box-shadow here. A bracket-card is a bare grid nested INSIDE the
     .brackets-grid card, so it has no background and no border-radius of its
     own — an elevation shadow on it draws a hard square-cornered halo against
     the card it already sits on. That's the double shadow, and it reads worst
     in dark mode: tokens-dark.css sets --shadow-color to pure black and raises
     the per-layer alphas, so the same --shadow-lg lands roughly six times
     heavier at night than in light. The card surface and its elevation belong
     to .brackets-grid; TheLeague's copy of this page has always been
     shadow-free here. */
  .bracket-card {
    display: grid;
  }


  .bracket-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  /* AFL gold, not --color-secondary (that token is TheLeague's brand green and
     the AFL theme never overrides it). Same light/dark split as the standings
     champion subtitle. --afl-gold-text carries the light/dark pair — amber on
     the white card, trophy gold on the navy one — so this needs one line. */
  .bracket-label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--afl-gold-text, #b45309);
    letter-spacing: 0.04em;
  }

  .bracket-title {
    margin: 0.1rem 0;
    font-size: 1.35rem;
    color: var(--page-text, #0f172a);
  }

  .bracket-meta {
    margin: 0;
    color: var(--content-text-muted, #475569);
    font-size: 0.9rem;
  }

  .bracket-pill {
    padding: 0.45rem 0.75rem;
    background: var(--content-bg-muted, #eef2ff);
    color: var(--page-text, #312e81);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* Championship highlight section */
  .championship-highlight {
    margin-top: 1.5rem;
    padding: 1rem;
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border: 2px solid #0ea5e9;
    border-radius: 12px;
  }

  .championship-label {
    margin: 0 0 0.75rem 0;
    font-size: 1rem;
    font-weight: 800;
    color: #0c4a6e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(html.dark) .championship-highlight {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.15) 0%, rgba(14, 165, 233, 0.08) 100%);
    border-color: #0ea5e9;
  }

  :global(html.dark) .championship-label {
    color: #7dd3fc;
  }


  .bracket-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 1fr);
    gap: 0.9rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  /* Mobile snap scrolling */
  @media (max-width: 768px) {
    .bracket-scroll {
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      gap: 0;
      grid-auto-columns: 100%;
      padding-bottom: 3rem; /* Space for scroll indicators */
    }

    .bracket-scroll::-webkit-scrollbar {
      display: none; /* Chrome, Safari */
    }

    .bracket-round {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      margin: 0 0.5rem;
    }
  }

  .bracket-round {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
  }

  .round-label {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--color-primary, #1c497c);
    margin: 0 0 0.35rem 0.25rem;
  }

  .matchup-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .matchup-card-link:hover {
    transform: translateY(-2px);
  }

  .matchup-card-link:hover .matchup-card {
    box-shadow: var(--shadow-lg);
  }

  .matchup-card-link:active {
    transform: translateY(0);
  }

  .matchup-card {
    background: var(--content-bg-muted, #f8fafc);
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: 12px;
    padding: 0.75rem;
    position: relative;
    display: grid;
    row-gap: 0.6rem;
  }

  .matchup-card[data-status='live'] {
    border-color: #f59e0b;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.12);
  }

  .matchup-card[data-status='final'] {
    border-color: rgba(28, 73, 124, 0.35);
  }

  /* Dark mode: final cards use the standard card border (AFL resolves to its
     navy-tinted --content-border). */
  :global(html.dark) .matchup-card[data-status='final'] {
    border-color: var(--content-border, #555555);
  }

  .matchup-card[data-status='scheduled'] {
    border-style: dashed;
  }

  .team-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .team-info {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .team-text {
    min-width: 0;
  }

  .team-name {
    margin: 0;
    font-weight: 800;
    font-size: var(--font-size-xs);
    color: var(--page-text, #0f172a);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .team-record {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: var(--content-text-muted, #475569);
  }

  .team-icon {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .team-icon--placeholder {
