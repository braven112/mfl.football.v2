---
import '../../styles/waiver-claims-panel.css';
// The claim rows are built by the client script below with
// `buildPlayerCellHTML`, so the lockup's stylesheet has to be global — a
// scoped rule never reaches innerHTML-injected markup. Both players pages
// already import it; importing it here too keeps the panel self-contained
// wherever it is dropped in.
import '../../styles/player-cell.css';
/**
 * WaiverClaimsPanel — the claims you have already filed, and what you can do
 * to them.
 *
 * ONE component for both leagues, same reason as WaiverClaimModal: the two
 * waiver systems differ in data (the AFL shows no bid), not in layout. Forking
 * it is how this repo grew 24 forked siblings — see
 * tests/page-fork-ratchet.test.ts.
 *
 * WHAT IT DELIBERATELY DOES NOT DO: reorder. MFL exposes no reorder control —
 * a round is one record whose `addsDrops` is an ordered list, MFL appends to
 * it, `REPLACE=1` is inert, and MFL's own editor changes only the drop and the
 * comment. Reordering could therefore only be delete-then-refile, which leaves
 * a window where the owner holds no claim at all. Delete and edit-drop each map
 * to a single MFL primitive with no such window, which is why they are safe to
 * offer while waivers are open. See
 * docs/claude/insights/features/waiver-claims.md (2026-09-03).
 *
 * Claims are FETCHED CLIENT-SIDE. The list needs a live owner-authenticated MFL
 * read, and doing that during SSR would put an MFL round-trip in front of every
 * Free Agents page load for every visitor, including the signed-out ones who
 * can never see this panel.
 */
export interface WaiverClaimsPanelConfig {
  /** False for a signed-out visitor or a session with no franchise. */
  canManage: boolean;
  /** Whether the league bids, so an award amount is worth a column. */
  system: 'bbid' | 'priority';
  /** The owner's roster, for the "drop instead" picker. */
  roster: Array<{ id: string; name: string }>;
  /**
   * MFL league id, used to scope the collapsed preference. BOTH leagues render
   * this panel and an owner may well want it hidden in one and not the other —
   * and with the ClientRouter a single module instance survives a hop between
   * them, so an unscoped key would carry the wrong league's choice across.
   */
  leagueId: string;
}

interface Props {
  config: WaiverClaimsPanelConfig;
}
const { config } = Astro.props;
---

<script type="application/json" id="waiver-claims-config" set:html={JSON.stringify(config)}></script>

{config.canManage && (
  <section class="wcp" id="waiver-claims-panel" hidden aria-labelledby="wcp-heading">
    <div class="wcp__head">
      <h2 class="wcp__title" id="wcp-heading">Your waiver claims</h2>
      <span class="wcp__head-right">
        <a class="wcp__mfl" id="wcp-mfl" href="#" target="_blank" rel="noopener" hidden>View on MyFantasyLeague &#8599;</a>
        <button type="button" class="wcp__toggle" id="wcp-toggle" aria-expanded="true" aria-controls="wcp-body">Hide</button>
      </span>
    </div>
    <div id="wcp-body">
      <p class="wcp__note" id="wcp-note" hidden></p>
      <ul class="wcp__list" id="wcp-list"></ul>
    </div>
  </section>
)}

<script>
  import { buildPlayerCellHTML } from '../../utils/player-cell-html';

  const raw = document.getElementById('waiver-claims-config')?.textContent;
  const cfg = raw ? JSON.parse(raw) : null;

  if (cfg?.canManage) {
    const panel = document.getElementById('waiver-claims-panel')!;
    const list = document.getElementById('wcp-list')!;
    const note = document.getElementById('wcp-note')!;
    const mflLink = document.getElementById('wcp-mfl') as HTMLAnchorElement;
    const toggle = document.getElementById('wcp-toggle') as HTMLButtonElement;
    const body = document.getElementById('wcp-body')!;

    /**
     * Collapsed state, remembered per league. localStorage throws outright in
     * some privacy modes, so every read and write is guarded and a failure just
     * means the panel opens — never that the page breaks.
     */
    const STORE_KEY = `wcp.collapsed.${cfg.leagueId}`;
    const readCollapsed = () => {
      try { return localStorage.getItem(STORE_KEY) === '1'; } catch { return false; }
    };
    const writeCollapsed = (v: boolean) => {
      try { v ? localStorage.setItem(STORE_KEY, '1') : localStorage.removeItem(STORE_KEY); } catch { /* ignore */ }
    };
    let collapsed = readCollapsed();

    /**
     * Collapse HIDES THE LIST, never the panel. A control that made the whole
     * thing vanish would leave no way back to claims that are still live and
     * still going to process — the count in the header is the point.
     */
    const applyCollapsed = (count: number) => {
      body.hidden = collapsed;
      toggle.textContent = collapsed ? `Show${count ? ` (${count})` : ''}` : 'Hide';
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      panel.classList.toggle('wcp--collapsed', collapsed);
    };

    let lastCount = 0;
    toggle.addEventListener('click', () => {
      collapsed = !collapsed;
      writeCollapsed(collapsed);
      applyCollapsed(lastCount);
    });

    const esc = (s: unknown) =>
      String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    const showNote = (msg: string, kind: 'ok' | 'warn' | 'error' = 'ok') => {
      note.textContent = msg;
      note.className = `wcp__note wcp__note--${kind}`;
      note.hidden = !msg;
    };

    /** Render the list. Order is MFL's own, which IS the claim priority. */
    const render = (claims: any[]) => {
      if (!claims.length) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      lastCount = claims.length;
      applyCollapsed(lastCount);
      list.innerHTML = claims
        .map((c, i) => {
          const dropLabel = c.dropName
            ? `Dropping <strong>${esc(c.dropName)}</strong>`
            : 'Adding without dropping';
          // The claimed player wears the SAME lockup as the Available Players
          // rows underneath — headshot chip, NFL logo, position — built by the
          // shared builder rather than re-spelled here, so a change to the
          // pattern reaches the claim card too. Position and NFL team used to
          // be a plain "TE · WSH" text line, which read as a different kind of
          // thing than the table it sits above.
          //
          // ONE fallback name, used by the lockup and by the delete confirm's
          // data attribute alike — a claim whose player is missing from the map
          // showed "Player 15913" in the row and "this player" in the confirm.
          const addName = c.addName || `Player ${c.addPlayerId}`;
          const cell = buildPlayerCellHTML({
            name: addName,
            headshot: c.addHeadshot,
            position: c.addPosition,
            nflTeam: c.addNflTeam,
            mflId: c.addPlayerId,
            espnId: c.addEspnId || undefined,
            size: 'compact',
            className: 'wcp__cell',
          });
          // The bid belongs on the TERMS line, not inside the lockup. The
          // lockup's name element is `nowrap; overflow: hidden; text-overflow:
          // ellipsis` by design — a long name on a phone would ellipsize a
          // trailing badge clean out of view, and a bid the owner cannot see is
          // the one number here they most need. Absent entirely in a priority
          // league.
          const terms = [
            c.bid != null ? `<span class="wcp__bid">$${Number(c.bid).toLocaleString()}</span>` : '',
            dropLabel,
            `Round ${esc(c.round)}`,
          ].filter(Boolean).join(' &middot; ');
          // The number is the priority MFL will honour, not a row count — say so
          // rather than leaving an unexplained ordinal. The name is carried as a
          // data attribute because the confirm prompt below must not pick up the
          // bid badge that now lives inside the name element.
          return `<li class="wcp__item" data-round="${esc(c.round)}" data-add="${esc(c.addPlayerId)}" data-name="${esc(addName)}">
            <span class="wcp__rank" title="Priority within round ${esc(c.round)}">${i + 1}</span>
            <div class="wcp__who">
              ${cell}
              <span class="wcp__drop">${terms}</span>
            </div>
            <span class="wcp__actions">
              <button type="button" class="wcp__btn" data-act="edit">Change drop</button>
              <button type="button" class="wcp__btn wcp__btn--danger" data-act="delete">Delete</button>
            </span>
          </li>`;
        })
        .join('');
    };

    const load = async () => {
      try {
        const res = await fetch('/api/waiver-claims');
        const data = await res.json().catch(() => ({}));
        if (data?.confirmUrl) {
          mflLink.href = data.confirmUrl;
          mflLink.hidden = false;
        }
        if (!res.ok || !data.success) {
          // A failed read must not imply "you have no claims" — that is the
          // same conflation this whole feature was built to stop.
          if (res.status !== 401 && res.status !== 403) {
            panel.hidden = false;
            list.innerHTML = '';
            lastCount = 0;
            applyCollapsed(0);
            showNote(data.message || 'Could not read your pending waivers.', 'error');
          }
          return;
        }
        showNote('');
        render(data.claims ?? []);
      } catch {
        /* Offline or blocked — leave the panel hidden rather than alarm anyone. */
      }
    };

    const act = async (body: Record<string, unknown>, pending: string) => {
      showNote(pending, 'ok');
      list.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
      try {
        const res = await fetch('/api/waiver-claims', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          showNote(data.message || `That didn't work (HTTP ${res.status}).`, 'error');
          return load();
        }
        // `verified` is the one that means MFL actually shows the change.
        showNote(data.message || 'Done.', data.verified === false ? 'warn' : 'ok');
        if (Array.isArray(data.claims)) render(data.claims);
        else await load();
      } catch {
        showNote('Network error — nothing was changed.', 'error');
        await load();
      }
    };

    list.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
      if (!btn) return;
      const item = btn.closest('.wcp__item') as HTMLElement;
      const round = item.dataset.round;
      const addPlayerId = item.dataset.add;
      const name = item.dataset.name || 'this player';

      if (btn.dataset.act === 'delete') {
        if (!confirm(`Delete your claim on ${name}? This cannot be undone from here.`)) return;
        await act({ action: 'delete', round, addPlayerId }, 'Deleting…');
        return;
      }

      // Change drop: a plain prompt-free picker built from the roster we were
      // given, so no extra request is needed to offer the choice.
      const options = [{ id: '0000', name: 'Nobody — add without dropping' }, ...cfg.roster];
      const choice = window.prompt(
        `Drop instead of…?\n\n${options.map((o, i) => `${i}. ${o.name}`).join('\n')}\n\nEnter a number:`,
        '0'
      );
      if (choice === null) return;
      const picked = options[Number(choice)];
      if (!picked) return showNote('That was not one of the options.', 'error');
      await act({ action: 'editDrop', round, addPlayerId, dropPlayerId: picked.id }, 'Saving…');
    });

    const start = () => { void load(); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
    else start();

    /**
     * DOCUMENT-level listeners: exactly one of each, always bound to the CURRENT
     * module evaluation.
     *
     * Both halves of that matter. They stack if simply added, because this
     * module can be re-evaluated on a ClientRouter hop between the two leagues'
     * Free Agents pages — every extra registration is another duplicate fetch.
     * But a plain once-flag is WORSE: it pins the surviving listener to the
     * FIRST evaluation's closure, whose `panel`/`list`/`cfg` refer to DOM that
     * the hop detached, so the panel would silently stop updating on the page
     * you are actually looking at. That is the stale-module-eval trap from
     * docs/claude/insights/domains/frontend.md, in its nastiest form — no
     * error, just a dead UI.
     *
     * Remove-then-add gives one listener AND a live closure.
     *
     * - `waiver-claims:changed` — a claim was filed through the modal on this
     *   same page. The panel used to load once and never hear about it, so an
     *   owner filed a claim, watched it land on MFL, and saw nothing here.
     * - `astro:page-load` — re-read after an in-site navigation.
     */
    const w = window as unknown as {
      __wcpOnChanged?: EventListener;
      __wcpOnPageLoad?: EventListener;
    };
    if (w.__wcpOnChanged) document.removeEventListener('waiver-claims:changed', w.__wcpOnChanged);
    if (w.__wcpOnPageLoad) document.removeEventListener('astro:page-load', w.__wcpOnPageLoad);
    w.__wcpOnChanged = () => { void load(); };
    w.__wcpOnPageLoad = () => { void load(); };
    document.addEventListener('waiver-claims:changed', w.__wcpOnChanged);
    document.addEventListener('astro:page-load', w.__wcpOnPageLoad);
  }
</script>

