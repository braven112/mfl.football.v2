---
/**
 * ThrowbackWeekModal — "This week you're playing as …" popup, once per device
 * per throwback week.
 *
 * Mounted by the league layout for a signed-in owner while their league's
 * throwback week is on (`buildThrowbackWelcome`, src/utils/throwback-welcome.ts).
 * Shows the era crest and name they are wearing; before the week's first
 * kickoff it links to the era picker, after it says picks are locked. The
 * dialog, band and once-per-device script are WelcomeModal's.
 */
import WelcomeModal from './WelcomeModal.astro';
import type { ThrowbackWelcome } from '../../utils/throwback-welcome';

interface Props {
  welcome: ThrowbackWelcome;
  /** Registry slug of the league this page belongs to (ClientRouter gate). */
  leagueSlug: string;
  /** League-resolved path to the era picker. */
  pickerHref: string;
  /** Stories only: render already open (non-modal), since a closed dialog draws nothing. */
  previewOpen?: boolean;
}

const { welcome, leagueSlug, pickerHref, previewOpen = false } = Astro.props;
---

<WelcomeModal
  id="throwback-week-modal"
  leagueSlug={leagueSlug}
  storageKey={welcome.storageKey}
  ghost="Throwback"
  crest={welcome.crest}
  crestFilter={welcome.crestFilter}
  bandStart={welcome.bandStart}
  bandEnd={welcome.bandEnd}
  bandGlow={welcome.bandGlow}
  previewOpen={previewOpen}
>
  <p class="twm__eyebrow">Throwback Week &middot; Week {welcome.week}</p>
  <h2 class="twm__title" id="throwback-week-modal-title">
    <span class="twm__lead">This week you&rsquo;re playing as</span>
    <span class="twm__name">
      {welcome.years && <span class="twm__years">{welcome.years}</span>}
      {welcome.name}
    </span>
  </h2>
  {welcome.locked ? (
    <p class="twm__note">Picks are locked now that games have kicked off. Enjoy the throwback.</p>
  ) : (
    <p class="twm__note">Want a different look? Pick your era before the week&rsquo;s first kickoff.</p>
  )}
  <div class="twm__actions">
    {!welcome.locked && (
      <a class="cta cta--primary twm__btn" href={pickerHref}>Choose your throwback</a>
    )}
    <button type="button" class:list={['cta', welcome.locked ? 'cta--primary' : 'cta--ghost', 'twm__btn']} data-twm-close>
      {welcome.locked ? 'Let’s go' : 'Keep this look'}
    </button>
  </div>
</WelcomeModal>
