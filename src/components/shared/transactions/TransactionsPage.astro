---
/**
 * Transactions — shared render for every league that has the route.
 *
 * A roster-move ledger whose opening view answers the in-season question:
 * who got picked up, what did it cost, and who came off to make room. Trades
 * are in the data and one checkbox away; IR and practice-squad moves are
 * filtered out in the normalizer and never appear.
 *
 * The thin route wrappers own the feed globs (a static import specifier can't
 * be a runtime variable, and a cron-generated feed must not be a static import
 * at all — docs/claude/rules/storage-and-build.md). This component owns the
 * markup and the filtering.
 *
 * FILTERING IS SERVER-SIDE, and the controls are a real GET form. A shared
 * `?team=0007&week=3` link has to RENDER filtered rather than flash the whole
 * ledger and then narrow, the back button has to work, and the page has to
 * survive with JavaScript off. The client script below only adds
 * convenience — it is not what makes the filters work.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import PlayerCell from '../../theleague/PlayerCell.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug, leagueHasFeature } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { getLeagueTeamBrands } from '../../../utils/league-team-brands';
import { getGlobalPlayerMap, type PlayerIdentity } from '../../../utils/player-map';
import { getAuthUser, franchiseIdForLeague } from '../../../utils/auth';
import { readViewerClock } from '../../../utils/viewer-preferences-page';
import { chosenZone } from '../../../utils/viewer-preferences';
import { loadTransactionsSeason, seasonsFromGlob, type LazyFeedGlob } from '../../../utils/transactions-feeds';
import { resolveSeason } from '../../../utils/mfl-feed-glob';
import { getCurrentLeagueYear } from '../../../utils/league-year';
import { formatPickLabel } from '../../../utils/mfl-pick-tokens.mjs';
import {
  parseFilters,
  applyFilters,
  groupByDay,
  filterHref,
  isDefaultView,
  kindsPresentIn,
} from '../../../utils/transactions-view';
import type { TransactionRow } from '../../../utils/mfl-transactions';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** Lazy `import.meta.glob` over this league's per-season transactions feeds. */
  transactionFeeds: LazyFeedGlob;
  /** The same over the per-season league feeds, for the minimum salary. */
  leagueFeeds: LazyFeedGlob;
}

const { leagueSlug, transactionFeeds, leagueFeeds } = Astro.props;
const league = getLeagueBySlug(leagueSlug);
if (!league) throw new Error(`TransactionsPage: unknown league ${leagueSlug}`);

const basePath = resolveLeaguePath(`/${leagueSlug}/transactions`, Astro.locals.hideLeaguePrefix ?? false);
const params = Astro.url.searchParams;

// ROSTER-MANAGEMENT SHAPED, so the league-year clock, not the season one:
// signings happen all offseason and the ledger for "this year" means the
// current MFL league, which turns over on Feb 14 (CLAUDE.md "Year rollover").
const availableYears = seasonsFromGlob(transactionFeeds);
const year = resolveSeason(params.get('year'), availableYears, getCurrentLeagueYear()) ?? getCurrentLeagueYear();

const hasSalaryCap = leagueHasFeature(leagueSlug, 'salaryCap');
const rows = await loadTransactionsSeason({ transactionFeeds, leagueFeeds, year, hasSalaryCap });

// READ-ONLY. Resolving a preference WRITES a cookie and belongs to the route —
// from a component it throws ResponseSentError after the headers commit
// (docs/claude/rules/viewer-preferences.md). readViewerClock is the safe read.
const authUser = getAuthUser(Astro.request);
const myFranchiseId = franchiseIdForLeague(authUser, league.id);
const viewerClock = await readViewerClock(Astro.cookies, authUser, leagueSlug);
// `prefs.zoneId` is an ID ("PT"), NOT an IANA zone — handing it to
// Intl.DateTimeFormat throws "Invalid time zone specified: PT" and takes the
// page down. `chosenZone` is the accessor that pairs the id with the viewer's
// country and returns the real zone.
const zone = chosenZone(viewerClock.prefs, viewerClock.leagueClock).zone;

const filters = parseFilters({ params, year, myFranchiseId });

// The AFL's own identity union first, TheLeague's as the fallback: MFL player
// ids are global so the two compose, and the AFL's archive reaches back
// further than TheLeague's union covers.
const primaryPlayers = getGlobalPlayerMap(leagueSlug);
const fallbackPlayers = leagueSlug === 'theleague' ? primaryPlayers : getGlobalPlayerMap('theleague');
const playerOf = (id: string): PlayerIdentity | undefined =>
  primaryPlayers.get(id) ?? fallbackPlayers.get(id);
const nameOf = (id: string): string | undefined => playerOf(id)?.name;

const visible = applyFilters({ rows, filters, nameOf });
const groups = groupByDay(visible, zone);

const brands = getLeagueTeamBrands(leagueSlug);
const teamOptions = Object.values(brands).sort((a, b) => a.name.localeCompare(b.name));
const nameForFranchise = (id: string) => brands[id]?.nameShort || brands[id]?.name || `Team ${id}`;

const timeFmt = new Intl.DateTimeFormat('en-US', { timeZone: zone, hour: 'numeric', minute: '2-digit' });
const moneyFmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

/** Label for the badge on each row. */
const KIND_LABEL: Record<string, string> = {
  'free-agent': 'Free agent',
  waiver: 'Waiver',
  'blind-bid': 'Blind bid',
  auction: 'Auction',
  trade: 'Trade',
};

// Only offer a filter the season can actually answer — see kindsPresentIn.
const offeredKinds = kindsPresentIn(rows, filters.kindsExplicit ? filters.kinds : []);
const showingDefault = isDefaultView(filters);
const weekOptions = Array.from({ length: 18 }, (_, i) => i + 1);

/** Pre-resolve a row's players so the template stays declarative. */
function cellsFor(ids: string[]) {
  return ids.map((id) => ({ id, player: playerOf(id) }));
}
type PlayerCells = ReturnType<typeof cellsFor>;

interface RenderRow {
  row: TransactionRow;
  time: string;
  teamName: string;
  crest: string | undefined;
  accent: string;
  added: PlayerCells;
  dropped: PlayerCells;
  amount: string | null;
  tradeSides: { name: string; players: PlayerCells; picks: string[] }[] | null;
}

const renderRows = new Map<string, RenderRow>();
for (const row of visible) {
  renderRows.set(row.id, {
    row,
    time: timeFmt.format(new Date(row.at)),
    teamName: nameForFranchise(row.franchiseId),
    crest: brands[row.franchiseId]?.icon,
    accent: brands[row.franchiseId]?.colorPrimary || 'var(--tx-accent)',
    added: cellsFor(row.added),
    dropped: cellsFor(row.dropped),
    amount: row.amount === null ? null : moneyFmt.format(row.amount),
    tradeSides: row.trade
      ? row.trade.sides.map((side) => ({
          name: nameForFranchise(side.franchiseId),
          players: cellsFor(side.players),
          picks: side.picks.map((p) => formatPickLabel(p, nameForFranchise)),
        }))
      : null,
  });
}

const totalLabel = visible.length === 1 ? '1 move' : `${visible.length.toLocaleString()} moves`;
---

<TheLeagueLayout title={`Transactions | ${league.name}`}>
  <main class="tx">
    <header class="tx__header">
      <div>
        <h1><a href={basePath}>Transactions</a></h1>
        <p class="tx__lede">
          Every signing, waiver claim and free agent pickup in {league.name}.
          Practice squad and injured reserve moves are left out.
        </p>
      </div>
      {availableYears.length > 1 && (
        <nav class="tx__years" aria-label="Season">
          {[...availableYears].reverse().map((y) => (
            <a
              class="tx__year"
              href={filterHref(basePath, params, { year: String(y) })}
              aria-current={y === year ? 'page' : undefined}
            >{y}</a>
          ))}
        </nav>
      )}
    </header>

    <form class="tx__filters" method="get" action={basePath} data-tx-filters>
      {/* The year rides along as a hidden field so submitting the form does
          not silently bounce the reader back to the current season. */}
      <input type="hidden" name="year" value={String(year)} />

      <label class="tx__field tx__field--grow">
        <span>Player</span>
        <input type="search" name="q" value={filters.query} placeholder="Search a name…" autocomplete="off" />
      </label>

      <label class="tx__field">
        <span>Team</span>
        <select name="team">
          <option value="">All teams</option>
          {teamOptions.map((t) => (
            <option value={t.franchiseId} selected={filters.team === t.franchiseId && !filters.mine}>{t.name}</option>
          ))}
        </select>
      </label>

      <label class="tx__field">
        <span>Week</span>
        <select name="week">
          <option value="">Any week</option>
          {weekOptions.map((w) => (
            <option value={String(w)} selected={filters.week === w}>Week {w}</option>
          ))}
        </select>
      </label>

      <fieldset class="tx__kinds" hidden={offeredKinds.length < 2}>
        <legend>Show</legend>
        {offeredKinds.map((kind) => (
          <label class="tx__check">
            <input type="checkbox" name="types" value={kind} checked={filters.kinds.has(kind)} />
            <span>{KIND_LABEL[kind]}</span>
          </label>
        ))}
      </fieldset>

      {myFranchiseId && (
        <label class="tx__check tx__check--mine">
          <input type="checkbox" name="mine" value="1" checked={filters.mine} />
          <span>Just my team</span>
        </label>
      )}

      <div class="tx__actions">
        <button type="submit" class="tx__submit">Apply</button>
        {!showingDefault && <a class="tx__reset" href={filterHref(basePath, new URLSearchParams(), { year: String(year) })}>Reset</a>}
      </div>
    </form>

    <p class="tx__count" aria-live="polite">
      {totalLabel}
      {filters.query && <> matching <strong>{filters.query}</strong></>}
      {filters.team && <> for <strong>{nameForFranchise(filters.team)}</strong></>}
      {filters.week !== null && <> in <strong>week {filters.week}</strong></>}
      <span class="tx__count-year"> · {year} season</span>
    </p>

    {groups.length === 0 ? (
      <p class="tx__empty">
        {rows.length === 0
          ? `No transactions recorded for ${year} yet.`
          : 'No moves match these filters.'}
      </p>
    ) : (
      <div class="tx__scroll">
        {groups.map((group) => (
          <section class="tx__day" aria-labelledby={`day-${group.key}`}>
            <h2 class="tx__day-head" id={`day-${group.key}`}>{group.label}</h2>
            <ul class="tx__rows">
              {group.rows.map((row) => {
                const r = renderRows.get(row.id)!;
                return (
                  <li class="tx__row" data-kind={row.kind} style={`--tx-team: ${r.accent};`}>
                    <span class="tx__time">{r.time}</span>

                    <span class="tx__team">
                      {r.crest && <img class="tx__crest" src={r.crest} alt="" width="22" height="22" loading="lazy" decoding="async" />}
                      <span class="tx__team-name">{r.teamName}</span>
                    </span>

                    <span class="tx__badge" data-kind={row.kind}>{KIND_LABEL[row.kind]}</span>

                    <div class="tx__move">
                      {r.tradeSides ? (
                        <div class="tx__trade">
                          {r.tradeSides.map((side) => (
                            <div class="tx__trade-side">
                              <span class="tx__trade-team">{side.name} sent</span>
                              <div class="tx__players">
                                {side.players.map((p) => (
                                  <PlayerCell
                                    name={p.player?.name ?? `Player ${p.id}`}
                                    headshot={p.player?.headshot}
                                    position={p.player?.position}
                                    nflTeam={p.player?.nflTeam}
                                    mflId={p.id}
                                    espnId={p.player?.espnId ?? undefined}
                                    size="compact"
                                  />
                                ))}
                                {side.picks.map((pick) => (
                                  <span class="tx__pick">{pick}</span>
                                ))}
                                {side.players.length === 0 && side.picks.length === 0 && (
                                  <span class="tx__nothing">nothing</span>
                                )}
                              </div>
                            </div>
                          ))}
                        </div>
                      ) : (
                        <>
                          {r.added.length > 0 && (
                            <div class="tx__side tx__side--in">
                              <span class="tx__sign" aria-hidden="true">+</span>
                              <span class="tx__sr">Added</span>
                              <div class="tx__players">
                                {r.added.map((p) => (
                                  <PlayerCell
                                    name={p.player?.name ?? `Player ${p.id}`}
                                    headshot={p.player?.headshot}
                                    position={p.player?.position}
                                    nflTeam={p.player?.nflTeam}
                                    mflId={p.id}
                                    espnId={p.player?.espnId ?? undefined}
                                    size="compact"
                                  />
                                ))}
                              </div>
                            </div>
                          )}
                          {r.dropped.length > 0 && (
                            <div class="tx__side tx__side--out">
                              <span class="tx__sign" aria-hidden="true">−</span>
                              <span class="tx__sr">Dropped</span>
                              <div class="tx__players">
                                {r.dropped.map((p) => (
                                  <PlayerCell
                                    name={p.player?.name ?? `Player ${p.id}`}
                                    headshot={p.player?.headshot}
                                    position={p.player?.position}
                                    nflTeam={p.player?.nflTeam}
                                    mflId={p.id}
                                    espnId={p.player?.espnId ?? undefined}
                                    size="compact"
                                  />
                                ))}
                              </div>
                            </div>
                          )}
                        </>
                      )}
                    </div>

                    {hasSalaryCap && (
                      <span class="tx__amount">{r.amount ?? <span class="tx__dash" title="Not recorded in the feed">—</span>}</span>
                    )}

                    {row.byCommish && <span class="tx__commish" title="Executed by the commissioner">COMM</span>}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    )}
  </main>
</TheLeagueLayout>

<script>
  /**
   * Convenience only — the form works without any of this.
   *
   * MUST initialise on `astro:page-load`, not `DOMContentLoaded`: with the
   * ClientRouter, a navigation into this page swaps the DOM without firing
   * DOMContentLoaded, so a DOMContentLoaded-only handler leaves the page
   * inert after the first visit (tests/clientrouter-init-ratchet.test.ts).
   */
  function initTransactionFilters() {
    const form = document.querySelector<HTMLFormElement>('[data-tx-filters]');
    if (!form) return;

    // Re-selecting the form on every page-load — never capturing it at module
    // scope — is the other half of surviving a ClientRouter navigation: the
    // node captured on the first visit is detached by the second.
    // Empty controls are disabled for the instant of the submit so they stay
    // OUT of the querystring — otherwise every filter change accretes `q=` and
    // `team=` into the URL, and the link an owner copies to share a filtered
    // view is mostly noise. Re-enabled immediately so the form still works if
    // the navigation is cancelled.
    const submit = () => {
      const emptied = Array.from(
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')
      ).filter((el) => el.name && el.type !== 'checkbox' && el.value === '');
      for (const el of emptied) el.disabled = true;
      form.requestSubmit();
      for (const el of emptied) el.disabled = false;
    };

    for (const el of Array.from(form.querySelectorAll<HTMLElement>('select, input[type="checkbox"]'))) {
      el.addEventListener('change', submit);
    }

    const search = form.querySelector<HTMLInputElement>('input[type="search"]');
    if (search) {
      let timer: ReturnType<typeof setTimeout> | undefined;
      search.addEventListener('input', () => {
        if (timer) clearTimeout(timer);
        timer = setTimeout(submit, 450);
      });
    }
  }

  document.addEventListener('astro:page-load', initTransactionFilters);
</script>

<style>
  /* A local vocabulary aliasing the global tokens, matching the pattern in
     DivisionStrengthPage. Every fallback below points at a token that exists
     in tokens.css — tests/design-token-guard.test.ts fails the build on one
     that does not, because an undefined var() renders its fallback in BOTH
     themes and dark mode ships broken. */
  .tx {
    --tx-accent: var(--league-accent, #1c497c);
    --tx-surface: var(--card-bg, #fff);
    --tx-surface-muted: var(--content-bg-muted, #f7f7f8);
    --tx-border: var(--content-border, #e5e5e5);
    --tx-ink: var(--page-text, #1a1a1a);
    --tx-ink-muted: var(--content-text-muted, #666);

    max-width: var(--container-max-width, 1100px);
    margin: 0 auto;
    padding: var(--spacing-lg, 1.5rem) var(--spacing-md, 1rem);
    color: var(--tx-ink);
  }

  .tx__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md, 1rem);
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .tx__header h1 { margin: 0 0 0.25rem; }
  .tx__header h1 a { color: inherit; text-decoration: none; }
  .tx__lede { margin: 0; color: var(--tx-ink-muted); max-width: 52ch; }

  .tx__years { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tx__year {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--radius-full, 999px);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--tx-ink-muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .tx__year:hover { border-color: var(--tx-accent); color: var(--tx-ink); }
  .tx__year[aria-current='page'] {
    background: var(--tx-accent);
    border-color: var(--tx-accent);
    color: #fff;
  }

  .tx__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--spacing-sm, 0.75rem);
    padding: var(--spacing-md, 1rem);
    background: var(--tx-surface-muted);
    border: 1px solid var(--tx-border);
    border-radius: var(--radius-md, 8px);
  }
  .tx__field { display: flex; flex-direction: column; gap: 0.25rem; }
  .tx__field--grow { flex: 1 1 14rem; }
  .tx__field > span,
  .tx__kinds legend {
    font-size: var(--font-size-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tx-ink-muted);
  }
  .tx__field input,
  .tx__field select {
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--radius-sm, 4px);
    background: var(--tx-surface);
    color: var(--tx-ink);
    font: inherit;
  }
  .tx__kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .tx__kinds legend { padding: 0; margin-bottom: 0.25rem; }
  .tx__check {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-sm, 0.875rem);
    white-space: nowrap;
  }
  .tx__check--mine { align-self: center; }
  .tx__actions { display: flex; align-items: center; gap: 0.6rem; margin-left: auto; }
  .tx__submit {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--btn-primary-border, var(--tx-accent));
    border-radius: var(--radius-sm, 4px);
    background: var(--btn-primary-bg, var(--tx-accent));
    color: var(--btn-primary-text, #fff);
    font: inherit;
    cursor: pointer;
  }
  .tx__reset { color: var(--tx-ink-muted); font-size: var(--font-size-sm, 0.875rem); }

  .tx__count {
    margin: var(--spacing-md, 1rem) 0 var(--spacing-sm, 0.75rem);
    color: var(--tx-ink-muted);
    font-size: var(--font-size-sm, 0.875rem);
  }
  .tx__count-year { font-variant-numeric: tabular-nums; }
  .tx__empty {
    padding: var(--spacing-xl, 2rem) var(--spacing-md, 1rem);
    text-align: center;
    color: var(--tx-ink-muted);
    background: var(--tx-surface-muted);
    border-radius: var(--radius-md, 8px);
  }

  /* Wide content scrolls inside its own container so the page body never
     scrolls horizontally on a phone. */
  .tx__scroll { overflow-x: auto; }

  .tx__day + .tx__day { margin-top: var(--spacing-lg, 1.5rem); }
  .tx__day-head {
    position: sticky;
    top: 0;
    z-index: 1;
    margin: 0 0 0.4rem;
    padding: 0.35rem 0;
    font-size: var(--font-size-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tx-ink-muted);
    background: var(--page-bg, #fff);
    border-bottom: 1px solid var(--tx-border);
  }

  .tx__rows { list-style: none; margin: 0; padding: 0; }
  .tx__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(8rem, 12rem) 6.5rem minmax(16rem, 1fr) auto auto;
    align-items: center;
    gap: var(--spacing-sm, 0.75rem);
    padding: 0.5rem 0.4rem;
    border-bottom: 1px solid var(--tx-border);
    border-left: 3px solid var(--tx-team, var(--tx-accent));
    min-width: 44rem;
  }
  .tx__row:hover { background: var(--table-row-bg-hover, var(--tx-surface-muted)); }

  .tx__time {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--tx-ink-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tx__team { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .tx__crest { width: 22px; height: 22px; object-fit: contain; flex: none; }
  .tx__team-name {
    font-weight: 600;
    font-size: var(--font-size-sm, 0.875rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tx__badge {
    justify-self: start;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--radius-full, 999px);
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--tx-ink-muted);
    white-space: nowrap;
  }
  .tx__badge[data-kind='blind-bid'],
  .tx__badge[data-kind='auction'] { color: var(--tx-ink); border-color: var(--tx-accent); }

  .tx__move { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .tx__side { display: flex; align-items: flex-start; gap: 0.4rem; min-width: 0; }
  .tx__sign {
    font-weight: 700;
    line-height: 1.4;
    color: var(--alert-success-text, #157347);
  }
  .tx__side--out .tx__sign { color: var(--alert-warning-text, #8a6100); }
  .tx__players { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; min-width: 0; }

  .tx__trade { display: flex; flex-direction: column; gap: 0.35rem; }
  .tx__trade-side { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; }
  .tx__trade-team {
    font-size: var(--font-size-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tx-ink-muted);
  }
  .tx__pick,
  .tx__nothing {
    padding: 0.1rem 0.4rem;
    border: 1px dashed var(--tx-border);
    border-radius: var(--radius-sm, 4px);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--tx-ink-muted);
  }

  .tx__amount {
    justify-self: end;
    font-variant-numeric: tabular-nums;
    font-size: var(--font-size-sm, 0.875rem);
    white-space: nowrap;
  }
  .tx__dash { color: var(--tx-ink-muted); }
  .tx__commish {
