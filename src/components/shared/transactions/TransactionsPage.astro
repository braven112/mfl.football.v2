---
/**
 * Transactions — shared render for every league that has the route.
 *
 * Schefter's wire for the season: each move leads with the story he wrote
 * about it (src/utils/transaction-stories.ts), and MFL's official record sits
 * behind "See details". A move he never wrote up shows the record itself.
 * The current season is the page; past seasons are a small menu in the
 * header, because almost nobody needs them. IR and practice-squad moves are
 * filtered out in the normalizer and never appear.
 *
 * The thin route wrappers own the feed globs (a static import specifier can't
 * be a runtime variable, and a cron-generated feed must not be a static import
 * at all — docs/claude/rules/storage-and-build.md). This component owns the
 * markup and the filtering.
 *
 * FILTERING IS SERVER-SIDE, and the controls are a real GET form. A shared
 * `?team=0007&week=3` link has to RENDER filtered rather than flash the whole
 * ledger and then narrow, the back button has to work, and the page has to
 * survive with JavaScript off. The client script below only adds
 * convenience — it is not what makes the filters work.
 */
import TheLeagueLayout from '../../../layouts/TheLeagueLayout.astro';
import TransactionRecord from './TransactionRecord.astro';
import { resolveLeaguePath } from '../../../utils/nav-utils';
import { getLeagueBySlug, leagueHasFeature } from '../../../config/leagues';
import type { CanonicalLeagueSlug } from '../../../config/leagues';
import { getLeagueTeamBrands } from '../../../utils/league-team-brands';
import { teamAccentVar } from '../../../utils/team-accent-css';
import { getGlobalPlayerMap, type PlayerIdentity } from '../../../utils/player-map';
import { getAuthUser, franchiseIdForLeague } from '../../../utils/auth';
import { getAuthor, getAuthorAvatar } from '../../../types/schefter';
import { postByline } from '../../../utils/persona-server';
import { indexMoveStories, loadMoveStoryPosts, withLiveFeed, type MoveStory } from '../../../utils/transaction-stories';
import { getSchefterFeedIfAny } from '../../../utils/schefter-league-data';
import { readViewerClock } from '../../../utils/viewer-preferences-page';
import { chosenZone } from '../../../utils/viewer-preferences';
import { loadTransactionsSeason, loadLedgerLeagueContext, seasonsFromGlob, type LazyFeedGlob } from '../../../utils/transactions-feeds';
import { resolveSeason } from '../../../utils/mfl-feed-glob';
import { getLeagueYearForSlug } from '../../../utils/league-year';
import { formatPickLabel } from '../../../utils/mfl-pick-tokens.mjs';
import {
  parseFilters,
  applyFilters,
  groupByDay,
  filterHref,
  isDefaultView,
  kindsPresentIn,
  ALL_DIVISIONS,
  PICKUP_KINDS,
  activeKindChip,
} from '../../../utils/transactions-view';
import type { TransactionRow } from '../../../utils/mfl-transactions';

interface Props {
  leagueSlug: CanonicalLeagueSlug;
  /** Lazy `import.meta.glob` over this league's per-season transactions feeds. */
  transactionFeeds: LazyFeedGlob;
  /** The same over the per-season league feeds, for the minimum salary. */
  leagueFeeds: LazyFeedGlob;
  /**
   * Lazy glob over this league's Schefter feed and its archive years, for the
   * story on each move. Absent for a league Schefter does not cover.
   */
  schefterPosts?: LazyFeedGlob;
}

const { leagueSlug, transactionFeeds, leagueFeeds, schefterPosts } = Astro.props;
const league = getLeagueBySlug(leagueSlug);
if (!league) throw new Error(`TransactionsPage: unknown league ${leagueSlug}`);
// The AFL and package leagues roll June 1, not Feb 14: their own clock.
const leagueYear = getLeagueYearForSlug(leagueSlug);

const basePath = resolveLeaguePath(`/${leagueSlug}/transactions`, Astro.locals.hideLeaguePrefix ?? false);
const params = Astro.url.searchParams;

// ROSTER-MANAGEMENT SHAPED, so the league-year clock, not the season one:
// signings happen all offseason and the ledger for "this year" means the
// current MFL league, which turns over on Feb 14 (CLAUDE.md "Year rollover").
const availableYears = seasonsFromGlob(transactionFeeds);
const year = resolveSeason(params.get('year'), availableYears, leagueYear) ?? leagueYear;

const hasSalaryCap = leagueHasFeature(leagueSlug, 'salaryCap');
const [rows, ledger, storyPosts] = await Promise.all([
  loadTransactionsSeason({
    transactionFeeds,
    leagueFeeds,
    year,
    hasSalaryCap,
    leagueId: league.id,
    // Only the current league year can gain rows since the last sync.
    isCurrentSeason: year === leagueYear,
  }),
  // Per SEASON, from that season's league.json — a league can change its bid
  // rules or its divisions between years.
  loadLedgerLeagueContext(leagueFeeds, year),
  schefterPosts
    ? loadMoveStoryPosts(withLiveFeed(schefterPosts, () => getSchefterFeedIfAny(league)), year)
    : Promise.resolve([]),
]);
const stories = indexMoveStories(storyPosts);
// A FAAB league has no salary cap, but its bids ARE what a move cost, so the
// amount column is shown for it too. Gated on the season's own budget rather
// than a new registry flag: it is a fact MFL already publishes.
const isFaab = ledger.faabBudget !== null;
const showAmounts = hasSalaryCap || isFaab;
const divisions = ledger.divisions;
const divisionOf = (franchiseId: string): string | undefined => ledger.divisionOfFranchise[franchiseId];
const divisionById = new Map((divisions ?? []).map((d) => [d.id, d]));

// READ-ONLY. Resolving a preference WRITES a cookie and belongs to the route —
// from a component it throws ResponseSentError after the headers commit
// (docs/claude/rules/viewer-preferences.md). readViewerClock is the safe read.
const authUser = getAuthUser(Astro.request);
const myFranchiseId = franchiseIdForLeague(authUser, league.id);
const viewerClock = await readViewerClock(Astro.cookies, authUser, leagueSlug);
// `prefs.zoneId` is an ID ("PT"), NOT an IANA zone — handing it to
// Intl.DateTimeFormat throws "Invalid time zone specified: PT" and takes the
// page down. `chosenZone` is the accessor that pairs the id with the viewer's
// country and returns the real zone.
const zone = chosenZone(viewerClock.prefs, viewerClock.leagueClock).zone;

const filters = parseFilters({
  params,
  year,
  myFranchiseId,
  divisionIds: (divisions ?? []).map((d) => d.id),
  divisionOf,
});

// The AFL's own identity union first, TheLeague's as the fallback: MFL player
// ids are global so the two compose, and the AFL's archive reaches back
// further than TheLeague's union covers.
const primaryPlayers = getGlobalPlayerMap(leagueSlug);
const fallbackPlayers = leagueSlug === 'theleague' ? primaryPlayers : getGlobalPlayerMap('theleague');
const playerOf = (id: string): PlayerIdentity | undefined =>
  primaryPlayers.get(id) ?? fallbackPlayers.get(id);
const nameOf = (id: string): string | undefined => playerOf(id)?.name;

const visible = applyFilters({ rows, filters, nameOf, divisionOf });
const groups = groupByDay(visible, zone);

const brands = getLeagueTeamBrands(leagueSlug);
const teamOptions = Object.values(brands).sort((a, b) => a.name.localeCompare(b.name));
// 99 teams in one flat <select> is a scroll, not a choice: in a division-pool
// league the options are grouped under their division, in MFL's order.
const teamGroups = divisions
  ? divisions
      .map((d) => ({ label: d.name, teams: teamOptions.filter((t) => divisionOf(t.franchiseId) === d.id) }))
      .filter((g) => g.teams.length > 0)
  : null;
const nameForFranchise = (id: string) => brands[id]?.nameShort || brands[id]?.name || `Team ${id}`;

const timeFmt = new Intl.DateTimeFormat('en-US', { timeZone: zone, hour: 'numeric', minute: '2-digit' });
// Cents only where MFL takes cents bids — and then on EVERY amount, so a column
// of $5.00 / $5.01 lines up. Whole-dollar leagues keep maximumFractionDigits 0.
const moneyFmt = ledger.amountDecimals === 2
  ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 })
  : new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

/**
 * The amount cell's text, or null for a dash. In a FAAB league a winning
 * blind bid with no amount is a $0 bid — MFL writes `|0|` and the parser reads
 * zero as "no price" — so it prints as $0.00 rather than "not recorded".
 */
function amountLabel(row: TransactionRow): string | null {
  if (row.amount !== null) return moneyFmt.format(row.amount);
  if (isFaab && row.kind === 'blind-bid') return moneyFmt.format(0);
  return null;
}
const dashTitle = isFaab ? 'No bid — first come, first served' : 'Not recorded in the feed';

/** Label for the badge on each row. */
const KIND_LABEL: Record<string, string> = {
  'free-agent': 'Free agent',
  waiver: 'Waiver',
  'blind-bid': 'Blind bid',
  auction: 'Auction',
  trade: 'Trade',
};

// Only offer a filter the season can actually answer — see kindsPresentIn.
const offeredKinds = kindsPresentIn(rows, filters.kindsExplicit ? filters.kinds : []);
const showingDefault = isDefaultView(filters);
// 22, not 18: a league year outlives its regular season, so the January and
// February rows it carries bucket into the playoff weeks. `parseFilters`
// already accepts 1-22, so stopping the dropdown at 18 made those weeks
// reachable only by hand-editing the URL.
const weekOptions = Array.from({ length: 22 }, (_, i) => i + 1);

/** Pre-resolve a row's players so the template stays declarative. */
function cellsFor(ids: string[]) {
  return ids.map((id) => ({ id, player: playerOf(id) }));
}
type PlayerCells = ReturnType<typeof cellsFor>;

interface RenderRow {
  row: TransactionRow;
  time: string;
  teamName: string;
  /** The franchise's division abbrev, in a division-pool league only. */
  division: string | undefined;
  crest: string | undefined;
  accent: string;
  added: PlayerCells;
  dropped: PlayerCells;
  amount: string | null;
  tradeSides: { name: string; players: PlayerCells; picks: string[] }[] | null;
  story: MoveStory | null;
}

const renderRows = new Map<string, RenderRow>();
for (const row of visible) {
  renderRows.set(row.id, {
    row,
    time: timeFmt.format(new Date(row.at)),
    teamName: nameForFranchise(row.franchiseId),
    division: divisionById.get(divisionOf(row.franchiseId) ?? '')?.abbrev,
    crest: brands[row.franchiseId]?.icon,
    // `teamAccentVar`, NOT the raw brand colour. The token layer
    // (TeamAccentStyles, already in this layout) does three things a raw
    // `colorPrimary` cannot: it carries an `html.dark` override — 15 of
    // TheLeague's 16 franchises have a distinct dark accent, and the
    // Mavericks' #181818 is invisible on a dark page — it enforces a 3:1
    // contrast floor against each theme's card surface, and it is scoped by
    // `data-league`, which matters because both leagues have a franchise 0001.
    accent: teamAccentVar(row.franchiseId, 'var(--tx-accent)'),
    added: cellsFor(row.added),
    dropped: cellsFor(row.dropped),
    amount: amountLabel(row),
    tradeSides: row.trade
      ? row.trade.sides.map((side) => ({
          name: nameForFranchise(side.franchiseId),
          players: cellsFor(side.players),
          picks: side.picks.map((p) => formatPickLabel(p, nameForFranchise)),
        }))
      : null,
    story: stories.get(row),
  });
}

// Schefter's byline follows the league's persona — the same name and face the
// news page shows. Only resolved when a story will actually render.
const byline = [...renderRows.values()].some((r) => r.story)
  ? await postByline({ league: league.navSlug }, getAuthor('claude'), getAuthorAvatar(getAuthor('claude')))
  : null;

// The season menu: the current league year first, then the archive, newest
// first. Deliberately small — past seasons are the rare visit.
const currentYear = leagueYear;
const pastYears = [...availableYears].reverse().filter((y) => y !== year);

// Kind chips are links, not a form — each is a real, shareable URL. Choosing
// one keeps every other filter but drops `types`, then sets its own.
const kindChip = activeKindChip(filters, offeredKinds);
const chipHref = (types: string | null, extra: Record<string, string | null> = {}) =>
  filterHref(basePath, params, { types, ...extra });
const showTradeChip = offeredKinds.includes('trade');
const showPickupChip = offeredKinds.some((k) => k !== 'trade');
// The secondary filters live in a disclosure that opens itself whenever one of
// them is narrowing the view, so an active filter is never hidden.
const advancedActive =
  !!filters.query || (!!filters.team && !filters.mine) || filters.week !== null ||
  (!!filters.division && !filters.divisionDefaulted);

const totalLabel = visible.length === 1 ? '1 move' : `${visible.length.toLocaleString()} moves`;
---

<TheLeagueLayout title={`Transactions | ${league.name}`}>
  <main class="tx" data-league={leagueSlug}>
    <header class="tx__header">
      <h1><a href={basePath}>Transactions</a></h1>
      {availableYears.length > 1 && (
        <details class="tx__season">
          <summary aria-label={`Season: ${year}. Choose another season`}>{year}<span aria-hidden="true"> ▾</span></summary>
          <ul class="tx__season-menu">
            {year !== currentYear && availableYears.includes(currentYear) && (
              <li><a href={basePath}>{currentYear} <span class="tx__season-note">this season</span></a></li>
            )}
            {pastYears.filter((y) => y !== currentYear).map((y) => (
              <li><a href={filterHref(basePath, new URLSearchParams(), { year: String(y) })}>{y}</a></li>
            ))}
          </ul>
        </details>
      )}
    </header>

    {year !== currentYear && (
      <p class="tx__past">
        Viewing the {year} season. <a href={basePath}>Back to {currentYear}</a>
      </p>
    )}

    <nav class="ui-pills tx__chips" aria-label="Filter moves">
      <a class="ui-pill tx__chip" href={chipHref(null, { mine: null })} aria-current={kindChip === 'all' && !filters.mine ? 'page' : undefined}>All</a>
      {myFranchiseId && (
        <a class="ui-pill tx__chip" href={chipHref(null, { mine: '1', team: null })} aria-current={filters.mine && kindChip === 'all' ? 'page' : undefined}>My team</a>
      )}
      {showPickupChip && showTradeChip && (
        <a class="ui-pill tx__chip" href={chipHref(PICKUP_KINDS.filter((k) => offeredKinds.includes(k)).join(','))} aria-current={kindChip === 'pickups' ? 'page' : undefined}>Pickups</a>
      )}
      {showTradeChip && (
        <a class="ui-pill tx__chip" href={chipHref('trade')} aria-current={kindChip === 'trades' ? 'page' : undefined}>Trades</a>
      )}
    </nav>

    <details class="tx__more" open={advancedActive}>
      <summary>Search &amp; filter</summary>
      <form class="tx__filters" method="get" action={basePath} data-tx-filters>
        {/* The year, kinds and "mine" ride along as hidden fields so this form
            never silently resets the season or a chip. */}
        {year !== currentYear && <input type="hidden" name="year" value={String(year)} />}
        {filters.kindsExplicit && <input type="hidden" name="types" value={[...filters.kinds].join(',')} />}
        {filters.mine && <input type="hidden" name="mine" value="1" />}

        <label class="tx__field tx__field--grow">
          <span>Player</span>
          <input type="search" name="q" value={filters.query} placeholder="Search a name…" autocomplete="off" />
        </label>

        {divisions && (
          <label class="tx__field">
            <span>Division</span>
            <select name="division">
              <option value={ALL_DIVISIONS} selected={filters.division === null}>All divisions</option>
              {divisions.map((d) => (
                <option value={d.id} selected={filters.division === d.id}>{d.name}</option>
              ))}
            </select>
          </label>
        )}

        {!filters.mine && (
          <label class="tx__field">
            <span>Team</span>
            <select name="team">
              <option value="">All teams</option>
              {teamGroups
                ? teamGroups.map((g) => (
                    <optgroup label={g.label}>
                      {g.teams.map((t) => (
                        <option value={t.franchiseId} selected={filters.team === t.franchiseId}>{t.name}</option>
                      ))}
                    </optgroup>
                  ))
                : teamOptions.map((t) => (
                    <option value={t.franchiseId} selected={filters.team === t.franchiseId}>{t.name}</option>
                  ))}
            </select>
          </label>
        )}

        <label class="tx__field">
          <span>Week</span>
          <select name="week">
            <option value="">Any week</option>
            {weekOptions.map((w) => (
              <option value={String(w)} selected={filters.week === w}>Week {w}</option>
            ))}
          </select>
        </label>

        <div class="tx__actions">
          <button type="submit" class="cta cta--primary">Apply</button>
          {!showingDefault && <a class="cta-link" href={filterHref(basePath, new URLSearchParams(), { year: year === currentYear ? null : String(year) })}>Reset</a>}
        </div>
      </form>
    </details>

    <p class="tx__count" aria-live="polite">
      {totalLabel}
      {filters.query && <> matching <strong>{filters.query}</strong></>}
      {filters.team && !filters.mine && <> for <strong>{nameForFranchise(filters.team)}</strong></>}
      {filters.mine && <> for <strong>your team</strong></>}
      {filters.division && <> in the <strong>{divisionById.get(filters.division)?.name}</strong></>}
      {filters.week !== null && <> in <strong>week {filters.week}</strong></>}
    </p>

    {groups.length === 0 ? (
      <p class="tx__empty">
        {rows.length === 0
          ? `No transactions recorded for ${year} yet.`
          : 'No moves match these filters.'}
      </p>
    ) : (
      groups.map((group) => (
        <section class="tx__day" aria-labelledby={`day-${group.key}`}>
          <h2 class="tx__day-head" id={`day-${group.key}`}>{group.label}</h2>
          <ul class="tx__cards">
            {group.rows.map((row) => {
              const r = renderRows.get(row.id)!;
              const record = (
                <TransactionRecord
                  kind={row.kind}
                  kindLabel={KIND_LABEL[row.kind]}
                  added={r.added}
                  dropped={r.dropped}
                  tradeSides={r.tradeSides}
                  amount={showAmounts ? r.amount : undefined}
                  dashTitle={dashTitle}
                  byCommish={row.byCommish}
                />
              );
              return (
                <li class="ui-card tx-card" data-kind={row.kind} data-story={r.story ? '' : undefined} style={`--tx-team: ${r.accent};`}>
                  <div class="tx-card__top">
                    {r.story && byline ? (
                      <span class="tx-card__by">
                        <img class="tx-card__avatar" src={byline.avatar} alt="" width="24" height="24" loading="lazy" decoding="async" />
                        <span class="tx-card__byname">{byline.name}</span>
                      </span>
                    ) : (
                      <span class="tx-card__team">
                        {r.crest && <img class="tx-card__crest" src={r.crest} alt="" width="22" height="22" loading="lazy" decoding="async" />}
                        <span class="tx-card__team-name">{r.teamName}</span>
                        {r.division && <span class="tx-card__division">{r.division}</span>}
                      </span>
                    )}
                    <span class="tx-card__when">
                      {r.story && r.crest && <img class="tx-card__crest" src={r.crest} alt={r.teamName} title={r.teamName} width="22" height="22" loading="lazy" decoding="async" />}
                      <span class="tx-card__time">{r.time}</span>
                    </span>
                  </div>

                  {r.story ? (
                    <>
                      <h3 class="tx-card__headline">{r.story.headline}</h3>
                      <p class="tx-card__body">{r.story.body}</p>
                      {r.story.analysis && <p class="tx-card__take"><strong>The take:</strong> {r.story.analysis}</p>}
                      <details class="tx-card__details">
                        <summary>See details</summary>
                        <div class="tx-card__record">
                          <span class="tx-card__team">
                            {r.crest && <img class="tx-card__crest" src={r.crest} alt="" width="22" height="22" loading="lazy" decoding="async" />}
                            <span class="tx-card__team-name">{r.teamName}</span>
                            {r.division && <span class="tx-card__division">{r.division}</span>}
                          </span>
                          {record}
                        </div>
                      </details>
                    </>
                  ) : (
                    record
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    )}
  </main>
</TheLeagueLayout>


<script>
  /**
   * Convenience only — the form works without any of this.
   *
   * MUST initialise on `astro:page-load`, not `DOMContentLoaded`: with the
   * ClientRouter, a navigation into this page swaps the DOM without firing
   * DOMContentLoaded, so a DOMContentLoaded-only handler leaves the page
   * inert after the first visit (tests/clientrouter-init-ratchet.test.ts).
   */
  function initTransactionFilters() {
    const form = document.querySelector<HTMLFormElement>('[data-tx-filters]');
    if (!form) return;

    // Re-selecting the form on every page-load — never capturing it at module
    // scope — is the other half of surviving a ClientRouter navigation: the
    // node captured on the first visit is detached by the second.
    // Empty controls are disabled for the instant of the submit so they stay
    // OUT of the querystring — otherwise every filter change accretes `q=` and
    // `team=` into the URL, and the link an owner copies to share a filtered
    // view is mostly noise. Re-enabled immediately so the form still works if
    // the navigation is cancelled.
    const submit = () => {
      const emptied = Array.from(
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')
      ).filter((el) => el.name && el.type !== 'checkbox' && el.value === '');
      for (const el of emptied) el.disabled = true;
      form.requestSubmit();
      for (const el of emptied) el.disabled = false;
    };

    // A chosen team pins the division to its own (parseFilters), so changing
    // the division has to let go of the team, or the new division is overridden
    // and the select snaps back. Registered BEFORE the submit listeners below:
    // listeners on one element run in registration order.
    const division = form.querySelector<HTMLSelectElement>('select[name="division"]');
    const team = form.querySelector<HTMLSelectElement>('select[name="team"]');
    if (division && team) {
      division.addEventListener('change', () => { team.value = ''; });
    }

    for (const el of Array.from(form.querySelectorAll<HTMLElement>('select, input[type="checkbox"]'))) {
      el.addEventListener('change', submit);
    }

    const search = form.querySelector<HTMLInputElement>('input[type="search"]');
    if (search) {
      let timer: ReturnType<typeof setTimeout> | undefined;
      search.addEventListener('input', () => {
        if (timer) clearTimeout(timer);
        timer = setTimeout(submit, 450);
      });
    }
  }

  document.addEventListener('astro:page-load', initTransactionFilters);
</script>

<style>
  /* A local vocabulary aliasing the global tokens, matching the pattern in
     DivisionStrengthPage. Every fallback below points at a token that exists
     in tokens.css — tests/design-token-guard.test.ts fails the build on one
     that does not, because an undefined var() renders its fallback in BOTH
     themes and dark mode ships broken. */
  .tx {
    --tx-accent: var(--league-accent, #1c497c);
    --tx-surface: var(--card-bg, #fff);
    --tx-surface-muted: var(--content-bg-muted, #f7f7f8);
    --tx-border: var(--content-border, #e5e5e5);
    --tx-ink: var(--page-text, #1a1a1a);
    --tx-ink-muted: var(--content-text-muted, #666);

    /* A reading column, not a table: one card per move. */
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--spacing-lg, 1.5rem) var(--spacing-md, 1rem);
    color: var(--tx-ink);
  }

  .tx__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md, 1rem);
    margin-bottom: var(--spacing-md, 1rem);
  }
  .tx__header h1 { margin: 0; }
  .tx__header h1 a { color: inherit; text-decoration: none; }

  /* The season menu — deliberately quiet; past years are the rare visit. */
  .tx__season { position: relative; }
  .tx__season summary {
    list-style: none;
    cursor: pointer;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--tx-border);
    border-radius: var(--radius-md, 8px);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--tx-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .tx__season summary::-webkit-details-marker { display: none; }
  .tx__season-menu {
    position: absolute;
    right: 0;
    z-index: 5;
    margin: 0.35rem 0 0;
    padding: 0.3rem 0;
    list-style: none;
    min-width: 9rem;
    max-height: 18rem;
    overflow-y: auto;
    background: var(--tx-surface);
    border: 1px solid var(--tx-border);
    border-radius: var(--radius-md, 8px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.12));
  }
