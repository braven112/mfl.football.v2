---
/**
 * AflConferencePlayoffPreview — AL or NL playoff seeding preview.
 *
 * Each AFL conference seeds 4 teams for the head-to-head playoffs:
 *   - Seeds 1–2: Division winners (sorted by record)
 *   - Seeds 3–4: Top 2 wild cards
 * Everyone else competes in the NIT-style consolation bracket.
 *
 * Picks the user's conference (AL or NL) when known; falls back to AL.
 * Renders seeds 1–6 so you can see who's in the playoffs and who's chasing.
 */
import { chooseTeamName } from '../../../utils/team-names';
import { getConferenceStandings } from '../../../utils/standings';
import {
  getConferenceLogo,
  getConferenceLogoDark,
  getConferenceShort,
} from '../../../utils/afl-conference';
import { stripBadgeYear, namespaceBadgeIds } from '../../../utils/afl-badge';
import { formatPoints } from '../../../utils/formatters';
import ThemeImage from '../../ThemeImage.astro';
import TeamIconCell from '../../TeamIconCell.astro';

// Division-title badge art. Inlined rather than <img>-linked because the year
// stamp has to come off (see below), which means editing the SVG — an <img>
// could only point at the unedited file. Inlining then brings the id problem
// with it: every shield declares `id="sh"` for its clip path, so two of them in
// one table share that id. It's benign as the art stands (the clip geometry is
// identical across shields, so first-wins resolves to the right shape) but the
// gradients are already per-division, which is the divergence that would make
// `sh` diverge next — so namespace rather than re-audit the art each time.
const badgeSvgRaw = import.meta.glob<string>(
  '../../../../public/assets/afl/awards/*.svg',
  { query: '?raw', import: 'default', eager: true }
);
// Strip the ★ YYYY ★ stamp: this marks "leads the division right now", not a
// win in any particular season.
const DIVISION_BADGE_SVG: Record<string, string> = {};
for (const [p, raw] of Object.entries(badgeSvgRaw)) {
  DIVISION_BADGE_SVG[(p.split('/').pop() as string).replace(/\.svg$/, '')] =
    stripBadgeYear(raw);
}

interface Team {
  franchiseId: string;
  name: string;
  nameMedium?: string;
  nameShort?: string;
  abbrev?: string;
  icon?: string;
  conference?: string;
  division?: string;
}

interface Props {
  teams: Team[];
  standings: any[];
  /** AFL league config (needed by getConferenceStandings). */
  config: any;
  userFranchiseId?: string;
  /** Pick which conference to show: '00' = AL, '01' = NL. Defaults to AL. */
  conferenceCode?: '00' | '01';
  /** Number of teams that make the playoffs. */
  playoffSlots?: number;
}

const {
  teams,
  standings,
  config,
  userFranchiseId,
  conferenceCode = '00',
  playoffSlots = 4,
} = Astro.props;

const teamMap = new Map(teams.map(t => [t.franchiseId, t]));
const hasGames = standings.some(f => parseFloat(f.pf ?? '0') > 0);

let confResult: { conference: any; allTeams: Array<any> } | null = null;
try {
  confResult = getConferenceStandings(standings, config, conferenceCode, { preserveFeedOrder: true });
} catch {
  confResult = null;
}

if (!confResult) {
  // If standings aren't ready, render nothing
}

const conferenceName = confResult?.conference?.name ?? (conferenceCode === '00' ? 'American League' : 'National League');
const conferenceLogo = getConferenceLogo(conferenceCode);
const conferenceLogoDark = getConferenceLogoDark(conferenceCode);

interface PreviewRow {
  franchiseId: string;
  name: string;
  icon?: string;
  seed: number;
  record: string;
  pf: number;
  division: string;
  isDivisionWinner: boolean;
  /** Inlined division-title shield, id-namespaced. Empty when no art exists. */
  divisionBadge: string;
  isUser: boolean;
}

const allConfTeams = (confResult?.allTeams ?? []) as any[];

// Award art is filed as `<conference>-<division>.svg` (al-north, nl-pacific,
// …), so derive the filename instead of hardcoding a division→slug map — that
// covers the six-division 2003-2012 layouts for free. A division with no art
// resolves to '' and the row falls back to the "Div" wordmark.
const conferenceSlug = getConferenceShort(conferenceCode).toLowerCase();
function divisionBadgeFor(division: string, franchiseId: string): string {
  const svg = DIVISION_BADGE_SVG[`${conferenceSlug}-${String(division).toLowerCase()}`];
  return svg ? namespaceBadgeIds(svg, `conf-${conferenceSlug}-${franchiseId}`) : '';
}

const rows: PreviewRow[] = allConfTeams.map((t: any) => {
  const team = teamMap.get(t.id);
  const displayName = team
    ? chooseTeamName({
        fullName: team.name,
        nameMedium: team.nameMedium,
        nameShort: team.nameShort,
        abbrev: team.abbrev,
      }, 'default')
    : t.teamName ?? t.id;
  return {
    franchiseId: t.id,
    name: displayName,
    icon: team?.icon,
    seed: t.conferenceSeed,
    record: t.h2hwlt ?? '0-0-0',
    pf: parseFloat(t.pf ?? '0'),
    division: t.division,
    isDivisionWinner: t.conferenceSeed <= 2,
    divisionBadge: t.conferenceSeed <= 2 ? divisionBadgeFor(t.division, t.id) : '',
    isUser: t.id === userFranchiseId,
  };
});

const visible = rows.slice(0, 6);
---

{rows.length > 0 && (
  <section class="afl-conf" aria-label={`${conferenceName} playoff preview`}>
    <div class="afl-conf__header">
      <div class="afl-conf__heading">
        <ThemeImage
          src={conferenceLogo}
          darkSrc={conferenceLogoDark}
          alt={`${conferenceName} logo`}
          class="afl-conf__logo"
          loading="lazy"
          decoding="async"
        />
        <div class="afl-conf__section-header">
          <h3 class="afl-conf__title">{conferenceName} Playoff Standings</h3>
          <p class="afl-conf__sub">Top {playoffSlots} clinch playoff seeds. Division winners take seeds 1–2.</p>
        </div>
      </div>
      <a href="/afl-fantasy/standings?view=league" class="afl-conf__cta">
        Full bracket
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <table class="afl-conf__table">
      <thead>
        <tr>
          <th class="afl-conf__th afl-conf__th--seed">Seed</th>
          <th class="afl-conf__th afl-conf__th--team">Team</th>
          <th class="afl-conf__th afl-conf__th--div">Div</th>
          {hasGames && <th class="afl-conf__th afl-conf__th--record">Record</th>}
          <th class="afl-conf__th afl-conf__th--pf">PF</th>
        </tr>
      </thead>
      <tbody>
        {visible.map((row) => (
          <>
            {row.seed === playoffSlots + 1 && (
              <tr class="afl-conf__cutline" aria-hidden="true">
                <td colspan={hasGames ? 5 : 4}>Playoff line ↓</td>
              </tr>
            )}
            <tr class:list={[
              'afl-conf__row',
              { 'afl-conf__row--user': row.isUser, 'afl-conf__row--out': row.seed > playoffSlots },
            ]}>
              <td class="afl-conf__td afl-conf__td--seed">
                <span class:list={['afl-conf__seed-badge', { 'afl-conf__seed-badge--in': row.seed <= playoffSlots }]}>
                  {row.seed}
                </span>
              </td>
              <td class="afl-conf__td afl-conf__td--team">
                <TeamIconCell icon={row.icon} name={row.name} emphasis={row.isUser} />
                {row.isDivisionWinner && (
                  row.divisionBadge
                    ? <span
                        class="afl-conf__div-badge"
                        role="img"
                        aria-label={`${row.division} division leader`}
                        title={`${row.division} division leader`}
                        set:html={row.divisionBadge}
                      />
                    : <span class="afl-conf__chip" aria-label="Division winner">Div</span>
                )}
              </td>
              <td class="afl-conf__td afl-conf__td--div">{row.division}</td>
              {hasGames && <td class="afl-conf__td afl-conf__td--record">{row.record}</td>}
              <td class="afl-conf__td afl-conf__td--pf">{formatPoints(row.pf, 0)}</td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </section>
)}

<style>
  .afl-conf {
    --afl-accent: var(--league-accent, #c41e3a);
    --afl-highlight-bg: color-mix(in srgb, var(--afl-accent) 6%, transparent);
    /* Crest size for the team column (see TeamIconCell). */
    --team-icon-size: 2.25rem;
    background: var(--card-bg, #fff);
    border: 1px solid var(--content-border, #e2e8f0);
    border-radius: var(--radius-md, 0.5rem);
    box-shadow: var(--shadow-md);
    padding: 1.5rem;
  }

  .afl-conf__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .afl-conf__heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.afl-conf__logo) {
    height: 1.875rem;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .afl-conf__section-header {
    padding-left: 0.625rem;
    border-left: 2px solid var(--afl-accent);
  }

  .afl-conf__title {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
    line-height: 1;
    color: var(--color-gray-700, #374151);
  }

  .afl-conf__sub {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-gray-500, #6b7280);
  }

  .afl-conf__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--afl-accent);
    text-decoration: none;
    transition: gap 0.15s ease;
    white-space: nowrap;
  }

  .afl-conf__cta:hover {
    gap: 0.5rem;
  }

  .afl-conf__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .afl-conf__th {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-400, #9ca3af);
    padding: 0 0.5rem 0.5rem;
    text-align: left;
    border-bottom: 1px solid var(--color-gray-50, #f9fafb);
    white-space: nowrap;
  }

  .afl-conf__th--seed { width: 2.5rem; text-align: center; }
  /* Crest-only column: shrink to content so the slack goes to the stat
     columns instead of stranding the crest next to a wide empty gap. */
  .afl-conf__th--team { width: 1%; }
  .afl-conf__th--record,
  .afl-conf__th--pf { text-align: right; }
  .afl-conf__th--div { text-align: center; width: 3rem; }

  .afl-conf__row {
    transition: background 0.1s ease;
  }

  .afl-conf__row:hover {
    background: var(--color-gray-50, #f9fafb);
  }

  .afl-conf__row--user {
    background: var(--afl-highlight-bg);
  }

  .afl-conf__row--user .afl-conf__td:first-child {
    box-shadow: inset 3px 0 0 var(--afl-accent);
  }

  .afl-conf__row--out .afl-conf__td {
    color: var(--color-gray-500, #6b7280);
  }

  /* An <img> doesn't answer to `color`, so the crest stayed fully saturated in
     a row whose other cells were dimmed — the row read as half-eliminated.
     Match the text's recession with opacity instead. */
  .afl-conf__row--out :global(.team-icon-cell) {
    opacity: 0.55;
  }

  .afl-conf__td {
    padding: 0.4375rem 0.5rem;
    border-bottom: 1px solid var(--color-gray-50, #f9fafb);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .afl-conf__td--seed {
    text-align: center;
  }

  .afl-conf__seed-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    background: var(--color-gray-100, #f3f4f6);
    color: var(--color-gray-500, #6b7280);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .afl-conf__seed-badge--in {
    background: var(--cat-regular-season, #1c497c);
    color: #fff;
  }

  .afl-conf__td--team {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--color-gray-800, #1f2937);
    overflow: hidden;
  }

  .afl-conf__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.0625rem 0.375rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-regular-season, #1c497c) 14%, transparent);
    color: var(--cat-regular-season, #1c497c);
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Division-title shield in place of the old "Div" wordmark. The art is
     self-contained (navy fills, white outer stroke) so it reads on the light
     card and the dark one without a theme swap; sizing is all that's needed. */
  .afl-conf__div-badge {
    display: inline-flex;
    flex-shrink: 0;
    /* The art's 260x336 viewBox frames the shield with ~15% of empty margin
       top and bottom, so the crest-sized box below paints a shield about
       1.3rem tall — deliberately smaller than the team crest beside it. */
    height: var(--div-badge-size, 1.75rem);
    line-height: 0;
  }

  .afl-conf__div-badge :global(svg) {
    height: 100%;
    width: auto;
    display: block;
  }

  .afl-conf__td--div {
    text-align: center;
    color: var(--color-gray-500, #6b7280);
    font-size: 0.75rem;
  }

  .afl-conf__td--record,
  .afl-conf__td--pf {
    text-align: right;
    color: var(--color-gray-700, #374151);
  }

  .afl-conf__cutline td {
    padding: 0.25rem 0.5rem;
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-error, #dc2626);
    background: color-mix(in srgb, var(--color-error, #dc2626) 6%, transparent);
    text-align: center;
  }

  @media (max-width: 640px) {
    .afl-conf {
      padding: 1.25rem;
    }

    /* Stack the CTA under the heading so the title gets the full width. */
    .afl-conf__header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    /* Keep the headline on a single line. */
    :global(.afl-conf__logo) {
      height: 1.5rem;
    }

    /* Let the heading's text block shrink so the title can ellipsis rather
       than push the card wider if a league feeds an unusually long name. */
    .afl-conf__heading,
    .afl-conf__section-header {
      min-width: 0;
    }

    .afl-conf__title {
      /* Shrink a touch on the narrowest phones (~320px) so the single-line
         headline never overflows the card; caps at 0.75rem by ~390px up. */
      font-size: clamp(0.6875rem, 3.1vw, 0.75rem);
      letter-spacing: 0.02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Division is redundant on this compact view — hide the column. */
    .afl-conf__th--div,
    .afl-conf__td--div {
      display: none;
    }

    /* Shrink the table a touch and tighten cell padding so the auto-layout
       table fits inside the card down to ~320px without clipping. */
    .afl-conf__table {
      font-size: 0.75rem;
    }

    .afl-conf__th,
    .afl-conf__td {
      padding-left: 0.375rem;
      padding-right: 0.375rem;
    }

    .afl-conf {
      --team-icon-size: 2rem;
      /* Track the crest down so the badge keeps its proportion to it. */
      --div-badge-size: 1.5rem;
    }
  }
</style>
