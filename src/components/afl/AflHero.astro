---
/**
 * AflHero — Renders the AFL homepage hero from an AflHeroState.
 *
 * The branded AflEventHero renders EVERY promo state — calendar events, the
 * in-season daily slot rotation, fresh What's New entries, and the default
 * fallback. Each state carries a `view: EventHeroView` the resolver builds.
 * Only calendar-driven events get the gold border (`bordered` prop).
 *
 * High-stakes interactive phases keep their bespoke components for the day-of
 * / active week, because the promo hero can't replace what they do:
 *   - trade-deadline day      → TradeDeadlineHero (live countdown)
 *   - championship week       → AflChampionshipHero (matchup card)
 *   - conference playoffs     → AflPlayoffsHero (bracket)
 * In the LEAD-UP to each of those, AflEventHero takes over.
 *
 * Phases with an identity of their own — the keeper window and the two
 * conference drafts — render as COMPOSITES instead (`AflCompositeHero`), on
 * the shared shell TheLeague's heroes use. That routing is deliberately
 * conservative and lives here rather than in the resolver: a state whose view
 * carries no `composite` treatment, or for which neither a player nor a
 * feature screenshot could be found,
 * falls through to `AflEventHero` exactly as before. A missing feed therefore
 * degrades to the card that always worked.
 *
 * The composite deliberately does NOT take `backdrop`. The franchise backdrop
 * paints the viewer's colours behind the whole card; a composite already says
 * whose story it is through its glow (see hero-franchise-accent.ts), and
 * stacking both leaves the cast player floating on a second team's gradient.
 *
 * HeroBanner is no longer used on the AFL homepage.
 */
import TradeDeadlineHero from '../theleague/TradeDeadlineHero';
import AflPlayoffsHero from './AflPlayoffsHero.astro';
import AflChampionshipHero from './AflChampionshipHero.astro';
import AflEventHero from './AflEventHero.astro';
import AflCompositeHero from './AflCompositeHero.astro';
import LiveScoringHero from '../shared/LiveScoringHero';
import '../../styles/live-scoring-hero.css';
import '../../styles/trade-deadline-hero.css';
import type { AflHeroState } from '../../utils/afl-hero-resolver';
import type { HeroFranchiseBackdrop } from '../../utils/hero-franchise-backdrop';
import type { BuiltLiveScoringProps } from '../../utils/live-scoring-hero-props';

/** Region label per state — gives screen-reader users a meaningful landmark cue. */
const REGION_LABEL: Record<string, string> = {
  'calendar-event': 'Featured league event',
  'regular-season': 'In-season hero',
  feature: "Fresh on the site",
  default: 'AFL hero',
};

interface Props {
  state: AflHeroState;
  /** AFL league config — required when rendering playoffs/championship heroes that need bracket data. */
  config?: any;
  /** Standings data from the AFL feed — same. */
  standings?: any[];
  /** User's franchise id, for highlighting in playoff brackets. */
  userFranchiseId?: string;
  /**
   * The signed-in owner's colours + crest for the promo hero's card. Only
   * AflEventHero takes it — the trade-deadline, playoff and championship heroes
   * are ABOUT specific franchises (a countdown, a bracket, a matchup), so
   * painting the viewer's own colours behind them would claim a card that
   * belongs to whoever is in it.
   */
  backdrop?: HeroFranchiseBackdrop | null;
  /**
   * Live scores, when the page could read them. Absent means the feed did not
   * answer, and the branded event card takes the slot — a scoreboard with no
   * scores is worse than the card it replaced.
   */
  liveScoring?: BuiltLiveScoringProps;
}

const { state, config, standings, userFranchiseId, backdrop = null, liveScoring} = Astro.props;
---

{/* Live scoring outranks the composite during game windows: while games are
    being played the hero's job is a SCOREBOARD, not a portrait. Same call
    TheLeague's SeasonDailyHero makes, and the reason `slot:live-scoring`
    deliberately carries no composite treatment. */}
{state.kind === 'regular-season' && state.slot === 'live-scoring' && liveScoring ? (
  <LiveScoringHero
    client:load
    {...liveScoring}
    phase="regular-season"
    gameWindow={state.gameWindow}
    isLive={state.isLive}
  />
) : state.kind === 'trade-deadline' ? (
  <TradeDeadlineHero
    client:idle
    deadlineMidnightPT={state.deadlineMidnightPT}
    referenceNowISO={state.referenceNowISO}
  />
) : state.kind === 'playoffs' && config && standings ? (
  <AflPlayoffsHero
    teams={config.teams}
    standings={standings}
    config={config}
    userFranchiseId={userFranchiseId}
  />
) : state.kind === 'championship' && config && standings ? (
  <AflChampionshipHero
    teams={config.teams}
    standings={standings}
    config={config}
    userFranchiseId={userFranchiseId}
  />
) : 'view' in state && state.view.composite && (state.view.model || state.view.screenshot) ? (
  <AflCompositeHero
    view={state.view}
    regionLabel={REGION_LABEL[state.kind] ?? 'AFL hero'}
  />
) : (
  <AflEventHero
    {...state.view}
    bordered={state.kind === 'calendar-event'}
    regionLabel={REGION_LABEL[state.kind] ?? 'AFL hero'}
    backdrop={backdrop}
  />
)}
