---
/**
 * Global dark-mode team icon swap styles.
 *
 * Included once in the shared layout <head>. For every team (either league)
 * that declares an `iconDark` in its config, emits a CSS rule that swaps the
 * rendered <img> to the dark variant under `html.dark`. Teams without
 * `iconDark` get no rule and render exactly as before in both themes.
 *
 * This is intentionally CSS-only: with theme preference 'auto' the server
 * cannot know the resolved theme, so a server-side src pick would be wrong
 * (see src/utils/team-icon-dark-css.ts for the full rationale).
 *
 * Rules for both leagues are always emitted (exact src matches can never
 * collide across leagues) — no league branching, per the loading-standard
 * "structure vs. skin" rule.
 */
import theleagueConfig from '../data/theleague.config.json';
import aflConfig from '../../data/afl-fantasy/afl.config.json';
import strokeManifest from '../data/crest-dark-stroke-manifest.json';
import { buildTeamIconDarkCss } from '../utils/team-icon-dark-css';
import { buildCrestDarkStrokeCss } from '../utils/crest-dark-stroke-css';

/**
 * Join the measured stroke list to each team's optional `iconStrokeDark`.
 * The manifest is generated by `scripts/measure-crest-contrast.mjs` and must
 * stay purely derived, so the per-team color override lives in the league
 * config (beside `iconDark`) and is merged here rather than written into the
 * manifest — regenerating it can never clobber a hand-picked color.
 */
function withStrokeColors(league: string, teams: any[]) {
  // `iconStrokeDark: false` is an opt-out, so test for presence of the key
  // rather than truthiness — `filter(t => t.iconStrokeDark)` would drop it.
  // Teams that never set the key stay OUT of this map entirely, which is what
  // makes them fall through to the default white stroke downstream; a `false`
  // value does enter the map and is skipped by buildCrestDarkStrokeCss.
  const colorByFranchise = new Map<string, string | false>(
    teams
      .filter((t) => t?.iconStrokeDark !== undefined)
      .map((t) => [t.franchiseId, t.iconStrokeDark]),
  );
  return strokeManifest.needsStroke
    .filter((e) => e.league === league)
    .map((e) => ({ ...e, strokeColor: colorByFranchise.get(e.franchiseId) }));
}

const css = [
  buildTeamIconDarkCss(theleagueConfig.teams, {
    franchiseIconDir: '/assets/theleague/icons',
  }),
  buildTeamIconDarkCss(aflConfig.teams, {
    franchiseIconDir: '/assets/afl/icons',
  }),
  // Fallback for crests with NO hand-authored dark variant that measure as
  // illegible on a dark card — stroke the silhouette white so a crest-only
  // cell still identifies its team. The manifest already excludes any team
  // with an `iconDark`, so the two rules can never both apply to one crest.
  buildCrestDarkStrokeCss(
    withStrokeColors('theleague', theleagueConfig.teams),
    { franchiseIconDir: '/assets/theleague/icons' },
  ),
  buildCrestDarkStrokeCss(
    withStrokeColors('afl', aflConfig.teams),
    { franchiseIconDir: '/assets/afl/icons' },
  ),
]
  .filter(Boolean)
  .join('\n');
---

{css && <style is:inline set:html={css} />}
