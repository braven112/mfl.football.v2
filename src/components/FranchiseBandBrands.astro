---
/**
 * Franchise band brands — the per-league crest + hue map the player modals'
 * header band reads.
 *
 * Emitted ONCE per page from the shared layout <head>, beside
 * `TeamIconDarkStyles` / `TeamAccentStyles`, for the same reason those live
 * there: the band is painted by client JS in ~4 different modals, and a
 * per-modal copy would collide on the element id and duplicate the payload.
 *
 * It is a JSON island rather than CSS custom properties because the band needs
 * a crest URL and a display name, not just colors.
 *
 * THROWBACK WEEK is resolved here so no client code has to know the date:
 * during a throwback week every franchise's legacy identity is baked into the
 * map, and every modal on the page throws back with it. The store read is
 * gated on the week actually being one — outside that week this component
 * costs a config walk and nothing else.
 *
 * Inside that week it is memoized, because this sits in the layout and would
 * otherwise put a blocking Redis round trip in the `<head>` of EVERY page —
 * including the ones with no player modal on them at all. `/live-scoring` and
 * `/lineup` each read the same store, but each renders throwback content that
 * pays for it. Owner picks change a handful of times a season, so a short TTL
 * costs nothing real: the worst case is one owner seeing their own era swap
 * take up to a minute to reach a modal band, on pages where the SCOREBOARD —
 * which is not memoized — already shows the new one.
 */
import theleagueConfig from '../data/theleague.config.json';
import aflConfig from '../../data/afl-fantasy/afl.config.json';
import type { LeagueSlug } from '../types/nav';
import { buildFranchiseBandBrands } from '../utils/franchise-band-brand';
import {
  isThrowbackWeekForScope,
  strictThrowbackScopeForLeagueSlug,
} from '../utils/throwback-scope';
import { getAllThrowbackPreferences } from '../utils/throwback-store';
import type { ThrowbackPick } from '../utils/throwback-identity';
import { getCurrentNFLWeek } from '../utils/current-week';
import { getTestDateFromSearchParams } from '../utils/league-year';

export interface Props {
  league: LeagueSlug;
}

const { league } = Astro.props;

/**
 * Module-scope, so it is shared across requests on a warm instance. That is
 * safe here and would not be for most cached data: throwback preferences are
 * LEAGUE-WIDE (every franchise's pick), never scoped to the viewer, so there
 * is no per-user state to leak. A failed read caches `{}` too — deliberately.
 * If Redis is down, every render should not pay the timeout to rediscover it.
 *
 * Keyed BY SCOPE. A single shared slot would serve TheLeague's picks to an AFL
 * page and vice versa for up to a minute, and the two leagues use the same
 * franchise ids, so every id would collide rather than miss — the same reason
 * `rankings-storage.ts` caches a `Map<scope, …>` instead of one array.
 */
const THROWBACK_CACHE_TTL_MS = 60_000;
const throwbackCache = new Map<string, { at: number; value: Record<string, ThrowbackPick> }>();

const TEAMS_BY_SCOPE: Record<string, any[]> = {
  theleague: (theleagueConfig as any).teams ?? [],
  afl: (aflConfig as any).teams ?? [],
};

async function cachedThrowbackOverrides(scope: string): Promise<Record<string, ThrowbackPick>> {
  const nowMs = Date.now();
  const hit = throwbackCache.get(scope);
  if (hit && nowMs - hit.at < THROWBACK_CACHE_TTL_MS) return hit.value;

  const value = await getAllThrowbackPreferences(
    (TEAMS_BY_SCOPE[scope] ?? []).map((t: any) => t.franchiseId),
    scope as Parameters<typeof getAllThrowbackPreferences>[1]
  );
  throwbackCache.set(scope, { at: nowMs, value });
  return value;
}

// Season-shaped clock (which NFL week is it), matching live-scoring. `?week=`
// and `?testDate=` are honored so a throwback week can be previewed the same
// way it is everywhere else.
const now = getTestDateFromSearchParams(Astro.url.searchParams) ?? new Date();
const weekParam = parseInt(Astro.url.searchParams.get('week') ?? '', 10);
const week =
  Number.isFinite(weekParam) && weekParam > 0 ? weekParam : (getCurrentNFLWeek(now) ?? 0);

// Null for a league that does not run Throwback Week at all (Best Ball).
const throwbackScope = strictThrowbackScopeForLeagueSlug(league);
const throwbackActive = throwbackScope !== null && isThrowbackWeekForScope(week, throwbackScope);
const throwbackOverrides =
  throwbackActive && throwbackScope ? await cachedThrowbackOverrides(throwbackScope) : {};

const brands = buildFranchiseBandBrands(league, { throwbackActive, throwbackOverrides });
// `</script>` can't appear in a crest path or a hex, but escaping `<` is the
// cheap way to guarantee a config edit can never break out of the tag.
const payload = JSON.stringify(brands).replace(/</g, '\\u003c');
---

<script type="application/json" id="franchise-band-brands" is:inline set:html={payload}></script>
